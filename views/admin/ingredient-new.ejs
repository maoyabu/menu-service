<div class="max-w-3xl mx-auto bg-white p-8 rounded-md shadow">
  <h1 class="text-2xl font-semibold mb-4 flex items-center space-x-2">
    <i data-lucide="carrot" class="w-6 h-6 text-gray-700"></i>
    <span>食材登録</span>
  </h1>
  <p class="text-sm text-gray-500 mb-6">新しい食材の情報を入力してください</p>

  <form action="/admin/ingredient-new" method="POST" class="space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block mb-1 text-sm font-bold">分類 *</label>
        <input list="classification-list" name="classification" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
        <datalist id="classification-list">
          <% if (classificationList && classificationList.length > 0) { %>
            <% classificationList.forEach(cat => { %>
              <option value="<%= cat %>">
            <% }) %>
          <% } %>
        </datalist>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">食材名 *</label>
        <input type="text" name="ingredient" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">食材名（よみ）</label>
        <input type="text" name="yomi" class="w-full border rounded-md px-3 py-2 bg-gray-50">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">エネルギー (kcal)</label>
        <input type="number" name="energy" class="w-full border rounded-md px-3 py-2 bg-gray-50">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">水分 (g)</label>
        <input type="number" step="0.1" name="water" class="w-full border rounded-md px-3 py-2 bg-gray-50">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">たんぱく質 (g)</label>
        <input type="number" step="0.1" name="protein" class="w-full border rounded-md px-3 py-2 bg-gray-50">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">脂質 (g)</label>
        <input type="number" step="0.1" name="lipid" class="w-full border rounded-md px-3 py-2 bg-gray-50">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">炭水化物 (g)</label>
        <input type="number" step="0.1" name="carbohydrate" class="w-full border rounded-md px-3 py-2 bg-gray-50">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">WIKIリンク</label>
        <div class="flex gap-2">
          <input type="url" name="wikiUrl" data-wiki-input class="flex-1 border rounded-md px-3 py-2 bg-gray-50" placeholder="https://ja.wikipedia.org/wiki/○○">
          <button type="button" data-action="fetch-wiki-image" class="px-3 py-2 text-sm border rounded-md bg-white text-gray-700 hover:bg-gray-100">画像取得</button>
        </div>
        <p class="text-xs text-gray-500 mt-1">Wikipediaのリンクを入力すると、画像URLを自動取得できます。</p>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">画像URL</label>
        <input type="url" name="imageUrl" data-image-input class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="https://example.com/image.jpg">
        <div class="mt-2">
          <img data-image-preview class="max-h-40 rounded border hidden" alt="プレビュー">
          <p class="text-xs text-gray-500 mt-1">URLは直接編集可能です。</p>
        </div>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">コメント</label>
        <textarea name="comment" rows="4" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="メモや注意点などを自由入力"></textarea>
      </div>
    </div>

    <!-- 季節チェックボックス -->
    <div>
      <label class="block mb-1 text-sm font-bold">旬な季節</label>
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-700">
        <!-- ALL 選択 -->
        <label class="inline-flex items-center">
          <input type="checkbox" name="season[]" value="all" class="mr-1">
          All
        </label>
        <label class="inline-flex items-center">
          <input type="checkbox" name="season[]" value="春" class="mr-1">
          春
        </label>
        <label class="inline-flex items-center">
          <input type="checkbox" name="season[]" value="夏" class="mr-1">
          夏
        </label>
        <label class="inline-flex items-center">
          <input type="checkbox" name="season[]" value="秋" class="mr-1">
          秋
        </label>
        <label class="inline-flex items-center">
          <input type="checkbox" name="season[]" value="冬" class="mr-1">
          冬
        </label>
      </div>
    </div>

    <!-- 月チェックボックス -->
    <div>
      <label class="block mb-1 text-sm font-bold">旬な月</label>
      <!-- ALL 選択 -->
      <div class="mb-2 text-sm text-gray-700">
        <label class="inline-flex items-center">
          <input type="checkbox" name="month[]" value="all" class="mr-1">
          All
        </label>
      </div>
      <!-- 月 6×2 グリッド -->
      <div class="grid grid-cols-6 gap-2 text-sm text-gray-700">
        <% ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'].forEach(m => { %>
          <label class="inline-flex items-center">
            <input type="checkbox" name="month[]" value="<%= m %>" class="mr-1">
            <%= m %>
          </label>
        <% }) %>
      </div>
    </div>

    <div>
      <label class="block mb-1 text-sm font-bold">単位 / g換算（複数可）</label>
      <p class="text-xs text-gray-500 mb-2">単位ごとに「1単位 = 何gか」を入力できます（任意）。</p>
      <div id="units-list" class="space-y-2 text-sm text-gray-500">
        <p class="text-xs text-gray-400" data-empty-text>単位を追加してください</p>
      </div>
      <button type="button" class="mt-2 px-3 py-1 border text-sm rounded bg-white text-gray-700 hover:bg-gray-100" onclick="addUnit()">＋ 追加</button>
    </div>

    <div class="text-right mt-8">
      <button type="submit" class="inline-flex items-center space-x-2 px-5 py-2 rounded bg-gray-900 text-white hover:bg-gray-800">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>食材を保存</span>
      </button>
    </div>
  </form>
</div>

<script>
  function addUnit(value = '', grams = '') {
    const container = document.getElementById('units-list');
    if (!container) return;
    const emptyHint = container.querySelector('[data-empty-text]');
    if (emptyHint) emptyHint.remove();
    const wrapper = document.createElement('div');
    wrapper.className = 'flex items-center gap-2';

    const input = document.createElement('input');
    input.name = 'unit[]';
    input.type = 'text';
    input.placeholder = '例: g, 個, 杯';
    input.className = 'flex-1 border rounded-md px-3 py-2 bg-gray-50';
    input.value = value || '';

    const gramsWrap = document.createElement('div');
    gramsWrap.className = 'flex items-center gap-1';
    const gramsInput = document.createElement('input');
    gramsInput.name = 'unitGrams[]';
    gramsInput.type = 'number';
    gramsInput.step = '0.1';
    gramsInput.min = '0';
    gramsInput.placeholder = '1単位のg';
    gramsInput.className = 'w-28 border rounded-md px-3 py-2 bg-gray-50';
    gramsInput.value = grams || '';
    const gramsSuffix = document.createElement('span');
    gramsSuffix.className = 'text-xs text-gray-500';
    gramsSuffix.textContent = 'g';
    gramsWrap.appendChild(gramsInput);
    gramsWrap.appendChild(gramsSuffix);

    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
    removeBtn.textContent = '×';
    removeBtn.onclick = function () {
      wrapper.remove();
    };

    wrapper.appendChild(input);
    wrapper.appendChild(gramsWrap);
    wrapper.appendChild(removeBtn);
    container.appendChild(wrapper);
  }

  (function(){
    const wikiInput = document.querySelector('[data-wiki-input]');
    const fetchBtn = document.querySelector('[data-action="fetch-wiki-image"]');
    const imageInput = document.querySelector('[data-image-input]');
    const preview = document.querySelector('[data-image-preview]');

    const updatePreview = () => {
      if (!preview) return;
      const val = (imageInput?.value || '').trim();
      if (val) {
        preview.src = val;
        preview.classList.remove('hidden');
      } else {
        preview.src = '';
        preview.classList.add('hidden');
      }
    };
    imageInput?.addEventListener('input', updatePreview);

    const fetchImage = async () => {
      const url = (wikiInput?.value || '').trim();
      if (!url) {
        alert('WIKIリンクを入力してください');
        return;
      }
      try {
        fetchBtn?.setAttribute('disabled', 'disabled');
        fetchBtn?.classList.add('opacity-60', 'cursor-wait');
        const res = await fetch(`/admin/api/wiki-image?url=${encodeURIComponent(url)}`);
        if (!res.ok) throw new Error('取得に失敗しました');
        const data = await res.json();
        if (data?.imageUrl && imageInput) {
          imageInput.value = data.imageUrl;
          updatePreview();
        }
        alert(data?.imageUrl ? '画像URLを取得しました' : '画像が見つかりませんでした');
      } catch (err) {
        alert(err?.message || '取得に失敗しました');
      } finally {
        fetchBtn?.removeAttribute('disabled');
        fetchBtn?.classList.remove('opacity-60', 'cursor-wait');
      }
    };
    fetchBtn?.addEventListener('click', (e)=>{ e.preventDefault(); fetchImage(); });
  })();

  lucide.createIcons();
</script>
