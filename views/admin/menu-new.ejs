<div class="max-w-4xl mx-auto bg-white p-8 rounded-md shadow">
  <h1 class="text-2xl font-semibold mb-2 flex items-center space-x-2">
    <i data-lucide="chef-hat" class="w-6 h-6 text-gray-700"></i>
    <span>レシピ登録</span>
  </h1>
  <p class="text-sm text-gray-500 mb-6">新しいレシピの情報を入力してください</p>
  <style>
    /* 基本トグル: OFF=グレー左, ON=ブルー右 */
    .toggle-track { position: relative; width: 48px; height: 24px; background: #d1d5db; border-radius: 9999px; display: inline-flex; align-items: center; padding: 0 2px; transition: background-color .2s ease; }
    .toggle-knob { width: 20px; height: 20px; border-radius: 9999px; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.25); transition: transform .2s ease; transform: translateX(0); }
    .toggle-input:checked + .toggle-track { background: #3b82f6; }
    .toggle-input:checked + .toggle-track .toggle-knob { transform: translateX(24px); }
    .toggle-state { display: inline-flex; gap: 4px; font-size: 11px; align-items: center; }
    .toggle-state .state-on,
    .toggle-state .state-off { padding: 4px 8px; border-radius: 6px; border: 1px solid #e5e7eb; transition: all .2s ease; }
    .toggle-input:checked ~ .toggle-state .state-on { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-input:checked ~ .toggle-state .state-off { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-on { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-off { background: #f3f4f6; border-color: #d1d5db; color: #374151; font-weight: 600; }
    /* invert mode: 未チェック=公開(ON)を強調しトラックもブルー, チェックで非公開(OFF)強調 */
    .toggle-invert .toggle-track { background: #3b82f6; }
    .toggle-invert .toggle-knob { transform: translateX(24px); }
    .toggle-invert .toggle-input:checked + .toggle-track { background: #d1d5db; }
    .toggle-invert .toggle-input:checked + .toggle-track .toggle-knob { transform: translateX(0); }
    .toggle-invert .toggle-input:not(:checked) ~ .toggle-state .state-on { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-invert .toggle-input:not(:checked) ~ .toggle-state .state-off { background: #fff; color: #9ca3af; }
    .toggle-invert .toggle-input:checked ~ .toggle-state .state-off { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-invert .toggle-input:checked ~ .toggle-state .state-on { background: #fff; color: #9ca3af; }
  </style>

  <form action="/admin/menu-new" method="POST" class="space-y-8">
    <input type="hidden" name="filters" value="<%= filters || '' %>">
    <div class="flex flex-wrap items-center gap-4 p-4 bg-gray-50 border rounded-lg">
      <span class="text-sm font-bold text-gray-700">公開設定</span>
      <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer toggle-invert">
        <input type="hidden" name="isPrivate" value="false">
        <input type="checkbox" name="isPrivate" value="true" class="toggle-input sr-only" aria-label="非公開フラグ">
        <span class="toggle-track"><span class="toggle-knob"></span></span>
        <span class="toggle-state">
          <span class="state-off">非公開</span>
          <span class="state-on">公開</span>
        </span>
      </label>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block mb-1 text-sm font-bold">レシピ名 *</label>
        <input type="text" name="name" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">よみ</label>
        <input type="text" name="yomi" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="よみがな">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">メニュー *</label>
        <input type="text" name="menu" list="menu-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
        <datalist id="menu-list">
          <% (menuList || []).forEach(name => { %>
            <option value="<%= name %>"></option>
          <% }); %>
        </datalist>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">種類 *</label>
        <input type="text" name="kind" list="kind-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 主菜 / 副菜 / デザート など" required>
        <datalist id="kind-list">
          <% (kindList || []).forEach(kind => { %>
            <option value="<%= kind %>"></option>
          <% }); %>
        </datalist>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">ジャンル *</label>
        <select name="junle" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
          <option value="">ジャンルを選択</option>
          <% junleList.forEach(junle => { %>
            <option value="<%= junle %>"><%= junle %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">調理方法 *</label>
        <input type="text" name="cook" list="cook-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 炒める / 茹でる" required>
        <datalist id="cook-list">
          <% (cookList || []).forEach(cook => { %>
            <option value="<%= cook %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <p class="block mb-2 text-sm font-bold text-gray-700">基本メニュー</p>
        <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer">
          <input type="hidden" name="basicMenu" value="false">
          <input type="checkbox" name="basicMenu" value="true" class="toggle-input sr-only" aria-label="基本メニューフラグ">
          <span class="toggle-track"><span class="toggle-knob"></span></span>
          <span class="toggle-state">
            <span class="state-off">OFF</span>
            <span class="state-on">ON</span>
          </span>
          <span>基本メニューにする</span>
        </label>
      </div>
      <div>
        <p class="block mb-2 text-sm font-bold text-gray-700">素材フラグ</p>
        <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer">
          <input type="hidden" name="material" value="false">
          <input type="checkbox" name="material" value="true" class="toggle-input sr-only" aria-label="素材フラグ">
          <span class="toggle-track"><span class="toggle-knob"></span></span>
          <span class="toggle-state">
            <span class="state-off">OFF</span>
            <span class="state-on">ON</span>
          </span>
          <span>素材メニューにする</span>
        </label>
      </div>
      <div>
        <p class="block mb-2 text-sm font-bold text-gray-700">つくりおき</p>
        <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer">
          <input type="hidden" name="makeAhead" value="false">
          <input type="checkbox" name="makeAhead" value="true" class="toggle-input sr-only" aria-label="つくりおきフラグ">
          <span class="toggle-track"><span class="toggle-knob"></span></span>
          <span class="toggle-state">
            <span class="state-off">OFF</span>
            <span class="state-on">ON</span>
          </span>
          <span>つくりおき向き</span>
        </label>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">URL *</label>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <input type="url" name="url" id="menu-url-input" class="flex-1 border rounded-md px-3 py-2 bg-gray-50" placeholder="https://example.com" required>
          <button type="button" id="menu-url-open" class="inline-flex items-center gap-1 px-3 py-2 text-sm border border-gray-300 rounded text-gray-700 hover:bg-gray-50">
            <i data-lucide="external-link" class="w-4 h-4"></i>
            <span>リンクを開く</span>
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1">URLを入力するとボタンから別タブで確認できます。</p>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">画像URL</label>
        <div class="flex flex-col md:flex-row md:items-start gap-4">
          <div class="flex-1 space-y-2">
            <input type="url" name="imageUrl" id="image-url-input" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="https://example.com/image.jpg">
            <p class="text-xs text-gray-500">画像の直リンクを入力すると右側にプレビューが表示されます。</p>
          </div>
          <div class="w-full md:w-48">
            <div class="relative w-full h-32 border border-dashed border-gray-300 rounded bg-gray-50 flex items-center justify-center overflow-hidden">
              <img id="image-url-preview" src="" alt="画像プレビュー" class="hidden object-cover w-full h-full">
              <span id="image-url-placeholder" class="text-xs text-gray-400">プレビューなし</span>
            </div>
          </div>
        </div>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">調理時間 (分) *</label>
        <input type="number" name="time" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">人数 *</label>
        <input type="number" name="people" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">コメント</label>
        <textarea name="comment" rows="4" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="レシピに関するメモや補足を書いてください"></textarea>
      </div>
    </div>

    <hr class="my-6">

    <div>
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">食材</label>
        <button type="button" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100" onclick="addIngredient()">
          <span class="text-xl leading-none">＋</span><span class="ml-1">食材を追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="ingredients-list" class="space-y-2 text-sm text-gray-500">食材を追加してください</div>
      </div>
    </div>

    <hr class="my-6">

    <div>
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">調味料</label>
        <button type="button" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100" onclick="addSeasoning()">
          <span class="text-xl leading-none">＋</span><span class="ml-1">調味料を追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="seasonings-list" class="space-y-2 text-sm text-gray-500">調味料を追加してください</div>
      </div>
    </div>

    <div class="text-right mt-8">
      <button type="submit" class="inline-flex items-center space-x-2 px-5 py-2 rounded bg-gray-900 text-white hover:bg-gray-800">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>レシピを保存</span>
      </button>
    </div>
  </form>
</div>

<script>
  // --- 新しい食材追加モーダル用JS ---
  let currentIngredientTab = 'search';

  function setIngredientTab(tab) {
    currentIngredientTab = tab;
    document.querySelectorAll('.ingredient-tab-btn').forEach(btn => {
      btn.classList.remove('bg-gray-200', 'text-black');
      btn.classList.add('text-gray-700');
    });
    const activeBtn = document.getElementById(`tab-btn-${tab}`);
    activeBtn.classList.remove('text-gray-700');
    activeBtn.classList.add('bg-gray-200', 'text-black');

    if (tab === 'favorite') {
      document.getElementById('ingredient-search').value = '';
      document.getElementById('ingredient-genre-filter').selectedIndex = 0;
    }

    fetchIngredients();
  }

  let ING_GENRE = '';
  const ING_GENRES = <%- JSON.stringify(genreList || []) %>;
  function paintIngGenres(){
    const holder = document.getElementById('ingredient-genres'); if (!holder) return;
    holder.innerHTML=''; holder.className = 'flex items-center gap-2';
    const label = document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
    const sel = document.createElement('select'); sel.className='border rounded px-3 py-2'; sel.id='ingredient-genre-filter';
    const all=['すべて',...ING_GENRES];
    all.forEach((lb,idx)=>{ const val=idx===0?'':lb; const op=document.createElement('option'); op.value=val; op.textContent=lb; if(String(ING_GENRE||'')===String(val||'')) op.selected=true; sel.appendChild(op); });
    sel.addEventListener('change', ()=>{ ING_GENRE = sel.value; fetchIngredients(); });
    holder.appendChild(label); holder.appendChild(sel);
  }

  async function fetchIngredients() {
    const keyword = document.getElementById('ingredient-search')?.value || '';
    const genreFilter = ING_GENRE || '';
    const params = new URLSearchParams();
    params.append('keyword', keyword);
    params.append('tab', currentIngredientTab);
    if (genreFilter) {
      params.append('genre', genreFilter);
    }
    if (currentIngredientTab === 'favorite') {
      params.append('favorite', true);
    }
    if (currentIngredientTab === 'recent') {
      params.append('recent', true);
    }

    const res = await fetch('/admin/api/ingredients?' + params.toString());
    let ingredients = await res.json();
    // フロント側で再度絞り込み（yomi対応, サーバー側で未対応の場合）
    if (keyword && Array.isArray(ingredients)) {
      ingredients = ingredients.filter(item =>
        (item.ingredient && item.ingredient.includes(keyword)) ||
        (item.yomi && item.yomi.includes(keyword)) ||
        (item.classification && item.classification.includes(keyword)) ||
        (item.unit && Array.isArray(item.unit) && item.unit.some(u => u.includes(keyword)))
      );
    }
    renderIngredientList(ingredients);
  }

  // 新しい食材リスト描画（お気に入り・詳細・カード全体クリックで追加）
  function renderIngredientList(ingredients) {
    const tags = document.getElementById('ingredient-tags'); const selected = document.getElementById('ingredient-selected');
    tags.innerHTML=''; selected.classList.add('hidden'); selected.innerHTML='';
    if (!ingredients || ingredients.length===0){ tags.innerHTML='<p class="text-sm text-gray-500">該当する食材が見つかりません</p>'; return; }
    ingredients.forEach(item=>{
      const label = item.ingredient || '';
      const b=document.createElement('button'); b.type='button'; b.textContent=label; b.className='px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200';
      b.addEventListener('click', ()=>{
        selected.classList.remove('hidden'); selected.innerHTML='';
        const row=document.createElement('div'); row.className='flex items-center gap-3';
        const info=document.createElement('div'); info.className='flex-1'; info.innerHTML=`<div class=\"font-semibold\">${label}</div><div class=\"text-xs text-gray-600\">カテゴリ: ${item.classification||''}</div>`;
        const hiddenId=document.createElement('input'); hiddenId.type='hidden'; hiddenId.value=String(item._id);
        const amount=document.createElement('input'); amount.type='number'; amount.min='0'; amount.step='0.1'; amount.className='w-24 border rounded px-2 py-1';
        const units=Array.isArray(item.unit)? item.unit: (item.unit? [item.unit]:[]);
        let unitEl; if (units.length){ unitEl=document.createElement('select'); unitEl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); }); } else { unitEl=document.createElement('input'); unitEl.className='w-24 border rounded px-2 py-1'; }
        const addBtn=document.createElement('button'); addBtn.type='button'; addBtn.textContent='追加'; addBtn.className='px-3 py-1.5 rounded bg-blue-600 text-white text-sm';
        addBtn.addEventListener('click', ()=>{
          addIngredientFromSearch(String(item._id), label, units, item.classification||'', item.short_nutrition||'');
          const cont = document.getElementById('ingredients-list'); const last = cont.lastElementChild; if (last){ const inputs=last.querySelectorAll('input, select'); if (inputs && inputs.length>=3){ inputs[1].value = amount.value || ''; const unitCtl = inputs[2]; if (unitCtl && unitCtl.tagName==='SELECT' && unitEl.tagName==='SELECT') unitCtl.value = unitEl.value; else if(unitCtl) unitCtl.value = unitEl.value || ''; }}
          document.getElementById('ingredient-modal').classList.add('hidden');
        });
        row.append(info, hiddenId, amount, unitEl, addBtn); selected.appendChild(row);
      });
      tags.appendChild(b);
    });
  }

  function openIngredientModal() {
    document.getElementById('ingredient-modal').classList.remove('hidden');
    paintIngGenres(); fetchIngredients();

    const searchInput = document.getElementById('ingredient-search');
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(ingredientSearchTimer);
        ingredientSearchTimer = setTimeout(() => {
          fetchIngredients();
        }, 300);
      });
      searchInput.dataset.bound = 'true';
    }
  }

  function closeIngredientModal() {
    document.getElementById('ingredient-modal').classList.add('hidden');
  }

  let ingredientSearchTimer;

  async function addIngredientFromSearch(id, name, units, classification = '', nutrition = '') {
    const container = document.getElementById('ingredients-list');
    // Remove "食材を追加してください" if present
    if (container.textContent.trim() === '食材を追加してください') container.innerHTML = '';
    const wrapper = document.createElement('div');
    wrapper.className = 'flex flex-col sm:flex-row sm:items-center sm:justify-between border p-4 rounded-lg bg-gray-50';

    // hidden input
    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'ingredient_ids[]';
    hidden.value = id;

    // 上部: 名前＋分類
    const topDiv = document.createElement('div');
    topDiv.className = 'text-base font-medium text-gray-900';
    topDiv.innerHTML = `${name} <span class="ml-2 inline-block text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">${classification || '分類'}</span>`;

    // 下部: 分量・単位・栄養・削除
    const bottomDiv = document.createElement('div');
    bottomDiv.className = 'flex flex-wrap items-center gap-2 mt-2 sm:mt-0';

    // 分量
    const amount = document.createElement('input');
    amount.type = 'number';
    amount.step = 'any';
    amount.name = 'ingredient_amounts[]';
    amount.placeholder = '量';
    amount.className = 'w-20 border rounded-md px-2 py-1 text-sm';

    // 単位
    const unitSelect = document.createElement('select');
    unitSelect.name = 'ingredient_units[]';
    unitSelect.className = 'border rounded-md px-2 py-1 text-sm';
    units.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u;
      opt.textContent = u;
      unitSelect.appendChild(opt);
    });

    // 栄養情報（ダミー/空でも表示）
    const nutritionSpan = document.createElement('span');
    nutritionSpan.className = 'text-gray-500 text-sm';
    nutritionSpan.textContent = nutrition || '-';

    // 削除ボタン
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
    removeBtn.textContent = '×';
    removeBtn.onclick = function () {
      wrapper.remove();
      // If no children, show placeholder
      if (container.children.length === 0) {
        container.innerHTML = '食材を追加してください';
      }
    };

    bottomDiv.appendChild(amount);
    bottomDiv.appendChild(unitSelect);
    bottomDiv.appendChild(nutritionSpan);
    bottomDiv.appendChild(removeBtn);

    wrapper.appendChild(hidden);
    wrapper.appendChild(topDiv);
    wrapper.appendChild(bottomDiv);
    container.appendChild(wrapper);
    // 記録API呼び出し
    await fetch(`/admin/api/ingredient-used/${id}`, { method: 'POST' });
    closeIngredientModal();
  }

  // 元のボタンをモーダル起動に変更
  function addIngredient() {
    openIngredientModal();
  }

  // --- 調味料追加モーダル用JS ---
  let currentSeasoningTab = 'search';

  function setSeasoningTab(tab) {
    currentSeasoningTab = tab;
    document.querySelectorAll('.seasoning-tab-btn').forEach(btn => {
      btn.classList.remove('bg-gray-200', 'text-black');
      btn.classList.add('text-gray-700');
    });
    const activeBtn = document.getElementById(`seasoning-tab-btn-${tab}`);
    activeBtn.classList.remove('text-gray-700');
    activeBtn.classList.add('bg-gray-200', 'text-black');

    if (tab === 'favorite' || tab === 'recent') {
      document.getElementById('seasoning-search').value = '';
      document.getElementById('seasoning-genre-filter').selectedIndex = 0;
    }

    fetchSeasonings();
  }

  let SEAS_GENRE = '';
  const SEAS_GENRES = <%- JSON.stringify(seasoningGenreList || []) %>;
  function paintSeaGenres(){
    const holder = document.getElementById('seasoning-genres'); if (!holder) return;
    holder.innerHTML=''; holder.className='flex items-center gap-2';
    const label=document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
    const sel=document.createElement('select'); sel.className='border rounded px-3 py-2'; sel.id='seasoning-genre-filter';
    const all=['すべて',...SEAS_GENRES];
    all.forEach((lb,idx)=>{ const val=idx===0?'':lb; const op=document.createElement('option'); op.value=val; op.textContent=lb; if(String(SEAS_GENRE||'')===String(val||'')) op.selected=true; sel.appendChild(op); });
    sel.addEventListener('change', ()=>{ SEAS_GENRE = sel.value; fetchSeasonings(); });
    holder.appendChild(label); holder.appendChild(sel);
  }

  async function fetchSeasonings() {
    const keyword = document.getElementById('seasoning-search')?.value || '';
    const genreFilter = SEAS_GENRE || '';
    const params = new URLSearchParams();
    params.append('keyword', keyword);
    params.append('tab', currentSeasoningTab);
    if (genreFilter) {
      params.append('genre', genreFilter);
    }
    if (currentSeasoningTab === 'favorite') {
      params.append('favorite', true);
    }
    if (currentSeasoningTab === 'recent') {
      params.append('recent', true);
    }

    const res = await fetch('/admin/api/seasonings?' + params.toString());
    let seasonings = await res.json();
    // フロント側で再度絞り込み（yomi対応, サーバー側で未対応の場合）
    if (keyword && Array.isArray(seasonings)) {
      seasonings = seasonings.filter(item =>
        (item.seasoning && item.seasoning.includes(keyword)) ||
        (item.yomi && item.yomi.includes(keyword)) ||
        (item.classification && item.classification.includes(keyword)) ||
        (item.unit && Array.isArray(item.unit) && item.unit.some(u => u.includes(keyword)))
      );
    }
    renderSeasoningList(seasonings);
  }

  // 調味料タグ描画 + 選択パネル
  function renderSeasoningList(list) {
    const tags = document.getElementById('seasoning-tags'); const selected = document.getElementById('seasoning-selected');
    tags.innerHTML=''; selected.classList.add('hidden'); selected.innerHTML='';
    if (!list || list.length===0){ tags.innerHTML='<p class="text-sm text-gray-500">該当する調味料が見つかりません</p>'; return; }
    list.forEach(item=>{
      const label=item.seasoning||''; const b=document.createElement('button'); b.type='button'; b.textContent=label; b.className='px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200';
      b.addEventListener('click', ()=>{
        selected.classList.remove('hidden'); selected.innerHTML=''; const row=document.createElement('div'); row.className='flex items-center gap-3';
        const info=document.createElement('div'); info.className='flex-1'; info.innerHTML=`<div class=\"font-semibold\">${label}</div><div class=\"text-xs text-gray-600\">カテゴリ: ${item.classification||''}</div>`;
        const hiddenId=document.createElement('input'); hiddenId.type='hidden'; hiddenId.value=String(item._id);
        const amount=document.createElement('input'); amount.type='number'; amount.min='0'; amount.step='0.1'; amount.className='w-24 border rounded px-2 py-1';
        const units=Array.isArray(item.unit)? item.unit: (item.unit? [item.unit]:[]);
        let unitEl; if (units.length){ unitEl=document.createElement('select'); unitEl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); }); } else { unitEl=document.createElement('input'); unitEl.className='w-24 border rounded px-2 py-1'; }
        const addBtn=document.createElement('button'); addBtn.type='button'; addBtn.textContent='追加'; addBtn.className='px-3 py-1.5 rounded bg-blue-600 text-white text-sm';
        addBtn.addEventListener('click', ()=>{
          addSeasoningFromSearch(String(item._id), label, units, item.classification||'', item.short_nutrition||'');
          const cont=document.getElementById('seasonings-list'); const last=cont.lastElementChild; if (last){ const inputs=last.querySelectorAll('input, select'); if (inputs && inputs.length>=3){ inputs[1].value = amount.value || ''; const unitCtl = inputs[2]; if (unitCtl && unitCtl.tagName==='SELECT' && unitEl.tagName==='SELECT') unitCtl.value = unitEl.value; else if(unitCtl) unitCtl.value = unitEl.value || ''; }}
          document.getElementById('seasoning-modal').classList.add('hidden');
        });
        row.append(info, hiddenId, amount, unitEl, addBtn); selected.appendChild(row);
      }); tags.appendChild(b);
    });
  }

  function openSeasoningModal() {
    document.getElementById('seasoning-modal').classList.remove('hidden');
    paintSeaGenres(); fetchSeasonings();

    const searchInput = document.getElementById('seasoning-search');
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(seasoningSearchTimer);
        seasoningSearchTimer = setTimeout(() => {
          fetchSeasonings();
        }, 300);
      });
      searchInput.dataset.bound = 'true';
    }
  }

  function closeSeasoningModal() {
    document.getElementById('seasoning-modal').classList.add('hidden');
  }

  let seasoningSearchTimer;

  async function addSeasoningFromSearch(id, name, units, classification = '', nutrition = '') {
    const container = document.getElementById('seasonings-list');
    // Remove "調味料を追加してください" if present
    if (container.textContent.trim() === '調味料を追加してください') container.innerHTML = '';
    const wrapper = document.createElement('div');
    wrapper.className = 'flex flex-col sm:flex-row sm:items-center sm:justify-between border p-4 rounded-lg bg-gray-50';

    // hidden input
    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'seasoning_ids[]';
    hidden.value = id;

    // 上部: 名前＋分類
    const topDiv = document.createElement('div');
    topDiv.className = 'text-base font-medium text-gray-900';
    topDiv.innerHTML = `${name} <span class="ml-2 inline-block text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">${classification || '分類'}</span>`;

    // 下部: 分量・単位・栄養・削除
    const bottomDiv = document.createElement('div');
    bottomDiv.className = 'flex flex-wrap items-center gap-2 mt-2 sm:mt-0';

    // 分量
    const amount = document.createElement('input');
    amount.type = 'number';
    amount.step = 'any';
    amount.name = 'seasoning_amounts[]';
    amount.placeholder = '量';
    amount.className = 'w-20 border rounded-md px-2 py-1 text-sm';

    // 単位
    const unitSelect = document.createElement('select');
    unitSelect.name = 'seasoning_units[]';
    unitSelect.className = 'border rounded-md px-2 py-1 text-sm';
    units.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u;
      opt.textContent = u;
      unitSelect.appendChild(opt);
    });

    // 栄養情報（ダミー/空でも表示）
    const nutritionSpan = document.createElement('span');
    nutritionSpan.className = 'text-gray-500 text-sm';
    nutritionSpan.textContent = nutrition || '-';

    // 削除ボタン
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
    removeBtn.textContent = '×';
    removeBtn.onclick = function () {
      wrapper.remove();
      // If no children, show placeholder
      if (container.children.length === 0) {
        container.innerHTML = '調味料を追加してください';
      }
    };

    bottomDiv.appendChild(amount);
    bottomDiv.appendChild(unitSelect);
    bottomDiv.appendChild(nutritionSpan);
    bottomDiv.appendChild(removeBtn);

    wrapper.appendChild(hidden);
    wrapper.appendChild(topDiv);
    wrapper.appendChild(bottomDiv);
    container.appendChild(wrapper);
    // 記録API呼び出し
    await fetch(`/admin/api/seasoning-used/${id}`, { method: 'POST' });
    closeSeasoningModal();
  }

  // 元のボタンをモーダル起動に変更
  function addSeasoning() {
    openSeasoningModal();
  }

</script>

<script>
// 共通: 詳細表示・お気に入りトグル
function toggleIngredientDetail(button) {
  const parent = button.closest('.ingredient-card, .seasoning-card');
  const detail = parent.querySelector('.detail-section');
  if (detail) detail.classList.toggle('hidden');
}

async function toggleFavorite(button, id, type) {
  const isFav = button.textContent === '★';
  const method = isFav ? 'DELETE' : 'POST';
  await fetch(`/admin/api/favorite/${type}/${id}`, { method });
  button.textContent = isFav ? '☆' : '★';
  button.classList.toggle('text-yellow-400', !isFav);
  button.classList.toggle('text-gray-400', isFav);
}
</script>

<script>
  // カテゴリリスト取得処理を削除（カテゴリのセレクトボックスも削除したため）

  function initImagePreview(inputId, imgId, placeholderId) {
    const input = document.getElementById(inputId);
    const img = document.getElementById(imgId);
    const placeholder = document.getElementById(placeholderId);

    const updatePreview = () => {
      const url = (input?.value || '').trim();
      if (url) {
        if (img) {
          img.src = url;
          img.classList.remove('hidden');
        }
        if (placeholder) {
          placeholder.classList.add('hidden');
        }
      } else {
        if (img) {
          img.src = '';
          img.classList.add('hidden');
        }
        if (placeholder) {
          placeholder.classList.remove('hidden');
        }
      }
    };

    input?.addEventListener('input', updatePreview);
    updatePreview();
  }

  function initUrlOpener(inputId, buttonId) {
    const input = document.getElementById(inputId);
    const button = document.getElementById(buttonId);
    if (!button) return;
    button.addEventListener('click', () => {
      const url = (input?.value || '').trim();
      if (url) {
        const features = 'noopener=yes,noreferrer=yes,width=1200,height=800,resizable=yes,scrollbars=yes';
        window.open(url, 'menuLinkWindow', features);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 初期描画用食材をEJSから受け取り
    const initialIngredients = <%- JSON.stringify(initialIngredients || []) %>;
    const resultsEl = document.getElementById('ingredient-results');
    if (resultsEl) {
      renderIngredientList(initialIngredients);
    }
    // 初期描画用調味料
    const initialSeasonings = <%- JSON.stringify(initialSeasonings || []) %>;
    const seasoningResultsEl = document.getElementById('seasoning-results');
    if (seasoningResultsEl) {
      renderSeasoningList(initialSeasonings);
    }

    initUrlOpener('menu-url-input', 'menu-url-open');
    initImagePreview('image-url-input', 'image-url-preview', 'image-url-placeholder');

    if (typeof window.refreshLucideIcons === 'function') {
      window.refreshLucideIcons();
    }

    // 栄養情報の短縮バージョン表示（ingredients）
    document.querySelectorAll('#ingredients-list .flex').forEach(wrapper => {
      const hiddenInput = wrapper.querySelector('input[type="hidden"][name="ingredient_ids[]"]');
      if (!hiddenInput) return;
      const ingredientId = hiddenInput.value;
      // nutritionSpanは3番目の子（amount, unit, nutrition, removeBtn）
      const nutritionSpan = wrapper.querySelector('span.text-gray-500.text-sm');
      if (!nutritionSpan) return;
      // initialIngredientsから該当IDを探す
      const matchedIngredient = initialIngredients.find(item => item._id === ingredientId);
      // Use short_nutrition instead of nutrition
      const nutrition = matchedIngredient?.short_nutrition;
      nutritionSpan.textContent = nutrition || '-';
    });

    // 栄養情報の短縮バージョン表示（seasonings）
    document.querySelectorAll('#seasonings-list .flex').forEach(wrapper => {
      const hiddenInput = wrapper.querySelector('input[type="hidden"][name="seasoning_ids[]"]');
      if (!hiddenInput) return;
      const seasoningId = hiddenInput.value;
      const nutritionSpan = wrapper.querySelector('span.text-gray-500.text-sm');
      if (!nutritionSpan) return;
      // initialSeasoningsから該当IDを探す
      const matchedSeasoning = initialSeasonings.find(item => item._id === seasoningId);
      // Use short_nutrition instead of nutrition
      const nutrition = matchedSeasoning?.short_nutrition;
      nutritionSpan.textContent = nutrition || '-';
    });
  });
</script>

