  let SEAS_GENRE = '';
  const SEAS_GENRES = <%- JSON.stringify(seasoningGenreList || []) %>;
  function paintSeaGenres(){
    const holder = document.getElementById('seasoning-genres'); if (!holder) return;
    holder.innerHTML=''; holder.className='flex items-center gap-2';
    const label=document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
    const sel=document.createElement('select'); sel.className='border rounded px-3 py-2'; sel.id='seasoning-genre-filter';
    const all=['すべて',...SEAS_GENRES];
    all.forEach((lb,idx)=>{ const val=idx===0?'':lb; const op=document.createElement('option'); op.value=val; op.textContent=lb; if(String(SEAS_GENRE||'')===String(val||'')) op.selected=true; sel.appendChild(op); });
    sel.addEventListener('change', ()=>{ SEAS_GENRE = sel.value; fetchSeasonings(); });
    holder.appendChild(label); holder.appendChild(sel);
  }

  async function fetchSeasonings() {
    const keyword = document.getElementById('seasoning-search')?.value || '';
    const genreFilter = SEAS_GENRE || '';
    const params = new URLSearchParams();
    params.append('keyword', keyword);
    params.append('tab', currentSeasoningTab);
    if (genreFilter) {
      params.append('genre', genreFilter);
    }
    if (currentSeasoningTab === 'favorite') {
      params.append('favorite', true);
    }
    if (currentSeasoningTab === 'recent') {
      params.append('recent', true);
    }

    const res = await fetch('/admin/api/seasonings?' + params.toString());
    let seasonings = await res.json();
    // フロント側で再度絞り込み（yomi対応, サーバー側で未対応の場合）
    if (keyword && Array.isArray(seasonings)) {
      seasonings = seasonings.filter(item =>
        (item.seasoning && item.seasoning.includes(keyword)) ||
        (item.yomi && item.yomi.includes(keyword)) ||
        (item.classification && item.classification.includes(keyword)) ||
        (item.unit && Array.isArray(item.unit) && item.unit.some(u => u.includes(keyword)))
      );
    }
    renderSeasoningList(seasonings);
  }

