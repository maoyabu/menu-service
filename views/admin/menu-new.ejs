<div class="max-w-4xl mx-auto bg-white p-8 rounded-md shadow">
  <h1 class="text-2xl font-semibold mb-2 flex items-center space-x-2">
    <i data-lucide="chef-hat" class="w-6 h-6 text-gray-700"></i>
    <span>レシピ登録</span>
  </h1>
  <p class="text-sm text-gray-500 mb-6">新しいレシピの情報を入力してください</p>
  <style>
    /* 基本トグル: OFF=グレー左, ON=ブルー右 */
    .toggle-track { position: relative; width: 48px; height: 24px; background: #d1d5db; border-radius: 9999px; display: inline-flex; align-items: center; padding: 0 2px; transition: background-color .2s ease; }
    .toggle-knob { width: 20px; height: 20px; border-radius: 9999px; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.25); transition: transform .2s ease; transform: translateX(0); }
    .toggle-input:checked + .toggle-track { background: #3b82f6; }
    .toggle-input:checked + .toggle-track .toggle-knob { transform: translateX(24px); }
    .toggle-state { display: inline-flex; gap: 4px; font-size: 11px; align-items: center; }
    .toggle-state .state-on,
    .toggle-state .state-off { padding: 4px 8px; border-radius: 6px; border: 1px solid #e5e7eb; transition: all .2s ease; }
    .toggle-input:checked ~ .toggle-state .state-on { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-input:checked ~ .toggle-state .state-off { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-on { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-off { background: #f3f4f6; border-color: #d1d5db; color: #374151; font-weight: 600; }
    /* invert mode: 未チェック=公開(ON)を強調しトラックもブルー, チェックで非公開(OFF)強調 */
    .toggle-invert .toggle-track { background: #3b82f6; }
    .toggle-invert .toggle-knob { transform: translateX(24px); }
    .toggle-invert .toggle-input:checked + .toggle-track { background: #d1d5db; }
    .toggle-invert .toggle-input:checked + .toggle-track .toggle-knob { transform: translateX(0); }
    .toggle-invert .toggle-input:not(:checked) ~ .toggle-state .state-on { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-invert .toggle-input:not(:checked) ~ .toggle-state .state-off { background: #fff; color: #9ca3af; }
    .toggle-invert .toggle-input:checked ~ .toggle-state .state-off { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-invert .toggle-input:checked ~ .toggle-state .state-on { background: #fff; color: #9ca3af; }
  </style>

  <form action="/admin/menu-new" method="POST" class="space-y-8">
    <input type="hidden" name="filters" value="<%= filters || '' %>">
    <div class="flex flex-wrap items-center gap-4 p-4 bg-gray-50 border rounded-lg">
      <span class="text-sm font-bold text-gray-700">公開設定</span>
      <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer toggle-invert">
        <input type="hidden" name="isPrivate" value="false">
        <input type="checkbox" name="isPrivate" value="true" class="toggle-input sr-only" aria-label="非公開フラグ">
        <span class="toggle-track"><span class="toggle-knob"></span></span>
        <span class="toggle-state">
          <span class="state-off">非公開</span>
          <span class="state-on">公開</span>
        </span>
      </label>
      <span class="h-6 w-px bg-gray-300"></span>
      <label class="inline-flex items-center gap-2 text-sm font-medium cursor-pointer">
        <input type="hidden" name="excludeFromRanking" value="false">
        <input type="checkbox" name="excludeFromRanking" value="true" class="w-4 h-4 text-amber-600 border-gray-300 rounded">
        <span>ランキングから除外する</span>
      </label>
    </div>

    <div class="p-4 bg-gray-50 border rounded-lg space-y-3">
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-bold text-gray-700">レシピタイプ</span>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="single" class="w-4 h-4 text-blue-600 border-gray-300" checked>
          <span>従来レシピ</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="set" class="w-4 h-4 text-blue-600 border-gray-300">
          <span>セットメニュー</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="arrange" class="w-4 h-4 text-blue-600 border-gray-300">
          <span>アレンジメニュー</span>
        </label>
      </div>
      <div id="set-type-section" class="hidden">
        <p class="text-sm font-bold text-gray-700 mb-2">セット種別</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="morning" class="w-4 h-4 text-blue-600 border-gray-300">
            <span>モーニング</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="lunch" class="w-4 h-4 text-blue-600 border-gray-300">
            <span>ランチ</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="dinner" class="w-4 h-4 text-blue-600 border-gray-300">
            <span>ディナー</span>
          </label>
        </div>
      </div>
      <p class="text-xs text-gray-500">セットメニューを選ぶとURL・画像・調味料は登録せず、既存レシピから構成します。必要に応じて食材を追加できます。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block mb-1 text-sm font-bold">レシピ名 *</label>
        <input type="text" name="name" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">よみ</label>
        <input type="text" name="yomi" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="よみがな">
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">メニュー *</label>
        <input type="text" name="menu" list="menu-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
        <datalist id="menu-list">
          <% (menuList || []).forEach(name => { %>
            <option value="<%= name %>"></option>
          <% }); %>
        </datalist>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">種類 *</label>
        <input type="text" name="kind" list="kind-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 主菜 / 副菜 / デザート など" required>
        <datalist id="kind-list">
          <% (kindList || []).forEach(kind => { %>
            <option value="<%= kind %>"></option>
          <% }); %>
        </datalist>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">ジャンル *</label>
        <select name="junle" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
          <option value="">ジャンルを選択</option>
          <% junleList.forEach(junle => { %>
            <option value="<%= junle %>"><%= junle %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">調理方法 *</label>
        <input type="text" name="cook" list="cook-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 炒める / 茹でる" required>
        <datalist id="cook-list">
          <% (cookList || []).forEach(cook => { %>
            <option value="<%= cook %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div id="basic-menu-section">
        <p class="block mb-2 text-sm font-bold text-gray-700">基本メニュー</p>
        <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer">
          <input type="hidden" name="basicMenu" value="false">
          <input type="checkbox" name="basicMenu" value="true" class="toggle-input sr-only" aria-label="基本メニューフラグ">
          <span class="toggle-track"><span class="toggle-knob"></span></span>
          <span class="toggle-state">
            <span class="state-off">OFF</span>
            <span class="state-on">ON</span>
          </span>
          <span>基本メニューにする</span>
        </label>
      </div>
      <div id="material-menu-section">
        <p class="block mb-2 text-sm font-bold text-gray-700">素材フラグ</p>
        <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer">
          <input type="hidden" name="material" value="false">
          <input type="checkbox" name="material" value="true" class="toggle-input sr-only" aria-label="素材フラグ">
          <span class="toggle-track"><span class="toggle-knob"></span></span>
          <span class="toggle-state">
            <span class="state-off">OFF</span>
            <span class="state-on">ON</span>
          </span>
          <span>素材メニューにする</span>
        </label>
      </div>
      <div id="makeahead-menu-section">
        <p class="block mb-2 text-sm font-bold text-gray-700">つくりおき</p>
        <label class="inline-flex items-center gap-3 text-sm font-medium cursor-pointer">
          <input type="hidden" name="makeAhead" value="false">
          <input type="checkbox" name="makeAhead" value="true" class="toggle-input sr-only" aria-label="つくりおきフラグ">
          <span class="toggle-track"><span class="toggle-knob"></span></span>
          <span class="toggle-state">
            <span class="state-off">OFF</span>
            <span class="state-on">ON</span>
          </span>
          <span>つくりおき向き</span>
        </label>
      </div>
      <div class="md:col-span-2" id="season-menu-section">
        <label class="block mb-1 text-sm font-bold">旬な季節</label>
        <div class="flex flex-wrap gap-3 text-sm">
          <% ['春','夏','秋','冬'].forEach(season => { %>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" name="season[]" value="<%= season %>" class="w-4 h-4 text-blue-600 border-gray-300 rounded">
              <span><%= season %></span>
            </label>
          <% }); %>
        </div>
        <p class="text-xs text-gray-500 mt-1">春(3-5月)、夏(6-9月)、秋(10-11月)、冬(12-2月)</p>
      </div>
      <div class="md:col-span-2" id="menu-url-section">
        <label class="block mb-1 text-sm font-bold">URL *</label>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <input type="url" name="url" id="menu-url-input" class="flex-1 border rounded-md px-3 py-2 bg-gray-50" placeholder="https://example.com" required>
          <button type="button" id="menu-url-open" class="inline-flex items-center gap-1 px-3 py-2 text-sm border border-gray-300 rounded text-gray-700 hover:bg-gray-50">
            <i data-lucide="external-link" class="w-4 h-4"></i>
            <span>リンクを開く</span>
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1">URLを入力するとボタンから別タブで確認できます。</p>
      </div>
      <div class="md:col-span-2" id="menu-image-section">
        <label class="block mb-1 text-sm font-bold">画像URL</label>
        <div class="flex flex-col md:flex-row md:items-start gap-4">
          <div class="flex-1 space-y-2">
            <input type="url" name="imageUrl" id="image-url-input" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="https://example.com/image.jpg">
            <p class="text-xs text-gray-500">画像の直リンクを入力すると右側にプレビューが表示されます。</p>
          </div>
          <div class="w-full md:w-48">
            <div class="relative w-full h-32 border border-dashed border-gray-300 rounded bg-gray-50 flex items-center justify-center overflow-hidden">
              <img id="image-url-preview" src="" alt="画像プレビュー" class="hidden object-cover w-full h-full">
              <span id="image-url-placeholder" class="text-xs text-gray-400">プレビューなし</span>
            </div>
          </div>
        </div>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">調理時間 (分) *</label>
        <input type="number" name="time" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div>
        <label class="block mb-1 text-sm font-bold">人数 *</label>
        <input type="number" name="people" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">SV</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <div>
            <label class="block mb-1 text-xs text-gray-500">主食SV</label>
            <input type="number" name="servings[staple]" min="0" step="0.1" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 1.0">
          </div>
          <div>
            <label class="block mb-1 text-xs text-gray-500">副菜SV</label>
            <input type="number" name="servings[sideDish]" min="0" step="0.1" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 1.0">
          </div>
          <div>
            <label class="block mb-1 text-xs text-gray-500">主菜SV</label>
            <input type="number" name="servings[mainDish]" min="0" step="0.1" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 1.0">
          </div>
          <div>
            <label class="block mb-1 text-xs text-gray-500">牛乳・乳製品SV</label>
            <input type="number" name="servings[dairy]" min="0" step="0.1" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 1.0">
          </div>
          <div>
            <label class="block mb-1 text-xs text-gray-500">果物SV</label>
            <input type="number" name="servings[fruit]" min="0" step="0.1" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="例: 1.0">
          </div>
        </div>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">コメント</label>
        <textarea name="comment" rows="4" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="レシピに関するメモや補足を書いてください"></textarea>
      </div>
    </div>

    <hr class="my-6">

    <div id="set-menu-section" class="hidden">
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">セットに含めるメニュー</label>
        <button type="button" id="open-set-menu-modal" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-blue-50 border-blue-300 text-blue-800 hover:bg-blue-100">
          <span class="text-xl leading-none">＋</span><span class="ml-1">メニューを追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="set-menu-list" class="space-y-2 text-sm text-gray-500">メニューを追加してください</div>
      </div>
      <p class="text-xs text-gray-500 mt-2">セットメニューや自分自身は追加できません。</p>
    </div>

    <input type="hidden" id="arrange-base-input" value="">
    <div id="arrange-base-section" class="hidden">
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">アレンジ元メニュー</label>
        <button type="button" id="open-arrange-base-modal" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-emerald-50 border-emerald-300 text-emerald-800 hover:bg-emerald-100">
          <span class="text-xl leading-none">＋</span><span class="ml-1">メニューを選択</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="arrange-base-selected" class="space-y-2 text-sm text-gray-500">メニューを選択してください</div>
      </div>
      <p class="text-xs text-gray-500 mt-2">アレンジの元になるメニューを1つ以上選択してください。</p>
    </div>

    <div id="ingredients-section">
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">食材</label>
        <button type="button" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100" onclick="addIngredient()">
          <span class="text-xl leading-none">＋</span><span class="ml-1">食材を追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="ingredients-list" class="space-y-2 text-sm text-gray-500">食材を追加してください</div>
      </div>
    </div>

    <hr class="my-6">

    <div id="seasonings-section">
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">調味料</label>
        <button type="button" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100" onclick="addSeasoning()">
          <span class="text-xl leading-none">＋</span><span class="ml-1">調味料を追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="seasonings-list" class="space-y-2 text-sm text-gray-500">調味料を追加してください</div>
      </div>
    </div>

    <div class="text-right mt-8">
      <button type="submit" class="inline-flex items-center space-x-2 px-5 py-2 rounded bg-gray-900 text-white hover:bg-gray-800">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>レシピを保存</span>
      </button>
    </div>
  </form>
</div>

<script>
  // --- 新しい食材追加モーダル用JS ---
  let currentIngredientTab = 'search';

  function setIngredientTab(tab) {
    currentIngredientTab = tab;
    document.querySelectorAll('.ingredient-tab-btn').forEach(btn => {
      btn.classList.remove('bg-gray-200', 'text-black');
      btn.classList.add('text-gray-700');
    });
    const activeBtn = document.getElementById(`tab-btn-${tab}`);
    activeBtn.classList.remove('text-gray-700');
    activeBtn.classList.add('bg-gray-200', 'text-black');

    if (tab === 'favorite') {
      document.getElementById('ingredient-search').value = '';
      document.getElementById('ingredient-genre-filter').selectedIndex = 0;
    }

    fetchIngredients();
  }

  let ING_GENRE = '';
  const ING_GENRES = <%- JSON.stringify(genreList || []) %>;
  function paintIngGenres(){
    const holder = document.getElementById('ingredient-genres'); if (!holder) return;
    holder.innerHTML=''; holder.className = 'flex items-center gap-2';
    const label = document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
    const sel = document.createElement('select'); sel.className='border rounded px-3 py-2'; sel.id='ingredient-genre-filter';
    const all=['すべて',...ING_GENRES];
    all.forEach((lb,idx)=>{ const val=idx===0?'':lb; const op=document.createElement('option'); op.value=val; op.textContent=lb; if(String(ING_GENRE||'')===String(val||'')) op.selected=true; sel.appendChild(op); });
    sel.addEventListener('change', ()=>{ ING_GENRE = sel.value; fetchIngredients(); });
    holder.appendChild(label); holder.appendChild(sel);
  }

  async function fetchIngredients() {
    const keyword = document.getElementById('ingredient-search')?.value || '';
    const genreFilter = ING_GENRE || '';
    const params = new URLSearchParams();
    params.append('keyword', keyword);
    params.append('tab', currentIngredientTab);
    if (genreFilter) {
      params.append('genre', genreFilter);
    }
    if (currentIngredientTab === 'favorite') {
      params.append('favorite', true);
    }
    if (currentIngredientTab === 'recent') {
      params.append('recent', true);
    }

    const res = await fetch('/admin/api/ingredients?' + params.toString());
    let ingredients = await res.json();
    // フロント側で再度絞り込み（yomi対応, サーバー側で未対応の場合）
    if (keyword && Array.isArray(ingredients)) {
      ingredients = ingredients.filter(item =>
        (item.ingredient && item.ingredient.includes(keyword)) ||
        (item.yomi && item.yomi.includes(keyword)) ||
        (item.classification && item.classification.includes(keyword)) ||
        (item.unit && Array.isArray(item.unit) && item.unit.some(u => u.includes(keyword)))
      );
    }
    renderIngredientList(ingredients);
  }

  // 食材リスト描画（カード全体クリックで選択）
  function renderIngredientList(ingredients) {
    const list = document.getElementById('ingredient-tags');
    const selected = document.getElementById('ingredient-selected');
    if (!list || !selected) return;
    list.innerHTML = '';
    selected.classList.add('hidden');
    selected.innerHTML = '';
    if (!ingredients || ingredients.length === 0) {
      list.innerHTML = '<p class="text-sm text-gray-500">該当する食材が見つかりません</p>';
      return;
    }

    let selectedIngredientId = '';

    function showSelected(item) {
      selected.classList.remove('hidden');
      selected.innerHTML = '';
      const label = item.ingredient || '';
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3';
      const info = document.createElement('div');
      info.className = 'flex-1';
      info.innerHTML = `<div class=\"font-semibold\">${label}</div><div class=\"text-xs text-gray-600\">カテゴリ: ${item.classification || ''}</div>`;
      const hiddenId = document.createElement('input');
      hiddenId.type = 'hidden';
      hiddenId.value = String(item._id);
      const amount = document.createElement('input');
      amount.type = 'number';
      amount.min = '0';
      amount.step = '0.1';
      amount.className = 'w-24 border rounded px-2 py-1';
      const units = Array.isArray(item.unit) ? item.unit : (item.unit ? [item.unit] : []);
      let unitEl;
      if (units.length) {
        unitEl = document.createElement('select');
        unitEl.className = 'w-28 border rounded px-2 py-1';
        units.forEach(u => {
          const op = document.createElement('option');
          op.value = u;
          op.textContent = u;
          unitEl.appendChild(op);
        });
      } else {
        unitEl = document.createElement('input');
        unitEl.className = 'w-24 border rounded px-2 py-1';
      }
      const addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.textContent = '追加';
      addBtn.className = 'px-3 py-1.5 rounded bg-blue-600 text-white text-sm';
      addBtn.addEventListener('click', () => {
        addIngredientFromSearch(String(item._id), label, units, item.classification || '', item.short_nutrition || '', item.imageUrl || '');
        const cont = document.getElementById('ingredients-list');
        const last = cont.lastElementChild;
        if (last) {
          const inputs = last.querySelectorAll('input, select');
          if (inputs && inputs.length >= 3) {
            inputs[1].value = amount.value || '';
            const unitCtl = inputs[2];
            if (unitCtl && unitCtl.tagName === 'SELECT' && unitEl.tagName === 'SELECT') unitCtl.value = unitEl.value;
            else if (unitCtl) unitCtl.value = unitEl.value || '';
          }
        }
        document.getElementById('ingredient-modal').classList.add('hidden');
      });
      row.append(info, hiddenId, amount, unitEl, addBtn);
      selected.appendChild(row);
    }

    function paintSelectedRow() {
      list.querySelectorAll('[data-item-id]').forEach((row) => {
        const isSelected = row.dataset.itemId === selectedIngredientId;
