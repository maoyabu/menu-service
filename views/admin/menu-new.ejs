<script>
  // カテゴリリスト取得処理を削除（カテゴリのセレクトボックスも削除したため）

  function initImagePreview(inputId, imgId, placeholderId) {
    const input = document.getElementById(inputId);
    const img = document.getElementById(imgId);
    const placeholder = document.getElementById(placeholderId);

    const updatePreview = () => {
      const url = (input?.value || '').trim();
      if (url) {
        if (img) {
          img.src = url;
          img.classList.remove('hidden');
        }
        if (placeholder) {
          placeholder.classList.add('hidden');
        }
      } else {
        if (img) {
          img.src = '';
          img.classList.add('hidden');
        }
        if (placeholder) {
          placeholder.classList.remove('hidden');
        }
      }
    };

    input?.addEventListener('input', updatePreview);
    updatePreview();
  }

  function initUrlOpener(inputId, buttonId) {
    const input = document.getElementById(inputId);
    const button = document.getElementById(buttonId);
    if (!button) return;
    button.addEventListener('click', () => {
      const url = (input?.value || '').trim();
      if (url) {
        const features = 'noopener=yes,noreferrer=yes,width=1200,height=800,resizable=yes,scrollbars=yes';
        window.open(url, 'menuLinkWindow', features);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 初期描画用食材をEJSから受け取り
    const initialIngredients = <%- JSON.stringify(initialIngredients || []) %>;
    const resultsEl = document.getElementById('ingredient-results');
    if (resultsEl) {
      renderIngredientList(initialIngredients);
    }
    // 初期描画用調味料
    const initialSeasonings = <%- JSON.stringify(initialSeasonings || []) %>;
    const seasoningResultsEl = document.getElementById('seasoning-results');
    if (seasoningResultsEl) {
      renderSeasoningList(initialSeasonings);
    }

    initUrlOpener('menu-url-input', 'menu-url-open');
    initImagePreview('image-url-input', 'image-url-preview', 'image-url-placeholder');

    if (typeof window.refreshLucideIcons === 'function') {
      window.refreshLucideIcons();
    }

    // 栄養情報の短縮バージョン表示（ingredients）
    document.querySelectorAll('#ingredients-list .flex').forEach(wrapper => {
      const hiddenInput = wrapper.querySelector('input[type="hidden"][name="ingredient_ids[]"]');
      if (!hiddenInput) return;
      const ingredientId = hiddenInput.value;
      // nutritionSpanは3番目の子（amount, unit, nutrition, removeBtn）
      const nutritionSpan = wrapper.querySelector('span.text-gray-500.text-sm');
      if (!nutritionSpan) return;
      // initialIngredientsから該当IDを探す
      const matchedIngredient = initialIngredients.find(item => item._id === ingredientId);
      // Use short_nutrition instead of nutrition
      const nutrition = matchedIngredient?.short_nutrition;
      nutritionSpan.textContent = nutrition || '-';
    });

    // 栄養情報の短縮バージョン表示（seasonings）
    document.querySelectorAll('#seasonings-list .flex').forEach(wrapper => {
      const hiddenInput = wrapper.querySelector('input[type="hidden"][name="seasoning_ids[]"]');
      if (!hiddenInput) return;
      const seasoningId = hiddenInput.value;
      const nutritionSpan = wrapper.querySelector('span.text-gray-500.text-sm');
      if (!nutritionSpan) return;
      // initialSeasoningsから該当IDを探す
      const matchedSeasoning = initialSeasonings.find(item => item._id === seasoningId);
      // Use short_nutrition instead of nutrition
      const nutrition = matchedSeasoning?.short_nutrition;
      nutritionSpan.textContent = nutrition || '-';
    });
  });
</script>

<script>
  const setMenuCandidates = <%- JSON.stringify(setMenuCandidates || []) %>;
  const arrangeMenuCandidates = <%- JSON.stringify(arrangeMenuCandidates || []) %>;
  const initialSetMenus = <%- JSON.stringify([]) %>;
  const initialArrangeBaseMenu = null;

  function setSectionEnabled(sectionId, enabled) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    section.classList.toggle('hidden', !enabled);
    section.querySelectorAll('input, select, textarea, button').forEach((el) => {
      if (el.id === 'open-set-menu-modal') return;
      if (enabled) {
        el.removeAttribute('disabled');
      } else {
        el.setAttribute('disabled', 'disabled');
      }
    });
  }

  function toggleRequired(inputId, isRequired) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (isRequired) input.setAttribute('required', 'required');
    else input.removeAttribute('required');
  }

  function applyMenuTypeState() {
    const checked = document.querySelector('input[name="menuType"]:checked');
    const isSet = checked && checked.value === 'set';
    const isArrange = checked && checked.value === 'arrange';
    setSectionEnabled('set-type-section', isSet);
    setSectionEnabled('set-menu-section', isSet);
    setSectionEnabled('arrange-base-section', isArrange);
    setSectionEnabled('menu-url-section', !isSet);
    setSectionEnabled('menu-image-section', !isSet);
    setSectionEnabled('ingredients-section', true);
    setSectionEnabled('seasonings-section', !isSet);
    setSectionEnabled('basic-menu-section', !isArrange);
    setSectionEnabled('material-menu-section', !isArrange);
    setSectionEnabled('makeahead-menu-section', !isArrange);
    setSectionEnabled('season-menu-section', !isArrange);
    toggleRequired('menu-url-input', !isSet);

    if (isArrange) {
      const menuInput = document.querySelector('input[name="menu"]');
      if (menuInput && !menuInput.value) menuInput.value = 'アレンジメニュー';
    }

    // setType validation handled on submit (checkbox group)
  }

  const setMenuState = {
    selected: new Map()
  };

  function normalizeText(value) {
    return String(value || '').toLowerCase();
  }

  function matchKeyword(item, keyword) {
    if (!keyword) return true;
    const text = [item.name, item.menu, item.kind, item.junle, item.cook].map(normalizeText).join(' ');
    return text.includes(keyword);
  }

  function renderSetMenuList() {
    const listEl = document.getElementById('set-menu-list');
    if (!listEl) return;
    const values = Array.from(setMenuState.selected.values());
    if (!values.length) {
      listEl.textContent = 'メニューを追加してください';
      return;
    }
    listEl.innerHTML = '';
    values.forEach((item) => {
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-wrap items-center gap-3 border border-gray-200 rounded p-2 bg-gray-50';

      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'set_menu_ids[]';
      hidden.value = item._id;
      wrap.appendChild(hidden);

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        wrap.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        wrap.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'min-w-[180px]';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      wrap.appendChild(info);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'ml-auto px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', () => {
        setMenuState.selected.delete(item._id);
        renderSetMenuList();
        renderSetMenuResults();
      });
      wrap.appendChild(removeBtn);

      listEl.appendChild(wrap);
    });
  }

  function renderSetMenuResults() {
    const resultsEl = document.getElementById('set-menu-results');
    if (!resultsEl) return;
    const keyword = normalizeText(document.getElementById('set-menu-keyword')?.value || '');
    const menuFilter = document.getElementById('set-menu-filter-menu')?.value || '';
    const kindFilter = document.getElementById('set-menu-filter-kind')?.value || '';
    const junleFilter = document.getElementById('set-menu-filter-junle')?.value || '';
    const cookFilter = document.getElementById('set-menu-filter-cook')?.value || '';

    const filtered = setMenuCandidates.filter((item) => {
      if (item.menuType === 'set') return false;
      if (menuFilter && item.menu !== menuFilter) return false;
      if (kindFilter && item.kind !== kindFilter) return false;
      if (junleFilter && item.junle !== junleFilter) return false;
      if (cookFilter && item.cook !== cookFilter) return false;
      return matchKeyword(item, keyword);
    });

    resultsEl.innerHTML = '';
    if (!filtered.length) {
      const empty = document.createElement('div');
      empty.className = 'text-sm text-gray-500';
      empty.textContent = '条件に一致するメニューがありません。';
      resultsEl.appendChild(empty);
      return;
    }

    filtered.forEach((item) => {
      const isSelected = setMenuState.selected.has(item._id);
      const row = document.createElement('div');
      row.dataset.itemId = String(item._id || '');
      row.className = `flex items-start gap-3 border rounded p-2 cursor-pointer transition ${isSelected ? 'bg-blue-50 border-blue-300 ring-2 ring-blue-200' : 'bg-white hover:bg-gray-50'}`;
      row.addEventListener('click', () => {
        if (setMenuState.selected.has(item._id)) setMenuState.selected.delete(item._id);
        else setMenuState.selected.set(item._id, item);
        renderSetMenuList();
        renderSetMenuResults();
      });

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        row.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        row.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'flex-1';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      row.appendChild(info);

      resultsEl.appendChild(row);
    });
  }

  const arrangeBaseState = {
    selected: new Map()
  };

  function renderArrangeBaseSelected() {
    const holder = document.getElementById('arrange-base-selected');
    const hiddenInput = document.getElementById('arrange-base-input');
    if (!holder) return;
    const values = Array.from(arrangeBaseState.selected.values());
    if (!values.length) {
      holder.textContent = 'メニューを選択してください';
      if (hiddenInput) hiddenInput.value = '';
      return;
    }
    if (hiddenInput) hiddenInput.value = values.map((item) => item._id).join(',');
    holder.innerHTML = '';
    values.forEach((item) => {

    const wrap = document.createElement('div');
    wrap.className = 'flex flex-wrap items-center gap-3 border border-gray-200 rounded p-2 bg-gray-50';

    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'arrange_base_menu_id';
    hidden.value = item._id;
    wrap.appendChild(hidden);

    if (item.imageUrl) {
      const img = document.createElement('img');
      img.src = item.imageUrl;
      img.alt = item.name || 'menu image';
      img.className = 'w-12 h-12 rounded object-cover';
      wrap.appendChild(img);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
      placeholder.textContent = 'NO IMG';
      wrap.appendChild(placeholder);
    }

    const info = document.createElement('div');
    info.className = 'min-w-[180px]';
    const title = document.createElement('div');
    title.className = 'font-medium text-gray-800';
    title.textContent = item.name || '名称未設定';
    const meta = document.createElement('div');
    meta.className = 'text-xs text-gray-500';
    meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
    info.appendChild(title);
    info.appendChild(meta);
    wrap.appendChild(info);

    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'ml-auto px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
    removeBtn.textContent = '×';
    removeBtn.addEventListener('click', () => {
      arrangeBaseState.selected.delete(item._id);
      renderArrangeBaseSelected();
      renderArrangeBaseResults();
    });
    wrap.appendChild(removeBtn);

    holder.appendChild(wrap);
    });
  }

  function renderArrangeBaseResults() {
    const resultsEl = document.getElementById('arrange-base-results');
    if (!resultsEl) return;
    const keyword = normalizeText(document.getElementById('arrange-base-keyword')?.value || '');
    const menuFilter = document.getElementById('arrange-base-filter-menu')?.value || '';
    const kindFilter = document.getElementById('arrange-base-filter-kind')?.value || '';
    const junleFilter = document.getElementById('arrange-base-filter-junle')?.value || '';
    const cookFilter = document.getElementById('arrange-base-filter-cook')?.value || '';

    const filtered = arrangeMenuCandidates.filter((item) => {
      if (item.menuType === 'set') return false;
      if (menuFilter && item.menu !== menuFilter) return false;
      if (kindFilter && item.kind !== kindFilter) return false;
      if (junleFilter && item.junle !== junleFilter) return false;
      if (cookFilter && item.cook !== cookFilter) return false;
      return matchKeyword(item, keyword);
    });

    resultsEl.innerHTML = '';
    if (!filtered.length) {
      const empty = document.createElement('div');
      empty.className = 'text-sm text-gray-500';
      empty.textContent = '条件に一致するメニューがありません。';
      resultsEl.appendChild(empty);
      return;
    }

    filtered.forEach((item) => {
      const isSelected = arrangeBaseState.selected.has(item._id);
      const row = document.createElement('div');
      row.dataset.itemId = String(item._id || '');
      row.className = `flex items-start gap-3 border rounded p-2 cursor-pointer transition ${isSelected ? 'bg-blue-50 border-blue-300 ring-2 ring-blue-200' : 'bg-white hover:bg-gray-50'}`;
      row.addEventListener('click', () => {
        if (arrangeBaseState.selected.has(item._id)) arrangeBaseState.selected.delete(item._id);
        else arrangeBaseState.selected.set(item._id, item);
        renderArrangeBaseSelected();
        renderArrangeBaseResults();
      });

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        row.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        row.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'flex-1';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      row.appendChild(info);

      resultsEl.appendChild(row);
    });
  }

  function openArrangeBaseModal() {
    const modal = document.getElementById('arrange-base-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    renderArrangeBaseResults();
  }

  function closeArrangeBaseModal() {
    const modal = document.getElementById('arrange-base-modal');
    if (!modal) return;
    modal.classList.add('hidden');
  }

  function openSetMenuModal() {
    const modal = document.getElementById('set-menu-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    renderSetMenuResults();
  }

  function closeSetMenuModal() {
    const modal = document.getElementById('set-menu-modal');
    if (!modal) return;
    modal.classList.add('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('open-set-menu-modal');
    const closeBtn = document.getElementById('set-menu-close');
    const applyBtn = document.getElementById('set-menu-apply');
    const overlay = document.getElementById('set-menu-overlay');
    const arrangeOpenBtn = document.getElementById('open-arrange-base-modal');
    const arrangeCloseBtn = document.getElementById('arrange-base-close');
    const arrangeOverlay = document.getElementById('arrange-base-overlay');

    if (openBtn) openBtn.addEventListener('click', openSetMenuModal);
    if (closeBtn) closeBtn.addEventListener('click', closeSetMenuModal);
    if (applyBtn) applyBtn.addEventListener('click', closeSetMenuModal);
    if (overlay) overlay.addEventListener('click', closeSetMenuModal);
    if (arrangeOpenBtn) arrangeOpenBtn.addEventListener('click', openArrangeBaseModal);
    if (arrangeCloseBtn) arrangeCloseBtn.addEventListener('click', closeArrangeBaseModal);
    if (arrangeOverlay) arrangeOverlay.addEventListener('click', closeArrangeBaseModal);

    ['set-menu-keyword','set-menu-filter-menu','set-menu-filter-kind','set-menu-filter-junle','set-menu-filter-cook']
      .forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', renderSetMenuResults);
        el.addEventListener('change', renderSetMenuResults);
      });
    ['arrange-base-keyword','arrange-base-filter-menu','arrange-base-filter-kind','arrange-base-filter-junle','arrange-base-filter-cook']
      .forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', renderArrangeBaseResults);
        el.addEventListener('change', renderArrangeBaseResults);
      });

    initialSetMenus.forEach((item) => {
      if (!item || !item._id) return;
      setMenuState.selected.set(item._id, item);
    });

    (Array.isArray(initialArrangeBaseMenu) ? initialArrangeBaseMenu : [initialArrangeBaseMenu]).forEach((item) => {
      if (!item || !item._id) return;
      arrangeBaseState.selected.set(item._id, item);
    });
    renderArrangeBaseSelected();

    document.querySelectorAll('input[name="menuType"]').forEach((el) => {
      el.addEventListener('change', applyMenuTypeState);
    });

    applyMenuTypeState();
    renderSetMenuList();

    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', (e) => {
        const checked = document.querySelector('input[name="menuType"]:checked');
        const isSet = checked && checked.value === 'set';
        const isArrange = checked && checked.value === 'arrange';
        if (isSet) {
          const any = Array.from(document.querySelectorAll('input[name="setType[]"]')).some((el) => el.checked);
          if (!any) {
            e.preventDefault();
            alert('セット種別を1つ以上選択してください。');
          }
          return;
        }
        if (isArrange) {
          if (!arrangeBaseState.selected.size) {
            e.preventDefault();
            alert('アレンジ元メニューを選択してください。');
          }
        }
      });
    }
  });
</script>

