<div class="max-w-4xl mx-auto bg-white p-8 rounded-md shadow">
  <h1 class="text-2xl font-semibold mb-2 flex items-center space-x-2">
    <i data-lucide="chef-hat" class="w-6 h-6 text-gray-700"></i>
    <span>レシピ編集</span>
  </h1>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <p class="text-sm text-gray-500">レシピの内容を更新してください</p>
    <a href="<%= backToListUrl %>" class="inline-flex items-center text-sm text-blue-600 hover:underline">
      <i data-lucide="arrow-left" class="w-4 h-4 mr-1"></i>
      <span>一覧に戻る</span>
    </a>
  </div>

  <form action="/admin/menu-edit/<%= menu._id %>?_method=PUT" method="POST" class="space-y-8">
    <input type="hidden" name="filters" value="<%= filters || '' %>">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 1. レシピ名* -->
      <div>
        <label class="block mb-1 text-sm font-bold">レシピ名 *</label>
        <input type="text" name="name" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.name %>" required>
      </div>
      <!-- 2. よみ -->
      <div>
        <label class="block mb-1 text-sm font-bold">よみ</label>
        <input type="text" name="yomi" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.yomi %>" placeholder="よみがな">
      </div>
      <!-- 3. メニュー* -->
      <div>
        <label class="block mb-1 text-sm font-bold">メニュー *</label>
        <input type="text" name="menu" list="menu-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.menu %>" required>
        <datalist id="menu-list">
          <% (menuList || []).forEach(name => { %>
            <option value="<%= name %>"></option>
          <% }) %>
        </datalist>
      </div>
      <!-- 4. 種類* -->
      <div>
        <label class="block mb-1 text-sm font-bold">種類 *</label>
        <input type="text" name="kind" list="kind-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.kind || '' %>" placeholder="例: 主菜 / 副菜 / デザート" required>
        <datalist id="kind-list">
          <% (kindList || []).forEach(kind => { %>
            <option value="<%= kind %>"></option>
          <% }) %>
        </datalist>
      </div>
      <!-- 5. ジャンル* -->
      <div>
        <label class="block mb-1 text-sm font-bold">ジャンル *</label>
        <select name="junle" class="w-full border rounded-md px-3 py-2 bg-gray-50" required>
          <option value="">ジャンルを選択</option>
          <% junleList.forEach(junle => { %>
            <option value="<%= junle %>" <%= menu.junle === junle ? 'selected' : '' %>><%= junle %></option>
          <% }) %>
        </select>
      </div>
      <!-- 6. 調理方法* -->
      <div>
        <label class="block mb-1 text-sm font-bold">調理方法 *</label>
        <input type="text" name="cook" list="cook-list" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.cook || '' %>" placeholder="例: 炒める / 茹でる" required>
        <datalist id="cook-list">
          <% (cookList || []).forEach(cook => { %>
            <option value="<%= cook %>"></option>
          <% }) %>
        </datalist>
      </div>
      <!-- 7. 素材フラグ -->
      <div class="flex items-center space-x-2">
        <input type="checkbox" id="material" name="material" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" <%= menu.material ? 'checked' : '' %>>
        <label for="material" class="text-sm font-bold text-gray-700">素材フラグ (ON/OFF)</label>
      </div>
      <div class="flex items-center space-x-2">
        <input type="checkbox" id="isPrivate" name="isPrivate" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" <%= menu.isPrivate ? 'checked' : '' %>>
        <label for="isPrivate" class="text-sm font-bold text-gray-700">非公開（一覧に表示しない）</label>
      </div>
      <!-- 8. URL* -->
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">URL *</label>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <input type="url" name="url" id="menu-url-input" class="flex-1 border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.url %>" placeholder="https://example.com" required>
          <button type="button" id="menu-url-open" class="inline-flex items-center gap-1 px-3 py-2 text-sm border border-gray-300 rounded text-gray-700 hover:bg-gray-50">
            <i data-lucide="external-link" class="w-4 h-4"></i>
            <span>リンクを開く</span>
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1">URLを入力するとボタンから別タブで確認できます。</p>
      </div>
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">画像URL</label>
        <div class="flex flex-col md:flex-row md:items-start gap-4">
          <div class="flex-1 space-y-2">
            <input type="url" name="imageUrl" id="image-url-input" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.imageUrl || '' %>" placeholder="https://example.com/image.jpg">
            <p class="text-xs text-gray-500">画像の直リンクを入力すると右側にプレビューが表示されます。</p>
          </div>
          <div class="w-full md:w-48">
            <div class="relative w-full h-32 border border-dashed border-gray-300 rounded bg-gray-50 flex items-center justify-center overflow-hidden">
              <img id="image-url-preview" src="<%= menu.imageUrl || '' %>" alt="画像プレビュー" class="object-cover w-full h-full <%= menu.imageUrl ? '' : 'hidden' %>">
              <span id="image-url-placeholder" class="text-xs text-gray-400 <%= menu.imageUrl ? 'hidden' : '' %>">プレビューなし</span>
            </div>
          </div>
        </div>
      </div>
      <!-- 9. 調理時間 (分)* -->
      <div>
        <label class="block mb-1 text-sm font-bold">調理時間 (分) *</label>
        <input type="number" name="time" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.time %>" required>
      </div>
      <!-- 10. 人数* -->
      <div>
        <label class="block mb-1 text-sm font-bold">人数 *</label>
        <input type="number" name="people" class="w-full border rounded-md px-3 py-2 bg-gray-50" value="<%= menu.people %>" required>
      </div>
      <!-- コメント -->
      <div class="md:col-span-2">
        <label class="block mb-1 text-sm font-bold">コメント</label>
        <textarea name="comment" rows="4" class="w-full border rounded-md px-3 py-2 bg-gray-50" placeholder="レシピに関するメモや補足を書いてください"><%= menu.comment || '' %></textarea>
      </div>
    </div>

    <hr class="my-6">

    <div>
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">食材</label>
        <button type="button" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100" onclick="addIngredient()">
          <span class="text-xl leading-none">＋</span><span class="ml-1">食材を追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="ingredients-list" class="space-y-2 text-sm text-gray-500">
          <% if (menu.ingredients && menu.ingredients.length) { %>
            <% menu.ingredients.forEach(ingredient => { %>
              <div class="ingredient-card flex flex-wrap items-center gap-2 border border-gray-200 rounded p-2 bg-gray-50">
                <input type="hidden" name="ingredient_ids[]" value="<%= ingredient._id %>">
                <span class="font-medium text-gray-800"><%= ingredient.name?.ingredient || '未設定' %></span>
                <span class="text-xs text-gray-500 px-2 py-1 bg-gray-100 rounded"><%= ingredient.name?.classification || '' %></span>
                <input type="number" name="ingredient_amounts[]" step="any" placeholder="量" class="w-20 border rounded-md px-2 py-1 text-sm" value="<%= ingredient.amount %>">
                <select name="ingredient_units[]" class="border rounded-md px-2 py-1 text-sm">
                  <% let units = (ingredient.name && ingredient.name.unit) ? [...ingredient.name.unit] : []; %>
                  <% if (ingredient.unit && !units.includes(ingredient.unit)) { units.unshift(ingredient.unit); } %>
                  <% units.forEach(u => { %>
                    <option value="<%= u %>" <%= u === ingredient.unit ? 'selected' : '' %>><%= u %></option>
                  <% }) %>
                </select>
                <button onclick="event.stopPropagation(); toggleIngredientDetail(this)" class="text-blue-500 hover:text-blue-700" title="栄養を見る">
                  <i data-lucide="info" class="w-4 h-4"></i>
                </button>
                <% if (ingredient.name && ingredient.name.nutrition) { %>
                  <span class="text-xs text-gray-400 ml-2">
                    <%= ingredient.name.nutrition %>
                  </span>
                <% } %>
                <button type="button" class="px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100 ml-auto" onclick="this.parentElement.remove()">×</button>
                <div class="mt-2 hidden text-xs text-gray-600 detail-section">
                  <div>水分: <%= ingredient.name?.water || '-' %>g　タンパク質: <%= ingredient.name?.protein || '-' %>g</div>
                  <div>脂質: <%= ingredient.name?.lipid || '-' %>g　炭水化物: <%= ingredient.name?.carbohydrate || '-' %>g</div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            食材を追加してください
          <% } %>
        </div>
      </div>
    </div>

    <hr class="my-6">

    <div>
      <div class="flex items-center justify-start gap-3">
        <label class="block mb-1 text-sm font-bold">調味料</label>
        <button type="button" class="inline-flex items-center border rounded px-3 py-1 text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100" onclick="addSeasoning()">
          <span class="text-xl leading-none">＋</span><span class="ml-1">調味料を追加</span>
        </button>
      </div>
      <div class="border rounded-lg p-4 bg-white shadow-sm space-y-2">
        <div id="seasonings-list" class="space-y-2 text-sm text-gray-500">
          <% if (menu.seasoning && menu.seasoning.length) { %>
            <% menu.seasoning.forEach(seasoning => { %>
              <div class="seasoning-card flex flex-wrap items-center gap-2 border border-gray-200 rounded p-2 bg-gray-50">
                <input type="hidden" name="seasoning_ids[]" value="<%= seasoning._id %>">
                <span class="font-medium text-gray-800"><%= seasoning.name?.seasoning || '未設定' %></span>
                <span class="text-xs text-gray-500 px-2 py-1 bg-gray-100 rounded"><%= seasoning.name?.classification || '' %></span>
                <input type="number" name="seasoning_amounts[]" step="any" placeholder="量" class="w-20 border rounded-md px-2 py-1 text-sm" value="<%= seasoning.amount %>">
                <select name="seasoning_units[]" class="border rounded-md px-2 py-1 text-sm">
                  <% let units = (seasoning.name && seasoning.name.unit) ? [...seasoning.name.unit] : []; %>
                  <% if (seasoning.unit && !units.includes(seasoning.unit)) { units.unshift(seasoning.unit); } %>
                  <% units.forEach(u => { %>
                    <option value="<%= u %>" <%= u === seasoning.unit ? 'selected' : '' %>><%= u %></option>
                  <% }) %>
                </select>
                <button onclick="event.stopPropagation(); toggleIngredientDetail(this)" class="text-blue-500 hover:text-blue-700" title="栄養を見る">
                  <i data-lucide="info" class="w-4 h-4"></i>
                </button>
                <% if (seasoning.name && seasoning.name.nutrition) { %>
                  <span class="text-xs text-gray-400 ml-2">
                    <%= seasoning.name.nutrition %>
                  </span>
                <% } %>
                <button type="button" class="px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100 ml-auto" onclick="this.parentElement.remove()">×</button>
                <div class="mt-2 hidden text-xs text-gray-600 detail-section">
                  <div>水分: <%= seasoning.name?.water || '-' %>g　タンパク質: <%= seasoning.name?.protein || '-' %>g</div>
                  <div>脂質: <%= seasoning.name?.lipid || '-' %>g　炭水化物: <%= seasoning.name?.carbohydrate || '-' %>g</div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            調味料を追加してください
          <% } %>
        </div>
      </div>
    </div>

    <div class="text-right mt-8">
      <button type="submit" class="inline-flex items-center space-x-2 px-5 py-2 rounded bg-blue-600 text-white hover:bg-blue-500">
        <i data-lucide="save" class="w-4 h-4"></i>
        <span>レシピを更新</span>
      </button>
    </div>
  </form>
</div>

<script>
  // --- 新しい食材追加モーダル用JS ---
  let currentIngredientTab = 'search';
  
  function setIngredientTab(tab) {
    currentIngredientTab = tab;

    // すべてのタブボタンから active クラスを除去
    document.querySelectorAll('.ingredient-tab-btn').forEach(btn => {
      btn.classList.remove('bg-gray-200', 'text-black');
      btn.classList.add('text-gray-700');
    });

    // 選択されたタブに active クラスを付与
    const activeBtn = document.getElementById(`tab-btn-${tab}`);
    activeBtn.classList.remove('text-gray-700');
    activeBtn.classList.add('bg-gray-200', 'text-black');

    // 検索ワードとジャンルフィルターの初期化
    if (tab === 'favorite' || tab === 'recent') {
      document.getElementById('ingredient-search').value = '';
    // no-op (chips UI)
    }

    fetchIngredients();
  }

  async function fetchIngredients() {
    const keyword = document.getElementById('ingredient-search')?.value || '';
    const genreFilter = ING_GENRE || '';
    const params = new URLSearchParams();
    params.append('keyword', keyword);
    params.append('tab', currentIngredientTab);
    if (genreFilter) params.append('genre', genreFilter);
    if (currentIngredientTab === 'favorite') params.append('favorite', true);

    const res = await fetch('/admin/api/ingredients?' + params.toString());
    const ingredients = await res.json();
    renderIngredientList(ingredients);
  }

  // 新しい食材リスト描画（お気に入り・詳細・カード全体クリックで追加）
  let ING_GENRE=''; const ING_GENRES=<%- JSON.stringify(genreList||[]) %>;
  function paintIngGenres(){ const holder=document.getElementById('ingredient-genres'); if(!holder) return; holder.innerHTML=''; holder.className='flex items-center gap-2'; const label=document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700'; const sel=document.createElement('select'); sel.className='border rounded px-3 py-2'; sel.id='ingredient-genre-filter'; const all=['すべて',...ING_GENRES]; all.forEach((lb,idx)=>{ const val=idx===0?'':lb; const op=document.createElement('option'); op.value=val; op.textContent=lb; if(String(ING_GENRE||'')===String(val||'')) op.selected=true; sel.appendChild(op); }); sel.addEventListener('change',()=>{ ING_GENRE=sel.value; fetchIngredients(); }); holder.appendChild(label); holder.appendChild(sel); }
  function renderIngredientList(items){ const tags=document.getElementById('ingredient-tags'); const selected=document.getElementById('ingredient-selected'); tags.innerHTML=''; selected.classList.add('hidden'); selected.innerHTML=''; if(!items||items.length===0){ tags.innerHTML='<p class="text-sm text-gray-500">該当する食材が見つかりません</p>'; return;} items.forEach(item=>{ const label=item.ingredient||''; const b=document.createElement('button'); b.type='button'; b.textContent=label; b.className='px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200'; b.addEventListener('click',()=>{ selected.classList.remove('hidden'); selected.innerHTML=''; const row=document.createElement('div'); row.className='flex items-center gap-3'; const info=document.createElement('div'); info.className='flex-1'; info.innerHTML=`<div class=\"font-semibold\">${label}</div><div class=\"text-xs text-gray-600\">カテゴリ: ${item.classification||''}</div>`; const hiddenId=document.createElement('input'); hiddenId.type='hidden'; hiddenId.value=String(item._id); const amount=document.createElement('input'); amount.type='number'; amount.min='0'; amount.step='0.1'; amount.className='w-24 border rounded px-2 py-1'; const units=Array.isArray(item.unit)?item.unit:(item.unit?[item.unit]:[]); let unitEl; if(units.length){ unitEl=document.createElement('select'); unitEl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); }); } else { unitEl=document.createElement('input'); unitEl.className='w-24 border rounded px-2 py-1'; } const addBtn=document.createElement('button'); addBtn.type='button'; addBtn.textContent='追加'; addBtn.className='px-3 py-1.5 rounded bg-blue-600 text-white text-sm'; addBtn.addEventListener('click',()=>{ addIngredientFromSearch(String(item._id),label,units,item.classification||'',item.short_nutrition||''); const cont=document.getElementById('ingredients-list'); const last=cont.lastElementChild; if(last){ const inputs=last.querySelectorAll('input, select'); if(inputs&&inputs.length>=3){ inputs[1].value=amount.value||''; const unitCtl=inputs[2]; if(unitCtl&&unitCtl.tagName==='SELECT' && unitEl.tagName==='SELECT') unitCtl.value=unitEl.value; else if(unitCtl) unitCtl.value=unitEl.value||''; }} document.getElementById('ingredient-modal').classList.add('hidden'); }); row.append(info,hiddenId,amount,unitEl,addBtn); selected.appendChild(row); }); tags.appendChild(b); }); }

  function openIngredientModal() {
    document.getElementById('ingredient-modal').classList.remove('hidden');
    paintIngGenres(); fetchIngredients();

    const searchInput = document.getElementById('ingredient-search');
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(ingredientSearchTimer);
        ingredientSearchTimer = setTimeout(() => {
          fetchIngredients();
        }, 300);
      });
      searchInput.dataset.bound = 'true';
    }
  }

  function closeIngredientModal() {
    document.getElementById('ingredient-modal').classList.add('hidden');
  }

  let ingredientSearchTimer;

  function addIngredientFromSearch(id, name, units, classification = '', nutrition = '') {
    const container = document.getElementById('ingredients-list');
    // Remove "食材を追加してください" if present
    if (container.textContent.trim() === '食材を追加してください') container.innerHTML = '';
    const wrapper = document.createElement('div');
    wrapper.className = 'flex flex-col sm:flex-row sm:items-center sm:justify-between border p-4 rounded-lg bg-gray-50';

    // hidden input
    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'ingredient_ids[]';
    hidden.value = id;

    // 上部: 名前＋分類
    const topDiv = document.createElement('div');
    topDiv.className = 'text-base font-medium text-gray-900';
    topDiv.innerHTML = `${name} <span class="ml-2 inline-block text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">${classification || '分類'}</span>`;

    // 下部: 分量・単位・栄養・削除
    const bottomDiv = document.createElement('div');
    bottomDiv.className = 'flex flex-wrap items-center gap-2 mt-2 sm:mt-0';

    // 分量
    const amount = document.createElement('input');
    amount.type = 'number';
    amount.step = 'any';
    amount.name = 'ingredient_amounts[]';
    amount.placeholder = '量';
    amount.className = 'w-20 border rounded-md px-2 py-1 text-sm';

    // 単位
    const unitSelect = document.createElement('select');
    unitSelect.name = 'ingredient_units[]';
    unitSelect.className = 'border rounded-md px-2 py-1 text-sm';
    units.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u;
      opt.textContent = u;
      unitSelect.appendChild(opt);
    });

    // 栄養情報（ダミー/空でも表示）
    const nutritionSpan = document.createElement('span');
    nutritionSpan.className = 'text-gray-500 text-sm';
    nutritionSpan.textContent = nutrition?.replace(/\s+/g, ' ').trim() || '-';

    // 削除ボタン
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
    removeBtn.textContent = '×';
    removeBtn.onclick = function () {
      wrapper.remove();
      // If no children, show placeholder
      if (container.children.length === 0) {
        container.innerHTML = '食材を追加してください';
      }
    };

    bottomDiv.appendChild(amount);
    bottomDiv.appendChild(unitSelect);
    bottomDiv.appendChild(nutritionSpan);
    bottomDiv.appendChild(removeBtn);

    wrapper.appendChild(hidden);
    wrapper.appendChild(topDiv);
    wrapper.appendChild(bottomDiv);
    container.appendChild(wrapper);

    const detailDiv = document.createElement('div');
    detailDiv.className = 'mt-2 hidden text-xs text-gray-600 detail-section';
    detailDiv.innerHTML = `
      <div>水分: -g　タンパク質: -g</div>
      <div>脂質: -g　炭水化物: -g</div>
    `;
    wrapper.appendChild(detailDiv);

    closeIngredientModal();
  }





  // 元のボタンをモーダル起動に変更
  function addIngredient() {
    openIngredientModal();
  }

  // --- 調味料追加モーダル用JS ---
  let currentSeasoningTab = 'search';
  function setSeasoningTab(tab) {
    currentSeasoningTab = tab;
    document.querySelectorAll('.seasoning-tab-btn').forEach(btn => {
      btn.classList.remove('bg-gray-200', 'text-black');
      btn.classList.add('text-gray-700');
    });
    const activeBtn = document.getElementById(`seasoning-tab-btn-${tab}`);
    activeBtn.classList.remove('text-gray-700');
    activeBtn.classList.add('bg-gray-200', 'text-black');

    if (tab === 'favorite' || tab === 'recent') {
      document.getElementById('seasoning-search').value = '';
      document.getElementById('seasoning-genre-filter').selectedIndex = 0;
    }

    fetchSeasonings();
  }

  async function fetchSeasonings() {
    const keyword = document.getElementById('seasoning-search')?.value || '';
    const genreFilter = document.getElementById('seasoning-genre-filter')?.value || '';
    const params = new URLSearchParams();
    params.append('keyword', keyword);
    params.append('tab', currentSeasoningTab);
    if (genreFilter) params.append('genre', genreFilter);
    if (currentSeasoningTab === 'favorite') params.append('favorite', true);

    const res = await fetch('/admin/api/seasonings?' + params.toString());
    const seasonings = await res.json();
    renderSeasoningList(seasonings);
  }

  function renderSeasoningList(seasonings) {
    const resultsContainer = document.getElementById('seasoning-results');
    resultsContainer.innerHTML = '';
    if (!seasonings || seasonings.length === 0) {
      resultsContainer.innerHTML = '<p class="text-sm text-gray-500">該当する調味料が見つかりません</p>';
      return;
    }

    seasonings.forEach(item => {
      const div = document.createElement('div');
      div.className = 'border p-2 rounded-md hover:bg-gray-50 cursor-pointer text-sm flex items-center gap-2';
      div.setAttribute('onclick', `addSeasoningFromSearch("${item._id}", "${item.seasoning}", ${JSON.stringify(item.unit)}, "${item.classification || ''}", "${item.nutrition || ''}")`);
      div.innerHTML = `
        <button type="button" class="favorite-btn mr-2" onclick="event.stopPropagation(); toggleFavorite(this, '${item._id}', 'seasoning')">
          <span class="favorite-icon">${item.isFavorite ? '★' : '☆'}</span>
        </button>
        <div class="flex-1">
          <div class="font-medium"><span class="seasoning-name">${item.seasoning}</span> <span class="text-xs text-gray-500">(${item.classification})</span></div>
          <div class="text-xs text-gray-600">単位: ${item.unit.join(', ')}</div>
        </div>
        <button onclick="event.stopPropagation(); toggleIngredientDetail(this)" class="text-blue-500 hover:text-blue-700" title="栄養を見る">
          <span class="inline-block">Info </span>
        </button>
        <button onclick="event.stopPropagation(); toggleFavorite(this, '${item._id}', 'seasoning')" class="${item.favorite ? 'text-yellow-400' : 'text-gray-400'} hover:text-yellow-500">${item.favorite ? '★' : '☆'}</button>
      `;
      // 栄養情報div
      const nutritionDiv = document.createElement('div');
      nutritionDiv.className = 'nutrition-info hidden text-xs text-gray-700 mt-1 w-full';
      nutritionDiv.innerHTML = item.nutrition ? item.nutrition : '栄養情報はありません';
      div.appendChild(nutritionDiv);
      resultsContainer.appendChild(div);
    });
  }

  function openSeasoningModal() {
    document.getElementById('seasoning-modal').classList.remove('hidden');
    paintSeaGenres(); fetchSeasonings();

    const searchInput = document.getElementById('seasoning-search');
    if (searchInput && !searchInput.dataset.bound) {
      searchInput.addEventListener('input', (e) => {
        clearTimeout(seasoningSearchTimer);
        seasoningSearchTimer = setTimeout(() => {
          fetchSeasonings();
        }, 300);
      });
      searchInput.dataset.bound = 'true';
    }
  }

  function closeSeasoningModal() {
    document.getElementById('seasoning-modal').classList.add('hidden');
  }

  let seasoningSearchTimer;

  // 分類プルダウン生成（調味料）
  function paintSeaGenres(){
    const holder = document.getElementById('seasoning-genres'); if(!holder) return; holder.innerHTML=''; holder.className='flex items-center gap-2';
    // サーバからの分類一覧はメニュー新規と違い変数を持っていないため、初回fetchで取得
    // 簡易にAPIへメタリクエスト
    (async()=>{
      try {
        const metaUrl = new URL('/admin/api/seasonings', location.origin); metaUrl.searchParams.set('meta','genres');
        const meta = await (await fetch(metaUrl.toString())).json();
        const cats = Array.isArray(meta?.genres) ? meta.genres : [];
        const label=document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
        const sel=document.createElement('select'); sel.className='border rounded px-3 py-2'; sel.id='seasoning-genre-filter';
        const all=['すべて', ...cats];
        all.forEach((lb,idx)=>{ const val=idx===0?'':lb; const op=document.createElement('option'); op.value=val; op.textContent=lb; sel.appendChild(op); });
        sel.addEventListener('change', ()=>{ fetchSeasonings(); });
        holder.appendChild(label); holder.appendChild(sel);
      } catch(_) {}
    })();
  }

  function addSeasoningFromSearch(id, name, units, classification = '', nutrition = '') {
    const container = document.getElementById('seasonings-list');
    // Remove "調味料を追加してください" if present
    if (container.textContent.trim() === '調味料を追加してください') container.innerHTML = '';
    const wrapper = document.createElement('div');
    wrapper.className = 'flex flex-col sm:flex-row sm:items-center sm:justify-between border p-4 rounded-lg bg-gray-50';

    // hidden input
    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'seasoning_ids[]';
    hidden.value = id;

    // 上部: 名前＋分類
    const topDiv = document.createElement('div');
    topDiv.className = 'text-base font-medium text-gray-900';
    topDiv.innerHTML = `${name} <span class="ml-2 inline-block text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">${classification || '分類'}</span>`;

    // 下部: 分量・単位・栄養・削除
    const bottomDiv = document.createElement('div');
    bottomDiv.className = 'flex flex-wrap items-center gap-2 mt-2 sm:mt-0';

    // 分量
    const amount = document.createElement('input');
    amount.type = 'number';
    amount.step = 'any';
    amount.name = 'seasoning_amounts[]';
    amount.placeholder = '量';
    amount.className = 'w-20 border rounded-md px-2 py-1 text-sm';

    // 単位
    const unitSelect = document.createElement('select');
    unitSelect.name = 'seasoning_units[]';
    unitSelect.className = 'border rounded-md px-2 py-1 text-sm';
    units.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u;
      opt.textContent = u;
      unitSelect.appendChild(opt);
    });

    // 栄養情報（ダミー/空でも表示）
    const nutritionSpan = document.createElement('span');
    nutritionSpan.className = 'text-gray-500 text-sm';
    nutritionSpan.textContent = nutrition?.replace(/\s+/g, ' ').trim() || '-';

    // 削除ボタン
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
    removeBtn.textContent = '×';
    removeBtn.onclick = function () {
      wrapper.remove();
      // If no children, show placeholder
      if (container.children.length === 0) {
        container.innerHTML = '調味料を追加してください';
      }
    };

    bottomDiv.appendChild(amount);
    bottomDiv.appendChild(unitSelect);
    bottomDiv.appendChild(nutritionSpan);
    bottomDiv.appendChild(removeBtn);

    wrapper.appendChild(hidden);
    wrapper.appendChild(topDiv);
    wrapper.appendChild(bottomDiv);
    container.appendChild(wrapper);

    const detailDiv = document.createElement('div');
    detailDiv.className = 'mt-2 hidden text-xs text-gray-600 detail-section';
    detailDiv.innerHTML = `
      <div>水分: -g　タンパク質: -g</div>
      <div>脂質: -g　炭水化物: -g</div>
    `;
    wrapper.appendChild(detailDiv);

    closeSeasoningModal();
    fetch('/admin/api/seasoning-used/' + id, { method: 'POST' });
  }

  // 元のボタンをモーダル起動に変更
  function addSeasoning() {
    openSeasoningModal();
  }

function setSeasoningTab(tab) {
  currentSeasoningTab = tab;
  document.querySelectorAll('.seasoning-tab-btn').forEach(btn => {
    btn.classList.remove('bg-gray-300');
  });
  document.getElementById(`seasoning-tab-btn-${tab}`).classList.add('bg-gray-300');

  if (tab === 'favorite' || tab === 'recent') {
    document.getElementById('seasoning-search').value = '';
    document.getElementById('seasoning-genre-filter').selectedIndex = 0;
  }

  fetchSeasonings();
}

async function fetchSeasonings() {
  const keyword = document.getElementById('seasoning-search')?.value || '';
  const genreFilter = document.getElementById('seasoning-genre-filter')?.value || '';
  const params = new URLSearchParams();
  params.append('keyword', keyword);
  params.append('tab', currentSeasoningTab);
  if (genreFilter) {
    params.append('genre', genreFilter);
  }
  if (currentSeasoningTab === 'favorite') {
    params.append('favorite', true);
  }
  if (currentSeasoningTab === 'recent') {
    params.append('recent', true);
  }

  const res = await fetch('/admin/api/seasonings?' + params.toString());
  const seasonings = await res.json();
  renderSeasoningList(seasonings);
}



</script>

<script>
// 共通: 詳細表示・お気に入りトグル
function toggleIngredientDetail(button) {
  const parent = button.closest('.ingredient-card, .seasoning-card');
  const detail = parent.querySelector('.detail-section');
  if (detail) detail.classList.toggle('hidden');
}

async function toggleFavorite(button, id, type) {
  const isFav = button.textContent === '★';
  const method = isFav ? 'DELETE' : 'POST';
  await fetch(`/admin/api/favorite/${type}/${id}`, { method });
  button.textContent = isFav ? '☆' : '★';
  button.classList.toggle('text-yellow-400', !isFav);
  button.classList.toggle('text-gray-400', isFav);
}


</script>

<script>
// 栄養情報表示切り替え
function toggleNutritionInfo(btn) {
  const container = btn.closest('.border');
  const nutritionDiv = container?.querySelector('.nutrition-info');
  if (nutritionDiv) {
    nutritionDiv.classList.toggle('hidden');
  }
}
</script>

<script>
  // カテゴリリスト取得処理を削除（カテゴリのセレクトボックスも削除したため）

  function initImagePreview(inputId, imgId, placeholderId) {
    const input = document.getElementById(inputId);
    const img = document.getElementById(imgId);
    const placeholder = document.getElementById(placeholderId);

    const updatePreview = () => {
      const url = (input?.value || '').trim();
      if (url) {
        if (img) {
          img.src = url;
          img.classList.remove('hidden');
        }
        if (placeholder) {
          placeholder.classList.add('hidden');
        }
      } else {
        if (img) {
          img.src = '';
          img.classList.add('hidden');
        }
        if (placeholder) {
          placeholder.classList.remove('hidden');
        }
      }
    };

    input?.addEventListener('input', updatePreview);
    updatePreview();
  }

  function initUrlOpener(inputId, buttonId) {
    const input = document.getElementById(inputId);
    const button = document.getElementById(buttonId);
    if (!button) return;
    button.addEventListener('click', () => {
      const url = (input?.value || '').trim();
      if (url) {
        const features = 'noopener=yes,noreferrer=yes,width=1200,height=800,resizable=yes,scrollbars=yes';
        window.open(url, 'menuLinkWindow', features);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (window.lucide && typeof window.lucide.createIcons === 'function') {
      lucide.createIcons();
    }
    initUrlOpener('menu-url-input', 'menu-url-open');
    initImagePreview('image-url-input', 'image-url-preview', 'image-url-placeholder');
    if (typeof window.refreshLucideIcons === 'function') {
      window.refreshLucideIcons();
    }
    // 初期描画用食材をEJSから受け取り
    const initialIngredients = <%- JSON.stringify(menu.ingredients || []) %>;
    const ingredientListData = <%- JSON.stringify(ingredientList || []) %>;
    const ingredientsListEl = document.getElementById('ingredients-list');
    if (ingredientsListEl && initialIngredients.length > 0) {
      ingredientsListEl.innerHTML = '';
      initialIngredients.forEach(item => {
        const matchedIngredient = ingredientListData.find(ing => ing._id.toString() === item.name?._id.toString());
        const wrapper = document.createElement('div');
        wrapper.className = 'flex flex-col sm:flex-row sm:items-center sm:justify-between border p-4 rounded-lg bg-gray-50';

        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'ingredient_ids[]';
        hidden.value = item.name?._id;

        const topDiv = document.createElement('div');
        topDiv.className = 'text-base font-medium text-gray-900';
        topDiv.innerHTML = `${matchedIngredient ? matchedIngredient.ingredient : '未設定'} <span class="ml-2 inline-block text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">${matchedIngredient?.classification || '分類'}</span>`;

        const bottomDiv = document.createElement('div');
        bottomDiv.className = 'flex flex-wrap items-center gap-2 mt-2 sm:mt-0';

        const amount = document.createElement('input');
        amount.type = 'number';
        amount.step = 'any';
        amount.name = 'ingredient_amounts[]';
        amount.placeholder = '量';
        amount.className = 'w-20 border rounded-md px-2 py-1 text-sm';
        amount.value = item.amount;

        const unitSelect = document.createElement('select');
        unitSelect.name = 'ingredient_units[]';
        unitSelect.className = 'border rounded-md px-2 py-1 text-sm';
        let units = (matchedIngredient && matchedIngredient.unit) ? [...matchedIngredient.unit] : [];
        if (item.unit && !units.includes(item.unit)) { units.unshift(item.unit); }
        units.forEach(u => {
          const opt = document.createElement('option');
          opt.value = u;
          opt.textContent = u;
          if (u === item.unit) opt.selected = true;
          unitSelect.appendChild(opt);
        });

        const nutritionSpan = document.createElement('span');
        nutritionSpan.className = 'text-gray-500 text-sm';
        nutritionSpan.textContent = matchedIngredient?.short_nutrition?.replace(/\s+/g, ' ').trim() || '-';

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
        removeBtn.textContent = '×';
        removeBtn.onclick = function () {
          wrapper.remove();
          if (ingredientsListEl.children.length === 0) {
            ingredientsListEl.innerHTML = '食材を追加してください';
          }
        };

        bottomDiv.appendChild(amount);
        bottomDiv.appendChild(unitSelect);
        bottomDiv.appendChild(nutritionSpan);
        bottomDiv.appendChild(removeBtn);

        wrapper.appendChild(hidden);
        wrapper.appendChild(topDiv);
        wrapper.appendChild(bottomDiv);
        ingredientsListEl.appendChild(wrapper);
      });
    }
    // 初期描画用調味料
    const initialSeasonings = <%- JSON.stringify(menu.seasoning || []) %>;
    const seasoningListData = <%- JSON.stringify(seasoningList || []) %>;
    const seasoningsListEl = document.getElementById('seasonings-list');
    if (seasoningsListEl && initialSeasonings.length > 0) {
      seasoningsListEl.innerHTML = '';
      initialSeasonings.forEach(item => {
        const matchedSeasoning = seasoningListData.find(s => s._id.toString() === item.name?._id.toString());
        const container = seasoningsListEl;

        const wrapper = document.createElement('div');
        wrapper.className = 'flex flex-col sm:flex-row sm:items-center sm:justify-between border p-4 rounded-lg bg-gray-50';

        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'seasoning_ids[]';
        hidden.value = item.name?._id;

        const topDiv = document.createElement('div');
        topDiv.className = 'text-base font-medium text-gray-900';
        topDiv.innerHTML = `${matchedSeasoning ? matchedSeasoning.seasoning : '未設定'} <span class="ml-2 inline-block text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded">${matchedSeasoning?.classification || '分類'}</span>`;

        const bottomDiv = document.createElement('div');
        bottomDiv.className = 'flex flex-wrap items-center gap-2 mt-2 sm:mt-0';

        const amount = document.createElement('input');
        amount.type = 'number';
        amount.step = 'any';
        amount.name = 'seasoning_amounts[]';
        amount.placeholder = '量';
        amount.className = 'w-20 border rounded-md px-2 py-1 text-sm';
        amount.value = item.amount;

        const unitSelect = document.createElement('select');
        unitSelect.name = 'seasoning_units[]';
        unitSelect.className = 'border rounded-md px-2 py-1 text-sm';
        let units = (matchedSeasoning && matchedSeasoning.unit) ? [...matchedSeasoning.unit] : [];
        if (item.unit && !units.includes(item.unit)) { units.unshift(item.unit); }
        units.forEach(u => {
          const opt = document.createElement('option');
          opt.value = u;
          opt.textContent = u;
          if (u === item.unit) opt.selected = true;
          unitSelect.appendChild(opt);
        });

        const nutritionSpan = document.createElement('span');
        nutritionSpan.className = 'text-gray-500 text-sm';
        nutritionSpan.textContent = matchedSeasoning?.short_nutrition?.replace(/\s+/g, ' ').trim() || '-';

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
        removeBtn.textContent = '×';
        removeBtn.onclick = function () {
          wrapper.remove();
          if (container.children.length === 0) {
            container.innerHTML = '調味料を追加してください';
          }
        };

        bottomDiv.appendChild(amount);
        bottomDiv.appendChild(unitSelect);
        bottomDiv.appendChild(nutritionSpan);
        bottomDiv.appendChild(removeBtn);

        wrapper.appendChild(hidden);
        wrapper.appendChild(topDiv);
        wrapper.appendChild(bottomDiv);
        container.appendChild(wrapper);
      });
    }
  });
</script>

