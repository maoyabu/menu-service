<%
  const viewResults = typeof results !== 'undefined' && results ? results : {};
  const menuContentUpdateMode = typeof isMenuContentUpdate !== 'undefined' && Boolean(isMenuContentUpdate);
  const restoreMode = typeof isRestore !== 'undefined' && Boolean(isRestore);
  const successCount = viewResults.success ? viewResults.success.length : 0;
  const failCount = viewResults.failed ? viewResults.failed.length : 0;
  const summary = viewResults.summary ? viewResults.summary : {};
  const details = viewResults.details ? viewResults.details : [];
%>

<section class="max-w-4xl mx-auto py-10 space-y-8">
  <header class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold text-gray-900">
      <% if (menuContentUpdateMode) { %>
        メニュー内容一括更新完了
      <% } else if (restoreMode) { %>
        リストア完了
      <% } else { %>
        バックアップ完了
      <% } %>
    </h1>
    <p class="text-sm text-gray-600">
      <% if (menuContentUpdateMode) { %>
        Excelファイルをもとにメニュー内容の更新を実行しました。
      <% } else if (restoreMode) { %>
        データベースの復元が完了しました。
      <% } else { %>
        バックアップファイルが作成されました。
      <% } %>
    </p>
  </header>

  <% if (menuContentUpdateMode) { %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-6">
        <p class="text-sm text-blue-700">対象行</p>
        <p class="text-2xl font-bold text-blue-900"><%= summary.targetRows || 0 %></p>
      </div>
      <div class="bg-green-50 border-2 border-green-200 rounded-xl p-6">
        <p class="text-sm text-green-700">一致レコード</p>
        <p class="text-2xl font-bold text-green-900"><%= summary.matchedCount || 0 %></p>
      </div>
      <div class="bg-indigo-50 border-2 border-indigo-200 rounded-xl p-6">
        <p class="text-sm text-indigo-700">更新レコード</p>
        <p class="text-2xl font-bold text-indigo-900"><%= summary.modifiedCount || 0 %></p>
      </div>
      <div class="<%= (summary.failedCount || 0) > 0 ? 'bg-red-50 border-red-200' : 'bg-gray-50 border-gray-200' %> border-2 rounded-xl p-6">
        <p class="<%= (summary.failedCount || 0) > 0 ? 'text-red-700' : 'text-gray-700' %> text-sm">失敗行</p>
        <p class="<%= (summary.failedCount || 0) > 0 ? 'text-red-900' : 'text-gray-900' %> text-2xl font-bold"><%= summary.failedCount || 0 %></p>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
        <span class="lucide w-5 h-5 text-indigo-600" data-lucide="list-checks"></span>
        実行結果
      </h2>
      <p class="text-sm text-gray-600 mb-4">
        ファイル：<%= summary.fileName || '' %> / 読み込み行：<%= summary.totalRows || 0 %> / スキップ行：<%= summary.skippedCount || 0 %>
      </p>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left py-2 px-3 text-sm font-semibold text-gray-700">行</th>
              <th class="text-left py-2 px-3 text-sm font-semibold text-gray-700">メニュー名</th>
              <th class="text-left py-2 px-3 text-sm font-semibold text-gray-700">種類</th>
              <th class="text-left py-2 px-3 text-sm font-semibold text-gray-700">結果</th>
            </tr>
          </thead>
          <tbody>
            <% details.forEach((item) => { %>
              <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="py-3 px-3 text-sm text-gray-700"><%= item.row %></td>
                <td class="py-3 px-3 text-sm text-gray-900"><%= item.name %></td>
                <td class="py-3 px-3 text-sm text-gray-700"><%= item.kind %></td>
                <td class="py-3 px-3 text-sm">
                  <% if (item.status === 'success') { %>
                    <span class="text-green-700 font-medium"><%= item.message %></span>
                  <% } else if (item.status === 'notFound') { %>
                    <span class="text-orange-700 font-medium"><%= item.message %></span>
                  <% } else if (item.status === 'failed') { %>
                    <span class="text-red-700 font-medium"><%= item.message %></span>
                  <% } else { %>
                    <span class="text-gray-600"><%= item.message %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
  <!-- 成功/失敗サマリー -->
  <div class="grid grid-cols-2 gap-4">
    <div class="bg-green-50 border-2 border-green-200 rounded-xl p-6">
      <div class="flex items-center gap-3">
        <span class="lucide w-8 h-8 text-green-600" data-lucide="check-circle"></span>
        <div>
          <p class="text-sm text-green-700">成功したコレクション</p>
          <p class="text-2xl font-bold text-green-900"><%= successCount %></p>
        </div>
      </div>
    </div>

    <% if (failCount > 0) { %>
      <div class="bg-red-50 border-2 border-red-200 rounded-xl p-6">
        <div class="flex items-center gap-3">
          <span class="lucide w-8 h-8 text-red-600" data-lucide="x-circle"></span>
          <div>
            <p class="text-sm text-red-700">失敗したコレクション</p>
            <p class="text-2xl font-bold text-red-900"><%= failCount %></p>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-6">
        <div class="flex items-center gap-3">
          <span class="lucide w-8 h-8 text-blue-600" data-lucide="info"></span>
          <div>
            <p class="text-sm text-blue-700">問題なし</p>
            <p class="text-2xl font-bold text-blue-900">すべて成功</p>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- 詳細結果 -->
  <div class="space-y-6">
    <% if (viewResults.success && viewResults.success.length > 0) { %>
      <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <span class="lucide w-5 h-5 text-green-600" data-lucide="check"></span>
          成功したコレクション
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-2 px-4 text-sm font-semibold text-gray-700">コレクション名</th>
                <th class="text-right py-2 px-4 text-sm font-semibold text-gray-700">レコード数</th>
              </tr>
            </thead>
            <tbody>
              <% viewResults.success.forEach((item) => { %>
                <tr class="border-b border-gray-100 hover:bg-green-50">
                  <td class="py-3 px-4 text-sm text-gray-900">
                    <span class="inline-flex items-center gap-2">
                      <span class="w-2 h-2 bg-green-400 rounded-full"></span>
                      <%= item.collection %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-sm text-right text-gray-600 font-medium">
                    <%= item.count || 0 %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% if (viewResults.failed && viewResults.failed.length > 0) { %>
      <div class="bg-white rounded-xl shadow border border-red-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <span class="lucide w-5 h-5 text-red-600" data-lucide="alert-circle"></span>
          失敗したコレクション
        </h2>
        <div class="space-y-3">
          <% viewResults.failed.forEach((item) => { %>
            <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
              <p class="text-sm font-medium text-red-900"><%= item.collection %></p>
              <p class="text-sm text-red-700 mt-1"><%= item.reason %></p>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- 完了メッセージ -->
  <% if (failCount === 0) { %>
    <div class="p-6 bg-green-50 border-2 border-green-200 rounded-xl">
      <div class="flex gap-4">
        <span class="lucide w-6 h-6 text-green-600 flex-shrink-0" data-lucide="check-circle"></span>
        <div>
          <h3 class="font-semibold text-green-900 mb-2">✓ 処理が正常に完了しました</h3>
          <p class="text-sm text-green-800">
            <% if (restoreMode) { %>
              すべてのデータが正常に復元されました。アプリケーションは引き続き利用可能です。
            <% } else { %>
              バックアップファイルが正常に作成されました。安全な場所に保存してください。
            <% } %>
          </p>
        </div>
      </div>
    </div>
  <% } %>
  <% } %>

  <!-- 戻るボタン -->
  <div class="flex gap-4">
    <a
      href="/admin/backup/index"
      class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 text-center"
    >
      <span class="inline-flex items-center gap-2 justify-center">
        <span class="lucide w-4 h-4" data-lucide="arrow-left"></span>
        バックアップ画面に戻る
      </span>
    </a>
  </div>
</section>

<script>
  // Lucide icon rendering
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
