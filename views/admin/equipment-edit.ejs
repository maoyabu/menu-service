<div class="container mx-auto px-6 py-10">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">備品 編集</h1>
      <p class="text-sm text-gray-500">情報を更新してください</p>
    </div>
    <a href="/admin/equipment-list" class="text-sm text-gray-600 underline">一覧に戻る</a>
  </div>

  <form method="post" action="/admin/equipment-edit/<%= eq._id %>" class="bg-white border border-gray-200 rounded-xl p-6 space-y-6">
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-gray-800 mb-1">備品名</label>
        <input required name="name" type="text" value="<%= eq.name || '' %>" class="w-full border-gray-300 rounded-md px-3 py-2" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-800 mb-1">単位</label>
        <input name="unit" list="unitOptions" value="<%= eq.unit || '' %>" class="w-full border-gray-300 rounded-md px-3 py-2" />
        <datalist id="unitOptions">
          <% (units||[]).filter(Boolean).forEach(u=>{ %>
            <option value="<%= u %>"></option>
          <% }) %>
        </datalist>
      </div>

      <div class="flex items-end">
        <label class="inline-flex items-center gap-2 text-sm text-gray-800">
          <input type="checkbox" name="isConsumable" <%= eq.isConsumable ? 'checked' : '' %> />
          消耗品
        </label>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-800 mb-1">家ストック分類</label>
        <input name="houseCategory" list="houseOptions" value="<%= eq.houseCategory || '' %>" class="w-full border-gray-300 rounded-md px-3 py-2" />
        <datalist id="houseOptions">
          <% (houseCategories||[]).filter(Boolean).forEach(v=>{ %>
            <option value="<%= v %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-800 mb-1">防災対策分類</label>
        <input name="disasterCategory" list="disasterOptions" value="<%= eq.disasterCategory || '' %>" class="w-full border-gray-300 rounded-md px-3 py-2" />
        <datalist id="disasterOptions">
          <% (disasterCategories||[]).filter(Boolean).forEach(v=>{ %>
            <option value="<%= v %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-800 mb-1">キャンプ用分類</label>
        <input name="campingCategory" list="campingOptions" value="<%= eq.campingCategory || '' %>" class="w-full border-gray-300 rounded-md px-3 py-2" />
        <datalist id="campingOptions">
          <% (campingCategories||[]).filter(Boolean).forEach(v=>{ %>
            <option value="<%= v %>"></option>
          <% }) %>
        </datalist>
      </div>
    </section>

    <section>
      <label class="block text-sm font-medium text-gray-800 mb-1">メンテナンス内容</label>
      <input name="maintenance" list="maintOptions" value="<%= eq.maintenance || '' %>" class="w-full border-gray-300 rounded-md px-3 py-2" />
      <datalist id="maintOptions">
        <% (maintenances||[]).filter(Boolean).forEach(v=>{ %>
          <option value="<%= v %>"></option>
        <% }) %>
      </datalist>
    </section>

    <div class="flex justify-end gap-3">
      <a href="/admin/equipment-list" class="px-4 py-2 border rounded-md">キャンセル</a>
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md">更新</button>
    </div>
  </form>
</div>
