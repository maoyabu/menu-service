<% const returnQuery = currentQuery ? `?returnTo=${encodeURIComponent(currentQuery)}` : ''; %>
<div class="flex items-center justify-between mb-2">
  <h1 class="text-2xl font-semibold text-gray-800 flex items-center gap-2">
    <i data-lucide="carrot" class="w-6 h-6 text-gray-700"></i>
    食材一覧
  </h1>
  <a href="/admin/ingredient-new" class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-gray-900 text-white text-sm hover:bg-gray-800">
    <i data-lucide="plus" class="w-4 h-4"></i>
    新規登録
  </a>
</div>
<p class="text-sm text-gray-500 mb-4">該当件数: <%= ingredients.length %> 件</p>

<form id="ingredient-filters" method="GET" action="/admin/ingredient-list" class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">キーワード</label>
    <input type="text" name="keyword" value="<%= keyword || '' %>" class="w-full py-2 px-3 border border-gray-300 rounded-md text-sm bg-gray-50" placeholder="食材名など">
  </div>
  <div>
    <label for="classification" class="block text-sm font-medium text-gray-700 mb-1">分類</label>
    <select name="classification" class="w-full py-2 px-3 border border-gray-300 rounded-md text-sm bg-gray-50">
      <option value="">すべて</option>
      <% categoryList.forEach(cat => { %>
        <option value="<%= cat %>" <%= (classification || '') === cat ? 'selected' : '' %>><%= cat %></option>
      <% }) %>
    </select>
  </div>
  <div class="md:col-span-2">
    <p class="block text-sm font-medium text-gray-700 mb-1">チェック項目</p>
    <div class="flex flex-wrap gap-4 text-sm text-gray-700">
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" name="missingConversion" value="true" <%= missingConversion ? 'checked' : '' %> class="rounded">
        g換算未登録
      </label>
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" name="missingSeason" value="true" <%= missingSeason ? 'checked' : '' %> class="rounded">
        旬の季節未登録
      </label>
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" name="missingMonth" value="true" <%= missingMonth ? 'checked' : '' %> class="rounded">
        旬の月未登録
      </label>
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" name="missingWiki" value="true" <%= missingWiki ? 'checked' : '' %> class="rounded">
        wikiリンク未登録
      </label>
    </div>
  </div>
</form>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
  <% if (ingredients.length === 0) { %>
    <p class="text-gray-500 text-sm col-span-full">一致する食材がありません</p>
  <% } else { %>
    <% ingredients.forEach(item => { const seasons = Array.isArray(item.season) ? item.season.filter(Boolean) : []; const months = Array.isArray(item.month) ? item.month.filter(Boolean) : []; %>
      <div class="bg-white border border-gray-200 shadow-sm rounded-xl overflow-hidden hover:shadow transition flex flex-col">
        <div class="h-32 bg-gray-100 relative">
          <% if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="<%= item.ingredient || item.name %>" class="object-cover w-full h-full">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
          <% } %>
          <% if (item.classification) { %>
            <span class="absolute top-2 left-2 inline-flex items-center px-2 py-1 text-[11px] font-semibold rounded-full bg-amber-50 text-amber-700"><%= item.classification %></span>
          <% } %>
        </div>
        <div class="p-3 space-y-2 flex-1 flex flex-col">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="text-sm text-gray-500"><%= item.ingredient || '' %></p>
              <h2 class="text-lg font-semibold text-gray-900 leading-tight"><%= item.name || item.ingredient %></h2>
            </div>
            <div class="flex gap-2">
              <a href="/admin/ingredient-edit/<%= item._id %><%= returnQuery %>" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100">
                <i data-lucide="edit" class="w-4 h-4"></i>
              </a>
              <form action="/admin/ingredient-delete/<%= item._id %>" method="POST" onsubmit="return confirm('本当に削除しますか？');">
                <button type="submit" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100">
                  <i data-lucide="trash" class="w-4 h-4"></i>
                </button>
              </form>
            </div>
          </div>
          <div class="text-xs text-gray-700 space-y-1">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-blue-700 font-semibold">旬な季節</span>
              <span><%= seasons.length ? seasons.join(' / ') : '未設定' %></span>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-green-700 font-semibold">旬な月</span>
              <span><%= months.length ? months.join(' / ') : '未設定' %></span>
            </div>
          </div>
          <% if (item.unit && item.unit.length > 0) { %>
            <div class="text-[11px] text-gray-500 mt-auto">単位: <%= item.unit.join(', ') %></div>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
  (function(){
    const form = document.getElementById('ingredient-filters');
    if (!form) return;
    let timer = null;
    const queueSubmit = () => {
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => { form.requestSubmit ? form.requestSubmit() : form.submit(); }, 300);
    };
    form.querySelectorAll('input[type="text"]').forEach((el) => {
      el.addEventListener('input', queueSubmit);
    });
    form.querySelectorAll('select, input[type="checkbox"], input[type="radio"]').forEach((el) => {
      el.addEventListener('change', queueSubmit);
    });
  })();
  lucide.createIcons();
</script>
