<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-gray-800 flex items-center gap-2">
    <i data-lucide="carrot" class="w-6 h-6 text-gray-700"></i>
    食材一覧
  </h1>
  <a href="/admin/ingredient-new" class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-gray-900 text-white text-sm hover:bg-gray-800">
    <i data-lucide="plus" class="w-4 h-4"></i>
    新規登録
  </a>
</div>

<form id="ingredient-filters" method="GET" action="/admin/ingredient-list" class="mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">キーワード</label>
    <input type="text" name="keyword" value="<%= keyword || '' %>" class="w-full py-2 px-3 border border-gray-300 rounded-md text-sm bg-gray-50" placeholder="食材名など">
  </div>
  <div>
    <label for="classification" class="block text-sm font-medium text-gray-700 mb-1">分類</label>
    <select name="classification" class="w-full py-2 px-3 border border-gray-300 rounded-md text-sm bg-gray-50">
      <option value="">すべて</option>
      <% categoryList.forEach(cat => { %>
        <option value="<%= cat %>" <%= (classification || '') === cat ? 'selected' : '' %>><%= cat %></option>
      <% }) %>
    </select>
  </div>
  <div class="flex flex-col justify-end">
    <label class="block text-sm font-medium text-gray-700 mb-1">換算単位</label>
    <label class="inline-flex items-center gap-2 text-sm text-gray-700">
      <input type="checkbox" name="missingConversion" value="true" <%= missingConversion ? 'checked' : '' %> class="rounded">
      g換算未登録のみ
    </label>
  </div>
</form>

<div class="grid gap-4">
  <% if (ingredients.length === 0) { %>
    <p class="text-gray-500 text-sm">一致する食材がありません</p>
  <% } else { %>
    <% ingredients.forEach(item => { %>
      <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-4 hover:shadow transition">
        <div class="flex justify-between items-center">
          <div>
            <h2 class="text-lg font-medium text-gray-900"><%= item.name %></h2>
            <div class="mt-1 flex gap-2 flex-wrap text-sm text-gray-600">
              <% if (item.ingredient) { %>
                <span class="px-2 py-1 bg-gray-100 rounded-md">食材名: <%= item.ingredient %></span>
              <% } %>
              <% if (item.classification) { %>
                <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-md text-xs font-medium">分類: <%= item.classification %></span>              <% } %>
              <% if (item.unit && item.unit.length > 0) { %>
                <span class="px-2 py-1 bg-gray-100 rounded-md">単位: <%= item.unit.join(', ') %></span>
              <% } %>

            </div>
          </div>
          <div class="flex gap-2">
            <a href="/admin/ingredient-edit/<%= item._id %>" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100">
              <i data-lucide="edit" class="w-4 h-4"></i>
            </a>
            <form action="/admin/ingredient-delete/<%= item._id %>" method="POST" onsubmit="return confirm('本当に削除しますか？');">
              <button type="submit" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100">
                <i data-lucide="trash" class="w-4 h-4"></i>
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
  (function(){
    const form = document.getElementById('ingredient-filters');
    if (!form) return;
    let timer = null;
    const queueSubmit = () => {
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => { form.requestSubmit ? form.requestSubmit() : form.submit(); }, 300);
    };
    form.querySelectorAll('input[type="text"]').forEach((el) => {
      el.addEventListener('input', queueSubmit);
    });
    form.querySelectorAll('select, input[type="checkbox"], input[type="radio"]').forEach((el) => {
      el.addEventListener('change', queueSubmit);
    });
  })();
  lucide.createIcons();
</script>
