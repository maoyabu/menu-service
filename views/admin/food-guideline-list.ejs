<% const returnQuery = currentQuery ? `?returnTo=${encodeURIComponent(currentQuery)}` : ''; %>
<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold text-gray-800 flex items-center gap-2">
      <i data-lucide="clipboard-list" class="w-6 h-6 text-gray-700"></i>
      食品の目安量管理
    </h1>
    <a href="/admin/food-guideline-new<%= returnQuery %>" class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-gray-900 text-white text-sm hover:bg-gray-800">
      <i data-lucide="plus" class="w-4 h-4"></i>
      新規登録
    </a>
  </div>
  <p class="text-sm text-gray-500 mb-4">該当件数: <%= guidelines.length %> 件</p>

  <form id="guideline-filters" method="GET" action="/admin/food-guideline-list" class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="classification" class="block text-sm font-medium text-gray-700 mb-1">分類</label>
      <select name="classification" class="w-full py-2 px-3 border border-gray-300 rounded-md text-sm bg-gray-50">
        <option value="">すべて</option>
        <% classifications.forEach(cat => { %>
          <option value="<%= cat %>" <%= (selectedClassification || '') === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="sex" class="block text-sm font-medium text-gray-700 mb-1">性別</label>
      <select name="sex" class="w-full py-2 px-3 border border-gray-300 rounded-md text-sm bg-gray-50">
        <option value="">すべて</option>
        <option value="男" <%= (selectedSex || '') === '男' ? 'selected' : '' %>>男性</option>
        <option value="女" <%= (selectedSex || '') === '女' ? 'selected' : '' %>>女性</option>
      </select>
    </div>
  </form>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-700">
        <tr>
          <th class="text-left px-4 py-3">年齢</th>
          <th class="text-left px-4 py-3">性別</th>
          <th class="text-left px-4 py-3">分類</th>
          <th class="text-right px-4 py-3">必要量 (g)</th>
          <th class="text-right px-4 py-3">操作</th>
        </tr>
      </thead>
      <tbody>
        <% if (!guidelines.length) { %>
          <tr>
            <td colspan="5" class="text-center text-gray-500 py-6">データがありません</td>
          </tr>
        <% } else { %>
          <% guidelines.forEach(row => { %>
            <tr class="border-t">
              <td class="px-4 py-3"><%= row.ageRangeLabel || '' %></td>
              <td class="px-4 py-3"><%= row.sex === '男' ? '男性' : (row.sex === '女' ? '女性' : '未設定') %></td>
              <td class="px-4 py-3"><%= row.classification %></td>
              <td class="px-4 py-3 text-right"><%= Number(row.requiredGrams || 0).toLocaleString('ja-JP') %></td>
              <td class="px-4 py-3 text-right">
                <div class="inline-flex gap-2">
                  <a href="/admin/food-guideline-edit/<%= row._id %><%= returnQuery %>" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100">
                    <i data-lucide="edit" class="w-4 h-4"></i>
                  </a>
                  <a href="/admin/food-guideline-new?copyFrom=<%= row._id %><%= currentQuery ? '&returnTo=' + encodeURIComponent(currentQuery) : '' %>" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100" title="複製">
                    <i data-lucide="copy" class="w-4 h-4"></i>
                  </a>
                  <form action="/admin/food-guideline-delete/<%= row._id %>" method="POST" onsubmit="return confirm('本当に削除しますか？');">
                    <input type="hidden" name="returnTo" value="<%= currentQuery || '' %>">
                    <button type="submit" class="border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-gray-100">
                      <i data-lucide="trash" class="w-4 h-4"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function(){
    const form = document.getElementById('guideline-filters');
    if (!form) return;
    let timer = null;
    const queueSubmit = () => {
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => {
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.submit();
        }
      }, 200);
    };
    form.querySelectorAll('select, input').forEach((el) => {
      el.addEventListener('change', queueSubmit);
    });
  })();
</script>
