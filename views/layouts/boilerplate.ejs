<!DOCTYPE html>
<html lang="jp">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>1week meal planning</title>
  <link rel="icon" href="/favicon.png" type="image/png">

  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900 font-sans">
    <%- include('../partials/admin-header') %>
    <main class="flex-grow container mx-auto px-4 py-6">
      <% if (locals.success && locals.success.length) { %>
        <div class="mb-4">
          <% locals.success.forEach(msg => { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-2 rounded mb-2">
              <%= msg %>
            </div>
          <% }); %>
        </div>
      <% } %>
      <% if (locals.error && locals.error.length) { %>
        <div class="mb-4">
          <% locals.error.forEach(msg => { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded mb-2">
              <%= msg %>
            </div>
          <% }); %>
        </div>
      <% } %>
        <%- body -%>
    </main>
    <script>
        lucide.createIcons();
    </script>
</body>
</html>