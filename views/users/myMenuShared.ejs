<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div class="flex-1">
      <% const __isMyMenu = (selected && selected.fav === 'mine'); %>
      <% const __isOriginalList = !!(selected && selected.originalMenu); %>
      <% const __pageTitle = __isOriginalList ? 'オリジナルレシピリスト' : (__isMyMenu ? 'マイメニューリスト' : 'メニューリスト'); %>
      <% const __titleTone = __isOriginalList
        ? 'bg-purple-50 border-purple-200 text-purple-800'
        : (__isMyMenu ? 'bg-amber-50 border-amber-200 text-amber-900' : 'bg-blue-50 border-blue-200 text-blue-800'); %>
      <nav class="text-sm mb-2 text-gray-600 inline-flex items-center gap-1">
        <a href="/users/my-menu" class="inline-flex items-center gap-1 text-blue-600 font-semibold">
          <span class="lucide w-4 h-4" data-lucide="utensils"></span>
          <span>マイメニュートップ</span>
        </a>
        <span class="text-gray-400">›</span>
        <span><%= __pageTitle %></span>
      </nav>
      <div class="rounded-xl border px-4 py-2 <%= __titleTone %>">
        <h1 class="text-xl font-extrabold"><%= __pageTitle %></h1>
        <p class="text-sm opacity-80">キーワード・種類・ジャンル・調理方法で検索</p>
      </div>
    </div>
    
  </header>

  <form id="menuFilterForm" method="get" class="bg-white p-4 rounded-xl border grid grid-cols-1 md:grid-cols-12 gap-3">
    <div class="flex flex-col gap-1 md:col-span-4">
      <label class="text-xs font-semibold text-gray-600">キーワード</label>
      <input type="text" name="keyword" value="<%= selected.keyword || '' %>" placeholder="キーワード" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500" />
    </div>
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-gray-600">種類</label>
      <select name="kind" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
        <option value="">種類</option>
        <% kinds.forEach(function(k){ %>
          <option value="<%= k %>" <%= selected.kind===k ? 'selected' : '' %>><%= k %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-gray-600">ジャンル</label>
      <select name="junle" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
        <option value="">ジャンル</option>
        <% junles.forEach(function(j){ %>
          <option value="<%= j %>" <%= selected.junle===j ? 'selected' : '' %>><%= j %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-gray-600">調理方法</label>
      <select name="cook" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
        <option value="">調理方法</option>
        <% cooks.forEach(function(c){ %>
          <option value="<%= c %>" <%= selected.cook===c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-gray-600">季節の旬</label>
      <label class="inline-flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="seasonal" value="1" <%= selected.seasonal ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300">
        <span>季節の旬</span>
      </label>
      <label class="inline-flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="seasonalMonth" value="1" <%= selected.seasonalMonth ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300">
        <span>今月の旬</span>
      </label>
    </div>
    <div class="flex flex-col gap-1 md:col-span-10">
      <label class="text-xs font-semibold text-gray-600">マイメニューの絞り込み</label>
      <div class="flex flex-wrap items-center gap-4">
        <select name="fav" class="w-full md:w-64 border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
          <option value="all" <%= (selected.fav||'all')==='all' ? 'selected' : '' %>>すべて</option>
          <option value="mine" <%= selected.fav==='mine' ? 'selected' : '' %>>マイメニュー</option>
          <option value="not" <%= selected.fav==='not' ? 'selected' : '' %>>マイメニュー未登録</option>
        </select>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 whitespace-nowrap">
          <input type="checkbox" name="originalMenu" value="1" <%= selected.originalMenu ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300">
          <span>オリジナルメニュー</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 whitespace-nowrap">
          <input type="checkbox" name="setMenu" value="1" <%= selected.setMenu ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300">
          <span>セットメニュー</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 whitespace-nowrap">
          <input type="checkbox" name="arrangeMenu" value="1" <%= selected.arrangeMenu ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300">
          <span>アレンジメニュー</span>
        </label>
      </div>
    </div>
    <div class="md:col-span-2 flex justify-end md:items-end">
      <a href="/users/my-menu/shared-register" class="px-4 py-2 rounded-lg border border-gray-600 text-sm font-semibold text-gray-900 hover:bg-gray-100 transition">クリア</a>
    </div>
  </form>

  <script>
    (function(){
      const form = document.getElementById('menuFilterForm');
      if (!form) return;
      let debounceId = null;
      const submitAsync = () => {
        form.submit();
      };
      const scheduleSubmit = () => {
        if (debounceId) clearTimeout(debounceId);
        debounceId = setTimeout(submitAsync, 250);
      };
      const keywordInput = form.querySelector('input[name="keyword"]');
      if (keywordInput) {
        keywordInput.addEventListener('input', scheduleSubmit);
      }
      form.querySelectorAll('select').forEach((select) => {
        select.addEventListener('change', submitAsync);
      });
      form.querySelectorAll('input[type="checkbox"]').forEach((checkbox) => {
        checkbox.addEventListener('change', submitAsync);
      });
    })();
  </script>

  <div class="flex items-center justify-between">
    <h2 class="font-semibold rounded-full px-3 py-1 border border-blue-200 bg-blue-50 text-blue-800">共有メニュー（検索結果 <%= resultCount || 0 %> 件）</h2>
    <div class="text-sm text-gray-600">♥ <span data-fav-count><%= (myMenuIds || []).length %></span></div>
  </div>

  <style>
    /* Make tags content-width and bigger font (like attachment) */
    .list-chip{ font-size:13px; }
    .myshared-grid{ display:grid; width:100%; height:100%; }
    .myshared-grid.one{ grid-template-columns:1fr; grid-template-rows:1fr; }
    .myshared-grid.two{ grid-template-columns:repeat(2,1fr); grid-template-rows:1fr; }
    .myshared-grid.three,
    .myshared-grid.four{ grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(2,1fr); }
    .myshared-grid.five{ grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(3,1fr); }
    .myshared-grid .tile{ background:#f1f5f9; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .myshared-grid .tile img{ width:100%; height:100%; object-fit:cover; }
    .myshared-grid .tile.span-2{ grid-column:1 / 3; }
  </style>
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 items-stretch">
    <% (list || []).forEach(function(item){ const isFav = (myMenuIds || []).includes(String(item.id)); %>
      <div class="border rounded-xl overflow-hidden relative flex flex-col min-h-[320px] h-full">
        <div class="h-44 bg-gray-100 relative">
          <% const __isSet = (item.menuType === 'set') || ((item.setImages || []).length > 0); %>
          <% if (__isSet) { %>
            <% const setImages = (item.setImages || []).filter(Boolean); %>
            <% const imgCount = Math.min(setImages.length, 5); %>
            <% if (imgCount > 0) { %>
              <% const gridClass = imgCount === 1 ? 'one' : (imgCount === 2 ? 'two' : (imgCount === 3 ? 'three' : (imgCount === 4 ? 'four' : 'five'))); %>
              <div class="myshared-grid <%= gridClass %>">
                <% if (imgCount === 3) { %>
                  <div class="tile span-2"><img src="<%= setImages[0] %>" alt=""></div>
                  <div class="tile"><img src="<%= setImages[1] %>" alt=""></div>
                  <div class="tile"><img src="<%= setImages[2] %>" alt=""></div>
                <% } else if (imgCount === 5) { %>
                  <div class="tile span-2"><img src="<%= setImages[0] %>" alt=""></div>
                  <% for (let i = 1; i < 5; i++) { %>
                    <div class="tile"><img src="<%= setImages[i] %>" alt=""></div>
                  <% } %>
                <% } else { %>
                  <% for (let i = 0; i < imgCount; i++) { %>
                    <div class="tile"><img src="<%= setImages[i] %>" alt=""></div>
                  <% } %>
                <% } %>
              </div>
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
            <% } %>
          <% } else if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="w-full h-full object-cover"/>
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
          <% } %>
          <% if (item.kind) { %>
            <span class="absolute top-2 left-2 text-[10px] bg-white/90 rounded px-2 py-0.5"><%= item.kind %></span>
          <% } %>
          <% if (item.canEdit) { %>
            <a href="/users/my-menu/edit/<%= item.id %>" class="absolute top-2 right-12 inline-flex h-8 w-8 items-center justify-center rounded-full border text-gray-500 bg-white/90 hover:bg-white" title="編集">
              <span class="lucide w-4 h-4" data-lucide="pencil"></span>
            </a>
          <% } %>
          <button type="button" class="absolute top-2 right-2 inline-flex h-8 w-8 items-center justify-center rounded-full border text-gray-500 bg-white/90 hover:bg-white favorite-btn <%= isFav ? 'is-active text-rose-500 border-rose-300 bg-rose-50' : '' %>" data-menu-id="<%= item.id %>">
            <span class="lucide w-4 h-4" data-lucide="heart"></span>
          </button>
        </div>
          <div class="p-3 space-y-2 flex-1 flex flex-col">
            <% const st = (myOwnTypes && myOwnTypes[String(item.id)]) || ''; %>
            <% const __sourceType = st || (item.sourceType || ''); %>
            <% const __isOriginalSource = (st === 'original') || (item.sourceType === 'original'); %>
            <% const __hideDuplicate = __isOriginalSource || (st === 'url'); %>
            <% if (!__hideDuplicate) { %>
              <div class="flex justify-end">
                <a href="/users/my-menu/duplicate/<%= item.id %>" class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-purple-100 text-purple-700 border border-purple-300 hover:bg-purple-200">
                  <span class="lucide w-3.5 h-3.5" data-lucide="copy"></span>
                  オリジナルを作成
                </a>
              </div>
            <% } %>
            <div class="flex justify-end mt-2">
              <button type="button" class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full bg-green-50 text-emerald-700 border border-emerald-200 hover:bg-green-100 assign-calendar-btn" data-menu-id="<%= item.id %>">
                <span class="lucide w-3.5 h-3.5" data-lucide="calendar-days"></span>
                カレンダーに追加
              </button>
            </div>
            <% const __typeIsSet = (item.menuType === 'set') || (Array.isArray(item.setImages) && item.setImages.length > 0); %>
            <% const __typeIsArrange = item.menuType === 'arrange'; %>
            <div class="flex flex-wrap items-center gap-1 self-start">
              <% if (__sourceType === 'url') { %>
                <span class="inline-flex px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 text-[13px]">レシピサイト</span>
              <% } else if (__sourceType === 'original') { %>
                <span class="inline-flex px-2 py-0.5 rounded bg-purple-50 text-purple-700 text-[13px]">オリジナル</span>
              <% } else { %>
                <span class="inline-flex px-2 py-0.5 rounded bg-blue-50 text-blue-700 text-[13px]">共有メニュー</span>
              <% } %>
              <% if (__typeIsSet) { %>
                <span class="inline-flex px-2 py-0.5 rounded bg-rose-50 text-rose-700 text-[13px]">セットメニュー</span>
              <% } %>
              <% if (__typeIsArrange) { %>
                <span class="inline-flex px-2 py-0.5 rounded bg-rose-50 text-rose-700 text-[13px]">アレンジメニュー</span>
              <% } %>
            </div>
            <% if (item.url) { %>
              <a href="<%= item.url %>" class="text-base font-semibold truncate text-blue-600 hover:underline" title="<%= item.name %>" target="_blank" rel="noopener">
                <%= item.name %>
              </a>
            <% } else { %>
              <p class="text-base font-semibold truncate" title="<%= item.name %>"><%= item.name %></p>
            <% } %>
            <div class="flex flex-col gap-1 items-start">
              <% if (item.time) { %>
                <span class="list-chip inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700 px-2 py-0.5 self-start">
                  調理時間 <%= String(item.time).endsWith('分') ? item.time : (item.time + '分') %>
                </span>
              <% } %>
              <% if (Array.isArray(item.season) && item.season.length) { %>
                <span class="list-chip inline-flex items-center rounded-full border border-teal-200 bg-teal-50 text-teal-800 px-2 py-0.5 self-start">
                  旬 <%= item.season.join(' / ') %>
                </span>
              <% } %>
              <% if (item.junle) { %>
                <span class="list-chip inline-flex items-center rounded-full border border-amber-200 bg-amber-50 text-amber-800 px-2 py-0.5 self-start">
                  ジャンル <%= item.junle %>
                </span>
              <% } %>
              <% if (item.cook) { %>
                <span class="list-chip inline-flex items-center rounded-full border border-amber-200 bg-amber-50 text-amber-800 px-2 py-0.5 self-start">
                  調理方法 <%= item.cook %>
                </span>
              <% } %>
              <% const __freq = (myMenuFreq && myMenuFreq[String(item.id)]) || null; %>
              <% if (__freq) { %>
                <% const __freqText = (__freq==5? '週に2回以上' : __freq==4? '週に1回程度' : __freq==3? '隔週に1回程度' : __freq==2? '月に1回程度' : '3ヶ月に1回以下'); %>
                <button type="button" class="list-chip inline-flex items-center gap-1 rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-2 py-0.5 self-start"
                        data-action="edit-frequency" data-menu-id="<%= item.id %>">
                  <span class="lucide w-4 h-4" data-lucide="calendar"></span>
                  <span data-role="freq-label"><%= __freqText %></span>
                </button>
              <% } %>
            </div>
            
          <% if (item.by) { %>
            <p class="text-xs text-gray-500 truncate">by <%= item.by %></p>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Favorite small panel (same as weekMenu style) -->
  <div id="fav-modal" class="hidden fixed inset-0 z-50 bg-transparent">
    <div id="fav-pop" class="w-80 rounded-xl bg-white p-5 shadow-lg border">
      <h3 class="text-base font-semibold mb-3">マイメニューに登録</h3>
      <div class="space-y-3 text-[15px]">
        <label class="flex items-center justify-between gap-3">
          <span class="flex flex-col leading-tight">
            <span class="font-medium">食べたい頻度</span>
            
          </span>
          <select id="fav-frequency" class="border rounded px-2 py-1">
            <option value="5">5 … 週に2回</option>
            <option value="4">4 … 週に1回</option>
            <option value="3" selected>3 … 隔週に1回</option>
            <option value="2">2 … 月に1回</option>
            <option value="1">1 … 3ヶ月に1回</option>
          </select>
        </label>
        
      </div>
      <div class="mt-5 flex justify-end gap-2">
        <button type="button" data-fav-action="cancel" class="px-3 py-1.5 rounded border">キャンセル</button>
        <button type="button" data-fav-action="submit" class="px-3 py-1.5 rounded bg-blue-600 text-white">登録</button>
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    const myMenuIds = new Set(<%- JSON.stringify(myMenuIds || []) %>);
    const myMenuFreqMap = Object.assign({}, <%- JSON.stringify(myMenuFreq || {}) %>);
    let anchorBtn = null;
    let anchorMenuId = null;

    const openPanel = (btn) => {
      const overlay = document.getElementById('fav-modal');
      const pop = document.getElementById('fav-pop');
      if (!overlay || !pop) return;
      overlay.classList.remove('hidden');
      const rect = btn.getBoundingClientRect();
      const vw = window.innerWidth || document.documentElement.clientWidth;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const pw = 320, ph = 160;
      let left = rect.right + 8;
      let top = rect.top;
      if (left + pw + 8 > vw) left = Math.max(8, rect.left - pw - 8);
      if (top + ph + 8 > vh) top = Math.max(8, vh - ph - 8);
      pop.style.position = 'fixed';
      pop.style.left = left + 'px';
      pop.style.top = top + 'px';
      document.getElementById('fav-frequency').value = '3';
    };
    const closePanel = () => {
      const overlay = document.getElementById('fav-modal');
      if (overlay) overlay.classList.add('hidden');
      anchorBtn = null; anchorMenuId = null;
    };

    const refreshBtn = (btn, active) => {
      btn.classList.toggle('is-active', !!active);
      btn.classList.toggle('text-rose-500', !!active);
      btn.classList.toggle('border-rose-300', !!active);
      btn.classList.toggle('bg-rose-50', !!active);
    };

    const updateFavCount = () => {
      const el = document.querySelector('[data-fav-count]');
      if (el) el.textContent = String(myMenuIds.size);
    };

    const upsert = async (menuId, freq, skill) => {
      const res = await fetch('/users/my-menu/api/upsert', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ menuId, favorite: true, frequency: freq, skill })
      });
      if (!res.ok) throw new Error('登録に失敗しました');
      return res.json();
    };
    const removeFav = async (menuId) => {
      const res = await fetch(`/users/my-menu/api/${encodeURIComponent(menuId)}`, { method: 'DELETE' });
      if (!res.ok) throw new Error('削除に失敗しました');
      return res.json();
    };

    document.addEventListener('click', async (ev) => {
      const t = ev.target.closest('.favorite-btn');
      if (t && t.dataset.menuId) {
        const id = String(t.dataset.menuId);
        if (myMenuIds.has(id)) {
          try {
            await removeFav(id);
            myMenuIds.delete(id);
            refreshBtn(t, false);
            updateFavCount();
          } catch (e) { alert(e.message || '削除に失敗しました'); }
        } else {
          anchorBtn = t; anchorMenuId = id; openPanel(t);
        }
        return;
      }
      // Open frequency editor when clicking the frequency chip
      const freqBtn = ev.target.closest('[data-action="edit-frequency"]');
      if (freqBtn && freqBtn.dataset.menuId) {
        ev.preventDefault();
        const id = String(freqBtn.dataset.menuId);
        anchorBtn = freqBtn; anchorMenuId = id; openPanel(freqBtn);
        const sel = document.getElementById('fav-frequency');
        if (sel) sel.value = String(myMenuFreqMap[id] || 3);
        // Change modal title temporarily
        const title = document.querySelector('#fav-pop h3');
        if (title) title.textContent = '頻度を変更';
        return;
      }
      // close overlay
      if (ev.target && ev.target.id === 'fav-modal') {
        closePanel();
      }
      if (ev.target && ev.target.matches('[data-fav-action="cancel"]')) {
        ev.preventDefault(); closePanel();
      }
      if (ev.target && ev.target.matches('[data-fav-action="submit"]')) {
        ev.preventDefault();
        if (!anchorMenuId || !anchorBtn) return closePanel();
        const freq = Number(document.getElementById('fav-frequency').value) || 3;
        try {
          await upsert(anchorMenuId, freq, false);
          myMenuIds.add(anchorMenuId);
          // If editing frequency chip, update its label inline
          if (anchorBtn && anchorBtn.matches('[data-action="edit-frequency"]')) {
            const label = anchorBtn.querySelector('[data-role="freq-label"]');
            const text = (freq===5? '週に2回以上' : freq===4? '週に1回程度' : freq===3? '隔週に1回程度' : freq===2? '月に1回程度' : '3ヶ月に1回以下');
            if (label) label.textContent = text;
            myMenuFreqMap[anchorMenuId] = freq;
          } else if (anchorBtn) {
            refreshBtn(anchorBtn, true);
            updateFavCount();
          }
          closePanel();
          window.refreshLucideIcons && window.refreshLucideIcons();
        } catch (e) {
          alert(e.message || '登録に失敗しました');
        }
      }
    });

    // Initial icon render
    window.refreshLucideIcons && window.refreshLucideIcons();
  })();
</script>

<!-- Calendar assign modal -->
<div id="menu-assign-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40">
  <div class="bg-white rounded-xl p-5 w-[360px] max-w-[94vw] border">
    <h3 class="font-semibold mb-3">カレンダーに追加</h3>
    <form id="menuAssignForm">
      <input type="hidden" name="menuId" id="assign-menu-id">
      <div class="mb-2">
        <label class="text-xs text-gray-700">日付</label>
        <input type="date" name="dateISO" id="assign-date" class="w-full border rounded px-3 py-2" required>
      </div>
      <div class="mb-2">
        <label class="text-xs text-gray-700">食事</label>
        <select name="mealType" id="assign-meal" class="w-full border rounded px-3 py-2">
          <option value="breakfast">朝食</option>
          <option value="lunch" selected>ランチ</option>
          <option value="dinner">夕食</option>
        </select>
      </div>
      <div class="mb-2 border-t pt-3">
        <label class="text-xs text-gray-700">当日の既存メニュー（比較して置換できます）</label>
        <div id="assign-existing-list" class="mt-2 space-y-2 text-sm text-gray-700">
          <div class="text-xs text-gray-400">取得中...</div>
        </div>
      </div>
      <div class="flex justify-end gap-2 mt-4">
        <button type="button" id="assign-cancel" class="px-3 py-1 rounded border">キャンセル</button>
        <button type="submit" id="assign-submit" class="px-3 py-1 rounded bg-blue-600 text-white">追加</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function(){
    const modal = document.getElementById('menu-assign-modal');
    const form = document.getElementById('menuAssignForm');
    const menuIdInput = document.getElementById('assign-menu-id');
    const dateInput = document.getElementById('assign-date');
    const mealInput = document.getElementById('assign-meal');
    document.addEventListener('click', (ev) => {
      const btn = ev.target.closest('.assign-calendar-btn');
      if (!btn) return;
      ev.preventDefault();
      const mid = btn.dataset.menuId || '';
      if (!mid) return alert('メニューIDが取得できません');
      menuIdInput.value = mid;
      // default date: today
      const today = new Date();
      const iso = today.toISOString().slice(0,10);
      dateInput.value = iso;
      if (modal) modal.classList.remove('hidden');
    });
    const closeModal = () => { if (modal) modal.classList.add('hidden'); };
    document.getElementById('assign-cancel').addEventListener('click', (e)=>{ e.preventDefault(); closeModal(); });

    const existingListEl = document.getElementById('assign-existing-list');
    const fetchExisting = async () => {
      if (!menuIdInput || !dateInput || !mealInput) return;
      const d = dateInput.value;
      const m = mealInput.value;
      if (!d) return;
      existingListEl.innerHTML = '<div class="text-xs text-gray-400">取得中...</div>';
      try {
        const params = new URLSearchParams({ dateISO: d, mealType: m });
        const res = await fetch('/users/my-menu/plan-slots?' + params.toString());
        const json = await res.json();
        if (!res.ok) throw new Error(json && json.error ? json.error : '取得に失敗しました');
        const slots = json.slots || [];
        if (!slots.length) {
          existingListEl.innerHTML = '<div class="text-xs text-gray-500">当該日のメニューはありません（このまま追加されます）</div>';
          return;
        }
        // render radio list: option -1 = 追加
        const out = [];
        out.push('<label class="inline-flex items-center gap-2"><input type="radio" name="assignMode" value="-1" checked> 追加（新しいスロットを追加）</label>');

        // fetch detailed menu info for selected menu and existing slot menus
        const selectedMenuId = menuIdInput.value;
        const menuIds = Array.from(new Set([selectedMenuId, ...slots.map(s => s.menuId).filter(Boolean)]));
        const menuInfoMap = new Map();
        try {
          await Promise.all(menuIds.map(async (id) => {
            try {
              const resp = await fetch('/users/my-menu/menu-info?menuId=' + encodeURIComponent(id));
              const j = await resp.json();
              if (resp.ok && j && j.menu) menuInfoMap.set(id, j.menu);
            } catch (_) { /* ignore per-menu errors */ }
          }));
        } catch (_) { /* noop */ }

        const selectedInfo = menuInfoMap.get(selectedMenuId) || null;
        slots.forEach((s) => {
          const info = menuInfoMap.get(s.menuId) || null;
          const img = info && info.imageUrl ? `<img src="${info.imageUrl}" class="w-10 h-10 object-cover rounded">` : (s.imageUrl ? `<img src="${s.imageUrl}" class="w-10 h-10 object-cover rounded">` : '<div class="w-10 h-10 bg-gray-100 rounded flex items-center justify-center text-xs text-gray-400">no image</div>');
          // build diff summary
          let diffHtml = '';
          try {
            const selIngs = (selectedInfo && Array.isArray(selectedInfo.ingredients)) ? selectedInfo.ingredients.map(i=>String(i.ingredient).trim()).filter(Boolean) : [];
            const exIngs = (info && Array.isArray(info.ingredients)) ? info.ingredients.map(i=>String(i.ingredient).trim()).filter(Boolean) : [];
            const selSet = new Set(selIngs);
            const exSet = new Set(exIngs);
            const common = selIngs.filter(x => exSet.has(x));
            const onlySel = selIngs.filter(x => !exSet.has(x));
            const onlyEx = exIngs.filter(x => !selSet.has(x));
            const selTime = selectedInfo ? (selectedInfo.time || '') : '';
            const exTime = info ? (info.time || '') : (s.time || '');
            diffHtml += `<div class="text-xs text-gray-600">調理時間: <span class="font-semibold">${escapeHtml(selTime||'–')}</span> ／ 現在: <span class="font-semibold">${escapeHtml(exTime||'–')}</span></div>`;
            if (common.length || onlySel.length || onlyEx.length) {
              diffHtml += '<div class="mt-1 text-xs">';
              if (common.length) diffHtml += `<div class="text-xs text-gray-700">共通: ${escapeHtml(common.slice(0,5).join(', '))}${common.length>5? ' …':''}</div>`;
              if (onlySel.length) diffHtml += `<div class="text-xs text-emerald-700">このメニューにのみ: ${escapeHtml(onlySel.slice(0,5).join(', '))}${onlySel.length>5? ' …':''}</div>`;
              if (onlyEx.length) diffHtml += `<div class="text-xs text-rose-700">既存にのみ: ${escapeHtml(onlyEx.slice(0,5).join(', '))}${onlyEx.length>5? ' …':''}</div>`;
              diffHtml += '</div>';
            }
          } catch (_) { diffHtml = ''; }

          out.push(`<label class="flex items-start gap-2 p-2 rounded border"><input type="radio" name="assignMode" value="${s.slotId}"> <div class="w-10 h-10">${img}</div> <div class="flex-1 text-sm truncate"><div class="font-semibold">${escapeHtml(s.name || '無題')}</div><div class="text-xs text-gray-500">${s.slotType||''}</div>${diffHtml}</div></label>`);
        });
        existingListEl.innerHTML = out.join('');
      } catch (e) {
        existingListEl.innerHTML = `<div class="text-xs text-rose-500">${(e&&e.message)||'取得失敗'}</div>`;
      }
    };

    dateInput.addEventListener('change', fetchExisting);
    mealInput.addEventListener('change', fetchExisting);

    // helper escape
    const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const payload = {
        menuId: menuIdInput.value,
        dateISO: dateInput.value,
        mealType: mealInput.value
      };
      // check selected assignMode
      try {
        const sel = form.querySelector('input[name="assignMode"]:checked');
        if (sel && sel.value && sel.value !== '-1') payload.replaceSlotId = sel.value;

        const res = await fetch('/users/my-menu/assign-to-plan', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
        const json = await res.json();
        if (!res.ok) throw new Error(json && json.error ? json.error : '追加に失敗しました');
        if (json.replaced || json.replacedSlotId) {
          alert('既存のメニューを置換しました');
        } else if (json.replaced === false) {
          alert('メニューを追加しました');
        } else {
          alert('処理が完了しました');
        }
        closeModal();
        // redirect to week menu for that week
        const d = new Date(payload.dateISO);
        const y = d.getFullYear(); const m = String(d.getMonth()+1).padStart(2,'0'); const day = String(d.getDate()).padStart(2,'0');
        const params = new URLSearchParams({ weekStart: `${y}-${m}-${day}` });
        window.location.href = '/users/week-menu?' + params.toString();
      } catch (e) { alert(e.message || '追加に失敗しました'); }
    });
    // initial fetch
    fetchExisting();
  })();
</script>
