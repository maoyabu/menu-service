    guidelineTotals: <%- serialize(typeof guidelineTotals !== "undefined" ? guidelineTotals : {}) %>,
    guidelineByUser: <%- serialize(typeof guidelineByUser !== "undefined" ? guidelineByUser : {}) %>,
    currentUserIsGroupOwner: <%- serialize(typeof currentUserIsGroupOwner !== 'undefined' ? currentUserIsGroupOwner : false) %>,
    participantsByMeal: <%- serialize(typeof participantsMap !== "undefined" ? participantsMap : {}) %>,
    doRecords: <%- serialize(typeof doRecords !== "undefined" ? doRecords : []) %>,
    menuFilterSettings: <%- serialize(typeof weekMenuSettings !== "undefined" ? weekMenuSettings : {}) %>,
    wantedIngredients: <%- serialize(typeof wantedIngredients !== "undefined" ? wantedIngredients : []) %>,
    wantedIngredientsYearMonth: <%- serialize(typeof wantedIngredientsYearMonth !== "undefined" ? wantedIngredientsYearMonth : '') %>,
    isModelPlanMode: <%- serialize(typeof isModelPlanMode !== "undefined" ? isModelPlanMode : false) %>,
    modelPlanId: <%- serialize(typeof modelPlanId !== "undefined" ? modelPlanId : '') %>,
    modelPlanTitle: <%- serialize(typeof modelPlanTitle !== "undefined" ? modelPlanTitle : '') %>,
    modelPlanDescription: <%- serialize(typeof modelPlanDescription !== "undefined" ? modelPlanDescription : '') %>,
    saveEndpoint: <%- serialize((typeof isModelPlanMode !== "undefined" && isModelPlanMode && typeof modelPlanId !== "undefined" && modelPlanId) ? `/users/my-menu/model-plans/${modelPlanId}` : '/users/week-menu') %>,
    shouldPromptPlanSource: <%- serialize(typeof shouldPromptPlanSource !== "undefined" ? shouldPromptPlanSource : false) %>,
    modelPlanChoices: <%- serialize(typeof modelPlanChoices !== "undefined" ? modelPlanChoices : []) %>
  };
</script>

<script>
  // 「これ食べた」記録ボタンの処理
  (function(){
    function startOfDayLocal(d){ const nd = new Date(d); nd.setHours(0,0,0,0); return nd; }
    document.addEventListener('click', async (ev) => {
      const btn = ev.target.closest('[data-action="mark-ate"]');
      if (!btn) return;
      ev.preventDefault();
      try {
        const container = btn.closest('[data-day][data-meal]');
        if (!container) throw new Error('日付が特定できません');
        const meal = container.getAttribute('data-meal');
        const dayIndex = Number(container.getAttribute('data-day'));
        const menuId = btn.getAttribute('data-menu-id');
        const data = window.weekMenuData || {};
        const weekDates = Array.isArray(data.weekDates) ? data.weekDates : [];
        const dateISO = (weekDates[dayIndex] && weekDates[dayIndex].dateISO) || '';
        const todayISO = data.todayISO || new Date().toISOString();

        if (!menuId) throw new Error('メニューが特定できません');
        if (!dateISO) throw new Error('日付が特定できません');
        // 未来日は不可（念のためクライアントでもガード）
        if (startOfDayLocal(new Date(dateISO)).getTime() > startOfDayLocal(new Date(todayISO)).getTime()) {
          throw new Error('未来日は記録できません');
        }

        // planId が無ければ自動保存を試行
        let planId = data.planId || '';
        if (!planId && window.weekMenuAPI && window.weekMenuAPI.saveWeekPlanSilently) {
          try {
            await window.weekMenuAPI.saveWeekPlanSilently();
            planId = (window.weekMenuData && window.weekMenuData.planId) || '';
          } catch (_) { /* ignore */ }
        }

        const payload = {
          planId: planId || '',
          groupId: data.currentGroupId || '',
          dayIndex,
          dateISO,
          mealType: meal,
          menuId
        };

        const resp = await fetch('/users/week-menu/do', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!resp.ok) {
          const t = await resp.text();
          throw new Error(t || '記録に失敗しました');
        }
        const json = await resp.json();
        if (!json || !json.success) throw new Error('記録に失敗しました');

        // UI: 記録済みに変更
        btn.setAttribute('disabled', 'true');
        btn.title = '記録済み';
        const icon = btn.querySelector('[data-lucide]');
        if (icon) icon.setAttribute('data-lucide', 'check');
        if (window.refreshLucideIcons) window.refreshLucideIcons();
      } catch (err) {
        alert(err.message || '記録に失敗しました');
      }
    });
  })();
</script>

