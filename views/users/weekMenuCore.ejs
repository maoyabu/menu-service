<!-- Shared week menu data, API scripts, and modal for the unified weekMenu2 view. -->
<%
  const serialize = (value) =>
    JSON.stringify(value)
      .replace(/</g, '\\u003c')
      .replace(/'/g, '\\u0027')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  const isEmbeddedLite = typeof embeddedLite !== 'undefined' && embeddedLite;
%>

