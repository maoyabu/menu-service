<%
  const fmtNumber = (value) => {
    if (value === null || value === undefined || value === '') return '―';
    const num = Number(value);
    if (!Number.isNaN(num)) return num;
    return value;
  };
  const usageFor = (id) => {
    if (!menuUsage) return [];
    const key = String(id || '');
    return Array.isArray(menuUsage[key]) ? menuUsage[key] : [];
  };
  const wantedIdSet = new Set((wantedIngredientIds || []).map(String));
  const wantedChecked = new Set(wantedValues || []);
  const wantedMonthLabel = (() => {
    const parts = String(selectedWantedMonth || '').split('-');
    return parts.length === 2 ? `${Number(parts[0])}年${Number(parts[1])}月` : '';
  })();
  const wantedActionMonthLabel = selectedWantedMonth === currentYearMonth ? '今月' : wantedMonthLabel;
%>

<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-start justify-between gap-4">
    <div class="space-y-2">
      <nav class="text-sm text-gray-600 inline-flex items-center gap-1">
        <a href="/users/my-top" class="inline-flex items-center gap-1 text-blue-600 font-semibold">
          <span class="lucide w-4 h-4" data-lucide="home"></span>
          <span>マイトップ</span>
        </a>
        <span class="text-gray-400">›</span>
        <span>旬の食材リスト</span>
      </nav>
      <div class="rounded-xl border px-4 py-3 bg-white shadow-sm">
        <h1 class="text-2xl font-bold flex items-center gap-2">
          <span class="lucide w-6 h-6 text-emerald-600" data-lucide="leaf"></span>
          旬の食材リスト
        </h1>
        <p class="text-sm text-gray-600">季節・月・分類・キーワード・食べたい登録状況で旬の食材を検索できます。</p>
      </div>
    </div>
  </header>

  <form method="get" class="bg-white border rounded-xl shadow-sm p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-gray-600">キーワード</label>
      <input type="text" name="keyword" value="<%= keyword || '' %>" placeholder="食材名・読み・分類を検索" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500" />
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-gray-600">分類</label>
      <select name="classification" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
        <option value="">すべて</option>
        <% (classifications || []).forEach((c)=>{ %>
          <option value="<%= c %>" <%= classification === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-gray-600">季節</label>
      <select name="season" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
        <option value="">選択なし</option>
        <% (seasonOptions || []).forEach((s)=>{ %>
          <option value="<%= s %>" <%= selectedSeason === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-gray-600">月</label>
      <select name="month" class="border rounded-lg px-3 py-2 h-11 focus:outline-none focus:ring-1 focus:ring-blue-500">
        <option value="">選択なし</option>
        <% (monthOptions || []).forEach((m)=>{ %>
          <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select>
    </div>
    <fieldset class="flex flex-col gap-1 md:col-span-2 lg:col-span-4">
      <legend class="text-xs font-semibold text-gray-600">食べたい食材</legend>
      <div class="flex items-center gap-5 h-11">
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" name="wanted" value="yes" <%= wantedChecked.has('yes') ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300 text-rose-600" />
          登録あり
        </label>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" name="wanted" value="no" <%= wantedChecked.has('no') ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300 text-rose-600" />
          登録なし
        </label>
        <span class="text-xs text-gray-500">対象: <%= wantedMonthLabel %></span>
      </div>
    </fieldset>
    <div class="md:col-span-2 lg:col-span-4 flex items-center justify-between flex-wrap gap-2 text-xs text-gray-600">
      <span>春(3-5月)・夏(6-9月)・秋(10-11月)・冬(12-2月)として判定し、季節は ALL 登録を含めません。</span>
      <div class="flex items-center gap-2">
        <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold">絞り込む</button>
        <a href="/users/seasonal-ingredients" class="px-4 py-2 rounded-lg border border-gray-600 text-sm font-semibold text-gray-900 hover:bg-gray-100 transition">クリア</a>
      </div>
    </div>
  </form>

  <div class="space-y-6">
    <section class="space-y-3">
      <div class="flex items-center gap-3 text-sm text-gray-700">
        <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-3 py-1 text-sky-700">
          <span class="lucide w-4 h-4" data-lucide="calendar"></span>
          <span><%= selectedMonth %></span>
        </span>
        <span class="text-sm text-gray-600">該当 <%= (monthlyList || []).length %> 件</span>
      </div>
      <% if (!(monthlyList || []).length) { %>
        <div class="border border-dashed border-sky-200 rounded-xl bg-sky-50 text-sky-800 text-sm px-4 py-3">
          選択した条件に一致する旬の食材がありませんでした。
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% monthlyList.forEach((item)=>{ const seasons = Array.isArray(item.season) ? item.season.filter(Boolean) : []; const months = Array.isArray(item.month) ? item.month.filter(Boolean) : []; const usage = usageFor(item._id); const extra = Math.max(0, usage.length - 3); %>
            <div class="bg-white border border-gray-200 shadow-sm rounded-xl overflow-hidden flex flex-col">
              <div class="h-40 bg-gray-100 relative">
                <% if (item.imageUrl) { %>
                  <img src="<%= item.imageUrl %>" alt="<%= item.ingredient %>" class="object-cover w-full h-full" />
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
                <% } %>
                <% if (item.classification) { %>
                  <span class="absolute top-2 left-2 inline-flex items-center px-2 py-1 text-[11px] font-semibold rounded-full bg-amber-50 text-amber-700"><%= item.classification %></span>
                <% } %>
              </div>
              <div class="p-4 space-y-3 flex-1 flex flex-col">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="text-lg font-semibold text-gray-900 leading-tight break-words"><%= item.ingredient %></h3>
                    <% if (item.yomi) { %>
                      <p class="text-xs text-gray-500 mt-0.5"><%= item.yomi %></p>
                    <% } %>
                  </div>
                  <% if (item.wikiUrl) { %>
                    <a href="<%= item.wikiUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold border border-blue-200">
                      <span class="lucide w-4 h-4" data-lucide="external-link"></span>
                      Wiki
                    </a>
                  <% } %>
                </div>
                <div class="bg-gray-50 rounded-lg p-3 space-y-2 text-sm text-gray-700">
                  <p class="text-xs text-gray-500 font-semibold">100gあたり</p>
                  <p class="text-sm">エネルギー: <strong><%= fmtNumber(item.energy) %></strong> kcal</p>
                  <div class="grid grid-cols-2 gap-x-4 gap-y-1">
                    <span>水分量: <strong><%= fmtNumber(item.water) %></strong> g</span>
                    <span>タンパク質: <strong><%= fmtNumber(item.protein) %></strong> g</span>
                    <span>脂質: <strong><%= fmtNumber(item.lipid) %></strong> g</span>
                    <span>炭水化物: <strong><%= fmtNumber(item.carbohydrate) %></strong> g</span>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2 text-xs text-gray-700">
                  <% if (seasons.length) { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-1 text-emerald-700 font-semibold">季節: <%= seasons.join(' / ') %></span>
                  <% } %>
                  <% if (months.length) { %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-1 text-blue-700 font-semibold">月: <%= months.join(' / ') %></span>
                  <% } %>
                </div>
                <% const isWanted = wantedIdSet.has(String(item._id)); %>
                <button
                  type="button"
                  data-action="toggle-wanted"
                  data-ingredient-id="<%= item._id %>"
                  data-year-month="<%= selectedWantedMonth %>"
                  data-registered="<%= isWanted ? 'true' : 'false' %>"
                  class="w-full inline-flex items-center justify-center gap-2 rounded-lg border px-3 py-2 text-sm font-semibold transition <%= isWanted ? 'border-rose-300 bg-rose-50 text-rose-700 hover:bg-rose-100' : 'border-emerald-300 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %>"
                >
                  <span class="lucide w-4 h-4" data-lucide="<%= isWanted ? 'check' : 'plus' %>"></span>
                  <span><%= isWanted ? `${wantedActionMonthLabel}の食べたい登録を外す` : `${wantedActionMonthLabel}はこの食材を食べたい` %></span>
                </button>
                <div class="space-y-1">
                  <p class="text-xs text-gray-500 font-semibold">この食材を使うメニュー</p>
                  <% if (!usage.length) { %>
                    <p class="text-xs text-gray-500">該当メニューはまだありません。</p>
                  <% } else { %>
                    <div class="flex flex-wrap gap-2">
                      <% usage.slice(0,3).forEach((menu)=>{ const href = menu.url ? menu.url : `/users/menu/${menu.id}`; const type = menu.sourceType || 'shared'; const tagClass = type === 'url' ? 'bg-green-50 text-green-700 border-green-200 hover:bg-green-100' : (type === 'shared' ? 'bg-blue-50 text-blue-700 border-blue-200 hover:bg-blue-100' : 'bg-purple-50 text-purple-700 border-purple-200 hover:bg-purple-100'); const amt = (typeof menu.amountGrams === 'number') ? `${menu.amountGrams}g` : (typeof menu.amount === 'number' ? `${menu.amount}g` : ''); %>
                        <a href="<%= href %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs border <%= tagClass %>">
                          <span class="lucide w-3 h-3" data-lucide="utensils-crossed"></span>
                          <span class="truncate max-w-[150px]"><%= menu.name %></span>
                          <% if (amt) { %><span class="text-[11px] opacity-80">(<%= amt %>)</span><% } %>
                        </a>
                      <% }); %>
                      <% if (extra > 0) { %>
                        <button type="button" data-action="show-usage" data-ingredient-id="<%= item._id %>" class="inline-flex items-center px-2 py-1 rounded-full bg-white text-gray-700 text-xs border border-gray-300 hover:bg-gray-50">
                          +<%= extra %>件
                        </button>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>
  </div>
</section>

<!-- Usage modal -->
<div id="usage-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/40" data-action="close-usage"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full border border-gray-200 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b">
        <div class="flex items-center gap-2">
          <span class="lucide w-5 h-5 text-gray-600" data-lucide="utensils-crossed"></span>
          <h3 class="font-semibold text-gray-800 text-sm">この食材を使うメニュー</h3>
        </div>
        <button type="button" class="text-gray-500 hover:text-gray-700" data-action="close-usage">
          <span class="lucide w-5 h-5" data-lucide="x"></span>
        </button>
      </div>
      <div class="p-5 max-h-[60vh] overflow-y-auto" id="usage-modal-body">
        <p class="text-sm text-gray-500">読み込み中...</p>
      </div>
    </div>
  </div>
  <script>
    window.refreshLucideIcons && window.refreshLucideIcons();
  </script>
</div>

<script>
  (function(){
    const usageMap = new Map(Object.entries(<%- JSON.stringify(menuUsage || {}) %>));
    const modal = document.getElementById('usage-modal');
    const body = document.getElementById('usage-modal-body');

    const renderTags = (list = []) => {
      if (!list.length) {
        body.innerHTML = '<p class="text-sm text-gray-500">該当メニューはまだありません。</p>';
        return;
      }
      const frag = document.createElement('div');
      frag.className = 'flex flex-wrap gap-2';
      list.forEach((m) => {
        const external = !!m.url;
        const href = external ? m.url : `/users/menu/${m.id}`;
        const type = m.sourceType || 'shared';
        const amt = (typeof m.amountGrams === 'number') ? `${m.amountGrams}g` : (typeof m.amount === 'number' ? `${m.amount}g` : '');
        const cls =
          type === 'url'
            ? 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs bg-green-50 text-green-700 border border-green-200 hover:bg-green-100'
            : type === 'shared'
              ? 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100'
              : 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs bg-purple-50 text-purple-700 border border-purple-200 hover:bg-purple-100';
        const a = document.createElement('a');
        a.className = cls;
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.innerHTML = '<span class="lucide w-3 h-3" data-lucide="utensils-crossed"></span>' +
          '<span class="truncate max-w-[220px]">' + (m.name || '') + '</span>' +
          (amt ? ' <span class="text-[11px] opacity-80">(' + amt + ')</span>' : '');
        frag.appendChild(a);
      });
      body.innerHTML = '';
      body.appendChild(frag);
      window.refreshLucideIcons && window.refreshLucideIcons();
    };

    const openModal = (ingredientId) => {
      const key = String(ingredientId || '');
      const list = usageMap.get(key) || [];
      renderTags(list);
      modal.classList.remove('hidden');
    };
    const closeModal = () => {
      modal.classList.add('hidden');
    };

    document.addEventListener('click', (ev) => {
      const wantedBtn = ev.target.closest('[data-action="toggle-wanted"]');
      if (wantedBtn) {
        const registered = wantedBtn.dataset.registered === 'true';
        wantedBtn.disabled = true;
        fetch('/users/seasonal-ingredients/wanted', {
          method: registered ? 'DELETE' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ingredientId: wantedBtn.dataset.ingredientId,
            yearMonth: wantedBtn.dataset.yearMonth
          })
        })
          .then(async (response) => {
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || '更新できませんでした。');
            window.location.reload();
          })
          .catch((error) => {
            wantedBtn.disabled = false;
            alert(error.message || '更新できませんでした。');
          });
        return;
      }
      const showBtn = ev.target.closest('[data-action="show-usage"]');
      if (showBtn && showBtn.dataset.ingredientId) {
        openModal(showBtn.dataset.ingredientId);
        return;
      }
      if (ev.target.closest('[data-action="close-usage"]')) {
        closeModal();
        return;
      }
    });
  })();
  window.refreshLucideIcons && window.refreshLucideIcons();
</script>
