<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">レシピサイトから登録</h1>
      <p class="text-sm text-gray-500">URLを入力すると候補情報を自動抽出（修正可）</p>
    </div>
    <a href="/users/my-menu" class="text-sm text-blue-600 font-semibold">マイメニュートップへ</a>
  </header>

  <div class="bg-white border rounded-2xl p-4 space-y-4">
    <form id="fetchForm" class="flex gap-3">
      <input id="recipeUrl" type="url" placeholder="https://..." class="flex-1 border rounded-lg px-3 py-2" required />
      <button class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold" type="submit">自動抽出</button>
    </form>
    <p class="text-xs text-gray-500">登録済み件数: <%= typeof myUrlCount !== 'undefined' ? myUrlCount : 0 %></p>
  </div>

  <form method="post" action="/users/my-menu/from-url" class="bg-white border rounded-2xl p-5 space-y-4">
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs text-gray-500">レシピ名</label>
        <input name="name" id="f_name" class="w-full border rounded-lg px-3 py-2" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">よみ</label>
        <input name="yomi" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="text-xs text-gray-500">メニュー（自由入力 or 選択）</label>
        <input name="menu" list="menuList" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="menuList">
          <% (menuNames || []).forEach(function(m){ if (!m) return; %>
            <option value="<%= m %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">種類</label>
        <input list="kindList" name="kind" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="kindList">
          <% kinds.forEach(function(k){ %>
            <option value="<%= k %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">ジャンル</label>
        <input list="junleList" name="junle" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="junleList">
          <% junles.forEach(function(j){ %>
            <option value="<%= j %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理方法</label>
        <input list="cookList" name="cook" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="cookList">
          <% cooks.forEach(function(c){ %>
            <option value="<%= c %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">レシピURL</label>
        <input name="url" id="f_url" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="text-xs text-gray-500">画像URL（プレビューあり）</label>
        <div class="flex gap-3 items-start">
          <input name="imageUrl" id="f_imageUrl" class="flex-1 border rounded-lg px-3 py-2" />
          <img id="imgPreview" src="" alt="preview" class="w-24 h-24 object-cover rounded border" />
        </div>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理時間（分）</label>
        <input name="time" id="f_time" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="text-xs text-gray-500">人数</label>
        <input name="people" id="f_people" type="number" min="1" step="1" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-gray-500">コメント</label>
        <textarea name="comment" id="f_comment" rows="3" class="w-full border rounded-lg px-3 py-2" placeholder="メモや補足"></textarea>
      </div>
    </div>

    <!-- 食材登録 -->
    <div class="border-t pt-4">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">食材</h3>
        <button type="button" id="openIngModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 食材を追加</button>
      </div>
      <div id="ingredientsList" class="mt-2 space-y-2"></div>
    </div>

    <!-- 調味料登録 -->
    <div class="border-t pt-4">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">調味料</h3>
        <button type="button" id="openSeaModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 調味料を追加</button>
      </div>
      <div id="seasoningsList" class="mt-2 space-y-2"></div>
    </div>

    <div class="border-t pt-4">
      <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="favorite" value="true" checked class="w-4 h-4"/>
            <span>お気に入り</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">食べたい頻度
            <select name="frequency" class="border rounded px-2 py-1">
              <% [5,4,3,2,1].forEach(function(i){ %>
                <option value="<%= i %>"><%= i %><% if (i===5) { %>（高い）<% } else if (i===1) { %>（低い）<% } %></option>
              <% }) %>
            </select>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="skill" value="true" class="w-4 h-4"/>
            <span>得意</span>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="share" value="true" class="w-4 h-4"/>
            <span>共有する</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">共有範囲
            <select name="shareScope" class="border rounded px-2 py-1">
              <option value="group">グループ内</option>
              <option value="all">全会員</option>
            </select>
          </label>
        </div>
      </div>
    </div>

    <div class="pt-2">
      <button class="px-5 py-2 rounded-lg bg-emerald-600 text-white font-semibold">登録する</button>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById('fetchForm');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = document.getElementById('recipeUrl').value.trim();
    if (!url) return;
    try {
      const res = await fetch('/users/my-menu/from-url/fetch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });
      const data = await res.json();
      if (data && data.duplicate) {
        alert('このURLは既に登録されています。');
        return;
      }
      document.getElementById('f_url').value = url;
      if (data.title && !document.getElementById('f_name').value) {
        document.getElementById('f_name').value = data.title;
      }
      if (data.image && !document.getElementById('f_imageUrl').value) {
        document.getElementById('f_imageUrl').value = data.image;
        const img = document.getElementById('imgPreview');
        if (img) img.src = data.image;
      }
      if (typeof data.time === 'number' && !Number.isNaN(data.time)) {
        const t = document.getElementById('f_time');
        if (t && !t.value) t.value = String(data.time);
      }
      if (typeof data.people === 'number' && data.people > 0) {
        const p = document.getElementById('f_people');
        if (p && !p.value) p.value = String(data.people);
      }
      if (data.comment) {
        const c = document.getElementById('f_comment');
        if (c && !c.value) c.value = data.comment;
      }
    } catch (e) {
      console.error(e);
      alert('自動抽出に失敗しました');
    }
  });

  // Live preview for image URL
  const imgInput = document.getElementById('f_imageUrl');
  imgInput?.addEventListener('input', () => {
    const img = document.getElementById('imgPreview');
    if (img) img.src = imgInput.value.trim();
  });

  // Build dynamic ingredient/seasoning rows
  const ING = <%- JSON.stringify((ingredients||[]).map(i=>({id:String(i._id), name:i.ingredient, units:i.unit||[], genre:i.classification||''}))) %>;
  const SEAS = <%- JSON.stringify((seasonings||[]).map(s=>({id:String(s._id), name:s.seasoning, units:s.unit||[], genre:s.classification||''}))) %>;
  const UNITS = <%- JSON.stringify(allUnits||[]) %>;

  function createRow(kind, item){
    const wrap = document.createElement('div');
    wrap.className = 'flex gap-2 items-center';
    const labelBox = document.createElement('div');
    labelBox.className = 'flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2';
    const title = document.createElement('span'); title.className='text-sm font-medium'; title.textContent = item?.name || '';
    const badge = document.createElement('span'); badge.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; badge.textContent = item?.genre || '';
    labelBox.appendChild(title); if (item?.genre) labelBox.appendChild(badge);
    const hiddenId = document.createElement('input'); hiddenId.type='hidden'; hiddenId.value = item?.id || '';
    const amount = document.createElement('input');
    amount.type = 'number'; amount.step = '0.1'; amount.min = '0';
    amount.className = 'w-24 border rounded px-2 py-1';
    let unit;
    if (item && Array.isArray(item.units) && item.units.length) {
      unit = document.createElement('select');
      unit.className = 'w-28 border rounded px-2 py-1';
      item.units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unit.appendChild(op); });
    } else {
      unit = document.createElement('input'); unit.setAttribute('list','unitList'); unit.className='w-24 border rounded px-2 py-1';
    }
    const del = document.createElement('button');
    del.type = 'button'; del.textContent = '削除'; del.className = 'px-2 py-1 text-xs border rounded';
    del.addEventListener('click', ()=> wrap.remove());

    if (kind==='ingredient') {
      hiddenId.name = 'ingredient_ids[]';
      amount.name = 'ingredient_amounts[]';
      unit.name = 'ingredient_units[]';
    } else {
      hiddenId.name = 'seasoning_ids[]';
      amount.name = 'seasoning_amounts[]';
      unit.name = 'seasoning_units[]';
    }
    wrap.append(labelBox, hiddenId, amount, unit, del);
    return wrap;
  }

  const unitDL = document.createElement('datalist');
  unitDL.id = 'unitList';
  (UNITS||[]).forEach(u=>{
    const op = document.createElement('option'); op.value = u; unitDL.appendChild(op);
  });
  document.body.appendChild(unitDL);
</script>

<script>
  // モーダル: プリセット選択 or オリジナル追加（タグ/チップUI）
  (function(){
    function buildChipModal(type){
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 z-50 hidden overflow-y-auto';
      modal.innerHTML = `
        <div class=\"absolute inset-0 bg-black/40\" data-close></div>
        <div class=\"relative mx-auto mt-10 w-[840px] max-w-[96vw] rounded-2xl bg-white shadow-xl\">
          <div class=\"flex items-center justify-between border-b px-5 py-3\">
            <h3 class=\"font-semibold\">${type==='ingredient' ? '食材を追加' : '調味料を追加'}</h3>
            <button type=\"button\" data-close class=\"text-gray-500\">✕</button>
          </div>
          <div class=\"p-4 space-y-3\">
            <div class=\"inline-flex p-1 bg-gray-100 rounded-full text-sm\">
              <button data-tab=\"preset\" class=\"px-4 py-1 rounded-full bg-white shadow text-gray-900\">プリセットから選択</button>
              <button data-tab=\"original\" class=\"px-4 py-1 rounded-full text-gray-600\">オリジナル追加</button>
            </div>
            <div data-view=\"preset\" class=\"space-y-3\">
              <input data-role=\"kw\" placeholder=\"検索...\" class=\"w-full border rounded px-3 py-2\"/>
              <div data-role=\"genres\" class=\"flex flex-wrap gap-2\"></div>
              <div data-role=\"tags\" class=\"flex flex-wrap gap-2 max-h-[40vh] overflow-auto border rounded p-3 bg-green-50\"></div>
              <div data-role=\"selected\" class=\"hidden border rounded p-3 bg-blue-50\"></div>
            </div>
            <div data-view=\"original\" class=\"hidden space-y-3\">
              <div class=\"grid grid-cols-3 gap-3\">
                <div><label class=\"text-xs text-gray-500\">名前</label><input data-o=\"name\" class=\"w-full border rounded px-3 py-2\"></div>
                <div><label class=\"text-xs text-gray-500\">カテゴリー</label><select data-o=\"cat\" class=\"w-full border rounded px-3 py-2\"><option value=\"\">選択してください<\/option><\/select></div>
                <div><label class=\"text-xs text-gray-500\">単位（カンマ区切り）</label><input data-o=\"units\" class=\"w-full border rounded px-3 py-2\" placeholder=\"g, ml, 本\"></div>
              </div>
              <div class=\"text-right\"><button data-role=\"create\" class=\"px-4 py-1.5 rounded bg-emerald-600 text-white text-sm\">作成して追加</button></div>
            </div>
          </div>
        </div>`;
      document.body.appendChild(modal);

      const presetView = modal.querySelector('[data-view="preset"]');
      const originalView = modal.querySelector('[data-view="original"]');
      const tabPreset = modal.querySelector('[data-tab="preset"]');
      const tabOriginal = modal.querySelector('[data-tab="original"]');
      function switchTab(tab){
        if (tab==='preset'){
          tabPreset.classList.add('bg-white','shadow','text-gray-900'); tabOriginal.classList.remove('bg-white','shadow','text-gray-900');
          presetView.classList.remove('hidden'); originalView.classList.add('hidden');
        } else {
          tabOriginal.classList.add('bg-white','shadow','text-gray-900'); tabPreset.classList.remove('bg-white','shadow','text-gray-900');
          originalView.classList.remove('hidden'); presetView.classList.add('hidden');
        }
      }
      tabPreset.addEventListener('click', ()=>switchTab('preset'));
      tabOriginal.addEventListener('click', ()=>switchTab('original'));

      function close(){ modal.classList.add('hidden'); }
      modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });

      const apiBase = type==='ingredient' ? '/users/my-menu/api/ingredients' : '/users/my-menu/api/seasonings';
      async function fetchList(params){
        const url = new URL(apiBase, location.origin);
        Object.entries(params||{}).forEach(([k,v])=>{ if (v) url.searchParams.set(k, v); });
        const res = await fetch(url.toString());
        return res.json();
      }
      function clearSelectionUI(){
        state.selectedId = null; state.selected = null; state._tagButtons = [];
        const box = modal.querySelector('[data-role="selected"]'); if (box){ box.classList.add('hidden'); box.innerHTML=''; }
      }
      async function buildGenresPersistent(){
        const holder = modal.querySelector('[data-role="genres"]');
        holder.innerHTML = '';
        // fetch all genres regardless of keyword/limit
        try {
          const metaUrl = new URL(apiBase, location.origin); metaUrl.searchParams.set('meta','genres');
          const metaRes = await fetch(metaUrl.toString());
          const meta = await metaRes.json();
          const cats = Array.isArray(meta?.genres) ? meta.genres : [];
          // populate category select in Original tab
          const catSel = modal.querySelector('[data-o="cat"]');
          if (catSel && catSel.tagName === 'SELECT') {
            catSel.innerHTML = '<option value="">選択してください</option>';
            cats.forEach(c=>{ const op=document.createElement('option'); op.value=c; op.textContent=c; catSel.appendChild(op); });
          }
          // Dropdown for genre filter
          holder.className = 'flex items-center gap-2';
          const label=document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
          const sel=document.createElement('select'); sel.className='border rounded px-3 py-2';
          const all = ['すべて', ...cats];
          all.forEach((labelTxt, idx)=>{ const val = idx===0 ? '' : labelTxt; const op=document.createElement('option'); op.value=val; op.textContent=labelTxt; if(String(state.genre||'')===String(val||'')) op.selected=true; sel.appendChild(op); });
          sel.addEventListener('change', ()=>{ state.genre = sel.value; clearSelectionUI(); run(); });
          holder.appendChild(label); holder.appendChild(sel);
        } catch(_) { /* no-op */ }
      }
      function buildTags(items){
        const tags = modal.querySelector('[data-role="tags"]');
        tags.innerHTML='';
        state._tagButtons = [];
        items.forEach(it=>{
          const label = it.ingredient || it.seasoning || '';
          const id = String(it._id || label);
          const b=document.createElement('button'); b.type='button'; b.className='px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200'; b.textContent=label;
          const paint=()=>{
            const active = state.selectedId && state.selectedId===id;
            b.classList.toggle('bg-gray-900', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('bg-gray-100', !active);
          };
          b.addEventListener('click', ()=>{ state.selectedId = id; (state._tagButtons||[]).forEach(x=>{ const a = state.selectedId===x.id; x.el.classList.toggle('bg-gray-900', a); x.el.classList.toggle('text-white', a); x.el.classList.toggle('bg-gray-100', !a); }); selectItem(it); });
          tags.appendChild(b);
          state._tagButtons.push({ id, el: b });
          paint();
        });
      }
      function showSelected(it){
        const box = modal.querySelector('[data-role="selected"]');
        box.classList.remove('hidden');
        const name = it.ingredient || it.seasoning || '';
        const units = Array.isArray(it.unit) ? it.unit : (it.unit? [it.unit] : []);
        box.innerHTML = '';
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3';
        const info = document.createElement('div'); info.className='flex-1'; info.innerHTML=`<div class="font-semibold">${name}</div><div class="text-xs text-gray-600">カテゴリ: ${it.classification||'-'}</div>`;
        const hiddenId = document.createElement('input'); hiddenId.type='hidden'; hiddenId.value = String(it._id);
        const amount = document.createElement('input'); amount.type='number'; amount.min='0'; amount.step='0.1'; amount.className='w-24 border rounded px-2 py-1';
        let unitEl; if (units.length){ unitEl=document.createElement('select'); unitEl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); }); } else { unitEl=document.createElement('input'); unitEl.className='w-24 border rounded px-2 py-1'; unitEl.setAttribute('list','unitList'); }
        // 単位追加（自グループのオリジナルのみ有効）
        const canAddUnit = !!it.group; // サーバから group が返る
        const addUnitBtn = document.createElement('button'); addUnitBtn.type='button'; addUnitBtn.textContent='＋単位を追加'; addUnitBtn.className='text-xs text-emerald-700 underline';
        addUnitBtn.addEventListener('click', async ()=>{
          const newUnit = (prompt('追加する単位を入力（カンマ可）')||'').trim();
          if (!newUnit) return;
          try {
            const endpoint = type==='ingredient' ? `/users/my-menu/api/ingredients/${String(it._id)}/units` : `/users/my-menu/api/seasonings/${String(it._id)}/units`;
            const res = await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ units: newUnit }) });
            if (!res.ok) { const m = await res.json().catch(()=>({})); alert(m.error || '追加に失敗しました'); return; }
            const data = await res.json();
            const list = Array.isArray(data.units)? data.units: [];
            if (unitEl.tagName==='SELECT'){
              unitEl.innerHTML=''; list.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); }); unitEl.value = newUnit.split(',').slice(-1)[0].trim();
            }
          } catch(_) { alert('追加に失敗しました'); }
        });
        const addBtn = document.createElement('button'); addBtn.type='button'; addBtn.textContent='追加'; addBtn.className='px-3 py-1.5 rounded bg-blue-600 text-white text-sm';
        addBtn.addEventListener('click', ()=>{
          const payload = { id: hiddenId.value, name, units };
          const wrap = createRow(type, { id: payload.id, name, genre: it.classification||'', units });
          // preset row already contains inputs; set values from this panel
          const inputs = wrap.querySelectorAll('input, select');
          // [hiddenId, amount, unit/select]
          if (inputs && inputs.length >= 3){
            const amountEl = inputs[1];
            const unitEl2 = inputs[2];
            amountEl.value = amount.value || '';
            if (unitEl2.tagName === 'SELECT') unitEl2.value = unitEl.value;
            else unitEl2.value = unitEl.value;
          }
          const containerId = type==='ingredient' ? 'ingredientsList' : 'seasoningsList';
          document.getElementById(containerId).appendChild(wrap);
          close();
        });
        if (canAddUnit) row.append(info, hiddenId, amount, unitEl, addUnitBtn, addBtn);
        else row.append(info, hiddenId, amount, unitEl, addBtn);
        box.appendChild(row);
      }
      function selectItem(it){ state.selected = it; showSelected(it); }
      const state = { keyword: '', genre: '', selected: null, selectedId: null };
      async function run(){
        const data = await fetchList({ keyword: state.keyword, genre: state.genre });
        if (!state._genresBuilt){ await buildGenresPersistent(); state._genresBuilt=true; }
        // Apply genre filter client side too for quick switch
        const list = state.genre ? data.filter(x=>x.classification===state.genre) : data;
        buildTags(list);
      }
      presetView.querySelector('[data-role="kw"]').addEventListener('input', (e)=>{ state.keyword = e.target.value; run(); });
      modal.addEventListener('click', (e)=>{ /* no-op to keep modal open on clicks */ });

      // Original create
      modal.querySelector('[data-role="create"]').addEventListener('click', async ()=>{
        const name = modal.querySelector('[data-o="name"]').value.trim();
        const cat = modal.querySelector('[data-o="cat"]').value.trim();
        const units = modal.querySelector('[data-o="units"]').value.trim();
        if (!name) { alert('名前を入力してください'); return; }
        const endpoint = type==='ingredient' ? '/users/my-menu/api/ingredients/custom' : '/users/my-menu/api/seasonings/custom';
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, classification: cat, units }) });
        if (!res.ok){ const m = await res.json().catch(()=>({})); alert(m.error || '作成に失敗しました'); return; }
        const created = await res.json();
        const wrap = createRow(type, { id: String(created._id), name: created.ingredient || created.seasoning || name, genre: created.classification || cat, units: Array.isArray(created.unit)? created.unit: (created.unit? [created.unit]: []) });
        const containerId = type==='ingredient' ? 'ingredientsList' : 'seasoningsList';
        document.getElementById(containerId).appendChild(wrap);
        close();
      });

      return { open: ()=>{ modal.classList.remove('hidden'); switchTab('preset'); clearSelectionUI(); run(); } };
    }
    const ing = buildChipModal('ingredient');
    const sea = buildChipModal('seasoning');
    document.getElementById('openIngModal')?.addEventListener('click', ()=>ing.open());
    document.getElementById('openSeaModal')?.addEventListener('click', ()=>sea.open());
  })();
</script>
