  /* --- hero carousel --- */
  /* --- hero ribbon slider --- */
  .ribbon-shell { position: relative; }
  .ribbon-viewport { overflow: hidden; }
  .ribbon-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 46%;
    gap: 18px;
    transition: transform .6s ease;
    padding: 12px 4px 24px;
  }
  @media (min-width: 640px) {
    .ribbon-track { grid-auto-columns: 40%; }
  }
  @media (min-width: 768px) {
    .ribbon-track { grid-auto-columns: 32%; }
  }
  @media (min-width: 1024px) {
    .ribbon-track { grid-auto-columns: 28%; }
  }
  @media (min-width: 1360px) {
    .ribbon-track { grid-auto-columns: 24%; }
