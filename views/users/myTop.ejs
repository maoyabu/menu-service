    position: absolute;
    left: 14px;
    top: 14px;
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #fde68a, #f59e0b);
    color: #5b3b00;
    font-weight: 700;
    font-size: 13px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }
