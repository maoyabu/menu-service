<script>
  (function(){
    var el = document.getElementById('hero-carousel');
    if (!el) return;
    var items = Array.isArray(window.headerItems) ? window.headerItems.slice(0, 10) : [];
    if (!items.length) return; // keep the fallback tile
    var empty = el.querySelector('[data-carousel-empty]');
    if (empty) empty.remove();

    // Build a two-layer stage (A/B) for random transitions
    var stage = document.createElement('div');
    stage.className = 'hero-stage';
    el.appendChild(stage);

    var imgA = document.createElement('img');
    imgA.className = 'hero-img is-visible';
    var imgB = document.createElement('img');
    imgB.className = 'hero-img';
    stage.appendChild(imgA);
    stage.appendChild(imgB);

    var nameChip = document.getElementById('hero-name-chip');
    var setName = function(index){
      if (!nameChip) return;
      var it = items[index];
      var label = (it && it.name) ? it.name : '';
      if (label) {
        nameChip.textContent = label;
        nameChip.title = label; // show full name on hover
        nameChip.classList.remove('hidden');
      } else {
        nameChip.textContent = '';
        nameChip.removeAttribute('title');
        nameChip.classList.add('hidden');
      }
    };

    // Initialize first frame
    var current = 0;
    imgA.src = items[0].imageUrl;
    imgA.alt = items[0].name || 'header image 1';
    setName(0);

    var useA = true; // which image element is the current visible one
    var DURATION = 800; // ms
    var INTERVAL = 6000; // ms

    function applyTransition(type, fromEl, toEl) {
      // Reset inline styles
      [fromEl, toEl].forEach(function(elm){
        elm.style.transition = 'none';
        elm.style.opacity = '';
        elm.style.transform = '';
      });

      // Force reflow to apply initial state before transition
      void toEl.offsetWidth;

      // Common: ensure toEl is on top and visible before anim
      toEl.classList.add('is-visible');

      // Set initial states by type
      if (type === 'fade') {
        toEl.style.opacity = 0;
      } else if (type === 'slide-left') {
        toEl.style.transform = 'translateX(100%)';
        toEl.style.opacity = 1;
      } else if (type === 'slide-right') {
        toEl.style.transform = 'translateX(-100%)';
        toEl.style.opacity = 1;
      } else if (type === 'slide-up') {
        toEl.style.transform = 'translateY(100%)';
        toEl.style.opacity = 1;
      } else if (type === 'slide-down') {
        toEl.style.transform = 'translateY(-100%)';
        toEl.style.opacity = 1;
      } else if (type === 'zoom-in') {
        // New image starts slightly enlarged and scales down to 1
        toEl.style.transform = 'scale(1.15)';
        toEl.style.opacity = 1;
      } else if (type === 'zoom-out') {
        // New image starts slightly smaller and scales up to 1
        toEl.style.transform = 'scale(0.85)';
        toEl.style.opacity = 1;
      }

      // Enable transition
      var t = 'transform .8s ease, opacity .8s ease';
      fromEl.style.transition = t;
      toEl.style.transition = t;

      requestAnimationFrame(function(){
        if (type === 'fade') {
          fromEl.style.opacity = 0;
          toEl.style.opacity = 1;
        } else if (type === 'slide-left') {
          fromEl.style.transform = 'translateX(-100%)';
          toEl.style.transform = 'translateX(0)';
        } else if (type === 'slide-right') {
          fromEl.style.transform = 'translateX(100%)';
          toEl.style.transform = 'translateX(0)';
        } else if (type === 'slide-up') {
          fromEl.style.transform = 'translateY(-100%)';
          toEl.style.transform = 'translateY(0)';
        } else if (type === 'slide-down') {
          fromEl.style.transform = 'translateY(100%)';
          toEl.style.transform = 'translateY(0)';
        } else if (type === 'zoom-in') {
          fromEl.style.opacity = 0;
          fromEl.style.transform = 'scale(1.02)';
          toEl.style.transform = 'scale(1)';
        } else if (type === 'zoom-out') {
          fromEl.style.opacity = 0;
          fromEl.style.transform = 'scale(0.98)';
          toEl.style.transform = 'scale(1)';
        }

        // Cleanup after animation
        setTimeout(function(){
          fromEl.classList.remove('is-visible');
          fromEl.style.opacity = 0;
          fromEl.style.transform = '';
        }, DURATION + 50);
      });
    }

    function nextFrame(){
      var next = (current + 1) % items.length;
      var active = useA ? imgA : imgB;
      var idle  = useA ? imgB : imgA;

      // Prepare next image content
      idle.src = items[next].imageUrl;
      idle.alt = items[next].name || ('header image ' + (next+1));

      // Pick a random transition type
      var modes = ['fade','slide-left','slide-right','slide-up','slide-down','zoom-in','zoom-out'];
      var type = modes[Math.floor(Math.random() * modes.length)];

      applyTransition(type, active, idle);
      setName(next);

      // Flip buffers
      useA = !useA;
      current = next;
    }

    setInterval(nextFrame, INTERVAL);
  })();
</script>

<script>
  (function () {
    const weekPlanData = window.myTopWeekPlanData;
    const dayButtons = Array.from(document.querySelectorAll('[data-week-day-button]'));
    const recipesTitleEl = document.getElementById('weekly-plan-recipes-title');
    const recipesBodyEl = document.getElementById('weekly-plan-recipes-body');
    const ingredientsTitleEl = document.getElementById('weekly-plan-ingredients-title');
    const ingredientsBodyEl = document.getElementById('weekly-plan-ingredients-body');

    if (!weekPlanData || !Array.isArray(weekPlanData.days)) {
      if (recipesBodyEl) {
        recipesBodyEl.textContent = '今週の7 DAYS PLANはまだ登録されていません。';
      }
      if (ingredientsBodyEl) {
        ingredientsBodyEl.textContent = '必要な食材・調味料はまだありません。';
      }
      return;
    }

    const formatQuantity = (value) => {
      if (typeof value !== 'number' || Number.isNaN(value)) return '';
      const rounded = Math.round(value * 100) / 100;
      const text = rounded.toFixed(2).replace(/\.?0+$/, '');
      return text;
    };

    const formatAmount = (entry) => {
      if (!entry || !Array.isArray(entry.units) || !entry.units.length) {
        return '数量未設定';
      }
      const parts = entry.units.map((unitEntry) => {
        if (!unitEntry) return '';
        const { amount, unit } = unitEntry;
        if (amount === null || typeof amount === 'undefined') {
          return unit || '数量未設定';
        }
        const quantityText = formatQuantity(amount);
        if (!unit) return quantityText;
        const hasNonAscii = /[^\x00-\x7F]/.test(unit);
        return hasNonAscii ? `${unit}${quantityText}` : `${quantityText}${unit}`;
      }).filter(Boolean);
      return parts.length ? parts.join(' + ') : '数量未設定';
    };

    const renderDayDetails = (day) => {
      if (!recipesTitleEl || !recipesBodyEl || !ingredientsTitleEl || !ingredientsBodyEl) {
        return;
      }

      recipesTitleEl.textContent = `${day.display} (${day.weekday}) のレシピ`;
      recipesBodyEl.innerHTML = '';

      if (!day.hasPlan) {
        const message = document.createElement('div');
        message.className = 'rounded-lg bg-gray-50 px-4 py-3 text-sm text-gray-500';
        message.textContent = 'この日の献立はまだ登録されていません。';
        recipesBodyEl.appendChild(message);
      } else {
        day.meals.forEach((meal) => {
          const mealCard = document.createElement('div');
          mealCard.className = 'space-y-2 rounded-lg border border-blue-100 bg-white p-3';

          const header = document.createElement('div');
          header.className = 'flex items-center justify-between';
          const label = document.createElement('p');
          label.className = 'text-xs font-semibold text-blue-600 uppercase tracking-wide';
          label.textContent = meal.label;
          header.appendChild(label);
          mealCard.appendChild(header);

        const list = document.createElement('div');
          list.className = 'space-y-2';

          meal.slots.forEach((slot) => {
            const slotWrap = document.createElement('div');
            slotWrap.className = 'space-y-1';


            const nameRow = document.createElement('div');
            nameRow.className = 'flex items-center justify-between gap-3';
            const nameSpan = document.createElement('span');
            nameSpan.className = 'text-sm font-semibold text-gray-900';
            if (slot.menu && slot.menu.url) {
              const link = document.createElement('a');
              link.href = slot.menu.url;
              link.target = 'menuWindow';
              link.rel = 'noopener';
              link.className = 'hover:underline';
              link.textContent = slot.menu.name;
              nameSpan.appendChild(link);
            } else {
              nameSpan.textContent = slot.menu ? slot.menu.name : 'メニュー候補がありません';
            }
            nameRow.appendChild(nameSpan);
            // Remove old time text here, will add as tag below
            slotWrap.appendChild(nameRow);

            // タグ表示 (調理時間, ジャンル, 調理方法)
            if (slot.menu && (slot.menu.time || slot.menu.junle || slot.menu.cook)) {
              const chipWrap = document.createElement('div');
              chipWrap.className = 'flex flex-wrap gap-2 text-[11px] text-gray-500';

              // 調理時間タグを最初に追加
              if (slot.menu && slot.menu.time) {
                const timeChip = document.createElement('span');
                timeChip.className = 'inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-emerald-700';
                timeChip.innerHTML = `<span>時間</span><span class="font-medium">${String(slot.menu.time).endsWith('分') ? slot.menu.time : slot.menu.time + '分'}</span>`;
                chipWrap.appendChild(timeChip);
              }
              if (slot.menu.junle) {
                const chip = document.createElement('span');
                chip.className = 'inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5';
                chip.innerHTML = `<span>ジャンル</span><span class="font-medium text-amber-700">${slot.menu.junle}</span>`;
                chipWrap.appendChild(chip);
              }
              if (slot.menu.cook) {
                const chip = document.createElement('span');
                chip.className = 'inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5';
                chip.innerHTML = `<span>調理方法</span><span class="font-medium text-amber-700">${slot.menu.cook}</span>`;
                chipWrap.appendChild(chip);
              }
              slotWrap.appendChild(chipWrap);
            }

            // 画像とメインタグオーバーレイ
            if (slot.menu && slot.menu.url && slot.menu.imageUrl) {
              const imageLinkWrap = document.createElement('a');
              imageLinkWrap.href = slot.menu.url;
              imageLinkWrap.target = 'menuWindow';
              imageLinkWrap.rel = 'noopener';
              imageLinkWrap.className = 'block overflow-hidden rounded-lg border border-blue-100 bg-blue-100/60 relative';

              const img = document.createElement('img');
              img.src = slot.menu.imageUrl;
              img.alt = slot.menu.name;
              img.className = 'w-full h-32 object-cover';

              if (slot.categoryLabel) {
                const overlayTag = document.createElement('span');
                overlayTag.className = 'absolute top-2 left-2 inline-flex items-center gap-1 rounded-full bg-blue-50 text-blue-600 px-2 py-1 text-xs font-semibold';
                overlayTag.textContent = slot.categoryLabel;
                const overlayWrap = document.createElement('div');
                overlayWrap.className = 'relative';
                overlayWrap.appendChild(img);
                overlayWrap.appendChild(overlayTag);
                imageLinkWrap.appendChild(overlayWrap);
              } else {
                imageLinkWrap.appendChild(img);
              }
              slotWrap.prepend(imageLinkWrap);
              // 週のプランで使用している画像を除外候補に追加
              if (slot.menu && slot.menu.imageUrl) {
                window.weekPlanImageExclusions = window.weekPlanImageExclusions || [];
                if (!window.weekPlanImageExclusions.includes(slot.menu.imageUrl)) {
                  window.weekPlanImageExclusions.push(slot.menu.imageUrl);
                }
              }
            }

            list.appendChild(slotWrap);
          });

          mealCard.appendChild(list);
          recipesBodyEl.appendChild(mealCard);
        });
      }

      ingredientsTitleEl.textContent = `${day.display} の食材 / 調味料`;
      ingredientsBodyEl.innerHTML = '';

      const sections = [
        { title: '食材', items: day.ingredientsSummary },
        { title: '調味料', items: day.seasoningSummary }
      ];

      sections.forEach((section) => {
        const card = document.createElement('div');
        card.className = 'space-y-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2';

        const heading = document.createElement('p');
        heading.className = 'text-xs font-semibold text-amber-600 uppercase tracking-wide';
        heading.textContent = section.title;
        card.appendChild(heading);

        if (!section.items || !section.items.length) {
          const empty = document.createElement('p');
          empty.className = 'text-xs text-gray-400';
          empty.textContent = '項目はありません。';
          card.appendChild(empty);
        } else {
          const list = document.createElement('ul');
          list.className = 'space-y-1 text-sm text-gray-700';
          section.items.forEach((item) => {
            const li = document.createElement('li');
            li.className = 'flex items-center justify-between gap-3';
            const nameSpan = document.createElement('span');
            nameSpan.textContent = item.name;
            const amountSpan = document.createElement('span');
            amountSpan.className = 'text-xs text-gray-500';
            amountSpan.textContent = formatAmount(item);
            li.append(nameSpan, amountSpan);
            list.appendChild(li);
          });
          card.appendChild(list);
        }

        ingredientsBodyEl.appendChild(card);
      });

      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    };

    const selectDay = (index) => {
      const day = weekPlanData.days[index];
      if (!day) return;
      dayButtons.forEach((button) => {
        const isActive = Number(button.dataset.dayIndex) === index;
        if (isActive) {
          button.classList.add('is-selected');
        } else {
          button.classList.remove('is-selected');
        }
      });
      renderDayDetails(day);
    };

    if (dayButtons.length && weekPlanData.days.length) {
      dayButtons.forEach((button) => {
        button.addEventListener('click', () => {
          selectDay(Number(button.dataset.dayIndex));
        });
      });
      const defaultIndex = Math.min(
        Math.max(weekPlanData.defaultDayIndex || 0, 0),
        weekPlanData.days.length - 1
      );
      selectDay(defaultIndex);
    } else {
      if (recipesBodyEl) {
        recipesBodyEl.textContent = '今週の7 DAYS PLANはまだ登録されていません。';
      }
      if (ingredientsBodyEl) {
        ingredientsBodyEl.textContent = '必要な食材・調味料はまだありません。';
      }
    }
  })();
</script>

<script>
  (function () {
    const config = window.myTopData;
    if (!config) return;

    const monthLabelEl = document.getElementById('plan-calendar-month-label');
    const gridEl = document.getElementById('plan-calendar-grid');
    const prevBtn = document.getElementById('plan-calendar-prev');
    const nextBtn = document.getElementById('plan-calendar-next');

    if (!monthLabelEl || !gridEl || !prevBtn || !nextBtn) return;

    const baseParams = new URLSearchParams();
    if (config.currentGroupId) {
      baseParams.set('group', config.currentGroupId);
    }

    const startOfDay = (value) => {
      const date = value instanceof Date ? new Date(value) : new Date(value);
      date.setHours(0, 0, 0, 0);
      return date;
    };

    const startOfWeek = (value) => {
      const date = startOfDay(value);
      const day = date.getDay();
      const diff = (day + 6) % 7;
      date.setDate(date.getDate() - diff);
      return date;
    };

    const addDays = (value, days) => {
      const date = new Date(value);
      date.setDate(date.getDate() + days);
      return date;
    };

    const formatMonthLabel = (date) => `${date.getFullYear()}年 ${date.getMonth() + 1}月`;

    let currentMonth = config.initialMonth ? new Date(config.initialMonth) : (config.todayISO ? new Date(config.todayISO) : new Date());
    if (Number.isNaN(currentMonth.getTime())) currentMonth = new Date();
    currentMonth.setDate(1);

    let selectedButton = null;

    const fetchCalendarData = async (monthDate) => {
      const monthParam = `${monthDate.getFullYear()}-${String(monthDate.getMonth() + 1).padStart(2, '0')}`;
      const params = new URLSearchParams(baseParams);
      params.set('month', monthParam);
      const response = await fetch(`${config.apiBase}?${params.toString()}`);
      if (!response.ok) {
        throw new Error('カレンダーデータを取得できませんでした');
      }
      return response.json();
    };

    const buildCalendar = (calendarData) => {
      if (!calendarData || !calendarData.calendarStart || !calendarData.calendarEnd) {
        showStatusMessage('カレンダーを表示できません', 'text-gray-400');
        return;
      }

      const planMap = new Map((calendarData.weeks || []).map((week) => [startOfWeek(new Date(week.weekStart)).toISOString(), week]));
      const todayWeekStartISO = calendarData.todayWeekStart || startOfWeek(new Date()).toISOString();
      const calendarStart = new Date(calendarData.calendarStart);
      const calendarEnd = new Date(calendarData.calendarEnd);
      const totalDays = Math.round((calendarEnd.getTime() - calendarStart.getTime()) / (1000 * 60 * 60 * 24)) + 1;
      const displayMonth = currentMonth.getMonth();
      const displayYear = currentMonth.getFullYear();

      gridEl.innerHTML = '';
      selectedButton = null;

      for (let i = 0; i < totalDays; i += 1) {
        const dayDate = addDays(calendarStart, i);
        const button = document.createElement('button');
        button.type = 'button';
        const isOutsideMonth = dayDate.getMonth() !== displayMonth || dayDate.getFullYear() !== displayYear;
        const weekStartISO = startOfWeek(dayDate).toISOString();
        const planInfo = planMap.get(weekStartISO);
        const hasPlan = !!(planInfo && planInfo.planId);
        const weekStartTime = new Date(weekStartISO).getTime();
        const isPastWeek = weekStartTime < new Date(todayWeekStartISO).getTime();
        const status = hasPlan ? 'planned' : (isPastWeek ? 'past' : 'future');

        button.className = `plan-calendar-cell plan-calendar-cell--${status}${isOutsideMonth ? ' plan-calendar-cell--outside' : ''}`;
        button.dataset.weekStartIso = weekStartISO;
        button.dataset.status = status;
        button.dataset.planId = hasPlan ? planInfo.planId : '';
        button.textContent = String(dayDate.getDate());
        button.setAttribute('aria-label', `${dayDate.getMonth() + 1}月${dayDate.getDate()}日を含む週`);

        if (hasPlan) {
          const indicator = document.createElement('span');
          indicator.className = 'block mx-auto mt-1 h-1.5 w-1.5 rounded-full bg-blue-500';
          button.appendChild(indicator);
        }

        gridEl.appendChild(button);
      }
    };

    const navigateToWeek = (button) => {
      if (!button) return;
      if (selectedButton) {
        selectedButton.classList.remove('plan-calendar-cell--selected');
      }
      selectedButton = button;
      button.classList.add('plan-calendar-cell--selected');

      const weekStartISO = button.dataset.weekStartIso;
      const planId = button.dataset.planId;
      const params = new URLSearchParams();
      if (config.currentGroupId) params.set('group', config.currentGroupId);
      if (planId) {
        params.set('plan', planId);
        if (weekStartISO) params.set('weekStart', weekStartISO);
      } else if (weekStartISO) {
        params.set('weekStart', weekStartISO);
      }

      const url = `${config.weekMenuBaseUrl}?${params.toString()}`;
      window.location.href = url;
    };

    gridEl.addEventListener('click', (event) => {
      const button = event.target.closest('.plan-calendar-cell');
      if (!button) return;
      navigateToWeek(button);
    });

    prevBtn.addEventListener('click', () => {
      currentMonth.setMonth(currentMonth.getMonth() - 1);
      renderCalendar();
    });

    nextBtn.addEventListener('click', () => {
      currentMonth.setMonth(currentMonth.getMonth() + 1);
      renderCalendar();
    });

    const showStatusMessage = (message, className = 'text-gray-400') => {
      gridEl.innerHTML = '';
      const placeholder = document.createElement('div');
      placeholder.className = `text-center text-sm py-6 ${className}`;
      placeholder.style.gridColumn = 'span 7 / span 7';
      placeholder.textContent = message;
      gridEl.appendChild(placeholder);
    };

    const renderCalendar = async () => {
      monthLabelEl.textContent = formatMonthLabel(currentMonth);
      showStatusMessage('読み込み中...', 'text-gray-400');
      try {
        const calendarData = await fetchCalendarData(currentMonth);
        buildCalendar(calendarData);
      } catch (error) {
        console.error(error);
        showStatusMessage('カレンダーを表示できませんでした', 'text-red-500');
      }
      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    };

    renderCalendar();
  })();
</script>
