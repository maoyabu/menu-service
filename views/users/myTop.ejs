    overflow: hidden;
    background: linear-gradient(135deg, #f8fafc, #e2e8f0);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.15);
  }
  .ribbon-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
