<%
  const serialize = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const currentUserName = (typeof user !== 'undefined' && user)
    ? (user.displayname || user.username || user.email || 'ユーザー')
    : 'ユーザー';
  const hasNextWeekPlan = typeof nextWeekPlan !== 'undefined' && nextWeekPlan && nextWeekPlan._id;
  const nextPlanId = hasNextWeekPlan ? String(nextWeekPlan._id) : '';
  const planButtonLabel = hasNextWeekPlan ? '来週の 7 DAYS PLAN を編集' : '来週の 7 DAYS PLAN を作成';
  const buttonIcon = hasNextWeekPlan ? 'pencil' : 'plus';
  const queryParts = [];
  if (typeof currentGroupId !== 'undefined' && currentGroupId) {
    queryParts.push(`group=${currentGroupId}`);
  }
  if (hasNextWeekPlan) {
    queryParts.push(`plan=${nextPlanId}`);
  }
  const weekMenuLink = '/users/week-menu' + (queryParts.length ? `?${queryParts.join('&')}` : '');
%>

<style>
  .plan-calendar-header-btn {
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    padding: 0.35rem;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .plan-calendar-header-btn:hover {
    background-color: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
    box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
  }
  .plan-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.35rem;
  }
  .plan-calendar-cell {
    border-radius: 0.75rem;
    padding: 0.75rem 0;
    text-align: center;
    font-size: 0.875rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .plan-calendar-cell:hover {
    border-color: rgba(59, 130, 246, 0.35);
  }
  .plan-calendar-cell--outside {
    opacity: 0.45;
  }
  .plan-calendar-cell--planned {
    background-color: #2563eb; /* blue-600 */
    color: #ffffff;            /* white text */
    border-color: #1e3a8a;     /* blue-900 */
    font-weight: 700;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.35) inset;
  }
  .plan-calendar-cell--future {
    background-color: #f0f7ff; /* light blue */
    color: #1d4ed8;            /* blue-700 */
    border-color: #bfdbfe;     /* blue-200 */
  }
  .plan-calendar-cell--past {
    background-color: #e2e8f0; /* slate-200/300 */
    color: #475569;            /* slate-600 */
    border-color: #cbd5e1;     /* slate-300 */
  }
  .plan-calendar-cell--selected {
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.45);
  }
  .plan-calendar-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #475569;
  }
  .plan-calendar-legend::before {
    content: '';
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.4rem;
  }
  .plan-calendar-legend--planned::before {
    background-color: #2563eb;  /* blue-600 */
    border: 1px solid #1e3a8a;  /* blue-900 */
  }
  .plan-calendar-legend--future::before {
    background-color: #bfdbfe;  /* blue-200 */
    border: 1px solid #60a5fa;  /* blue-400 */
  }
  .plan-calendar-legend--past::before {
    background-color: #e2e8f0;  /* slate-200/300 */
    border: 1px solid #94a3b8;  /* slate-400 */
  }
  .weekly-day-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border-radius: 0.75rem;
    padding: 0.75rem 0.5rem;
    border: 1px solid #e2e8f0;
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .weekly-day-button .day-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }
  .weekly-day-button .day-date {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .weekly-day-button[data-has-plan="true"] {
    background-color: #e0f2fe;
    color: #1d4ed8;
    border-color: rgba(59,130,246,0.35);
  }
  .weekly-day-button[data-is-today="true"] {
    border-color: rgba(59,130,246,0.45);
  }
  .weekly-day-button:hover {
    border-color: rgba(59,130,246,0.6);
  }
  .weekly-day-button.is-selected {
    box-shadow: 0 0 0 2px rgba(59,130,246,0.45);
    background-color: #dbeafe;
  }
  /* --- hero carousel --- */
  #hero-carousel { position: relative; overflow: hidden; }
  #hero-carousel .hero-track { position: absolute; inset: 0; display: flex; width: 100%; height: 100%; transition: transform .8s ease; }
  #hero-carousel .hero-slide { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; }
  #hero-carousel .hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.0) 20%, rgba(0,0,0,.25) 100%); pointer-events: none; }
  #hero-carousel .hero-empty { display:flex; align-items:center; justify-content:center; height:100%; color: rgba(255,255,255,.8); }

  /* --- hero stage (dual image for random transitions) --- */
  #hero-carousel .hero-stage { position:absolute; inset:0; }
  #hero-carousel .hero-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transform:translateZ(0); }
  #hero-carousel .hero-img.is-visible { opacity:1; }
  /* transitions are set inline via JS (opacity/transform .8s ease) */
  /* --- drop shadow utility for watermark --- */
  .drop-shadow { filter: drop-shadow(0 1px 2px rgba(0,0,0,.45)); }

  /* --- watermark outline text --- */
  .wm-outline {
    color: #fff;
    -webkit-text-stroke: 1px rgba(0,0,0,.9);
    text-shadow:
      0 0 1px rgba(0,0,0,.9),
      1px 0 1px rgba(0,0,0,.9),
      -1px 0 1px rgba(0,0,0,.9),
      0 1px 1px rgba(0,0,0,.9),
      0 -1px 1px rgba(0,0,0,.9);
    paint-order: stroke fill;
  }
</style>

