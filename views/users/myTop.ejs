          <% todayPlan.meals.forEach((meal) => { %>
            <% meal.slots.forEach((slot) => { const menu = slot.menu || null; %>
              <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm flex flex-col">
                <div class="relative h-52 md:h-64 bg-gray-100">
                  <!-- 画像左上のランチ/ディナー タグ（重ね表示） -->
                  <span class="absolute top-2 left-2 inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-semibold <%= meal.mealKey === 'lunch' ? 'bg-orange-50 text-orange-600' : 'bg-blue-50 text-blue-600' %>">
                    <span class="lucide w-3 h-3 <%= meal.mealKey === 'lunch' ? 'text-orange-500' : 'text-blue-500' %>" data-lucide="<%= meal.mealKey === 'lunch' ? 'sun' : 'moon' %>"></span>
                    <%= meal.label %>
                  </span>

                  <% if (menu && menu.imageUrl) { %>
                    <% if (menu.url) { %>
                      <a href="<%= menu.url %>" target="menuWindow" rel="noopener">
                        <img src="<%= menu.imageUrl %>" alt="<%= menu.name %>" class="w-full h-full object-cover">
                      </a>
                    <% } else { %>
                      <img src="<%= menu.imageUrl %>" alt="<%= menu.name %>" class="w-full h-full object-cover">
                    <% } %>
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-xs text-gray-400 bg-gradient-to-br from-gray-100 to-gray-200">no image</div>
                  <% } %>
                </div>
                <div class="p-4 space-y-2 flex-1 flex flex-col">
                  <h3 class="text-lg font-semibold text-gray-900">
                  <% if (menu && menu.url) { %>
                    <a href="<%= menu.url %>" target="menuWindow" rel="noopener" class="hover:underline">
                        <%= menu.name %>
                      </a>
                    <% } else { %>
                      <%= menu ? menu.name : 'メニュー候補がありません' %>
                    <% } %>
                  </h3>
                  <% if (menu && (menu.time || menu.junle || menu.cook)) { %>
                    <div class="flex flex-wrap gap-2 text-[11px] text-gray-500">
                      <% if (menu.time) { %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-emerald-700">
                          <span>時間</span>
                          <span class="font-medium"><%= String(menu.time).endsWith('分') ? menu.time : menu.time + '分' %></span>
                        </span>
                      <% } %>
                      <% if (menu.junle) { %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-yellow-50 px-2 py-0.5 text-yellow-700">
                          <span>ジャンル</span>
                          <span class="font-medium"><%= menu.junle %></span>
                        </span>
                      <% } %>
                      <% if (menu.cook) { %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-yellow-50 px-2 py-0.5 text-yellow-700">
                          <span>調理方法</span>
                          <span class="font-medium"><%= menu.cook %></span>
                        </span>
                      <% } %>
                    </div>
                  <% } %>
                  <% if (menu && menu.comment) { %>
                    <p class="text-sm text-gray-500"><%= menu.comment %></p>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% }) %>
        <% } else { %>
