    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    padding: 0 10px;
  }
  .ribbon-nav button {
    pointer-events: auto;
    width: 42px;
    height: 42px;
    border-radius: 50%;
