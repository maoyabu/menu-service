<%
  const serialize = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const currentUserName = (typeof user !== 'undefined' && user)
    ? (user.displayname || user.username || user.email || 'ユーザー')
    : 'ユーザー';
  const hasNextWeekPlan = typeof nextWeekPlan !== 'undefined' && nextWeekPlan && nextWeekPlan._id;
  const nextPlanId = hasNextWeekPlan ? String(nextWeekPlan._id) : '';
  const planButtonLabel = hasNextWeekPlan ? '来週の 7 DAYS PLAN を編集' : '来週の 7 DAYS PLAN を作成';
  const buttonIcon = hasNextWeekPlan ? 'pencil' : 'plus';
  const queryParts = [];
  if (typeof currentGroupId !== 'undefined' && currentGroupId) {
    queryParts.push(`group=${currentGroupId}`);
  }
  if (hasNextWeekPlan) {
    queryParts.push(`plan=${nextPlanId}`);
  }
  const weekMenuLink = '/users/week-menu' + (queryParts.length ? `?${queryParts.join('&')}` : '');
%>

<style>
  .plan-calendar-header-btn {
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    padding: 0.35rem;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .plan-calendar-header-btn:hover {
    background-color: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
  }
  .plan-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.35rem;
  }
  .plan-calendar-cell {
    border-radius: 0.75rem;
    padding: 0.75rem 0;
    text-align: center;
    font-size: 0.875rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .plan-calendar-cell:hover {
    border-color: rgba(59, 130, 246, 0.35);
  }
  .plan-calendar-cell--outside {
    opacity: 0.45;
  }
  .plan-calendar-cell--planned {
    background-color: #dbeafe;
    color: #1d4ed8;
    border-color: rgba(59, 130, 246, 0.6);
    font-weight: 600;
  }
  .plan-calendar-cell--future {
    background-color: #f8fafc;
    color: #475569;
    border-color: rgba(148, 163, 184, 0.2);
  }
  .plan-calendar-cell--past {
    background-color: #e5e7eb;
    color: #6b7280;
    border-color: rgba(148, 163, 184, 0.35);
  }
  .plan-calendar-cell--selected {
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.45);
  }
  .plan-calendar-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #475569;
  }
  .plan-calendar-legend::before {
    content: '';
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.4rem;
  }
  .plan-calendar-legend--planned::before {
    background-color: #bfdbfe;
    border: 1px solid rgba(59,130,246,0.65);
  }
  .plan-calendar-legend--future::before {
    background-color: #f1f5f9;
    border: 1px solid rgba(148,163,184,0.35);
  }
  .plan-calendar-legend--past::before {
    background-color: #e5e7eb;
    border: 1px solid rgba(148,163,184,0.55);
  }
  .weekly-day-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border-radius: 0.75rem;
    padding: 0.75rem 0.5rem;
    border: 1px solid #e2e8f0;
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .weekly-day-button .day-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }
  .weekly-day-button .day-date {
    font-size: 0.95rem;
    font-weight: 700;
  }
  .weekly-day-button[data-has-plan="true"] {
    background-color: #e0f2fe;
    color: #1d4ed8;
    border-color: rgba(59,130,246,0.35);
  }
  .weekly-day-button[data-is-today="true"] {
    border-color: rgba(59,130,246,0.45);
  }
  .weekly-day-button:hover {
    border-color: rgba(59,130,246,0.6);
  }
  .weekly-day-button.is-selected {
    box-shadow: 0 0 0 2px rgba(59,130,246,0.45);
    background-color: #dbeafe;
  }
</style>

<section class="relative max-w-6xl mx-auto py-10 space-y-10">
  <header class="bg-gradient-to-r from-blue-500 via-blue-400 to-indigo-500 text-white rounded-3xl shadow-lg overflow-hidden">
    <div class="p-8 md:p-12 flex flex-col md:flex-row md:items-center md:justify-between gap-12">
      <div class="flex flex-col gap-6 max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] bg-white/20 px-4 py-1 rounded-full w-max">
          <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
          my top
        </div>
        <div class="space-y-3">
          <h1 class="text-3xl md:text-4xl font-bold leading-tight">
            こんにちは、<span class="text-emerald-200"><%= currentUserName %></span> さん
          </h1>
          <p class="text-sm md:text-base text-white/80 leading-relaxed">
            「今日何食べる」のストレスからの解放！来週1週間のMENUをおすすめします。使えば使うほど自分にぴったりなMENUがおすすめされるようになります。
          </p>
        </div>
        <div class="flex flex-col gap-2">
          <div class="flex flex-wrap gap-3">
            <% const isEditMode = hasNextWeekPlan; %>
            <a
              href="<%= weekMenuLink %>"
              class="inline-flex items-center gap-2 rounded-full text-sm font-semibold px-5 py-2 transition <%= isEditMode ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-white text-blue-600 hover:bg-blue-50' %>"
            >
              <span class="lucide <%= isEditMode ? 'text-white' : 'text-blue-500' %>" data-lucide="<%= buttonIcon %>"></span>
              <%= planButtonLabel %>
            </a>
          </div>
          <% if (hasNextWeekPlan && typeof nextWeekRangeLabel !== 'undefined') { %>
            <p class="text-xs text-white/80">保存済み: <%= nextWeekRangeLabel %></p>
          <% } %>
        </div>
      </div>

      <div class="relative">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-3xl bg-white/10 border border-white/30 backdrop-blur-sm flex items-center justify-center">
          <div class="text-center">
            <span class="text-6xl md:text-7xl font-black text-white/90">7</span>
            <p class="uppercase text-xs tracking-[0.35em] text-white/60 mt-2">days plan</p>
          </div>
        </div>
        <div class="absolute -bottom-6 -left-6 bg-emerald-400 text-blue-950 px-4 py-2 rounded-2xl shadow-md text-xs font-semibold tracking-wider">
          next action: 家族会議
        </div>
      </div>
    </div>
  </header>

  <section class="grid lg:grid-cols-[2fr,1fr] gap-6">
  <div class="flex flex-col gap-6">
    <article class="bg-white rounded-2xl shadow border border-gray-100 p-6 flex flex-col gap-5">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold">今日の献立</h2>
          <p class="text-xs text-gray-500 mt-1"><%= todayPlan ? todayPlan.dateLabel : '' %> (<%= todayPlan ? todayPlan.weekdayLabel : '' %>)</p>
        </div>
        <% if (todayPlan && todayPlan.hasPlan) { %>
          <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full">
            <span class="lucide w-3 h-3" data-lucide="sprout"></span>
            ready
          </span>
        <% } else { %>
          <span class="inline-flex items-center gap-1 text-xs font-medium text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
            <span class="lucide w-3 h-3" data-lucide="clock"></span>
            未設定
          </span>
        <% } %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <% if (todayPlan && todayPlan.hasPlan) { %>
          <% todayPlan.meals.forEach((meal) => { %>
            <% meal.slots.forEach((slot) => { const menu = slot.menu || null; %>
              <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm flex flex-col">
                <div class="h-52 md:h-64 bg-gray-100">
                  <% if (menu && menu.imageUrl) { %>
                    <img src="<%= menu.imageUrl %>" alt="<%= menu.name %>" class="w-full h-full object-cover">
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-xs text-gray-400 bg-gradient-to-br from-gray-100 to-gray-200">no image</div>
                  <% } %>
                </div>
                <div class="p-4 space-y-2 flex-1 flex flex-col">
                  <div class="flex items-center justify-between gap-3">
                    <% const isLunch = meal.mealKey === 'lunch'; %>
                    <span class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold <%= isLunch ? 'bg-orange-50 text-orange-600' : 'bg-blue-50 text-blue-600' %>">
                      <span class="lucide w-3 h-3 <%= isLunch ? 'text-orange-500' : 'text-blue-500' %>" data-lucide="<%= meal.mealKey === 'lunch' ? 'sun' : 'moon' %>"></span>
                      <%= meal.label %>
                    </span>
                    <% if (menu && menu.time) { %>
                      <span class="text-xs text-gray-400"><%= String(menu.time).endsWith('分') ? menu.time : menu.time + '分' %></span>
                    <% } %>
                  </div>
                  <h3 class="text-lg font-semibold text-gray-900"><%= menu ? menu.name : 'メニュー候補がありません' %></h3>
                  <% if (menu && menu.comment) { %>
                    <p class="text-sm text-gray-500"><%= menu.comment %></p>
                  <% } %>
                  <% if (menu && (menu.junle || menu.cook)) { %>
                    <div class="flex flex-wrap gap-2 text-[11px] text-gray-500">
                      <% if (menu.junle) { %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-yellow-50 px-2 py-0.5 text-yellow-700">
                          <span>ジャンル</span>
                          <span class="font-medium"><%= menu.junle %></span>
                        </span>
                      <% } %>
                      <% if (menu.cook) { %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-yellow-50 px-2 py-0.5 text-yellow-700">
                          <span>調理方法</span>
                          <span class="font-medium"><%= menu.cook %></span>
                        </span>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% }) %>
        <% } else { %>
          <div class="col-span-full rounded-2xl bg-gray-50 px-4 py-6 text-center text-sm text-gray-500 border border-dashed border-gray-200">
            今日の献立はまだ登録されていません。<br>
            <span class="text-xs text-gray-400">週次プランを開いて、献立を登録しましょう。</span>
          </div>
        <% } %>
      </div>
      <a href="<%= currentWeekLink %>" class="mt-auto inline-flex items-center justify-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700">
        今週のプランを編集する
        <span class="lucide w-4 h-4" data-lucide="arrow-up-right"></span>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow border border-gray-100 p-6 flex flex-col gap-6">
      <header class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold">今週の献立プラン</h2>
          <p class="text-xs text-gray-500 mt-1 uppercase tracking-wide">7 days preview</p>
        </div>
        <button class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700">
          全て表示
          <span class="lucide w-4 h-4" data-lucide="calendar-range"></span>
        </button>
      </header>

      <div class="space-y-4">
        <div id="weekly-plan-day-buttons" class="grid md:grid-cols-7 gap-2">
          <% weekPlanOverview.forEach((day) => { %>
            <button
              type="button"
              class="weekly-day-button"
              data-week-day-button
              data-day-index="<%= day.index %>"
              data-has-plan="<%= day.hasPlan %>"
              data-is-today="<%= day.isToday %>"
            >
              <span class="day-label"><%= day.weekday %></span>
              <span class="day-date"><%= day.display %></span>
            </button>
          <% }) %>
        </div>
        <div class="grid md:grid-cols-2 gap-4" id="weekly-plan-detail">
          <article id="weekly-plan-recipes" class="rounded-xl border border-blue-100 bg-white p-4 space-y-3" style="min-height: 160px;">
            <div class="flex items-center justify-between">
              <h4 id="weekly-plan-recipes-title" class="text-sm font-semibold text-gray-800">レシピ</h4>
            </div>
            <div id="weekly-plan-recipes-body" class="text-sm text-gray-600">
              表示する日を選択してください。
            </div>
          </article>
          <article id="weekly-plan-ingredients" class="rounded-xl border border-amber-100 bg-white p-4 space-y-3" style="min-height: 160px;">
            <div class="flex items-center justify-between">
              <h4 id="weekly-plan-ingredients-title" class="text-sm font-semibold text-gray-800">食材 / 調味料</h4>
            </div>
            <div id="weekly-plan-ingredients-body" class="text-sm text-gray-600">
              表示する日を選択してください。
            </div>
          </article>
        </div>
      </div>

    </article>
  </div>

  <div class="flex flex-col gap-6">
    <article class="bg-white rounded-2xl shadow border border-gray-100 p-6 flex flex-col gap-5">
      <header class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold">7 DAYS PLAN</h2>
          <p class="text-xs text-gray-500 mt-1">週ごとの設定状況を確認し、編集・登録できます</p>
        </div>
        <div class="inline-flex items-center gap-2">
          <button type="button" class="plan-calendar-header-btn" id="plan-calendar-prev" aria-label="前の月">
            <span class="lucide w-4 h-4" data-lucide="chevron-left"></span>
          </button>
          <span class="text-sm font-semibold text-gray-800" id="plan-calendar-month-label">----</span>
          <button type="button" class="plan-calendar-header-btn" id="plan-calendar-next" aria-label="次の月">
            <span class="lucide w-4 h-4" data-lucide="chevron-right"></span>
          </button>
        </div>
      </header>

      <div class="grid grid-cols-7 gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
        <span class="text-center">月</span>
        <span class="text-center">火</span>
        <span class="text-center">水</span>
        <span class="text-center">木</span>
        <span class="text-center">金</span>
        <span class="text-center">土</span>
        <span class="text-center">日</span>
      </div>

      <div id="plan-calendar-grid" class="plan-calendar-grid text-sm text-gray-600">
        <div class="text-center text-sm text-gray-400 py-6" style="grid-column: span 7 / span 7;">読み込み中...</div>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <span class="plan-calendar-legend plan-calendar-legend--planned">プラン登録済み</span>
        <span class="plan-calendar-legend plan-calendar-legend--future">これから設定</span>
        <span class="plan-calendar-legend plan-calendar-legend--past">過去を記録</span>
      </div>
    </article>
    <article class="bg-white rounded-2xl shadow border border-gray-100 p-6 flex flex-col gap-5">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">お気に入りMENU</h2>
        <span class="inline-flex items-center gap-1 text-xs font-medium text-pink-600 bg-pink-50 px-3 py-1 rounded-full">
          <span class="lucide w-3 h-3" data-lucide="heart"></span>
          family pick
        </span>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <% const favoriteMenus = [
             { name: 'ママ特製ラザニア', description: '週末リクエストNo.1。チーズたっぷりで子ども達も大喜び。', tags: ['休日', 'ご馳走'], imageUrl: 'https://images.unsplash.com/photo-1604908176912-9e6209a18753?auto=format&fit=crop&w=900&q=60' },
             { name: '旬野菜のグリル', description: 'おばあちゃんが持ってきてくれた野菜で作るヘルシーメニュー。', tags: ['季節限定', '野菜たっぷり'], imageUrl: 'https://images.unsplash.com/photo-1482049016688-2d3e1b311543?auto=format&fit=crop&w=900&q=60' },
             { name: 'ハーブチキンプレート', description: 'パパの得意料理。焼くだけで香りが広がる定番の一皿。', tags: ['定番', '短時間'], imageUrl: 'https://images.unsplash.com/photo-1612874470907-52db3da03447?auto=format&fit=crop&w=900&q=60' },
             { name: 'さっぱりレモンパスタ', description: '平日ランチの救世主。爽やかな味で午後も軽やかに。', tags: ['10分', 'ランチ'], imageUrl: 'https://images.unsplash.com/photo-1525755662778-989d0524087e?auto=format&fit=crop&w=900&q=60' }
           ]; %>
        <% favoriteMenus.forEach((fav) => { %>
          <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm flex flex-col">
            <div class="h-36 bg-gray-100">
              <% if (fav.imageUrl) { %>
                <img src="<%= fav.imageUrl %>" alt="<%= fav.name %>" class="w-full h-full object-cover">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-xs text-gray-400 bg-gradient-to-br from-gray-100 to-gray-200">no image</div>
              <% } %>
            </div>
            <div class="p-4 space-y-2 flex-1 flex flex-col">
              <h3 class="text-sm font-semibold text-gray-900"><%= fav.name %></h3>
              <p class="text-xs text-gray-500 leading-relaxed"><%= fav.description %></p>
              <div class="flex flex-wrap gap-2 text-[11px] text-pink-600">
                <% (fav.tags || []).forEach((tag) => { %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-pink-50 px-2 py-0.5">
                    <span class="lucide w-3 h-3" data-lucide="sparkle"></span>
                    <span><%= tag %></span>
                  </span>
                <% }) %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <button class="mt-auto inline-flex items-center justify-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700">
        お気に入りを編集
        <span class="lucide w-4 h-4" data-lucide="pencil"></span>
      </button>
    </article>

    <article class="bg-white rounded-2xl shadow border border-gray-100 p-6 flex flex-col gap-5">
      <header class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold">家族のトピックス</h2>
          <p class="text-xs text-gray-500 mt-1">シェアされたメモ・予定をチェック</p>
        </div>
        <button class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 hover:text-blue-700">
          すべて
        </button>
      </header>

      <div class="space-y-4 text-sm text-gray-700">
        <div class="p-4 rounded-xl bg-blue-50 border border-blue-100 flex gap-3">
          <span class="lucide w-5 h-5 text-blue-500" data-lucide="bell-ring"></span>
          <div>
            <p class="font-semibold">日曜 11:00 - 家族ランチ</p>
            <p class="text-xs text-blue-600 mt-1">リマインダーをセットしました</p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-100 flex gap-3">
          <span class="lucide w-5 h-5 text-emerald-500" data-lucide="leaf"></span>
          <div>
            <p class="font-semibold">ベジタブルチャレンジ Week 3</p>
            <p class="text-xs text-emerald-600 mt-1">家族の達成率 85%</p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-amber-50 border border-amber-100 flex gap-3">
          <span class="lucide w-5 h-5 text-amber-500" data-lucide="star"></span>
          <div>
            <p class="font-semibold">みんなのお気に入りレシピ</p>
            <p class="text-xs text-amber-600 mt-1">「焼き野菜のバルサミコグレーズ」</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>


  <footer class="rounded-2xl border border-dashed border-gray-200 p-6 bg-gray-50 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">次のステップを計画しましょう</h2>
      <p class="text-sm text-gray-600 mt-2">
        家族みんなで共有する年間プランを作成。献立、家計、暮らしのメモをまとめて管理できます。
