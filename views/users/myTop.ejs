<script>
  // Use server-provided headerImageItems (url+name), excluding today's & this week's images if available
  (function(){
    var serverItems = <%- serialize(headerImageItems || []) %>;

    // Exclusion list: today plan
    var exclude = [];
    <% if (todayPlan && todayPlan.hasPlan) { %>
      <% todayPlan.meals.forEach(function(meal){ meal.slots.forEach(function(slot){ %>
        <% if (slot.menu && slot.menu.imageUrl) { %>
          exclude.push("<%- (slot.menu.imageUrl || '').replace(/"/g, '\\"') %>");
        <% } %>
      <% }) }) %>
    <% } %>

    // Exclusion list: weekly plan (populated by render)
    if (Array.isArray(window.weekPlanImageExclusions)) {
      exclude = exclude.concat(window.weekPlanImageExclusions);
    }

    var excludeSet = new Set(exclude.filter(Boolean));
    var candidates = Array.isArray(serverItems)
      ? serverItems.filter(function(item){ return item && item.imageUrl && !excludeSet.has(item.imageUrl); })
      : [];

    // Fallback to serverItems if everything got excluded
    window.headerItems = candidates.length ? candidates : (serverItems || []);
  })();
</script>

<script>
  (function(){
    const btn = document.getElementById('alert-button');
    const modal = document.getElementById('alert-modal');
    const closeBtn = document.getElementById('alert-close');
    const open = ()=> { modal?.classList.remove('hidden'); modal?.classList.add('flex'); if (window.refreshLucideIcons) window.refreshLucideIcons(); };
    const close = ()=> { modal?.classList.add('hidden'); modal?.classList.remove('flex'); };
    btn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    modal?.addEventListener('click', (ev)=> { if (ev.target === modal) close(); });
  })();
</script>


