<%
  const serialize = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const currentUserName = (typeof user !== 'undefined' && user)
    ? (user.displayname || user.username || user.email || 'ユーザー')
    : 'ユーザー';
  // 再来週の 7 DAYS PLAN へ誘導
  const hasAfterNextWeekPlan = typeof afterNextWeekPlan !== 'undefined' && afterNextWeekPlan && afterNextWeekPlan._id;
  const afterNextPlanId = hasAfterNextWeekPlan ? String(afterNextWeekPlan._id) : '';
  const planButtonLabel = hasAfterNextWeekPlan ? '再来週の 7 DAYS PLAN を編集' : '再来週の 7 DAYS PLAN を作成';
  const buttonIcon = hasAfterNextWeekPlan ? 'pencil' : 'plus';
  const currentGroupName = (() => {
    const groups = Array.isArray(userGroups) ? userGroups : [];
    const currentGroupId = (typeof selectedGroupId !== 'undefined' && selectedGroupId) ? String(selectedGroupId) : '';
    const defaultGroupId = (typeof userDefaultGroupId !== 'undefined' && userDefaultGroupId) ? String(userDefaultGroupId) : '';
    const gid = currentGroupId || defaultGroupId;
    const g = groups.find((gr) => String(gr._id || '') === gid);
    return g ? g.group_name : '';
  })();
  const queryParts = [];
  if (typeof currentGroupId !== 'undefined' && currentGroupId) {
    queryParts.push(`group=${currentGroupId}`);
  }
  if (typeof afterNextWeekStartISO !== 'undefined' && afterNextWeekStartISO) {
    queryParts.push(`weekStart=${encodeURIComponent(afterNextWeekStartISO)}`);
  }
  if (hasAfterNextWeekPlan) {
    queryParts.push(`plan=${afterNextPlanId}`);
  }
  const weekMenuLink = '/users/week-menu2' + (queryParts.length ? `?${queryParts.join('&')}` : '');
%>

<style>
  .plan-calendar-header-btn {
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    padding: 0.35rem;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .plan-calendar-header-btn:hover {
    background-color: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
    box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
  }
  .plan-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.35rem;
  }
  .plan-calendar-cell {
    border-radius: 0.75rem;
    padding: 0.75rem 0;
    text-align: center;
    font-size: 0.875rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .plan-calendar-cell:hover {
    border-color: rgba(59, 130, 246, 0.35);
  }
  .plan-calendar-cell--outside {
    opacity: 0.45;
  }
  .plan-calendar-cell--planned {
    background-color: #2563eb; /* blue-600 */
    color: #ffffff;            /* white text */
    border-color: #1e3a8a;     /* blue-900 */
    font-weight: 700;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.35) inset;
  }
  .plan-calendar-cell--future {
    background-color: #f0f7ff; /* light blue */
    color: #1d4ed8;            /* blue-700 */
    border-color: #bfdbfe;     /* blue-200 */
  }
  .plan-calendar-cell--past {
    background-color: #e2e8f0; /* slate-200/300 */
    color: #475569;            /* slate-600 */
    border-color: #cbd5e1;     /* slate-300 */
  }
  .plan-calendar-cell--selected {
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.45);
  }
  .plan-calendar-legend {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #475569;
  }
  .plan-calendar-legend::before {
    content: '';
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.4rem;
  }
  .plan-calendar-legend--planned::before {
    background-color: #2563eb;  /* blue-600 */
    border: 1px solid #1e3a8a;  /* blue-900 */
  }
  .plan-calendar-legend--future::before {
    background-color: #bfdbfe;  /* blue-200 */
    border: 1px solid #60a5fa;  /* blue-400 */
  }
  .plan-calendar-legend--past::before {
    background-color: #e2e8f0;  /* slate-200/300 */
    border: 1px solid #94a3b8;  /* slate-400 */
  }
  .weekly-day-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border-radius: 14px;
    padding: 0.5rem 0.5rem;
    border: 2px solid #bfdbfe; /* blue-200 */
    background-color: #e8f2ff; /* light blue */
    color: #1d4ed8; /* blue-700 */
    font-weight: 600;
    font-size: 0.8rem;
    transition: all 0.2s ease;
    min-width: 0;
  }
  .weekly-day-button .day-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1d4ed8;
  }
