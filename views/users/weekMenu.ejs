                        <% } %>
                      </div>
                      <div class="space-y-2">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400"><%= label %></p>
                        <p class="text-sm font-semibold text-gray-900" data-element="dish-name"><%= row.name %></p>
                        <div class="flex flex-wrap gap-2 text-[11px] font-semibold text-amber-700" data-element="dish-chips">
                          <% 
                            const formattedTimeDinner = row.time ? (String(row.time).endsWith('分') ? String(row.time) : String(row.time) + '分') : '';
                            const chips = [
