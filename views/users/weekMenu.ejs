      </div>
    </div>

    <div class="px-6 pb-6 space-y-10">
      <section class="space-y-4" data-panel="lunch">
        <div class="divide-y divide-blue-100 rounded-2xl border border-blue-100 bg-blue-50 shadow-sm">
          <% plan.forEach((day) => { const slot = day?.lunch?.main || null; const row = displayRow(menuLookup, slot); const dateInfo = Array.isArray(weekDates) ? weekDates[day.index] : null; const dateLabel = dateInfo ? dateInfo.display : ''; %>
            <div
              class="flex flex-col gap-3 px-4 py-4 md:flex-row md:items-center md:justify-between<%= row.hasMenu ? '' : ' slot-empty' %>"
              data-day="<%= day.index %>"
              data-meal="lunch"
              data-slot="main"
              data-category="lunchMain"
            >
              <div class="flex items-start md:items-center gap-4">
                <div class="w-16 shrink-0 text-center">
                  <% if (dateLabel) { %>
                    <p class="text-sm font-semibold text-blue-700"><%= dateLabel %></p>
                  <% } %>
                  <p class="text-xs font-semibold text-gray-700"><%= day.dayLabel %></p>
                </div>
                <div class="w-20 h-20 rounded-lg overflow-hidden border border-blue-100 bg-blue-100/60 flex items-center justify-center text-[10px] text-blue-300" data-element="dish-image">
                  <% if (row.imageUrl) { %>
                    <img src="<%= row.imageUrl %>" alt="<%= row.name %>" class="object-cover w-full h-full">
                  <% } else { %>
                    <span>no image</span>
                  <% } %>
                </div>
                <div class="space-y-2 flex-1">
                  <p class="text-base font-semibold text-gray-900" data-element="dish-name"><%= row.name %></p>
                  <div class="flex flex-wrap gap-2 text-[11px] font-semibold text-amber-700" data-element="dish-chips">
                    <% 
                      const formattedTime = row.time ? (String(row.time).endsWith('分') ? String(row.time) : String(row.time) + '分') : '';
                      const chips = [
                        row.junle ? { label: 'ジャンル', value: row.junle } : null,
                        row.cook ? { label: '調理方法', value: row.cook } : null,
                        formattedTime ? { label: '調理時間', value: formattedTime } : null
                      ].filter(Boolean); 
                    %>
                    <% if (chips.length) { %>
                      <% chips.forEach((chip) => { %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1">
                          <span><%= chip.label %></span>
                          <span class="font-medium text-amber-800"><%= chip.value %></span>
                        </span>
                      <% }) %>
                    <% } %>
                  </div>
                  <% const shouldShowLunchDetail = row.detail && row.detail !== row.cook && row.detail !== row.junle; %>
                  <p class="text-xs text-gray-500 <%= shouldShowLunchDetail ? '' : 'hidden' %>" data-element="dish-detail"><%= shouldShowLunchDetail ? row.detail : '' %></p>
                  <div class="menu-picker hidden mt-3" data-picker></div>
                </div>
              </div>
              <div class="flex items-center gap-2 self-end md:self-center">
                <button type="button" class="icon-button favorite-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="toggle-favorite" aria-pressed="false" title="お気に入りに追加" <% if (!row.hasMenu) { %>disabled<% } %>>
                  <span class="sr-only">お気に入りに追加</span>
                  <span class="lucide w-4 h-4" data-lucide="heart"></span>
                </button>
                <button type="button" class="icon-button dine-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="toggle-dine" aria-pressed="false" title="家と外食を切り替え" <% if (!row.hasMenu) { %>disabled<% } %>>
                  <span class="sr-only">家と外食を切り替え</span>
                  <span data-role="dine-home" class="lucide w-4 h-4" data-lucide="home"></span>
                  <span data-role="dine-out" class="lucide w-4 h-4 hidden" data-lucide="utensils"></span>
                </button>
                <button type="button" class="icon-button shuffle-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="shuffle" title="再提案" <% if (!row.hasMenu) { %>disabled<% } %>>
                  <span class="sr-only">再提案</span>
                  <span class="lucide w-4 h-4" data-lucide="refresh-ccw"></span>
                </button>
                <button type="button" class="icon-button clear-slot inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-red-300 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="clear-slot" title="メニューを未選択にする" <% if (!row.hasMenu) { %>disabled<% } %>>
                  <span class="sr-only">メニューを未選択にする</span>
                  <span class="lucide w-4 h-4" data-lucide="x-circle"></span>
                </button>
                <button type="button" class="change-button icon-button inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="change" title="探す" <% if (!row.hasMenu) { %>disabled<% } %>>
                  <span class="sr-only">探す</span>
                  <span class="lucide w-4 h-4" data-lucide="search"></span>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="space-y-4 hidden" data-panel="dinner" hidden>
        <div class="divide-y divide-blue-100 rounded-2xl border border-blue-100 bg-blue-50 shadow-sm">
          <% plan.forEach((day) => { const dateInfo = Array.isArray(weekDates) ? weekDates[day.index] : null; const dateLabel = dateInfo ? dateInfo.display : ''; %>
            <div class="px-4 py-4" data-day="<%= day.index %>" data-meal="dinner">
              <div class="flex items-start gap-4">
                <div class="w-16 shrink-0 text-left">
                  <p class="text-sm font-semibold text-gray-900"><%= day.dayLabel %></p>
                  <% if (dateLabel) { %>
                    <p class="text-xs text-gray-500"><%= dateLabel %></p>
                  <% } %>
                </div>
                <div class="flex-1 grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-meal-group>
                  <% ['staple', 'main', 'side', 'soup'].forEach((slotKey) => {
                       const slot = day?.dinner?.[slotKey] || null;
                       const categoryKey = slotKey === 'staple' ? 'dinnerStaple' : (slotKey === 'main' ? 'dinnerMain' : (slotKey === 'side' ? 'dinnerSide' : 'dinnerSoup'));
                       const label = categoryConfig[categoryKey]?.label || '';
                       const row = displayRow(menuLookup, slot); %>
                    <div
                      class="rounded-xl border border-blue-100 bg-blue-50/80 overflow-hidden<%= row.hasMenu ? '' : ' slot-empty' %>"
                      data-slot="<%= slotKey %>"
                      data-category="<%= categoryKey %>"
                    >
                      <div class="w-full h-28 bg-blue-100/60 flex items-center justify-center text-[10px] text-blue-300" data-element="dish-image">
                        <% if (row.imageUrl) { %>
                          <img src="<%= row.imageUrl %>" alt="<%= row.name %>" class="object-cover w-full h-full">
                        <% } else { %>
                          <span>no image</span>
                        <% } %>
                      </div>
                      <div class="space-y-2 p-4">
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400"><%= label %></p>
                        <p class="text-sm font-semibold text-gray-900" data-element="dish-name"><%= row.name %></p>
                        <div class="flex flex-wrap gap-2 text-[11px] font-semibold text-amber-700" data-element="dish-chips">
                          <% 
                            const formattedTimeDinner = row.time ? (String(row.time).endsWith('分') ? String(row.time) : String(row.time) + '分') : '';
                            const chips = [
                              row.junle ? { label: 'ジャンル', value: row.junle } : null,
                              formattedTimeDinner ? { label: '調理時間', value: formattedTimeDinner } : null
                            ].filter(Boolean); 
                          %>
                          <% if (chips.length) { %>
                            <% chips.forEach((chip) => { %>
                              <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1">
                                <span><%= chip.label %></span>
                                <span class="font-medium text-amber-800"><%= chip.value %></span>
                              </span>
                            <% }) %>
                          <% } %>
                        </div>
                        <% const shouldShowDinnerDetail = row.detail && row.detail !== row.cook && row.detail !== row.junle; %>
                        <p class="text-xs text-gray-500 <%= shouldShowDinnerDetail ? '' : 'hidden' %>" data-element="dish-detail"><%= shouldShowDinnerDetail ? row.detail : '' %></p>
                      </div>
                      <div class="flex items-center gap-2 justify-end flex-wrap">
                        <button type="button" class="icon-button favorite-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="toggle-favorite" aria-pressed="false" title="お気に入りに追加" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">お気に入りに追加</span>
                          <span class="lucide w-4 h-4" data-lucide="heart"></span>
                        </button>
                        <button type="button" class="icon-button dine-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="toggle-dine" aria-pressed="false" title="家と外食を切り替え" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">家と外食を切り替え</span>
                          <span data-role="dine-home" class="lucide w-4 h-4" data-lucide="home"></span>
                          <span data-role="dine-out" class="lucide w-4 h-4 hidden" data-lucide="utensils"></span>
                        </button>
                        <button type="button" class="icon-button shuffle-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="shuffle" title="再提案" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">再提案</span>
                          <span class="lucide w-4 h-4" data-lucide="refresh-ccw"></span>
                        </button>
                        <button type="button" class="icon-button clear-slot inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-red-300 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="clear-slot" title="メニューを未選択にする" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">メニューを未選択にする</span>
                          <span class="lucide w-4 h-4" data-lucide="x-circle"></span>
                        </button>
                        <button type="button" class="change-button icon-button inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="change" title="探す" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">探す</span>
                          <span class="lucide w-4 h-4" data-lucide="search"></span>
                        </button>
                      </div>
                      <div class="menu-picker hidden" data-picker></div>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
  </div>

  <div class="mt-10 flex justify-center">
    <button type="button" data-action="save-week-plan" class="inline-flex w-full md:w-2/5 items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-200">
      保存
    </button>
  </div>
</section>

<script>
  window.weekMenuData = {
    plan: JSON.parse('<%- serialize(plan) %>'),
    menusByCategory: JSON.parse('<%- serialize(menusByCategory) %>'),
    menuLookup: JSON.parse('<%- serialize(menuLookup) %>'),
    categoryConfig: JSON.parse('<%- serialize(categoryConfig) %>'),
    weekDates: JSON.parse('<%- serialize(weekDates) %>'),
    weekRangeLabel: <%- serialize(weekRangeLabel) %>,
    currentGroupId: <%- serialize(currentGroupId || '') %>,
    planId: <%- serialize(existingPlanId || '') %>,
    weekStartISO: <%- serialize(weekStartISO || '') %>,
    isHistoricalWeek: <%- serialize(isHistoricalWeek || false) %>,
    todayISO: <%- serialize(todayISO || '') %>
  };
</script>

<script>
  (function () {
    const data = window.weekMenuData;
    if (!data) return;

    const clonePlan = (value) => {
      if (typeof structuredClone === 'function') {
        try {
          return structuredClone(value);
        } catch (err) {
          // fallback below
        }
      }
      return JSON.parse(JSON.stringify(value));
    };

    const state = {
      planId: data.planId || '',
      tab: 'lunch',
      plan: clonePlan(data.plan)
    };

    const menuLookup = data.menuLookup;
    const menusByCategory = data.menusByCategory;
    const weekDates = Array.isArray(data.weekDates) ? data.weekDates : [];
    const currentGroupId = data.currentGroupId || '';
    const weekRangeLabel = data.weekRangeLabel || '';
    const tabButtons = Array.from(document.querySelectorAll('.tab-button'));
    const panels = Array.from(document.querySelectorAll('[data-panel]'));
    const saveButton = document.querySelector('[data-action="save-week-plan"]');

    const getSlotReference = (dayIndex, mealKey, slotKey) => {
      const day = state.plan[dayIndex];
      if (!day) return null;
      if (mealKey === 'lunch') return day?.lunch?.[slotKey] || null;
      if (mealKey === 'dinner') return day?.dinner?.[slotKey] || null;
      return null;
    };

    const updateImage = (container, url, name) => {
      if (!container) return;
      container.innerHTML = '';
      if (url) {
        const img = document.createElement('img');
        img.src = url;
        img.alt = name || 'メニュー画像';
        img.className = 'object-cover w-full h-full';
        container.appendChild(img);
      } else {
        const span = document.createElement('span');
        span.className = 'text-[10px] text-gray-400';
        span.textContent = 'no image';
        container.appendChild(span);
      }
    };

    const toggleFavorite = (slot) => {
      if (!slot) return;
      slot.favorite = !slot.favorite;
    };

    const toggleDineOut = (slot) => {
      if (!slot) return;
      slot.dineOut = !slot.dineOut;
    };

    const pickRandomMenu = (categoryKey, excludeMenuId) => {
      const options = menusByCategory[categoryKey] || [];
      if (!options.length) return null;
      if (options.length === 1) return options[0];

      let candidate = null;
      let guard = 0;
      do {
        const index = Math.floor(Math.random() * options.length);
        candidate = options[index];
        guard += 1;
      } while (candidate?.id === excludeMenuId && guard < 10);
      return candidate;
    };

    const modalElements = {
      overlay: document.querySelector('[data-menu-modal]'),
      dialog: document.querySelector('[data-menu-modal-dialog]'),
      closeButtons: Array.from(document.querySelectorAll('[data-menu-modal-close]')),
      searchInput: document.querySelector('[data-menu-modal-search]'),
      kindSelect: document.querySelector('[data-menu-modal-kind]'),
      junleSelect: document.querySelector('[data-menu-modal-junle]'),
      cookSelect: document.querySelector('[data-menu-modal-cook]'),
      list: document.querySelector('[data-menu-modal-list]'),
      empty: document.querySelector('[data-menu-modal-empty]'),
      currentSection: document.querySelector('[data-menu-modal-current]'),
      currentName: document.querySelector('[data-menu-modal-current-name]'),
      currentDetail: document.querySelector('[data-menu-modal-current-detail]')
    };

    const modalState = {
      isOpen: false,
      slot: null,
      categoryKey: '',
      options: [],
      currentMenu: null,
      filters: {
        search: '',
        kind: '',
        junle: '',
        cook: ''
      }
    };

    const populateSelectOptions = (select, values, initialValue = '') => {
      if (!select) return;
      const unique = new Set(values.filter(Boolean));
      if (initialValue) unique.add(initialValue);
      const sorted = Array.from(unique).sort((a, b) => a.localeCompare(b, 'ja'));
      select.innerHTML = '';
      const emptyOption = document.createElement('option');
      emptyOption.value = '';
      emptyOption.textContent = 'すべて';
      select.appendChild(emptyOption);
      sorted.forEach((value) => {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });
      if (initialValue && select.querySelector(`option[value="${initialValue}"]`)) {
        select.value = initialValue;
      } else {
        select.value = '';
      }
    };

    const applyModalFilters = () => {
      const { search, kind, junle, cook } = modalState.filters;
      const query = search.trim().toLowerCase();
      const activeFilters = {
        kind: kind || '',
        junle: junle || '',
        cook: cook || ''
      };

      return modalState.options.filter((menu) => {
        if (!menu) return false;
        if (activeFilters.kind && menu.kind !== activeFilters.kind) return false;
        if (activeFilters.junle && menu.junle !== activeFilters.junle) return false;
        if (activeFilters.cook && menu.cook !== activeFilters.cook) return false;
        if (!query) return true;
        const candidates = [
          menu.name,
          menu.junle,
          menu.cook,
          menu.kind,
          menu.menu
        ].filter(Boolean).map((text) => text.toLowerCase());
        return candidates.some((text) => text.includes(query));
      });
    };

    const renderModalCurrentMenu = () => {
      const { currentMenu } = modalState;
      if (!modalElements.currentSection || !modalElements.currentName || !modalElements.currentDetail) return;
      if (!currentMenu) {
        modalElements.currentSection.classList.add('hidden');
        modalElements.currentName.textContent = '';
        modalElements.currentDetail.textContent = '';
        return;
      }

      modalElements.currentSection.classList.remove('hidden');
      modalElements.currentName.textContent = currentMenu.name || '';
      const detailParts = [currentMenu.junle, currentMenu.cook].filter(Boolean);
      modalElements.currentDetail.textContent = detailParts.length ? detailParts.join(' / ') : '';
    };

    const renderModalList = () => {
      if (!modalElements.list || !modalElements.empty) return;
      modalElements.list.innerHTML = '';
      const filtered = applyModalFilters();

      if (!filtered.length) {
        modalElements.empty.classList.remove('hidden');
        if (typeof window.refreshLucideIcons === 'function') {
          window.refreshLucideIcons();
        }
        return;
      }

      modalElements.empty.classList.add('hidden');
      const currentMenuId = modalState.currentMenu?.id || '';

      filtered.forEach((menu) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.menuOption = menu.id;
        button.className = [
          'group inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm transition',
          menu.id === currentMenuId
            ? 'border-blue-400 bg-blue-50 text-blue-700'
            : 'border-gray-200 bg-white text-gray-600 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-700'
        ].join(' ');
        button.title = menu.name;

        const nameSpan = document.createElement('span');
        nameSpan.className = 'font-semibold';
        nameSpan.textContent = menu.name;

        const metaSpan = document.createElement('span');
        metaSpan.className = 'text-[11px] text-gray-400 group-hover:text-blue-500';
        const metaParts = [menu.junle, menu.cook].filter(Boolean);
        metaSpan.textContent = metaParts.join(' / ');

        button.appendChild(nameSpan);
        if (metaSpan.textContent) {
          button.appendChild(metaSpan);
        }
        modalElements.list.appendChild(button);
      });

      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    };

    const closeMenuModal = () => {
      if (!modalState.isOpen) return;
      modalState.isOpen = false;
      modalState.slot = null;
      modalState.categoryKey = '';
      modalState.options = [];
      modalState.currentMenu = null;
      modalState.filters = { search: '', kind: '', junle: '', cook: '' };
      if (modalElements.overlay) {
        modalElements.overlay.classList.add('hidden');
        modalElements.overlay.setAttribute('aria-hidden', 'true');
      }
      document.body.classList.remove('overflow-hidden');
    };

    const selectMenuFromModal = (menuId) => {
      if (!modalState.isOpen || !modalState.slot) return;
      const nextMenu = menuLookup[menuId];
      if (!nextMenu) return;
      modalState.slot.menuId = nextMenu.id;
      modalState.slot.dineOut = false;
      modalState.slot.categoryKey = modalState.categoryKey;
      closeMenuModal();
      render();
    };

    const openMenuModal = (categoryKey, slot) => {
      if (!modalElements.overlay || !slot) return;

      const options = Array.isArray(menusByCategory[categoryKey])
        ? menusByCategory[categoryKey].slice()
        : [];
      const currentMenu = slot.menuId ? menuLookup[slot.menuId] || null : null;

      if (currentMenu && !options.some((menu) => menu.id === currentMenu.id)) {
        options.unshift(currentMenu);
      }

      const deduped = Array.from(
        options.reduce((map, menu) => {
          if (menu && menu.id && !map.has(menu.id)) {
            map.set(menu.id, menu);
          }
          return map;
        }, new Map())
      ).map(([, value]) => value);

      modalState.isOpen = true;
      modalState.slot = slot;
      modalState.categoryKey = categoryKey;
      modalState.currentMenu = currentMenu;
      modalState.options = deduped.sort((a, b) => a.name.localeCompare(b.name, 'ja'));
      modalState.filters = {
        search: '',
        kind: '',
        junle: currentMenu?.junle || '',
        cook: ''
      };

      populateSelectOptions(
        modalElements.kindSelect,
        modalState.options.map((menu) => menu.kind),
        ''
      );
      populateSelectOptions(
        modalElements.junleSelect,
        modalState.options.map((menu) => menu.junle),
        modalState.filters.junle
      );
      populateSelectOptions(
        modalElements.cookSelect,
        modalState.options.map((menu) => menu.cook),
        ''
      );

      if (
        modalState.filters.junle &&
        (!modalElements.junleSelect || modalElements.junleSelect.value !== modalState.filters.junle)
      ) {
        modalState.filters.junle = '';
      }

      renderModalCurrentMenu();

      const initialResults = applyModalFilters();
      if (!initialResults.length && modalState.filters.junle) {
        modalState.filters.junle = '';
        if (modalElements.junleSelect) modalElements.junleSelect.value = '';
      }

      renderModalList();

      if (modalElements.searchInput) {
        modalElements.searchInput.value = '';
      }

      modalElements.overlay.classList.remove('hidden');
      modalElements.overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      if (modalElements.searchInput) {
        setTimeout(() => modalElements.searchInput?.focus(), 50);
      }

      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    };

    if (modalElements.overlay) {
      modalElements.overlay.addEventListener('click', (event) => {
        if (event.target === modalElements.overlay) {
          closeMenuModal();
        }
      });
    }

    if (modalElements.list) {
      modalElements.list.addEventListener('click', (event) => {
        const optionButton = event.target.closest('[data-menu-option]');
        if (!optionButton) return;
        selectMenuFromModal(optionButton.dataset.menuOption);
      });
    }

    if (modalElements.searchInput) {
      modalElements.searchInput.addEventListener('input', (event) => {
        modalState.filters.search = event.target.value || '';
        renderModalList();
      });
    }

    if (modalElements.kindSelect) {
      modalElements.kindSelect.addEventListener('change', (event) => {
        modalState.filters.kind = event.target.value || '';
        renderModalList();
      });
    }

    if (modalElements.junleSelect) {
      modalElements.junleSelect.addEventListener('change', (event) => {
        modalState.filters.junle = event.target.value || '';
        renderModalList();
      });
    }

    if (modalElements.cookSelect) {
      modalElements.cookSelect.addEventListener('change', (event) => {
        modalState.filters.cook = event.target.value || '';
        renderModalList();
      });
    }

    if (modalElements.closeButtons.length) {
      modalElements.closeButtons.forEach((button) => {
        button.addEventListener('click', () => closeMenuModal());
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenuModal();
      }
    });

    const updateChips = (container, menu, mealType) => {
      if (!container) return;
      container.innerHTML = '';
      if (!menu) return;

      const formattedTime = menu.time
        ? (String(menu.time).trim().endsWith('分') ? String(menu.time).trim() : `${String(menu.time).trim()}分`)
        : '';

      const chipsData = [];
      if (menu.junle) {
        chipsData.push({ label: 'ジャンル', value: menu.junle });
      }
      if (mealType === 'lunch' && menu.cook) {
        chipsData.push({ label: '調理方法', value: menu.cook });
      }
      if (formattedTime) {
        chipsData.push({ label: '調理時間', value: formattedTime });
      }

      if (!chipsData.length) return;

      chipsData.forEach((chip) => {
        const span = document.createElement('span');
        span.className = 'inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1';
        span.textContent = '';

        const labelSpan = document.createElement('span');
        labelSpan.textContent = chip.label;
        span.appendChild(labelSpan);

        const valueSpan = document.createElement('span');
        valueSpan.className = 'font-medium text-amber-800';
        valueSpan.textContent = chip.value;
        span.appendChild(valueSpan);

        container.appendChild(span);
      });
    };

    const setSlotEmptyState = (wrapper, isEmpty) => {
      if (!wrapper) return;
      if (isEmpty) {
        wrapper.classList.add('slot-empty');
      } else {
        wrapper.classList.remove('slot-empty');
      }
    };

    const updateDineButtonIcons = (button, isDineOut) => {
      if (!button) return;
      const homeIcon = button.querySelector('[data-role="dine-home"]');
      const outIcon = button.querySelector('[data-role="dine-out"]');
      if (homeIcon) {
        homeIcon.classList.toggle('hidden', isDineOut);
      }
      if (outIcon) {
        outIcon.classList.toggle('hidden', !isDineOut);
      }
    };

    const buildPayload = () => {
      const dayPlans = [];

      state.plan.forEach((day) => {
        if (!day) return;
        const dateISO = weekDates[day.index]?.dateISO || day.dateISO || null;

        const lunchSlot = day?.lunch?.main;
        if (lunchSlot && lunchSlot.menuId) {
          dayPlans.push({
            dayIndex: day.index,
            dateISO,
            mealType: 'lunch',
            slots: [{
              categoryKey: lunchSlot.categoryKey || 'lunchMain',
              menuId: lunchSlot.menuId,
              dineOut: !!lunchSlot.dineOut,
              favorite: !!lunchSlot.favorite,
              locked: !!lunchSlot.locked
            }]
          });
        }

        const dinnerSlots = [];
        if (day?.dinner) {
          Object.entries(day.dinner).forEach(([key, value]) => {
            if (!value || !value.menuId) return;
            const categoryKey = value.categoryKey || (key === 'staple' ? 'dinnerStaple'
              : key === 'main' ? 'dinnerMain'
              : key === 'side' ? 'dinnerSide'
              : key === 'soup' ? 'dinnerSoup'
              : null);
            if (!categoryKey) return;
            dinnerSlots.push({
              categoryKey,
              menuId: value.menuId,
              dineOut: !!value.dineOut,
              favorite: !!value.favorite,
              locked: !!value.locked
            });
          });
        }

        if (dinnerSlots.length) {
          dayPlans.push({
            dayIndex: day.index,
            dateISO,
            mealType: 'dinner',
            slots: dinnerSlots
          });
        }
      });

      const weekStartISO = weekDates[0]?.dateISO || (state.plan[0]?.dateISO ?? null) || (dayPlans[0]?.dateISO ?? null);
      const weekEndISO = weekDates[weekDates.length - 1]?.dateISO || (state.plan[state.plan.length - 1]?.dateISO ?? weekStartISO);

      return {
        groupId: currentGroupId,
        weekStart: weekStartISO,
        weekEnd: weekEndISO,
        dayPlans,
        title: weekRangeLabel ? `${weekRangeLabel}の献立` : '',
        planId: state.planId || undefined
      };
    };

    const handleSave = async () => {
      if (!currentGroupId) {
        alert('保存先グループが設定されていません。');
        return;
      }

      const payload = buildPayload();

      if (!payload.weekStart || !payload.dayPlans.length) {
        alert('保存するメニューがありません。');
        return;
      }

      if (!saveButton) return;
      const originalLabel = saveButton.textContent;
      saveButton.disabled = true;
      saveButton.textContent = '保存中...';

      try {
        const response = await fetch('/users/week-menu', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || '保存に失敗しました。');
        }

        if (result.planId) {
          state.planId = result.planId;
          window.weekMenuData.planId = result.planId;
        }

        alert('1週間のメニューを保存しました。');
      } catch (error) {
        console.error(error);
        alert(error.message || '保存に失敗しました。');
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = originalLabel;
      }
    };

    const renderSlot = (wrapper, slot) => {
      const nameEl = wrapper.querySelector('[data-element="dish-name"]');
      const detailEl = wrapper.querySelector('[data-element="dish-detail"]');
      const favoriteBtn = wrapper.querySelector('[data-action="toggle-favorite"]');
      const dineBtn = wrapper.querySelector('[data-action="toggle-dine"]');
      const shuffleBtn = wrapper.querySelector('[data-action="shuffle"]');
      const changeBtn = wrapper.querySelector('[data-action="change"]');
      const clearBtn = wrapper.querySelector('[data-action="clear-slot"]');
      const chipsEl = wrapper.querySelector('[data-element="dish-chips"]');
      const imageEl = wrapper.querySelector('[data-element="dish-image"]');
      const mealType = wrapper.dataset.meal || wrapper.closest('[data-meal]')?.dataset.meal || '';
      const wrapperCategoryKey =
        wrapper.dataset.category || wrapper.closest('[data-slot]')?.dataset.category || '';
      const wrapperCategoryOptions = wrapperCategoryKey ? (menusByCategory[wrapperCategoryKey] || []) : [];

      if (!slot) {
        if (nameEl) nameEl.textContent = 'メニュー候補がありません';
        if (detailEl) {
          detailEl.textContent = '管理者にご確認ください';
          detailEl.classList.remove('hidden');
        }
        if (chipsEl) chipsEl.innerHTML = '';
        updateImage(imageEl, '', '');
        [favoriteBtn, dineBtn, shuffleBtn, changeBtn, clearBtn].forEach((btn) => {
          if (!btn) return;
          if (btn === shuffleBtn || btn === changeBtn) {
            btn.disabled = wrapperCategoryOptions.length === 0;
          } else {
            btn.disabled = true;
          }
        });
        setSlotEmptyState(wrapper, true);
        wrapper.classList.add('opacity-60');
        updateDineButtonIcons(dineBtn, false);
        return;
      }

      const menu = slot.menuId ? menuLookup[slot.menuId] : null;
      const categoryOptions = slot.categoryKey ? (menusByCategory[slot.categoryKey] || []) : [];
      const hasOptions = categoryOptions.length > 0;

      if (!menu) {
        const hasMenuId = !!slot.menuId;
        if (nameEl) nameEl.textContent = hasMenuId ? 'メニュー情報が見つかりません' : 'メニューは未選択です';
        if (detailEl) {
          detailEl.textContent = hasMenuId ? '管理者にご確認ください' : 'メニューを選択してください';
          detailEl.classList.remove('hidden');
        }
        if (chipsEl) chipsEl.innerHTML = '';
        updateImage(imageEl, '', '');

        if (favoriteBtn) {
          favoriteBtn.disabled = true;
          favoriteBtn.setAttribute('aria-pressed', 'false');
          favoriteBtn.classList.remove('is-active', 'text-rose-500', 'border-rose-300', 'bg-rose-50');
        }
        if (dineBtn) {
          dineBtn.disabled = true;
          dineBtn.setAttribute('aria-pressed', 'false');
          updateDineButtonIcons(dineBtn, false);
        }
        if (shuffleBtn) shuffleBtn.disabled = !wrapperCategoryOptions.length;
        if (changeBtn) changeBtn.disabled = !wrapperCategoryOptions.length;
        if (clearBtn) clearBtn.disabled = !hasMenuId;
        setSlotEmptyState(wrapper, true);
        wrapper.classList.remove('opacity-60');
        return;
      }

      setSlotEmptyState(wrapper, false);
      if (nameEl) nameEl.textContent = menu.name;
      if (detailEl) {
        let detailText = menu.cook || menu.junle || menu.kind || menu.menu || '詳細情報は未登録です';
        const hideDetail = detailText && (detailText === menu.cook || detailText === menu.junle);
        if (hideDetail) {
          detailEl.textContent = '';
          detailEl.classList.add('hidden');
        } else {
          detailEl.textContent = detailText;
          detailEl.classList.remove('hidden');
        }
      }
      updateChips(chipsEl, menu, mealType);
      updateImage(imageEl, menu.imageUrl, menu.name);

      wrapper.classList.toggle('opacity-60', !!slot.dineOut);

      if (favoriteBtn) {
        favoriteBtn.disabled = false;
        favoriteBtn.setAttribute('aria-pressed', slot.favorite ? 'true' : 'false');
        favoriteBtn.classList.toggle('is-active', !!slot.favorite);
        favoriteBtn.classList.toggle('text-rose-500', !!slot.favorite);
        favoriteBtn.classList.toggle('border-rose-300', !!slot.favorite);
        favoriteBtn.classList.toggle('bg-rose-50', !!slot.favorite);
      }

      if (dineBtn) {
        dineBtn.disabled = false;
        dineBtn.setAttribute('aria-pressed', slot.dineOut ? 'true' : 'false');
        updateDineButtonIcons(dineBtn, !!slot.dineOut);
      }

      if (shuffleBtn) shuffleBtn.disabled = !hasOptions;
      if (changeBtn) changeBtn.disabled = !hasOptions;
      if (clearBtn) clearBtn.disabled = false;
    };

    const render = () => {
      state.plan.forEach((day, dayIndex) => {
        const lunchWrapper = document.querySelector(
          `[data-day="${dayIndex}"][data-meal="lunch"][data-slot="main"]`
        );
        if (lunchWrapper) {
          renderSlot(lunchWrapper, day?.lunch?.main || null);
        }

        const dinnerDayWrapper = document.querySelector(`[data-day="${dayIndex}"][data-meal="dinner"]`);
        if (dinnerDayWrapper) {
          ['staple', 'main', 'side', 'soup'].forEach((slotKey) => {
            const slotWrapper = dinnerDayWrapper.querySelector(`[data-slot="${slotKey}"]`);
            if (slotWrapper) {
              renderSlot(slotWrapper, day?.dinner?.[slotKey] || null);
            }
          });
        }
      });

      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    };

    const switchTab = (nextTab) => {
      state.tab = nextTab;
      tabButtons.forEach((button) => {
        const isActive = button.dataset.tab === nextTab;
        button.classList.toggle('bg-gray-900', isActive);
        button.classList.toggle('text-white', isActive);
        button.classList.toggle('shadow-sm', isActive);
        button.classList.toggle('bg-gray-100', !isActive);
        button.classList.toggle('text-gray-600', !isActive);
      });
      panels.forEach((panel) => {
        const shouldHide = panel.dataset.panel !== nextTab;
        panel.hidden = shouldHide;
        panel.classList.toggle('hidden', shouldHide);
      });
    };

    document.addEventListener('click', (event) => {
      const actionNode = event.target.closest('[data-action]');
      if (!actionNode) return;

      const wrapper = actionNode.closest('[data-day]');
      if (!wrapper) return;

      const dayIndex = Number(wrapper.dataset.day);
      const mealKey = wrapper.dataset.meal || wrapper.closest('[data-meal]')?.dataset.meal || 'dinner';
      let slotKey = wrapper.dataset.slot;
      if (!slotKey && wrapper.matches('[data-meal="dinner"]')) {
        const slotWrapper = actionNode.closest('[data-slot]');
        slotKey = slotWrapper?.dataset.slot;
        if (!slotWrapper) return;
      }

      const slotWrapper = slotKey ? wrapper.querySelector(`[data-slot="${slotKey}"]`) || wrapper : wrapper;
      const categoryKey = slotWrapper.dataset.category;
      if (!categoryKey) return;

      const slotName = slotKey || 'main';
      const slot = (() => {
        const existing = getSlotReference(dayIndex, mealKey, slotName);
        if (existing) return existing;

        const day = state.plan[dayIndex];
        if (!day) return null;

        const baseSlot = {
          menuId: null,
          categoryKey,
          favorite: false,
          dineOut: false,
          locked: false
        };

        if (mealKey === 'lunch') {
          day.lunch = day.lunch || {};
          day.lunch[slotName] = baseSlot;
        } else if (mealKey === 'dinner') {
          day.dinner = day.dinner || {};
          day.dinner[slotName] = baseSlot;
        }

        return baseSlot;
      })();

      if (!slot) return;
      if (!slot.categoryKey) {
        slot.categoryKey = categoryKey;
      }

      const action = actionNode.dataset.action;
      if (action === 'toggle-favorite') {
        toggleFavorite(slot);
      } else if (action === 'toggle-dine') {
        toggleDineOut(slot);
      } else if (action === 'shuffle') {
        const nextMenu = pickRandomMenu(categoryKey, slot.menuId);
        if (nextMenu) {
          slot.menuId = nextMenu.id;
          slot.dineOut = false;
        }
      } else if (action === 'change') {
        openMenuModal(categoryKey, slot);
      } else if (action === 'clear-slot') {
        slot.menuId = null;
        slot.favorite = false;
        slot.dineOut = false;
        slot.locked = false;
        if (modalState.isOpen && modalState.slot === slot) {
          closeMenuModal();
        }
      }

      render();
      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => switchTab(button.dataset.tab));
    });

    const regenerateButton = document.querySelector('[data-action="regenerate-week"]');
    if (regenerateButton) {
      regenerateButton.addEventListener('click', () => {
        const nextPlan = state.plan.map((day) => {
          const cloneDay = {
            ...day,
            lunch: { ...day.lunch },
            dinner: { ...day.dinner }
          };

          const rebuildSlot = (categoryKey) => {
            const nextMenu = pickRandomMenu(categoryKey);
            if (!nextMenu) return null;
            return {
              menuId: nextMenu.id,
              categoryKey,
              favorite: false,
              dineOut: false
            };
          };

          cloneDay.lunch.main = rebuildSlot('lunchMain');
          cloneDay.dinner.staple = rebuildSlot('dinnerStaple');
          cloneDay.dinner.main = rebuildSlot('dinnerMain');
          cloneDay.dinner.side = rebuildSlot('dinnerSide');
          cloneDay.dinner.soup = rebuildSlot('dinnerSoup');

          return cloneDay;
        });

        state.plan = nextPlan;
        render();
        if (typeof window.refreshLucideIcons === 'function') {
          window.refreshLucideIcons();
        }
      });
    }

    if (saveButton) {
      saveButton.addEventListener('click', handleSave);
    }

    switchTab('lunch');
    render();
    if (typeof window.refreshLucideIcons === 'function') {
      window.refreshLucideIcons();
    }
  })();
</script>
