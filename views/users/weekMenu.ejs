<%
  const serialize = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const displayRow = (menuLookup, slot) => {
    if (!slot) {
      return {
        name: '候補がありません',
        detail: 'メニュー情報が不足しています',
      hasMenu: false,
      junle: '',
      cook: '',
      time: '',
      imageUrl: ''
    };
  }
  const menu = menuLookup[slot.menuId] || null;
  if (!menu) {
    return {
      name: 'メニューが見つかりません',
      detail: '管理者にご確認ください',
      hasMenu: false,
      junle: '',
      cook: '',
      time: '',
      imageUrl: ''
    };
  }

  const detail = menu.cook || menu.junle || menu.kind || menu.menu || '';
  return {
      name: menu.name,
      detail: detail || '詳細情報は未登録です',
      hasMenu: true,
      junle: menu.junle || '',
      cook: menu.cook || '',
      time: (menu.time !== undefined && menu.time !== null) ? String(menu.time) : '',
      imageUrl: menu.imageUrl || ''
    };
  };
%>

<style>
  .slot-empty {
    background-color: #f8fafc !important;
    border: 1px solid #9ca3af !important;
    border-radius: 0.75rem;
  }
  .slot-empty [data-element="dish-image"] {
    background-color: #e5e7eb !important;
    color: #9ca3af !important;
    border-color: #9ca3af !important;
  }
  .slot-empty [data-element="dish-name"],
  .slot-empty [data-element="dish-detail"],
  .slot-empty [data-element="dish-chips"] span,
  .slot-empty [data-element="dish-chips"] span span {
    color: #6b7280 !important;
  }
  .slot-empty p {
    color: #6b7280 !important;
  }
  .slot-empty [data-element="dish-chips"] span {
    background-color: #e5e7eb !important;
  }
  .slot-empty .icon-button {
    border-color: #d1d5db !important;
    color: #94a3b8 !important;
  }
  .slot-empty .icon-button:hover:not(:disabled) {
    border-color: #9ca3af !important;
    color: #64748b !important;
  }
</style>

<div class="fixed inset-0 z-50 hidden" data-menu-modal aria-hidden="true">
  <div class="absolute inset-0 bg-gray-900/70 backdrop-blur-sm" data-menu-modal-close></div>
  <div class="relative flex min-h-full items-center justify-center px-4 py-8">
    <div class="w-full max-w-3xl max-h-[90vh] overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-gray-200 flex flex-col" data-menu-modal-dialog>
      <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-blue-500">メニューを検索</p>
          <h2 class="text-xl font-bold text-gray-900">候補から選択</h2>
        </div>
        <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-gray-300 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-200" data-menu-modal-close aria-label="閉じる">
          <span class="lucide w-4 h-4" data-lucide="x"></span>
        </button>
      </div>
      <div class="flex-1 space-y-5 overflow-y-auto px-6 py-6">
        <div class="grid gap-4 md:grid-cols-4">
          <div class="md:col-span-2">
            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500">キーワード</label>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-gray-300">
                <span class="lucide w-4 h-4" data-lucide="search"></span>
              </span>
              <input type="search" data-menu-modal-search placeholder="メニュー名や食材で検索" class="w-full rounded-xl border border-gray-200 bg-white pl-9 pr-3 py-2 text-sm text-gray-700 placeholder:text-gray-400 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100">
            </div>
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500">種類</label>
            <select data-menu-modal-kind class="w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100">
              <option value="">すべて</option>
            </select>
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500">ジャンル</label>
            <select data-menu-modal-junle class="w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100">
              <option value="">すべて</option>
            </select>
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500">調理方法</label>
            <select data-menu-modal-cook class="w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100">
              <option value="">すべて</option>
            </select>
          </div>
        </div>

        <div class="hidden rounded-2xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-800" data-menu-modal-current>
          <p class="text-xs font-semibold uppercase tracking-wide text-blue-500">現在のメニュー</p>
          <p class="mt-1 text-base font-semibold text-blue-900" data-menu-modal-current-name></p>
          <p class="text-xs text-blue-700/80" data-menu-modal-current-detail></p>
        </div>

        <div class="min-h-[180px]">
          <div class="flex flex-wrap gap-2" data-menu-modal-list></div>
