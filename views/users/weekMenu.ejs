<%
  const serialize = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const displayRow = (menuLookup, slot) => {
    if (!slot) {
      return {
        name: '候補がありません',
        detail: 'メニュー情報が不足しています',
      hasMenu: false,
      junle: '',
      cook: '',
      time: '',
      imageUrl: ''
    };
  }
  const menu = menuLookup[slot.menuId] || null;
  if (!menu) {
    return {
      name: 'メニューが見つかりません',
      detail: '管理者にご確認ください',
      hasMenu: false,
      junle: '',
      cook: '',
      time: '',
      imageUrl: ''
    };
  }

  const detail = menu.cook || menu.junle || menu.kind || menu.menu || '';
  return {
      name: menu.name,
      detail: detail || '詳細情報は未登録です',
      hasMenu: true,
      junle: menu.junle || '',
      cook: menu.cook || '',
      time: (menu.time !== undefined && menu.time !== null) ? String(menu.time) : '',
      imageUrl: menu.imageUrl || ''
    };
  };
%>

<section class="relative max-w-6xl mx-auto py-10 space-y-8">
  <header class="bg-gradient-to-r from-blue-500 via-blue-400 to-indigo-500 text-white rounded-3xl shadow-lg overflow-hidden">
    <div class="p-8 md:p-12 flex flex-col gap-6">
      <div class="space-y-3">
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.3em] bg-white/20 px-4 py-1 rounded-full">
          <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
          1week meal planning
        </span>
        <h1 class="text-3xl md:text-4xl font-bold leading-tight">来週の 7 DAYS PLAN を計画しよう！</h1>
        <p class="text-sm md:text-base text-white/80 max-w-2xl">
          AIが提案するメニューをカスタマイズして、来週の食事の予定を立てましょう
        </p>
      </div>
    </div>
  </header>

  <div class="bg-white border border-gray-100 rounded-3xl shadow-sm overflow-hidden">
