<%
  const serialize = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const displayRow = (menuLookup, slot) => {
    if (!slot) {
      return {
        name: '候補がありません',
        detail: 'メニュー情報が不足しています',
      hasMenu: false,
      junle: '',
      cook: '',
      time: '',
      imageUrl: '',
      url: ''
    };
  }
  const menu = menuLookup[slot.menuId] || null;
  if (!menu) {
    return {
      name: 'メニューが見つかりません',
      detail: '管理者にご確認ください',
      hasMenu: false,
      junle: '',
      cook: '',
      time: '',
      imageUrl: '',
      url: ''
    };
  }

  const detail = menu.cook || menu.junle || menu.kind || menu.menu || '';
  return {
      name: menu.name,
      detail: detail || '詳細情報は未登録です',
      hasMenu: true,
      junle: menu.junle || '',
      cook: menu.cook || '',
      time: (menu.time !== undefined && menu.time !== null) ? String(menu.time) : '',
      imageUrl: menu.imageUrl || '',
      url: menu.url || ''
    };
  };
%>

<style>
  .slot-empty {
    background-color: #f8fafc !important;
    border: 1px solid #9ca3af !important;
    border-radius: 0.75rem;
  }
  .slot-empty [data-element="dish-image"] {
    background-color: #e5e7eb !important;
    color: #9ca3af !important;
    border-color: #9ca3af !important;
  }
  .slot-empty [data-element="dish-name"],
  .slot-empty [data-element="dish-detail"],
  .slot-empty [data-element="dish-chips"] span,
  .slot-empty [data-element="dish-chips"] span span {
    color: #6b7280 !important;
  }
  .slot-empty p {
    color: #6b7280 !important;
  }
  .slot-empty [data-element="dish-chips"] span {
    background-color: #e5e7eb !important;
  }
  .slot-empty .icon-button {
    border-color: #d1d5db !important;
    color: #94a3b8 !important;
  }
  .slot-empty .icon-button:hover:not(:disabled) {
    border-color: #9ca3af !important;
    color: #64748b !important;
  }
  /* Force spacing for the requirements summary below the tabs */
  [data-requirements-summary] {
    margin-top: 5px !important;
    margin-bottom: 0 !important;
  }
  /* ===== Inline 7 DAYS PLAN calendar (compact, myTop palette) ===== */
  .plan-calendar { display: flex; flex-direction: column; gap: 10px; }
  .plan-calendar-header-btn {
    display:inline-flex; align-items:center; justify-content:center;
    width:32px; height:32px; border:1px solid #93c5fd; border-radius:9999px;
    background:#ffffff; color:#1d4ed8; transition:all .15s ease;
  }
  .plan-calendar-header-btn:hover{ border-color:#60a5fa; box-shadow:0 0 0 3px rgba(96,165,250,.2); }
  #plan-calendar-month-label{ color:#1e3a8a; }

  .plan-calendar-grid { display:grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap:4px; grid-auto-rows: 24px; }
  .plan-calendar-day { position:relative; }
  .plan-calendar-day > button {
    width:100%; height:100%;
    border:1px solid #bfdbfe; border-radius:12px; background:#f0f7ff;
    line-height:1; font-size:12px; color:#1e3a8a;
    transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
  }
  .plan-calendar-day > button:hover{ border-color:#60a5fa; background:#e8f2ff; }
  .plan-calendar-day--muted > button { background:#f1f5f9; border-color:#e2e8f0; color:#94a3b8; }
  .plan-calendar-day--today > button { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.25) inset; }


  .plan-calendar-legend { display:inline-flex; align-items:center; gap:6px; font-size:11px; padding:4px 8px; border-radius:9999px; border:1px solid #e5e7eb; background:#fff; color:#1e3a8a; }
  .plan-calendar-legend--planned {
    background-color: #2563eb !important;
    color: #ffffff !important;
  }
  .plan-calendar-legend--future  { border-color:#bfdbfe; background:#f0f7ff; color:#1d4ed8; }
  .plan-calendar-legend--past    { border-color:#cbd5e1; background:#f8fafc; color:#475569; }

  /* week status coloring */
  .plan-calendar-day.is-planned > button {
    background-color: #2563eb !important;
    color: #ffffff !important;
    border-radius: 6px;
  }
  .plan-calendar-day.is-future > button {
    background-color: #f0f7ff; /* light */
    border-color: #bfdbfe;     /* blue-200 */
    color: #1d4ed8;            /* blue-700 */
  }
  /* 過去の週（過去を記録） */
  .plan-calendar-day.is-past > button {
    background-color: #e2e8f0 !important; /* slate-200〜300 と現行より少し濃い */
    border-color: #cbd5e1 !important;     /* slate-300 */
    color: #475569 !important;            /* slate-600 ※読みやすいが濃すぎない */
  }

  /* Constrain inline header calendar width to match myTop */
  .header-calendar-wrap {
    width: 100%;
    max-width: 360px;
    margin-left: auto; /* right-align */
    margin-right: 0;
  }
  @media (min-width: 768px) {
    .header-calendar-wrap {
      max-width: 360px;
      /* Do not override margin-left: auto; */
    }
  }
</style>

<div class="fixed inset-0 z-50 hidden" data-menu-modal aria-hidden="true">
