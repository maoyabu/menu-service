  </div>
</div>

<section class="relative max-w-6xl mx-auto py-10 space-y-8">
  <header class="bg-gradient-to-r from-blue-500 via-blue-400 to-indigo-500 text-white rounded-3xl shadow-lg overflow-hidden">
    <div class="p-6 md:p-8 lg:p-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <!-- Left: title/description -->
        <div class="space-y-3">
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.3em] bg-white/20 px-4 py-1 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
            7 DAYS PLAN
          </span>
          <% 
            const parts = weekRangeLabel.split('〜');
            const year = new Date().getFullYear();
            const displayLabel = parts.length === 2 ? `${year}/${parts[0]}〜${parts[1]}` : `${year}/${weekRangeLabel}`;
          %>
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold leading-tight"><%= displayLabel %><br> の 7 DAYS PLAN を計画しよう！</h1>
          <p class="text-sm md:text-base text-white/80 max-w-2xl">
            AIが提案するメニューを自分好みにカスタマイズして、7 DAYS PLANを立てましょう
          </p>
        </div>

        <!-- Right: inline compact calendar -->
        <aside class="header-calendar-wrap bg-white rounded-2xl shadow border border-gray-100 p-4 plan-calendar">
          <header class="flex items-center justify-between">
            <div>
              <h2 class="text-sm font-semibold text-gray-900">7 DAYS PLAN</h2>
              <p class="text-[11px] text-gray-500 mt-1">週をクリックして切り替えできます</p>
            </div>
            <div class="inline-flex items-center gap-2">
              <button type="button" class="plan-calendar-header-btn" id="plan-calendar-prev" aria-label="前の月">
                <span class="lucide w-4 h-4" data-lucide="chevron-left"></span>
              </button>
              <span class="text-sm font-semibold text-gray-800" id="plan-calendar-month-label">----</span>
              <button type="button" class="plan-calendar-header-btn" id="plan-calendar-next" aria-label="次の月">
                <span class="lucide w-4 h-4" data-lucide="chevron-right"></span>
              </button>
            </div>
          </header>

          <div class="grid grid-cols-7 gap-2 text-[11px] font-semibold uppercase tracking-wide text-gray-500">
            <span class="text-center">月</span>
            <span class="text-center">火</span>
            <span class="text-center">水</span>
            <span class="text-center">木</span>
            <span class="text-center">金</span>
            <span class="text-center">土</span>
            <span class="text-center">日</span>
          </div>

          <div id="plan-calendar-grid" class="plan-calendar-grid text-[12px] text-gray-600">
            <div class="text-center text-sm text-gray-400 py-4" style="grid-column: span 7 / span 7;">読み込み中...</div>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <span class="plan-calendar-legend plan-calendar-legend--planned">プラン登録済み</span>
            <span class="plan-calendar-legend plan-calendar-legend--future">これから設定</span>
            <span class="plan-calendar-legend plan-calendar-legend--past">過去を記録</span>
          </div>
        </aside>
      </div>
    </div>
  </header>

    <div class="px-0 py-0 space-y-0">
      <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm font-semibold">
        <button type="button" data-main-tab="plan" class="main-tab-button w-full rounded-full bg-gray-900 text-white px-4 py-2 shadow-sm">🍽 7 DAYS PLAN</button>
        <button type="button" data-main-tab="supplies" class="main-tab-button w-full rounded-full bg-gray-100 text-gray-600 px-4 py-2">🛒 食材・調味料リスト</button>
      </div>
    </div>
    <div class="px-0">
      <div
        class="rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 mt-[10px] mb-0 hidden"
        data-requirements-summary
      ></div>
    </div>

  <div class="bg-white border border-gray-100 rounded-3xl shadow-sm overflow-hidden">
    <div class="px-6 pb-6 pt-[24px] space-y-0" data-main-panel="plan">
      <div class="inline-grid grid-cols-2 text-sm font-semibold border border-blue-600 overflow-hidden w-64 ml-0 rounded-none" data-plan-tab-buttons>
        <button type="button" data-tab="lunch" class="tab-button w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-blue-600 text-white border-r border-blue-600">🍱 ランチ</button>
        <button type="button" data-tab="dinner" class="tab-button w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-white text-blue-600">🍽 ディナー</button>
      </div>
      <section class="space-y-4" data-panel="lunch">
        <div class="divide-y divide-blue-100 rounded-none border border-blue-100 bg-blue-50 shadow-sm">
          <% plan.forEach((day) => { const rawLunchSlots = Array.isArray(day.lunchSlots) ? day.lunchSlots : []; const dateInfo = Array.isArray(weekDates) ? weekDates[day.index] : null; const dateLabel = dateInfo ? dateInfo.display : ''; %>
            <div class="px-4 py-4" data-day="<%= day.index %>" data-meal="lunch">
              <div class="flex items-start gap-4">
                <div class="w-16 shrink-0 text-left">
                  <p class="text-sm font-semibold text-gray-900"><%= day.dayLabel %></p>
                  <% if (dateLabel) { %>
                    <p class="text-xs text-gray-500"><%= dateLabel %></p>
                  <% } %>
                </div>
                <div class="flex-1 grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-lunch-group>
                  <% rawLunchSlots.forEach((slot, slotIndex) => { if (!(slot && slot.menuId)) { return; } const row = displayRow(menuLookup, slot); %>
                    <div class="rounded-xl border border-blue-100 bg-blue-50/80 overflow-hidden flex flex-col h-full<%= row.hasMenu ? '' : ' slot-empty' %>" data-slot-index="<%= slotIndex %>" data-category="<%= (slot && slot.categoryKey) || 'lunchMain' %>">
                      <div class="w-full h-28 bg-blue-100/60 flex items-center justify-center text-[10px] text-blue-300 relative" data-element="dish-image">                        <% if (row.imageUrl) { %>
                          <% if (row.url) { %>
                            <a href="<%= row.url %>" target="menuWindow" rel="noopener" class="block w-full h-full">
                              <img src="<%= row.imageUrl %>" alt="<%= row.name %>" class="object-cover w-full h-full">
                            </a>
                          <% } else { %>
                            <img src="<%= row.imageUrl %>" alt="<%= row.name %>" class="object-cover w-full h-full">
                          <% } %>
                        <% } else { %>
                          <span>no image</span>
                        <% } %>
                        <% if (row.junle) { %>
                          <span class="absolute left-2 top-2 inline-flex items-center rounded-full bg-blue-50 border border-blue-200 text-blue-600 px-2 py-0.5 text-[10px] font-semibold"><%= row.junle %></span>                        <% } %>
                      </div>
                      <div class="space-y-2 p-4 flex-1">
                        <!-- ランチラベル削除 -->
                        <p class="text-sm font-semibold text-gray-900" data-element="dish-name">
                          <% if (row.url) { %>
                            <a href="<%= row.url %>" target="menuWindow" rel="noopener" class="hover:underline"><%= row.name %></a>
                          <% } else { %>
                            <%= row.name %>
                          <% } %>
                        </p>
                        <div class="flex flex-wrap gap-2 text-[11px] font-semibold text-amber-700" data-element="dish-chips">
                          <% 
                            const formattedTimeLunch = row.time ? (String(row.time).endsWith('分') ? String(row.time) : String(row.time) + '分') : '';
                          %>
                          <% if (formattedTimeLunch) { %>
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-emerald-800">
                              <span>調理時間</span>
                              <span class="font-medium"><%= formattedTimeLunch %></span>
                            </span>
                          <% } %>
                          <% if (row.cook) { %>
                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1">
                              <span>調理方法</span>
                              <span class="font-medium text-amber-800"><%= row.cook %></span>
                            </span>
                          <% } %>
                        </div>
                        <% const shouldShowLunchDetail = row.detail && row.detail !== row.cook && row.detail !== row.junle; %>
                        <p class="text-xs text-gray-500 <%= shouldShowLunchDetail ? '' : 'hidden' %>" data-element="dish-detail"><%= shouldShowLunchDetail ? row.detail : '' %></p>
                      </div>
                      <div class="flex items-center gap-2 justify-end flex-wrap mt-auto pb-3 px-4">
                        <button type="button" class="icon-button favorite-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="toggle-favorite" aria-pressed="false" title="お気に入りに追加" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">お気に入りに追加</span>
                          <span class="lucide w-4 h-4" data-lucide="heart"></span>
                        </button>
                        <button type="button" class="icon-button dine-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="toggle-dine" aria-pressed="false" title="家と外食を切り替え" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">家と外食を切り替え</span>
                          <span data-role="dine-home" class="lucide w-4 h-4" data-lucide="home"></span>
                          <span data-role="dine-out" class="lucide w-4 h-4 hidden" data-lucide="utensils"></span>
                        </button>
                        <button type="button" class="icon-button shuffle-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="shuffle" title="再提案" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">再提案</span>
                          <span class="lucide w-4 h-4" data-lucide="refresh-ccw"></span>
                        </button>
                        <button type="button" class="icon-button clear-slot inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-red-300 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="clear-slot" title="メニューを未選択にする" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">メニューを未選択にする</span>
                          <span class="lucide w-4 h-4" data-lucide="x-circle"></span>
                        </button>
                        <button type="button" class="change-button icon-button inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 shadow-sm transition hover:border-blue-300 hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100 disabled:cursor-not-allowed disabled:opacity-40" data-action="change" title="探す" <% if (!row.hasMenu) { %>disabled<% } %>>
                          <span class="sr-only">探す</span>
                          <span class="lucide w-4 h-4" data-lucide="search"></span>
                        </button>
                      </div>
                    </div>
                  <% }) %>
                  <button type="button" class="rounded-xl border border-dashed border-blue-200 bg-gray-50 text-blue-500 flex flex-col items-center justify-center gap-2 py-6 hover:border-blue-400 hover:text-blue-600 transition" data-action="add-lunch-slot">
                    <span class="lucide w-6 h-6" data-lucide="plus"></span>
                    <span class="text-xs font-semibold">メニューを追加</span>
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
      </div>
    </section>

      <section class="space-y-4 hidden" data-panel="dinner" hidden>
        <div class="divide-y divide-blue-100 rounded-none border border-blue-100 bg-blue-50 shadow-sm">
          <% plan.forEach((day) => {
               const dateInfo = Array.isArray(weekDates) ? weekDates[day.index] : null;
               const dateLabel = dateInfo ? dateInfo.display : '';
               const baseDinnerSlots = ['staple', 'main', 'side', 'soup']
                 .map((slotKey) => {
                   const slot = day?.dinner?.[slotKey] || null;
                   return slot ? { ...slot, baseKey: slotKey } : null;
                 })
                 .filter(Boolean);
               const extraDinnerSlots = Array.isArray(day?.dinnerExtras)
                 ? day.dinnerExtras.map((slot) => (slot ? { ...slot, baseKey: null } : null)).filter(Boolean)
                 : [];
               const dinnerSlots = [...baseDinnerSlots, ...extraDinnerSlots].filter((slot) => slot && slot.menuId);
             %>
            <div class="px-4 py-4" data-day="<%= day.index %>" data-meal="dinner">
              <div class="flex items-start gap-4">
                <div class="w-16 shrink-0 text-left">
                  <p class="text-sm font-semibold text-gray-900"><%= day.dayLabel %></p>
                  <% if (dateLabel) { %>
                    <p class="text-xs text-gray-500"><%= dateLabel %></p>
                  <% } %>
                </div>
                <div class="flex-1 grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-dinner-group>
                  <% dinnerSlots.forEach((slot, slotIndex) => {
                       const categoryKey = slot?.categoryKey
                         || (slot?.baseKey === 'staple'
                           ? 'dinnerStaple'
                           : slot?.baseKey === 'main'
                             ? 'dinnerMain'
                             : slot?.baseKey === 'side'
                               ? 'dinnerSide'
                               : slot?.baseKey === 'soup'
                                 ? 'dinnerSoup'
                                 : 'dinnerFlexible');
