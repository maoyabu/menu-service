</section>

<script>
  window.weekMenuData = {
    plan: JSON.parse('<%- serialize(plan) %>'),
    menusByCategory: JSON.parse('<%- serialize(menusByCategory) %>'),
    menuLookup: JSON.parse('<%- serialize(menuLookup) %>'),
    categoryConfig: JSON.parse('<%- serialize(categoryConfig) %>'),
    weekDates: JSON.parse('<%- serialize(weekDates) %>'),
    weekRangeLabel: <%- serialize(weekRangeLabel) %>,
    currentGroupId: <%- serialize(currentGroupId || '') %>,
    planId: <%- serialize(existingPlanId || '') %>
  };
</script>

<script>
  (function () {
    const data = window.weekMenuData;
    if (!data) return;

    const clonePlan = (value) => {
      if (typeof structuredClone === 'function') {
        try {
          return structuredClone(value);
        } catch (err) {
          // fallback below
        }
      }
      return JSON.parse(JSON.stringify(value));
    };

    const state = {
      planId: data.planId || '',
      tab: 'lunch',
      plan: clonePlan(data.plan)
    };

    const menuLookup = data.menuLookup;
    const menusByCategory = data.menusByCategory;
    const weekDates = Array.isArray(data.weekDates) ? data.weekDates : [];
    const currentGroupId = data.currentGroupId || '';
    const weekRangeLabel = data.weekRangeLabel || '';
    const tabButtons = Array.from(document.querySelectorAll('.tab-button'));
    const panels = Array.from(document.querySelectorAll('[data-panel]'));
    const saveButton = document.querySelector('[data-action="save-week-plan"]');

    const getSlotReference = (dayIndex, mealKey, slotKey) => {
      const day = state.plan[dayIndex];
      if (!day) return null;
      if (mealKey === 'lunch') return day?.lunch?.[slotKey] || null;
      if (mealKey === 'dinner') return day?.dinner?.[slotKey] || null;
      return null;
    };

    const updateImage = (container, url, name) => {
      if (!container) return;
      container.innerHTML = '';
      if (url) {
        const img = document.createElement('img');
        img.src = url;
        img.alt = name || 'メニュー画像';
        img.className = 'object-cover w-full h-full';
        container.appendChild(img);
      } else {
        const span = document.createElement('span');
        span.className = 'text-[10px] text-gray-400';
        span.textContent = 'no image';
        container.appendChild(span);
      }
    };

    const toggleFavorite = (slot) => {
      if (!slot) return;
      slot.favorite = !slot.favorite;
    };

    const toggleDineOut = (slot) => {
      if (!slot) return;
      slot.dineOut = !slot.dineOut;
    };

    const pickRandomMenu = (categoryKey, excludeMenuId) => {
      const options = menusByCategory[categoryKey] || [];
      if (!options.length) return null;
      if (options.length === 1) return options[0];

      let candidate = null;
      let guard = 0;
      do {
        const index = Math.floor(Math.random() * options.length);
        candidate = options[index];
        guard += 1;
      } while (candidate?.id === excludeMenuId && guard < 10);
      return candidate;
    };

    const openPicker = (container, categoryKey, slot) => {
      if (!container) return;
      let picker = container.querySelector('select');
      if (!picker) {
        picker = document.createElement('select');
        picker.className = 'w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-200';
        const options = menusByCategory[categoryKey] || [];
        options.forEach((menu) => {
          const option = document.createElement('option');
          option.value = menu.id;
          option.textContent = menu.name;
          picker.appendChild(option);
        });
        container.appendChild(picker);

        picker.addEventListener('change', (event) => {
          const nextMenu = menuLookup[event.target.value];
          if (!nextMenu) return;
          slot.menuId = nextMenu.id;
          slot.dineOut = false;
          slot.categoryKey = categoryKey;
          container.classList.add('hidden');
          render();
        });
      }

      picker.value = slot.menuId || '';
      container.classList.toggle('hidden');
    };

    const updateChips = (container, menu) => {
      if (!container) return;
      container.innerHTML = '';
      if (!menu) return;

      const formattedTime = menu.time
        ? (String(menu.time).trim().endsWith('分') ? String(menu.time).trim() : `${String(menu.time).trim()}分`)
        : '';

      const chipsData = [
        menu.junle ? { label: 'ジャンル', value: menu.junle } : null,
        menu.cook ? { label: '調理方法', value: menu.cook } : null,
        formattedTime ? { label: '調理時間', value: formattedTime } : null
      ].filter(Boolean);

      if (!chipsData.length) return;

      chipsData.forEach((chip) => {
        const span = document.createElement('span');
        span.className = 'inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1';
        span.textContent = '';

        const labelSpan = document.createElement('span');
        labelSpan.textContent = chip.label;
        span.appendChild(labelSpan);

        const valueSpan = document.createElement('span');
        valueSpan.className = 'font-medium text-amber-800';
        valueSpan.textContent = chip.value;
        span.appendChild(valueSpan);

        container.appendChild(span);
      });
    };

    const updateDineButtonIcons = (button, isDineOut) => {
      if (!button) return;
      const homeIcon = button.querySelector('[data-role="dine-home"]');
      const outIcon = button.querySelector('[data-role="dine-out"]');
      if (homeIcon) {
        homeIcon.classList.toggle('hidden', isDineOut);
      }
      if (outIcon) {
        outIcon.classList.toggle('hidden', !isDineOut);
      }
    };

    const buildPayload = () => {
      const dayPlans = [];

      state.plan.forEach((day) => {
        if (!day) return;
        const dateISO = weekDates[day.index]?.dateISO || day.dateISO || null;

        const lunchSlot = day?.lunch?.main;
        if (lunchSlot && lunchSlot.menuId) {
          dayPlans.push({
            dayIndex: day.index,
            dateISO,
            mealType: 'lunch',
            slots: [{
              categoryKey: lunchSlot.categoryKey || 'lunchMain',
              menuId: lunchSlot.menuId,
              dineOut: !!lunchSlot.dineOut,
              favorite: !!lunchSlot.favorite,
              locked: !!lunchSlot.locked
            }]
          });
        }

        const dinnerSlots = [];
        if (day?.dinner) {
          Object.entries(day.dinner).forEach(([key, value]) => {
            if (!value || !value.menuId) return;
            const categoryKey = value.categoryKey || (key === 'staple' ? 'dinnerStaple'
              : key === 'main' ? 'dinnerMain'
              : key === 'side' ? 'dinnerSide'
              : key === 'soup' ? 'dinnerSoup'
              : null);
            if (!categoryKey) return;
            dinnerSlots.push({
              categoryKey,
              menuId: value.menuId,
              dineOut: !!value.dineOut,
              favorite: !!value.favorite,
              locked: !!value.locked
            });
          });
        }

        if (dinnerSlots.length) {
          dayPlans.push({
            dayIndex: day.index,
            dateISO,
            mealType: 'dinner',
            slots: dinnerSlots
          });
        }
      });

      const weekStartISO = weekDates[0]?.dateISO || (state.plan[0]?.dateISO ?? null) || (dayPlans[0]?.dateISO ?? null);
      const weekEndISO = weekDates[weekDates.length - 1]?.dateISO || (state.plan[state.plan.length - 1]?.dateISO ?? weekStartISO);

      return {
        groupId: currentGroupId,
        weekStart: weekStartISO,
        weekEnd: weekEndISO,
        dayPlans,
        title: weekRangeLabel ? `${weekRangeLabel}の献立` : '',
        planId: state.planId || undefined
      };
    };

    const handleSave = async () => {
      if (!currentGroupId) {
        alert('保存先グループが設定されていません。');
        return;
      }

      const payload = buildPayload();

      if (!payload.weekStart || !payload.dayPlans.length) {
        alert('保存するメニューがありません。');
        return;
      }

      if (!saveButton) return;
      const originalLabel = saveButton.textContent;
      saveButton.disabled = true;
      saveButton.textContent = '保存中...';

      try {
        const response = await fetch('/users/week-menu', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || '保存に失敗しました。');
        }

        if (result.planId) {
          state.planId = result.planId;
          window.weekMenuData.planId = result.planId;
        }

        alert('1週間のメニューを保存しました。');
      } catch (error) {
        console.error(error);
        alert(error.message || '保存に失敗しました。');
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = originalLabel;
      }
    };

    const renderSlot = (wrapper, slot) => {
      const nameEl = wrapper.querySelector('[data-element="dish-name"]');
      const detailEl = wrapper.querySelector('[data-element="dish-detail"]');
      const favoriteBtn = wrapper.querySelector('[data-action="toggle-favorite"]');
      const dineBtn = wrapper.querySelector('[data-action="toggle-dine"]');
      const shuffleBtn = wrapper.querySelector('[data-action="shuffle"]');
      const changeBtn = wrapper.querySelector('[data-action="change"]');
      const chipsEl = wrapper.querySelector('[data-element="dish-chips"]');
      const imageEl = wrapper.querySelector('[data-element="dish-image"]');

      const menu = slot ? menuLookup[slot.menuId] : null;

      if (!slot || !menu) {
        if (nameEl) nameEl.textContent = 'メニュー候補がありません';
        if (detailEl) detailEl.textContent = '管理者にご確認ください';
        if (chipsEl) chipsEl.innerHTML = '';
        updateImage(imageEl, '', '');

        [favoriteBtn, dineBtn, shuffleBtn, changeBtn].forEach((btn) => {
          if (btn) btn.disabled = true;
        });
        wrapper.classList.add('opacity-60');
        updateDineButtonIcons(dineBtn, false);
        return;
      }

      if (nameEl) nameEl.textContent = menu.name;
      if (detailEl) detailEl.textContent = menu.cook || menu.junle || menu.kind || menu.menu || '詳細情報は未登録です';
      updateChips(chipsEl, menu);
      updateImage(imageEl, menu.imageUrl, menu.name);

      wrapper.classList.toggle('opacity-60', !!slot.dineOut);

      if (favoriteBtn) {
        favoriteBtn.disabled = false;
        favoriteBtn.setAttribute('aria-pressed', slot.favorite ? 'true' : 'false');
        favoriteBtn.classList.toggle('is-active', !!slot.favorite);
        favoriteBtn.classList.toggle('text-rose-500', !!slot.favorite);
        favoriteBtn.classList.toggle('border-rose-300', !!slot.favorite);
        favoriteBtn.classList.toggle('bg-rose-50', !!slot.favorite);
      }

      if (dineBtn) {
        dineBtn.disabled = false;
        dineBtn.setAttribute('aria-pressed', slot.dineOut ? 'true' : 'false');
        updateDineButtonIcons(dineBtn, !!slot.dineOut);
      }

      if (shuffleBtn) shuffleBtn.disabled = false;
      if (changeBtn) changeBtn.disabled = false;
    };

    const render = () => {
      state.plan.forEach((day, dayIndex) => {
        const lunchWrapper = document.querySelector(
          `[data-day="${dayIndex}"][data-meal="lunch"][data-slot="main"]`
        );
        if (lunchWrapper) {
          renderSlot(lunchWrapper, day?.lunch?.main || null);
        }

        const dinnerDayWrapper = document.querySelector(`[data-day="${dayIndex}"][data-meal="dinner"]`);
        if (dinnerDayWrapper) {
          ['staple', 'main', 'side', 'soup'].forEach((slotKey) => {
            const slotWrapper = dinnerDayWrapper.querySelector(`[data-slot="${slotKey}"]`);
            if (slotWrapper) {
              renderSlot(slotWrapper, day?.dinner?.[slotKey] || null);
            }
          });
        }
      });

      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    };

    const switchTab = (nextTab) => {
      state.tab = nextTab;
      tabButtons.forEach((button) => {
        const isActive = button.dataset.tab === nextTab;
        button.classList.toggle('bg-gray-900', isActive);
        button.classList.toggle('text-white', isActive);
        button.classList.toggle('shadow-sm', isActive);
        button.classList.toggle('bg-gray-100', !isActive);
        button.classList.toggle('text-gray-600', !isActive);
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.panel !== nextTab);
      });
    };

    document.addEventListener('click', (event) => {
      const actionNode = event.target.closest('[data-action]');
      if (!actionNode) return;

      const wrapper = actionNode.closest('[data-day]');
      if (!wrapper) return;

      const dayIndex = Number(wrapper.dataset.day);
      const mealKey = wrapper.dataset.meal || wrapper.closest('[data-meal]')?.dataset.meal || 'dinner';
      let slotKey = wrapper.dataset.slot;
      if (!slotKey && wrapper.matches('[data-meal="dinner"]')) {
        const slotWrapper = actionNode.closest('[data-slot]');
        slotKey = slotWrapper?.dataset.slot;
        if (!slotWrapper) return;
      }

      const slotWrapper = slotKey ? wrapper.querySelector(`[data-slot="${slotKey}"]`) || wrapper : wrapper;
      const categoryKey = slotWrapper.dataset.category;
      if (!categoryKey) return;

      const slot = getSlotReference(dayIndex, mealKey, slotKey || 'main');
      if (!slot) return;

      const action = actionNode.dataset.action;
      if (action === 'toggle-favorite') {
        toggleFavorite(slot);
      } else if (action === 'toggle-dine') {
        toggleDineOut(slot);
      } else if (action === 'shuffle') {
        const nextMenu = pickRandomMenu(categoryKey, slot.menuId);
        if (nextMenu) {
          slot.menuId = nextMenu.id;
          slot.dineOut = false;
        }
      } else if (action === 'change') {
        const pickerHost = slotWrapper.querySelector('[data-picker]');
        openPicker(pickerHost, categoryKey, slot);
      }

      render();
      if (typeof window.refreshLucideIcons === 'function') {
        window.refreshLucideIcons();
      }
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => switchTab(button.dataset.tab));
    });

    const regenerateButton = document.querySelector('[data-action="regenerate-week"]');
    if (regenerateButton) {
      regenerateButton.addEventListener('click', () => {
        const nextPlan = state.plan.map((day) => {
          const cloneDay = {
            ...day,
            lunch: { ...day.lunch },
            dinner: { ...day.dinner }
          };

          const rebuildSlot = (categoryKey) => {
            const nextMenu = pickRandomMenu(categoryKey);
            if (!nextMenu) return null;
            return {
              menuId: nextMenu.id,
              categoryKey,
              favorite: false,
              dineOut: false
            };
          };

          cloneDay.lunch.main = rebuildSlot('lunchMain');
          cloneDay.dinner.staple = rebuildSlot('dinnerStaple');
          cloneDay.dinner.main = rebuildSlot('dinnerMain');
          cloneDay.dinner.side = rebuildSlot('dinnerSide');
          cloneDay.dinner.soup = rebuildSlot('dinnerSoup');

          return cloneDay;
        });

        state.plan = nextPlan;
        render();
        if (typeof window.refreshLucideIcons === 'function') {
          window.refreshLucideIcons();
        }
      });
    }

    if (saveButton) {
      saveButton.addEventListener('click', handleSave);
    }

    switchTab('lunch');
    render();
    if (typeof window.refreshLucideIcons === 'function') {
      window.refreshLucideIcons();
    }
  })();
</script>
