<section class="max-w-4xl mx-auto py-8 space-y-6">
  <header class="space-y-1">
    <p class="text-xs text-gray-500"><a href="/notices" class="text-blue-600 hover:underline">お知らせ一覧</a></p>
    <h1 class="text-2xl font-bold text-gray-900"><%= notice?.title || 'お知らせ' %></h1>
    <p class="text-sm text-gray-500"><%= notice && notice.publishedAt ? new Date(notice.publishedAt).toLocaleString('ja-JP') : '' %></p>
    <% if (notice?.category) { %>
      <span class="inline-block text-[11px] px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100"><%= notice.category %></span>
    <% } %>
  </header>

  <article class="rounded-2xl border bg-white p-5 shadow-sm space-y-4">
    <div class="text-sm text-gray-800 whitespace-pre-wrap"><%= notice?.body || '' %></div>
    <% if (notice?.url) { %>
      <a href="<%= notice.url %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">
        リンクを開く
        <i data-lucide="external-link" class="w-4 h-4"></i>
      </a>
    <% } %>
  </article>
</section>
