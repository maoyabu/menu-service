<div class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div class="flex flex-wrap items-end gap-3">
      <h1 class="text-2xl font-bold leading-tight">備品管理</h1>
      <p class="text-sm text-gray-500">自宅の備品を保管場所ごとに管理</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/users/my-equipment/inventory" class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-semibold rounded-full border border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100">
        <span class="lucide w-4 h-4" data-lucide="check-square"></span>
        <span>棚卸しリスト</span>
      </a>
    </div>
  </header>

  <section class="space-y-2">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div></div>
      <div class="flex gap-2">
        <button type="button" id="equip-guide-hide" class="px-3 py-1.5 rounded border text-sm bg-gray-100 text-gray-700 hover:bg-gray-200">非表示</button>
        <button type="button" id="equip-guide-show" class="px-3 py-1.5 rounded border text-sm bg-blue-50 text-blue-700 hover:bg-blue-100">ガイド表示</button>
      </div>
    </div>
    <div id="equip-guide-wrapper" class="border rounded-2xl bg-white overflow-hidden shadow-sm">
      <img src="/pict/myEquipment.jpg" alt="マイ備品ガイド" class="w-full h-auto object-cover">
    </div>
  </section>

  <!-- Filter tabs (match myStock look) -->
  <% const t = type || 'all'; const showGridView = (t === 'all' || t === 'wishlist'); %>
  <div class="mt-1">
    <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
      <a href="/users/my-equipment?type=all" class="px-4 py-1 rounded-full <%= t==='all' ? 'bg-white shadow text-gray-900' : 'text-gray-600' %>">すべて</a>
      <a href="/users/my-equipment?type=house" class="px-4 py-1 rounded-full <%= t==='house' ? 'bg-white shadow text-gray-900' : 'text-gray-600' %>">家ストック</a>
      <a href="/users/my-equipment?type=disaster" class="px-4 py-1 rounded-full <%= t==='disaster' ? 'bg-white shadow text-gray-900' : 'text-gray-600' %>">防災対策</a>
      <a href="/users/my-equipment?type=camping" class="px-4 py-1 rounded-full <%= t==='camping' ? 'bg-white shadow text-gray-900' : 'text-gray-600' %>">キャンプ用</a>
      <a href="/users/my-equipment?type=wishlist" class="px-4 py-1 rounded-full <%= t==='wishlist' ? 'bg-white shadow text-gray-900' : 'text-gray-600' %>">ウィッシュリスト</a>
    </div>
  </div>

  <!-- Add button (amber) under filters -->
  <div>
    <button type="button" onclick="openAddModal()" class="px-3 py-1.5 rounded border bg-amber-50 border-amber-300 text-amber-800 text-sm">＋ 追加</button>
  </div>

  <% const placeNames = Object.keys(placeMap||{}); %>
  <% if (!placeNames.length) { %>
    <div class="bg-white rounded-xl border p-6 text-center text-gray-600">まだ備品がありません。「追加」から登録してください。</div>
  <% } %>
  <% placeNames.forEach((pname) => { const list = placeMap[pname] || []; const pnameLiteral = JSON.stringify(pname || '').replace(/'/g, "\\'"); %>
    <section class="rounded-2xl border bg-white">
      <div class="p-4 flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-semibold"><%= pname %></h2>
        <div class="flex items-center gap-2">
          <button type="button" onclick='openAddModal(<%- pnameLiteral %>)' class="px-3 py-1 rounded border bg-amber-50 border-amber-300 text-amber-800 text-xs">＋ 追加</button>
        </div>
      </div>
      <div class="px-4 pb-4 space-y-3">
        <% const groupKey = (it) => {
             if (t === 'house') return it.houseCategory || '未分類';
             if (t === 'disaster') return it.disasterCategory || '未分類';
             if (t === 'camping') return it.campingCategory || '未分類';
             return '';
           }; %>
        <% const grouped = {}; list.forEach(it=>{ const k = groupKey(it); grouped[k] = grouped[k]||[]; grouped[k].push(it); }); %>
        <% const cats = Object.keys(grouped); %>
        <% if (showGridView) { %>
          <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            <% list.forEach(function(it){
                 const editPayload = JSON.stringify({ id: String(it._id), equipmentId: it.equipment ? String(it.equipment) : "", name: it.name||"", quantity: it.quantity||0, unit: it.unit||"", placeId: String(it.place||""), isConsumable: !!it.isConsumable, houseCategory: it.houseCategory||"", disasterCategory: it.disasterCategory||"", campingCategory: it.campingCategory||"", maintenance: it.maintenance||"", productUrl: it.productUrl||"", productImageUrl: it.productImageUrl||"", comment: it.comment||"", expiryDate: it.expiryDate ? new Date(it.expiryDate).toISOString().slice(0,10) : "", tracked: !!it.tracked, lastCount: it.lastCount||0, lastComment: it.lastComment||"", ownerId: it.ownerId || "all" }).replace(/'/g,"\\\\'");
                 const qtyNum = Number(it.quantity) || 0;
                 const wishlistItem = (!it.place) || qtyNum <= 0;
                 const hasImage = !!(it.productImageUrl && it.productImageUrl.trim());
                 const hasProductUrl = !!(it.productUrl && it.productUrl.trim());
            %>
              <div class="border border-blue-300 rounded-lg bg-white px-3 py-2 text-sm shadow-sm flex flex-col h-full">
                <div class="flex gap-3 flex-1">
                  <div class="w-16 h-16 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                    <% if (hasImage) { %>
                      <img src="<%= it.productImageUrl %>" alt="<%= it.name %>の画像" class="w-full h-full object-cover" loading="lazy">
                    <% } else { %>
                      <span class="text-[11px] text-gray-400">No Image</span>
                    <% } %>
                  </div>
                  <div class="flex-1 min-w-0 space-y-1">
                    <div class="flex items-start justify-between gap-2">
                      <div class="min-w-0">
                        <p class="font-medium text-gray-900 truncate"><%= it.name %></p>
                        <% if (wishlistItem) { %><span class="inline-flex items-center text-[11px] text-amber-700 bg-amber-50 border border-amber-200 rounded px-1.5 py-0.5 mt-0.5">ウィッシュリスト</span><% } %>
                      </div>
                      <span class="inline-flex items-center gap-1 ml-2 shrink-0">
                        <button type="button" class="text-gray-600 hover:text-gray-800" title="編集" onclick='openEdit(<%- editPayload %>)'><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                        <button type="button" class="text-red-600 hover:text-red-700" title="削除" onclick="removeItem('<%= it._id %>')"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                      </span>
                    </div>
                    <% if (it.comment) { %>
                      <p class="text-xs text-gray-500 truncate"><%= it.comment %></p>
                    <% } %>
                    <div class="text-xs text-gray-600">
                      <span class="align-middle"><%= it.quantity || '' %><%= it.unit || '' %></span>
                    </div>
                    <div class="text-[11px] text-gray-600">
                      所有: <span class="font-medium text-gray-800"><%= it.ownerName || '全員' %></span>
                    </div>
                    <div class="text-[11px] text-gray-500 flex items-center gap-1 flex-wrap">
                      <% if (it.houseCategory) { %><span class="px-2 py-0.5 text-[11px] bg-gray-100 rounded"><%= it.houseCategory %></span><% } %>
                      <% if (it.disasterCategory) { %><span class="px-2 py-0.5 text-[11px] bg-orange-100 rounded"><%= it.disasterCategory %></span><% } %>
                      <% if (it.campingCategory) { %><span class="px-2 py-0.5 text-[11px] bg-green-100 rounded"><%= it.campingCategory %></span><% } %>
                    </div>
                    <% if (it.maintenance) { %><div class="text-[11px] text-gray-500 truncate"><%= it.maintenance %></div><% } %>
                      </div>
                    </div>
                <% if (hasProductUrl) { %>
                  <div class="pt-2 mt-auto">
                    <a href="<%= it.productUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-semibold">
                      <span class="lucide w-3.5 h-3.5" data-lucide="shopping-cart"></span>
                      購入
                    </a>
                  </div>
                <% } %>
              </div>
                <% }) %>
              </div>
        <% } else { %>
          <% cats.forEach(function(cat){ const items = grouped[cat] || []; %>
            <details class="group" open>
              <summary class="cursor-pointer select-none px-1 py-1.5 flex items-center justify-between">
                <span class="font-medium text-sm"><%= cat %></span>
                <span class="text-xs text-gray-500"><%= items.length %> 件</span>
              </summary>
              <div class="pb-2 pt-1 grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                <% items.forEach(function(it){
                 const editPayload = JSON.stringify({ id: String(it._id), equipmentId: it.equipment ? String(it.equipment) : "", name: it.name||"", quantity: it.quantity||0, unit: it.unit||"", placeId: String(it.place||""), isConsumable: !!it.isConsumable, houseCategory: it.houseCategory||"", disasterCategory: it.disasterCategory||"", campingCategory: it.campingCategory||"", maintenance: it.maintenance||"", productUrl: it.productUrl||"", productImageUrl: it.productImageUrl||"", comment: it.comment||"", expiryDate: it.expiryDate ? new Date(it.expiryDate).toISOString().slice(0,10) : "", tracked: !!it.tracked, lastCount: it.lastCount||0, lastComment: it.lastComment||"", ownerId: it.ownerId || "all" }).replace(/'/g,"\\\\'");
                     const qtyNum = Number(it.quantity) || 0;
                     const wishlistItem = (!it.place) || qtyNum <= 0;
                     const hasImage = !!(it.productImageUrl && it.productImageUrl.trim());
                     const hasProductUrl = !!(it.productUrl && it.productUrl.trim());
                %>
                  <div class="border border-blue-300 rounded-lg bg-white px-3 py-2 text-sm shadow-sm flex flex-col h-full">
                    <div class="flex gap-3 flex-1">
                      <div class="w-16 h-16 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                        <% if (hasImage) { %>
                          <img src="<%= it.productImageUrl %>" alt="<%= it.name %>の画像" class="w-full h-full object-cover" loading="lazy">
                        <% } else { %>
                          <span class="text-[11px] text-gray-400">No Image</span>
                        <% } %>
                      </div>
                      <div class="flex-1 min-w-0 space-y-1">
                        <div class="flex items-start justify-between gap-2">
                          <div class="min-w-0">
                            <p class="font-medium text-gray-900 truncate"><%= it.name %></p>
                            <% if (wishlistItem) { %><span class="inline-flex items-center text-[11px] text-amber-700 bg-amber-50 border border-amber-200 rounded px-1.5 py-0.5 mt-0.5">ウィッシュリスト</span><% } %>
                          </div>
                          <span class="inline-flex items-center gap-1 ml-2 shrink-0">
                            <button type="button" class="text-gray-600 hover:text-gray-800" title="編集" onclick='openEdit(<%- editPayload %>)'><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                            <button type="button" class="text-red-600 hover:text-red-700" title="削除" onclick="removeItem('<%= it._id %>')"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                          </span>
                        </div>
                        <% if (it.comment) { %>
                          <p class="text-xs text-gray-500 truncate"><%= it.comment %></p>
                        <% } %>
                        <div class="text-xs text-gray-600">
                          <span class="align-middle"><%= it.quantity || '' %><%= it.unit || '' %></span>
                        </div>
                        <div class="text-[11px] text-gray-600">
                          所有: <span class="font-medium text-gray-800"><%= it.ownerName || '全員' %></span>
                        </div>
                        <div class="text-[11px] text-gray-500 flex items-center gap-1 flex-wrap">
                          <% if (it.houseCategory) { %><span class="px-2 py-0.5 text-[11px] bg-gray-100 rounded"><%= it.houseCategory %></span><% } %>
                          <% if (it.disasterCategory) { %><span class="px-2 py-0.5 text-[11px] bg-orange-100 rounded"><%= it.disasterCategory %></span><% } %>
                          <% if (it.campingCategory) { %><span class="px-2 py-0.5 text-[11px] bg-green-100 rounded"><%= it.campingCategory %></span><% } %>
                        </div>
                        <% if (it.maintenance) { %><div class="text-[11px] text-gray-500 truncate"><%= it.maintenance %></div><% } %>
                      </div>
                    </div>
                    <% if (hasProductUrl) { %>
                      <div class="pt-2 mt-auto">
                        <a href="<%= it.productUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-semibold">
                          <span class="lucide w-3.5 h-3.5" data-lucide="shopping-cart"></span>
                          購入
                        </a>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </details>
          <% }) %>
        <% } %>
      </div>
    </section>
  <% }) %>

  <!-- Add/Edit Modal -->
  <dialog id="equip-modal" class="rounded-xl p-0 w-full max-w-3xl">
    <form method="dialog" class="p-0 m-0" onsubmit="return false;">
      <div class="px-5 py-3 border-b flex items-center justify-between">
        <h3 id="equip-modal-title" class="font-semibold">備品の追加</h3>
        <button type="button" class="text-gray-500" onclick="closeEquipModal()">✕</button>
      </div>
      <div class="p-5 space-y-5 max-h-[70vh] overflow-y-auto">
        <!-- Tabs like myStock -->
        <div id="preset-section" class="space-y-3">
          <div class="flex flex-col gap-2">
            <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm w-fit">
              <button type="button" data-preset-tab="preset" class="px-4 py-1 rounded-full bg-white shadow text-gray-900">プリセットから選択</button>
              <button type="button" data-preset-tab="custom" class="px-4 py-1 rounded-full text-gray-600">オリジナル追加</button>
            </div>
            <span class="text-xs text-gray-500">タグを選んだあと、下の入力欄で数量や保存場所を入力してください</span>
          </div>

          <!-- Preset search -->
          <div id="preset-pane" class="space-y-3">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-2 items-end">
              <div>
                <label class="block text-xs text-gray-600">キーワード検索</label>
                <input id="q-keyword" type="text" placeholder="例: 石けん" class="w-full border rounded px-2 py-1" />
              </div>
              <div>
                <label class="block text-xs text-gray-600">家ストック分類</label>
                <input id="q-house" list="opt-house" class="w-full border rounded px-2 py-1" />
              </div>
              <div>
                <label class="block text-xs text-gray-600">防災対策分類</label>
                <input id="q-disaster" list="opt-disaster" class="w-full border rounded px-2 py-1" />
              </div>
              <div>
                <label class="block text-xs text-gray-600">キャンプ分類</label>
                <input id="q-camping" list="opt-camping" class="w-full border rounded px-2 py-1" />
              </div>
              <div class="md:col-span-1 flex md:justify-start">
                <button type="button" id="preset-clear" class="px-3 py-1.5 border border-gray-500 rounded text-sm text-gray-700">クリア</button>
              </div>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded p-2">
              <div id="preset-results" class="flex gap-2 flex-wrap max-h-48 overflow-auto"></div>
            </div>
          </div>

          <!-- Custom preset registration -->
        <div id="custom-preset-panel" class="rounded border border-dashed border-blue-200 bg-blue-50/40 p-3 space-y-3 hidden">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-sm font-semibold text-blue-900">オリジナル備品を登録（グループ限定）</p>
                <p class="text-xs text-blue-800">プリセットに無い備品名をタグとして登録できます</p>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
              <div class="md:col-span-3">
                <label class="block text-xs text-gray-600">備品名</label>
                <input id="custom-preset-name" type="text" class="w-full border rounded px-2 py-1" placeholder="例: 自宅オリジナル備品" />
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-2 md:col-span-3">
                <div>
                  <label class="block text-xs text-gray-600">単位</label>
                  <input id="custom-preset-unit" type="text" class="w-full border rounded px-2 py-1" placeholder="例: 個" />
                </div>
                <div class="flex items-end">
                  <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input id="custom-preset-consumable" type="checkbox" />
                    消耗品
                  </label>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-2 md:col-span-3">
                <div>
                  <label class="block text-xs text-gray-600">家ストック分類</label>
                  <input id="custom-preset-house" list="opt-house" class="w-full border rounded px-2 py-1" />
                </div>
                <div>
                  <label class="block text-xs text-gray-600">防災対策分類</label>
                  <input id="custom-preset-disaster" list="opt-disaster" class="w-full border rounded px-2 py-1" />
                </div>
                <div>
                  <label class="block text-xs text-gray-600">キャンプ分類</label>
                  <input id="custom-preset-camping" list="opt-camping" class="w-full border rounded px-2 py-1" />
                </div>
              </div>
              <div class="md:col-span-3">
                <label class="block text-xs text-gray-600">メンテナンス内容</label>
                <input id="custom-preset-maintenance" list="opt-maint" class="w-full border rounded px-2 py-1" />
              </div>
            </div>
            <div class="flex justify-end">
              <button type="button" id="custom-preset-save" class="px-4 py-1.5 rounded bg-blue-600 text-white text-xs">タグとして登録</button>
            </div>
          </div>
        </div>

        <!-- Input block (blue background) -->
        <div id="original-pane" class="rounded border border-blue-200 bg-blue-50 p-3 space-y-3 hidden">
          <div id="equip-target" class="rounded border border-blue-200 bg-blue-100 px-3 py-2 text-sm font-semibold text-blue-900 flex flex-wrap gap-2 hidden">
            <span id="equip-target-name"></span>
            <span id="equip-target-category" class="text-xs font-normal text-blue-800 hidden"></span>
          </div>
          <!-- Header: note + place -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-end">
            <div>
              <label class="block text-xs text-gray-600">備品名補足（任意）</label>
              <input id="f-comment" type="text" class="w-full border rounded px-2 py-1" placeholder="例: よく使う商品名など" />
            </div>
            <div>
              <label class="block text-xs text-gray-600">保存場所</label>
              <input id="f-place-name" list="opt-place" placeholder="既存を選択 or 新規名を入力" class="w-full border rounded px-2 py-1" />
            </div>
          </div>
          <input id="f-name" type="hidden" />
          <div>
            <label class="block text-xs text-gray-600">所有者</label>
            <select id="f-owner" class="w-full border rounded px-2 py-1">
              <% (ownerOptions || [{ id: 'all', name: '全員' }]).forEach(function(opt){ %>
                <option value="<%= opt.id %>"><%= opt.name || '名前未設定' %></option>
              <% }) %>
            </select>
            <p class="text-[11px] text-gray-500 mt-0.5">「全員」またはグループメンバーから選択</p>
          </div>

          <!-- Row: 数量/単位/消耗品 -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
            <div>
              <label class="block text-xs text-gray-600">数量</label>
              <input id="f-qty" type="number" min="0" class="w-full border rounded px-2 py-1" />
            </div>
            <div>
              <label class="block text-xs text-gray-600">単位</label>
              <input id="f-unit" list="opt-unit" class="w-full border rounded px-2 py-1" />
            </div>
            <div class="flex items-end">
              <label class="inline-flex items-center gap-2 text-base text-gray-800">
                <input id="f-consumable" type="checkbox" />
                消耗品
              </label>
            </div>
          </div>

          <div class="space-y-2">
            <label class="inline-flex items-center gap-2 text-sm text-gray-800">
              <input id="f-tracked" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-200">
              <span>棚卸し対象として数量/コメントを記録する</span>
            </label>
            <div id="tracked-fields" class="grid grid-cols-1 md:grid-cols-2 gap-2 hidden">
              <div>
                <label class="block text-xs text-gray-600">棚卸し用 基準数量</label>
                <input id="f-last-count" type="number" min="0" class="w-full border rounded px-2 py-1" value="0" />
              </div>
              <div>
                <label class="block text-xs text-gray-600">棚卸しメモ</label>
                <input id="f-last-comment" type="text" class="w-full border rounded px-2 py-1" placeholder="棚卸し時に記録するコメント" />
              </div>
            </div>
          </div>

          <!-- Row: 家/防災/キャンプ -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
            <div>
              <label class="block text-xs text-gray-600">家ストック分類</label>
              <input id="f-house" list="opt-house" class="w-full border rounded px-2 py-1" />
            </div>
            <div>
              <label class="block text-xs text-gray-600">防災対策分類</label>
              <input id="f-disaster" list="opt-disaster" class="w-full border rounded px-2 py-1" />
            </div>
            <div>
              <label class="block text-xs text-gray-600">キャンプ分類</label>
              <input id="f-camping" list="opt-camping" class="w-full border rounded px-2 py-1" />
            </div>
          </div>

          <!-- Row: URL -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-2 items-start">
            <div class="md:col-span-2 space-y-1">
              <label class="block text-xs text-gray-600">商品URL（任意）</label>
              <input id="f-url" type="url" class="w-full border rounded px-2 py-1" placeholder="例: https://www.amazon.co.jp/...">
              <div class="text-[11px] text-gray-500">
                画像URL：
                <span id="equip-image-url" class="break-all">未取得</span>
              </div>
              <input id="f-image-url" type="url" class="w-full border rounded px-2 py-1 text-xs" placeholder="画像URLを直接入力（取得できない場合はこちら）">
            </div>
            <div class="flex items-center justify-center">
              <div class="border border-dashed border-gray-300 rounded bg-white w-32 h-32 flex items-center justify-center overflow-hidden">
                <img id="equip-image-preview" class="max-w-full max-h-full object-contain hidden" alt="商品画像プレビュー">
                <span id="equip-image-placeholder" class="text-[11px] text-gray-400">プレビュー</span>
              </div>
            </div>
          </div>

          <!-- Row: メンテ + 期限 (メンテ広め/期限狭め) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
            <div class="md:col-span-2">
              <label class="block text-xs text-gray-600">メンテナンス内容</label>
              <input id="f-maintenance" list="opt-maint" class="w-full border rounded px-2 py-1" />
            </div>
            <div>
              <label class="block text-xs text-gray-600">賞味期限（任意）</label>
              <input id="f-expiry" type="date" class="w-full border rounded px-2 py-1" />
            </div>
          </div>
        </div>
      </div>
      <div id="equip-form-actions" class="px-5 py-3 border-t flex justify-end gap-2 hidden">
        <button type="button" class="px-3 py-1.5 border rounded" onclick="closeEquipModal()">キャンセル</button>
        <button type="button" class="px-3 py-1.5 bg-blue-600 text-white rounded" onclick="submitEquipForm()">保存</button>
      </div>
    </form>
    <datalist id="opt-unit">
      <% (categories.units||[]).forEach(v=>{ %><option value="<%= v %>"></option><% }) %>
    </datalist>
    <datalist id="opt-house">
      <% (categories.house||[]).forEach(v=>{ %><option value="<%= v %>"></option><% }) %>
    </datalist>
    <datalist id="opt-disaster">
      <% (categories.disaster||[]).forEach(v=>{ %><option value="<%= v %>"></option><% }) %>
    </datalist>
    <datalist id="opt-camping">
      <% (categories.camping||[]).forEach(v=>{ %><option value="<%= v %>"></option><% }) %>
    </datalist>
    <datalist id="opt-maint">
      <% (categories.maintenance||[]).forEach(v=>{ %><option value="<%= v %>"></option><% }) %>
    </datalist>
    <datalist id="opt-place"></datalist>
  </dialog>
</div>

<script>
const MYEQ_PLACES = <%- JSON.stringify(places || []) %>;
let editingId = null;
let selectedPreset = null;
const equipImageUrlText = document.getElementById('equip-image-url');
const equipImagePreview = document.getElementById('equip-image-preview');
const equipImagePlaceholder = document.getElementById('equip-image-placeholder');
const productUrlInputEl = document.getElementById('f-url');
const manualImageInputEl = document.getElementById('f-image-url');
const ownerSelectEl = document.getElementById('f-owner');
const equipTargetBox = document.getElementById('equip-target');
const equipTargetName = document.getElementById('equip-target-name');
const equipTargetCategory = document.getElementById('equip-target-category');
const presetSection = document.getElementById('preset-section');
const equipGuideWrapper = document.getElementById('equip-guide-wrapper');
const equipGuideHide = document.getElementById('equip-guide-hide');
const equipGuideShow = document.getElementById('equip-guide-show');
let equipImageFetchTimer = null;
let equipImageFetchId = 0;
const nameInputEl = document.getElementById('f-name');
const unitInputEl = document.getElementById('f-unit');
const consumableInputEl = document.getElementById('f-consumable');
const houseInputEl = document.getElementById('f-house');
const disasterInputEl = document.getElementById('f-disaster');
const campingInputEl = document.getElementById('f-camping');
const customPresetInputs = {
  name: document.getElementById('custom-preset-name'),
  unit: document.getElementById('custom-preset-unit'),
  consumable: document.getElementById('custom-preset-consumable'),
  house: document.getElementById('custom-preset-house'),
  disaster: document.getElementById('custom-preset-disaster'),
  camping: document.getElementById('custom-preset-camping'),
  maintenance: document.getElementById('custom-preset-maintenance')
};
const customPresetSaveBtn = document.getElementById('custom-preset-save');
const presetTabButtons = document.querySelectorAll('[data-preset-tab]');
const presetPane = document.getElementById('preset-pane');
const customPresetPanel = document.getElementById('custom-preset-panel');
const formActions = document.getElementById('equip-form-actions');
let presetTabState = 'preset';

function updateOriginalPaneVisibility(){
  const pane = document.getElementById('original-pane');
  const trackedFields = document.getElementById('tracked-fields');
  const trackedToggle = document.getElementById('f-tracked');
  if (!pane) return;
  const shouldShow = !!(editingId || (selectedPreset && selectedPreset._id));
  pane.classList.toggle('hidden', !shouldShow);
  formActions?.classList.toggle('hidden', !shouldShow);
  if (trackedFields && trackedToggle) {
    trackedFields.classList.toggle('hidden', !trackedToggle.checked);
  }
}

function resetCustomPresetForm(){
  Object.values(customPresetInputs).forEach(el=>{
    if (!el) return;
    if (el.type === 'checkbox') el.checked = false;
    else el.value = '';
  });
  updateOriginalPaneVisibility();
}

function getPresetCategory(item){
  if (!item) return '';
  return item.classification || item.houseCategory || item.disasterCategory || item.campingCategory || '';
}

function getCurrentCategory(){
  return (houseInputEl?.value.trim() || disasterInputEl?.value.trim() || campingInputEl?.value.trim() || '');
}

function setTargetInfo(name, category){
  const hasName = !!(name && name.trim());
  if (equipTargetBox){
    equipTargetBox.classList.toggle('hidden', !hasName);
  }
  if (equipTargetName) equipTargetName.textContent = hasName ? `対象: ${name}` : '';
  if (equipTargetCategory){
    equipTargetCategory.textContent = category || '';
    equipTargetCategory.classList.toggle('hidden', !category);
  }
}
let manualImageOverride = false;

function togglePresetControls(show){
  const method = show ? 'remove' : 'add';
  presetSection?.classList[method]('hidden');
  if (!show) resetCustomPresetForm();
}

function setPresetTab(tab){
  presetTabState = tab;
  const isPresetTab = tab === 'preset';
  presetPane?.classList.toggle('hidden', !isPresetTab);
  customPresetPanel?.classList.toggle('hidden', isPresetTab);
  if (isPresetTab) {
    resetCustomPresetForm();
  } else {
    selectedPreset = null;
    if (nameInputEl) nameInputEl.value = '';
    if (unitInputEl) unitInputEl.value = '';
    if (consumableInputEl) consumableInputEl.checked = false;
    if (houseInputEl) houseInputEl.value = '';
    if (disasterInputEl) disasterInputEl.value = '';
    if (campingInputEl) campingInputEl.value = '';
    const maintenanceInputEl = document.getElementById('f-maintenance');
    if (maintenanceInputEl) maintenanceInputEl.value = '';
    renderSelectedPresetTag();
    updatePresetButtons();
    setTargetInfo('', '');
  }
  presetTabButtons.forEach(btn=>{
    const active = btn.dataset.presetTab === tab;
    btn.classList.toggle('bg-white', active);
    btn.classList.toggle('shadow', active);
    btn.classList.toggle('text-gray-900', active);
    btn.classList.toggle('text-gray-600', !active);
  });
}
setPresetTab('preset');

presetTabButtons.forEach(btn=>{
  btn.addEventListener('click', ()=> setPresetTab(btn.dataset.presetTab));
});
function updateEquipImagePreview(url, fallback, opts = {}){
  if (equipImageUrlText) equipImageUrlText.textContent = url ? url : (fallback || '未取得');
  if (equipImagePreview) {
    if (url) {
      equipImagePreview.src = url;
      equipImagePreview.classList.remove('hidden');
    } else {
      equipImagePreview.src = '';
      equipImagePreview.classList.add('hidden');
    }
  }
  if (equipImagePlaceholder) equipImagePlaceholder.classList.toggle('hidden', !!url);
  if (manualImageInputEl && (!manualImageOverride || opts.forceManualSync)) {
    manualImageInputEl.value = url || '';
  }
}

async function fetchEquipImage(value, runId){
  if (manualImageOverride) return;
  try{
    const res = await fetch('/users/my-stock/api/product-image?url=' + encodeURIComponent(value));
    if (!res.ok) throw new Error('failed');
    const data = await res.json();
    if (runId !== equipImageFetchId) return;
    if (data && data.imageUrl){
      updateEquipImagePreview(data.imageUrl);
    } else {
      updateEquipImagePreview('', '取得できませんでした');
    }
  } catch(_) {
    if (runId !== equipImageFetchId) return;
    updateEquipImagePreview('', '取得に失敗しました');
  }
}

function scheduleEquipImageFetch(value){
  if (manualImageOverride) return;
  equipImageFetchId += 1;
  const runId = equipImageFetchId;
  clearTimeout(equipImageFetchTimer);
  if (!value){
    updateEquipImagePreview('', '未取得');
    return;
  }
  if (equipImageUrlText) equipImageUrlText.textContent = '読み込み中…';
  equipImageFetchTimer = setTimeout(()=> fetchEquipImage(value, runId), 400);
}

function primeEquipImagePreview(productUrl, imageUrl){
  const prodVal = String(productUrl || '').trim();
  if (productUrlInputEl) productUrlInputEl.value = prodVal;
  const imgVal = String(imageUrl || '').trim();
  manualImageOverride = !!imgVal;
  if (manualImageInputEl) manualImageInputEl.value = imgVal;
  if (imgVal){
    updateEquipImagePreview(imgVal, null, { forceManualSync: true });
  } else {
    manualImageOverride = false;
    updateEquipImagePreview('', '未取得', { forceManualSync: true });
    scheduleEquipImageFetch(prodVal);
  }
}

if (productUrlInputEl){
  productUrlInputEl.addEventListener('input', ()=>{
    if (!manualImageOverride){
      scheduleEquipImageFetch(productUrlInputEl.value.trim());
    }
  });
}

if (manualImageInputEl){
  manualImageInputEl.addEventListener('input', ()=>{
    const val = manualImageInputEl.value.trim();
    manualImageOverride = !!val;
    if (val){
      updateEquipImagePreview(val, null, { forceManualSync: true });
    } else {
      manualImageOverride = false;
      updateEquipImagePreview('', '未取得', { forceManualSync: true });
      scheduleEquipImageFetch(productUrlInputEl ? productUrlInputEl.value.trim() : '');
    }
  });
}

if (customPresetSaveBtn){
  customPresetSaveBtn.addEventListener('click', async ()=>{
    const payload = {
      name: customPresetInputs.name?.value.trim() || '',
      unit: customPresetInputs.unit?.value.trim() || '',
      isConsumable: !!customPresetInputs.consumable?.checked,
      houseCategory: customPresetInputs.house?.value.trim() || '',
      disasterCategory: customPresetInputs.disaster?.value.trim() || '',
      campingCategory: customPresetInputs.camping?.value.trim() || '',
      maintenance: customPresetInputs.maintenance?.value.trim() || ''
    };
    if (!payload.name){
      alert('備品名を入力してください');
      customPresetInputs.name?.focus();
      return;
    }
    try{
      const res = await fetch('/users/my-equipment/api/custom-presets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error();
      const created = await res.json();
      selectPreset(created);
      updatePresetButtons();
      renderSelectedPresetTag();
      setTargetInfo(created.name || '', getPresetCategory(created));
      searchPresets();
      alert('オリジナル備品を登録しました');
    } catch(_){
      alert('オリジナル備品の登録に失敗しました');
    }
  });
}

function renderSelectedPresetTag(){
  const box = document.querySelector('[data-role="selected"]');
  if (!box) return;
  box.innerHTML = '';
  if (selectedPreset && selectedPreset._id){
    const allowBadge = !presetSection?.classList.contains('hidden');
    box.classList.remove('hidden');
    const wrap = document.createElement('div');
    wrap.className = 'flex items-center gap-2 text-sm';
    const pill = document.createElement('span');
    pill.className = 'px-3 py-1 rounded-full bg-emerald-50 text-emerald-700';
    pill.textContent = selectedPreset.name || 'プリセット選択済み';
    const clearBtn = document.createElement('button');
    clearBtn.type = 'button';
    clearBtn.className = 'text-xs text-gray-500 underline';
    clearBtn.textContent = 'クリア';
    clearBtn.addEventListener('click', clearSelectedPreset);
    wrap.appendChild(pill);
    wrap.appendChild(clearBtn);
    if (allowBadge){
      box.appendChild(wrap);
    } else {
      box.classList.add('hidden');
    }
    setTargetInfo(selectedPreset.name || '', selectedPreset.category || '');
  } else {
    box.classList.add('hidden');
    setTargetInfo(nameInputEl?.value.trim() || '', getCurrentCategory());
  }
  updateOriginalPaneVisibility();
}

function clearSelectedPreset(){
  selectedPreset = null;
  renderSelectedPresetTag();
  updatePresetButtons();
  updateOriginalPaneVisibility();
}

renderSelectedPresetTag();
setTargetInfo('', '');

[nameInputEl, houseInputEl, disasterInputEl, campingInputEl].forEach(el=>{
  if (!el) return;
  el.addEventListener('input', ()=>{
    if (!selectedPreset){
      setTargetInfo(nameInputEl?.value.trim() || '', getCurrentCategory());
    }
  });
});
const trackedToggle = document.getElementById('f-tracked');
if (trackedToggle) {
  trackedToggle.addEventListener('change', updateOriginalPaneVisibility);
}

function openAddModal(placeName){
  editingId = null; selectedPreset = null;
  document.getElementById('equip-modal-title').textContent = '備品の追加';
  togglePresetControls(true);
  resetForm();
  loadPlaces();
  searchPresets();
  renderSelectedPresetTag();
  updatePresetButtons();
  if (placeName) {
    const field = document.getElementById('f-place-name');
    if (field) field.value = placeName;
  }
  primeEquipImagePreview('', '');
  setTargetInfo('', '');
  updateOriginalPaneVisibility();
  const dlg = document.getElementById('equip-modal'); dlg.showModal();
}
function openEdit(data){
  editingId = data.id; selectedPreset = null;
  document.getElementById('equip-modal-title').textContent = '備品の編集';
  togglePresetControls(false);
  // fill
  document.getElementById('f-name').value = data.name||'';
  document.getElementById('f-qty').value = data.quantity||0;
  document.getElementById('f-unit').value = data.unit||'';
  // set place name from id
  try{
    const p = (MYEQ_PLACES||[]).find(x=> String(x._id) === String(data.placeId||''));
    document.getElementById('f-place-name').value = p ? (p.name || '') : '';
  }catch(_){ document.getElementById('f-place-name').value=''; }
  document.getElementById('f-consumable').checked = !!data.isConsumable;
  if (ownerSelectEl) {
    ownerSelectEl.value = 'all';
    const hasOwnerOption = Array.from(ownerSelectEl.options || []).some(opt => String(opt.value) === String(data.ownerId || ''));
    if (hasOwnerOption && data.ownerId) {
      ownerSelectEl.value = data.ownerId;
    }
  }
  document.getElementById('f-tracked').checked = !!data.tracked;
  document.getElementById('f-last-count').value = data.lastCount || 0;
  document.getElementById('f-last-comment').value = data.lastComment || '';
  document.getElementById('f-house').value = data.houseCategory||'';
  document.getElementById('f-disaster').value = data.disasterCategory||'';
  document.getElementById('f-camping').value = data.campingCategory||'';
  document.getElementById('f-maintenance').value = data.maintenance||'';
  document.getElementById('f-url').value = data.productUrl||'';
  document.getElementById('f-image-url').value = data.productImageUrl || '';
  document.getElementById('f-comment').value = data.comment||'';
  document.getElementById('f-expiry').value = data.expiryDate ? new Date(data.expiryDate).toISOString().slice(0,10) : '';
  loadPlaces();
  const category = data.houseCategory || data.disasterCategory || data.campingCategory || '';
  selectedPreset = null;
  renderSelectedPresetTag();
  updatePresetButtons();
  primeEquipImagePreview(data.productUrl || '', data.productImageUrl || '');
  setTargetInfo(data.name || '', category);
  updateOriginalPaneVisibility();
  const dlg = document.getElementById('equip-modal'); dlg.showModal();
  if (window.refreshLucideIcons) window.refreshLucideIcons();
}
function closeEquipModal(){ document.getElementById('equip-modal').close(); }
async function loadPlaces(){
  try{
    const res = await fetch('/users/my-equipment/api/places');
    const list = await res.json();
    const dl = document.getElementById('opt-place');
    dl.innerHTML = '';
    list.forEach(p=>{
      const o = document.createElement('option'); o.value = p.name; dl.appendChild(o);
    });
  }catch(_){ }
}
function resetForm(){
  ['f-name','f-qty','f-unit','f-place-name','f-house','f-disaster','f-camping','f-maintenance','f-url','f-image-url','f-expiry','f-comment','f-last-comment'].forEach(id=>{
    const el = document.getElementById(id); if (el) el.value = '';
  });
  if (ownerSelectEl) ownerSelectEl.value = 'all';
  document.getElementById('f-tracked').checked = false;
  document.getElementById('f-last-count').value = 0;
  document.getElementById('f-consumable').checked = false;
  document.getElementById('preset-results').innerHTML='';
  selectedPreset = null;
  manualImageOverride = false;
  renderSelectedPresetTag();
  setTargetInfo('', '');
  resetCustomPresetForm();
  updateOriginalPaneVisibility();
}

let _presetTimer = null;
async function searchPresets(){
  const qs = new URLSearchParams();
  const k = document.getElementById('q-keyword').value.trim(); if(k) qs.set('keyword', k);
  const h = document.getElementById('q-house').value.trim(); if(h) qs.set('houseCategory', h);
  const d = document.getElementById('q-disaster').value.trim(); if(d) qs.set('disasterCategory', d);
  const c = document.getElementById('q-camping').value.trim(); if(c) qs.set('campingCategory', c);
  const res = await fetch('/users/my-equipment/api/presets?'+qs.toString());
  const list = await res.json();
  const box = document.getElementById('preset-results'); box.innerHTML='';
  list.forEach(e=>{
    const wrap = document.createElement('span');
    wrap.className = 'rounded px-1.5 py-1 bg-green-50';
    const b = document.createElement('button');
    b.type='button';
    b.dataset.id = e._id;
    const isSel = selectedPreset && String(selectedPreset._id) === String(e._id);
    b.className = 'px-3 py-1.5 text-sm rounded-full ' + (isSel ? 'bg-black text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200');
    b.textContent = e.name;
    b.onclick = ()=> { selectPreset(e); updatePresetButtons(); };
    wrap.appendChild(b);
    box.appendChild(wrap);
  });
  updatePresetButtons();
  renderSelectedPresetTag();
}
['q-keyword','q-house','q-disaster','q-camping'].forEach(id=>{
  const el = document.getElementById(id);
  el.addEventListener('input', ()=>{ clearTimeout(_presetTimer); _presetTimer = setTimeout(searchPresets, 200); });
});
document.getElementById('preset-clear').addEventListener('click', ()=>{
  ['q-keyword','q-house','q-disaster','q-camping'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  selectedPreset = null; updatePresetButtons?.(); searchPresets();
});

const GUIDE_KEY_EQUIP = 'myequipment:guide:hidden';
function applyEquipGuide(hidden){
  if (!equipGuideWrapper) return;
  equipGuideWrapper.classList.toggle('hidden', hidden);
  try { localStorage.setItem(GUIDE_KEY_EQUIP, hidden ? '1' : '0'); } catch(_){}
}
try {
  const saved = localStorage.getItem(GUIDE_KEY_EQUIP);
  if (saved === '1') applyEquipGuide(true);
} catch(_) {}
equipGuideHide?.addEventListener('click', ()=> applyEquipGuide(true));
equipGuideShow?.addEventListener('click', ()=> applyEquipGuide(false));

function selectPreset(e){
  selectedPreset = { ...e, category: getPresetCategory(e) };
  document.getElementById('f-name').value = e.name||'';
  document.getElementById('f-unit').value = e.unit||'';
  document.getElementById('f-consumable').checked = !!e.isConsumable;
  document.getElementById('f-house').value = e.houseCategory||'';
  document.getElementById('f-disaster').value = e.disasterCategory||'';
  document.getElementById('f-camping').value = e.campingCategory||'';
  document.getElementById('f-maintenance').value = e.maintenance||'';
  renderSelectedPresetTag();
  setTargetInfo(e.name || '', selectedPreset.category || '');
  updateOriginalPaneVisibility();
}

function updatePresetButtons(){
  const box = document.getElementById('preset-results');
  if (!box) return;
  Array.from(box.querySelectorAll('button')).forEach(btn => {
    const id = btn.dataset.id;
    const isSel = selectedPreset && String(selectedPreset._id) === String(id);
    btn.className = 'px-3 py-1.5 text-sm rounded-full ' + (isSel ? 'bg-black text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200');
  });
}

async function submitEquipForm(){
  const payload = {
    equipmentId: selectedPreset? selectedPreset._id : null,
    name: document.getElementById('f-name').value.trim(),
    quantity: Number(document.getElementById('f-qty').value || 0),
    unit: document.getElementById('f-unit').value.trim(),
    placeName: document.getElementById('f-place-name').value.trim(),
    isConsumable: document.getElementById('f-consumable').checked,
    tracked: document.getElementById('f-tracked').checked,
    lastCount: Number(document.getElementById('f-last-count').value || 0),
    lastComment: document.getElementById('f-last-comment').value.trim(),
    houseCategory: document.getElementById('f-house').value.trim(),
    disasterCategory: document.getElementById('f-disaster').value.trim(),
    campingCategory: document.getElementById('f-camping').value.trim(),
    maintenance: document.getElementById('f-maintenance').value.trim(),
    comment: document.getElementById('f-comment').value.trim(),
    productUrl: document.getElementById('f-url').value.trim(),
    productImageUrl: document.getElementById('f-image-url').value.trim(),
    expiryDate: document.getElementById('f-expiry').value || null,
    owner: ownerSelectEl ? ownerSelectEl.value : 'all'
  };
  if (!payload.name){ alert('備品名は必須です'); return; }
  try{
    if (editingId){
      const res = await fetch('/users/my-equipment/api/'+editingId, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if (!res.ok) throw new Error();
    } else {
      const res = await fetch('/users/my-equipment/api/add', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
      if (!res.ok) throw new Error();
    }
    window.location.reload();
  }catch(_){ alert('保存に失敗しました'); }
}

async function removeItem(id){
  if (!confirm('削除しますか？')) return;
  try{
    const res = await fetch('/users/my-equipment/api/'+id, { method: 'DELETE' });
    if (!res.ok) throw new Error();
    window.location.reload();
  }catch(_){ alert('削除に失敗しました'); }
}
</script>
