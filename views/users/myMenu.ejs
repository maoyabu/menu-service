<%
  const sc = (mymenuStats && mymenuStats.sharedCount) || 0;
  const uc = (mymenuStats && mymenuStats.urlCount) || 0;
  const oc = (mymenuStats && mymenuStats.originalCount) || 0;
%>

<section class="max-w-6xl mx-auto space-y-8">
  <header>
    <div class="flex items-center gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-amber-900">
      <span class="lucide w-5 h-5" data-lucide="utensils"></span>
      <h1 class="text-xl font-extrabold">マイメニュー</h1>
      <span class="text-sm">レシピコレクションを編集して、自分にぴったりな7 DAYS PLANを提案してもらおう！</span>
    </div>
  </header>

  <div>
    <a href="/users/my-menu/mine" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-blue-600 text-blue-700 hover:bg-blue-50 text-sm font-semibold">
      <span class="lucide w-4 h-4" data-lucide="list"></span>
      あなたのレシピコレクションを見る
    </a>
  </div>

  <!-- Counters -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="rounded-2xl border bg-gradient-to-br from-blue-50 to-white p-5">
      <p class="text-3xl font-extrabold text-blue-600"><%= sc %></p>
      <p class="text-sm text-blue-700/80">共有メニュー</p>
    </div>
    <div class="rounded-2xl border bg-gradient-to-br from-emerald-50 to-white p-5">
      <p class="text-3xl font-extrabold text-emerald-600"><%= uc %></p>
      <p class="text-sm text-emerald-700/80">レシピサイト</p>
    </div>
    <div class="rounded-2xl border bg-gradient-to-br from-purple-50 to-white p-5">
      <p class="text-3xl font-extrabold text-purple-600"><%= oc %></p>
      <p class="text-sm text-purple-700/80">オリジナル</p>
    </div>
  </div>

  <!-- Three columns: shared, url, original -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Shared -->
    <section class="rounded-2xl border border-blue-200 bg-white p-5 space-y-3 flex flex-col">
      <div class="flex items-center gap-2 text-blue-700">
        <span class="lucide w-5 h-5" data-lucide="search"></span>
        <h2 class="font-semibold">共有メニューから登録</h2>
      </div>
      <p class="text-xs text-gray-500">みんなが登録したメニューからマイメニューに</p>
      <p class="text-xs text-gray-500">登録済み（<%= sc %>件）</p>
      <div class="flex-1">
      <div class="grid grid-cols-2 gap-3 min-h-[140px]">
        <% (mySharedSamples || []).forEach(function(mm){ const m = mm.menu || {}; %>
          <div class="overflow-hidden rounded-xl border">
            <div class="h-24 bg-gray-100">
              <% if (m.imageUrl) { %>
                <img src="<%= m.imageUrl %>" alt="<%= m.name %>" class="w-full h-full object-cover" />
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
              <% } %>
            </div>
            <div class="p-2 space-y-1">
              <span class="inline-flex self-start text-[13px] px-2 py-0.5 rounded bg-blue-50 text-blue-700">共有メニュー</span>
              <div class="text-sm font-semibold truncate" title="<%= m.name %>"><%= m.name %></div>
            </div>
          </div>
        <% }) %>
      </div>
      </div>
      <a href="/users/my-menu/shared-register" class="mt-auto inline-flex items-center justify-between gap-2 w-full px-3 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold">
        <span class="inline-flex items-center gap-1"><span class="lucide w-4 h-4" data-lucide="plus"></span> メニューを検索</span>
        <span class="lucide w-4 h-4" data-lucide="chevron-right"></span>
      </a>
    </section>

    <!-- From URL -->
    <section class="rounded-2xl border border-emerald-200 bg-white p-5 space-y-3 flex flex-col">
      <div class="flex items-center gap-2 text-emerald-700">
        <span class="lucide w-5 h-5" data-lucide="link"></span>
        <h2 class="font-semibold">レシピサイトから登録</h2>
      </div>
      <p class="text-xs text-gray-500">お気に入りのレシピサイトをマイメニュー</p>
      <p class="text-xs text-gray-500">登録済み（<%= uc %>件）</p>
      <div class="flex-1">
      <div class="grid grid-cols-2 gap-3 min-h-[140px]">
        <% (myUrlSamples || []).forEach(function(mm){ const m = mm.menu || {}; %>
          <div class="overflow-hidden rounded-xl border">
            <div class="h-24 bg-gray-100">
              <% if (m.imageUrl) { %>
                <img src="<%= m.imageUrl %>" alt="<%= m.name %>" class="w-full h-full object-cover" />
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
              <% } %>
            </div>
            <div class="p-2 space-y-1">
              <span class="inline-flex self-start text-[13px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700">レシピサイト</span>
              <div class="text-sm font-semibold truncate" title="<%= m.name %>"><%= m.name %></div>
            </div>
          </div>
        <% }) %>
      </div>
      </div>
      <a href="/users/my-menu/from-url" class="mt-auto inline-flex items-center justify-between gap-2 w-full px-3 py-2 rounded-lg bg-emerald-600 text-white text-sm font-semibold">
        <span class="inline-flex items-center gap-1"><span class="lucide w-4 h-4" data-lucide="plus"></span> URLを登録</span>
        <span class="lucide w-4 h-4" data-lucide="chevron-right"></span>
      </a>
    </section>

    <!-- Original -->
    <section class="rounded-2xl border border-purple-200 bg-white p-5 space-y-3 flex flex-col">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-purple-700">
          <span class="lucide w-5 h-5" data-lucide="sparkles"></span>
          <h2 class="font-semibold">オリジナルレシピ</h2>
        </div>
        <a href="/users/my-menu/original-list" class="inline-flex items-center gap-1 rounded px-3 py-1.5 text-sm bg-purple-600 text-white hover:bg-purple-700">一覧</a>
      </div>
      <p class="text-xs text-gray-500">自分オリジナルのメニューをマイメニューに</p>
      <p class="text-xs text-gray-500">登録済み（<%= oc %>件）</p>
      <div class="flex-1">
      <div class="grid grid-cols-2 gap-3 min-h-[140px]">
        <% (myOriginalSamples || []).forEach(function(mm){ const m = mm.menu || {}; %>
          <div class="overflow-hidden rounded-xl border">
            <div class="h-24 bg-gray-100">
              <% if (m.imageUrl) { %>
                <img src="<%= m.imageUrl %>" alt="<%= m.name %>" class="w-full h-full object-cover" />
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
              <% } %>
            </div>
            <div class="p-2 space-y-1">
              <span class="inline-flex self-start text-[13px] px-2 py-0.5 rounded bg-purple-50 text-purple-700">オリジナル</span>
              <div class="text-sm font-semibold truncate" title="<%= m.name %>"><%= m.name %></div>
            </div>
          </div>
        <% }) %>
      </div>
      </div>
      <a href="/users/my-menu/original" class="mt-auto inline-flex items-center justify-between gap-2 w-full px-3 py-2 rounded-lg bg-purple-700 text-white text-sm font-semibold">
        <span class="inline-flex items-center gap-1"><span class="lucide w-4 h-4" data-lucide="plus"></span> レシピを作成</span>
        <span class="lucide w-4 h-4" data-lucide="chevron-right"></span>
      </a>
    </section>
  </div>

  <!-- Group members -->
  <section class="rounded-2xl border border-amber-300 bg-amber-50 p-5 space-y-4">
    <div class="flex items-center gap-2 text-amber-700">
      <span class="lucide w-5 h-5" data-lucide="users"></span>
      <h2 class="font-semibold">グループメンバーのマイメニュー</h2>
    </div>
    <p class="text-xs text-amber-800">グループメンバーの好きなメニューを知ろう！</p>
    <form id="groupFilter" method="get" class="bg-white border rounded-xl p-3 grid grid-cols-1 md:grid-cols-5 gap-2 text-sm">
      <select name="g_kind" id="gf_kind" class="border rounded-lg px-3 py-2">
        <option value="">種類（すべて）</option>
        <% (groupFacets && Array.isArray(groupFacets.kinds) ? groupFacets.kinds : []).forEach(function(k){ %>
          <option value="<%= k %>" <%= (groupSelected && groupSelected.kind===k) ? 'selected' : '' %>><%= k %></option>
        <% }) %>
      </select>
      <select name="g_junle" id="gf_junle" class="border rounded-lg px-3 py-2">
        <option value="">ジャンル（すべて）</option>
        <% (groupFacets && Array.isArray(groupFacets.junles) ? groupFacets.junles : []).forEach(function(j){ %>
          <option value="<%= j %>" <%= (groupSelected && groupSelected.junle===j) ? 'selected' : '' %>><%= j %></option>
        <% }) %>
      </select>
      <select name="g_cook" id="gf_cook" class="border rounded-lg px-3 py-2">
        <option value="">調理方法（すべて）</option>
        <% (groupFacets && Array.isArray(groupFacets.cooks) ? groupFacets.cooks : []).forEach(function(c){ %>
          <option value="<%= c %>" <%= (groupSelected && groupSelected.cook===c) ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
      <select name="g_member" id="gf_member" class="border rounded-lg px-3 py-2">
        <option value="">メンバー（すべて）</option>
        <% (groupFacets && Array.isArray(groupFacets.members) ? groupFacets.members : []).forEach(function(m){ %>
          <option value="<%= m.id %>" <%= (groupSelected && groupSelected.member===String(m.id)) ? 'selected' : '' %>><%= m.name || 'メンバー' %></option>
        <% }) %>
      </select>
      <div class="md:col-span-1 flex items-end justify-end">
        <button type="button" id="groupFilterClear" class="px-4 py-2 rounded-lg border font-semibold">クリア</button>
      </div>
    </form>

    <div class="text-xs text-amber-800"> <%= (groupMemberItems || []).length %>件のメニュー</div>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <% (groupMemberItems || []).forEach(function(mm){ const m = mm.menu || {}; const owner = (mm.user?.displayname || mm.user?.username || ''); %>
        <div class="bg-white border rounded-xl overflow-hidden relative">
          <div class="h-28 bg-gray-100">
            <% if (m.imageUrl) { %>
              <img src="<%= m.imageUrl %>" alt="<%= m.name %>" class="w-full h-full object-cover" />
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
            <% } %>
            <% if (m.kind) { %>
              <span class="absolute top-2 left-2 text-[10px] bg-white/90 text-gray-700 rounded px-2 py-0.5"><%= m.kind %></span>
            <% } %>
          </div>
          <div class="p-2">
            <p class="text-sm font-semibold truncate" title="<%= m.name %>"><%= m.name %></p>
            <p class="text-xs text-gray-500 truncate">by <%= owner %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
</section>

<script>
  window.myTopData = {};
  window.refreshLucideIcons && window.refreshLucideIcons();
  (function(){
    const form = document.getElementById('groupFilter'); if(!form) return;
    const k = document.getElementById('gf_kind');
    const j = document.getElementById('gf_junle');
    const c = document.getElementById('gf_cook');
    const m = document.getElementById('gf_member');
    const apply = ()=>{
      const sp = new URLSearchParams();
      if (k.value) sp.set('g_kind', k.value);
      if (j.value) sp.set('g_junle', j.value);
      if (c.value) sp.set('g_cook', c.value);
      if (m.value) sp.set('g_member', m.value);
      const url = form.getAttribute('action') || window.location.pathname;
      const qs = sp.toString();
      window.location.href = url + (qs ? ('?' + qs) : '');
    };
    [k,j,c,m].forEach(el=> el.addEventListener('change', apply));
    document.getElementById('groupFilterClear').addEventListener('click', ()=>{ k.value=''; j.value=''; c.value=''; m.value=''; apply(); });
  })();
</script>
