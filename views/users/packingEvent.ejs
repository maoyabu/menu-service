<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="space-y-2">
    <div class="text-xs text-gray-500 flex items-center gap-1">
      <a href="/users/packing" class="text-blue-600 hover:underline">トップ</a>
      <span>＞</span>
      <span class="text-gray-800"><%= event.name || '' %> のパッキングプラン</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold"><%= event.name || '' %> のパッキングプラン</h1>
        <p class="text-sm text-gray-600">このイベントで使用する収納に持ち物を入れてチェックできます</p>
        <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
          <span>参加メンバー:</span>
          <% const participantLabels = (event.participants || []).map((id)=> (memberNameById.get(id) || '')).filter(Boolean); %>
          <% if (participantLabels.length) { %>
            <% participantLabels.forEach((name)=> { %>
              <span class="inline-flex items-center px-2 py-1 rounded-full bg-blue-50 text-blue-800 border border-blue-100"><%= name %></span>
            <% }) %>
          <% } else { %>
            <span class="text-gray-400">未設定</span>
          <% } %>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/users/packing/shop/<%= event.id %>" class="px-3 py-1.5 rounded-lg bg-amber-50 text-amber-800 text-sm font-semibold border border-amber-200 hover:bg-amber-100">買い物リストへ</a>
        <a href="/users/packing/check/<%= event.id %>" class="px-3 py-1.5 rounded-lg bg-green-600 text-white text-sm font-semibold hover:bg-green-700">チェックリストへ</a>
      </div>
    </div>
    <% if (event.completed) { %>
      <div class="rounded-xl border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
        このイベントは完了済みです。復活は「完了イベント一覧」から行えます。
      </div>
    <% } %>
  </header>

  <section class="border rounded-2xl bg-white p-4 space-y-3">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-100">収納・持ち物タグ</span>
        <p class="text-xs text-gray-500">収納タグを選択して持ち物タグをクリックすると紐づきます</p>
      </div>
      <div class="flex gap-2">
        <button type="button" id="open-storage-modal" class="px-3 py-1.5 rounded-lg border text-sm bg-amber-50 text-amber-800 hover:bg-amber-100">収納を追加</button>
        <button type="button" id="open-item-modal" class="px-3 py-1.5 rounded-lg border text-sm bg-purple-50 text-purple-800 hover:bg-purple-100">持ち物を追加</button>
      </div>
    </div>
    <div class="space-y-2">
      <div class="text-xs text-gray-500">収納先</div>
      <div id="storage-tags" class="flex flex-wrap gap-2"></div>
      <div class="text-xs text-gray-500">未使用</div>
      <div id="storage-unused" class="flex flex-wrap gap-2"></div>
      <% if (!(storages||[]).length) { %>
        <p class="text-xs text-gray-500">収納がありません。追加してください。</p>
      <% } %>
    </div>
    <div class="space-y-2">
      <div class="text-xs text-gray-500">持ち物</div>
      <div id="owner-filter" class="flex flex-wrap gap-2 text-xs">
        <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
          <input type="checkbox" value="all" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
          <span>共有</span>
        </label>
        <% (members || []).forEach((m)=> { %>
          <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
            <input type="checkbox" value="<%= m.id %>" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
            <span><%= m.name %></span>
          </label>
        <% }) %>
      </div>
      <div class="space-y-2" id="item-pool"></div>
      <p class="text-xs text-gray-500" id="pool-empty">持ち物がありません。追加してください。</p>
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-gray-600">
          <span>買い物リスト</span>
          <span class="text-[11px] text-gray-400">収納には入れられません</span>
        </div>
        <div id="wish-list" class="flex flex-wrap gap-2"></div>
        <p class="text-xs text-gray-500" id="wish-empty">買い物リストは空です。持ち物編集で買い物をONにできます。</p>
      </div>
    </div>
    <div class="space-y-2">
      <div class="text-xs text-gray-500">マスター持ち物（クリックでプールに追加）</div>
      <div id="master-pool" class="flex flex-wrap gap-2"></div>
    </div>
  </section>

  <section class="border rounded-2xl bg-white p-4 space-y-3">
    <div class="flex items-center gap-2">
      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-50 text-green-700 border border-green-100">収納先別の持ち物</span>
      <p class="text-xs text-gray-500">タグをクリックして外すと持ち物プールに戻ります</p>
    </div>
    <div id="storage-lists" class="space-y-3"></div>
  </section>

  <section class="border rounded-2xl bg-white p-4 space-y-2">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700 border border-gray-200">イベント完了</span>
        <p class="text-xs text-gray-500 mt-1">完了するとイベント一覧に表示されなくなり、完了一覧から復活できます</p>
      </div>
      <button type="button" id="event-complete-open" class="px-4 py-2 rounded-lg text-sm font-semibold text-white bg-red-600 hover:bg-red-700 disabled:opacity-60 disabled:cursor-not-allowed" <%= event.completed ? 'disabled' : '' %>>
        <%= event.completed ? '完了済み' : 'イベントを完了' %>
      </button>
    </div>
  </section>
</section>

<!-- 収納追加モーダル -->
<div id="storage-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">収納を追加</h3>
      <button type="button" data-storage-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">収納名
      <input type="text" id="storage-modal-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: スーツケース" />
    </label>
    <label class="block text-sm">制限重量(g)
      <input type="number" min="0" id="storage-modal-max" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" value="0" />
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-storage-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="storage-modal-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">追加</button>
    </div>
  </div>
</div>
<datalist id="item-category-datalist"></datalist>

<!-- 持ち物追加モーダル -->
<div id="item-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">持ち物を追加</h3>
      <button type="button" data-item-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">持ち物名
      <input type="text" id="item-modal-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 着替え" />
    </label>
    <div class="grid sm:grid-cols-2 gap-2">
      <label class="block text-sm">誰のもの
        <select id="item-modal-owner" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
          <option value="all">共有</option>
          <% (members || []).forEach((m)=> { %>
            <option value="<%= m.id %>" <%= String(m.id) === String((user && user._id) || '') ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="block text-sm">数量
        <input type="number" step="1" min="0" id="item-modal-qty" value="1" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </label>
      <label class="block text-sm">重量(g)
        <input type="number" step="1" min="0" id="item-modal-weight" value="0" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </label>
    </div>
    <label class="block text-sm">カテゴリー
      <input type="text" list="item-category-datalist" id="item-modal-category" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 衣類 / 洗面・メイク / ガジェット" />
    </label>
    <label class="block text-sm">コメント
      <input type="text" id="item-modal-comment" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="メモ" />
    </label>
    <label class="inline-flex items-center gap-2 text-sm">
      <input type="checkbox" id="item-modal-wish" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
      <span>買い物リストに入れる（収納には入れられません）</span>
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-item-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="item-modal-save" class="px-4 py-2 rounded-lg bg-amber-600 text-white font-semibold hover:bg-amber-700">追加</button>
    </div>
  </div>
</div>

<!-- 完了確認モーダル -->
<div id="event-complete-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-24 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">イベントを完了しますか？</h3>
      <button type="button" data-complete-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <p class="text-sm text-gray-700">完了するとイベント一覧には表示されず、完了イベント一覧から復活できます。</p>
    <p class="text-sm font-semibold text-gray-900"><%= event.name || '' %></p>
    <div class="flex justify-end gap-2">
      <button type="button" data-complete-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="event-complete-confirm" class="px-4 py-2 rounded-lg bg-blue-700 text-white text-sm font-semibold hover:bg-blue-800">完了にする</button>
    </div>
  </div>
</div>

  <script>
    (function(){
      const eventId = <%- JSON.stringify(event.id || '') %>;
      const members = <%- JSON.stringify(members || []) %>;
      const currentUserId = <%- JSON.stringify((user && user._id) ? String(user._id) : '') %>;
      let eventCompleted = !!<%- JSON.stringify(event.completed || false) %>;
      const storages = <%- JSON.stringify(storages || []) %>;
      const selectedStorageIds = (<%- JSON.stringify(event.storageIds || []) %>).length ? <%- JSON.stringify(event.storageIds || []) %> : storages.map((s)=> s.id);
      const masterItems = <%- JSON.stringify(masterItems || []) %>;
      const memberMap = new Map((members||[]).map((m)=> [m.id, m.name]));
      const items = <%- JSON.stringify(items || []) %>;

    const storageTags = document.getElementById('storage-tags');
    const storageUnused = document.getElementById('storage-unused');
    const itemPool = document.getElementById('item-pool');
    const poolEmpty = document.getElementById('pool-empty');
    const wishList = document.getElementById('wish-list');
    const wishEmpty = document.getElementById('wish-empty');
    const storageLists = document.getElementById('storage-lists');
    const masterPool = document.getElementById('master-pool');
    const ownerFilter = document.getElementById('owner-filter');

    const storageModal = document.getElementById('storage-modal');
    const storageModalName = document.getElementById('storage-modal-name');
    const storageModalMax = document.getElementById('storage-modal-max');
    const storageModalSave = document.getElementById('storage-modal-save');
    const itemModal = document.getElementById('item-modal');
    const itemModalName = document.getElementById('item-modal-name');
    const itemModalOwner = document.getElementById('item-modal-owner');
    const itemModalQty = document.getElementById('item-modal-qty');
    const itemModalWeight = document.getElementById('item-modal-weight');
    const itemModalCategory = document.getElementById('item-modal-category');
    const itemModalComment = document.getElementById('item-modal-comment');
    const itemModalWish = document.getElementById('item-modal-wish');
    const itemModalSave = document.getElementById('item-modal-save');
    const itemCategoryDatalist = document.getElementById('item-category-datalist');
    const completeOpen = document.getElementById('event-complete-open');
    const completeModal = document.getElementById('event-complete-modal');
    const completeConfirm = document.getElementById('event-complete-confirm');
    let itemEditId = '';
    let categoryOptions = Array.from(new Set([...(masterItems||[]).map(m=> (m.category||'').trim()).filter(Boolean), ...(items||[]).map(i=> (i.category||'').trim()).filter(Boolean)])).filter(Boolean);

    let activeStorageId = selectedStorageIds[0] || '';
    const ACTIVE_STORAGE_KEY = `packing:event:${eventId}:activeStorage`;
    const OWNER_KEY = `packing:event:${eventId}:owners`;

    function toast(msg){ try{ const el=document.createElement('div'); el.textContent=msg; el.className='fixed bottom-4 right-4 bg-gray-900 text-white text-sm px-3 py-2 rounded shadow'; document.body.appendChild(el); setTimeout(()=> el.remove(),2000);}catch(_){alert(msg);} }

    function restoreActiveStorage(){
      try{
        const saved = localStorage.getItem(ACTIVE_STORAGE_KEY);
        if (saved && selectedStorageIds.includes(saved)) activeStorageId = saved;
      } catch(_) {}
    }
    function saveActiveStorage(id){
      try{ localStorage.setItem(ACTIVE_STORAGE_KEY, id || ''); }catch(_) {}
    }

    function restoreOwnerSelections(){
      if (!ownerFilter) return;
      try{
        const saved = JSON.parse(localStorage.getItem(OWNER_KEY) || '[]');
        if (Array.isArray(saved) && saved.length){
          ownerFilter.querySelectorAll('input[type="checkbox"]').forEach((cb)=>{
            cb.checked = saved.includes(cb.value);
          });
        }
      } catch(_) {}
    }
    function saveOwnerSelections(){
      if (!ownerFilter) return;
      try{
        const checked = Array.from(ownerFilter.querySelectorAll('input[type="checkbox"]:checked')).map(cb=> cb.value);
        localStorage.setItem(OWNER_KEY, JSON.stringify(checked));
      } catch(_) {}
    }

    function normalizeWishItems(){
      items.forEach((it)=>{
        if (it.wish && (it.storageId || it.storageName)){
          it.storageId = '';
          it.storageName = '';
        }
      });
    }

    async function saveEventStorages(newIds){
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ storageIds: newIds })
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        selectedStorageIds.splice(0, selectedStorageIds.length, ...(json.storageIds || []));
        if (activeStorageId && !selectedStorageIds.includes(activeStorageId)){
          activeStorageId = selectedStorageIds[0] || '';
        }
        renderStorages();
        renderStorageLists();
        renderItemPool();
        toast('収納の使用設定を更新しました');
      }catch(e){ toast(e.message || '更新に失敗しました'); }
    }

    function addStorageToEvent(id){
      if (!id) return;
      if (!selectedStorageIds.includes(id)) selectedStorageIds.push(id);
      saveEventStorages([...selectedStorageIds]);
    }
    function removeStorageFromEvent(id){
      const idx = selectedStorageIds.indexOf(id);
      if (idx >= 0) selectedStorageIds.splice(idx,1);
      saveEventStorages([...selectedStorageIds]);
    }

    function renderStorages(){
      if (!storageTags) return;
      storageTags.innerHTML = '';
      (storages||[]).forEach((s)=>{
        if (!selectedStorageIds.includes(s.id)) return;
        const btn = document.createElement('button');
        const active = s.id === activeStorageId;
        btn.type = 'button';
        btn.dataset.id = s.id;
        btn.className = 'px-3 py-1.5 rounded-full border text-sm flex items-center gap-1 ' + (active ? 'bg-blue-600 text-white border-blue-700 shadow' : 'bg-white text-gray-800 border-gray-300 hover:border-blue-300');
        btn.innerHTML = `<span>${s.name}</span><span data-remove="${s.id}" class="text-[11px] text-gray-200 ${active ? '' : 'text-gray-400'}">×</span>`;
        btn.addEventListener('click', (e)=>{
          if (e.target?.dataset?.remove){
            removeStorageFromEvent(s.id);
            e.stopPropagation();
            return;
          }
          activeStorageId = s.id;
          saveActiveStorage(activeStorageId);
          renderStorages();
          renderItemPool();
        });
        storageTags.appendChild(btn);
      });
      if (storageUnused){
        storageUnused.innerHTML = '';
        storages.forEach((s)=>{
          if (selectedStorageIds.includes(s.id)) return;
          const b = document.createElement('button');
          b.type='button';
          b.dataset.id = s.id;
          b.className='px-3 py-1 rounded-full border bg-gray-50 text-gray-700 text-xs hover:border-blue-300';
          b.textContent = `＋ ${s.name}`;
          b.addEventListener('click', ()=> addStorageToEvent(s.id));
          storageUnused.appendChild(b);
        });
      }
      if (!activeStorageId && selectedStorageIds[0]) activeStorageId = selectedStorageIds[0];
      saveActiveStorage(activeStorageId);
    }

    function renderCategoryOptions(){
      if (!itemCategoryDatalist) return;
      itemCategoryDatalist.innerHTML = '';
      categoryOptions = Array.from(new Set(categoryOptions.filter(Boolean)));
      categoryOptions.forEach(c=>{ const opt=document.createElement("option"); opt.value=c; itemCategoryDatalist.appendChild(opt); });
    }

    function openStorageModal(){
      if (storageModalName) storageModalName.value = '';
      if (storageModalMax) storageModalMax.value = 0;
      storageModal?.classList.remove('hidden'); storageModal?.classList.add('flex');
      storageModalName?.focus();
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function renderWishList(){
      if (!wishList) return;
      wishList.innerHTML = '';
      const checkedOwners = Array.from(ownerFilter?.querySelectorAll('input[type="checkbox"]:checked') || []).map(el=> el.value);
      const hasOwnerSelection = checkedOwners.length > 0;
      const list = items
        .filter((it)=> !!it.wish)
        .filter((it)=>{
          if (!hasOwnerSelection) return false;
          if (checkedOwners.includes('all') && it.owner === 'all') return true;
          return checkedOwners.includes(it.owner);
        });
      if (!list.length){
        wishEmpty?.classList.remove('hidden');
        return;
      }
      wishEmpty?.classList.add('hidden');
      const grouped = {};
      list.forEach((it)=>{
        const cat = (it.category || '').trim() || '未分類';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(it);
      });
      Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja')).forEach((cat)=>{
        const sec = document.createElement('div');
        sec.className = 'space-y-1';
        const title = document.createElement('div');
        title.className = 'text-[11px] text-gray-600';
        title.textContent = cat;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        grouped[cat].forEach((it)=>{
          const tag = document.createElement('div');
          tag.className='inline-flex items-center gap-1 px-3 py-1.5 rounded-full border bg-gray-100 text-gray-800 text-sm border-gray-300';
          tag.innerHTML = `
            <span class="text-[10px] font-semibold text-gray-600 bg-gray-200 px-1 rounded">買い物</span>
            <span class="font-semibold cursor-pointer" data-item-edit="${it.id}" title="クリックで編集">${it.name}</span>
            <button type="button" class="text-blue-600 hover:text-blue-800" data-item-edit="${it.id}" aria-label="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
            <button type="button" class="text-green-700 hover:text-green-900" data-item-clone="${it.id}" aria-label="複製"><i data-lucide="copy" class="w-4 h-4"></i></button>
            <button type="button" class="text-red-600 hover:text-red-800" data-item-del="${it.id}" aria-label="削除"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
          `;
          wrap.appendChild(tag);
        });
        sec.appendChild(title);
        sec.appendChild(wrap);
        wishList.appendChild(sec);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function renderItemPool(){
      if (!itemPool) return;
      normalizeWishItems();
      itemPool.innerHTML = '';
      const checkedOwners = Array.from(ownerFilter?.querySelectorAll('input[type=\"checkbox\"]:checked') || []).map(el=> el.value);
      const hasOwnerSelection = checkedOwners.length > 0;
      const unassigned = items.filter((it)=> !it.storageId && !it.wish).filter((it)=>{
        if (!hasOwnerSelection) return false;
        if (checkedOwners.includes('all') && it.owner === 'all') return true;
        return checkedOwners.includes(it.owner);
      });
      if (!unassigned.length){
        poolEmpty.classList.remove('hidden');
      } else {
        poolEmpty.classList.add('hidden');
      }
      const grouped = {};
      unassigned.forEach((it)=>{
        const cat = (it.category || '').trim() || '未分類';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(it);
      });
      const cats = Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja'));
      cats.forEach((cat)=>{
        const section = document.createElement('div');
        section.className = 'space-y-1';
        const title = document.createElement('div');
        title.className = 'text-xs font-semibold text-gray-700';
        title.textContent = cat;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        grouped[cat].forEach((it)=>{
          const tag = document.createElement('div');
          tag.className='inline-flex items-center gap-1 px-3 py-1 rounded-full border bg-white text-sm hover:border-blue-300';
          tag.innerHTML = `
            <span class="font-semibold text-gray-900 cursor-pointer" data-item-edit="${it.id}" title="クリックで編集">${it.name}</span>
            <button type="button" class="text-blue-600 hover:text-blue-800" data-item-edit="${it.id}" aria-label="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
            <button type="button" class="text-green-700 hover:text-green-900" data-item-clone="${it.id}" aria-label="複製"><i data-lucide="copy" class="w-4 h-4"></i></button>
            <button type="button" class="text-red-600 hover:text-red-800" data-item-del="${it.id}" aria-label="削除"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
            <button type="button" class="text-gray-400 hover:text-gray-600" data-item-assign="${it.id}" aria-label="収納に入れる"><i data-lucide="arrow-right" class="w-4 h-4"></i></button>
          `;
          wrap.appendChild(tag);
        });
        section.appendChild(title);
        section.appendChild(wrap);
        itemPool.appendChild(section);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
      renderWishList();
    }

    function renderMasterPool(){
      if (!masterPool) return;
      masterPool.innerHTML = '';
      const grouped = {};
      masterItems.forEach((it)=>{
        const cat = (it.category || '').trim() || '未分類';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(it);
      });
      const cats = Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja'));
      cats.forEach((cat)=>{
        const sec = document.createElement('div');
        sec.className = 'space-y-1';
        const title = document.createElement('div');
        title.className = 'text-xs text-gray-600';
        title.textContent = cat;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        grouped[cat].forEach((it)=>{
          const tag = document.createElement('button');
          tag.type='button';
          const isWish = !!it.wish;
          const baseClass = isWish ? 'bg-gray-200 border-gray-300 text-gray-800' : 'bg-gray-50 text-gray-800';
          tag.className=`px-3 py-1.5 rounded-full border text-sm hover:border-blue-300 ${baseClass}`;
          tag.innerHTML = isWish ? `<span class="text-[10px] font-semibold text-gray-700 bg-gray-300 px-1 rounded mr-1">買い物</span>${it.name}` : it.name;
          tag.addEventListener('click', ()=> addItemFromMaster(it));
          wrap.appendChild(tag);
        });
        sec.appendChild(title);
        sec.appendChild(wrap);
        masterPool.appendChild(sec);
      });
    }

    function renderStorageLists(){
      if (!storageLists) return;
      normalizeWishItems();
      storageLists.innerHTML = '';
      storages.forEach((s)=>{
        if (!selectedStorageIds.includes(s.id)) return;
        const list = items.filter((it)=> !it.wish && it.storageId === s.id);
        const totalWeight = list.reduce((sum, it)=> {
          const qty = Number(it.quantity || 0) || 1;
          const w = Number(it.weight || 0) || 0;
          return sum + (w * qty);
        }, 0);
        const max = Number(s.maxWeight || 0);
        const remain = max ? (max - totalWeight) : null;
        const remainClass = remain !== null && remain < 0 ? 'text-red-600 font-semibold' : 'text-gray-600';
        const remainLabel = remain === null ? '' : ` / 残り: ${remain} g`;
        const sec = document.createElement('section');
        sec.className = 'border rounded-lg px-3 py-2';
        sec.innerHTML = `<div class="flex items-center justify-between mb-2"><span class="font-semibold text-sm">${s.name}</span><span class="text-xs ${remainClass}">重量合計: ${totalWeight} g${max ? remainLabel : ''}</span></div>`;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        list.forEach((it)=>{
          const tag = document.createElement('button');
          tag.type='button';
          tag.className='px-3 py-1.5 rounded-full border bg-green-50 text-green-800 text-sm hover:border-green-300';
          tag.innerHTML = `${it.name} <span class="text-[11px] text-gray-500">${it.weight || 0}g</span> <span class="text-[11px] text-gray-500">(×)</span>`;
          tag.addEventListener('click', ()=> assignItemToStorage(it.id, ''));
          wrap.appendChild(tag);
        });
        if (!list.length){
          const empty = document.createElement('p');
          empty.className='text-xs text-gray-500';
          empty.textContent='まだ持ち物がありません。';
          wrap.appendChild(empty);
        }
        sec.appendChild(wrap);
        storageLists.appendChild(sec);
      });
    }

    async function assignItemToStorage(id, storageId){
      if (!id) return;
      const target = items.find((i)=> i.id === id);
      if (target?.wish && storageId){
        toast('買い物リストの持ち物は収納に入れられません');
        return;
      }
      if (storageId && !selectedStorageIds.includes(storageId)){
        toast('このイベントで使用しない収納先です');
        return;
      }
      try{
        const res = await fetch(`/users/packing/api/items/${encodeURIComponent(id)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ storageId })
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        const target = items.find((i)=> i.id === id);
        if (target){
          target.storageId = json.storageId;
          target.storageName = json.storageName || '';
        }
        renderItemPool();
        renderStorageLists();
      }catch(e){ toast(e.message || '更新に失敗しました'); }
    }

    async function addItemFromMaster(master){
      if (!master) return;
      const payload = {
        eventId,
        thingId: master.id,
        name: master.name,
        owner: master.owner || 'all',
        quantity: master.defaultQuantity || 1,
        category: master.category || '',
        comment: master.comment || '',
        storageId: '',
      };
      try{
        const res = await fetch('/users/packing/api/items', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('追加に失敗しました');
        const json = await res.json();
        items.push({ ...json, id: json.id.toString() });
        if (json.category && !categoryOptions.includes(json.category)) { categoryOptions.push(json.category); renderCategoryOptions(); }
        renderItemPool();
        renderStorageLists();
        toast('持ち物を追加しました');
      }catch(e){ toast(e.message || '追加に失敗しました'); }
    }

    function openModal(modalEl){
      modalEl?.classList.remove('hidden'); modalEl?.classList.add('flex');
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    function closeModal(modalEl){
      modalEl?.classList.add('hidden'); modalEl?.classList.remove('flex');
    }

    function openCompleteModal(){
      if (eventCompleted) return;
      completeModal?.classList.remove('hidden'); completeModal?.classList.add('flex');
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    function closeCompleteModal(){
      completeModal?.classList.add('hidden'); completeModal?.classList.remove('flex');
    }
    completeOpen?.addEventListener('click', openCompleteModal);
    completeModal?.addEventListener('click', (ev)=> { if (ev.target === completeModal) closeCompleteModal(); });
    completeModal?.querySelectorAll('[data-complete-close]')?.forEach((b)=> b.addEventListener('click', closeCompleteModal));
    completeConfirm?.addEventListener('click', async ()=>{
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ completed: true })
        });
        if (!res.ok) throw new Error('完了に失敗しました');
        eventCompleted = true;
        completeOpen?.setAttribute('disabled','true');
        completeOpen?.classList.add('opacity-60','cursor-not-allowed');
        closeCompleteModal();
        toast('イベントを完了しました');
        setTimeout(()=> { window.location.href = '/users/packing/completed'; }, 400);
      }catch(e){ toast(e.message || '完了に失敗しました'); }
    });

    document.getElementById('open-storage-modal')?.addEventListener('click', openStorageModal);
    document.getElementById('open-item-modal')?.addEventListener('click', ()=> openItemModal(null));
    storageModal?.addEventListener('click', (ev)=> { if (ev.target === storageModal) closeModal(storageModal); });
    itemModal?.addEventListener('click', (ev)=> { if (ev.target === itemModal) closeModal(itemModal); });
    storageModal?.querySelectorAll('[data-storage-close]')?.forEach((b)=> b.addEventListener('click', ()=> closeModal(storageModal)));
    itemModal?.querySelectorAll('[data-item-close]')?.forEach((b)=> b.addEventListener('click', ()=> { itemEditId=''; closeModal(itemModal); }));

    storageModalSave?.addEventListener('click', async ()=>{
      const name = (storageModalName?.value || '').trim();
      if (!name) return;
      try{
        const res = await fetch('/users/packing/api/storages', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ name, maxWeight: storageModalMax?.value || 0 }) });
        if (!res.ok) throw new Error('追加に失敗しました');
        const json = await res.json();
        storages.push({ id: json.id.toString(), name: json.name, maxWeight: json.maxWeight || 0 });
        storageModalName.value = ''; if (storageModalMax) storageModalMax.value = '0';
        closeModal(storageModal);
        if (!selectedStorageIds.includes(json.id.toString())) selectedStorageIds.push(json.id.toString());
        renderStorages();
        renderStorageLists();
        saveEventStorages([...selectedStorageIds]);
        toast('収納を追加しました');
      }catch(e){ toast(e.message || '追加に失敗しました'); }
    });

    function openItemModal(target, opts = {}){
      const mode = opts.mode || (target ? 'edit' : 'create');
      itemEditId = target && mode !== 'clone' ? target.id : '';
      itemModalName.value = target?.name || '';
      if (mode === 'clone'){
        itemModalOwner.value = currentUserId || 'all';
      } else {
        itemModalOwner.value = target?.owner || (currentUserId || 'all');
      }
      itemModalQty.value = target?.quantity || 0;
      itemModalWeight.value = target?.weight || 0;
      if (itemModalCategory) itemModalCategory.value = target?.category || '';
      itemModalComment.value = target?.comment || '';
      if (itemModalWish) itemModalWish.checked = !!target?.wish;
      openModal(itemModal);
      itemModalName?.focus();
    }

    itemModalSave?.addEventListener('click', async ()=>{
      const name = (itemModalName?.value || '').trim();
      if (!name) return;
      const payload = {
        name,
        owner: itemModalOwner?.value || 'all',
        quantity: itemModalQty?.value || 0,
        weight: itemModalWeight?.value || 0,
        category: itemModalCategory?.value || '',
        comment: itemModalComment?.value || '',
        eventId,
        storageId: '',
        thingId: '',
        wish: itemModalWish?.checked || false
      };
      try{
        let json;
        if (itemEditId){
          const res = await fetch(`/users/packing/api/items/${encodeURIComponent(itemEditId)}`, { method:'PATCH', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error('更新に失敗しました');
          json = await res.json();
          const target = items.find((i)=> i.id === itemEditId);
          if (target) Object.assign(target, { ...json, id: json.id.toString() });
        } else {
          const res = await fetch('/users/packing/api/items', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error('追加に失敗しました');
          json = await res.json();
          items.push({ ...json, id: json.id.toString() });
        }
        if (json.category && !categoryOptions.includes(json.category)) { categoryOptions.push(json.category); renderCategoryOptions(); }
        itemModalName.value=''; itemModalComment.value=''; itemModalQty.value='1'; itemModalOwner.value='all'; if (itemModalCategory) itemModalCategory.value=''; if (itemModalWish) itemModalWish.checked = false;
        itemEditId='';
        closeModal(itemModal);
        renderItemPool();
        renderStorageLists();
        toast('保存しました');
      }catch(e){ toast(e.message || '追加に失敗しました'); }
    });

    function handleItemActions(ev){
      const editBtn = ev.target.closest('button[data-item-edit]');
      const delBtn = ev.target.closest('button[data-item-del]');
      const assignBtn = ev.target.closest('button[data-item-assign]');
      const cloneBtn = ev.target.closest('button[data-item-clone]');
      const nameClick = ev.target.closest('span[data-item-edit]');
      if (editBtn || nameClick){
        const id = (editBtn || nameClick).dataset.itemEdit;
        const target = items.find((i)=> i.id === id);
        if (target) openItemModal(target);
      } else if (cloneBtn){
        const id = cloneBtn.dataset.itemClone;
        const target = items.find((i)=> i.id === id);
        if (!target) return;
        if (!confirm('この持ち物を複製しますか？')) return;
        openItemModal(target, { mode: 'clone' });
      } else if (delBtn){
        const id = delBtn.dataset.itemDel;
        if (!confirm('削除しますか？')) return;
        fetch(`/users/packing/api/items/${encodeURIComponent(id)}`, { method:'DELETE' })
          .then(res=> { if(!res.ok) throw new Error(); return res.json(); })
          .then(()=> {
            const idx = items.findIndex((i)=> i.id === id); if (idx>=0) items.splice(idx,1);
            renderItemPool(); renderStorageLists(); toast('削除しました');
          })
          .catch(()=> toast('削除に失敗しました'));
      } else if (assignBtn){
        const id = assignBtn.dataset.itemAssign;
        assignItemToStorage(id, activeStorageId);
      }
    }

    itemPool?.addEventListener('click', handleItemActions);
    wishList?.addEventListener('click', handleItemActions);

    ownerFilter?.addEventListener('change', ()=> { saveOwnerSelections(); renderItemPool(); });

    restoreActiveStorage();
    restoreOwnerSelections();
    renderStorages();
    renderCategoryOptions();
    renderItemPool();
    renderStorageLists();
  })();
</script>
