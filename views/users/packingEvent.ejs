<style>
  .toggle-pill {
    position: relative;
    width: 42px;
    height: 22px;
    border-radius: 9999px;
    border: 1px solid #fca5a5;
    background: #fff;
    transition: all 0.2s ease;
  }
  .toggle-pill .knob {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 0 0 1px #fca5a5;
    transition: all 0.2s ease;
  }
  .toggle-pill.is-on {
    background: #ef4444;
    border-color: #ef4444;
  }
  .toggle-pill.is-on .knob {
    transform: translateX(20px);
    box-shadow: 0 0 0 1px #ef4444;
  }
  .toggle-pill:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  #storage-modal,
  #item-modal,
  #event-name-modal,
  #event-participants-modal,
  #item-storage-modal,
  #event-complete-modal {
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  #storage-modal > div,
  #item-modal > div,
  #event-name-modal > div,
  #event-participants-modal > div,
  #item-storage-modal > div,
  #event-complete-modal > div {
    margin-top: 0;
    margin-bottom: 0;
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
  }
  #item-storage-modal > div,
  #event-participants-modal > div {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  #item-storage-options,
  #event-participants-options {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
  }
  #item-storage-modal > div > :first-child,
  #item-storage-modal > div > :last-child,
  #event-participants-modal > div > :first-child,
  #event-participants-modal > div > :last-child {
    flex-shrink: 0;
  }
</style>

<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="space-y-2">
    <div class="text-xs text-gray-500 flex items-center gap-1">
      <a href="/users/packing" class="text-blue-600 hover:underline">トップ</a>
      <span>＞</span>
      <span id="event-name-breadcrumb" class="text-gray-800"><%= event.name || '' %> のパッキングプラン</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <div class="flex items-center gap-2">
          <h1 id="event-name-title" class="text-2xl font-bold"><%= event.name || '' %> のパッキングプラン</h1>
          <button type="button" id="event-name-edit-open" class="px-2 py-1 rounded border text-[11px] bg-white text-gray-700 hover:bg-gray-50">プラン名を編集</button>
        </div>
        <p class="text-sm text-gray-600">このイベントで使用する収納に持ち物を入れてチェックできます</p>
        <div id="event-participant-summary" class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
          <span>参加メンバー:</span>
          <% const participantLabels = (event.participants || []).map((id)=> (memberNameById.get(id) || '')).filter(Boolean); %>
          <% if (participantLabels.length) { %>
            <% participantLabels.forEach((name)=> { %>
              <span class="inline-flex items-center px-2 py-1 rounded-full bg-blue-50 text-blue-800 border border-blue-100"><%= name %></span>
            <% }) %>
          <% } else { %>
            <span class="text-gray-400">未設定</span>
          <% } %>
          <button type="button" id="event-participants-edit-open" class="ml-1 px-2 py-1 rounded border border-blue-200 bg-white text-[11px] font-semibold text-blue-700 hover:bg-blue-50">メンバーを編集</button>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/users/packing/shop/<%= event.id %>" class="px-3 py-1.5 rounded-lg bg-amber-50 text-amber-800 text-sm font-semibold border border-amber-200 hover:bg-amber-100">買い物リストへ</a>
        <a href="/users/packing/check/<%= event.id %>" class="px-3 py-1.5 rounded-lg bg-green-600 text-white text-sm font-semibold hover:bg-green-700">チェックリストへ</a>
      </div>
    </div>
    <% if (event.completed) { %>
      <div class="rounded-xl border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
        このイベントは完了済みです。復活は「完了イベント一覧」から行えます。
      </div>
    <% } %>
  </header>

  <section class="border rounded-2xl bg-white p-4 space-y-3">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-100">収納・持ち物タグ</span>
        <p class="text-xs text-gray-500">持ち物の「収納先を選ぶ」から入れる場所を指定できます</p>
      </div>
      <div class="flex gap-2">
      </div>
    </div>
    <div class="space-y-3 rounded-2xl border border-sky-200 bg-sky-50 p-4">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-800 border border-sky-200 text-sm font-semibold">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-sky-600 text-white text-xs font-bold">1</span>
            <span>収納先</span>
          </div>
          <button type="button" id="storage-unused-toggle" class="px-2 py-1 rounded border text-[11px] bg-white hover:bg-gray-50">未使用の収納先を表示する</button>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="open-storage-modal" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sky-700 text-white text-sm font-semibold hover:bg-sky-800 border border-sky-800">
            <i data-lucide="plus" class="w-4 h-4"></i>
            収納先を追加
          </button>
          <button type="button" data-section-toggle="storage" class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-sky-300 bg-white text-sky-800 text-xs font-semibold hover:bg-sky-100" aria-expanded="true"><i data-lucide="chevron-up" class="w-4 h-4"></i><span>閉じる</span></button>
        </div>
      </div>
      <div data-section-content="storage" class="space-y-3">
      <div id="storage-owner-filter" class="flex flex-wrap gap-2 text-[11px] text-gray-600">
        <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
          <input type="checkbox" value="all" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
          <span>共有</span>
        </label>
        <% (members || []).forEach((m)=> { %>
          <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
            <input type="checkbox" value="<%= m.id %>" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
            <span><%= m.name %></span>
          </label>
        <% }) %>
      </div>
      <div id="storage-tags" class="flex flex-wrap gap-2"></div>
      <div id="storage-unused-title" class="text-xs text-gray-500 hidden">未使用の収納先</div>
      <div id="storage-unused" class="flex flex-wrap gap-2 hidden"></div>
      <% if (!(storages||[]).length) { %>
        <p class="text-xs text-gray-500">収納がありません。追加してください。</p>
      <% } %>
      </div>
    </div>
    <div class="space-y-3 rounded-2xl border border-purple-200 bg-purple-50 p-4">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100 text-purple-800 border border-purple-200 text-sm font-semibold">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-purple-600 text-white text-xs font-bold">2</span>
            <span>持ち物</span>
          </div>
          <button type="button" id="hidden-toggle" class="px-2 py-1 rounded border text-[11px] bg-white text-gray-700 hover:bg-gray-50">非表示の持ち物を表示する</button>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="open-item-modal" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-purple-700 text-white text-sm font-semibold hover:bg-purple-800 border border-purple-800">
            <i data-lucide="plus" class="w-4 h-4"></i>
            持ち物を追加
          </button>
          <button type="button" data-section-toggle="items" class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-purple-300 bg-white text-purple-800 text-xs font-semibold hover:bg-purple-100" aria-expanded="true"><i data-lucide="chevron-up" class="w-4 h-4"></i><span>閉じる</span></button>
        </div>
      </div>
      <div data-section-content="items" class="space-y-3">
      <div id="owner-filter" class="flex flex-wrap gap-2 text-xs">
        <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
          <input type="checkbox" value="all" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
          <span>共有</span>
        </label>
        <% (members || []).forEach((m)=> { %>
          <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
            <input type="checkbox" value="<%= m.id %>" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
            <span><%= m.name %></span>
          </label>
        <% }) %>
      </div>
      <div class="space-y-2" id="item-pool"></div>
      <p class="text-xs text-gray-500" id="pool-empty">持ち物がありません。追加してください。</p>
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-gray-600">
          <span>買い物リスト</span>
          <span class="text-[11px] text-gray-400">収納には入れられません</span>
        </div>
        <div id="wish-list" class="flex flex-wrap gap-2"></div>
        <p class="text-xs text-gray-500" id="wish-empty">買い物リストは空です。持ち物編集で買い物をONにできます。</p>
      </div>
      </div>
    </div>
    <div class="space-y-3 rounded-2xl border border-rose-200 bg-rose-50 p-4">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 text-rose-800 border border-rose-200 text-sm font-semibold">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-rose-500 text-white text-xs font-bold">3</span>
          <span>パッキングプランの進捗</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] text-rose-700">メンバーごとに作成状況を登録できます</span>
          <button type="button" data-section-toggle="progress" class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-rose-300 bg-white text-rose-800 text-xs font-semibold hover:bg-rose-100" aria-expanded="true"><i data-lucide="chevron-up" class="w-4 h-4"></i><span>閉じる</span></button>
        </div>
      </div>
      <div data-section-content="progress">
        <div id="plan-status-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2"></div>
      </div>
    </div>
  </section>

  <section class="border rounded-2xl bg-white p-4 space-y-3">
    <div class="flex items-center gap-2">
      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-50 text-green-700 border border-green-100">収納先別の持ち物</span>
      <p class="text-xs text-gray-500">収納先ごとに持ち物の確認・編集・移動ができます</p>
    </div>
    <div id="storage-lists" class="space-y-3"></div>
  </section>

  <section class="border rounded-2xl bg-white p-4 space-y-2">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700 border border-gray-200">イベント完了</span>
        <p class="text-xs text-gray-500 mt-1">完了するとイベント一覧に表示されなくなり、完了一覧から復活できます</p>
      </div>
      <button type="button" id="event-complete-open" class="px-4 py-2 rounded-lg text-sm font-semibold text-white bg-red-600 hover:bg-red-700 disabled:opacity-60 disabled:cursor-not-allowed" <%= event.completed ? 'disabled' : '' %>>
        <%= event.completed ? '完了済み' : 'イベントを完了' %>
      </button>
    </div>
  </section>
</section>

<!-- 収納追加モーダル -->
<div id="storage-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900" id="storage-modal-title">収納を追加</h3>
      <button type="button" data-storage-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">収納名
      <input type="text" id="storage-modal-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: スーツケース" />
    </label>
    <label class="block text-sm">制限重量(g)
      <input type="number" min="0" id="storage-modal-max" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" value="0" />
    </label>
    <label class="block text-sm">表示順
      <input type="number" id="storage-modal-order" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 1" />
      <span class="mt-1 block text-xs text-gray-500">数字が小さい収納先から表示されます。</span>
    </label>
    <label class="block text-sm">画像URL
      <input type="url" id="storage-modal-image-url" class="mt-1 w-full border rounded-lg px-3 py-2" placeholder="https://example.com/image.jpg" />
    </label>
    <label class="block text-sm">誰のもの
      <select id="storage-modal-owner" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
        <option value="all">共有</option>
        <% (members || []).forEach((m)=> { %>
          <option value="<%= m.id %>" <%= String(m.id) === String(currentUserId || '') ? 'selected' : '' %>><%= m.name %></option>
        <% }) %>
      </select>
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-storage-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="storage-modal-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">追加</button>
    </div>
  </div>
</div>
<datalist id="item-category-datalist"></datalist>

<!-- 持ち物追加モーダル -->
<div id="item-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">持ち物を追加</h3>
      <button type="button" data-item-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">持ち物名
      <input type="text" id="item-modal-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 着替え" />
    </label>
    <div class="grid sm:grid-cols-2 gap-2">
      <label class="block text-sm">誰のもの
        <select id="item-modal-owner" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
          <option value="all">共有</option>
          <% (members || []).forEach((m)=> { %>
            <option value="<%= m.id %>" <%= String(m.id) === String((user && user._id) || '') ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="block text-sm">数量
        <input type="number" step="1" min="0" id="item-modal-qty" value="1" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </label>
      <label class="block text-sm">重量(g)
        <input type="number" step="1" min="0" id="item-modal-weight" value="0" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </label>
      <label class="block text-sm">優先度
        <select id="item-modal-priority" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
          <option value="最重要">最重要</option>
          <option value="重要">重要</option>
          <option value="普通" selected>普通</option>
          <option value="あった方がいい">あった方がいい</option>
          <option value="あってもいい">あってもいい</option>
        </select>
      </label>
    </div>
    <label class="block text-sm">カテゴリー
      <input type="text" list="item-category-datalist" id="item-modal-category" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 衣類 / 洗面・メイク / ガジェット" />
    </label>
    <label class="block text-sm">コメント
      <input type="text" id="item-modal-comment" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="メモ" />
    </label>
    <label class="block text-sm">画像URL
      <input type="url" id="item-modal-image-url" class="mt-1 w-full border rounded-lg px-3 py-2" placeholder="https://example.com/image.jpg" />
    </label>
    <label class="inline-flex items-center gap-2 text-sm">
      <input type="checkbox" id="item-modal-wish" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
      <span>買い物リストに入れる（収納には入れられません）</span>
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-item-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="item-modal-save" class="px-4 py-2 rounded-lg bg-amber-600 text-white font-semibold hover:bg-amber-700">追加</button>
    </div>
  </div>
</div>

<!-- プラン名編集モーダル -->
<div id="event-name-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">プラン名を編集</h3>
      <button type="button" data-name-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">プラン名
      <input type="text" id="event-name-input" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-name-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="event-name-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">保存</button>
    </div>
  </div>
</div>

<!-- 参加メンバー編集モーダル -->
<div id="event-participants-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">参加メンバーを編集</h3>
        <p class="text-xs text-gray-500 mt-1">このプランに参加するメンバーを選択してください。</p>
      </div>
      <button type="button" data-participants-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <div id="event-participants-options" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      <% (allGroupMembers || []).forEach((m)=> { %>
        <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm">
          <input type="checkbox" value="<%= m.id %>" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" <%= (event.participants || []).includes(String(m.id)) ? 'checked' : '' %> />
          <span><%= m.name %></span>
        </label>
      <% }) %>
    </div>
    <div class="flex justify-end gap-2">
      <button type="button" data-participants-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="event-participants-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">保存</button>
    </div>
  </div>
</div>

<!-- 持ち物の収納先選択モーダル -->
<div id="item-storage-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">収納先を選択</h3>
        <p id="item-storage-target-name" class="text-sm text-gray-600 mt-1"></p>
      </div>
      <button type="button" data-item-storage-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <div id="item-storage-options" class="grid grid-cols-1 gap-2"></div>
    <p id="item-storage-empty" class="hidden text-sm text-gray-500">使用中の収納先がありません。先に収納先を追加してください。</p>
    <div class="flex justify-end gap-2">
      <button type="button" data-item-storage-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="item-storage-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">この収納先に入れる</button>
    </div>
  </div>
</div>

<!-- 完了確認モーダル -->
<div id="event-complete-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-24 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">イベントを完了しますか？</h3>
      <button type="button" data-complete-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <p class="text-sm text-gray-700">完了するとイベント一覧には表示されず、完了イベント一覧から復活できます。</p>
    <p id="event-name-complete" class="text-sm font-semibold text-gray-900"><%= event.name || '' %></p>
    <div class="flex justify-end gap-2">
      <button type="button" data-complete-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="event-complete-confirm" class="px-4 py-2 rounded-lg bg-blue-700 text-white text-sm font-semibold hover:bg-blue-800">完了にする</button>
    </div>
  </div>
</div>

<div id="packing-preview-modal" class="hidden fixed inset-0 z-50 bg-black/40 items-start justify-center p-4 overflow-y-auto">
  <div class="my-4 w-full max-w-lg max-h-[calc(100dvh-2rem)] overflow-y-auto bg-white rounded-2xl shadow-2xl p-4 space-y-3">
    <div class="flex items-center justify-between gap-3"><h3 id="packing-preview-title" class="text-lg font-semibold"></h3><button type="button" data-preview-close><i data-lucide="x" class="w-5 h-5"></i></button></div>
    <img id="packing-preview-image" class="hidden w-full max-h-[60vh] object-contain rounded-xl border bg-gray-50" alt="" />
    <p id="packing-preview-no-image" class="hidden rounded-xl bg-gray-50 px-4 py-8 text-center text-sm text-gray-500">画像は登録されていません。</p>
    <div id="packing-preview-details" class="text-sm text-gray-600 whitespace-pre-wrap"></div>
  </div>
</div>

  <script>
    (function(){
      const eventId = <%- JSON.stringify(event.id || '') %>;
      const members = <%- JSON.stringify(members || []) %>;
      let eventParticipants = <%- JSON.stringify(event.participants || []) %>;
      const currentUserId = <%- JSON.stringify((user && user._id) ? String(user._id) : '') %>;
      let eventCompleted = !!<%- JSON.stringify(event.completed || false) %>;
      let eventName = <%- JSON.stringify(event.name || '') %>;
      const storages = <%- JSON.stringify(storages || []) %>;
      const selectedStorageIds = <%- JSON.stringify(event.storageIds || []) %>;
      const masterItems = <%- JSON.stringify(masterItems || []) %>;
      const memberMap = new Map((members||[]).map((m)=> [m.id, m.name]));
      const items = <%- JSON.stringify(items || []) %>;
      const packingPriorityOptions = ['最重要', '重要', '普通', 'あった方がいい', 'あってもいい'];
      const defaultPackingPriority = '普通';
      const normalizePackingPriority = (value) => packingPriorityOptions.includes(value) ? value : defaultPackingPriority;

  const storageTags = document.getElementById('storage-tags');
  const storageUnused = document.getElementById('storage-unused');
  const storageUnusedToggle = document.getElementById('storage-unused-toggle');
  const storageUnusedTitle = document.getElementById('storage-unused-title');
  const storageOwnerFilter = document.getElementById('storage-owner-filter');
  const itemPool = document.getElementById('item-pool');
  const poolEmpty = document.getElementById('pool-empty');
    const wishList = document.getElementById('wish-list');
    const wishEmpty = document.getElementById('wish-empty');
    const storageLists = document.getElementById('storage-lists');
    const ownerFilter = document.getElementById('owner-filter');

  const storageModal = document.getElementById('storage-modal');
  const storageModalTitle = document.getElementById('storage-modal-title');
  const storageModalName = document.getElementById('storage-modal-name');
  const storageModalMax = document.getElementById('storage-modal-max');
  const storageModalOrder = document.getElementById('storage-modal-order');
  const storageModalImageUrl = document.getElementById('storage-modal-image-url');
  const storageModalOwner = document.getElementById('storage-modal-owner');
  const storageModalSave = document.getElementById('storage-modal-save');
    const itemModal = document.getElementById('item-modal');
    const itemModalName = document.getElementById('item-modal-name');
    const itemModalOwner = document.getElementById('item-modal-owner');
    const itemModalQty = document.getElementById('item-modal-qty');
    const itemModalWeight = document.getElementById('item-modal-weight');
    const itemModalPriority = document.getElementById('item-modal-priority');
    const itemModalCategory = document.getElementById('item-modal-category');
    const itemModalComment = document.getElementById('item-modal-comment');
    const itemModalImageUrl = document.getElementById('item-modal-image-url');
    const itemModalWish = document.getElementById('item-modal-wish');
    const itemModalSave = document.getElementById('item-modal-save');
    const itemCategoryDatalist = document.getElementById('item-category-datalist');
    const completeOpen = document.getElementById('event-complete-open');
    const completeModal = document.getElementById('event-complete-modal');
    const completeConfirm = document.getElementById('event-complete-confirm');
    const hiddenToggle = document.getElementById('hidden-toggle');
    const planStatusList = document.getElementById('plan-status-list');
    const planStatus = new Map(Object.entries(<%- JSON.stringify(planStatus || {}) %>));
    const eventNameModal = document.getElementById('event-name-modal');
    const eventNameInput = document.getElementById('event-name-input');
    const eventNameSave = document.getElementById('event-name-save');
    const eventNameOpen = document.getElementById('event-name-edit-open');
    const eventNameTitle = document.getElementById('event-name-title');
    const eventNameBreadcrumb = document.getElementById('event-name-breadcrumb');
    const eventNameComplete = document.getElementById('event-name-complete');
    const participantsModal = document.getElementById('event-participants-modal');
    const participantsOpen = document.getElementById('event-participants-edit-open');
    const participantsSave = document.getElementById('event-participants-save');
    const participantsOptions = document.getElementById('event-participants-options');
    const itemStorageModal = document.getElementById('item-storage-modal');
    const itemStorageOptions = document.getElementById('item-storage-options');
    const itemStorageTargetName = document.getElementById('item-storage-target-name');
    const itemStorageEmpty = document.getElementById('item-storage-empty');
    const itemStorageSave = document.getElementById('item-storage-save');
    const previewModal = document.getElementById('packing-preview-modal');
    const previewTitle = document.getElementById('packing-preview-title');
    const previewImage = document.getElementById('packing-preview-image');
    const previewNoImage = document.getElementById('packing-preview-no-image');
    const previewDetails = document.getElementById('packing-preview-details');
    let itemEditId = '';
    let storageEditId = '';
    let showUnusedStorages = false;
    let showHiddenItems = false;
    let storageChoiceItemId = '';
    let categoryOptions = Array.from(new Set([...(masterItems||[]).map(m=> (m.category||'').trim()).filter(Boolean), ...(items||[]).map(i=> (i.category||'').trim()).filter(Boolean)])).filter(Boolean);

    const OWNER_KEY = `packing:event:${eventId}:owners`;
    const STORAGE_OWNER_KEY = `packing:event:${eventId}:storageOwners`;
    const SECTION_STATE_KEY = `packing:event:${eventId}:sections`;
    const STORAGE_SECTION_STATE_KEY = `packing:event:${eventId}:storageSections`;

    masterItems.forEach((m)=> { m.priority = normalizePackingPriority(m.priority); });
    items.forEach((it)=> { it.priority = normalizePackingPriority(it.priority); });

    function toast(msg){ try{ const el=document.createElement('div'); el.textContent=msg; el.className='fixed bottom-4 right-4 bg-gray-900 text-white text-sm px-3 py-2 rounded shadow'; document.body.appendChild(el); setTimeout(()=> el.remove(),2000);}catch(_){alert(msg);} }
    function openPreview(target, type){
      if (!target) return;
      previewTitle.textContent = target.name || '';
      const url = String(target.imageUrl || '').trim();
      previewImage.classList.toggle('hidden', !url); previewNoImage.classList.toggle('hidden', !!url);
      previewImage.onerror = ()=> { previewImage.classList.add('hidden'); previewNoImage.classList.remove('hidden'); };
      if (url) { previewImage.src = url; previewImage.alt = target.name || ''; } else previewImage.removeAttribute('src');
      previewDetails.textContent = type === 'storage' ? `制限重量: ${target.maxWeight || 0} g` : `数量: ${target.quantity ?? 0}\n重量: ${target.weight ?? 0} g${target.comment ? `\n${target.comment}` : ''}`;
      openModal(previewModal);
    }
    previewModal?.addEventListener('click', (e)=> { if (e.target === previewModal) closeModal(previewModal); });
    previewModal?.querySelectorAll('[data-preview-close]')?.forEach((b)=> b.addEventListener('click', ()=> closeModal(previewModal)));
    function loadSectionStates(){
      try {
        const saved = JSON.parse(localStorage.getItem(SECTION_STATE_KEY) || '{}');
        return saved && typeof saved === 'object' ? saved : {};
      } catch (_) {
        return {};
      }
    }
    const sectionStates = loadSectionStates();
    function loadStorageSectionStates(){
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_SECTION_STATE_KEY) || '{}');
        return saved && typeof saved === 'object' ? saved : {};
      } catch (_) {
        return {};
      }
    }
    const storageSectionStates = loadStorageSectionStates();
    function saveStorageSectionStates(){
      try { localStorage.setItem(STORAGE_SECTION_STATE_KEY, JSON.stringify(storageSectionStates)); } catch (_) {}
    }
    function setSectionOpen(sectionId, isOpen, persist = true){
      const content = document.querySelector(`[data-section-content="${sectionId}"]`);
      const button = document.querySelector(`[data-section-toggle="${sectionId}"]`);
      if (!content || !button) return;
      content.classList.toggle('hidden', !isOpen);
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      button.innerHTML = `<i data-lucide="chevron-${isOpen ? 'up' : 'down'}" class="w-4 h-4"></i><span>${isOpen ? '閉じる' : '開く'}</span>`;
      sectionStates[sectionId] = isOpen;
      if (persist) {
        try { localStorage.setItem(SECTION_STATE_KEY, JSON.stringify(sectionStates)); } catch (_) {}
      }
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    document.querySelectorAll('[data-section-toggle]').forEach((button)=> {
      const sectionId = button.dataset.sectionToggle;
      const initialOpen = sectionStates[sectionId] !== false;
      setSectionOpen(sectionId, initialOpen, false);
      button.addEventListener('click', ()=> {
        setSectionOpen(sectionId, button.getAttribute('aria-expanded') !== 'true');
      });
    });
    function priorityBadgeClass(priority){
      switch (normalizePackingPriority(priority)) {
        case '最重要': return 'bg-red-50 text-red-700 border-red-200';
        case '重要': return 'bg-orange-50 text-orange-700 border-orange-200';
        case 'あった方がいい': return 'bg-sky-50 text-sky-700 border-sky-200';
        case 'あってもいい': return 'bg-gray-50 text-gray-600 border-gray-200';
        default: return 'bg-blue-50 text-blue-700 border-blue-200';
      }
    }
    function priorityBadgeHtml(priority){
      const label = normalizePackingPriority(priority);
      return `<span class="text-[10px] font-semibold px-1 rounded border ${priorityBadgeClass(label)}">${label}</span>`;
    }

    function selectableStorages(){
      return (storages || []).filter((storage)=> {
        if (!selectedStorageIds.includes(storage.id)) return false;
        const owner = String(storage.owner || 'all');
        return owner === 'all' || memberMap.has(owner);
      }).sort(compareStorageNames);
    }

    function compareStorageNames(a, b){
      const aHash = String(a?.name || '').startsWith('#');
      const bHash = String(b?.name || '').startsWith('#');
      if (aHash !== bHash) return aHash ? 1 : -1;
      const aOrder = a?.displayOrder == null ? Number.MAX_SAFE_INTEGER : Number(a.displayOrder);
      const bOrder = b?.displayOrder == null ? Number.MAX_SAFE_INTEGER : Number(b.displayOrder);
      if (aOrder !== bOrder) return aOrder - bOrder;
      return String(a?.name || '').localeCompare(String(b?.name || ''), 'ja');
    }

    function openItemStorageModal(item){
      if (!item) return;
      storageChoiceItemId = item.id;
      if (itemStorageTargetName) itemStorageTargetName.textContent = `「${item.name}」を入れる収納先を選んでください。`;
      if (itemStorageOptions) {
        itemStorageOptions.innerHTML = '';
        selectableStorages().forEach((storage)=> {
          const label = document.createElement('label');
          label.className = 'flex items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 text-sm hover:border-blue-300 cursor-pointer';
          const radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = 'item-storage-choice';
          radio.value = storage.id;
          radio.checked = String(item.storageId || '') === String(storage.id);
          radio.className = 'border-gray-300 text-blue-600 focus:ring-blue-500';
          const name = document.createElement('span');
          name.className = 'font-semibold text-gray-800';
          name.textContent = storage.name;
          label.append(radio, name);
          itemStorageOptions.appendChild(label);
        });
      }
      const hasOptions = selectableStorages().length > 0;
      itemStorageEmpty?.classList.toggle('hidden', hasOptions);
      if (itemStorageSave) itemStorageSave.disabled = !hasOptions;
      openModal(itemStorageModal);
    }

    function restoreOwnerSelections(){
      if (!ownerFilter) return;
      try{
        const saved = JSON.parse(localStorage.getItem(OWNER_KEY) || '[]');
        if (Array.isArray(saved) && saved.length){
          ownerFilter.querySelectorAll('input[type="checkbox"]').forEach((cb)=>{
            cb.checked = saved.includes(cb.value);
          });
        }
      } catch(_) {}
    }
    function saveOwnerSelections(){
      if (!ownerFilter) return;
      try{
        const checked = Array.from(ownerFilter.querySelectorAll('input[type="checkbox"]:checked')).map(cb=> cb.value);
        localStorage.setItem(OWNER_KEY, JSON.stringify(checked));
      } catch(_) {}
    }
    function restoreStorageOwnerSelections(){
      if (!storageOwnerFilter) return;
      try{
        const saved = JSON.parse(localStorage.getItem(STORAGE_OWNER_KEY) || '[]');
        if (Array.isArray(saved) && saved.length){
          storageOwnerFilter.querySelectorAll('input[type="checkbox"]').forEach((cb)=>{
            cb.checked = saved.includes(cb.value);
          });
        }
      } catch(_) {}
    }
    function saveStorageOwnerSelections(){
      if (!storageOwnerFilter) return;
      try{
        const checked = Array.from(storageOwnerFilter.querySelectorAll('input[type="checkbox"]:checked')).map(cb=> cb.value);
        localStorage.setItem(STORAGE_OWNER_KEY, JSON.stringify(checked));
      } catch(_) {}
    }

    function normalizeWishItems(){
      items.forEach((it)=>{
        if (it.wish && (it.storageId || it.storageName)){
          it.storageId = '';
          it.storageName = '';
        }
      });
    }

    async function saveEventStorages(newIds){
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ storageIds: newIds })
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        selectedStorageIds.splice(0, selectedStorageIds.length, ...(json.storageIds || []));
        renderStorages();
        renderStorageLists();
        renderItemPool();
        toast('収納の使用設定を更新しました');
      }catch(e){ toast(e.message || '更新に失敗しました'); }
    }

    function addStorageToEvent(id){
      if (!id) return;
      if (!selectedStorageIds.includes(id)) selectedStorageIds.push(id);
      saveEventStorages([...selectedStorageIds]);
    }
    function removeStorageFromEvent(id){
      const idx = selectedStorageIds.indexOf(id);
      if (idx >= 0) selectedStorageIds.splice(idx,1);
      saveEventStorages([...selectedStorageIds]);
    }

    const storageOwnerLabel = (val)=>{
      if (!val || val === 'all') return '共有';
      return memberMap.get(val) || '未設定';
    };
    const getStorageOwnerSelections = ()=>{
      const checked = Array.from(storageOwnerFilter?.querySelectorAll('input[type="checkbox"]:checked') || []).map((el)=> el.value);
      return { list: checked, has: checked.length > 0 };
    };

    function renderStorages(){
      if (!storageTags) return;
      storageTags.innerHTML = '';
      const selection = getStorageOwnerSelections();
      const matchesOwner = (s)=>{
        if (!selection.has) return true;
        const ownerVal = s.owner || 'all';
        if (selection.list.includes('all') && ownerVal === 'all') return true;
        return selection.list.includes(ownerVal);
      };
      const filtered = (storages||[]).filter(matchesOwner).sort(compareStorageNames);
      filtered.forEach((s)=>{
        if (!selectedStorageIds.includes(s.id)) return;
        const tag = document.createElement('div');
        tag.dataset.id = s.id;
        tag.className = 'px-3 py-1.5 rounded-full border text-sm flex items-center gap-1 bg-sky-50 text-sky-800 border-sky-200';
        tag.innerHTML = `
          <span class="font-semibold">${s.name}</span>
          <button type="button" class="text-blue-700 hover:text-blue-900" data-storage-edit="${s.id}" title="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
          <button type="button" data-remove="${s.id}" class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-100 ml-1">
            <span class="lucide w-3 h-3" data-lucide="arrow-right"></span>
            未使用
          </button>`;
        tag.addEventListener('click', (e)=>{
          if (e.target?.closest?.('button[data-storage-edit]')){
            const target = storages.find((st)=> st.id === s.id);
            openStorageModal(target || null);
            return;
          }
          if (e.target?.closest?.('button[data-remove]')){
            removeStorageFromEvent(s.id);
            return;
          }
          openPreview(s, 'storage');
        });
        storageTags.appendChild(tag);
      });
      if (storageUnused){
        storageUnused.innerHTML = '';
        storageUnused.classList.toggle('hidden', !showUnusedStorages);
        storageUnusedTitle?.classList.toggle('hidden', !showUnusedStorages);
        if (!showUnusedStorages) { /* keep empty */ }
        filtered.forEach((s)=>{
          if (selectedStorageIds.includes(s.id)) return;
          const b = document.createElement('button');
          b.type='button';
          b.dataset.id = s.id;
          b.className='px-3 py-1 rounded-full border bg-gray-50 text-gray-700 text-xs hover:border-blue-300 flex items-center gap-1';
          b.innerHTML = `＋ ${s.name} <span class="text-[10px] px-1 rounded bg-gray-100 text-gray-600">未使用</span> <button type="button" data-storage-edit="${s.id}" class="text-gray-500 hover:text-gray-700" title="編集"><i data-lucide="pencil" class="w-3 h-3"></i></button>`;
          b.addEventListener('click', (ev)=>{
            if (ev.target?.closest?.('button[data-storage-edit]')){
              const target = storages.find((st)=> st.id === s.id);
              openStorageModal(target || null);
              ev.stopPropagation();
              return;
            }
            addStorageToEvent(s.id);
          });
          storageUnused.appendChild(b);
        });
      }
    }

    function renderCategoryOptions(){
      if (!itemCategoryDatalist) return;
      itemCategoryDatalist.innerHTML = '';
      categoryOptions = Array.from(new Set(categoryOptions.filter(Boolean)));
      categoryOptions.forEach(c=>{ const opt=document.createElement("option"); opt.value=c; itemCategoryDatalist.appendChild(opt); });
    }

    function openStorageModal(target){
      const isEdit = !!target;
      storageEditId = isEdit ? (target.id || '') : '';
      if (storageModalTitle) storageModalTitle.textContent = isEdit ? '収納を編集' : '収納を追加';
      if (storageModalSave) storageModalSave.textContent = isEdit ? '更新' : '追加';
      if (storageModalName) storageModalName.value = isEdit ? (target?.name || '') : '';
      if (storageModalMax) storageModalMax.value = isEdit ? (target?.maxWeight || 0) : 0;
      if (storageModalOrder) storageModalOrder.value = isEdit ? (target?.displayOrder ?? '') : '';
      if (storageModalImageUrl) storageModalImageUrl.value = isEdit ? (target?.imageUrl || '') : '';
      if (storageModalOwner) storageModalOwner.value = isEdit ? (target?.owner || 'all') : (currentUserId || 'all');
      storageModal?.classList.remove('hidden'); storageModal?.classList.add('flex');
      storageModalName?.focus();
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function renderWishList(){
      if (!wishList) return;
      wishList.innerHTML = '';
      const checkedOwners = Array.from(ownerFilter?.querySelectorAll('input[type="checkbox"]:checked') || []).map(el=> el.value);
      const hasOwnerSelection = checkedOwners.length > 0;
      const list = items
        .filter((it)=> !!it.wish)
        .filter((it)=> !it.hidden || showHiddenItems)
        .filter((it)=>{
          if (!hasOwnerSelection) return false;
          if (checkedOwners.includes('all') && it.owner === 'all') return true;
          return checkedOwners.includes(it.owner);
        });
      if (!list.length){
        wishEmpty?.classList.remove('hidden');
        return;
      }
      wishEmpty?.classList.add('hidden');
      const grouped = {};
      list.forEach((it)=>{
        const cat = it.hidden ? '非表示' : ((it.category || '').trim() || '未分類');
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(it);
      });
      Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja')).forEach((cat)=>{
        const sec = document.createElement('div');
        sec.className = 'space-y-1';
        const title = document.createElement('div');
        title.className = 'text-[11px] text-gray-600';
        title.textContent = cat;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        grouped[cat].forEach((it)=>{
          const tag = document.createElement('div');
          tag.dataset.itemPreview = it.id;
          tag.className='inline-flex items-center gap-1 px-3 py-1.5 rounded-full border bg-gray-100 text-gray-800 text-sm border-gray-300';
          tag.innerHTML = `
            <span class="text-[10px] font-semibold text-gray-600 bg-gray-200 px-1 rounded">買い物</span>
            ${priorityBadgeHtml(it.priority)}
            <span class="font-semibold cursor-pointer" title="プレビューを表示">${it.name}</span>
            <button type="button" class="text-blue-600 hover:text-blue-800" data-item-edit="${it.id}" aria-label="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
            <button type="button" class="text-red-600 hover:text-red-800" data-item-del="${it.id}" aria-label="削除"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
          `;
          wrap.appendChild(tag);
        });
        sec.appendChild(title);
        sec.appendChild(wrap);
        wishList.appendChild(sec);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function renderItemPool(){
      if (!itemPool) return;
      normalizeWishItems();
      itemPool.innerHTML = '';
      const checkedOwners = Array.from(ownerFilter?.querySelectorAll('input[type="checkbox"]:checked') || []).map(el=> el.value);
      const hasOwnerSelection = checkedOwners.length > 0;
      const unassigned = items.filter((it)=> !it.storageId && !it.wish).filter((it)=>{
        if (it.hidden && !showHiddenItems) return false;
        if (!hasOwnerSelection) return false;
        if (checkedOwners.includes('all') && it.owner === 'all') return true;
        return checkedOwners.includes(it.owner);
      });
      if (!unassigned.length){
        poolEmpty.classList.remove('hidden');
      } else {
        poolEmpty.classList.add('hidden');
      }
      const grouped = {};
      unassigned.forEach((it)=>{
        const cat = it.hidden ? '非表示' : ((it.category || '').trim() || '未分類');
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(it);
      });
      const cats = Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja'));
      cats.forEach((cat)=>{
        const section = document.createElement('div');
        section.className = 'space-y-1';
        const title = document.createElement('div');
        title.className = 'text-xs font-semibold text-gray-700';
        title.textContent = cat;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        grouped[cat].forEach((it)=>{
          const tag = document.createElement('div');
          tag.dataset.itemPreview = it.id;
          const baseClass = it.hidden ? 'border-dashed border-amber-300 bg-amber-50 text-amber-800' : 'border bg-white text-gray-900';
          tag.className=`inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm hover:border-blue-300 ${baseClass}`;
          tag.innerHTML = `
            ${priorityBadgeHtml(it.priority)}
            <span class="font-semibold text-gray-900 cursor-pointer" title="プレビューを表示">${it.name}</span>
            <button type="button" class="text-blue-600 hover:text-blue-800 ml-2" data-item-edit="${it.id}" aria-label="編集" title="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
            ${it.hidden
              ? `<button type="button" class="ml-2 inline-flex items-center gap-1 px-2 py-1 rounded-full border border-blue-200 bg-blue-50 text-blue-700 hover:bg-blue-100" data-item-unhide="${it.id}" aria-label="表示に戻す" title="表示に戻す"><i data-lucide="eye"></i><span>表示に戻す</span></button>`
              : `<button type="button" class="text-red-600 hover:text-red-800 ml-2" data-item-hide="${it.id}" aria-label="非表示" title="非表示"><i data-lucide="eye-off" class="w-4 h-4"></i></button>
                 <button type="button" class="ml-2 inline-flex items-center gap-1 px-2 py-1 rounded-full border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100" data-item-assign="${it.id}" aria-label="収納先を選ぶ" title="収納先を選ぶ"><i data-lucide="luggage" class="w-4 h-4"></i><span class="text-[11px] font-semibold">収納先を選ぶ</span></button>`}
          `;
          wrap.appendChild(tag);
        });
        section.appendChild(title);
        section.appendChild(wrap);
        itemPool.appendChild(section);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
      renderWishList();
    }

    function renderStorageLists(){
      if (!storageLists) return;
      normalizeWishItems();
      storageLists.innerHTML = '';
      const selection = getStorageOwnerSelections();
      const filtered = (storages || []).filter((s)=>{
        if (!selection.has) return true;
        const ownerVal = s.owner || 'all';
        if (selection.list.includes('all') && ownerVal === 'all') return true;
        return selection.list.includes(ownerVal);
      }).sort(compareStorageNames);
      filtered.forEach((s)=>{
        if (!selectedStorageIds.includes(s.id)) return;
        const list = items.filter((it)=> !it.wish && !it.hidden && it.storageId === s.id);
        const isOpen = storageSectionStates[s.id] !== false;
        const totalWeight = list.reduce((sum, it)=> {
          const qty = Number(it.quantity || 0) || 1;
          const w = Number(it.weight || 0) || 0;
          return sum + (w * qty);
        }, 0);
        const max = Number(s.maxWeight || 0);
        const remain = max ? (max - totalWeight) : null;
        const remainClass = remain !== null && remain < 0 ? 'text-red-600 font-semibold' : 'text-gray-600';
        const remainLabel = remain === null ? '制限なし' : `${remain} g`;
        const sec = document.createElement('section');
        sec.className = 'border rounded-lg px-3 py-2';
        const header = document.createElement('div');
        header.className = `flex items-center justify-between gap-3 flex-wrap ${isOpen ? 'mb-2' : ''}`;
        header.innerHTML = `
          <span class="font-semibold text-sm">${s.name}</span>
          <div class="flex items-center gap-3 flex-wrap ml-auto">
            <span class="text-xs text-gray-600">持ち物: ${list.length}件</span>
            <span class="text-xs text-gray-600">重量合計: ${totalWeight} g</span>
            <span class="text-xs ${remainClass}">残り重量: ${remainLabel}</span>
            <button type="button" data-storage-section-toggle="${s.id}" class="inline-flex items-center gap-1 rounded border border-green-200 bg-white px-2 py-1 text-[11px] font-semibold text-green-800 hover:bg-green-50" aria-expanded="${isOpen ? 'true' : 'false'}">
              <i data-lucide="chevron-${isOpen ? 'up' : 'down'}" class="w-3.5 h-3.5"></i>
              <span>${isOpen ? '閉じる' : '開く'}</span>
            </button>
          </div>`;
        header.querySelector('[data-storage-section-toggle]')?.addEventListener('click', ()=> {
          storageSectionStates[s.id] = !isOpen;
          saveStorageSectionStates();
          renderStorageLists();
        });
        header.addEventListener('click', (event)=> {
          if (!event.target.closest('button')) openPreview(s, 'storage');
        });
        const wrap = document.createElement('div');
        wrap.className = `flex flex-wrap gap-2 ${isOpen ? '' : 'hidden'}`;
        list.forEach((it)=>{
          const tag = document.createElement('div');
          tag.className='inline-flex items-center gap-1 px-3 py-1.5 rounded-full border bg-green-50 text-green-800 text-sm hover:border-green-300';
          tag.innerHTML = `
            ${priorityBadgeHtml(it.priority)}
            <span>${it.name}</span>
            <span class="text-[11px] text-gray-600">${it.weight || 0}g</span>
            <button type="button" class="inline-flex items-center gap-1 text-blue-700 hover:text-blue-900 ml-1" data-item-edit="${it.id}" title="持ち物を編集"><i data-lucide="pencil" class="w-3.5 h-3.5"></i><span class="text-[11px] font-semibold">編集</span></button>
            <button type="button" class="inline-flex items-center gap-1 text-amber-700 hover:text-amber-900 ml-1" data-item-move="${it.id}" title="収納先を変更"><i data-lucide="luggage" class="w-3.5 h-3.5"></i><span class="text-[11px] font-semibold">収納先変更</span></button>
            <button type="button" class="inline-flex items-center gap-1 text-gray-600 hover:text-gray-900 ml-1" data-item-remove="${it.id}" title="持ち物に戻す"><i data-lucide="undo-2" class="w-3.5 h-3.5"></i><span class="text-[11px] font-semibold">持ち物に戻す</span></button>
          `;
          tag.addEventListener('click', (ev)=>{
            const editBtn = ev.target.closest('button[data-item-edit]');
            const moveBtn = ev.target.closest('button[data-item-move]');
            const removeBtn = ev.target.closest('button[data-item-remove]');
            if (editBtn){
              const target = items.find((i)=> i.id === it.id);
              if (target) openItemModal(target);
              return;
            }
            if (moveBtn){
              const target = items.find((i)=> i.id === it.id);
              if (target) openItemStorageModal(target);
              return;
            }
            if (removeBtn){
              assignItemToStorage(it.id, '');
              return;
            }
            openPreview(it, 'item');
          });
          wrap.appendChild(tag);
        });
        if (!list.length){
          const empty = document.createElement('p');
          empty.className='text-xs text-gray-500';
          empty.textContent='まだ持ち物がありません。';
          wrap.appendChild(empty);
        }
        sec.appendChild(header);
        sec.appendChild(wrap);
        storageLists.appendChild(sec);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    async function assignItemToStorage(id, storageId){
      if (!id) return false;
      const target = items.find((i)=> i.id === id);
      if (target?.wish && storageId){
        toast('買い物リストの持ち物は収納に入れられません');
        return false;
      }
      if (storageId && !selectedStorageIds.includes(storageId)){
        toast('このイベントで使用しない収納先です');
        return false;
      }
      try{
        const res = await fetch(`/users/packing/api/items/${encodeURIComponent(id)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ storageId })
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        const target = items.find((i)=> i.id === id);
        if (target){
          target.storageId = json.storageId;
          target.storageName = json.storageName || '';
        }
        renderItemPool();
        renderStorageLists();
        return true;
      }catch(e){
        toast(e.message || '更新に失敗しました');
        return false;
      }
    }

    async function addItemFromMaster(master){
      if (!master) return;
      const payload = {
        eventId,
        thingId: master.id,
        name: master.name,
        owner: master.owner || 'all',
        quantity: master.defaultQuantity || 1,
        priority: normalizePackingPriority(master.priority),
        category: master.category || '',
        comment: master.comment || '',
        storageId: '',
      };
      try{
        const res = await fetch('/users/packing/api/items', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('追加に失敗しました');
        const json = await res.json();
        items.push({ ...json, id: json.id.toString() });
        if (json.category && !categoryOptions.includes(json.category)) { categoryOptions.push(json.category); renderCategoryOptions(); }
        renderItemPool();
        renderStorageLists();
        toast('持ち物を追加しました');
      }catch(e){ toast(e.message || '追加に失敗しました'); }
    }

    function openModal(modalEl){
      modalEl?.classList.remove('hidden'); modalEl?.classList.add('flex');
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    function closeModal(modalEl){
      modalEl?.classList.add('hidden'); modalEl?.classList.remove('flex');
    }

    function openCompleteModal(){
      if (eventCompleted) return;
      completeModal?.classList.remove('hidden'); completeModal?.classList.add('flex');
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    function closeCompleteModal(){
      completeModal?.classList.add('hidden'); completeModal?.classList.remove('flex');
    }
    completeOpen?.addEventListener('click', openCompleteModal);
    completeModal?.addEventListener('click', (ev)=> { if (ev.target === completeModal) closeCompleteModal(); });
    completeModal?.querySelectorAll('[data-complete-close]')?.forEach((b)=> b.addEventListener('click', closeCompleteModal));
    eventNameOpen?.addEventListener('click', ()=>{
      if (eventNameInput) eventNameInput.value = eventName || '';
      openModal(eventNameModal);
    });
    eventNameModal?.addEventListener('click', (ev)=> { if (ev.target === eventNameModal) closeModal(eventNameModal); });
    eventNameModal?.querySelectorAll('[data-name-close]')?.forEach((b)=> b.addEventListener('click', ()=> closeModal(eventNameModal)));
    eventNameSave?.addEventListener('click', async ()=>{
      const name = (eventNameInput?.value || '').trim();
      if (!name) return toast('プラン名を入力してください');
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ name })
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        eventName = json.name || name;
        const title = `${eventName} のパッキングプラン`;
        if (eventNameTitle) eventNameTitle.textContent = title;
        if (eventNameBreadcrumb) eventNameBreadcrumb.textContent = title;
        if (eventNameComplete) eventNameComplete.textContent = eventName;
        closeModal(eventNameModal);
        toast('プラン名を更新しました');
      }catch(e){ toast(e.message || '更新に失敗しました'); }
    });
    participantsOpen?.addEventListener('click', ()=> openModal(participantsModal));
    participantsModal?.addEventListener('click', (ev)=> { if (ev.target === participantsModal) closeModal(participantsModal); });
    participantsModal?.querySelectorAll('[data-participants-close]')?.forEach((button)=> {
      button.addEventListener('click', ()=> closeModal(participantsModal));
    });
    participantsSave?.addEventListener('click', async ()=>{
      const participants = Array.from(
        participantsOptions?.querySelectorAll('input[type="checkbox"]:checked') || []
      ).map((checkbox)=> checkbox.value);
      try {
        participantsSave.disabled = true;
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ participants })
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        eventParticipants = json.participants || participants;
        toast('参加メンバーを更新しました');
        window.location.reload();
      } catch (e) {
        participantsSave.disabled = false;
        toast(e.message || '更新に失敗しました');
      }
    });
    completeConfirm?.addEventListener('click', async ()=>{
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ completed: true })
        });
        if (!res.ok) throw new Error('完了に失敗しました');
        eventCompleted = true;
        completeOpen?.setAttribute('disabled','true');
        completeOpen?.classList.add('opacity-60','cursor-not-allowed');
        closeCompleteModal();
        toast('イベントを完了しました');
        setTimeout(()=> { window.location.href = '/users/packing/completed'; }, 400);
      }catch(e){ toast(e.message || '完了に失敗しました'); }
    });

    document.getElementById('open-storage-modal')?.addEventListener('click', ()=> openStorageModal(null));
    document.getElementById('open-item-modal')?.addEventListener('click', ()=> openItemModal(null));
    storageModal?.addEventListener('click', (ev)=> { if (ev.target === storageModal) closeModal(storageModal); });
    itemModal?.addEventListener('click', (ev)=> { if (ev.target === itemModal) closeModal(itemModal); });
    storageModal?.querySelectorAll('[data-storage-close]')?.forEach((b)=> b.addEventListener('click', ()=> { storageEditId=''; closeModal(storageModal); }));
    itemModal?.querySelectorAll('[data-item-close]')?.forEach((b)=> b.addEventListener('click', ()=> { itemEditId=''; closeModal(itemModal); }));
    storageOwnerFilter?.addEventListener('change', ()=> { saveStorageOwnerSelections(); renderStorages(); renderStorageLists(); });
    storageUnusedToggle?.addEventListener('click', ()=> {
      showUnusedStorages = !showUnusedStorages;
      if (storageUnusedToggle) storageUnusedToggle.textContent = showUnusedStorages ? '未使用の収納先を隠す' : '未使用の収納先を表示する';
      renderStorages();
    });

    storageModalSave?.addEventListener('click', async ()=>{
      const name = (storageModalName?.value || '').trim();
      if (!name) return;
      const owner = storageModalOwner?.value || 'all';
      const displayOrder = storageModalOrder?.value ?? '';
      const imageUrl = storageModalImageUrl?.value || '';
      try{
        if (storageEditId){
          const res = await fetch(`/users/packing/api/storages/${encodeURIComponent(storageEditId)}`, { method:'PATCH', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ name, maxWeight: storageModalMax?.value || 0, displayOrder, imageUrl, owner }) });
          if (!res.ok) throw new Error('更新に失敗しました');
          const json = await res.json();
          const target = storages.find((s)=> s.id === storageEditId);
          if (target) Object.assign(target, { name: json.name, maxWeight: json.maxWeight || 0, displayOrder: json.displayOrder ?? null, imageUrl: json.imageUrl || '', owner: json.owner || 'all' });
          storageEditId='';
          closeModal(storageModal);
          renderStorages();
          renderStorageLists();
          toast('収納を更新しました');
        } else {
          const res = await fetch('/users/packing/api/storages', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ name, maxWeight: storageModalMax?.value || 0, displayOrder, imageUrl, owner }) });
          if (!res.ok) throw new Error('追加に失敗しました');
          const json = await res.json();
          storages.push({ id: json.id.toString(), name: json.name, maxWeight: json.maxWeight || 0, displayOrder: json.displayOrder ?? null, imageUrl: json.imageUrl || '', owner: json.owner || 'all' });
          storageModalName.value = ''; if (storageModalMax) storageModalMax.value = '0'; if (storageModalOwner) storageModalOwner.value = currentUserId || 'all';
          closeModal(storageModal);
          if (!selectedStorageIds.includes(json.id.toString())) selectedStorageIds.push(json.id.toString());
          renderStorages();
          renderStorageLists();
          saveEventStorages([...selectedStorageIds]);
          toast('収納を追加しました');
        }
      }catch(e){ toast(e.message || '保存に失敗しました'); }
    });

    function openItemModal(target, opts = {}){
      const mode = opts.mode || (target ? 'edit' : 'create');
      itemEditId = target && mode !== 'clone' ? target.id : '';
      if (itemModalSave) itemModalSave.textContent = mode === 'edit' ? '更新' : '追加';
      itemModalName.value = target?.name || '';
      if (mode === 'clone'){
        itemModalOwner.value = currentUserId || 'all';
      } else {
        itemModalOwner.value = target?.owner || (currentUserId || 'all');
      }
      itemModalQty.value = target?.quantity || 0;
      itemModalWeight.value = target?.weight || 0;
      if (itemModalPriority) itemModalPriority.value = normalizePackingPriority(target?.priority);
      if (itemModalCategory) itemModalCategory.value = target?.category || '';
      itemModalComment.value = target?.comment || '';
      if (itemModalImageUrl) itemModalImageUrl.value = target?.imageUrl || '';
      if (itemModalWish) itemModalWish.checked = !!target?.wish;
      openModal(itemModal);
      itemModalName?.focus();
    }

    itemModalSave?.addEventListener('click', async ()=>{
      const name = (itemModalName?.value || '').trim();
      if (!name) return;
      const editingItem = itemEditId ? items.find((item)=> item.id === itemEditId) : null;
      const wish = itemModalWish?.checked || false;
      const payload = {
        name,
        owner: itemModalOwner?.value || 'all',
        quantity: itemModalQty?.value || 0,
        weight: itemModalWeight?.value || 0,
        priority: itemModalPriority?.value || defaultPackingPriority,
        category: itemModalCategory?.value || '',
        comment: itemModalComment?.value || '',
        imageUrl: itemModalImageUrl?.value || '',
        eventId,
        storageId: wish ? '' : (editingItem?.storageId || ''),
        thingId: editingItem?.thingId || '',
        wish
      };
      try{
        let json;
        if (itemEditId){
          const res = await fetch(`/users/packing/api/items/${encodeURIComponent(itemEditId)}`, { method:'PATCH', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error('更新に失敗しました');
          json = await res.json();
          const target = items.find((i)=> i.id === itemEditId);
          if (target) Object.assign(target, { ...json, id: json.id.toString() });
        } else {
          const res = await fetch('/users/packing/api/items', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error('追加に失敗しました');
          json = await res.json();
          items.push({ ...json, id: json.id.toString() });
        }
        if (json.category && !categoryOptions.includes(json.category)) { categoryOptions.push(json.category); renderCategoryOptions(); }
        itemModalName.value=''; itemModalComment.value=''; itemModalQty.value='1'; itemModalOwner.value='all'; if (itemModalPriority) itemModalPriority.value = defaultPackingPriority; if (itemModalCategory) itemModalCategory.value=''; if (itemModalWish) itemModalWish.checked = false;
        itemEditId='';
        closeModal(itemModal);
        renderItemPool();
        renderStorageLists();
        toast('保存しました');
      }catch(e){ toast(e.message || '追加に失敗しました'); }
    });

    function handleItemActions(ev){
      const previewTag = ev.target.closest('[data-item-preview]');
      const editBtn = ev.target.closest('button[data-item-edit]');
      const hideBtn = ev.target.closest('button[data-item-hide]');
      const unhideBtn = ev.target.closest('button[data-item-unhide]');
      const assignBtn = ev.target.closest('button[data-item-assign]');
      const nameClick = ev.target.closest('span[data-item-edit]');
      if (editBtn || nameClick){
        const id = (editBtn || nameClick).dataset.itemEdit;
        const target = items.find((i)=> i.id === id);
        if (target) openItemModal(target);
      } else if (hideBtn){
        const id = hideBtn.dataset.itemHide;
        const target = items.find((i)=> i.id === id);
        if (!target) return;
        fetch(`/users/packing/api/items/${encodeURIComponent(id)}`, { method:'PATCH', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ hidden: true }) })
          .then(res=> { if(!res.ok) throw new Error(); return res.json(); })
          .then((json)=> {
            const it = items.find((i)=> i.id === id);
            if (it){ Object.assign(it, { ...it, ...json, id: json.id?.toString?.() || it.id, storageId: '', storageName: '', hidden: true }); }
            renderItemPool(); renderStorageLists(); toast('非表示にしました');
          })
          .catch(()=> toast('非表示に失敗しました'));
      } else if (unhideBtn){
        const id = unhideBtn.dataset.itemUnhide;
        fetch(`/users/packing/api/items/${encodeURIComponent(id)}`, { method:'PATCH', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ hidden: false }) })
          .then(res=> { if(!res.ok) throw new Error(); return res.json(); })
          .then((json)=> {
            const it = items.find((i)=> i.id === id);
            if (it){ Object.assign(it, { ...it, ...json, id: json.id?.toString?.() || it.id, hidden: false }); }
            renderItemPool(); renderStorageLists(); toast('表示に戻しました');
          })
          .catch(()=> toast('解除に失敗しました'));
      } else if (assignBtn){
        const id = assignBtn.dataset.itemAssign;
        const target = items.find((item)=> item.id === id);
        if (target) openItemStorageModal(target);
      } else if (previewTag) {
        const target = items.find((item)=> item.id === previewTag.dataset.itemPreview);
        if (target) openPreview(target, 'item');
      }
    }

    itemPool?.addEventListener('click', handleItemActions);
    wishList?.addEventListener('click', handleItemActions);

    itemStorageModal?.addEventListener('click', (ev)=> { if (ev.target === itemStorageModal) closeModal(itemStorageModal); });
    itemStorageModal?.querySelectorAll('[data-item-storage-close]')?.forEach((button)=> {
      button.addEventListener('click', ()=> closeModal(itemStorageModal));
    });
    itemStorageSave?.addEventListener('click', async ()=> {
      const storageId = itemStorageOptions?.querySelector('input[name="item-storage-choice"]:checked')?.value || '';
      if (!storageId) return toast('収納先を選択してください');
      itemStorageSave.disabled = true;
      const updated = await assignItemToStorage(storageChoiceItemId, storageId);
      itemStorageSave.disabled = false;
      if (updated) closeModal(itemStorageModal);
    });

    function updateHiddenToggle(){
      if (hiddenToggle) hiddenToggle.textContent = showHiddenItems ? '非表示の持ち物を隠す' : '非表示の持ち物を表示する';
    }

    function renderPlanStatus(){
      if (!planStatusList) return;
      planStatusList.innerHTML = '';
      if (!(eventParticipants || []).length){
        const empty = document.createElement('p');
        empty.className = 'text-xs text-rose-700';
        empty.textContent = '参加メンバーが設定されていません。';
        planStatusList.appendChild(empty);
        return;
      }
      (eventParticipants || []).forEach((pid)=>{
        const name = memberMap.get(pid) || 'メンバー';
        const done = !!planStatus.get(pid);
        const isOwnPlan = currentUserId && String(pid) === String(currentUserId);
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between gap-2 rounded-lg border border-rose-100 bg-white px-3 py-2';
        const left = document.createElement('div');
        left.className = 'flex items-center gap-2';
        left.innerHTML = `<span class="inline-flex items-center justify-center px-3 h-7 rounded-full bg-rose-100 text-rose-700 text-sm font-semibold leading-none whitespace-nowrap">${name.slice(0,3)}</span>`;
        const right = document.createElement('div');
        right.className = 'flex items-center gap-2';
        const statusLabel = document.createElement('span');
        statusLabel.className = 'text-xs font-semibold ' + (done ? 'text-rose-700' : 'text-gray-500');
        statusLabel.textContent = done ? '完了' : '作成中';
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.dataset.planToggle = pid;
        toggle.className = 'toggle-pill ' + (done ? 'is-on' : '');
        toggle.setAttribute('aria-pressed', done ? 'true' : 'false');
        toggle.setAttribute('aria-disabled', isOwnPlan ? 'false' : 'true');
        toggle.disabled = !isOwnPlan;
        toggle.tabIndex = isOwnPlan ? 0 : -1;
        toggle.innerHTML = '<span class="knob"></span>';
        right.appendChild(statusLabel);
        right.appendChild(toggle);
        row.appendChild(left);
        row.appendChild(right);
        planStatusList.appendChild(row);
      });
    }

    async function savePlanStatus(){
      try{
        const body = currentUserId ? { planStatus: { [currentUserId]: !!planStatus.get(currentUserId) } } : { planStatus: {} };
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(eventId)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error();
        return true;
      }catch(_){ return false; }
    }
    ownerFilter?.addEventListener('change', ()=> { saveOwnerSelections(); renderItemPool(); });
    hiddenToggle?.addEventListener('click', ()=> {
      showHiddenItems = !showHiddenItems;
      updateHiddenToggle();
      renderItemPool();
    });
    planStatusList?.addEventListener('click', async (ev)=>{
      const btn = ev.target.closest('button[data-plan-toggle]');
      if (!btn || btn.disabled) return;
      const pid = btn.dataset.planToggle;
      if (!currentUserId || String(pid) !== String(currentUserId)) return;
      const current = !!planStatus.get(pid);
      planStatus.set(pid, !current);
      renderPlanStatus();
      const ok = await savePlanStatus();
      if (!ok){
        planStatus.set(pid, current);
        renderPlanStatus();
        toast('更新に失敗しました');
      } else {
        toast('更新しました');
      }
    });

    restoreStorageOwnerSelections();
    restoreOwnerSelections();
    updateHiddenToggle();
    renderStorages();
    renderCategoryOptions();
    renderItemPool();
    renderStorageLists();
    renderPlanStatus();
  })();
</script>
