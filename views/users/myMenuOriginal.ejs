<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex flex-col items-start gap-2">
    <nav class="text-sm text-gray-600 inline-flex items-center gap-1">
      <a href="/users/my-menu" class="inline-flex items-center gap-1 text-blue-600 font-semibold">
        <span class="lucide w-4 h-4" data-lucide="utensils"></span>
        <span>マイメニュートップ</span>
      </a>
      <span class="text-gray-400">›</span>
      <span>オリジナルレシピの登録</span>
    </nav>
    <div class="flex items-center gap-3">
      <div class="rounded-xl border border-purple-200 bg-purple-50 px-4 py-2 text-purple-800">
        <h1 class="text-xl font-extrabold">オリジナルレシピの登録</h1>
        <p class="text-sm opacity-80">基本レイアウトをレシピサイト登録と統一</p>
      </div>
      <a href="/users/my-menu/original-list" class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 bg-purple-600 text-white text-sm font-semibold hover:bg-purple-700">
        <span class="lucide w-4 h-4" data-lucide="list"></span>
        一覧
      </a>
    </div>
  </header>

  <p class="text-xs text-gray-500">登録件数: <%= typeof myOriginalCount !== 'undefined' ? myOriginalCount : 0 %></p>
  <style>
    .toggle-track { position: relative; width: 48px; height: 24px; background: #d1d5db; border-radius: 9999px; display: inline-flex; align-items: center; padding: 0 2px; transition: background-color .2s ease; }
    .toggle-knob { width: 20px; height: 20px; border-radius: 9999px; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.25); transition: transform .2s ease; transform: translateX(0); }
    .toggle-input:checked + .toggle-track { background: #3b82f6; }
    .toggle-input:checked + .toggle-track .toggle-knob { transform: translateX(24px); }
    .toggle-state { display: inline-flex; gap: 4px; font-size: 11px; align-items: center; }
    .toggle-state .state-on,
    .toggle-state .state-off { padding: 4px 8px; border-radius: 6px; border: 1px solid #e5e7eb; transition: all .2s ease; }
    .toggle-input:checked ~ .toggle-state .state-on { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-input:checked ~ .toggle-state .state-off { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-on { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-off { background: #f3f4f6; border-color: #d1d5db; color: #374151; font-weight: 600; }
  </style>

  <form method="post" action="/users/my-menu/original" class="bg-white border rounded-2xl p-5 space-y-4">
    <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-semibold text-gray-700">レシピタイプ</span>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="single" class="w-4 h-4 text-blue-600 border-gray-300" checked>
          <span>従来レシピ</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="set" class="w-4 h-4 text-blue-600 border-gray-300">
          <span>セットメニュー</span>
        </label>
      </div>
      <div id="set-type-section" class="hidden">
        <p class="text-sm font-semibold text-gray-700 mb-2">セット種別</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="morning" class="w-4 h-4 text-blue-600 border-gray-300">
            <span>モーニング</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="lunch" class="w-4 h-4 text-blue-600 border-gray-300">
            <span>ランチ</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="dinner" class="w-4 h-4 text-blue-600 border-gray-300">
            <span>ディナー</span>
          </label>
        </div>
      </div>
      <p class="text-xs text-gray-500">セットメニューを選ぶと画像URL・調味料は登録せず、既存レシピから構成します。必要に応じて食材を追加できます。</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs text-gray-500">レシピ名</label>
        <input name="name" class="w-full border rounded-lg px-3 py-2" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">よみ</label>
        <input name="yomi" class="w-full border rounded-lg px-3 py-2" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">メニュー（自由入力 or 選択）</label>
        <input name="menu" list="menuList" class="w-full border rounded-lg px-3 py-2" required />
        <datalist id="menuList">
          <% (typeof menuNames !== 'undefined' ? menuNames : []).forEach(function(m){ if (!m) return; %>
            <option value="<%= m %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">種類</label>
        <input list="kindList" name="kind" class="w-full border rounded-lg px-3 py-2" required />
        <datalist id="kindList">
          <% (kinds||[]).forEach(function(k){ %>
            <option value="<%= k %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">ジャンル</label>
        <input list="junleList" name="junle" class="w-full border rounded-lg px-3 py-2" required />
        <datalist id="junleList">
          <% (junles||[]).forEach(function(j){ %>
            <option value="<%= j %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理方法</label>
        <input list="cookList" name="cook" class="w-full border rounded-lg px-3 py-2" required />
        <datalist id="cookList">
          <% (cooks||[]).forEach(function(c){ %>
            <option value="<%= c %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div class="md:col-span-2" id="image-section">
        <label class="text-xs text-gray-500">画像URL（プレビューあり）</label>
        <div class="flex gap-3 items-start">
          <input name="imageUrl" id="imageUrlInput" class="flex-1 border rounded-lg px-3 py-2" required />
          <label class="px-3 py-2 border rounded-lg cursor-pointer text-sm whitespace-nowrap">画像選択
            <input id="imageFileInput" type="file" accept="image/*" class="hidden" />
          </label>
          <img id="imgPreview" src="" alt="preview" class="w-24 h-24 object-cover rounded border" />
        </div>
        <p class="text-[11px] text-gray-500 mt-1">ファイル選択後、自動でCloudinaryへアップロードします</p>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理時間（分）</label>
        <input name="time" class="w-full border rounded-lg px-3 py-2" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">人数</label>
        <input name="people" type="number" min="1" step="1" class="w-full border rounded-lg px-3 py-2" required />
      </div>
      <div class="md:col-span-2" id="instruction-section">
        <label class="text-xs text-gray-500">作り方</label>
        <textarea name="instruction" rows="6" class="w-full border rounded-lg px-3 py-2" placeholder="手順を記入" required></textarea>
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-gray-500">コメント</label>
        <textarea name="comment" rows="3" class="w-full border rounded-lg px-3 py-2" placeholder="メモや補足"></textarea>
      </div>
    </div>

    <div id="set-menu-section" class="border-t pt-4 hidden">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">セットに含めるメニュー</h3>
        <button type="button" id="openSetMenuModal" class="px-3 py-1.5 rounded border text-sm bg-blue-50 border-blue-300 text-blue-800 hover:bg-blue-100">＋ メニューを追加</button>
      </div>
      <div id="setMenuList" class="mt-2 space-y-2 text-sm text-gray-500">メニューを追加してください</div>
      <p class="text-xs text-gray-500 mt-1">セットメニューや自分自身は追加できません。</p>
    </div>

    <!-- 食材登録 -->
    <div class="border-t pt-4" id="ingredients-section">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">食材</h3>
        <button type="button" id="openIngModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 食材を追加</button>
      </div>
      <div id="ingredientsList" class="mt-2 space-y-2"></div>
    </div>

    <!-- 調味料登録 -->
    <div class="border-t pt-4" id="seasonings-section">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">調味料</h3>
        <button type="button" id="openSeaModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 調味料を追加</button>
      </div>
      <div id="seasoningsList" class="mt-2 space-y-2"></div>
    </div>

    <div class="border-t pt-4">
      <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <span class="text-sm font-semibold text-gray-700">基本メニュー</span>
          <label class="inline-flex items-center gap-2 font-medium cursor-pointer">
            <input type="hidden" name="basicMenu" value="false">
            <input type="checkbox" name="basicMenu" value="true" class="toggle-input sr-only" <%= (typeof prefillOriginal !== 'undefined' && prefillOriginal && prefillOriginal.basicMenu) ? 'checked' : '' %>/>
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>基本メニューにする</span>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <span class="text-sm font-semibold text-gray-700">つくりおき</span>
          <label class="inline-flex items-center gap-2 font-medium cursor-pointer">
            <input type="hidden" name="makeAhead" value="false">
            <input type="checkbox" name="makeAhead" value="true" class="toggle-input sr-only" <%= (typeof prefillOriginal !== 'undefined' && prefillOriginal && prefillOriginal.makeAhead) ? 'checked' : '' %>/>
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>つくりおき向き</span>
          </label>
        </div>
        <!-- 上段: お気に入り 行 -->
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium cursor-pointer">
            <input type="hidden" name="favorite" value="false">
            <input type="checkbox" name="favorite" value="true" class="toggle-input sr-only" checked/>
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>♡ お気に入り</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">食べたい頻度
            <select name="frequency" class="border rounded px-2 py-1">
              <option value="5">5 … 週に2回</option>
              <option value="4">4 … 週に1回</option>
              <option value="3" selected>3 … 隔週に1回</option>
              <option value="2">2 … 月に1回</option>
              <option value="1">1 … 3ヶ月に1回</option>
            </select>
          </label>
        </div>

        <!-- 下段: 共有 行 -->
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="hidden" name="share" value="false">
            <input type="checkbox" name="share" value="true" class="toggle-input sr-only" checked/>
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>共有する</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">共有範囲
            <select name="shareScope" class="border rounded px-2 py-1">
              <option value="group">グループ内</option>
              <option value="all" selected>全会員</option>
              <option value="public">一般公開</option>
            </select>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <span class="text-sm font-semibold text-gray-700">非表示にする</span>
          <label class="inline-flex items-center gap-2 font-medium cursor-pointer">
            <input type="hidden" name="hidden" value="false">
            <input type="checkbox" name="hidden" value="true" class="toggle-input sr-only" <%= (typeof prefillOriginal !== 'undefined' && prefillOriginal && prefillOriginal.hidden) ? 'checked' : '' %>>
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>一覧で非表示</span>
          </label>
        </div>
      </div>
    </div>

    <div class="pt-2">
      <button class="px-5 py-2 rounded-lg bg-emerald-600 text-white font-semibold">登録する</button>
    </div>
  </form>
</section>

<script>
  // Upload to Cloudinary then preview
  const fileInput = document.getElementById('imageFileInput');
  const urlInput = document.getElementById('imageUrlInput');
  const preview = document.getElementById('imgPreview');
  fileInput?.addEventListener('change', async () => {
    if (!fileInput.files || !fileInput.files[0]) return;
    const fd = new FormData();
    fd.append('image', fileInput.files[0]);
    try {
      const res = await fetch('/users/my-menu/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (data.url) {
        urlInput.value = data.url;
        if (preview) preview.src = data.url;
      } else {
        alert('アップロードに失敗しました');
      }
    } catch (e) {
      console.error(e);
      alert('アップロードに失敗しました');
    } finally {
      fileInput.value = '';
    }
  });
  // Live preview when editing URL directly
  urlInput?.addEventListener('input', () => {
    if (preview) preview.src = urlInput.value.trim();
  });

  // Build dynamic ingredient/seasoning rows (from-url と同等)
  const ING = <%- JSON.stringify(((ingredients||[])).map(i=>({id:String(i._id), name:i.ingredient, units:i.unit||[], genre:i.classification||''}))) %>;
  const SEAS = <%- JSON.stringify(((seasonings||[])).map(s=>({id:String(s._id), name:s.seasoning, units:s.unit||[], genre:s.classification||''}))) %>;
  const UNITS = <%- JSON.stringify(allUnits||[]) %>;

  function createRow(kind, item){
    const wrap = document.createElement('div');
    wrap.className = 'flex gap-2 items-center';
    const labelBox = document.createElement('div');
    labelBox.className = 'flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2';
    const title = document.createElement('span'); title.className='text-sm font-medium'; title.textContent = item?.name || '';
    const badge = document.createElement('span'); badge.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; badge.textContent = item?.genre || '';
    labelBox.appendChild(title); if (item?.genre) labelBox.appendChild(badge);
    const hiddenId = document.createElement('input'); hiddenId.type='hidden'; hiddenId.value = item?.id || '';
    const amount = document.createElement('input');
    amount.type = 'number'; amount.step = '0.1'; amount.min = '0';
    amount.className = 'w-24 border rounded px-2 py-1';
    let unitEl;
    if (item && Array.isArray(item.units) && item.units.length) {
      unitEl = document.createElement('select');
      unitEl.className = 'w-28 border rounded px-2 py-1';
      item.units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); });
    } else {
      unitEl = document.createElement('input'); unitEl.setAttribute('list','unitList'); unitEl.className='w-24 border rounded px-2 py-1';
    }
    const del = document.createElement('button');
    del.type = 'button'; del.textContent = '削除'; del.className = 'px-2 py-1 text-xs border rounded';
    del.addEventListener('click', ()=> wrap.remove());

    if (kind==='ingredient'){
      hiddenId.name='ingredient_ids[]'; amount.name='ingredient_amounts[]'; unitEl.name='ingredient_units[]';
    } else {
      hiddenId.name='seasoning_ids[]'; amount.name='seasoning_amounts[]'; unitEl.name='seasoning_units[]';
    }
    wrap.append(labelBox, hiddenId, amount, unitEl, del);
    return wrap;
  }

  const unitDL = document.createElement('datalist');
  unitDL.id = 'unitList';
  (UNITS||[]).forEach(u=>{ const op=document.createElement('option'); op.value=u; unitDL.appendChild(op); });
  document.body.appendChild(unitDL);
</script>

<script>
  const setMenuCandidates = <%- JSON.stringify(setMenuCandidates || []) %>;

  function setSectionEnabled(sectionId, enabled) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    section.classList.toggle('hidden', !enabled);
    section.querySelectorAll('input, select, textarea, button').forEach((el) => {
      if (el.id === 'openSetMenuModal') return;
      if (enabled) {
        el.removeAttribute('disabled');
      } else {
        el.setAttribute('disabled', 'disabled');
      }
    });
  }

  function toggleRequired(inputSelector, isRequired) {
    const input = document.querySelector(inputSelector);
    if (!input) return;
    if (isRequired) input.setAttribute('required', 'required');
    else input.removeAttribute('required');
  }

  function applyMenuTypeState() {
    const checked = document.querySelector('input[name="menuType"]:checked');
    const isSet = checked && checked.value === 'set';
    setSectionEnabled('set-type-section', isSet);
    setSectionEnabled('set-menu-section', isSet);
    setSectionEnabled('image-section', !isSet);
    setSectionEnabled('seasonings-section', !isSet);
    setSectionEnabled('ingredients-section', true);
    toggleRequired('#imageUrlInput', !isSet);
    toggleRequired('textarea[name=\"instruction\"]', !isSet);
    // setType validation handled on submit (checkbox group)
  }

  const setMenuState = { selected: new Map() };

  function normalizeText(value) {
    return String(value || '').toLowerCase();
  }

  function matchKeyword(item, keyword) {
    if (!keyword) return true;
    const text = [item.name, item.menu, item.kind, item.junle, item.cook].map(normalizeText).join(' ');
    return text.includes(keyword);
  }

  function renderSetMenuList() {
    const listEl = document.getElementById('setMenuList');
    if (!listEl) return;
    const values = Array.from(setMenuState.selected.values());
    if (!values.length) {
      listEl.textContent = 'メニューを追加してください';
      return;
    }
    listEl.innerHTML = '';
    values.forEach((item) => {
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-wrap items-center gap-3 border border-gray-200 rounded p-2 bg-gray-50';

      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'set_menu_ids[]';
      hidden.value = item._id;
      wrap.appendChild(hidden);

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        wrap.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        wrap.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'min-w-[180px]';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      wrap.appendChild(info);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'ml-auto px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', () => {
        setMenuState.selected.delete(item._id);
        renderSetMenuList();
        renderSetMenuResults();
      });
      wrap.appendChild(removeBtn);

      listEl.appendChild(wrap);
    });
  }

  function renderSetMenuResults() {
    const resultsEl = document.getElementById('set-menu-results');
    if (!resultsEl) return;
    const keyword = normalizeText(document.getElementById('set-menu-keyword')?.value || '');
    const menuFilter = document.getElementById('set-menu-filter-menu')?.value || '';
    const kindFilter = document.getElementById('set-menu-filter-kind')?.value || '';
    const junleFilter = document.getElementById('set-menu-filter-junle')?.value || '';
    const cookFilter = document.getElementById('set-menu-filter-cook')?.value || '';

    const filtered = setMenuCandidates.filter((item) => {
      if (item.menuType === 'set') return false;
      if (menuFilter && item.menu !== menuFilter) return false;
      if (kindFilter && item.kind !== kindFilter) return false;
      if (junleFilter && item.junle !== junleFilter) return false;
      if (cookFilter && item.cook !== cookFilter) return false;
      return matchKeyword(item, keyword);
    });

    resultsEl.innerHTML = '';
    if (!filtered.length) {
      const empty = document.createElement('div');
      empty.className = 'text-sm text-gray-500';
      empty.textContent = '条件に一致するメニューがありません。';
      resultsEl.appendChild(empty);
      return;
    }

    filtered.forEach((item) => {
      const row = document.createElement('label');
      row.className = 'flex items-start gap-3 border rounded p-2 bg-white hover:bg-gray-50 cursor-pointer';

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.className = 'mt-1 w-4 h-4 text-blue-600 border-gray-300';
      checkbox.checked = setMenuState.selected.has(item._id);
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) setMenuState.selected.set(item._id, item);
        else setMenuState.selected.delete(item._id);
        renderSetMenuList();
      });
      row.appendChild(checkbox);

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        row.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        row.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'flex-1';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      row.appendChild(info);

      resultsEl.appendChild(row);
    });
  }

  function openSetMenuModal() {
    const modal = document.getElementById('set-menu-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    renderSetMenuResults();
  }

  function closeSetMenuModal() {
    const modal = document.getElementById('set-menu-modal');
    if (!modal) return;
    modal.classList.add('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input[name=\"menuType\"]').forEach((el) => {
      el.addEventListener('change', applyMenuTypeState);
    });
    applyMenuTypeState();

    const openBtn = document.getElementById('openSetMenuModal');
    const closeBtn = document.getElementById('set-menu-close');
    const applyBtn = document.getElementById('set-menu-apply');
    const overlay = document.getElementById('set-menu-overlay');
    if (openBtn) openBtn.addEventListener('click', openSetMenuModal);
    if (closeBtn) closeBtn.addEventListener('click', closeSetMenuModal);
    if (applyBtn) applyBtn.addEventListener('click', closeSetMenuModal);
    if (overlay) overlay.addEventListener('click', closeSetMenuModal);

    ['set-menu-keyword','set-menu-filter-menu','set-menu-filter-kind','set-menu-filter-junle','set-menu-filter-cook']
      .forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', renderSetMenuResults);
        el.addEventListener('change', renderSetMenuResults);
      });

    renderSetMenuList();

    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', (e) => {
        const checked = document.querySelector('input[name="menuType"]:checked');
        const isSet = checked && checked.value === 'set';
        if (!isSet) return;
        const any = Array.from(document.querySelectorAll('input[name="setType[]"]')).some((el) => el.checked);
        if (!any) {
          e.preventDefault();
          alert('セット種別を1つ以上選択してください。');
        }
      });
    }
  });
</script>

