<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">オリジナルレシピの登録</h1>
      <p class="text-sm text-gray-500">基本レイアウトをレシピサイト登録と統一</p>
    </div>
    <a href="/users/my-menu" class="text-sm text-blue-600 font-semibold">マイメニュートップへ</a>
  </header>

  <p class="text-xs text-gray-500">登録件数: <%= typeof myOriginalCount !== 'undefined' ? myOriginalCount : 0 %></p>

  <form method="post" action="/users/my-menu/original" class="bg-white border rounded-2xl p-5 space-y-4">
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs text-gray-500">レシピ名</label>
        <input name="name" class="w-full border rounded-lg px-3 py-2" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">よみ</label>
        <input name="yomi" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="text-xs text-gray-500">メニュー（自由入力）</label>
        <input name="menu" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="text-xs text-gray-500">種類</label>
        <input list="kindList" name="kind" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="kindList">
          <% (kinds||[]).forEach(function(k){ %>
            <option value="<%= k %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">ジャンル</label>
        <input list="junleList" name="junle" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="junleList">
          <% (junles||[]).forEach(function(j){ %>
            <option value="<%= j %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理方法</label>
        <input list="cookList" name="cook" class="w-full border rounded-lg px-3 py-2" />
        <datalist id="cookList">
          <% (cooks||[]).forEach(function(c){ %>
            <option value="<%= c %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-gray-500">画像URL（プレビューあり）</label>
        <div class="flex gap-3 items-start">
          <input name="imageUrl" id="imageUrlInput" class="flex-1 border rounded-lg px-3 py-2" />
          <label class="px-3 py-2 border rounded-lg cursor-pointer text-sm whitespace-nowrap">画像選択
            <input id="imageFileInput" type="file" accept="image/*" class="hidden" />
          </label>
          <img id="imgPreview" src="" alt="preview" class="w-24 h-24 object-cover rounded border" />
        </div>
        <p class="text-[11px] text-gray-500 mt-1">ファイル選択後、自動でCloudinaryへアップロードします</p>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理時間（分）</label>
        <input name="time" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label class="text-xs text-gray-500">人数</label>
        <input name="people" type="number" min="1" step="1" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-gray-500">作り方</label>
        <textarea name="instruction" rows="6" class="w-full border rounded-lg px-3 py-2" placeholder="手順を記入"></textarea>
      </div>
      <div class="md:col-span-2">
        <label class="text-xs text-gray-500">コメント</label>
        <textarea name="comment" rows="3" class="w-full border rounded-lg px-3 py-2" placeholder="メモや補足"></textarea>
      </div>
    </div>

    <!-- 食材登録 -->
    <div class="border-t pt-4">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold">食材</h3>
        <button type="button" id="openIngModal" class="px-3 py-1.5 rounded border text-sm">＋ 食材を追加</button>
      </div>
      <div id="ingredientsList" class="mt-2 space-y-2"></div>
    </div>

    <!-- 調味料登録 -->
    <div class="border-t pt-4">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold">調味料</h3>
        <button type="button" id="openSeaModal" class="px-3 py-1.5 rounded border text-sm">＋ 調味料を追加</button>
      </div>
      <div id="seasoningsList" class="mt-2 space-y-2"></div>
    </div>

    <div class="border-t pt-4">
      <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
        <!-- 上段: お気に入り 行 -->
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="favorite" value="true" checked class="w-4 h-4"/>
            <span>♡ お気に入り</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">食べたい頻度
            <select name="frequency" class="border rounded px-2 py-1">
              <% [5,4,3,2,1].forEach(function(i){ %>
                <option value="<%= i %>"><%= i %><% if (i===5) { %>（高い）<% } else if (i===1) { %>（低い）<% } %></option>
              <% }) %>
            </select>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="skill" value="true" class="w-4 h-4"/>
            <span>得意</span>
          </label>
        </div>

        <!-- 下段: 共有 行 -->
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="share" value="true" class="w-4 h-4"/>
            <span>共有する</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">共有範囲
            <select name="shareScope" class="border rounded px-2 py-1">
              <option value="group">グループ内</option>
              <option value="all">全会員</option>
            </select>
          </label>
        </div>
      </div>
    </div>

    <div class="pt-2">
      <button class="px-5 py-2 rounded-lg bg-emerald-600 text-white font-semibold">登録する</button>
    </div>
  </form>
</section>

<script>
  // Upload to Cloudinary then preview
  const fileInput = document.getElementById('imageFileInput');
  const urlInput = document.getElementById('imageUrlInput');
  const preview = document.getElementById('imgPreview');
  fileInput?.addEventListener('change', async () => {
    if (!fileInput.files || !fileInput.files[0]) return;
    const fd = new FormData();
    fd.append('image', fileInput.files[0]);
    try {
      const res = await fetch('/users/my-menu/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (data.url) {
        urlInput.value = data.url;
        if (preview) preview.src = data.url;
      } else {
        alert('アップロードに失敗しました');
      }
    } catch (e) {
      console.error(e);
      alert('アップロードに失敗しました');
    } finally {
      fileInput.value = '';
    }
  });
  // Live preview when editing URL directly
  urlInput?.addEventListener('input', () => {
    if (preview) preview.src = urlInput.value.trim();
  });

  // Build dynamic ingredient/seasoning rows (from-url と同等)
  const ING = <%- JSON.stringify(((ingredients||[])).map(i=>({id:String(i._id), name:i.ingredient, units:i.unit||[], genre:i.classification||''}))) %>;
  const SEAS = <%- JSON.stringify(((seasonings||[])).map(s=>({id:String(s._id), name:s.seasoning, units:s.unit||[], genre:s.classification||''}))) %>;
  const UNITS = <%- JSON.stringify(allUnits||[]) %>;

  function createRow(kind, item){
    const wrap = document.createElement('div');
    wrap.className = 'flex gap-2 items-center';
    const labelBox = document.createElement('div');
    labelBox.className = 'flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2';
    const title = document.createElement('span'); title.className='text-sm font-medium'; title.textContent = item?.name || '';
    const badge = document.createElement('span'); badge.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; badge.textContent = item?.genre || '';
    labelBox.appendChild(title); if (item?.genre) labelBox.appendChild(badge);
    const hiddenId = document.createElement('input'); hiddenId.type='hidden'; hiddenId.value = item?.id || '';
    const amount = document.createElement('input');
    amount.type = 'number'; amount.step = '0.1'; amount.min = '0';
    amount.className = 'w-24 border rounded px-2 py-1';
    let unitEl;
    if (item && Array.isArray(item.units) && item.units.length) {
      unitEl = document.createElement('select');
      unitEl.className = 'w-28 border rounded px-2 py-1';
      item.units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); });
    } else {
      unitEl = document.createElement('input'); unitEl.setAttribute('list','unitList'); unitEl.className='w-24 border rounded px-2 py-1';
    }
    const del = document.createElement('button');
    del.type = 'button'; del.textContent = '削除'; del.className = 'px-2 py-1 text-xs border rounded';
    del.addEventListener('click', ()=> wrap.remove());

    if (kind==='ingredient'){
      hiddenId.name='ingredient_ids[]'; amount.name='ingredient_amounts[]'; unitEl.name='ingredient_units[]';
    } else {
      hiddenId.name='seasoning_ids[]'; amount.name='seasoning_amounts[]'; unitEl.name='seasoning_units[]';
    }
    wrap.append(labelBox, hiddenId, amount, unitEl, del);
    return wrap;
  }

  const unitDL = document.createElement('datalist');
  unitDL.id = 'unitList';
  (UNITS||[]).forEach(u=>{ const op=document.createElement('option'); op.value=u; unitDL.appendChild(op); });
  document.body.appendChild(unitDL);
</script>

<script>
  // Modal-based selector（from-url と同等の検索UI）
  (function(){
    function buildSearchModal(type){
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 z-50 hidden';
      modal.innerHTML = `
        <div class=\"absolute inset-0 bg-black/40\" data-close></div>
        <div class=\"relative mx-auto mt-16 w-[720px] max-w-[92vw] rounded-2xl bg-white shadow-xl\">
          <div class=\"flex items-center justify-between border-b px-5 py-3\">
            <h3 class=\"font-semibold\">${type==='ingredient' ? '食材を追加' : '調味料を追加'}</h3>
            <button type=\"button\" data-close class=\"text-gray-500\">✕</button>
          </div>
          <div class=\"p-4 space-y-3\">
            <input data-role=\"kw\" placeholder=\"名前で検索...\" class=\"w-full border rounded px-3 py-2\"/>
            <div class=\"flex gap-2 items-end\">
              <input data-role=\"genre\" placeholder=\"ジャンル\" class=\"border rounded px-2 py-1\" />
            </div>
            <div data-role=\"results\" class=\"max-h-[50vh] overflow-auto divide-y\"></div>
          </div>
        </div>`;
      document.body.appendChild(modal);
      function close(){ modal.classList.add('hidden'); }
      modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });
      async function doSearch(params){
        const base = type==='ingredient' ? '/users/my-menu/api/ingredients' : '/users/my-menu/api/seasonings';
        const url = new URL(base, location.origin);
        Object.entries(params||{}).forEach(([k,v])=>{ if (v) url.searchParams.set(k, v); });
        const res = await fetch(url.toString());
        return res.json();
      }
      async function run(){
        const kw = modal.querySelector('[data-role="kw"]').value.trim();
        const gn = modal.querySelector('[data-role="genre"]').value.trim();
        const params = { keyword: kw, genre: gn };
        const data = await doSearch(params);
        const holder = modal.querySelector('[data-role="results"]'); holder.innerHTML='';
        (data||[]).forEach(item=>{
          const name = item.ingredient || item.seasoning || '';
          const classification = item.classification || '';
          const units = Array.isArray(item.unit) ? item.unit.join(', ') : (item.unit||'');
          const row = document.createElement('button'); row.type='button'; row.className='w-full text-left px-3 py-2 hover:bg-gray-50';
          row.innerHTML = `<div class=\"text-sm font-semibold\">${name} <span class=\"ml-2 text-xs text-gray-500\">${classification}</span></div>
                           <div class=\"text-xs text-gray-500\">単位: ${units}　${item.short_nutrition||''}</div>`;
          row.addEventListener('click', ()=>{
            const wrap = createRow(type, { id: String(item._id), name, genre: classification, units: Array.isArray(item.unit)? item.unit: (item.unit? [item.unit]: []) });
            if (type==='ingredient') document.getElementById('ingredientsList').appendChild(wrap);
            else document.getElementById('seasoningsList').appendChild(wrap);
            close();
          });
          holder.appendChild(row);
        });
      }
      const kwInput = modal.querySelector('[data-role="kw"]');
      const gnInput = modal.querySelector('[data-role="genre"]');
      // Avoid blur-triggered rerender that cancels first click
      function debounce(fn, ms){ let t; return (...args)=>{ clearTimeout(t); t = setTimeout(()=>fn(...args), ms); }; }
      const debouncedRun = debounce(run, 200);
      const trigger = (e)=>{ if (!e.isComposing) debouncedRun(); };
      kwInput.addEventListener('input', trigger);
      gnInput.addEventListener('input', trigger);
      kwInput.addEventListener('keydown', (e)=>{ if (e.key==='Enter') { e.preventDefault(); run(); }});
      gnInput.addEventListener('keydown', (e)=>{ if (e.key==='Enter') { e.preventDefault(); run(); }});
      kwInput.addEventListener('compositionend', debouncedRun);
      gnInput.addEventListener('compositionend', debouncedRun);
      return { open: ()=>{ modal.classList.remove('hidden'); run(); } };
    }
    const ingModal = buildSearchModal('ingredient');
    const seaModal = buildSearchModal('seasoning');
    document.getElementById('openIngModal')?.addEventListener('click', ()=>ingModal.open());
    document.getElementById('openSeaModal')?.addEventListener('click', ()=>seaModal.open());
  })();
</script>
