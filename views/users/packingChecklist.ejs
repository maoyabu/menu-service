<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold">パッキングプラン</h1>
      <p class="text-sm text-gray-600">旅行などのイベントの持ち物リストを作成して忘れ物がないようにチェック</p>
    </div>
  </header>

  <section class="space-y-2">
    <div class="relative min-h-[48px]">
      <button
        type="button"
        id="guide-toggle"
        class="absolute top-3 left-3 px-3 py-1.5 rounded border text-sm bg-white/90 text-gray-800 shadow-sm hover:bg-white"
      >非表示</button>
      <div id="guide-wrapper" class="border rounded-2xl bg-white overflow-hidden shadow-sm">
        <img src="/pict/packPlan.jpg" alt="パッキングプランガイド" class="w-full h-auto object-cover">
      </div>
    </div>
  </section>

  <section class="border rounded-2xl bg-white p-4 space-y-4">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-100">イベント一覧</span>
        <button type="button" id="event-filter-toggle" class="text-xs font-semibold text-blue-700 hover:text-blue-900">全てのイベントを表示</button>
      </div>
      <button type="button" id="event-add-open" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 whitespace-nowrap">イベントを追加</button>
    </div>
    <div id="event-list" class="grid gap-2 grid-cols-1 sm:grid-cols-2"></div>
    <div class="text-sm text-gray-500" id="event-empty">まだイベントがありません。追加してください。</div>
  </section>

  <div class="grid lg:grid-cols-2 gap-4">
    <section class="border rounded-2xl bg-white p-4 space-y-3">
      <div class="flex items-center justify-between gap-2">
        <div>
          <span class="px-2 py-1 text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-100">収納リスト</span>
          <p class="text-xs text-gray-500 mt-1">旅行用収納を登録・編集します</p>
        </div>
        <button type="button" id="storage-add-open" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">収納を追加</button>
      </div>
      <div id="storage-list" class="grid grid-cols-1 md:grid-cols-2 gap-2"></div>
      <div class="text-sm text-gray-500" id="storage-empty">収納がありません。追加してください。</div>
    </section>

    <section class="border rounded-2xl bg-white p-4 space-y-3">
      <div class="flex items-center justify-between gap-2">
        <div>
          <span class="px-2 py-1 text-xs font-semibold rounded-full bg-purple-50 text-purple-700 border border-purple-100">持ち物リスト</span>
          <p class="text-xs text-gray-500 mt-1">イベントとは別に持ち物を登録・編集します</p>
        </div>
        <button type="button" id="master-add-open" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">持ち物を追加</button>
      </div>
      <div id="owner-filter" class="flex flex-wrap gap-2 text-sm">
        <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
          <input type="checkbox" value="all" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
          <span>共有</span>
        </label>
        <% (members || []).forEach((m)=> { %>
          <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
            <input type="checkbox" value="<%= m.id %>" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
            <span><%= m.name %></span>
          </label>
        <% }) %>
      </div>
      <div id="master-item-list" class="grid grid-cols-1 md:grid-cols-2 gap-2"></div>
      <div class="text-sm text-gray-500" id="master-item-empty">持ち物がありません。追加してください。</div>
      <div class="flex justify-end">
        <button type="button" id="category-manage-open" class="px-3 py-1.5 rounded-lg border text-sm bg-white text-gray-800 hover:bg-gray-50">カテゴリー編集</button>
      </div>
    </section>
  </div>
</section>

<div id="event-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-10 w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900" id="event-modal-title">イベントを編集</h3>
      <button type="button" data-event-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <div class="space-y-3">
      <label class="block text-sm">イベント名
        <input type="text" id="modal-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
      </label>
      <div class="space-y-2">
        <p class="text-sm font-medium text-gray-800">参加メンバー</p>
        <div id="modal-participants" class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm"></div>
      </div>
    </div>
    <div class="flex justify-end gap-2">
      <button type="button" data-event-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="modal-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">保存</button>
    </div>
  </div>
</div>

<div id="event-delete-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-24 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">イベントを削除</h3>
      <button type="button" id="event-delete-close" class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <p class="text-sm text-gray-700">本当に削除しますか？このイベントの持ち物データも削除されます。</p>
    <p class="text-sm font-semibold text-gray-900" id="event-delete-name"></p>
    <div class="flex justify-end gap-2">
      <button type="button" id="event-delete-cancel" class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="event-delete-confirm" class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-semibold hover:bg-red-700">削除する</button>
    </div>
  </div>
</div>

<div id="storage-edit-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">収納を編集</h3>
      <button type="button" data-storage-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">収納名
      <input type="text" id="storage-edit-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </label>
    <label class="block text-sm">制限重量(g)
      <input type="number" min="0" id="storage-edit-weight" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </label>
    <div class="flex justify-end gap-2">
      <button type="button" data-storage-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="storage-edit-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">保存</button>
    </div>
  </div>
</div>

<div id="master-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-12 w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900" id="master-modal-title">持ち物を追加</h3>
      <button type="button" data-master-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <form id="master-modal-form" class="space-y-2">
      <label class="block text-sm">持ち物名
        <input type="text" name="name" required class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 着替え" />
      </label>
      <div class="grid sm:grid-cols-3 gap-2">
        <label class="block text-sm">誰のもの
          <select name="owner" id="master-owner" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
            <option value="all">共有</option>
            <% (members || []).forEach((m)=> { %>
              <option value="<%= m.id %>" <%= String(m.id) === String((user && user._id) || '') ? 'selected' : '' %>><%= m.name %></option>
            <% }) %>
          </select>
        </label>
        <label class="block text-sm">基準数量
          <input type="number" step="1" min="0" name="defaultQuantity" value="1" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
        </label>
        <label class="block text-sm">重量(g)
          <input type="number" step="1" min="0" name="defaultWeight" value="0" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
        </label>
      </div>
      <label class="block text-sm">カテゴリー
        <input type="text" list="category-datalist" name="category" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 衣類 / 洗面・メイク / ガジェット" />
      </label>
      <label class="block text-sm">コメント
        <input type="text" name="comment" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="メモ" />
      </label>
      <label class="inline-flex items-center gap-2 text-sm">
        <input type="checkbox" name="wish" id="master-wish" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
        <span>買い物リストに入れる（収納には入れません）</span>
      </label>
      <div class="flex justify-end gap-2">
        <button type="button" data-master-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">保存</button>
      </div>
    </form>
  </div>
</div>
<datalist id="category-datalist"></datalist>

<!-- カテゴリー編集モーダル -->
<div id="category-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-12 w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">カテゴリー編集</h3>
      <button type="button" data-category-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <div class="space-y-3">
      <div>
        <label class="text-sm font-medium text-gray-700">新しいカテゴリーを追加</label>
        <div class="flex gap-2 mt-1">
          <input type="text" id="category-add-input" class="flex-1 border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="カテゴリー名" />
          <button type="button" id="category-add-btn" class="px-3 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">追加</button>
        </div>
      </div>
      <div class="border rounded-lg p-3 bg-gray-50 space-y-2 max-h-80 overflow-y-auto" id="category-list"></div>
    </div>
    <p class="text-xs text-gray-500">カテゴリーを削除すると、そのカテゴリーが設定されている持ち物のカテゴリーは未登録になります。</p>
  </div>
</div>

<script>
  (function(){
    const events = <%- JSON.stringify(events || []) %>;
    const storages = <%- JSON.stringify(storages || []) %>;
    const masterItems = <%- JSON.stringify(masterItems || []) %>;
    let masterCategories = <%- JSON.stringify(masterCategories || []) %>;
    const members = <%- JSON.stringify(members || []) %>;
    const currentUserId = <%- JSON.stringify(currentUserId || '') %>;

  const eventList = document.getElementById('event-list');
  const eventEmpty = document.getElementById('event-empty');
  const eventFilterToggle = document.getElementById('event-filter-toggle');
  const storageList = document.getElementById('storage-list');
  const storageEmpty = document.getElementById('storage-empty');
  const masterItemList = document.getElementById('master-item-list');
  const masterItemEmpty = document.getElementById('master-item-empty');
  const guideWrapper = document.getElementById('guide-wrapper');
  const guideToggle = document.getElementById('guide-toggle');
  const ownerFilter = document.getElementById('owner-filter');
  const deleteModal = document.getElementById('event-delete-modal');
  const deleteName = document.getElementById('event-delete-name');
  const deleteConfirm = document.getElementById('event-delete-confirm');
  const deleteCancel = document.getElementById('event-delete-cancel');
  const deleteClose = document.getElementById('event-delete-close');
  let deleteTargetId = '';
  const EVENT_FILTER_KEY = 'packing:events:showAll';
  let showAllEvents = false;

  const eventAddOpen = document.getElementById('event-add-open');
  const storageAddOpen = document.getElementById('storage-add-open');
const masterItemForm = document.getElementById('master-modal-form');

    const modal = document.getElementById('event-modal');
    const modalTitle = document.getElementById('event-modal-title');
    const modalName = document.getElementById('modal-name');
    const modalParticipants = document.getElementById('modal-participants');
    const modalSave = document.getElementById('modal-save');
    let modalEventId = '';
    let modalParticipantsChecked = [];

    const storageEditModal = document.getElementById('storage-edit-modal');
    const storageEditName = document.getElementById('storage-edit-name');
    const storageEditWeight = document.getElementById('storage-edit-weight');
  const storageEditSave = document.getElementById('storage-edit-save');
  let storageEditId = '';

  const masterModal = document.getElementById('master-modal');
  const masterModalTitle = document.getElementById('master-modal-title');
  const masterAddOpen = document.getElementById('master-add-open');
  const categoryDatalist = document.getElementById('category-datalist');
  const masterOwner = document.getElementById('master-owner');
  const masterWish = document.getElementById('master-wish');
  let masterEditId = '';
  const OWNER_KEY = 'packing:master:owners';
  const categoryModal = document.getElementById('category-modal');
  const categoryListEl = document.getElementById('category-list');
  const categoryAddInput = document.getElementById('category-add-input');
  const categoryAddBtn = document.getElementById('category-add-btn');
  const categoryManageOpen = document.getElementById('category-manage-open');

    function toast(msg){
      if (!msg) return;
      try {
        const el = document.createElement('div');
        el.textContent = msg;
        el.className = 'fixed bottom-4 right-4 bg-gray-900 text-white text-sm px-3 py-2 rounded shadow';
        document.body.appendChild(el);
        setTimeout(()=> el.remove(), 2000);
      } catch(_) { alert(msg); }
    }

    function renderEventList(){
      if (!eventList) return;
      eventList.innerHTML = '';
      const filtered = showAllEvents || !currentUserId
        ? events
        : events.filter((ev)=> (ev.participants || []).includes(currentUserId));
      if (!filtered.length){
        eventEmpty.classList.remove('hidden');
        return;
      }
      eventEmpty.classList.add('hidden');
      filtered.forEach((ev)=>{
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between border-2 border-blue-200 rounded-xl px-3 py-3 bg-white shadow-sm';
        row.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="flex items-center gap-2">
              <button type="button" class="text-left text-sm font-semibold text-blue-700 hover:underline" data-event-edit="${ev.id}">${ev.name} のパッキングプラン</button>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full border border-gray-200 bg-gray-50 text-[11px] text-gray-700 whitespace-nowrap">参加 ${(ev.participants||[]).length} 人</span>
            </span>
          </div>
          <div class="flex flex-col md:flex-row gap-2 md:gap-3 items-end md:items-center">
            <a href="/users/packing/${encodeURIComponent(ev.id)}" class="px-3 py-1 rounded-lg border border-orange-600 text-sm text-white bg-orange-500 hover:bg-orange-600 whitespace-nowrap w-full md:w-auto text-center shadow-sm">編集</a>
            <button type="button" class="p-2 rounded-lg border border-green-200 text-green-700 bg-green-50 hover:bg-green-100 w-full md:w-auto" aria-label="チェックリスト" onclick="window.location.href='/users/packing/check/${encodeURIComponent(ev.id)}'">
              <i data-lucide="clipboard-check" class="w-4 h-4"></i>
            </button>
            <button type="button" class="p-2 rounded-lg border border-red-200 text-red-700 bg-red-50 hover:bg-red-100 w-full md:w-auto" data-event-delete="${ev.id}" aria-label="削除">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        `;
        eventList.appendChild(row);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function renderStorageList(){
      if (!storageList) return;
      storageList.innerHTML = '';
      if (!storages.length){
        storageEmpty.classList.remove('hidden');
        return;
      }
      storageEmpty.classList.add('hidden');
      storages.forEach((s)=>{
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 border-2 border-gray-300 rounded-xl px-4 py-3 bg-slate-50 shadow-md';
        row.innerHTML = `
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm text-gray-900">${s.name}</p>
            <p class="text-xs text-gray-500">制限重量: ${s.maxWeight || 0} g</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="text-gray-600 hover:text-gray-800" data-storage-edit="${s.id}" aria-label="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
            <button type="button" class="text-red-600 hover:text-red-800" data-storage-del="${s.id}" aria-label="削除"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
          </div>
        `;
        storageList.appendChild(row);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    
function renderCategoryDatalist(){
      if (!categoryDatalist) return;
      categoryDatalist.innerHTML = '';
      Array.from(new Set(masterCategories || [])).forEach((c)=> {
        const opt = document.createElement('option');
        opt.value = c;
        categoryDatalist.appendChild(opt);
      });
    }

    function openCategoryModal(){
      if (!categoryModal) return;
      renderCategoryManageList();
      categoryModal.classList.remove('hidden'); categoryModal.classList.add('flex');
      if (window.refreshLucideIcons) window.refreshLucideIcons();
      categoryAddInput?.focus();
    }
    function closeCategoryModal(){
      categoryModal?.classList.add('hidden'); categoryModal?.classList.remove('flex');
      if (categoryAddInput) categoryAddInput.value = '';
    }

    async function patchCategoryForItems(targetCategory, nextCategory){
      const targets = masterItems.filter((m)=> (m.category || '').trim() === targetCategory);
      for (const item of targets){
        try{
          const res = await fetch(`/users/packing/api/master-items/${encodeURIComponent(item.id)}`, {
            method:'PATCH',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify({ category: nextCategory })
          });
          if (!res.ok) throw new Error();
          const json = await res.json();
          item.category = json.category || '';
        }catch(_) { /* best effort */ }
      }
      masterCategories = Array.from(new Set(masterItems.map((m)=> (m.category || '').trim()).filter(Boolean)));
      renderCategoryDatalist();
      renderMasterItemList();
    }

    function renderCategoryManageList(){
      if (!categoryListEl) return;
      categoryListEl.innerHTML = '';
      const list = Array.from(new Set(masterCategories || [])).sort((a,b)=> a.localeCompare(b,'ja'));
      if (!list.length){
        const empty = document.createElement('p');
        empty.className = 'text-sm text-gray-500';
        empty.textContent = 'まだカテゴリーがありません。追加してください。';
        categoryListEl.appendChild(empty);
        return;
      }
      list.forEach((cat)=>{
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2 bg-white border rounded-lg px-3 py-2';
        const name = document.createElement('input');
        name.type = 'text';
        name.value = cat;
        name.className = 'flex-1 border rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200';
        const saveBtn = document.createElement('button');
        saveBtn.type = 'button';
        saveBtn.className = 'px-2 py-1 text-sm rounded border bg-blue-50 text-blue-700 hover:bg-blue-100';
        saveBtn.textContent = '保存';
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'px-2 py-1 text-sm rounded border bg-red-50 text-red-700 hover:bg-red-100';
        delBtn.textContent = '削除';
        saveBtn.addEventListener('click', async ()=>{
          const next = (name.value || '').trim();
          if (!next || next === cat) return;
          await patchCategoryForItems(cat, next);
          toast('カテゴリー名を更新しました');
          renderCategoryManageList();
        });
        delBtn.addEventListener('click', async ()=>{
          if (!confirm(`「${cat}」を削除し、紐付く持ち物のカテゴリーを未登録にします。よろしいですか？`)) return;
          await patchCategoryForItems(cat, '');
          toast('カテゴリーを削除しました');
          renderCategoryManageList();
        });
        row.appendChild(name);
        row.appendChild(saveBtn);
        row.appendChild(delBtn);
        categoryListEl.appendChild(row);
      });
    }

    function restoreOwnerSelections(){
      if (!ownerFilter) return;
      try{
        const saved = JSON.parse(localStorage.getItem(OWNER_KEY) || '[]');
        if (Array.isArray(saved) && saved.length){
          ownerFilter.querySelectorAll('input[type="checkbox"]').forEach((cb)=> {
            cb.checked = saved.includes(cb.value);
          });
        }
      } catch(_) {}
    }
    function saveOwnerSelections(){
      if (!ownerFilter) return;
      try{
        const checked = Array.from(ownerFilter.querySelectorAll('input[type="checkbox"]:checked')).map(cb=> cb.value);
        localStorage.setItem(OWNER_KEY, JSON.stringify(checked));
      } catch(_) {}
    }

function renderMasterItemList(){
      if (!masterItemList) return;
      masterItemList.innerHTML = '';
      if (!masterItems.length){
        masterItemEmpty.classList.remove('hidden');
        return;
      }
      masterItemEmpty.classList.add('hidden');
      const checkedOwners = Array.from(ownerFilter?.querySelectorAll('input[type="checkbox"]:checked') || []).map(el=> el.value);
      const hasOwnerSelection = checkedOwners.length > 0;
      const grouped = {};
      masterItems
        .filter(it=> {
          if (!hasOwnerSelection) return false;
          if (checkedOwners.includes('all') && it.owner === 'all') return true;
          return checkedOwners.includes(it.owner);
        })
        .forEach(it => {
        const cat = (it.category || '').trim() || '未分類';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(it);
      });
      const cats = Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja'));
      cats.forEach(cat=>{
        const section = document.createElement('div');
        section.className = 'space-y-2';
        const title = document.createElement('div');
        title.className = 'text-xs font-semibold text-gray-700';
        title.textContent = cat;
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-wrap gap-2';
        grouped[cat].forEach((it)=>{
          const tag = document.createElement('div');
          const wishClass = it.wish ? 'bg-gray-100 border-gray-300' : 'bg-white';
          tag.className = `inline-flex items-center gap-1 px-2 py-1 rounded-full border text-sm shadow-sm ${wishClass}`;
          tag.innerHTML = `
            ${it.wish ? '<span class="text-[10px] font-semibold text-gray-600 bg-gray-200 px-1 rounded">買い物</span>' : ''}
            <span class="font-semibold text-gray-900 cursor-pointer" title="クリックで編集" data-master-edit="${it.id}">${it.name}</span>
            <button type="button" class="text-blue-600 hover:text-blue-800" data-master-edit="${it.id}" aria-label="編集"><i data-lucide="pencil" class="w-4 h-4"></i></button>
            <button type="button" class="text-green-700 hover:text-green-900" data-master-clone="${it.id}" aria-label="複製"><i data-lucide="copy" class="w-4 h-4"></i></button>
            <button type="button" class="text-red-600 hover:text-red-800" data-master-del="${it.id}" aria-label="削除"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
          `;
          wrap.appendChild(tag);
        });
        section.appendChild(title);
        section.appendChild(wrap);
        masterItemList.appendChild(section);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    // Event edit modal
    function renderModalParticipants(){
      if (!modalParticipants) return;
      modalParticipants.innerHTML = '';
      members.forEach((m)=>{
        const wrap = document.createElement('label');
        wrap.className = 'flex items-center gap-2 border rounded-lg px-2 py-1';
        wrap.innerHTML = `<input type="checkbox" data-owner="${m.id}" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" ${modalParticipantsChecked.includes(m.id) ? 'checked' : ''} /><span class="truncate">${m.name}</span>`;
        modalParticipants.appendChild(wrap);
      });
    }
    modalParticipants?.addEventListener('change', (ev)=>{
      const cb = ev.target.closest('input[type="checkbox"][data-owner]');
      if (!cb) return;
      const id = cb.dataset.owner;
      if (cb.checked){
        if (!modalParticipantsChecked.includes(id)) modalParticipantsChecked.push(id);
      } else {
        modalParticipantsChecked = modalParticipantsChecked.filter((p)=> p !== id);
      }
    });
    function openEventModal(id){
      const ev = events.find((x)=> x.id === id);
      modalEventId = ev ? ev.id : '';
      modalName.value = ev ? ev.name || '' : '';
      modalParticipantsChecked = ev ? [...(ev.participants || [])] : [];
      if (modalTitle) modalTitle.textContent = ev ? 'イベントを編集' : 'イベントを追加';
      renderModalParticipants();
      modal?.classList.remove('hidden'); modal?.classList.add('flex');
    }
    function closeEventModal(){
      modal?.classList.add('hidden'); modal?.classList.remove('flex'); modalEventId='';
  }
    modal?.addEventListener('click', (ev)=> { if (ev.target === modal) closeEventModal(); });
    modal.querySelectorAll('[data-event-close]')?.forEach((b)=> b.addEventListener('click', closeEventModal));
    modalSave?.addEventListener('click', async ()=>{
      try{
        const payload = { name: modalName.value || '', participants: modalParticipantsChecked };
        if (modalEventId){
          const res = await fetch(`/users/packing/api/events/${encodeURIComponent(modalEventId)}`, {
            method:'PATCH',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('更新に失敗しました');
          const json = await res.json();
          const target = events.find((e)=> e.id === modalEventId);
          if (target){ target.name = json.name; target.participants = json.participants || []; }
          toast('イベントを更新しました');
        } else {
          const res = await fetch('/users/packing/api/events', {
            method:'POST',
            headers:{ 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('イベント作成に失敗しました');
          const json = await res.json();
          events.unshift({ ...json, id: json.id.toString() });
          toast('イベントを追加しました');
        }
        renderEventList();
        closeEventModal();
      }catch(e){ toast(e.message || '保存に失敗しました'); }
    });

    const GUIDE_KEY = 'packing:guide:hidden';
    function applyGuideVisibility(hidden){
      if (!guideWrapper) return;
      guideWrapper.classList.toggle('hidden', hidden);
      if (guideToggle){
        guideToggle.textContent = hidden ? 'ガイド表示' : '非表示';
        guideToggle.setAttribute('aria-pressed', hidden ? 'false' : 'true');
      }
      try { localStorage.setItem(GUIDE_KEY, hidden ? '1' : '0'); } catch(_) {}
    }
    try {
      const saved = localStorage.getItem(GUIDE_KEY);
      if (saved === '1') {
        applyGuideVisibility(true);
      } else {
        applyGuideVisibility(false);
      }
    } catch(_) {}
    guideToggle?.addEventListener('click', ()=> {
      const hidden = guideWrapper?.classList.contains('hidden');
      applyGuideVisibility(!hidden);
    });

    deleteCancel?.addEventListener('click', ()=> {
      deleteTargetId = '';
      deleteModal?.classList.add('hidden'); deleteModal?.classList.remove('flex');
    });
    deleteClose?.addEventListener('click', ()=> {
      deleteTargetId = '';
      deleteModal?.classList.add('hidden'); deleteModal?.classList.remove('flex');
    });
    deleteModal?.addEventListener('click', (ev)=> {
      if (ev.target === deleteModal){
        deleteTargetId = '';
        deleteModal.classList.add('hidden'); deleteModal.classList.remove('flex');
      }
    });
    deleteConfirm?.addEventListener('click', async ()=>{
      if (!deleteTargetId) return;
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(deleteTargetId)}`, { method:'DELETE' });
        if (!res.ok) throw new Error('削除に失敗しました');
        const idx = events.findIndex((e)=> e.id === deleteTargetId);
        if (idx >= 0) events.splice(idx,1);
        deleteTargetId = '';
        deleteModal?.classList.add('hidden'); deleteModal?.classList.remove('flex');
        renderEventList();
        toast('イベントを削除しました');
      }catch(e){ toast(e.message || '削除に失敗しました'); }
    });

    eventAddOpen?.addEventListener('click', ()=> openEventModal(null));
    function restoreEventFilter(){
      try{
        const saved = localStorage.getItem(EVENT_FILTER_KEY);
        showAllEvents = saved === '1';
      } catch(_) {}
      updateFilterButton();
    }
    function updateFilterButton(){
      if (!eventFilterToggle) return;
      eventFilterToggle.textContent = showAllEvents ? '参加イベントのみ表示' : '全てのイベントを表示';
      eventFilterToggle.className = 'text-xs font-semibold ' + (showAllEvents ? 'text-blue-900' : 'text-blue-700 hover:text-blue-900');
    }
    eventFilterToggle?.addEventListener('click', ()=> {
      showAllEvents = !showAllEvents;
      try{ localStorage.setItem(EVENT_FILTER_KEY, showAllEvents ? '1' : '0'); }catch(_){}
      updateFilterButton();
      renderEventList();
    });
    restoreEventFilter();

    // Event list click
    eventList?.addEventListener('click', (ev)=>{
      const btn = ev.target.closest('button[data-event-edit]');
      const del = ev.target.closest('button[data-event-delete]');
      if (btn) openEventModal(btn.dataset.eventEdit);
      if (del){
        deleteTargetId = del.dataset.eventDelete;
        const target = events.find((e)=> e.id === deleteTargetId);
        if (deleteName) deleteName.textContent = target ? `${target.name} のパッキングプラン` : '';
        deleteModal?.classList.remove('hidden'); deleteModal?.classList.add('flex');
      }
    });

    // Storage add/edit/delete
    storageAddOpen?.addEventListener('click', ()=>{
      storageEditId = '';
      storageEditName.value = '';
      storageEditWeight.value = 0;
      storageEditModal?.classList.remove('hidden'); storageEditModal?.classList.add('flex');
      storageEditName?.focus();
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    });
    storageList?.addEventListener('click', async (ev)=>{
      const editBtn = ev.target.closest('button[data-storage-edit]');
      const delBtn = ev.target.closest('button[data-storage-del]');
      if (editBtn){
        const id = editBtn.dataset.storageEdit;
        const target = storages.find((s)=> s.id === id); if (!target) return;
        storageEditId = id;
        storageEditName.value = target.name || '';
        storageEditWeight.value = target.maxWeight || 0;
        storageEditModal?.classList.remove('hidden'); storageEditModal?.classList.add('flex');
        if (window.refreshLucideIcons) window.refreshLucideIcons();
      } else if (delBtn){
        const id = delBtn.dataset.storageDel;
        if (!confirm('削除してよろしいですか？')) return;
        try{
          const res = await fetch(`/users/packing/api/storages/${encodeURIComponent(id)}`, { method:'DELETE' });
          if (!res.ok) throw new Error('削除に失敗しました');
          const idx = storages.findIndex((s)=> s.id === id);
          if (idx>=0) storages.splice(idx,1);
          renderStorageList();
          toast('削除しました');
        }catch(e){ toast(e.message || '削除に失敗しました'); }
      }
    });
    storageEditModal?.addEventListener('click', (ev)=> { if (ev.target === storageEditModal) { storageEditModal.classList.add('hidden'); storageEditModal.classList.remove('flex'); } });
    storageEditModal?.querySelectorAll('[data-storage-close]')?.forEach((b)=> b.addEventListener('click', ()=> { storageEditModal.classList.add('hidden'); storageEditModal.classList.remove('flex'); }));
    storageEditSave?.addEventListener('click', async ()=>{
      try{
        if (storageEditId){
          const res = await fetch(`/users/packing/api/storages/${encodeURIComponent(storageEditId)}`, { method:'PATCH', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ name: storageEditName.value || '', maxWeight: storageEditWeight.value || 0 }) });
          if (!res.ok) throw new Error('更新に失敗しました');
          const json = await res.json();
          const target = storages.find((s)=> s.id === storageEditId);
          if (target){ target.name = json.name; target.maxWeight = json.maxWeight || 0; }
          toast('更新しました');
        } else {
          const res = await fetch('/users/packing/api/storages', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ name: storageEditName.value || '', maxWeight: storageEditWeight.value || 0 }) });
          if (!res.ok) throw new Error('追加に失敗しました');
          const json = await res.json();
          storages.unshift({ id: json.id.toString(), name: json.name, maxWeight: json.maxWeight || 0 });
          toast('収納を追加しました');
        }
        renderStorageList();
        storageEditModal.classList.add('hidden'); storageEditModal.classList.remove('flex');
      }catch(e){ toast(e.message || '更新に失敗しました'); }
    });

    // Master items add/edit/delete
    function openMasterModal(target, opts = {}){
      const mode = opts.mode || (target ? 'edit' : 'create');
      masterModal?.classList.remove('hidden'); masterModal?.classList.add('flex');
      masterModalTitle.textContent = mode === 'clone' ? '持ち物を複製' : (target ? '持ち物を編集' : '持ち物を追加');
      masterEditId = target && mode !== 'clone' ? target.id : '';
      const form = masterItemForm;
      if (!form) return;
      form.name.value = target?.name || '';
      if (mode === 'clone'){
        form.owner.value = currentUserId || 'all';
      } else {
      form.owner.value = target?.owner || (masterOwner?.value || 'all');
      }
      form.defaultQuantity.value = (target && typeof target.defaultQuantity !== 'undefined') ? target.defaultQuantity : 1;
      form.defaultWeight.value = target?.defaultWeight || 0;
      if (form.category) form.category.value = target?.category || '';
      form.comment.value = target?.comment || '';
      if (masterWish) masterWish.checked = !!target?.wish;
      form.name.focus();
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    masterAddOpen?.addEventListener('click', ()=> openMasterModal(null));
    masterModal?.addEventListener('click', (ev)=> { if (ev.target === masterModal) { masterModal.classList.add('hidden'); masterModal.classList.remove('flex'); } });
    masterModal?.querySelectorAll('[data-master-close]')?.forEach((b)=> b.addEventListener('click', ()=> { masterModal.classList.add('hidden'); masterModal.classList.remove('flex'); }));

    masterItemForm?.addEventListener('submit', async (ev)=>{
      ev.preventDefault();
      const fd = new FormData(masterItemForm);
      const payload = Object.fromEntries(fd.entries());
      payload.wish = fd.has('wish');
      const isEdit = !!masterEditId;
      const url = isEdit ? `/users/packing/api/master-items/${encodeURIComponent(masterEditId)}` : '/users/packing/api/master-items';
      const method = isEdit ? 'PATCH' : 'POST';
      try{
        const res = await fetch(url, { method, headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error(isEdit ? '更新に失敗しました' : '追加に失敗しました');
        const json = await res.json();
        if (isEdit){
          const target = masterItems.find((m)=> m.id === masterEditId);
          if (target) Object.assign(target, { ...json, id: json.id.toString() });
          if (json.category && !masterCategories.includes(json.category)) masterCategories.push(json.category);
        } else {
          masterItems.unshift({ ...json, id: json.id.toString() });
          if (json.category && !masterCategories.includes(json.category)) masterCategories.push(json.category);
        }
        masterItemForm.reset();
        masterModal.classList.add('hidden'); masterModal.classList.remove('flex');
        renderCategoryDatalist();
        renderMasterItemList();
        toast(isEdit ? '更新しました' : '持ち物を追加しました');
      }catch(e){ toast(e.message || '保存に失敗しました'); }
    });

    masterItemList?.addEventListener('click', async (ev)=>{
      const delBtn = ev.target.closest('button[data-master-del]');
      const editBtn = ev.target.closest('button[data-master-edit]');
      const cloneBtn = ev.target.closest('button[data-master-clone]');
      const nameClick = ev.target.closest('span[data-master-edit]');
      if (delBtn){
        const id = delBtn.dataset.masterDel;
        if (!confirm('削除してよろしいですか？')) return;
        try{
          const res = await fetch(`/users/packing/api/master-items/${encodeURIComponent(id)}`, { method:'DELETE' });
          if (!res.ok) throw new Error('削除に失敗しました');
          const idx = masterItems.findIndex((m)=> m.id === id); if (idx>=0) masterItems.splice(idx,1);
          renderMasterItemList();
          toast('削除しました');
        }catch(e){ toast(e.message || '削除に失敗しました'); }
      } else if (editBtn){
        const id = editBtn.dataset.masterEdit;
        const target = masterItems.find((m)=> m.id === id); if (!target) return;
        openMasterModal(target);
      } else if (cloneBtn || nameClick){
        const id = (cloneBtn || nameClick).dataset.masterClone || (cloneBtn || nameClick).dataset.masterEdit;
        const target = masterItems.find((m)=> m.id === id);
        if (!target) return;
        if (cloneBtn){
          if (!confirm('この持ち物を複製しますか？')) return;
          openMasterModal(target, { mode: 'clone' });
        } else {
          openMasterModal(target);
        }
      }
    });

    renderEventList();
    renderStorageList();
    renderCategoryDatalist();
    restoreOwnerSelections();
    renderMasterItemList();
    ownerFilter?.addEventListener('change', ()=> { saveOwnerSelections(); renderMasterItemList(); });
    categoryManageOpen?.addEventListener('click', openCategoryModal);
    categoryModal?.addEventListener('click', (ev)=> { if (ev.target === categoryModal) closeCategoryModal(); });
    categoryModal?.querySelectorAll('[data-category-close]')?.forEach((b)=> b.addEventListener('click', closeCategoryModal));
    categoryAddBtn?.addEventListener('click', ()=>{
      const val = (categoryAddInput?.value || '').trim();
      if (!val) return;
      if (!masterCategories.includes(val)) masterCategories.push(val);
      renderCategoryDatalist();
      renderMasterItemList();
      renderCategoryManageList();
      if (categoryAddInput) categoryAddInput.value = '';
      toast('カテゴリーを追加しました（持ち物編集で選択できます）');
    });
  })();
</script>
