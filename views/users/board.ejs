<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="space-y-2">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <p class="text-xs text-gray-500">グループの掲示板</p>
        <h1 class="text-2xl font-bold text-gray-900"><%= currentGroupName ? `${currentGroupName}の掲示板` : '掲示板' %></h1>
      </div>
      <button type="button" id="task-open-modal" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">
        <i data-lucide="plus" class="w-4 h-4"></i>
        イベントを追加
      </button>
    </div>
  </header>

  <section class="space-y-2" style="margin-top:5px !important;">
    <div class="relative min-h-[48px]">
      <button
        type="button"
        id="task-guide-toggle"
        class="absolute top-3 left-3 px-3 py-1.5 rounded border text-sm bg-white/90 text-gray-800 shadow-sm hover:bg-white"
      >非表示</button>
      <div id="task-guide-wrapper" class="border rounded-2xl bg-white overflow-hidden shadow-sm">
        <img src="/pict/taskManage.jpg" alt="イベント管理ガイド" class="w-full h-auto object-cover">
      </div>
    </div>
  </section>

  <section class="border rounded-2xl bg-white p-4 space-y-3">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div class="flex items-center gap-2 text-sm">
        <button type="button" data-status-tab="active" class="px-3 py-1.5 rounded-full border text-sm font-semibold tab-active">未完了</button>
        <button type="button" data-status-tab="completed" class="px-3 py-1.5 rounded-full border text-sm font-semibold text-gray-600">完了</button>
      </div>
      <div class="flex flex-wrap gap-2 text-xs text-gray-600">
        <div class="inline-flex items-center gap-2 px-2 py-1 rounded border border-gray-200 bg-gray-50">
          <span>誰</span>
          <div id="filter-assignee" class="flex flex-wrap gap-2">
            <label class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-gray-200 bg-white">
              <input type="checkbox" value="all" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              <span>全員</span>
            </label>
            <% members.forEach((m)=> { %>
              <label class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-gray-200 bg-white">
                <input type="checkbox" value="<%= m.id %>" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                <span><%= m.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
        <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-300 bg-gray-100">
          <span>カテゴリー</span>
          <select id="filter-category" class="border rounded px-1 py-1 text-xs focus:outline-none focus:ring-2 focus:ring-blue-200">
            <option value="">すべて</option>
            <% categories.forEach((c)=> { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </label>
        <label class="inline-flex items-center gap-1 px-2 py-1 rounded border border-gray-200 bg-gray-50">
          <span>ステータス</span>
          <select id="filter-status" class="border rounded px-1 py-1 text-xs focus:outline-none focus:ring-2 focus:ring-blue-200">
            <option value="">すべて</option>
            <option value="not_started">未着手</option>
            <option value="in_progress">進行中</option>
            <option value="on_hold">保留</option>
          </select>
        </label>
      </div>
    </div>
    <div id="task-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
    <p id="task-empty" class="text-sm text-gray-500">イベントはまだありません。追加してください。</p>
  </section>
</section>

<!-- イベントモーダル -->
<div id="task-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900" id="task-modal-title">掲示内容を追加</h3>
      <button type="button" data-task-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">タイトル
      <input type="text" id="task-title" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 旅行の荷造り"/>
    </label>
    <div class="space-y-2">
      <p class="text-sm font-medium text-gray-800">イベントの種類</p>
      <div class="flex flex-wrap gap-3 text-sm">
        <label class="inline-flex items-center gap-2">
          <input type="radio" name="task-kind" value="task" class="text-blue-600 focus:ring-blue-500" checked>
          <span>タスク</span>
        </label>
        <label class="inline-flex items-center gap-2">
          <input type="radio" name="task-kind" value="bulletin" class="text-blue-600 focus:ring-blue-500">
          <span>掲示物</span>
        </label>
      </div>
    </div>
    <label class="block text-sm">カテゴリー
      <input type="text" list="task-category-datalist" id="task-category" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 家事 / 旅行 / 買い物"/>
    </label>
    <div class="grid sm:grid-cols-2 gap-2">
      <label class="block text-sm">開始日
        <input type="date" id="task-start" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200"/>
      </label>
      <label class="block text-sm">期限
        <input type="date" id="task-due" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200"/>
      </label>
    </div>
    <div class="space-y-2">
      <p class="text-sm font-medium text-gray-800">誰</p>
      <div id="task-assignees" class="flex flex-wrap gap-2">
        <button type="button" data-assignee-btn value="all" class="px-3 py-1.5 rounded-full border border-blue-100 bg-blue-50 text-sm text-blue-700 hover:border-blue-300">全員</button>
        <% members.forEach((m)=> { %>
          <button type="button" data-assignee-btn value="<%= m.id %>" class="px-3 py-1.5 rounded-full border border-blue-100 bg-blue-50 text-sm text-blue-700 hover:border-blue-300"><%= m.name %></button>
        <% }) %>
      </div>
    </div>
    <div class="flex items-center justify-between rounded-lg border border-gray-200 px-3 py-2">
      <div>
        <p class="text-sm font-medium text-gray-800">確認</p>
        <p class="text-xs text-gray-500">確認済みにする</p>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="task-confirmed" class="sr-only peer">
        <div class="w-10 h-6 bg-gray-200 rounded-full peer peer-checked:bg-blue-600 transition"></div>
        <div class="absolute left-1 top-1 w-4 h-4 bg-white rounded-full transition peer-checked:translate-x-4"></div>
      </label>
    </div>
    <label class="block text-sm">進捗状況
      <select id="task-status" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
        <option value="not_started">未着手</option>
        <option value="in_progress">進行中</option>
        <option value="on_hold">保留</option>
        <option value="completed">完了</option>
      </select>
    </label>
    <label class="block text-sm">掲示する内容
      <textarea id="task-note" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" rows="3" placeholder="掲示する内容を入力"></textarea>
    </label>
    <div class="grid sm:grid-cols-2 gap-2">
      <label class="block text-sm">繰り返し
        <select id="task-recur-type" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
          <option value="none">なし</option>
          <option value="daily">日ごと</option>
          <option value="weekly">週ごと</option>
          <option value="monthly">月ごと</option>
        </select>
      </label>
      <label class="block text-sm">間隔
        <input type="number" min="1" value="1" id="task-recur-interval" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200"/>
      </label>
    </div>
    <div class="grid sm:grid-cols-2 gap-2">
      <div class="space-y-1">
        <p class="text-sm">曜日(週)</p>
        <div id="task-recur-weekdays" class="flex flex-wrap gap-2">
          <% ['日','月','火','水','木','金','土'].forEach((label, idx)=> { %>
            <button type="button" data-weekday-btn value="<%= idx %>" class="px-2.5 py-1 rounded-full border border-blue-100 bg-blue-50 text-sm text-blue-700 hover:border-blue-300"><%= label %></button>
          <% }) %>
        </div>
      </div>
      <label class="block text-sm">日付(月)
        <input type="number" min="1" max="31" id="task-recur-day" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="例: 15"/>
      </label>
    </div>
    <div class="flex justify-end gap-2">
      <button type="button" data-task-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="task-save" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">保存</button>
    </div>
  </div>
</div>
<datalist id="task-category-datalist">
  <% categories.forEach((c)=> { %>
    <option value="<%= c %>"></option>
  <% }) %>
</datalist>

<script>
  (function(){
    const members = new Map((<%- JSON.stringify(members || []) %>).map((m)=> [m.id, m.name]));
    members.set('all', '全員');
    const currentUserId = <%- JSON.stringify((typeof currentUserId !== 'undefined' ? currentUserId : '')) %>;
    let tasks = <%- JSON.stringify(tasks || []) %>;
    const guideWrapper = document.getElementById('task-guide-wrapper');
    const guideToggle = document.getElementById('task-guide-toggle');
    const statusTabs = document.querySelectorAll('[data-status-tab]');
    const taskList = document.getElementById('task-list');
    const taskEmpty = document.getElementById('task-empty');
    const filterAssignee = document.getElementById('filter-assignee');
    const filterCreator = document.getElementById('filter-creator');
    const filterCategory = document.getElementById('filter-category');
    const filterStatus = document.getElementById('filter-status');
    const modal = document.getElementById('task-modal');
    const modalTitle = document.getElementById('task-modal-title');
    const openBtn = document.getElementById('task-open-modal');
    const saveBtn = document.getElementById('task-save');
    const titleInput = document.getElementById('task-title');
    const categoryInput = document.getElementById('task-category');
    const startInput = document.getElementById('task-start');
    const dueInput = document.getElementById('task-due');
    const assigneeButtons = document.querySelectorAll('[data-assignee-btn]');
    const kindInputs = document.querySelectorAll('[name="task-kind"]');
    const statusSelect = document.getElementById('task-status');
    const noteInput = document.getElementById('task-note');
    const confirmedInput = document.getElementById('task-confirmed');
    const recurType = document.getElementById('task-recur-type');
    const recurInterval = document.getElementById('task-recur-interval');
    const recurWeekdays = document.getElementById('task-recur-weekdays');
    const recurDay = document.getElementById('task-recur-day');
    let editingId = '';
    let activeTab = 'active';
    const GUIDE_KEY = 'board:guide:hidden';

    function toast(msg){ try{ const el=document.createElement('div'); el.textContent=msg; el.className='fixed bottom-4 right-4 bg-gray-900 text-white text-sm px-3 py-2 rounded shadow'; document.body.appendChild(el); setTimeout(()=> el.remove(),2000);}catch(_){alert(msg);} }

    function getUserStatus(task, userId, allowFallback){
      if (!task) return 'not_started';
      if (task.kind === 'bulletin'){
        const confirmedBy = Array.isArray(task.confirmedBy) ? task.confirmedBy.map(String) : [];
        if (userId && confirmedBy.includes(String(userId))) return 'completed';
      }
      const statusBy = Array.isArray(task.statusBy) ? task.statusBy : [];
      const found = statusBy.find((s)=> String(s.user) === String(userId));
      if (found?.status) return found.status;
      if (allowFallback) return task.status || 'not_started';
      return 'not_started';
    }

    function statusTagClass(task, userId, status){
      if (task?.kind === 'task' && status === 'not_started'){
        const confirmedBy = Array.isArray(task?.confirmedBy) ? task.confirmedBy.map(String) : [];
        if (userId && confirmedBy.includes(String(userId))){
          return 'bg-blue-100 text-blue-700 border-blue-200';
        }
        return 'bg-gray-100 text-gray-700 border-gray-200';
      }
      switch(status){
        case 'completed': return 'bg-emerald-600 text-white border-emerald-700';
        case 'on_hold': return 'bg-red-100 text-red-700 border-red-200';
        case 'in_progress': return 'bg-yellow-100 text-yellow-800 border-yellow-200';
        case 'not_started':
        default: return 'bg-gray-100 text-gray-700 border-gray-200';
      }
    }

    function updateGuide(hidden){
      if (!guideWrapper) return;
      guideWrapper.classList.toggle('hidden', hidden);
      if (guideToggle){
        guideToggle.textContent = hidden ? 'ガイド表示' : '非表示';
        guideToggle.setAttribute('aria-pressed', hidden ? 'false' : 'true');
      }
      try{ localStorage.setItem(GUIDE_KEY, hidden ? '1' : '0'); }catch(_){}
    }

    function openModal(task){
      editingId = task?.id || '';
      modalTitle.textContent = editingId ? '掲示内容を編集' : '掲示内容を追加';
      if (saveBtn) saveBtn.textContent = editingId ? '更新' : '保存';
      titleInput.value = task?.title || '';
      categoryInput.value = task?.category || '';
      const kindValue = task?.kind || 'task';
      kindInputs.forEach((input)=> { input.checked = input.value === kindValue; });
      startInput.value = task?.startAt ? new Date(task.startAt).toISOString().slice(0,10) : '';
      dueInput.value = task?.dueAt ? new Date(task.dueAt).toISOString().slice(0,10) : '';
      assigneeButtons.forEach((btn)=> {
        const active = (task?.assignees || []).includes(btn.value);
        btn.classList.toggle('bg-blue-50', active);
        btn.classList.toggle('text-blue-700', active);
        btn.classList.toggle('border-blue-100', active);
        btn.classList.toggle('bg-white', !active);
        btn.classList.toggle('text-gray-600', !active);
        btn.classList.toggle('border-gray-200', !active);
        btn.classList.toggle('is-selected', active);
      });
      statusSelect.value = getUserStatus(task, currentUserId, true) || 'not_started';
      if (confirmedInput){
        const confirmedBy = Array.isArray(task?.confirmedBy) ? task.confirmedBy : [];
        const statusBy = Array.isArray(task?.statusBy) ? task.statusBy : [];
        const statusHit = statusBy.find((s)=> String(s.user) === String(currentUserId));
        const isConfirmed = !!(currentUserId && confirmedBy.includes(String(currentUserId)));
        confirmedInput.checked = isConfirmed || (statusHit?.status === 'completed');
      }
      noteInput.value = task?.note || '';
      recurType.value = task?.recurrence?.type || 'none';
      recurInterval.value = task?.recurrence?.interval || 1;
      Array.from(recurWeekdays.querySelectorAll('[data-weekday-btn]')).forEach((btn)=> {
        const active = (task?.recurrence?.weekdays || []).includes(Number(btn.value));
        btn.classList.toggle('bg-blue-50', active);
        btn.classList.toggle('text-blue-700', active);
        btn.classList.toggle('border-blue-100', active);
        btn.classList.toggle('bg-white', !active);
        btn.classList.toggle('text-gray-600', !active);
        btn.classList.toggle('border-gray-200', !active);
        btn.classList.toggle('is-selected', active);
      });
      recurDay.value = task?.recurrence?.dayOfMonth || '';
      syncBulletinStatus();
      modal.classList.remove('hidden'); modal.classList.add('flex');
    }
    function closeModal(){
      modal.classList.add('hidden'); modal.classList.remove('flex');
      editingId = '';
    }

    function syncBulletinStatus(){
      const selectedKind = Array.from(kindInputs).find((input)=> input.checked)?.value || 'task';
      if (selectedKind !== 'bulletin') return;
      if (!confirmedInput) return;
      if (confirmedInput.checked){
        statusSelect.value = 'completed';
      } else {
        statusSelect.value = 'not_started';
      }
    }

    function renderList(){
      taskList.innerHTML = '';
      const selectedAssignees = Array.from(filterAssignee.querySelectorAll('input[type="checkbox"]:checked')).map(cb=> cb.value);
      const selectedCategories = filterCategory.value ? [filterCategory.value] : [];
      const selectedStatuses = filterStatus.value ? [filterStatus.value] : [];
      const creator = (typeof filterCreator !== 'undefined' && filterCreator && filterCreator.value) ? filterCreator.value : '';
      if (selectedAssignees.includes('all')) selectedAssignees.length = 0;
      const filtered = tasks.filter((t)=>{
        const currentStatus = getUserStatus(t, currentUserId, true);
        if (activeTab === 'active' && currentStatus === 'completed') return false;
        if (activeTab === 'completed' && currentStatus !== 'completed') return false;
        if (creator && t.createdBy !== creator) return false;
        if (selectedAssignees.length && !t.assignees.some((a)=> selectedAssignees.includes(a))) return false;
        if (selectedCategories.length && !selectedCategories.includes(t.category || '')) return false;
        if (selectedStatuses.length && !selectedStatuses.includes(currentStatus)) return false;
        return true;
      });
      if (!filtered.length){
        taskEmpty.classList.remove('hidden');
        return;
      }
      taskEmpty.classList.add('hidden');
      const sorted = filtered.sort((a,b)=> {
        const da = a.createdAt ? new Date(a.createdAt).getTime() : 0;
        const db = b.createdAt ? new Date(b.createdAt).getTime() : 0;
        return db - da;
      });
      const grouped = [
        ...sorted.filter((t)=> t.kind === 'bulletin'),
        ...sorted.filter((t)=> t.kind !== 'bulletin')
      ];
      grouped.forEach((t)=>{
          const card = document.createElement('div');
          const dueStr = t.dueAt ? new Date(t.dueAt).toLocaleDateString('ja-JP') : '未設定';
          const startStr = t.startAt ? new Date(t.startAt).toLocaleDateString('ja-JP') : '';
          const assigneeTags = t.assignees.map((a)=> {
            const label = members.get(a) || 'メンバー';
            const statusValue = getUserStatus(t, a, false);
            const cls = statusTagClass(t, a, statusValue);
            return `<span class="inline-flex items-center px-2 py-0.5 rounded-full border text-[11px] ${cls}">${label}</span>`;
          }).join(' ');
          const assigneeLabels = assigneeTags || '<span class="text-xs text-gray-500">未指定</span>';
          const currentStatus = getUserStatus(t, currentUserId, true);
          const statusLabel = { not_started:'未着手', in_progress:'進行中', on_hold:'保留', completed:'完了' }[currentStatus] || currentStatus;
          const kindLabel = t.kind === 'bulletin' ? '掲示物' : 'タスク';
          card.className = 'rounded-xl border border-gray-200 bg-white p-3 space-y-2 shadow-sm';
          card.innerHTML = `
            <div class="flex items-start justify-between gap-2">
              <div>
                <p class="font-semibold text-gray-900">${t.title}</p>
                <p class="text-xs text-gray-500">${t.category || 'カテゴリー未設定'}</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] px-2 py-1 rounded-full border bg-slate-50 text-slate-700 border-slate-200">${kindLabel}</span>
                <span class="text-[11px] px-2 py-1 rounded-full border ${currentStatus === 'completed' ? 'bg-green-50 text-green-700 border-green-200' : 'bg-gray-50 text-gray-600 border-gray-200'}">${statusLabel}</span>
                <button class="text-gray-500 hover:text-gray-800" data-task-edit="${t.id}" aria-label="編集"><i data-lucide="edit" class="w-4 h-4"></i></button>
              </div>
            </div>
            <div class="text-xs text-gray-600 space-y-1">
              <div class="flex flex-wrap items-center gap-1">誰: ${assigneeLabels}</div>
              <p>イベント日: ${startStr || '未設定'} / 期限: ${dueStr}</p>
              ${t.note ? `<p class="text-gray-700 bg-gray-50 border border-gray-100 rounded px-2 py-1">${t.note}</p>` : ''}
            </div>
            <div class="flex items-center justify-between text-xs text-gray-500">
              <span>作成: ${members.get(t.createdBy) || 'メンバー'}</span>
              <div class="flex items-center gap-2">
                ${currentStatus !== 'completed' ? `<button class="text-green-700 hover:text-green-900" data-task-complete="${t.id}">完了にする</button>` : `<button class="text-gray-600 hover:text-gray-800" data-task-reopen="${t.id}">未完了に戻す</button>`}
                ${(t.source === 'manual' && currentUserId && t.createdBy === currentUserId) ? `<button class="text-red-600 hover:text-red-800" data-task-delete="${t.id}">削除</button>` : ''}
              </div>
            </div>
          `;
          taskList.appendChild(card);
        });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    async function saveTask(){
      let selectedAssignees = Array.from(document.querySelectorAll('[data-assignee-btn].is-selected')).map(btn=> btn.value);
      if (selectedAssignees.includes('all')){
        selectedAssignees = Array.from(members.keys()).filter((id)=> id !== 'all');
      }
      const selectedKind = Array.from(kindInputs).find((input)=> input.checked)?.value || 'task';
      const shouldConfirm = !!confirmedInput?.checked;
      const selectedWeekdays = Array.from(recurWeekdays.querySelectorAll('[data-weekday-btn].is-selected')).map(btn=> Number(btn.value));
      const statusValue = (selectedKind === 'bulletin' && shouldConfirm) ? 'completed' : statusSelect.value;
      const payload = {
        title: titleInput.value.trim(),
        category: categoryInput.value.trim(),
        startAt: startInput.value ? new Date(startInput.value) : null,
        dueAt: dueInput.value ? new Date(dueInput.value) : null,
        assignees: selectedAssignees,
        status: statusValue,
        kind: selectedKind,
        confirmed: shouldConfirm,
        note: noteInput.value.trim(),
        recurrence: {
          type: recurType.value,
          interval: Number(recurInterval.value || 1),
          weekdays: selectedWeekdays,
          dayOfMonth: recurDay.value ? Number(recurDay.value) : null
        }
      };
      try{
        const res = await fetch(editingId ? `/users/board/api/tasks/${encodeURIComponent(editingId)}` : '/users/board/api/tasks', {
          method: editingId ? 'PATCH' : 'POST',
          headers: { 'Content-Type':'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('保存に失敗しました');
        const json = await res.json();
        const idx = tasks.findIndex((t)=> t.id === json.id);
        if (idx >= 0) tasks[idx] = json; else tasks.push(json);
        closeModal();
        renderList();
        toast('保存しました');
      }catch(e){ toast(e.message || '保存に失敗しました'); }
    }

    async function updateStatus(task, status){
      if (!task) return;
      const payload = { status };
      if (task.kind === 'bulletin'){
        payload.confirmed = status === 'completed';
      }
      const updated = await updateTask(task.id, payload);
      if (updated) toast('更新しました');
    }

    async function updateTask(id, fields){
      try{
        const res = await fetch(`/users/board/api/tasks/${encodeURIComponent(id)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify(fields)
        });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        const idx = tasks.findIndex((t)=> t.id === json.id);
        if (idx >= 0) tasks[idx] = json;
        renderList();
        return json;
      }catch(e){ toast(e.message || '更新に失敗しました'); }
      return null;
    }

    assigneeButtons.forEach((btn)=> {
      btn.addEventListener('click', ()=>{
        const active = !btn.classList.contains('is-selected');
        btn.classList.toggle('bg-blue-50', active);
        btn.classList.toggle('text-blue-700', active);
        btn.classList.toggle('border-blue-100', active);
        btn.classList.toggle('bg-white', !active);
        btn.classList.toggle('text-gray-600', !active);
        btn.classList.toggle('border-gray-200', !active);
        btn.classList.toggle('is-selected', active);
      });
    });

    recurType?.addEventListener('change', ()=> {
      const type = recurType.value;
      const disableAll = type === 'none';
      recurInterval.disabled = disableAll;
      recurDay.disabled = disableAll || type !== 'monthly';
      recurWeekdays.querySelectorAll('[data-weekday-btn]').forEach((btn)=> {
        btn.disabled = disableAll || type !== 'weekly';
        btn.classList.toggle('opacity-50', btn.disabled);
      });
      if (disableAll || type !== 'weekly'){
        recurWeekdays.querySelectorAll('[data-weekday-btn]').forEach((btn)=> {
          btn.classList.remove('bg-blue-50','text-blue-700','border-blue-100');
          btn.classList.add('bg-white','text-gray-600','border-gray-200');
          btn.classList.remove('is-selected');
        });
      }
    });
    recurType?.dispatchEvent(new Event('change'));

    recurWeekdays?.querySelectorAll('[data-weekday-btn]').forEach((btn)=> {
      btn.addEventListener('click', ()=>{
        if (btn.disabled) return;
        const active = !btn.classList.contains('is-selected');
        btn.classList.toggle('bg-blue-50', active);
        btn.classList.toggle('text-blue-700', active);
        btn.classList.toggle('border-blue-100', active);
        btn.classList.toggle('bg-white', !active);
        btn.classList.toggle('text-gray-600', !active);
        btn.classList.toggle('border-gray-200', !active);
        btn.classList.toggle('is-selected', active);
      });
    });

    statusTabs.forEach((tab)=> {
      tab.addEventListener('click', ()=>{
        statusTabs.forEach((t)=> t.classList.remove('tab-active','bg-blue-600','text-white'));
        tab.classList.add('tab-active','bg-blue-600','text-white');
        activeTab = tab.dataset.statusTab;
        renderList();
      });
    });

    kindInputs.forEach((input)=> {
      input.addEventListener('change', syncBulletinStatus);
    });
    confirmedInput?.addEventListener('change', syncBulletinStatus);
    statusSelect?.addEventListener('change', ()=> {
      if (statusSelect.value !== 'not_started' && confirmedInput) {
        confirmedInput.checked = true;
      }
      syncBulletinStatus();
    });

    filterAssignee?.addEventListener('change', renderList);
    [filterCategory, filterStatus].forEach((el)=> el?.addEventListener('change', renderList));
    openBtn?.addEventListener('click', ()=> openModal(null));
    modal?.addEventListener('click', (ev)=> { if (ev.target === modal || ev.target.hasAttribute('data-task-close')) closeModal(); });
    saveBtn?.addEventListener('click', saveTask);
    taskList?.addEventListener('click', (ev)=>{
      const editBtn = ev.target.closest('button[data-task-edit]');
      const completeBtn = ev.target.closest('button[data-task-complete]');
      const reopenBtn = ev.target.closest('button[data-task-reopen]');
      const deleteBtn = ev.target.closest('button[data-task-delete]');
      if (editBtn){
        const id = editBtn.dataset.taskEdit;
        const target = tasks.find((t)=> t.id === id);
        if (target) openModal(target);
      } else if (completeBtn){
        const id = completeBtn.dataset.taskComplete;
        const target = tasks.find((t)=> t.id === id);
        updateStatus(target, 'completed');
      } else if (reopenBtn){
        const id = reopenBtn.dataset.taskReopen;
        const target = tasks.find((t)=> t.id === id);
        updateStatus(target, 'in_progress');
      } else if (deleteBtn){
        const id = deleteBtn.dataset.taskDelete;
        if (!confirm('このイベントを削除しますか？')) return;
        fetch(`/users/board/api/tasks/${encodeURIComponent(id)}`, { method:'DELETE' })
          .then((res)=> { if(!res.ok) throw new Error(); return res.json(); })
          .then(()=> {
            tasks = tasks.filter((t)=> t.id !== id);
            renderList();
            toast('削除しました');
          })
          .catch(()=> toast('削除に失敗しました'));
      }
    });

    guideToggle?.addEventListener('click', ()=> {
      const hidden = guideWrapper?.classList.contains('hidden');
      updateGuide(!hidden);
    });
    // restore guide state
    try{
      const savedGuide = localStorage.getItem(GUIDE_KEY);
      if (savedGuide === '1') updateGuide(true);
    }catch(_){}

    const params = new URLSearchParams(window.location.search);
    const confirmId = params.get('confirm');
    if (confirmId){
      const target = tasks.find((t)=> t.id === confirmId);
      if (target){
        openModal(target);
        const confirmedBy = Array.isArray(target.confirmedBy) ? target.confirmedBy.map(String) : [];
        if (!currentUserId || confirmedBy.includes(String(currentUserId))) {
          renderList();
        } else updateTask(confirmId, { confirmed: true }).then((updated)=> {
          if (updated && confirmedInput) {
            confirmedInput.checked = true;
            syncBulletinStatus();
          }
        });
      }
    }

    renderList();
  })();
</script>
