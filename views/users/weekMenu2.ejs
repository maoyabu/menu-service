    // Build supplies range text (e.g., 2025年10月27日から11月2日の食材・調味料リスト)
    (function(){
      const labelEl = document.getElementById('wm2-supplies-range');
      try{
        const data = window.weekMenuData || {};
        const startISO = data.weekStartISO || (Array.isArray(WEEK) && WEEK[0] && (WEEK[0].dateISO || WEEK[0]));
        const start = startISO ? new Date(startISO) : null;
        const endISO = Array.isArray(WEEK) && WEEK[6] ? (WEEK[6].dateISO || WEEK[6]) : (start ? new Date(start.getFullYear(), start.getMonth(), start.getDate()+6).toISOString() : null);
        const end = endISO ? new Date(endISO) : null;
        const fmt = (d, withYear=false) => {
          if (!d || Number.isNaN(d.getTime())) return '';
          const y = d.getFullYear();
          const m = d.getMonth()+1;
          const day = d.getDate();
          return withYear ? `${y}年${m}月${day}日` : `${m}月${day}日`;
        };
        const text = `${fmt(start, true)}から${fmt(end)}の食材・調味料リスト`;
        if (labelEl) labelEl.textContent = text;
      }catch(_){ if (labelEl) labelEl.textContent = 'この週の食材・調味料リスト'; }
    })();
    // Pick the requested mail-link date first, then today within the week.
    const todayISO = (window.weekMenuData && window.weekMenuData.todayISO) || new Date().toISOString();
    const todayDateStr = new Date(todayISO).toDateString();
    const requestedDate = new URL(window.location.href).searchParams.get('date');
    const selectedDateStr = requestedDate ? new Date(`${requestedDate}T00:00:00`).toDateString() : todayDateStr;
    let sel = Math.max(0, (WEEK || []).findIndex(d => {
      const iso = d?.dateISO || d; if (!iso) return false; try { return new Date(iso).toDateString() === todayDateStr; } catch(_) { return false; }
    }));
    const requestedIndex = (WEEK || []).findIndex(d => {
      const iso = d?.dateISO || d; if (!iso) return false; try { return new Date(iso).toDateString() === selectedDateStr; } catch(_) { return false; }
    });
    if (requestedIndex >= 0) sel = requestedIndex;

    function toLabel(d){
      const display = d && d.display ? d.display : '';
      if (display && d && Object.prototype.hasOwnProperty.call(d, 'weekday')) {
        return { disp: display, dow: d.weekday || '' };
      }
      const iso = d && d.dateISO ? d.dateISO : d;
      let dow = '';
      try { const dt = new Date(iso); dow = WEEKDAY[(dt.getDay()+6)%7] || ''; } catch(_) {}
      // If display already like MM/DD, use it; else format from iso
      const disp = display || (function(){ try { const dt=new Date(iso); const m=dt.getMonth()+1, day=dt.getDate(); return `${('0'+m).slice(-2)}/${('0'+day).slice(-2)}`; } catch(_) { return '--/--'; } })();
      return { disp, dow };
    }
    const formatLabelWithDow = (entry) => {
