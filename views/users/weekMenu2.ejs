    const formatAmountLabel = (item) => {
      const amount = (typeof item?.amount === 'number' && !Number.isNaN(item.amount))
        ? Math.round(item.amount * 100) / 100
        : null;
      const unit = item?.unit || '';
      return amount === null ? '' : `${amount}${unit || ''}`;
