      return { totals, seasonal: menuHasSeasonal(menu) };
    };
    const computeShortages = (snapshot) => {
      if (!snapshot) return [];
      const { entries, seasoningEntries, mode, dayCount } = snapshot;
      const totals = new Map();
      (entries || []).forEach(({ id, name, amount, unit }) => {
        const grams = convertEntryToGrams({ id, name, amount, unit });
        if (typeof grams !== 'number' || Number.isNaN(grams)) return;
        const cls = resolveIngredientClass(id, name);
        totals.set(cls, (totals.get(cls) || 0) + grams);
      });
      (seasoningEntries || []).forEach(({ id, name, amount, unit }) => {
        const cls = resolveSeasoningClass(id, name);
        if (!SEASONING_CAPTURE_CLASSES.has(cls)) return;
        const grams = convertSeasoningEntryToGrams({ id, name, amount, unit });
        if (typeof grams !== 'number' || Number.isNaN(grams)) return;
        totals.set(cls, (totals.get(cls) || 0) + grams);
      });
      const multiplier = mode === 'week' ? Math.max(1, Number(dayCount) || 1) : 1;
      const shortages = [];
      ING_CLASS_ORDER.forEach((cls) => {
        const requiredValRaw = guidelineTotals && Object.prototype.hasOwnProperty.call(guidelineTotals, cls)
          ? Number(guidelineTotals[cls])
          : 0;
        const required = Number.isFinite(requiredValRaw) ? requiredValRaw * multiplier : 0;
        const actual = totals.get(cls) || 0;
        const shortage = required - actual;
        if (shortage > 0) shortages.push({ cls, shortage, required, actual });
      });
      shortages.sort((a, b) => b.shortage - a.shortage);
      return shortages;
    };
    const pickMenuSuggestions = (shortages, snapshot) => {
      if (!shortages || !shortages.length) return { picks: [], remaining: new Map() };
      const participantCount = Math.max(1, snapshot?.participantCount || defaultIds().length || 1);
      const menus = Object.values(lookup || {});
      const scored = [];
      shortages = shortages.slice(0); // shallow copy
      const shortageMap = new Map(shortages.map((s) => [s.cls, s.shortage]));
      menus.forEach((menu) => {
        const { totals, seasonal } = calcMenuClassTotals(menu, participantCount);
        let coverage = 0;
        const coverMap = new Map();
        shortages.forEach((s) => {
          const supply = totals.get(s.cls) || 0;
          if (supply > 0) {
            const hit = Math.min(s.shortage, supply);
            coverage += hit;
            coverMap.set(s.cls, hit);
          }
        });
        if (coverage <= 0) return;
        scored.push({
          menu,
          coverage,
          coverMap,
          seasonal,
          classHits: coverMap.size
        });
      });
      const picks = [];
      const remaining = new Map(shortageMap);
      while (picks.length < 3) {
        let best = null;
        let bestScore = 0;
        scored.forEach((cand) => {
          let eff = 0;
          cand.coverMap.forEach((supply, cls) => {
            const rem = remaining.get(cls) || 0;
            const hit = Math.min(rem, supply);
            eff += hit;
          });
          if (eff <= 0) return;
          const bonus = (cand.seasonal ? 20 : 0) + (cand.classHits > 1 ? 5 : 0);
          const score = eff + bonus;
          if (!best || score > bestScore) {
            best = cand;
            bestScore = score;
          }
        });
        if (!best) break;
        const appliedCover = new Map();
        best.coverMap.forEach((supply, cls) => {
          const rem = remaining.get(cls) || 0;
          const hit = Math.min(rem, supply);
          if (hit > 0) {
            remaining.set(cls, Math.max(0, rem - hit));
            appliedCover.set(cls, hit);
          }
        });
        picks.push({ menu: best.menu, coverMap: appliedCover, seasonal: best.seasonal });
        scored.splice(scored.indexOf(best), 1);
        const stillShort = Array.from(remaining.values()).some((v) => v > 0);
        if (!stillShort) break;
      }
      return { picks, remaining };
    };
    const addSuggestionToMeal = (menuId, mealKey, snapshot, feedbackEl) => {
