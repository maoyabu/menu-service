<!-- Not-eating reason modal -->
<div id="wm2-reason-modal" class="hidden fixed inset-0 z-50 bg-black/30 flex items-center justify-center">
  <div class="w-[92%] max-w-md rounded-xl bg-white p-4 shadow-lg">
    <h3 class="text-base font-semibold mb-2">食べない理由（任意）</h3>
    <div class="space-y-3">
      <label class="block text-sm text-gray-700">過去の理由から選択（任意）</label>
      <select id="wm2-reason-select" class="w-full border rounded px-2 py-1 text-sm">
        <option value="">選択しない</option>
      </select>
      <label class="block text-sm text-gray-700">自由入力（任意）</label>
      <textarea id="wm2-reason-input" class="w-full border rounded px-2 py-1 text-sm" rows="3" placeholder="例：外出のため、ダイエット中 など"></textarea>
    </div>
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" data-reason-action="cancel" class="px-3 py-1.5 rounded border">キャンセル</button>
      <button type="button" data-reason-action="skip" class="px-3 py-1.5 rounded border">理由なしで確定</button>
      <button type="button" data-reason-action="submit" class="px-3 py-1.5 rounded bg-blue-600 text-white">確定</button>
    </div>
  </div>
  <script>
    (function(){
      let ctx = null; // { day, meal }
      const modal = document.getElementById('wm2-reason-modal');
      const sel = document.getElementById('wm2-reason-select');
      const input = document.getElementById('wm2-reason-input');

      async function open(day, meal){
        ctx = { day, meal };
        input.value = '';
        sel.innerHTML = '<option value="">選択しない</option>';
        // fetch past reasons
        try {
          const gid = (window.weekMenuData && window.weekMenuData.currentGroupId) || '';
          if (gid) {
            const res = await fetch(`/users/week-menu/participant-reasons?group=${encodeURIComponent(gid)}`);
            if (res.ok) {
              const json = await res.json();
              const list = Array.isArray(json?.reasons) ? json.reasons : [];
              list.forEach((r) => {
                const opt = document.createElement('option');
                opt.value = r; opt.textContent = r; sel.appendChild(opt);
              });
            }
          }
        } catch(_) {}
        modal.classList.remove('hidden');
      }
      function close(){ modal.classList.add('hidden'); ctx = null; }

      // expose to attendee handler
      window.__wm2_openReasonModal = open;

      document.addEventListener('click', async (ev) => {
        const t = ev.target;
        if (!modal || modal.classList.contains('hidden')) return;
        if (t.closest('[data-reason-action="cancel"]')) { ev.preventDefault(); close(); return; }
        if (t.closest('[data-reason-action="skip"]')) {
          ev.preventDefault();
          if (ctx) {
            // trigger original removal without reason
            window.__wm2_submitRemove(ctx.day, ctx.meal, '');
          }
          close();
          return;
        }
        if (t.closest('[data-reason-action="submit"]')) {
          ev.preventDefault();
          const reason = (input.value || sel.value || '').trim();
          if (ctx) {
            window.__wm2_submitRemove(ctx.day, ctx.meal, reason);
          }
          close();
          return;
        }
        if (t.id === 'wm2-reason-modal') { close(); }
      });
    })();
  </script>

  <!-- weekMenu2 prep-extra small popover -->
  <script>
    (function(){
      let ctx = null; // { day, meal, index, anchorRect }
      let pop = null;
      function ensure(){
        if (pop) return pop;
        pop = document.createElement('div');
        pop.id = 'wm2-prep-pop';
        pop.className = 'hidden fixed z-50 bg-white border rounded-xl shadow p-3 w-44';
        pop.innerHTML = `
          <div class="text-sm font-semibold mb-2">作り置き人数</div>
          <div class="flex items-center gap-2">
            <input type="number" min="0" step="1" id="wm2-prep-input" name="prepExtra" aria-label="追加作り置き人数" class="w-20 border rounded px-2 py-1" />
            <span class="text-sm">名分</span>
          </div>
          <div class="mt-3 flex justify-end gap-2">
            <button type="button" data-prep-action="cancel" class="px-2 py-1 border rounded text-sm">キャンセル</button>
            <button type="button" data-prep-action="submit" class="px-2 py-1 bg-blue-600 text-white rounded text-sm">設定</button>
          </div>`;
        document.body.appendChild(pop);
        return pop;
      }
      function openAt(x, y){ const el=ensure(); el.style.left=`${x}px`; el.style.top=`${y}px`; el.classList.remove('hidden'); }
      function close(){ if (pop) pop.classList.add('hidden'); ctx=null; }

      // Intercept clicks on set-prep icon and open popover
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action="set-prep"]');
        if (!btn) return;
        // find day/meal and slot index
        const box = btn.closest('[data-day][data-meal]');
        const day = Number(box?.dataset?.day || '0');
        const meal = box?.dataset?.meal || 'lunch';
        const index = meal==='lunch' ? Number(btn.closest('[data-slot-index]')?.dataset?.slotIndex || '-1') : Number(btn.closest('[data-dinner-index]')?.dataset?.dinnerIndex || '-1');
        if (Number.isNaN(day) || Number.isNaN(index) || index < 0) return;
        e.stopPropagation(); e.preventDefault();
        const r = btn.getBoundingClientRect();
        ctx = { day, meal, index };
        // set current value
        try {
          const n = (window.weekMenuAPI && window.weekMenuAPI.getPrepExtra) ? window.weekMenuAPI.getPrepExtra(day, meal, index) : 0;
          ensure();
          document.getElementById('wm2-prep-input').value = String(n||0);
        } catch(_) {}
        openAt(Math.min(window.innerWidth-200, r.left), Math.min(window.innerHeight-140, r.bottom+6));
      }, true);

      // submit/cancel handlers
      document.addEventListener('click', (e) => {
        if (!pop || pop.classList.contains('hidden')) return;
        if (e.target.closest('[data-prep-action="cancel"]')) { e.preventDefault(); close(); return; }
        if (e.target.closest('[data-prep-action="submit"]')) {
          e.preventDefault();
          const val = Math.max(0, Math.floor(Number(document.getElementById('wm2-prep-input').value)||0));
          if (ctx && window.weekMenuAPI && window.weekMenuAPI.setPrepExtra) {
            window.weekMenuAPI.setPrepExtra(ctx.day, ctx.meal, ctx.index, val);
            // request auto-save and rebuild
            try { if (window.weekMenuAPI && window.weekMenuAPI.requestAutoSave) window.weekMenuAPI.requestAutoSave(); } catch(_) {}
            try { if (typeof rebuild==='function') rebuild(); } catch(_) {}
          }
          close();
          return;
        }
        // click outside popover closes it
        if (!e.target.closest('#wm2-prep-pop')) close();
      });
    })();
  </script>

  <!-- weekMenu is already included near the top (pre-hidden) -->
</div>
<script>
  // Weekly supplies aggregator and toggle
  (function(){
    const specialPrefixUnits = new Set(['大さじ','小さじ']);
    const formatQty = (val) => {
      if (typeof val !== 'number' || Number.isNaN(val)) return '';
      const n = Math.round(val * 10) / 10; return n % 1 ? n.toFixed(1) : String(n);
    };
    const formatUnitEntry = ({ amount, unit, missingAmount }) => {
      if (missingAmount) return '数量未設定';
      const q = formatQty(amount);
      if (!unit) return q;
      if (specialPrefixUnits.has(unit)) return unit + q;
      const nonAscii = /[^\x00-\x7F]/.test(unit);
      return nonAscii ? `${q}${unit}` : `${q} ${unit}`;
    };

    const computeWeekly = () => {
      const data = window.weekMenuData || {}; const lookup = data.menuLookup || {};
      const grp = Number(data.groupSize) > 0 ? Number(data.groupSize) : 1;
      const plan = (data.planSnapshot || data.plan) || [];
      const items = new Map();
      const merge = (src, mult, type) => {
        if (!src || !src.name) return; const name = src.name; const unit = src.unit || '';
        const entry = items.get(name) || { unitMap:new Map(), types:new Set(), classByType:new Map() };
        const u = entry.unitMap.get(unit) || { amount:0, missingAmount:false };
        if (typeof src.amount === 'number' && !Number.isNaN(src.amount)) { u.amount += src.amount * mult; } else { u.missingAmount = true; }
        entry.unitMap.set(unit, u); if (type) entry.types.add(type);
        if (type && src.classification) entry.classByType.set(type, src.classification);
        items.set(name, entry);
      };
      (plan||[]).forEach((day)=>{
        const lunch = Array.isArray(day?.lunchSlots)? day.lunchSlots: [];
        let dinner = Array.isArray(day?.dinnerSlots)? day.dinnerSlots: [];
        if (!Array.isArray(day?.dinnerSlots)){
          const base = day?.dinner && typeof day.dinner==='object' ? ['staple','main','side','soup'].map(k=>day.dinner[k]).filter(Boolean): [];
          const extras = Array.isArray(day?.dinnerExtras)? day.dinnerExtras.filter(Boolean): [];
          dinner = [...base, ...extras];
        }
        [...lunch, ...dinner].forEach((slot)=>{
          if (!slot || slot.dineOut) return; const menu = slot.menuId ? (lookup[slot.menuId] || slot.menu || null) : (slot.menu || null); if (!menu) return;
          const base = Number(menu.people); const mult = base && base>0 ? (grp/base) : 1;
          (Array.isArray(menu.ingredients)? menu.ingredients: []).forEach(it=> merge(it, mult, 'ingredient'));
          (Array.isArray(menu.seasoning)? menu.seasoning: []).forEach(it=> merge(it, mult, 'seasoning'));
        });
      });
      const all = Array.from(items.entries()).map(([name, entry])=>({
        name,
        types: Array.from(entry.types),
        units: Array.from(entry.unitMap.entries()).map(([unit, u])=>({ unit, amount: u.missingAmount? null : Math.round(u.amount*10)/10, missingAmount: u.missingAmount })),
        classByType: entry.classByType
      })).sort((a,b)=> a.name.localeCompare(b.name,'ja'));
      return {
        ingredients: all.filter(x=> !x.types.length || x.types.includes('ingredient')),
        seasonings: all.filter(x=> !x.types.length || x.types.includes('seasoning'))
      };
    };

    // Shopping list renderer inside weekMenu2
    const render = async () => {
      const box = document.getElementById('wm2-supplies'); if (!box) return;
      const data = window.weekMenuData || {}; const groupId = data.currentGroupId || '';
      const weekISO = data.weekStartISO || (Array.isArray(data.weekDates) && data.weekDates[0] && data.weekDates[0].dateISO) || '';
      const KEY = `shopping:${groupId}:${weekISO}`;
      const API_URL = '/users/shopping-list/api/state';
      const loadLocalState = () => { try { return JSON.parse(localStorage.getItem(KEY)||'{}'); } catch(_) { return {}; } };
      const DKEY = KEY + ':dates';
      const loadLocalDates = () => { try { return JSON.parse(localStorage.getItem(DKEY)||'{}'); } catch(_) { return {}; } };
      const saveLocalState = (st) => { try { localStorage.setItem(KEY, JSON.stringify(st||{})); } catch(_) { } };
      const saveLocalDates = (st) => { try { localStorage.setItem(DKEY, JSON.stringify(st||{})); } catch(_) { } };
      const loadSharedState = async () => {
        if (!groupId || !weekISO) {
          return { state: loadLocalState(), dates: loadLocalDates() };
        }
        try {
          const res = await fetch(`${API_URL}?group=${encodeURIComponent(groupId)}&weekStart=${encodeURIComponent(weekISO)}`);
          if (!res.ok) throw new Error('fetch failed');
          const data = await res.json();
          const state = (data && typeof data.state === 'object') ? data.state : {};
          const dates = (data && typeof data.dates === 'object') ? data.dates : {};
          const serverEmpty = (!state || Object.keys(state).length === 0) && (!dates || Object.keys(dates).length === 0);
          const localState = loadLocalState();
          const localDates = loadLocalDates();
          const localHas = (localState && Object.keys(localState).length > 0) || (localDates && Object.keys(localDates).length > 0);
          if (serverEmpty && localHas) {
            try {
              await fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  groupId,
                  weekStart: weekISO,
                  state: localState,
                  dates: localDates
                })
              });
              return { state: localState || {}, dates: localDates || {} };
            } catch (_) {
              return { state: localState || {}, dates: localDates || {} };
            }
          }
          return { state, dates };
        } catch (_) {
          return { state: loadLocalState(), dates: loadLocalDates() };
        }
      };
      const scheduleSharedSave = () => {
        if (!groupId || !weekISO) return;
        if (window.__wm2_supSaveTimer) clearTimeout(window.__wm2_supSaveTimer);
        window.__wm2_supSaveTimer = setTimeout(async () => {
          window.__wm2_supSaveTimer = null;
          try {
            await fetch(API_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                groupId,
                weekStart: weekISO,
                state: window.__wm2_supStateCache || {},
                dates: window.__wm2_supDates || {}
              })
            });
          } catch (_) {
            saveLocalState(window.__wm2_supStateCache || {});
            saveLocalDates(window.__wm2_supDates || {});
          }
        }, 300);
      };

      if (!window.__wm2_supStateCache || !window.__wm2_supDates) {
        const shared = await loadSharedState();
        window.__wm2_supStateCache = shared.state || {};
        window.__wm2_supDates = shared.dates || {};
      }
      const state = window.__wm2_supStateCache || {};
      const dates = window.__wm2_supDates || {};

      const agg = computeWeekly();
      const fmtDate = (iso)=>{ try { const d=new Date(iso); if (isNaN(d)) return ''; return d.toLocaleDateString('ja-JP'); } catch(_){ return ''; } };
      // Build my-stock name sets and name->id map (cached)
      async function getStockNameSets(){
        if (window.__wm2_stockNameSets) return window.__wm2_stockNameSets;
        try{
          const [stocksRes, ingRes, seaRes] = await Promise.all([
            fetch('/users/my-stock/api/stocks'),
            fetch('/users/my-menu/api/ingredients?limit=1000'),
            fetch('/users/my-menu/api/seasonings?limit=1000')
          ]);
          const [stocks, ings, seas] = await Promise.all([stocksRes.json(), ingRes.json(), seaRes.json()]);
          // id->name maps
          const ingMap = new Map((ings||[]).map(x=> [String(x._id||x.id), x.ingredient || x.name]));
          const seaMap = new Map((seas||[]).map(x=> [String(x._id||x.id), x.seasoning || x.name]));
          // name->id maps
          const ingNameToId = new Map((ings||[]).map(x=> [(x.ingredient || x.name || '').toString(), String(x._id||x.id)]));
          const seaNameToId = new Map((seas||[]).map(x=> [(x.seasoning || x.name || '').toString(), String(x._id||x.id)]));
          const ingNameSet = new Set(); const seaNameSet = new Set();
          (stocks||[]).forEach(s=>{
            if (s.type==='ingredient'){
              const n=ingMap.get(String(s.item)); if(n) ingNameSet.add(n);
            } else if (s.type==='seasoning'){
              const n=seaMap.get(String(s.item)); if(n) seaNameSet.add(n);
            }
          });
          window.__wm2_stockNameSets = { ingNameSet, seaNameSet, ingNameToId, seaNameToId };
          return window.__wm2_stockNameSets;
        }catch(_){ return { ingNameSet: new Set(), seaNameSet: new Set(), ingNameToId: new Map(), seaNameToId: new Map() }; }
      }

      const { ingNameSet, seaNameSet } = await getStockNameSets();

      const entries = [];
      const makeKey = (type, name) => `${type}:${name}`; // stable key across renders
      // Build entries from aggregated items
      (agg.ingredients||[]).forEach((it)=>{
        const entry = {
          type:'ingredient',
          name: it.name,
          classification: (it.classByType && it.classByType.get && it.classByType.get('ingredient')) ? it.classByType.get('ingredient') : '',
          amountText: (it.units||[]).map(formatUnitEntry).filter(Boolean).join(' + ') || '数量未設定'
        };
        entry.key = makeKey('ingredient', entry.name);
        entry.fromStock = ingNameSet.has(it.name);
        entries.push(entry);
      });
      (agg.seasonings||[]).forEach((it)=>{
        const entry = {
          type:'seasoning',
          name: it.name,
          classification: (it.classByType && it.classByType.get && it.classByType.get('seasoning')) ? it.classByType.get('seasoning') : '',
          amountText: (it.units||[]).map(formatUnitEntry).filter(Boolean).join(' + ') || '数量未設定'
        };
        entry.key = makeKey('seasoning', entry.name);
        entry.fromStock = seaNameSet.has(it.name);
        entries.push(entry);
      });

      // Partition by effective checked state
      const buyItems = []; // unchecked
      const doneItems = []; // checked
      entries.forEach((it)=>{
        const legacyKey = `${it.type}:${it.name}:${it.amountText}`; // backward compatibility
        const hasNew = Object.prototype.hasOwnProperty.call(state, it.key);
        const hasOld = Object.prototype.hasOwnProperty.call(state, legacyKey);
        const checked = hasNew ? !!state[it.key] : (hasOld ? !!state[legacyKey] : it.fromStock);
        const x = { ...it, checked };
        (checked ? doneItems : buyItems).push(x);
      });

      const normalizeClassLabel = (val) => (val && String(val).trim()) ? String(val).trim() : 'その他';
      const sortClassLabels = (labels) => labels.sort((a, b) => {
        if (a === 'その他' && b !== 'その他') return 1;
        if (b === 'その他' && a !== 'その他') return -1;
        return a.localeCompare(b, 'ja');
      });
      const groupByClass = (items) => {
        const map = new Map();
        (items || []).forEach((it) => {
          const label = normalizeClassLabel(it.classification);
          if (!map.has(label)) map.set(label, []);
          map.get(label).push(it);
        });
        return map;
      };
      const listTpl = (id, items)=>{
        const wrap = document.createElement('div'); wrap.id=id;
        const makeList = (listItems) => {
          const ul = document.createElement('ul'); ul.className='list space-y-2';
          (listItems||[]).forEach((it)=>{
            const checked = !!it.checked;
            const li = document.createElement('li'); li.className = 'li ' + (checked ? 'checked' : ''); li.dataset.key = it.key; li.dataset.fromStock = it.fromStock ? 'true' : 'false';
            li.dataset.type = it.type; li.dataset.name = it.name;
            li.innerHTML = `
              <div class="flex items-start gap-2 w-full">
                <input type="checkbox" class="mt-1" name="wm2-supply-check" aria-label="${it.name}" ${checked ? 'checked' : ''} />
                <span class="flex-1">
                  <span class="text-sm font-medium text-gray-800">${it.name}</span>
                  <span class="ml-2 text-xs text-gray-600">${it.amountText}</span>
                  <span class="ml-2" data-role="state-inline"></span>
                </span>
                <span class="pill ${it.type==='ingredient'?'ing':'sea'}">${it.type==='ingredient'?'食材':'調味料'}</span>
                ${!it.fromStock ? `
                  <button type="button" class="ml-2 inline-flex items-center justify-center rounded-full border border-purple-300 text-purple-700 bg-purple-50 hover:bg-purple-100 px-2 py-1 text-xs font-semibold" data-action="wm2-add-stock" title="マイストックに追加">
                    <span class="text-xs font-bold leading-none mr-0.5">＋</span>
                    <span class="lucide w-3.5 h-3.5" data-lucide="package"></span>
                  </button>
                ` : ''}
              </div>`;
            ul.appendChild(li);
            try {
              if (checked && li.dataset.fromStock !== 'true') {
                const inline = li.querySelector('[data-role="state-inline"]');
                const d = (window.__wm2_supDates && window.__wm2_supDates[it.key]) || '';
                if (inline && d) inline.innerHTML = '<span class="pill state purchased">購入済み ' + (fmtDate(d) || '') + '</span>';
              }
            } catch(_) {}
          });
          return ul;
        };
        const renderType = (title, listItems) => {
          if (!listItems || !listItems.length) return;
          const h = document.createElement('h5'); h.className='mt-2 text-xs font-semibold text-gray-500'; h.textContent=title; wrap.appendChild(h);
          const groups = groupByClass(listItems);
          const labels = sortClassLabels(Array.from(groups.keys()));
          labels.forEach((label)=>{
            const sub = document.createElement('div'); sub.className='mt-2 text-[11px] font-semibold text-gray-500'; sub.textContent = label; wrap.appendChild(sub);
            wrap.appendChild(makeList(groups.get(label)));
          });
        };
        const ing = (items||[]).filter((it)=> it.type === 'ingredient');
        const sea = (items||[]).filter((it)=> it.type === 'seasoning');
        renderType('食材', ing);
        renderType('調味料', sea);
        return wrap;
      };

      box.innerHTML='';
      const note = document.createElement('div'); note.className='sup-note mb-2'; note.textContent='チェックを入れると購入済みに移動します。'; box.appendChild(note);
      const grid = document.createElement('div'); grid.className='grid grid-cols-1 md:grid-cols-2 gap-4';
      const left = document.createElement('div');
      const h1 = document.createElement('h4'); h1.textContent = '買うもの'; left.appendChild(h1);
      left.appendChild(listTpl('wm2-sup-buy', buyItems));
      const right = document.createElement('div');
      const h2 = document.createElement('h4'); h2.textContent = 'ストック / 購入済み'; right.appendChild(h2);
      right.appendChild(listTpl('wm2-sup-done', doneItems));
      grid.appendChild(left); grid.appendChild(right); box.appendChild(grid);
      if (window.refreshLucideIcons) window.refreshLucideIcons();

      // bind change handler once (delegated)
      if (!window.__wm2_bindSuppliesChange){
        document.addEventListener('change', (ev)=>{
          const cb = ev.target && ev.target.closest && ev.target.closest('#wm2-supplies input[type="checkbox"]');
          if (!cb) return;
          const li = cb.closest('li'); if (!li) return;
          const key = li.dataset.key; const checked = !!cb.checked; state[key] = checked;
          const fromStock = li.dataset.fromStock === 'true';
          if (checked){
            if (fromStock){
              // no date stored for stock
            } else {
              // purchased: store date and render inline tag
              const nowISO = new Date().toISOString();
              try { window.__wm2_supDates[key] = nowISO; } catch(_){}
            }
          } else {
            try { delete window.__wm2_supDates[key]; } catch(_){}
          }
          scheduleSharedSave();
          render();
        });
        // Add-to-MyStock button handler (open modal for details)
        document.addEventListener('click', async (ev)=>{
          const btn = ev.target && ev.target.closest && ev.target.closest('#wm2-supplies [data-action="wm2-add-stock"]');
          if (!btn) return;
          const li = btn.closest('li'); if (!li) return;
          const type = li.dataset.type; const name = li.dataset.name; const key = li.dataset.key;
          const { ingNameToId, seaNameToId, ingNameSet, seaNameSet } = await getStockNameSets();
          const id = type === 'ingredient' ? ingNameToId.get(name) : seaNameToId.get(name);
          if (!id) { alert('品目のIDが見つかりません'); return; }

          // Build modal
          const modal = document.createElement('div');
          modal.className = 'fixed inset-0 z-50';
          modal.innerHTML = `
            <div class="absolute inset-0 bg-black/40" data-close></div>
            <div class="relative mx-auto mt-10 w-[720px] max-w-[96vw] rounded-xl bg-white shadow-xl">
              <div class="flex items-center justify-between border-b px-5 py-3">
                <h3 class="font-semibold">マイストックに追加</h3>
                <button type="button" data-close class="text-gray-500">✕</button>
              </div>
              <div class="p-4 space-y-3">
                <div class="text-sm">
                  <span class="font-semibold">対象:</span>
                  ${name}
                  <span class="ml-2 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] text-gray-600">
                    ${type==='ingredient'?'食材':'調味料'}
                  </span>
                </div>
                <div class="grid grid-cols-3 gap-2 border rounded bg-blue-50 p-3">
                  <div>
                    <label class="text-xs text-gray-500" for="wm2-stock-amount">数量</label>
                    <input id="wm2-stock-amount" name="amount" data-x="amount" type="number" step="0.1" min="0" class="w-full border rounded px-2 py-1" placeholder="例: 1">
                  </div>
                  <div>
                    <label class="text-xs text-gray-500" for="wm2-stock-unit">単位</label>
                    <input id="wm2-stock-unit" name="unit" data-x="unit" class="w-full border rounded px-2 py-1" placeholder="例: 個 / g / ml">
                  </div>
                  <div>
                    <label class="text-xs text-gray-500" for="wm2-stock-place">保管場所</label>
                    <select id="wm2-stock-place" name="place" data-x="place" class="w-full border rounded px-2 py-1"><option value="">選択してください</option></select>
                    <button type="button" data-x="placeAdd" class="ml-2 text-xs text-emerald-700 underline">新規追加</button>
                  </div>
                  <div class="col-span-3 md:col-span-2 space-y-1">
                    <label class="text-xs text-gray-500" for="wm2-stock-product-url">商品URL（任意）</label>
                    <div class="flex flex-col gap-3 md:flex-row md:items-start">
                      <div class="flex-1 min-w-0 space-y-1">
                        <input id="wm2-stock-product-url" name="productUrl" data-x="productUrl" type="url" class="w-full border rounded px-2 py-1" placeholder="例: https://www.amazon.co.jp/...">
                        <div class="text-[11px] text-gray-500" data-role="image-url">
                          画像URL：
                          <span data-role="image-url-text" class="break-all">未取得</span>
                        </div>
                      </div>
                      <div class="w-full md:w-28">
                        <div class="border border-dashed border-gray-300 rounded bg-white h-28 flex items-center justify-center overflow-hidden">
                          <img data-role="image-preview" class="max-w-full max-h-full object-contain hidden" alt="商品画像">
                          <span data-role="image-placeholder" class="text-[11px] text-gray-400">プレビュー</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-span-3 flex flex-wrap items-center gap-3">
                    <label class="inline-flex items-center gap-2 text-xs text-gray-700">
                      <input type="checkbox" id="wm2-stock-stockpile" name="stockpile" data-x="stockpile" class="rounded">
                      備蓄
                    </label>
                    <div class="flex-1 min-w-0">
                      <label class="text-xs text-gray-500" for="wm2-stock-comment">コメント</label>
                      <input id="wm2-stock-comment" name="comment" data-x="comment" class="w-full border rounded px-2 py-1" placeholder="メモなど">
                    </div>
                  </div>
                  <div class="col-span-3">
                    <label class="text-xs text-gray-500" for="wm2-stock-exp">賞味期限</label>
                    <input id="wm2-stock-exp" name="exp" data-x="exp" type="date" class="w-full border rounded px-2 py-1">
                  </div>
                </div>
                <div class="flex items-center justify-end gap-2 pt-3">
                  <button type="button" data-close class="px-3 py-1.5 rounded border">キャンセル</button>
                  <button type="button" data-x="save" class="px-4 py-1.5 rounded bg-blue-600 text-white text-sm inline-flex items-center gap-1">
                    <span class="lucide w-4 h-4" data-lucide="package-plus"></span>
                    追加する
                  </button>
                </div>
              </div>
            </div>`;
          document.body.appendChild(modal);
          if (window.refreshLucideIcons) window.refreshLucideIcons();

          const close = () => { try { clearTimeout(imageFetchTimer); modal.remove(); } catch(_){} };
          modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });
          const productUrlInput = modal.querySelector('[data-x="productUrl"]');
          const imageUrlText = modal.querySelector('[data-role="image-url-text"]');
          const imagePreview = modal.querySelector('[data-role="image-preview"]');
          const imagePlaceholder = modal.querySelector('[data-role="image-placeholder"]');
          let cachedImageUrl = '';
          let imageFetchTimer = null;
          let imageFetchId = 0;
          const updateImagePreview = (url, fallback) => {
            cachedImageUrl = url || '';
            if (imageUrlText) imageUrlText.textContent = url ? url : (fallback || '未取得');
            if (imagePreview) {
              if (url) {
                imagePreview.src = url;
                imagePreview.classList.remove('hidden');
              } else {
                imagePreview.src = '';
                imagePreview.classList.add('hidden');
              }
            }
            if (imagePlaceholder) {
              imagePlaceholder.classList.toggle('hidden', !!url);
            }
          };
          const fetchImageFromUrl = async (value, runId) => {
            try {
              const res = await fetch('/users/my-stock/api/product-image?url=' + encodeURIComponent(value));
              if (!res.ok) throw new Error('fetch failed');
              const data = await res.json();
              if (runId !== imageFetchId) return;
              if (data && data.imageUrl) {
                updateImagePreview(data.imageUrl);
              } else {
                updateImagePreview('', '取得できませんでした');
              }
            } catch (_){
              if (runId !== imageFetchId) return;
              updateImagePreview('', '取得に失敗しました');
            }
          };
          const scheduleImageFetch = (inputValue) => {
            imageFetchId += 1;
            const runId = imageFetchId;
            clearTimeout(imageFetchTimer);
            if (!inputValue){
              updateImagePreview('', '未取得');
              return;
            }
            if (imageUrlText) imageUrlText.textContent = '読み込み中…';
            imageFetchTimer = setTimeout(()=> fetchImageFromUrl(inputValue, runId), 450);
          };
          if (productUrlInput){
            productUrlInput.addEventListener('input', ()=>{
              const value = String(productUrlInput.value || '').trim();
              scheduleImageFetch(value);
            });
          }
          updateImagePreview('', '未取得');

          // Load places
          (async()=>{ try{ const list= await (await fetch('/users/my-stock/api/places')).json(); const sel=modal.querySelector('[data-x="place"]'); sel.innerHTML='<option value="">選択してください</option>'; (list||[]).forEach(p=>{ const op=document.createElement('option'); op.value=p._id; op.textContent=p.name; sel.appendChild(op); }); }catch(_){ } })();
          modal.querySelector('[data-x="placeAdd"]').addEventListener('click', async ()=>{
            const pname = prompt('保管場所名'); if(!pname) return;
            try{
              const res = await fetch('/users/my-stock/api/places', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name: pname }) });
              if (res.ok){ const created = await res.json(); const sel=modal.querySelector('[data-x="place"]'); const op=document.createElement('option'); op.value=created._id; op.textContent=created.name; sel.appendChild(op); sel.value=created._id; }
            }catch(_){ alert('保管場所の追加に失敗しました'); }
          });

          modal.querySelector('[data-x="save"]').addEventListener('click', async ()=>{
            const payload = {
              type,
              id,
              amount: modal.querySelector('[data-x="amount"]').value,
              unit: modal.querySelector('[data-x="unit"]').value,
              placeId: modal.querySelector('[data-x="place"]').value || null,
              expiryDate: modal.querySelector('[data-x="exp"]').value || null,
              stockpile: !!modal.querySelector('[data-x="stockpile"]').checked,
              comment: (modal.querySelector('[data-x="comment"]').value||'').trim(),
              productUrl: (modal.querySelector('[data-x="productUrl"]').value||'').trim(),
              productImageUrl: cachedImageUrl || ''
            };
            try{
              const res = await fetch('/users/my-stock/api/stocks', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
              if (!res.ok) throw new Error('登録に失敗しました');
            }catch(e){ alert(e.message || '登録に失敗しました'); return; }

            // Update caches and UI
            if (type === 'ingredient') { ingNameSet.add(name); } else { seaNameSet.add(name); }
            li.dataset.fromStock = 'true';
            state[key] = true; try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(_){ }
            const cb = li.querySelector('input[type="checkbox"]'); if (cb && !cb.checked) cb.checked = true;
            const done = document.getElementById('wm2-sup-done'); if (done) done.appendChild(li);
            li.classList.add('checked');
            const stateTag = li.querySelector('[data-role="state"]');
            if (stateTag){
              stateTag.classList.remove('hidden');
              stateTag.classList.add('stock');
              stateTag.classList.remove('purchased');
              stateTag.innerHTML = '<span class="lucide w-3 h-3" data-lucide="package"></span><span class="ml-1">ストック</span>';
            }
            const inlineTag = li.querySelector('[data-role="state-inline"]'); if (inlineTag) inlineTag.innerHTML='';
            const addBtn = li.querySelector('[data-action="wm2-add-stock"]'); if (addBtn) addBtn.remove();
            if (window.refreshLucideIcons) window.refreshLucideIcons();
            close();
          });
        });
        window.__wm2_bindSuppliesChange = true;
      }
    };

    const toggleBtn = document.getElementById('wm2-toggle-supplies');
    const box = document.getElementById('wm2-supplies');
    const preview = document.getElementById('wm2-preview');
    const main = document.getElementById('wm2-main');
    const section = document.getElementById('wm2-section');
    const setMode = (mode) => { // 'menu' | 'supplies'
      const showSupplies = mode === 'supplies';
      if (box) box.classList.toggle('hidden', !showSupplies);
      if (preview) preview.classList.toggle('hidden', showSupplies);
      if (main) main.classList.toggle('hidden', showSupplies);
      if (toggleBtn) toggleBtn.textContent = showSupplies ? 'メニューの表示' : 'お買い物リストを表示';
      if (section) section.dataset.mode = showSupplies ? 'supplies' : 'menu';
      if (showSupplies) render();
    };
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const nowShowing = !box?.classList.contains('hidden');
        setMode(nowShowing ? 'menu' : 'supplies');
      });
    }

    const regenBtn = document.getElementById('wm2-regenerate');
    if (regenBtn) {
      const regenDefaultHTML = regenBtn.innerHTML;
      let regenArmed = false;
      let regenArmTimer = null;
      regenBtn.addEventListener('click', async () => {
        if (!regenArmed) {
          regenArmed = true;
          if (regenArmTimer) clearTimeout(regenArmTimer);
          regenArmTimer = setTimeout(() => { regenArmed = false; }, 2000);
          return;
        }
        regenArmed = false;
        if (regenArmTimer) { clearTimeout(regenArmTimer); regenArmTimer = null; }
        const ok = window.confirm('1週間のメニューを再提案します。よろしいですか？');
        if (!ok) return;
        const groupId = regenBtn.dataset.groupId || (window.weekMenuData && window.weekMenuData.currentGroupId) || '';
        const weekStartISO = regenBtn.dataset.weekStart || (window.weekMenuData && window.weekMenuData.weekStartISO) || '';
        if (!groupId || !weekStartISO) {
          alert('再提案に必要な情報が不足しています。');
          return;
        }
        regenBtn.disabled = true;
        regenBtn.classList.add('opacity-70', 'cursor-not-allowed');
        regenBtn.innerHTML = '再提案中...';
        try {
          const res = await fetch('/users/week-menu/regenerate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ groupId, weekStart: weekStartISO })
          });
          if (!res.ok) {
            throw new Error('failed');
          }
          window.location.reload();
        } catch (e) {
          alert('メニューの再提案に失敗しました。時間をおいて再度お試しください。');
          regenBtn.disabled = false;
          regenBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          regenBtn.innerHTML = regenDefaultHTML;
        }
      });
    }

    // Default to supplies mode when query param show=supplies
    try {
      const qp = new URLSearchParams(window.location.search || '');
      if (qp.get('show') === 'supplies') setMode('supplies');
    } catch (_) { /* noop */ }

    // Re-render when plan changes
    document.addEventListener('weekplan:rendered', ()=>{ if (box && !box.classList.contains('hidden')) render(); });
    document.addEventListener('click', (e)=>{
      const needsRefresh = e.target.closest('[data-menu-option]') || e.target.closest('[data-fav-action="submit"]') || e.target.closest('[data-action="toggle-dine"]') || e.target.closest('[data-action="clear-slot"]') || e.target.closest('[data-action="shuffle"]');
      if (needsRefresh && box && !box.classList.contains('hidden')) setTimeout(render, 50);
    });
  })();
</script>
