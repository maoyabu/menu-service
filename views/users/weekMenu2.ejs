    <div class="space-y-3">
      <label class="block text-sm text-gray-700">過去の理由から選択（任意）</label>
      <select id="wm2-reason-select" class="w-full border rounded px-2 py-1 text-sm">
        <option value="">選択しない</option>
      </select>
      <label class="block text-sm text-gray-700">自由入力（任意）</label>
      <textarea id="wm2-reason-input" class="w-full border rounded px-2 py-1 text-sm" rows="3" placeholder="例：外出のため、ダイエット中 など"></textarea>
    </div>
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" data-reason-action="cancel" class="px-3 py-1.5 rounded border">キャンセル</button>
      <button type="button" data-reason-action="skip" class="px-3 py-1.5 rounded border">理由なしで確定</button>
      <button type="button" data-reason-action="submit" class="px-3 py-1.5 rounded bg-blue-600 text-white">確定</button>
    </div>
  </div>
  <script>
    (function(){
      let ctx = null; // { day, meal }
      const modal = document.getElementById('wm2-reason-modal');
      const sel = document.getElementById('wm2-reason-select');
      const input = document.getElementById('wm2-reason-input');

      async function open(day, meal){
        ctx = { day, meal };
        input.value = '';
        sel.innerHTML = '<option value="">選択しない</option>';
        // fetch past reasons
        try {
          const gid = (window.weekMenuData && window.weekMenuData.currentGroupId) || '';
          if (gid) {
            const res = await fetch(`/users/week-menu/participant-reasons?group=${encodeURIComponent(gid)}`);
            if (res.ok) {
              const json = await res.json();
              const list = Array.isArray(json?.reasons) ? json.reasons : [];
              list.forEach((r) => {
                const opt = document.createElement('option');
                opt.value = r; opt.textContent = r; sel.appendChild(opt);
              });
            }
          }
        } catch(_) {}
        modal.classList.remove('hidden');
      }
      function close(){ modal.classList.add('hidden'); ctx = null; }

      // expose to attendee handler
      window.__wm2_openReasonModal = open;

      document.addEventListener('click', async (ev) => {
        const t = ev.target;
        if (!modal || modal.classList.contains('hidden')) return;
        if (t.closest('[data-reason-action="cancel"]')) { ev.preventDefault(); close(); return; }
        if (t.closest('[data-reason-action="skip"]')) {
          ev.preventDefault();
          if (ctx) {
            // trigger original removal without reason
            window.__wm2_submitRemove(ctx.day, ctx.meal, '');
          }
          close();
          return;
        }
        if (t.closest('[data-reason-action="submit"]')) {
          ev.preventDefault();
          const reason = (input.value || sel.value || '').trim();
          if (ctx) {
            window.__wm2_submitRemove(ctx.day, ctx.meal, reason);
          }
          close();
          return;
        }
        if (t.id === 'wm2-reason-modal') { close(); }
      });
    })();
  </script>

