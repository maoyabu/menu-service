    function buildPills(){
      const row = document.getElementById('wm2-days'); if (!row) return; row.innerHTML='';
      DAY_DISPLAY_ORDER.forEach((idx)=>{
        const d = WEEK[idx];
        if (!d) return;
        const f=toLabel(d); const b=document.createElement('button'); b.type='button'; b.className='day-pill'; b.dataset.index=String(idx); b.dataset.active= String(idx===sel);
