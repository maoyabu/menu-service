      try {
        return new Date(iso);
      } catch (_) {
        return null;
      }
    };
    const computeDaySpan = (idx) => {
      const startDate = getDateFromWeek(0);
      const targetDate = getDateFromWeek(idx);
      if (!startDate || !targetDate) return idx + 1;
      const ms = targetDate.setHours(0,0,0,0) - startDate.setHours(0,0,0,0);
      const days = Math.floor(ms / (24 * 60 * 60 * 1000));
