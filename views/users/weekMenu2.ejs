      // event delegation for stability across rebuilds
      row.onclick = (ev)=>{
        const btn = ev.target.closest('.day-pill');
        if (!btn) return;
        const idx = Number(btn.dataset.index);
        if (!Number.isNaN(idx)) { sel = idx; rebuild(); }
      };
    }

    const dragPayloadType = 'application/x-week-menu-slot';
    let currentDragPayload = null;
    const dndDayTargets = document.getElementById('wm2-dnd-day-targets');
    const dndDayTitle = document.getElementById('wm2-dnd-day-title');
    const dndDayList = document.getElementById('wm2-dnd-day-list');
    const mealLabelForDrag = (meal) => {
      if (meal === 'breakfast') return '朝食';
      if (meal === 'lunch') return 'ランチ';
      if (meal === 'dinner') return 'ディナー';
      return 'メニュー';
    };
    const closestEl = (target, selector) => {
      if (!target || !target.closest) return null;
      return target.closest(selector);
    };
    const renderDndDayTargets = (payload) => {
      if (!dndDayTargets || !dndDayList || !payload) return;
      dndDayList.innerHTML = '';
      if (dndDayTitle) dndDayTitle.textContent = `${mealLabelForDrag(payload.fromMeal)}の移動先`;
      DAY_DISPLAY_ORDER.forEach((idx) => {
        const entry = WEEK[idx];
        if (!entry) return;
        const info = toLabel(entry);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'dnd-day';
        btn.dataset.dropDay = String(idx);
        btn.dataset.active = String(idx === Number(payload.fromDay));
        btn.disabled = getPlanData()[idx]?.isPreviousWeekDay === true;
        btn.innerHTML = `<span>${info.dow || WEEKDAY[idx] || ''}</span><span>${info.disp || ''}</span>`;
        dndDayList.appendChild(btn);
      });
    };
    const positionDndDayTargets = (anchorEl) => {
      if (!dndDayTargets || !anchorEl || window.innerWidth <= 768) return;
      const rect = anchorEl.getBoundingClientRect();
      const gap = 12;
      const viewportPadding = 8;
      const panelWidth = dndDayTargets.offsetWidth || 132;
      const panelHeight = dndDayTargets.offsetHeight || 340;
      let left = rect.right + gap;
      if (left + panelWidth > window.innerWidth - viewportPadding) {
        left = rect.left - panelWidth - gap;
      }
      left = Math.max(viewportPadding, Math.min(left, window.innerWidth - panelWidth - viewportPadding));
      let top = rect.top + Math.max(0, (rect.height - panelHeight) / 2);
      top = Math.max(viewportPadding, Math.min(top, window.innerHeight - panelHeight - viewportPadding));
      dndDayTargets.style.left = `${left}px`;
      dndDayTargets.style.top = `${top}px`;
      dndDayTargets.style.right = 'auto';
      dndDayTargets.style.bottom = 'auto';
    };
    const resetDndDayTargetsPosition = () => {
      if (!dndDayTargets) return;
      dndDayTargets.style.left = '';
      dndDayTargets.style.top = '';
      dndDayTargets.style.right = '';
      dndDayTargets.style.bottom = '';
    };
    const showDndDayTargets = (payload, anchorEl = null) => {
      if (!dndDayTargets || !payload) return;
      if (currentViewMode === 'week') {
        hideDndDayTargets();
        return;
      }
      renderDndDayTargets(payload);
      dndDayTargets.hidden = false;
      dndDayTargets.setAttribute('aria-hidden', 'false');
      if (window.innerWidth <= 768) {
        resetDndDayTargetsPosition();
      } else {
        positionDndDayTargets(anchorEl);
      }
    };
    const hideDndDayTargets = () => {
      if (!dndDayTargets) return;
      dndDayTargets.hidden = true;
      dndDayTargets.setAttribute('aria-hidden', 'true');
      if (dndDayList) dndDayList.innerHTML = '';
      resetDndDayTargetsPosition();
    };
    const getDropMealFromWrap = (target) => {
      const wrap = closestEl(target, '#wm2-day-breakfast, #wm2-day-lunch, #wm2-day-dinner');
      if (!wrap) return '';
      if (wrap.id === 'wm2-day-breakfast') return 'breakfast';
      if (wrap.id === 'wm2-day-lunch') return 'lunch';
      if (wrap.id === 'wm2-day-dinner') return 'dinner';
      return '';
    };
    const readDragPayload = (event) => {
      try {
        const raw = event.dataTransfer?.getData(dragPayloadType) || event.dataTransfer?.getData('text/plain') || '';
        return raw ? JSON.parse(raw) : null;
      } catch (_) {
        return null;
      }
    };
    document.addEventListener('dragstart', (event) => {
      const item = event.target.closest('.wm2-draggable');
      if (!item) return;
      const payload = {
        fromDay: Number(item.dataset.dragDay),
        fromMeal: item.dataset.dragMeal || '',
        fromIndex: Number(item.dataset.dragIndex)
      };
      currentDragPayload = payload;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData(dragPayloadType, JSON.stringify(payload));
      event.dataTransfer.setData('text/plain', JSON.stringify(payload));
      item.classList.add('opacity-60');
      showDndDayTargets(payload, item);
    });
    document.addEventListener('dragend', (event) => {
      const item = event.target.closest('.wm2-draggable');
      if (item) item.classList.remove('opacity-60');
      document.querySelectorAll('.wm2-drop-target').forEach((el) => el.classList.remove('wm2-drop-target'));
      currentDragPayload = null;
      setTimeout(hideDndDayTargets, 0);
    });
    document.addEventListener('dragover', (event) => {
      const payload = currentDragPayload || readDragPayload(event);
      if (!payload || !payload.fromMeal) return;
      const allowPillDrop = currentViewMode !== 'week';
      const dayTarget = allowPillDrop ? closestEl(event.target, '#wm2-dnd-day-targets [data-drop-day]') : null;
      const pill = allowPillDrop ? closestEl(event.target, '#wm2-days .day-pill') : null;
      const weekDropBucket = closestEl(event.target, '[data-week-drop-day][data-week-drop-meal]');
      const weekDropItem = closestEl(event.target, '.wm2-week-slot');
      const meal = getDropMealFromWrap(event.target);
      const weekMeal = weekDropBucket?.dataset.weekDropMeal || weekDropItem?.dataset.dragMeal || '';
      if (dayTarget || pill || meal === payload.fromMeal || weekMeal === payload.fromMeal) {
        event.preventDefault();
        event.dataTransfer.dropEffect = 'move';
        const target = dayTarget || pill || weekDropItem || weekDropBucket || closestEl(event.target, '.wm2-draggable') || closestEl(event.target, '#wm2-day-breakfast, #wm2-day-lunch, #wm2-day-dinner');
        if (target) target.classList.add('wm2-drop-target');
      }
    });
    document.addEventListener('dragleave', (event) => {
      const target = closestEl(event.target, '.wm2-drop-target');
      if (target) target.classList.remove('wm2-drop-target');
    });
    document.addEventListener('drop', (event) => {
      const payload = currentDragPayload || readDragPayload(event);
      if (!payload || !payload.fromMeal) return;
      const allowPillDrop = currentViewMode !== 'week';
      const dayTarget = allowPillDrop ? closestEl(event.target, '#wm2-dnd-day-targets [data-drop-day]') : null;
      const pill = allowPillDrop ? closestEl(event.target, '#wm2-days .day-pill') : null;
      const weekDropBucket = closestEl(event.target, '[data-week-drop-day][data-week-drop-meal]');
      const weekDropItem = closestEl(event.target, '.wm2-week-slot');
      const meal = getDropMealFromWrap(event.target);
      let toDay = sel;
      let toMeal = meal;
      let toIndex = null;
      if (dayTarget || pill) {
        toDay = Number((dayTarget || pill).dataset.dropDay || (dayTarget || pill).dataset.index);
        toMeal = payload.fromMeal;
      } else if (weekDropBucket || weekDropItem) {
        const target = weekDropBucket || weekDropItem;
        toDay = Number(target.dataset.weekDropDay || target.dataset.dragDay);
        toMeal = target.dataset.weekDropMeal || target.dataset.dragMeal || '';
        if (toMeal !== payload.fromMeal) return;
        if (weekDropItem) toIndex = Number(weekDropItem.dataset.dragIndex);
      } else {
        if (meal !== payload.fromMeal) return;
        const targetItem = closestEl(event.target, '.wm2-draggable');
        if (targetItem) toIndex = Number(targetItem.dataset.dragIndex);
      }
      const planForDrop = getPlanData();
      if (planForDrop[payload.fromDay]?.isPreviousWeekDay || planForDrop[toDay]?.isPreviousWeekDay) return;
      event.preventDefault();
      document.querySelectorAll('.wm2-drop-target').forEach((el) => el.classList.remove('wm2-drop-target'));
      hideDndDayTargets();
      const ok = window.weekMenuAPI && window.weekMenuAPI.moveSlot
        ? window.weekMenuAPI.moveSlot({ ...payload, toDay, toMeal, toIndex })
        : false;
      if (ok && Number.isInteger(toDay)) {
        sel = toDay;
        rebuild();
      }
      currentDragPayload = null;
    });

    const formatMenuServingValue = (value) => {
      const num = Number(value) || 0;
      const rounded = Math.round(num * 10) / 10;
      return rounded % 1 ? rounded.toFixed(1) : String(rounded);
    };
    const buildMenuServingTotals = (menu, multiplier = 1) => {
      const totals = SERVING_ITEMS.reduce((acc, item) => {
        acc[item.key] = 0;
        return acc;
      }, {});
      const addServings = (targetMenu) => {
        const servings = targetMenu?.servings || {};
        SERVING_ITEMS.forEach((item) => {
          const value = Number(servings[item.key]);
          if (!Number.isFinite(value) || value <= 0) return;
          totals[item.key] += value * multiplier;
        });
      };
      if (!menu) return totals;
      addServings(menu);
      if (menu.menuType === 'set' && Array.isArray(menu.setMenus)) {
        menu.setMenus.forEach(addServings);
      }
      return totals;
    };
    const getMenuServingChipItems = (servingTotals = {}) => SERVING_ITEMS
      .map((item) => ({
        label: item.label,
        value: Number(servingTotals?.[item.key]) || 0
      }))
      .filter((item) => item.value > 0);

    function rowFromSlot(slot){
      if (!slot) return { hasMenu:false };
      let m = null;
      if (slot.menuId && lookup[slot.menuId]) m = lookup[slot.menuId];
      if (!m && slot.menu) m = slot.menu; // fallback to embedded menu from weekMenu state
      if (!m) return { hasMenu:false };
      const isDineOut = !!slot.dineOut;
      const shopName = (slot.dineOutName || '').trim();
      const shopUrl = (slot.dineOutUrl || '').trim();
      const detail = m.cook || m.junle || m.kind || m.menu || '';
      const menuType = m.menuType || 'single';
      const setMenus = Array.isArray(m.setMenus) ? m.setMenus : [];
      let mealType = 'dinner';
      if (slot?.categoryKey === 'breakfastMain') {
        mealType = 'breakfast';
      } else if (slot?.categoryKey === 'lunchMain') {
        mealType = 'lunch';
      } else if (slot?.categoryKey && slot.categoryKey.startsWith('dinner')) {
        mealType = 'dinner';
      }
      const servingMultiplier = normalizeServingMultiplier(slot?.servingMultiplier);
      // Always keep menu name and image; only chips area changes for dine-out
      return {
        hasMenu:true,
        isDineOut,
        menuId: m.id || (slot.menuId ? String(slot.menuId) : ''),
        menuType,
        isArrangeBase: !!((m.id && arrangeBaseMenuIdSet.has(String(m.id))) || (slot.menuId && arrangeBaseMenuIdSet.has(String(slot.menuId)))),
        setMenus,
        name: m.name,
        imageUrl: m.imageUrl || '',
        url: m.url || '',
        time: (m.time ?? '') + '',
        cook: m.cook || '',
        junle: m.junle || '',
        prepExtra: Math.max(0, Number(slot?.prepExtra) || 0),
        servingMultiplier,
        servingTotals: buildMenuServingTotals(m, servingMultiplier),
        shopName,
        shopUrl,
        detail,
        mealType,
        mealLabel: mealType === 'breakfast' ? '朝食' : (mealType === 'lunch' ? 'ランチ' : 'ディナー')
      };
    }

    function buildSetMenuGrid(images, title){
      const count = Math.min(images.length, 5);
      if (!count) return '';
      const gridClass = count === 1 ? 'one' : (count === 2 ? 'two' : (count === 3 ? 'three' : (count === 4 ? 'four' : 'five')));
      let html = `<div class="wm2-set-grid ${gridClass}">`;
      const renderTile = (src, span) => {
        const spanClass = span ? ' span-2' : '';
        return `<div class="tile${spanClass}"><img src="${src}" alt="${title || ''}"></div>`;
      };
      if (count === 3) {
        html += renderTile(images[0], true);
        html += renderTile(images[1], false);
        html += renderTile(images[2], false);
      } else if (count === 5) {
        html += renderTile(images[0], true);
        for (let i = 1; i < 5; i += 1) {
          html += renderTile(images[i], false);
        }
      } else {
        for (let i = 0; i < count; i += 1) {
          html += renderTile(images[i], false);
        }
      }
      html += '</div>';
      return html;
    }

    function cardEl(row){
      const timeLabel = row.time ? (String(row.time).endsWith('分')? row.time: row.time+'分') : '';
      const wrap = document.createElement('div'); wrap.className='wm2-card';
      const cookChip = row.cook? `<span class=\"wm2-chip kind\"><span>調理方法</span><span>${row.cook}</span></span>`: '';
      const svChipsHtml = getMenuServingChipItems(row.servingTotals)
        .map((item) => `<span class=\"wm2-chip sv\"><span>${item.label}</span><span>${formatMenuServingValue(item.value)}</span></span>`)
        .join('');
      const homeOrOutIcon = row.isDineOut
        ? '' // 外食時はチップ自体で切替できるためミニアイコンは表示しない
        : `<button type=\"button\" class=\"mini ${row.prepExtra>0?'is-home':''}\" data-action=\"toggle-dine\" title=\"家と外食を切り替え\"><span class=\"lucide w-4 h-4\" data-lucide=\"home\"></span></button>`;
      const prepIcon = (!row.isDineOut)
        ? `<button type=\"button\" class=\"mini is-prep\" data-action=\"set-prep\" title=\"作り置きを設定\"><span class=\"lucide w-4 h-4\" data-lucide=\"user-plus\"></span></button>`
        : '';
      const chipsHtml = row.isDineOut
        ? `
            ${row.shopName || row.shopUrl ? `<span class=\"wm2-chip kind\">${row.shopUrl ? `<a href=\"${row.shopUrl}\" target=\"_blank\" rel=\"noopener\" class=\"hover:underline\">${row.shopName || row.shopUrl}</a>` : `${row.shopName}`}</span>` : ''}
            <button type=\"button\" class=\"wm2-chip kind\" data-action=\"toggle-dine\" title=\"家に切り替え\"><span class=\"lucide w-4 h-4\" data-lucide=\"utensils\"></span><span>外食</span></button>
            <span class=\"wm2-mini-icons\"><button type=\"button\" class=\"mini is-edit\" data-action=\"edit-dine\" title=\"外食情報を編集\"><span class=\"lucide w-4 h-4\" data-lucide=\"edit-3\"></span></button></span>
          ` : `
            ${timeLabel? `<span class=\"wm2-chip time\"><span>調理時間</span><span>${timeLabel}</span></span>`: ''}
            ${svChipsHtml}
            ${row.junle? `<span class=\"wm2-chip kind\"><span>ジャンル</span><span>${row.junle}</span></span>`: ''}
            ${cookChip}
            ${cookChip ? `<span class=\"wm2-mini-icons\">${homeOrOutIcon}${prepIcon}</span>` : `<span class=\"wm2-mini-icons\">${homeOrOutIcon}${prepIcon}</span>`}
          `;
      const showMealBadge = row.mealType === 'breakfast' || row.mealType === 'lunch';
      const mealBadgeClass = row.mealType === 'breakfast'
        ? 'bg-amber-50 text-amber-700 border border-amber-200'
        : 'bg-blue-50 text-blue-700 border border-blue-200';
      const isSetMenu = row.menuType === 'set';
      const setImages = isSetMenu
        ? (row.setMenus || []).map((m) => m && m.imageUrl).filter(Boolean)
        : [];
      const imageHtml = isSetMenu
        ? (setImages.length ? buildSetMenuGrid(setImages, row.name) : '<div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>')
        : (row.imageUrl ? (row.url? `<a href=\"${row.url}\" target=\"menuWindow\" rel=\"noopener\"><img src=\"${row.imageUrl}\" alt=\"${row.name}\"></a>`: `<img src=\"${row.imageUrl}\" alt=\"${row.name}\">`) : '');
      const arrangeTagHtml = [
        row.menuType === 'set'
          ? '<span class="wm2-arrange-tag"><span class="lucide w-3 h-3" data-lucide="layers"></span><span>セットメニュー</span></span>'
          : '',
        row.menuType === 'arrange'
          ? '<span class="wm2-arrange-tag"><span class="lucide w-3 h-3" data-lucide="wand-sparkles"></span><span>アレンジ</span></span>'
          : '',
        row.isArrangeBase
          ? '<span class="wm2-arrange-tag"><span class="lucide w-3 h-3" data-lucide="wand-sparkles"></span><span>アレンジ元</span></span>'
          : ''
      ].join('');
      const nameHtml = isSetMenu
        ? `<button type="button" class="hover:underline text-left" data-action="open-set-menu" data-menu-id="${row.menuId}">${row.name}${arrangeTagHtml}</button>`
        : (row.url
          ? `<a href=\"${row.url}\" target=\"menuWindow\" rel=\"noopener\" class=\"hover:underline\">${row.name}${arrangeTagHtml}</a>`
          : `<span>${row.name}${arrangeTagHtml}</span>`);
      wrap.innerHTML = `
        <div class=\"img\" data-element=\"dish-image\">
          ${showMealBadge ? `<span class=\"absolute left-2 top-2 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold ${mealBadgeClass}\">${row.mealLabel || ''}</span>` : ''}
          ${imageHtml}
          <div class=\"fav-overlay\">
            <button type=\"button\" class=\"${ICON_BTN}\" data-action=\"toggle-favorite\" aria-pressed=\"false\" title=\"お気に入り\"><span class=\"sr-only\">お気に入りに追加</span><span class=\"lucide w-4 h-4\" data-lucide=\"heart\"></span></button>
          </div>
        </div>
        <div class=\"p-3 space-y-2\">
          <div class=\"wm2-title\" data-element=\"dish-name\">${nameHtml}</div>
          <div class=\"wm2-badges\" data-element=\"dish-chips\">${chipsHtml}</div>
          <p class=\"text-xs text-gray-500 hidden\" data-element=\"dish-detail\"></p>
        </div>`;
      // Mark fav overlay active when favorited later by caller
      return wrap;
    }

    const createServingControl = (dayIndex, mealType, slotIndex, slot) => {
      const label = document.createElement('label');
      label.className = 'inline-flex items-center gap-1 rounded-full border border-violet-200 bg-violet-50 px-2 py-1 text-[11px] font-semibold text-violet-800';
      const text = document.createElement('span');
      text.textContent = '数量';
      ['click', 'pointerdown', 'mousedown'].forEach((eventName) => {
        label.addEventListener(eventName, (event) => event.stopPropagation());
      });
      const input = document.createElement('input');
      input.type = 'number';
      input.min = '0.1';
      input.max = '99';
      input.step = '0.1';
      input.value = String(normalizeServingMultiplier(slot?.servingMultiplier));
      input.setAttribute('aria-label', 'メニューの数量');
      input.className = 'w-14 rounded border border-violet-200 bg-white px-1.5 py-0.5 text-right text-xs text-gray-900';
      ['click', 'pointerdown', 'mousedown'].forEach((eventName) => {
        input.addEventListener(eventName, (event) => event.stopPropagation());
      });
      input.addEventListener('keydown', (event) => event.stopPropagation());
      input.addEventListener('change', () => {
        const value = normalizeServingMultiplier(input.value);
        input.value = String(value);
        const api = window.weekMenuAPI || {};
        if (!api.setServingMultiplier || !api.setServingMultiplier(dayIndex, mealType, slotIndex, value)) {
          input.value = String(normalizeServingMultiplier(slot?.servingMultiplier));
        }
      });
      label.append(text, input);
      return label;
    };

    function renderDay(){
      const leftTitle = document.getElementById('wm2-left-title');
      const rightTitle = document.getElementById('wm2-right-title');
      const d = WEEK[sel] || null; const f = d ? toLabel(d) : { disp: '--/--', dow: '' };
      const label = `${f.disp}${f.dow ? '（'+f.dow+'）' : ''}`;
      if (leftTitle) leftTitle.textContent = label + ' のレシピ';
      if (rightTitle) rightTitle.textContent = label + ' の食材 / 調味料';

      const plan = getPlanData();
      const day = plan[sel] || {};
      syncDayCommentView(sel);
      const breakfastWrap = document.getElementById('wm2-day-breakfast'); if (breakfastWrap){ breakfastWrap.innerHTML=''; }
      const lunchWrap = document.getElementById('wm2-day-lunch'); if (lunchWrap){ lunchWrap.innerHTML=''; }
      const dinnerWrap = document.getElementById('wm2-day-dinner'); if (dinnerWrap){ dinnerWrap.innerHTML=''; }
      const breakfastBox = document.getElementById('wm2-box-breakfast'); if (breakfastBox){ breakfastBox.dataset.day = String(sel); breakfastBox.dataset.meal = 'breakfast'; }
      const lunchBox = document.getElementById('wm2-box-lunch'); if (lunchBox){ lunchBox.dataset.day = String(sel); lunchBox.dataset.meal = 'lunch'; }
      const dinnerBox = document.getElementById('wm2-box-dinner'); if (dinnerBox){ dinnerBox.dataset.day = String(sel); dinnerBox.dataset.meal = 'dinner'; }

      // Ensure add buttons carry day/meal to satisfy weekMenu event delegation
      const addBreakfastBtn = document.getElementById('wm2-btn-add-breakfast');
      if (addBreakfastBtn){ addBreakfastBtn.dataset.day = String(sel); addBreakfastBtn.dataset.meal = 'breakfast'; addBreakfastBtn.dataset.mealType = 'breakfast'; }
      const addLunchBtn = document.getElementById('wm2-btn-add-lunch');
      if (addLunchBtn){ addLunchBtn.dataset.day = String(sel); addLunchBtn.dataset.meal = 'lunch'; addLunchBtn.dataset.mealType = 'lunch'; }
      const addDinnerBtn = document.getElementById('wm2-btn-add-dinner');
      if (addDinnerBtn){ addDinnerBtn.dataset.day = String(sel); addDinnerBtn.dataset.meal = 'dinner'; addDinnerBtn.dataset.category = 'dinnerFlexible'; }

      // Render attendees for selected day
      renderAttendees(sel);

      const renderSimpleSlots = (slots, wrapEl, mealType, defaultCategory = 'lunchMain') => {
        if (!wrapEl) return;
        wrapEl.innerHTML = '';
        (slots || []).forEach((slot, idx) => {
          const row = rowFromSlot(slot); if (!row.hasMenu) return;
          const item = document.createElement('div');
          item.className = 'wm2-draggable';
          item.draggable = true;
          item.setAttribute('data-slot-index', String(idx));
          item.setAttribute('data-category', slot?.categoryKey || defaultCategory);
          item.dataset.meal = mealType;
          item.dataset.mealType = mealType;
          item.dataset.dragDay = String(sel);
          item.dataset.dragMeal = mealType;
          item.dataset.dragIndex = String(idx);
          const actions = document.createElement('div'); actions.className='wm2-actions';
          const mySet = new Set((window.weekMenuData && window.weekMenuData.myMenuIds) || []);
          const favActive = !!(slot?.menuId && mySet.has(String(slot.menuId))) || !!slot?.favorite;
          actions.innerHTML = `
            <button type=\"button\" class=\"${ICON_BTN}\" data-action=\"shuffle\" title=\"再提案\"><span class=\"sr-only\">再提案</span><span class=\"lucide w-4 h-4\" data-lucide=\"refresh-ccw\"></span></button>
            <button type=\"button\" class=\"${ICON_BTN}\" data-action=\"change\" title=\"探す\"><span class=\"sr-only\">探す</span><span class=\"lucide w-4 h-4\" data-lucide=\"search\"></span></button>
            <button type=\"button\" class=\"${ICON_BTN} text-red-700 border-red-500 bg-red-50 hover:border-red-600 hover:text-red-800 hover:bg-red-100 focus:ring-red-200\" data-action=\"clear-slot\" title=\"メニューを未選択にする\"><span class=\"sr-only\">メニューを未選択にする</span><span class=\"lucide w-4 h-4\" data-lucide=\"x-circle\"></span></button>`;
          actions.prepend(createServingControl(sel, mealType, idx, slot));
          const card = cardEl(row);
          // Add DO overlay button at image bottom-right on past/today
          try {
            const dayISO = (WEEK[sel] && (WEEK[sel].dateISO || WEEK[sel])) || '';
            const todayISO = (window.weekMenuData && window.weekMenuData.todayISO) || new Date().toISOString();
            const canRecord = dayISO && (new Date(dayISO).setHours(0,0,0,0) <= new Date(todayISO).setHours(0,0,0,0));
