      if (!ws || Number.isNaN(ws.getTime()) || Number.isNaN(t.getTime())) return false;
      const todayWeekStart = new Date(t);
      const offset = (todayWeekStart.getDay() + 6) % 7; // Monday -> 0
      todayWeekStart.setHours(0, 0, 0, 0);
      todayWeekStart.setDate(todayWeekStart.getDate() - offset);
      return ws.getTime() > todayWeekStart.getTime();
