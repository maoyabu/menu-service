    const getGuidelineForCurrentUser = () => {
      const entry = guidelineByUser && currentUserId ? guidelineByUser[String(currentUserId)] : null;
      return entry && Object.keys(entry).length ? entry : (guidelineTotals || {});
    };
    function buildGuidelineTotalsForIds(ids) {
      const baseIds = Array.isArray(ids) && ids.length ? ids.map(String) : defaultIds();
      const sums = {};
      ING_CLASS_ORDER.forEach((cls) => { sums[cls] = 0; });
      let count = 0;
      baseIds.forEach((id) => {
        const entry = guidelineByUser && guidelineByUser[id];
        if (!entry) return;
        count += 1;
        ING_CLASS_ORDER.forEach((cls) => {
          const val = Number(entry[cls]) || 0;
          sums[cls] += val;
        });
      });
      if (!count) return guidelineTotals || {};
      const averages = {};
      ING_CLASS_ORDER.forEach((cls) => {
        averages[cls] = sums[cls] / count;
      });
      return averages;
    }
    const getIds = (dayIndex, meal) => {
