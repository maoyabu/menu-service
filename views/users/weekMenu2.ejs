                    ${type==='ingredient'?'食材':'調味料'}
                  </span>
                </div>
                <div class="grid grid-cols-3 gap-2 border rounded bg-blue-50 p-3">
                  <div>
                    <label class="text-xs text-gray-500" for="wm2-stock-amount">数量</label>
                    <input id="wm2-stock-amount" name="amount" data-x="amount" type="number" step="0.1" min="0" class="w-full border rounded px-2 py-1" placeholder="例: 1">
                  </div>
                  <div>
                    <label class="text-xs text-gray-500" for="wm2-stock-unit">単位</label>
                    <input id="wm2-stock-unit" name="unit" data-x="unit" class="w-full border rounded px-2 py-1" placeholder="例: 個 / g / ml">
                  </div>
                  <div>
                    <label class="text-xs text-gray-500" for="wm2-stock-place">保管場所</label>
                    <select id="wm2-stock-place" name="place" data-x="place" class="w-full border rounded px-2 py-1"><option value="">選択してください</option></select>
                    <button type="button" data-x="placeAdd" class="ml-2 text-xs text-emerald-700 underline">新規追加</button>
                  </div>
                  <div class="col-span-3 md:col-span-2 space-y-1">
                    <label class="text-xs text-gray-500" for="wm2-stock-product-url">商品URL（任意）</label>
                    <div class="flex flex-col gap-3 md:flex-row md:items-start">
                      <div class="flex-1 min-w-0 space-y-1">
                        <input id="wm2-stock-product-url" name="productUrl" data-x="productUrl" type="url" class="w-full border rounded px-2 py-1" placeholder="例: https://www.amazon.co.jp/...">
                        <div class="text-[11px] text-gray-500" data-role="image-url">
                          画像URL：
                          <span data-role="image-url-text" class="break-all">未取得</span>
                        </div>
                      </div>
                      <div class="w-full md:w-28">
                        <div class="border border-dashed border-gray-300 rounded bg-white h-28 flex items-center justify-center overflow-hidden">
                          <img data-role="image-preview" class="max-w-full max-h-full object-contain hidden" alt="商品画像">
                          <span data-role="image-placeholder" class="text-[11px] text-gray-400">プレビュー</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="col-span-3 flex flex-wrap items-center gap-3">
                    <label class="inline-flex items-center gap-2 text-xs text-gray-700">
                      <input type="checkbox" id="wm2-stock-stockpile" name="stockpile" data-x="stockpile" class="rounded">
                      備蓄
                    </label>
                    <div class="flex-1 min-w-0">
                      <label class="text-xs text-gray-500" for="wm2-stock-comment">コメント</label>
                      <input id="wm2-stock-comment" name="comment" data-x="comment" class="w-full border rounded px-2 py-1" placeholder="メモなど">
                    </div>
                  </div>
                  <div class="col-span-3">
                    <label class="text-xs text-gray-500" for="wm2-stock-exp">賞味期限</label>
                    <input id="wm2-stock-exp" name="exp" data-x="exp" type="date" class="w-full border rounded px-2 py-1">
                  </div>
                </div>
                <div class="flex items-center justify-end gap-2 pt-3">
                  <button type="button" data-close class="px-3 py-1.5 rounded border">キャンセル</button>
                  <button type="button" data-x="save" class="px-4 py-1.5 rounded bg-blue-600 text-white text-sm inline-flex items-center gap-1">
                    <span class="lucide w-4 h-4" data-lucide="package-plus"></span>
                    追加する
                  </button>
                </div>
              </div>
            </div>`;
          document.body.appendChild(modal);
          if (window.refreshLucideIcons) window.refreshLucideIcons();

          const close = () => { try { clearTimeout(imageFetchTimer); modal.remove(); } catch(_){} };
          modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });
          const productUrlInput = modal.querySelector('[data-x="productUrl"]');
          const imageUrlText = modal.querySelector('[data-role="image-url-text"]');
          const imagePreview = modal.querySelector('[data-role="image-preview"]');
          const imagePlaceholder = modal.querySelector('[data-role="image-placeholder"]');
          let cachedImageUrl = '';
          let imageFetchTimer = null;
          let imageFetchId = 0;
          const updateImagePreview = (url, fallback) => {
            cachedImageUrl = url || '';
            if (imageUrlText) imageUrlText.textContent = url ? url : (fallback || '未取得');
            if (imagePreview) {
              if (url) {
                imagePreview.src = url;
                imagePreview.classList.remove('hidden');
              } else {
                imagePreview.src = '';
                imagePreview.classList.add('hidden');
              }
            }
            if (imagePlaceholder) {
              imagePlaceholder.classList.toggle('hidden', !!url);
            }
          };
          const fetchImageFromUrl = async (value, runId) => {
            try {
              const res = await fetch('/users/my-stock/api/product-image?url=' + encodeURIComponent(value));
              if (!res.ok) throw new Error('fetch failed');
              const data = await res.json();
              if (runId !== imageFetchId) return;
              if (data && data.imageUrl) {
                updateImagePreview(data.imageUrl);
              } else {
                updateImagePreview('', '取得できませんでした');
              }
            } catch (_){
              if (runId !== imageFetchId) return;
              updateImagePreview('', '取得に失敗しました');
            }
          };
          const scheduleImageFetch = (inputValue) => {
            imageFetchId += 1;
            const runId = imageFetchId;
            clearTimeout(imageFetchTimer);
            if (!inputValue){
              updateImagePreview('', '未取得');
              return;
            }
            if (imageUrlText) imageUrlText.textContent = '読み込み中…';
            imageFetchTimer = setTimeout(()=> fetchImageFromUrl(inputValue, runId), 450);
          };
          if (productUrlInput){
            productUrlInput.addEventListener('input', ()=>{
              const value = String(productUrlInput.value || '').trim();
              scheduleImageFetch(value);
            });
          }
          updateImagePreview('', '未取得');

          // Load places
          (async()=>{ try{ const list= await (await fetch('/users/my-stock/api/places')).json(); const sel=modal.querySelector('[data-x="place"]'); sel.innerHTML='<option value="">選択してください</option>'; (list||[]).forEach(p=>{ const op=document.createElement('option'); op.value=p._id; op.textContent=p.name; sel.appendChild(op); }); }catch(_){ } })();
          modal.querySelector('[data-x="placeAdd"]').addEventListener('click', async ()=>{
            const pname = prompt('保管場所名'); if(!pname) return;
            try{
              const res = await fetch('/users/my-stock/api/places', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name: pname }) });
              if (res.ok){ const created = await res.json(); const sel=modal.querySelector('[data-x="place"]'); const op=document.createElement('option'); op.value=created._id; op.textContent=created.name; sel.appendChild(op); sel.value=created._id; }
            }catch(_){ alert('保管場所の追加に失敗しました'); }
          });

          modal.querySelector('[data-x="save"]').addEventListener('click', async ()=>{
            const payload = {
              type,
              id,
              amount: modal.querySelector('[data-x="amount"]').value,
              unit: modal.querySelector('[data-x="unit"]').value,
              placeId: modal.querySelector('[data-x="place"]').value || null,
              expiryDate: modal.querySelector('[data-x="exp"]').value || null,
              stockpile: !!modal.querySelector('[data-x="stockpile"]').checked,
              comment: (modal.querySelector('[data-x="comment"]').value||'').trim(),
              productUrl: (modal.querySelector('[data-x="productUrl"]').value||'').trim(),
              productImageUrl: cachedImageUrl || ''
            };
            try{
              const res = await fetch('/users/my-stock/api/stocks', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
              if (!res.ok) throw new Error('登録に失敗しました');
            }catch(e){ alert(e.message || '登録に失敗しました'); return; }

            // Update caches and UI
            if (type === 'ingredient') { ingNameSet.add(name); } else { seaNameSet.add(name); }
            li.dataset.fromStock = 'true';
            state[key] = true; try{ localStorage.setItem(KEY, JSON.stringify(state)); }catch(_){ }
            const cb = li.querySelector('input[type="checkbox"]'); if (cb && !cb.checked) cb.checked = true;
            const done = document.getElementById('wm2-sup-done'); if (done) done.appendChild(li);
            li.classList.add('checked');
            const stateTag = li.querySelector('[data-role="state"]');
            if (stateTag){
              stateTag.classList.remove('hidden');
              stateTag.classList.add('stock');
              stateTag.classList.remove('purchased');
              stateTag.innerHTML = '<span class="lucide w-3 h-3" data-lucide="package"></span><span class="ml-1">ストック</span>';
            }
            const inlineTag = li.querySelector('[data-role="state-inline"]'); if (inlineTag) inlineTag.innerHTML='';
            const addBtn = li.querySelector('[data-action="wm2-add-stock"]'); if (addBtn) addBtn.remove();
            if (window.refreshLucideIcons) window.refreshLucideIcons();
            close();
          });
        });
        window.__wm2_bindSuppliesChange = true;
      }
    };

    const toggleBtn = document.getElementById('wm2-toggle-supplies');
    const toggleLabel = toggleBtn ? toggleBtn.querySelector('[data-wm2-toggle-label]') : null;
    const box = document.getElementById('wm2-supplies');
    const preview = document.getElementById('wm2-preview');
    const main = document.getElementById('wm2-main');
    const section = document.getElementById('wm2-section');
    const setMode = (mode) => { // 'menu' | 'supplies'
      const showSupplies = mode === 'supplies';
      if (box) box.classList.toggle('hidden', !showSupplies);
      if (preview) preview.classList.toggle('hidden', showSupplies);
      if (main) main.classList.toggle('hidden', showSupplies);
      const weekView = document.getElementById('wm2-week-view');
      if (weekView) weekView.classList.toggle('hidden', showSupplies || currentViewMode !== 'week');
      if (toggleLabel) toggleLabel.textContent = showSupplies ? 'メニューの表示' : 'お買い物リスト';
      if (section) section.dataset.mode = showSupplies ? 'supplies' : 'menu';
      if (showSupplies) render();
      if (!showSupplies) updateViewModeUI();
    };
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const nowShowing = !box?.classList.contains('hidden');
        if (nowShowing) {
          const url = new URL(window.location.href);
          url.searchParams.delete('show');
          window.location.assign(url.toString());
          return;
        }
        setMode('supplies');
      });
    }
    const suppliesFilter = document.getElementById('wm2-supplies-filter');
    const suppliesFrom = document.getElementById('wm2-supplies-from');
    const suppliesTo = document.getElementById('wm2-supplies-to');
    if (suppliesFilter) {
      suppliesFilter.addEventListener('submit', (ev) => {
        ev.preventDefault();
        render();
      });
    }
    [suppliesFrom, suppliesTo].forEach((input) => {
      if (!input) return;
      input.addEventListener('change', () => {
        if (box && !box.classList.contains('hidden')) render();
      });
    });

    const regenBtn = document.getElementById('wm2-regenerate');
    if (regenBtn) {
      const regenDefaultHTML = regenBtn.innerHTML;
      let regenArmed = false;
      let regenArmTimer = null;
      const canRegenerateWeek = (() => {
        try {
          const data = window.weekMenuData || {};
          const weekStartISO = regenBtn.dataset.weekStart || data.weekStartISO || '';
          const todayISO = data.todayISO || new Date().toISOString();
          if (!weekStartISO) return false;
          const weekStart = new Date(weekStartISO);
          const today = new Date(todayISO);
          if (Number.isNaN(weekStart.getTime()) || Number.isNaN(today.getTime())) return false;
          const todayWeekStart = new Date(today);
          const dow = todayWeekStart.getDay(); // 0..6, Sun..Sat
          const offset = (dow + 6) % 7; // Monday -> 0
          todayWeekStart.setHours(0, 0, 0, 0);
          todayWeekStart.setDate(todayWeekStart.getDate() - offset);
          return weekStart.getTime() > todayWeekStart.getTime();
        } catch (_) {
          return false;
        }
      })();
      if (!canRegenerateWeek) {
        regenBtn.disabled = true;
        regenBtn.classList.add('opacity-50', 'cursor-not-allowed');
        regenBtn.title = '現在の週・過去の週は再提案できません';
      }
      regenBtn.addEventListener('click', async () => {
        if (regenBtn.disabled) return;
        if (!regenArmed) {
          regenArmed = true;
          if (regenArmTimer) clearTimeout(regenArmTimer);
          regenArmTimer = setTimeout(() => { regenArmed = false; }, 2000);
          return;
        }
        regenArmed = false;
        if (regenArmTimer) { clearTimeout(regenArmTimer); regenArmTimer = null; }
        const ok = window.confirm('1週間のメニューを再提案します。よろしいですか？');
        if (!ok) return;
        const groupId = regenBtn.dataset.groupId || (window.weekMenuData && window.weekMenuData.currentGroupId) || '';
        const weekStartISO = regenBtn.dataset.weekStart || (window.weekMenuData && window.weekMenuData.weekStartISO) || '';
        if (!groupId || !weekStartISO) {
          alert('再提案に必要な情報が不足しています。');
          return;
        }
        regenBtn.disabled = true;
        regenBtn.classList.add('opacity-70', 'cursor-not-allowed');
        regenBtn.innerHTML = '再提案中...';
        try {
          const res = await fetch('/users/week-menu/regenerate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ groupId, weekStart: weekStartISO })
          });
          if (!res.ok) {
            const json = await res.json().catch(() => null);
            throw new Error((json && json.error) ? json.error : 'failed');
          }
          window.location.reload();
        } catch (e) {
          alert((e && e.message && e.message !== 'failed')
            ? e.message
            : 'メニューの再提案に失敗しました。時間をおいて再度お試しください。');
          regenBtn.disabled = false;
          regenBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          regenBtn.innerHTML = regenDefaultHTML;
        }
      });
    }

    // Default to supplies mode when query param show=supplies
    try {
      const qp = new URLSearchParams(window.location.search || '');
      if (qp.get('show') === 'supplies') setMode('supplies');
    } catch (_) { /* noop */ }

    // Re-render when plan changes
    document.addEventListener('weekplan:rendered', ()=>{ if (box && !box.classList.contains('hidden')) render(); });
    document.addEventListener('click', (e)=>{
      const needsRefresh = e.target.closest('[data-menu-option]') || e.target.closest('[data-fav-action="submit"]') || e.target.closest('[data-action="toggle-dine"]') || e.target.closest('[data-action="clear-slot"]') || e.target.closest('[data-action="shuffle"]');
      if (needsRefresh && box && !box.classList.contains('hidden')) setTimeout(render, 50);
    });
  })();
</script>
