    function collectMealEntries(dayObj){
      const buckets = { breakfast: [], lunch: [], dinner: [] };
      const addSlot = (slot, bucketKey) => {
        if (!slot) return;
        const menu = slot?.menuId && lookup[slot.menuId] ? lookup[slot.menuId] : (slot?.menu || null);
        if (!menu || slot?.dineOut) return;
        buckets[bucketKey].push({
          menu,
          extra: Math.max(0, Number(slot?.prepExtra) || 0),
          servingMultiplier: normalizeServingMultiplier(slot?.servingMultiplier)
        });
      };
      if (Array.isArray(dayObj?.breakfastSlots)) {
        dayObj.breakfastSlots.forEach((slot) => addSlot(slot, 'breakfast'));
      }
      if (Array.isArray(dayObj?.lunchSlots)) {
        dayObj.lunchSlots.forEach((slot) => {
          const key = slot?.categoryKey === 'breakfastMain' ? 'breakfast' : 'lunch';
          addSlot(slot, key);
        });
      }
      let dinnerSlots = Array.isArray(dayObj?.dinnerSlots) ? dayObj.dinnerSlots : [];
      if (!dinnerSlots.length && dayObj && dayObj.dinner) {
        const base = ['staple','main','side','soup'].map((k)=> dayObj.dinner[k]).filter(Boolean);
        const extras = Array.isArray(dayObj.dinnerExtras) ? dayObj.dinnerExtras.filter(Boolean) : [];
        dinnerSlots = [...base, ...extras];
      }
      dinnerSlots.forEach((slot) => addSlot(slot, 'dinner'));
      return buckets;
    }

    function aggregateDayData(dayObj, dayIndex){
      const agg = { ingredients: new Map(), seasonings: new Map() };
      const classEntries = [];
      const seasoningClassEntries = [];
      const createServingTotals = () => SERVING_ITEMS.reduce((acc, item) => {
        acc[item.key] = 0;
        return acc;
      }, {});
      const servingTotals = createServingTotals();
      if (!dayObj) return { agg, classEntries, seasoningClassEntries, servingTotals };
      const buckets = collectMealEntries(dayObj);
      const counts = {
        breakfast: getIds(dayIndex, 'breakfast').length,
        lunch: getIds(dayIndex, 'lunch').length,
        dinner: getIds(dayIndex, 'dinner').length
      };
      const addAmount = (map, name, amount, unit) => {
        if (!name) return;
        const key = `${name}|${unit || ''}`;
        const prev = map.get(key) || 0;
        const val = parseFloat(amount);
        map.set(key, Number.isNaN(val) ? prev : prev + val);
      };
      const appendEntry = (collector, it, scaled, people, menuMeta = {}) => {
        collector.push({
          id: it?.id ? String(it.id) : '',
          name: it?.name || '',
          classification: it?.classification || '',
          unit: it?.unit || '',
          amount: scaled,
          people: Math.max(1, Number(people) || 1),
          menuId: menuMeta.menuId || '',
          menuName: menuMeta.menuName || '',
          planMenuName: menuMeta.planMenuName || '',
          mealType: menuMeta.mealType || '',
          dayIndex
        });
      };
      const addServingTotals = (menu, multiplier) => {
        const servings = menu?.servings || {};
        SERVING_ITEMS.forEach((item) => {
          const value = Number(servings[item.key]);
          if (!Number.isFinite(value) || value <= 0) return;
          servingTotals[item.key] += value * multiplier;
        });
      };
      const applyMenus = (entries, people, mealType) => {
        (entries || []).forEach((entry) => {
          const m = entry && entry.menu ? entry.menu : entry;
          if (!m) return;
          const extra = Math.max(0, Number(entry && entry.extra) || 0);
          const servingMultiplier = normalizeServingMultiplier(entry?.servingMultiplier);
          const menusToApply = (m.menuType === 'set' && Array.isArray(m.setMenus) && m.setMenus.length)
            ? [m, ...m.setMenus]
            : [m];
          menusToApply.forEach((targetMenu) => {
            if (!targetMenu) return;
            const menuMeta = {
              menuId: targetMenu.id || m.id || '',
              menuName: targetMenu.name || m.name || '',
              planMenuName: m.name || '',
              mealType
            };
            const basePeople = Number(targetMenu.people) > 0 ? Number(targetMenu.people) : 1;
            const peopleMultiplier = (people + extra) > 0 ? ((people + extra) / basePeople) : 1;
            const multiplier = peopleMultiplier * servingMultiplier;
            addServingTotals(targetMenu, servingMultiplier);
            (Array.isArray(targetMenu.ingredients) ? targetMenu.ingredients : []).forEach((it) => {
              const raw = Number(it?.amount);
              const scaled = raw * multiplier;
              addAmount(agg.ingredients, it?.name || '', scaled, it?.unit);
              if (!Number.isNaN(raw)) appendEntry(classEntries, it, scaled, people, menuMeta);
            });
            (Array.isArray(targetMenu.seasoning) ? targetMenu.seasoning : []).forEach((it) => {
              const raw = Number(it?.amount);
              if (Number.isNaN(raw)) return;
              const scaled = raw * multiplier;
              addAmount(agg.seasonings, it?.name || '', scaled, it?.unit);
              appendEntry(seasoningClassEntries, it, scaled, people, menuMeta);
            });
          });
        });
      };
      applyMenus(buckets.breakfast, counts.breakfast, 'breakfast');
      applyMenus(buckets.lunch, counts.lunch, 'lunch');
      applyMenus(buckets.dinner, counts.dinner, 'dinner');
      return { agg, classEntries, seasoningClassEntries, servingTotals, participants: counts };
    }

    function renderServingTotalsSummary(target, dayTotals = {}, weekTotals = {}, weekDayCount = 1){
      if (!target) return;
      target.innerHTML = '';
      const header = document.createElement('div');
      header.className = 'flex flex-wrap items-center justify-between gap-2';
      const titleWrap = document.createElement('div');
      titleWrap.className = 'flex flex-wrap items-center gap-2';
      const title = document.createElement('p');
      title.className = 'text-sm font-semibold text-gray-800';
      title.textContent = 'SV合計';
      titleWrap.append(title, createSvGuideButton());
      header.appendChild(titleWrap);
      const profileNote = document.createElement('p');
      profileNote.className = 'text-[11px] font-medium text-emerald-700';
      const profileParts = [];
      if (servingRequirementProfile.age !== null) profileParts.push(`${servingRequirementProfile.age}歳`);
      if (servingRequirementProfile.sexLabel) profileParts.push(servingRequirementProfile.sexLabel);
      profileNote.textContent = profileParts.length
        ? `SVの推奨値は${profileParts.join('、')}で判定`
        : 'SVの推奨値は基本形で判定';
      header.appendChild(profileNote);
      target.appendChild(header);
      const formatSv = (val) => {
        const num = Number(val) || 0;
        const rounded = Math.round(num * 10) / 10;
        return rounded % 1 ? rounded.toFixed(1) : String(rounded);
      };
      const formatRequiredSv = (item, multiplier = 1) => {
        const factor = Math.max(1, Number(multiplier) || 1);
        const min = (Number(item.requiredMin) || 0) * factor;
        const max = (Number(item.requiredMax) || 0) * factor;
        if (min === max) return formatSv(min);
        return `${formatSv(min)}〜${formatSv(max)}`;
      };
      const formatActualWithRequired = (actual, item, multiplier = 1) => {
        return `${formatSv(actual)} / ${formatRequiredSv(item, multiplier)}(SV)`;
      };
      const isSvOver = (actual, item, multiplier = 1) => {
        const factor = Math.max(1, Number(multiplier) || 1);
        const max = (Number(item.requiredMax) || 0) * factor;
        return max > 0 && (Number(actual) || 0) > max;
      };
      const table = document.createElement('table');
      table.className = 'mt-2 w-full text-[13px]';
      table.innerHTML = `
        <thead>
          <tr>
            <th class="text-left text-[11px] font-semibold text-gray-500"></th>
            <th class="w-32 text-right text-[11px] font-semibold text-gray-500">その日</th>
            <th class="w-32 text-right text-[11px] font-semibold text-gray-500">週累計</th>
          </tr>
        </thead>
      `;
      const tbody = document.createElement('tbody');
      servingRequirementItems.forEach((item) => {
        const dayVal = Number(dayTotals[item.key]) || 0;
        const weekVal = Number(weekTotals[item.key]) || 0;
        const dayClass = isSvOver(dayVal, item, 1) ? 'text-red-600' : 'text-blue-600';
        const weekClass = isSvOver(weekVal, item, weekDayCount) ? 'text-red-600' : 'text-emerald-700';
        const row = document.createElement('tr');
        row.className = 'text-gray-700';
        row.innerHTML = `
          <td class="py-1 font-medium">${item.label}</td>
          <td class="py-1 text-right text-sm font-semibold ${dayClass}">${formatActualWithRequired(dayVal, item, 1)}</td>
          <td class="py-1 text-right text-sm font-semibold ${weekClass}">${formatActualWithRequired(weekVal, item, weekDayCount)}</td>
        `;
        tbody.appendChild(row);
      });
      table.appendChild(tbody);
      target.appendChild(table);
    }

    function renderRequirementsForDay(day, mode = 'day', selectedIndex = sel){
      const reqEl = document.getElementById('wm2-req'); if (!reqEl) return;
      if (!enableRequirementsPanel) {
        reqEl.innerHTML = '';
        return;
      }
      requirementsRenderToken += 1;
      const renderToken = requirementsRenderToken;
      reqEl.innerHTML='';
      const plan = getPlanData();
      if (!day || !plan.length) {
        const empty = document.createElement('p');
        empty.className = 'text-xs text-gray-500';
        empty.textContent = 'この日のデータが見つかりません。';
        reqEl.appendChild(empty);
        return;
      }
      const indexNumber = Number(selectedIndex);
      const cappedIndex = Number.isFinite(indexNumber) ? indexNumber : 0;
      const safeIndex = Math.max(0, Math.min(cappedIndex, plan.length - 1));
      const dayAgg = aggregateDayData(day, safeIndex);
      const agg = dayAgg.agg;

      const formatQty1 = (val) => {
        if (typeof val !== 'number' || Number.isNaN(val)) return '';
        const n = Math.round(val * 10) / 10; return n % 1 ? n.toFixed(1) : String(n);
      };
      const labelData = getDateLabel(safeIndex);
      const spanDayCount = computeDaySpan(safeIndex);
      const classHeader = document.createElement('div');
      classHeader.className = 'flex items-center justify-between mb-2 gap-3 bg-white';
      const classTitle = document.createElement('p');
      classTitle.className = 'text-sm font-semibold text-gray-800';
      classTitle.textContent = requirementsMode === 'week'
        ? '食材分類別の合計 (週累計, g換算)'
        : '食材分類別の合計 (g換算)';
      classHeader.appendChild(classTitle);
      const toggleHost = document.createElement('div');
      toggleHost.dataset.role = 'req-mode-header';
      toggleHost.appendChild(createReqModeButtons());
      classHeader.appendChild(toggleHost);
      reqEl.appendChild(classHeader);
      const suggestRow = document.createElement('div');
      suggestRow.className = 'flex justify-end mb-1';
      const suggestBtn = document.createElement('button');
      suggestBtn.type = 'button';
      suggestBtn.className = 'px-3 py-1.5 text-xs font-semibold text-amber-800 bg-amber-100 border border-amber-200 rounded-full hover:bg-amber-200';
      suggestBtn.textContent = '不足分の提案';
      suggestRow.appendChild(suggestBtn);
      reqEl.appendChild(suggestRow);
      const classBox = document.createElement('div');
      classBox.className = 'mt-4 rounded-2xl border border-amber-100 bg-amber-50/60 p-3 text-xs';
      classBox.dataset.role = 'ingredient-class-summary';
      reqEl.appendChild(classBox);
      const servingBox = document.createElement('div');
      servingBox.className = 'mt-3 rounded-2xl border border-emerald-100 bg-emerald-50/70 p-3 text-xs';
      servingBox.dataset.role = 'serving-summary';
      reqEl.appendChild(servingBox);
      const suggestionBox = document.createElement('div');
      suggestionBox.className = 'mt-3 text-xs text-gray-700 space-y-1';
      suggestionBox.dataset.role = 'shortage-suggestions';
      reqEl.appendChild(suggestionBox);
      const indicesForClassification = mode === 'week'
        ? Array.from({ length: safeIndex + 1 }, (_, idx) => idx)
        : [safeIndex];
      const indicesForServingTotals = Array.from({ length: safeIndex + 1 }, (_, idx) => idx);
      const aggregateCache = new Map([[safeIndex, dayAgg]]);
      const getAggregateForIndex = (idx) => {
        if (aggregateCache.has(idx)) return aggregateCache.get(idx);
        const aggregated = aggregateDayData(plan[idx], idx);
        aggregateCache.set(idx, aggregated);
        return aggregated;
      };
      const combinedEntries = [];
      const combinedSeasoningEntries = [];
      const weekServingTotals = SERVING_ITEMS.reduce((acc, item) => {
        acc[item.key] = 0;
        return acc;
      }, {});
      let participantMax = 0;
      const participantIds = collectParticipantIds(indicesForClassification);
      indicesForClassification.forEach((idx) => {
        if (idx < 0 || idx >= plan.length) return;
        const target = getAggregateForIndex(idx);
        combinedEntries.push(...target.classEntries);
        combinedSeasoningEntries.push(...target.seasoningClassEntries);
        const p = target.participants || {};
        participantMax = Math.max(
          participantMax,
          Number(p.breakfast) || 0,
          Number(p.lunch) || 0,
          Number(p.dinner) || 0
        );
      });
      indicesForServingTotals.forEach((idx) => {
        if (idx < 0 || idx >= plan.length) return;
        const target = getAggregateForIndex(idx);
        SERVING_ITEMS.forEach((item) => {
          weekServingTotals[item.key] += Number(target.servingTotals?.[item.key]) || 0;
        });
      });
      renderClassSummary(classBox, combinedEntries, formatQty1, renderToken, {
        seasoningEntries: combinedSeasoningEntries,
        mode,
        dayCount: mode === 'week' ? spanDayCount : 1,
        targetLabel: labelData,
        participantCount: participantMax || defaultIds().length || 1,
        participantIds,
        selectedIndex: safeIndex,
        allowShortageMenuSelection: true,
        allowActualBreakdown: true
      });
      renderServingTotalsSummary(servingBox, dayAgg.servingTotals, weekServingTotals, spanDayCount);
      latestRequirementsSnapshot = {
        entries: combinedEntries,
        seasoningEntries: combinedSeasoningEntries,
        mode,
        dayCount: mode === 'week' ? spanDayCount : 1,
        targetLabel: labelData,
        participantCount: participantMax || defaultIds().length || 1,
        participantIds,
        selectedIndex: safeIndex
      };
      suggestBtn.addEventListener('click', () => {
        renderShortageSuggestions(suggestionBox, latestRequirementsSnapshot, suggestBtn);
      });
      const spacer = document.createElement('div');
      spacer.className = 'h-4 md:h-6';
      reqEl.appendChild(spacer);
      const sec = (title, map)=>{
        const box = document.createElement('div');
        const h = document.createElement('h4'); h.textContent = title; box.appendChild(h);
        const ul = document.createElement('ul');
        const qualitativeUnits = new Set(['少々', '適量', 'お好みで', 'ひとつまみ']);
        Array.from(map.entries()).forEach(([k,v])=>{
          const [name, unit] = k.split('|');
          const li = document.createElement('li');
          const valStr = (typeof v === 'number' && !Number.isNaN(v)) ? formatQty1(v) : '';
          const unitText = (unit || '').trim();
          const amountText = qualitativeUnits.has(unitText)
            ? unitText
            : `${valStr}${unitText}`;
          let tagHtml = '';
          if (title === '食材' && ingredientMetaCache.ready) {
            const cls = resolveIngredientClass('', name);
            if (cls) {
              tagHtml = `<span class="ml-2 inline-flex items-center rounded-full border border-amber-200 bg-amber-50 text-amber-700 text-[10px] px-2 py-0.5">${cls}</span>`;
            }
          }
          li.innerHTML = `<span>${name}${tagHtml}</span><span>${amountText}</span>`;
          ul.appendChild(li);
        });
        box.appendChild(ul);
        return box;
      };
      reqEl.appendChild(sec('食材', agg.ingredients));
      reqEl.appendChild(sec('調味料', agg.seasonings));
    }

