          const y = d.getFullYear();
          const m = d.getMonth()+1;
          const day = d.getDate();
          return withYear ? `${y}年${m}月${day}日` : `${m}月${day}日`;
        };
        const text = `${fmt(start, true)}から${fmt(end)}の食材・調味料リスト`;
        if (labelEl) labelEl.textContent = text;
      }catch(_){ if (labelEl) labelEl.textContent = 'この週の食材・調味料リスト'; }
    })();
    // pick default selected index = today within week, else 0
    const todayISO = (window.weekMenuData && window.weekMenuData.todayISO) || new Date().toISOString();
    const todayDateStr = new Date(todayISO).toDateString();
    let sel = Math.max(0, (WEEK || []).findIndex(d => {
      const iso = d?.dateISO || d; if (!iso) return false; try { return new Date(iso).toDateString() === todayDateStr; } catch(_) { return false; }
    }));

    function toLabel(d){
      const display = d && d.display ? d.display : '';
      const iso = d && d.dateISO ? d.dateISO : d;
      let dow = '';
      try { const dt = new Date(iso); dow = WEEKDAY[(dt.getDay()+6)%7] || ''; } catch(_) {}
      // If display already like MM/DD, use it; else format from iso
      const disp = display || (function(){ try { const dt=new Date(iso); const m=dt.getMonth()+1, day=dt.getDate(); return `${('0'+m).slice(-2)}/${('0'+day).slice(-2)}`; } catch(_) { return '--/--'; } })();
      return { disp, dow };
    }
    const formatLabelWithDow = (entry) => {
      const info = toLabel(entry);
      if (!info.disp) return '';
      return info.dow ? `${info.disp}（${info.dow}）` : info.disp;
    };
    const getDateLabel = (idx) => {
      const entry = WEEK[idx];
      if (!entry) return '';
      if (entry.display) {
        return entry.weekday
          ? `${entry.display}（${entry.weekday}）`
          : entry.display;
      }
      return formatLabelWithDow(entry);
    };
    const getDateFromWeek = (idx) => {
      const entry = WEEK[idx];
      if (!entry) return null;
      const iso = entry.dateISO || entry;
      try {
        return new Date(iso);
      } catch (_) {
        return null;
      }
    };
    const computeDaySpan = (idx) => {
      const startDate = getDateFromWeek(0);
      const targetDate = getDateFromWeek(idx);
      if (!startDate || !targetDate) return idx + 1;
      const ms = targetDate.setHours(0,0,0,0) - startDate.setHours(0,0,0,0);
      const days = Math.floor(ms / (24 * 60 * 60 * 1000));
      return Math.max(1, days + 1);
    };

    function buildPills(){
      const row = document.getElementById('wm2-days'); if (!row) return; row.innerHTML='';
      (WEEK||[]).forEach((d,idx)=>{
        const f=toLabel(d); const b=document.createElement('button'); b.type='button'; b.className='day-pill'; b.dataset.index=String(idx); b.dataset.active= String(idx===sel);
        b.innerHTML = `<div class="text-xs">${f.dow}</div><div class="day-date">${f.disp}</div>`;
        row.appendChild(b);
      });
      // event delegation for stability across rebuilds
      row.onclick = (ev)=>{
        const btn = ev.target.closest('.day-pill');
        if (!btn) return;
        const idx = Number(btn.dataset.index);
        if (!Number.isNaN(idx)) { sel = idx; rebuild(); }
      };
    }

    function rowFromSlot(slot){
      if (!slot) return { hasMenu:false };
      let m = null;
      if (slot.menuId && lookup[slot.menuId]) m = lookup[slot.menuId];
      if (!m && slot.menu) m = slot.menu; // fallback to embedded menu from weekMenu state
      if (!m) return { hasMenu:false };
      const isDineOut = !!slot.dineOut;
      const shopName = (slot.dineOutName || '').trim();
      const shopUrl = (slot.dineOutUrl || '').trim();
      const detail = m.cook || m.junle || m.kind || m.menu || '';
      let mealType = 'dinner';
      if (slot?.categoryKey === 'breakfastMain') {
        mealType = 'breakfast';
      } else if (slot?.categoryKey === 'lunchMain') {
        mealType = 'lunch';
      } else if (slot?.categoryKey && slot.categoryKey.startsWith('dinner')) {
        mealType = 'dinner';
      }
      // Always keep menu name and image; only chips area changes for dine-out
      return {
        hasMenu:true,
        isDineOut,
        name: m.name,
        imageUrl: m.imageUrl || '',
        url: m.url || '',
        time: (m.time ?? '') + '',
        cook: m.cook || '',
        junle: m.junle || '',
        prepExtra: Math.max(0, Number(slot?.prepExtra) || 0),
        shopName,
        shopUrl,
        detail,
        mealType,
        mealLabel: mealType === 'breakfast' ? '朝食' : (mealType === 'lunch' ? 'ランチ' : 'ディナー')
      };
    }

