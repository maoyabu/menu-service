      if (m >= 3 && m <= 5) return '春';
      if (m >= 6 && m <= 9) return '夏';
      if (m >= 10 && m <= 11) return '秋';
      return '冬';
    };
    const isIngredientSeasonalMeta = (meta) => {
      if (!meta) return false;
      const now = new Date();
      const monthLabel = `${now.getMonth() + 1}月`;
      if (Array.isArray(meta.months) && meta.months.includes(monthLabel)) return true;
      const currentSeason = monthToSeason(now.getMonth() + 1);
      return Array.isArray(meta.seasons) && meta.seasons.includes(currentSeason);
    };
    const menuHasSeasonal = (menu) => {
      const list = Array.isArray(menu?.ingredients) ? menu.ingredients : [];
      return list.some((it) => {
        const id = (it && (it.id || it._id || it.name?._id || it.name)) ? String(it.id || it._id || it.name?._id || it.name) : '';
        const name = it?.ingredient || it?.name?.ingredient || it?.name?.name || it?.name || '';
        const meta = getIngredientMeta(id, name);
        return isIngredientSeasonalMeta(meta);
      });
    };
    const calcMenuClassTotals = (menu, participantCount = 1) => {
      const totals = new Map();
      if (!menu) return { totals, seasonal: false };
      const basePeople = Number(menu.people) > 0 ? Number(menu.people) : 1;
      const multiplier = participantCount > 0 ? (participantCount / basePeople) : 1;
      const ingredients = Array.isArray(menu.ingredients) ? menu.ingredients : [];
      ingredients.forEach((it) => {
        const raw = Number(it?.amount);
        if (!Number.isFinite(raw)) return;
        const scaled = raw * multiplier;
        const id = (it && (it.id || it._id || it.name?._id || it.name)) ? String(it.id || it._id || it.name?._id || it.name) : '';
        const name = it?.ingredient || it?.name?.ingredient || it?.name?.name || it?.name || '';
        const grams = convertEntryToGrams({ id, name, amount: scaled, unit: it?.unit });
        if (!grams || !Number.isFinite(grams)) return;
        const cls = resolveIngredientClass(id, name);
        totals.set(cls, (totals.get(cls) || 0) + grams);
      });
      // capture seasoning grams for classes we count
      const seasonings = Array.isArray(menu.seasoning) ? menu.seasoning : [];
      seasonings.forEach((it) => {
        const raw = Number(it?.amount);
        if (!Number.isFinite(raw)) return;
        const scaled = raw * multiplier;
        const id = (it && (it.id || it._id || it.name?._id || it.name)) ? String(it.id || it._id || it.name?._id || it.name) : '';
        const name = it?.seasoning || it?.name?.seasoning || it?.name?.name || it?.name || '';
        const cls = resolveSeasoningClass(id, name);
        if (!SEASONING_CAPTURE_CLASSES.has(cls)) return;
        const grams = convertSeasoningEntryToGrams({ id, name, amount: scaled, unit: it?.unit });
        if (!grams || !Number.isFinite(grams)) return;
        totals.set(cls, (totals.get(cls) || 0) + grams);
