    const closeSetMenuModal = () => {
      const modal = setModalEl();
      if (modal) modal.classList.remove('is-open');
    };
    const renderSetMenuModal = (menu) => {
      const modal = setModalEl();
      const body = setModalBodyEl();
      const titleEl = setModalTitleEl();
      if (!modal || !body || !titleEl) return;
      titleEl.textContent = menu?.name ? `${menu.name} のメニュー` : 'セットメニュー';
      body.innerHTML = '';
      const menus = Array.isArray(menu?.setMenus) ? menu.setMenus : [];
      const classSection = document.createElement('div');
      const classTitle = document.createElement('div');
      classTitle.className = 'text-sm font-semibold text-gray-800';
      classTitle.textContent = '食材分類別の合計 (g換算)';
      classSection.appendChild(classTitle);
      const classBox = document.createElement('div');
      classBox.className = 'mt-2 rounded-2xl border border-amber-100 bg-amber-50/60 p-3 text-xs';
      classSection.appendChild(classBox);
      body.appendChild(classSection);

      const classEntries = [];
      const seasoningClassEntries = [];
      const appendEntry = (collector, it, people) => {
        collector.push({
          id: it?.id ? String(it.id) : '',
          name: it?.name || '',
          classification: it?.classification || '',
          unit: it?.unit || '',
          amount: (typeof it?.amount === 'number' && !Number.isNaN(it.amount)) ? it.amount : null,
          people: Math.max(1, Number(people) || 1)
        });
      };
      const addMenuEntries = (targetMenu) => {
        if (!targetMenu) return;
        const people = Math.max(1, Number(targetMenu.people) || 1);
        (Array.isArray(targetMenu.ingredients) ? targetMenu.ingredients : []).forEach((it) => appendEntry(classEntries, it, people));
        (Array.isArray(targetMenu.seasoning) ? targetMenu.seasoning : []).forEach((it) => appendEntry(seasoningClassEntries, it, people));
      };
      addMenuEntries(menu);
      menus.forEach(addMenuEntries);

      const formatQty1 = (val) => {
        if (typeof val !== 'number' || Number.isNaN(val)) return '';
        const n = Math.round(val * 10) / 10;
        return n % 1 ? n.toFixed(1) : String(n);
      };
      requirementsRenderToken += 1;
      const renderToken = requirementsRenderToken;
      renderClassSummary(classBox, classEntries, formatQty1, renderToken, {
        seasoningEntries: seasoningClassEntries,
        mode: 'day',
        dayCount: 1,
        targetLabel: '',
        participantCount: 1,
        participantIds: []
      });

      if (!menus.length) {
        const empty = document.createElement('div');
        empty.className = 'text-sm text-gray-500';
        empty.textContent = '登録されたメニューがありません。';
        body.appendChild(empty);
        modal.classList.add('is-open');
        return;
      }
      menus.forEach((m) => {
        const item = document.createElement('div');
        item.className = 'wm2-set-item';

        const head = document.createElement('div');
        head.className = 'wm2-set-item-head';

        const thumb = document.createElement('div');
        thumb.className = 'wm2-set-thumb';
        if (m?.imageUrl) {
          const img = document.createElement('img');
          img.src = m.imageUrl;
          img.alt = m.name || 'menu image';
          thumb.appendChild(img);
        } else {
          thumb.textContent = 'no image';
        }

        const meta = document.createElement('div');
        meta.className = 'wm2-set-meta';
        const title = document.createElement('div');
        title.className = 'wm2-set-title';
        title.textContent = m?.name || '名称未設定';
        meta.appendChild(title);

        const metaRow = document.createElement('div');
        metaRow.className = 'wm2-set-tags';
        if (m?.time) metaRow.appendChild(buildTag(`時間 ${String(m.time).endsWith('分') ? m.time : m.time + '分'}`, ''));
        if (m?.people) metaRow.appendChild(buildTag(`人数 ${m.people}人`, ''));
        if (m?.junle) metaRow.appendChild(buildTag(`ジャンル ${m.junle}`, ''));
        if (m?.cook) metaRow.appendChild(buildTag(`調理方法 ${m.cook}`, ''));
        meta.appendChild(metaRow);

        head.appendChild(thumb);
        head.appendChild(meta);

        if (m?.url) {
          const link = document.createElement('a');
          link.className = 'wm2-set-link';
          link.href = m.url;
          link.target = 'menuWindow';
          link.rel = 'noopener';
          link.textContent = 'レシピサイト';
          head.appendChild(link);
        }

        item.appendChild(head);

        const ingBlock = document.createElement('div');
        const ingLabel = document.createElement('div');
        ingLabel.className = 'text-xs font-semibold text-emerald-700 mb-1';
        ingLabel.textContent = '食材';
        ingBlock.appendChild(ingLabel);
        const ingTags = document.createElement('div');
        ingTags.className = 'wm2-set-tags';
        (Array.isArray(m?.ingredients) ? m.ingredients : []).forEach((it) => {
          const label = `${it?.name || ''}${formatAmountLabel(it) ? ' ' + formatAmountLabel(it) : ''}`.trim();
          if (label) ingTags.appendChild(buildTag(label, 'ing'));
        });
        if (!ingTags.children.length) {
          ingTags.appendChild(buildTag('登録なし', ''));
        }
        ingBlock.appendChild(ingTags);
        item.appendChild(ingBlock);

        const seaBlock = document.createElement('div');
        const seaLabel = document.createElement('div');
        seaLabel.className = 'text-xs font-semibold text-amber-700 mb-1';
        seaLabel.textContent = '調味料';
        seaBlock.appendChild(seaLabel);
        const seaTags = document.createElement('div');
        seaTags.className = 'wm2-set-tags';
        (Array.isArray(m?.seasoning) ? m.seasoning : []).forEach((it) => {
          const label = `${it?.name || ''}${formatAmountLabel(it) ? ' ' + formatAmountLabel(it) : ''}`.trim();
          if (label) seaTags.appendChild(buildTag(label, 'sea'));
        });
        if (!seaTags.children.length) {
          seaTags.appendChild(buildTag('登録なし', ''));
        }
        seaBlock.appendChild(seaTags);
        item.appendChild(seaBlock);

        body.appendChild(item);
      });
      modal.classList.add('is-open');
    };

    const openSetMenuModalById = (menuId) => {
      if (!menuId) return;
      const menu = lookup && lookup[menuId] ? lookup[menuId] : null;
      if (!menu || menu.menuType !== 'set') return;
      renderSetMenuModal(menu);
    };

    const closeActualBreakdownModal = () => {
      const modal = document.getElementById('wm2-actual-breakdown-modal');
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
    };
    const openActualBreakdownModal = (classification, entries, seasoningEntries, options = {}) => {
      const modal = document.getElementById('wm2-actual-breakdown-modal');
      const title = document.getElementById('wm2-actual-breakdown-title');
      const description = document.getElementById('wm2-actual-breakdown-description');
      const body = document.getElementById('wm2-actual-breakdown-body');
      if (!modal || !title || !description || !body) return;

      const rows = new Map();
      const addEntry = (entry, type) => {
        const cls = type === 'seasoning'
          ? resolveSeasoningClass(entry?.id, entry?.name, entry?.classification || '')
          : resolveIngredientClass(entry?.id, entry?.name, entry?.classification || '');
        if (cls !== classification) return;
        const grams = type === 'seasoning'
          ? convertSeasoningEntryToGrams(entry)
          : convertEntryToGrams(entry);
        if (typeof grams !== 'number' || Number.isNaN(grams)) return;
        const perPerson = grams / Math.max(1, Number(entry?.people) || 1);
        const dayIndex = Number.isInteger(Number(entry?.dayIndex)) ? Number(entry.dayIndex) : -1;
        const mealType = entry?.mealType || '';
        const menuName = entry?.menuName || 'メニュー名未設定';
        const planMenuName = entry?.planMenuName || '';
        const key = `${dayIndex}:${mealType}:${planMenuName}:${menuName}`;
        const current = rows.get(key) || { dayIndex, mealType, menuName, planMenuName, grams: 0 };
        current.grams += perPerson;
        rows.set(key, current);
      };
      (entries || []).forEach((entry) => addEntry(entry, 'ingredient'));
      (seasoningEntries || []).forEach((entry) => addEntry(entry, 'seasoning'));
      const breakdown = Array.from(rows.values()).sort((a, b) => dayDisplayRank(a.dayIndex) - dayDisplayRank(b.dayIndex) || b.grams - a.grams);
      const total = breakdown.reduce((sum, row) => sum + row.grams, 0);

      title.textContent = `${classification}の実績内訳`;
      description.textContent = `${options.targetLabel || '表示中の期間'} / 1人あたり合計 ${Math.round(total)}g`;
      body.innerHTML = '';
      if (!breakdown.length) {
        body.innerHTML = '<p class="py-8 text-center text-sm text-gray-500">内訳を表示できるメニューがありません。</p>';
      } else {
        const list = document.createElement('div');
        list.className = 'divide-y divide-gray-100 rounded-xl border border-gray-200 bg-white';
        const mealLabels = { breakfast: '朝食', lunch: 'ランチ', dinner: '夕食' };
        breakdown.forEach((row) => {
          const item = document.createElement('div');
          item.className = 'flex items-center justify-between gap-4 px-4 py-3';
          const info = document.createElement('div');
          const menuName = document.createElement('p');
          menuName.className = 'text-sm font-semibold text-gray-900';
          menuName.textContent = row.planMenuName && row.planMenuName !== row.menuName
            ? `${row.planMenuName}（${row.menuName}）`
            : row.menuName;
          const context = document.createElement('p');
          context.className = 'mt-1 text-xs text-gray-500';
          const dayLabel = row.dayIndex >= 0 ? getDateLabel(row.dayIndex) : '';
          context.textContent = [dayLabel, mealLabels[row.mealType] || ''].filter(Boolean).join(' / ');
          info.append(menuName, context);
          const grams = document.createElement('span');
          grams.className = 'whitespace-nowrap text-sm font-bold text-blue-700';
          grams.textContent = `${Math.round(row.grams * 10) / 10}g`;
          item.append(info, grams);
          list.appendChild(item);
        });
        body.appendChild(list);
      }
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
    };
    document.querySelectorAll('#wm2-actual-breakdown-modal [data-actual-breakdown-close]').forEach((button) => {
      button.addEventListener('click', closeActualBreakdownModal);
    });

    function renderClassSummary(target, entries, formatQty, token, options = {}){
      if (!target) return;
      target.innerHTML = '';
      const seasoningEntries = Array.isArray(options.seasoningEntries) ? options.seasoningEntries : [];
      const needsSeasoningMeta = seasoningEntries.length > 0;
      if ((!entries || !entries.length) && !needsSeasoningMeta) {
        const empty = document.createElement('p');
        empty.className = 'text-xs text-gray-500';
        empty.textContent = '分類できる食材がありません。';
        target.appendChild(empty);
        return;
      }

      if (!ingredientMetaCache.ready || (needsSeasoningMeta && !seasoningMetaCache.ready)) {
        const note = document.createElement('p');
        note.className = 'text-xs text-gray-500';
        note.textContent = (ingredientMetaCache.error || seasoningMetaCache.error)
          ? '分類データの取得に失敗しました。再試行しています…'
          : '分類データを取得しています...';
        target.appendChild(note);
        Promise.all([
          ingredientMetaCache.ready ? Promise.resolve(true) : ensureIngredientMeta(),
          (!needsSeasoningMeta || seasoningMetaCache.ready) ? Promise.resolve(true) : ensureSeasoningMeta()
        ]).then(([ingOk, seaOk]) => {
          if (!ingOk || (!seaOk && needsSeasoningMeta)) {
            if (note.isConnected) note.textContent = '分類データの取得に失敗しました。時間をおいて再試行してください。';
            return;
          }
          if (token !== requirementsRenderToken) return;
          renderClassSummary(target, entries, formatQty, token, options);
        });
        return;
      }

      const totals = new Map();
      entries.forEach(({ id, name, amount, unit, people, classification }) => {
        const grams = convertEntryToGrams({ id, name, amount, unit });
        if (typeof grams !== 'number' || Number.isNaN(grams)) return;
        const cls = resolveIngredientClass(id, name, classification || '');
        const perPerson = grams / Math.max(1, Number(people) || 1);
        totals.set(cls, (totals.get(cls) || 0) + perPerson);
      });

      if (needsSeasoningMeta) {
        seasoningEntries.forEach(({ id, name, amount, unit, people, classification }) => {
          const cls = resolveSeasoningClass(id, name, classification || '');
          if (!SEASONING_CAPTURE_CLASSES.has(cls)) return;
          const grams = convertSeasoningEntryToGrams({ id, name, amount, unit });
          if (typeof grams !== 'number' || Number.isNaN(grams)) return;
          const perPerson = grams / Math.max(1, Number(people) || 1);
          totals.set(cls, (totals.get(cls) || 0) + perPerson);
        });
      }

      const metricsColClass = 'text-right w-24';
      const table = document.createElement('table');
      table.className = 'w-full mt-2 text-[13px]';
      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      const userName = getCurrentUserName();
      const requiredHeader = options.mode === 'week'
        ? `${userName ? `${userName}さん` : 'ログインユーザー'}の${options.targetLabel || ''}\nまでの必要量`
        : `${userName ? `${userName}さん` : 'ログインユーザー'}の\n1日の必要量`;
      const actualHeader = options.mode === 'week'
        ? `${options.targetLabel || ''}\nまでの実績/人`
        : '実績/人';
      headRow.innerHTML = `
        <th class="text-left text-[11px] font-semibold text-gray-500"></th>
        <th class="${metricsColClass} text-[11px] font-semibold text-gray-500 leading-tight whitespace-pre-line">${requiredHeader}</th>
        <th class="${metricsColClass} text-[11px] font-semibold text-gray-500 leading-tight whitespace-pre-line">${actualHeader}</th>
        <th class="${metricsColClass} text-[11px] font-semibold text-gray-500">差分</th>
      `;
      thead.appendChild(headRow);
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      let hasRows = false;
      const formatWhole = (val) => {
        const num = typeof val === 'number' ? val : 0;
        const rounded = Math.round(num);
        return `${rounded}g`;
      };
      const requiredTotals = options.mode === 'day'
        ? getGuidelineForCurrentUser()
        : buildGuidelineTotalsForIds(options.participantIds);
      ING_CLASS_ORDER.forEach((cls) => {
        const grams = totals.get(cls);
        const actualVal = (typeof grams === 'number' && !Number.isNaN(grams)) ? grams : 0;
        const requiredValRaw = requiredTotals && Object.prototype.hasOwnProperty.call(requiredTotals, cls)
          ? Number(requiredTotals[cls])
          : 0;
        const multiplier = options.mode === 'week' ? Math.max(1, Number(options.dayCount) || 1) : 1;
        const requiredVal = Number.isFinite(requiredValRaw) ? requiredValRaw * multiplier : 0;
        if (!actualVal && !requiredVal) return;
        hasRows = true;
        const row = document.createElement('tr');
        row.className = 'text-gray-700';
        const labelWrap = document.createElement('div');
        labelWrap.className = 'flex items-center gap-2';
        const badge = document.createElement('span');
        badge.className = 'inline-flex h-7 w-7 items-center justify-center rounded-full border border-amber-100 bg-white text-amber-600 shadow-sm';
        if (cls === 'きのこ類') {
          badge.appendChild(createMushroomIcon());
        } else {
          const icon = document.createElement('i');
          icon.dataset.lucide = ING_CLASS_ICONS[cls] || 'circle';
          icon.className = 'w-4 h-4';
          badge.appendChild(icon);
        }
        const label = document.createElement('span');
        label.className = 'font-medium';
        label.textContent = cls;
        labelWrap.append(badge, label);

        const shortageVal = actualVal - requiredVal;
        const shortageClass = shortageVal < 0 ? 'text-red-600' : (shortageVal > 0 ? 'text-gray-900' : 'text-gray-500');
        const shortageMagnitude = shortageVal === 0 ? '0' : String(Math.round(Math.abs(shortageVal)));
        const shortageText = shortageVal === 0
          ? '0g'
          : `${shortageVal < 0 ? '-' : ''}${shortageMagnitude}g`;

        const buildValue = (value, extraClass = 'text-gray-900') => {
          const el = document.createElement('td');
          el.className = `${metricsColClass} text-sm font-semibold align-middle ${extraClass}`;
          el.textContent = value;
          return el;
        };

        const shortageCol = buildValue('', `${shortageClass} ${shortageVal ? '' : 'text-gray-500'}`);
        if (shortageVal < 0 && options.allowShortageMenuSelection) {
          const shortageButton = document.createElement('button');
          shortageButton.type = 'button';
          shortageButton.className = 'rounded-full px-2 py-1 text-red-600 underline decoration-dotted underline-offset-2 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-300';
          shortageButton.textContent = shortageText;
          shortageButton.title = `${cls}を使うメニューを選ぶ`;
          shortageButton.setAttribute('aria-label', `${cls}の不足${shortageMagnitude}gを補うメニューを選ぶ`);
          shortageButton.addEventListener('click', () => {
            openShortageMenuModal(cls, {
              entries,
              seasoningEntries,
              mode: options.mode,
              dayCount: options.dayCount,
              targetLabel: options.targetLabel,
              participantCount: options.participantCount,
              participantIds: options.participantIds,
              selectedIndex: options.selectedIndex
            });
          });
          shortageCol.appendChild(shortageButton);
        } else {
          shortageCol.textContent = shortageText;
        }
        const actualCol = buildValue('', 'text-blue-600');
        if (actualVal > 0 && options.allowActualBreakdown) {
          const actualButton = document.createElement('button');
          actualButton.type = 'button';
          actualButton.className = 'rounded-full px-2 py-1 text-blue-600 underline decoration-dotted underline-offset-2 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-300';
          actualButton.textContent = formatWhole(actualVal);
          actualButton.title = `${cls}のメニュー別内訳を見る`;
          actualButton.setAttribute('aria-label', `${cls}の実績${Math.round(actualVal)}gのメニュー別内訳を見る`);
          actualButton.addEventListener('click', () => {
            openActualBreakdownModal(cls, entries, seasoningEntries, options);
          });
          actualCol.appendChild(actualButton);
        } else {
          actualCol.textContent = formatWhole(actualVal);
        }

        const labelCell = document.createElement('td');
        labelCell.className = 'py-1';
        labelCell.appendChild(labelWrap);

        row.append(
          labelCell,
          buildValue(formatWhole(requiredVal)),
          actualCol,
          shortageCol
        );
        tbody.appendChild(row);
      });

      if (!hasRows) {
        const empty = document.createElement('p');
        empty.className = 'text-xs text-gray-500';
        empty.textContent = 'g換算できる食材がありません。';
        target.appendChild(empty);
        return;
      }
      table.appendChild(tbody);
      target.appendChild(table);
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function renderWeekView(){
      const host = document.getElementById('wm2-week-grid');
      if (!host) return;
      const plan = getPlanData();
      host.innerHTML = '';
      const renderWeekThumb = (thumb, row) => {
        if (!thumb || !row) return;
        const setImages = row.menuType === 'set'
          ? (row.setMenus || []).map((m) => m && m.imageUrl).filter(Boolean)
          : [];
        if (setImages.length) {
          thumb.insertAdjacentHTML('beforeend', buildSetMenuGrid(setImages, row.name));
          return;
        }
        if (row.imageUrl) {
          const img = document.createElement('img');
          img.src = row.imageUrl;
          img.alt = row.name || '';
          thumb.appendChild(img);
          return;
        }
        thumb.textContent = 'no image';
      };
      const makeWeekCard = (row, dayIndex, mealKey, slotIndex) => {
        const item = document.createElement('div');
        item.tabIndex = 0;
        item.setAttribute('role', 'button');
        item.className = 'wm2-week-slot wm2-draggable';
        item.draggable = plan[dayIndex]?.isPreviousWeekDay !== true;
        item.dataset.dragDay = String(dayIndex);
        item.dataset.dragMeal = mealKey;
        item.dataset.dragIndex = String(slotIndex);
        const thumb = document.createElement('div');
        thumb.className = 'wm2-week-slot-thumb';
        renderWeekThumb(thumb, row);
        const recipeUrl = row.url || (row.menuId ? `/users/menu/${row.menuId}` : '');
        const thumbNode = recipeUrl ? document.createElement('a') : thumb;
        if (recipeUrl) {
          thumbNode.href = recipeUrl;
          thumbNode.target = 'menuWindow';
          thumbNode.rel = 'noopener noreferrer';
          thumbNode.dataset.weekRecipeLink = '';
          thumbNode.className = 'wm2-week-slot-thumb-link block flex-shrink-0';
          thumbNode.title = `${row.name || 'メニュー'}のレシピを開く`;
          thumbNode.appendChild(thumb);
        }
        const name = document.createElement(recipeUrl ? 'a' : 'div');
        name.className = 'wm2-week-slot-name';
        name.textContent = row.name || 'メニュー';
        if (recipeUrl) {
          name.href = recipeUrl;
          name.target = 'menuWindow';
          name.rel = 'noopener noreferrer';
          name.dataset.weekRecipeLink = '';
          name.title = `${row.name || 'メニュー'}のレシピを開く`;
        }
        const meta = document.createElement('div');
        meta.className = 'wm2-week-slot-meta';
        meta.appendChild(name);
        const servingItems = getMenuServingChipItems(row.servingTotals);
        if (servingItems.length) {
          const svLine = document.createElement('div');
          svLine.className = 'wm2-week-slot-sv';
          servingItems.forEach((svItem) => {
            const chip = document.createElement('span');
            chip.textContent = `${svItem.label}:${formatMenuServingValue(svItem.value)}`;
            svLine.appendChild(chip);
          });
          meta.appendChild(svLine);
        }
        item.append(thumbNode, meta);
        item.addEventListener('click', (event) => {
          if (event.target.closest('[data-week-recipe-link]')) return;
          sel = dayIndex;
          currentViewMode = 'detail';
          persistViewMode();
          updateViewModeUI();
          rebuild();
        });
        item.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          if (event.target.closest('[data-week-recipe-link]')) return;
          event.preventDefault();
          sel = dayIndex;
          currentViewMode = 'detail';
          persistViewMode();
          updateViewModeUI();
          rebuild();
        });
        return item;
      };
      const renderMealBucket = (container, slots, mealKey, dayIndex) => {
        const list = document.createElement('div');
        list.className = 'wm2-week-slot-list';
        list.dataset.weekDropDay = String(dayIndex);
        list.dataset.weekDropMeal = mealKey;
        if (!(slots || []).length) {
          const empty = document.createElement('div');
          empty.className = 'wm2-week-empty';
          empty.textContent = '未設定';
          list.appendChild(empty);
          container.appendChild(list);
          return;
        }
        slots.forEach((slot, index) => {
          const row = rowFromSlot(slot);
          if (!row.hasMenu) return;
          const card = makeWeekCard(row, dayIndex, mealKey, index);
          list.appendChild(card);
        });
        container.appendChild(list);
      };

      DAY_DISPLAY_ORDER.forEach((dayIndex) => {
        const entry = WEEK[dayIndex];
        if (!entry) return;
        const day = plan[dayIndex] || {};
        const dayCard = document.createElement('div');
        dayCard.className = `wm2-week-day${dayIndex === sel ? ' is-selected' : ''}`;

        const head = document.createElement('div');
        head.className = 'wm2-week-day-head';
        const titleWrap = document.createElement('div');
        const title = document.createElement('div');
        title.className = 'wm2-week-day-title';
        title.textContent = `${WEEKDAY[dayIndex] || ''} ${getDateLabel(dayIndex)}`;
        const meta = document.createElement('div');
        meta.className = 'wm2-week-day-meta';
        meta.textContent = 'タップで詳細';
        titleWrap.append(title, meta);
        const openBtn = document.createElement('button');
        openBtn.type = 'button';
        openBtn.className = 'text-xs font-semibold text-blue-700';
        openBtn.textContent = '詳細';
        openBtn.addEventListener('click', () => {
          sel = dayIndex;
          currentViewMode = 'detail';
          persistViewMode();
          updateViewModeUI();
          rebuild();
        });
        head.append(titleWrap, openBtn);
        dayCard.appendChild(head);

        const breakfast = Array.isArray(day.breakfastSlots) ? day.breakfastSlots.filter((slot) => rowFromSlot(slot).hasMenu) : [];
        const lunch = Array.isArray(day.lunchSlots) ? day.lunchSlots.filter((slot) => rowFromSlot(slot).hasMenu) : [];
        let dinnerSlots = Array.isArray(day.dinnerSlots) ? day.dinnerSlots.filter(Boolean) : [];
        if (!Array.isArray(day.dinnerSlots)) {
          const base = day.dinner && typeof day.dinner === 'object' ? ['staple','main','side','soup'].map((k)=> day.dinner[k]).filter(Boolean) : [];
          const extras = Array.isArray(day.dinnerExtras) ? day.dinnerExtras.filter(Boolean) : [];
          dinnerSlots = [...base, ...extras];
        }

        [
          { key: 'breakfast', label: '朝食', slots: breakfast },
          { key: 'lunch', label: '昼食', slots: lunch },
          { key: 'dinner', label: 'ディナー', slots: dinnerSlots }
        ].forEach(({ key, label, slots }) => {
          const mealBlock = document.createElement('div');
          mealBlock.className = 'wm2-week-meal';
          mealBlock.dataset.weekMeal = key;
          const mealLabel = document.createElement('div');
          mealLabel.className = 'wm2-week-meal-label';
          mealLabel.textContent = label;
          mealBlock.appendChild(mealLabel);
          renderMealBucket(mealBlock, slots, key, dayIndex);
          dayCard.appendChild(mealBlock);
        });

        host.appendChild(dayCard);
      });
    }

    function updateViewModeUI(){
      const main = document.getElementById('wm2-main');
      const weekView = document.getElementById('wm2-week-view');
      const preview = document.getElementById('wm2-preview');
      document.querySelectorAll('#wm2-view-toggle [data-view-mode]').forEach((btn) => {
        btn.dataset.active = String(btn.dataset.viewMode === currentViewMode);
      });
      if (main) main.dataset.active = String(currentViewMode === 'detail');
      if (weekView) weekView.dataset.active = String(currentViewMode === 'week');
      if (weekView) weekView.dataset.mealTab = currentWeekMealTab;
      if (weekView) weekView.dataset.mealLayout = currentWeekViewLayout;
      if (preview) preview.classList.toggle('hidden', currentViewMode !== 'detail');
      const section = document.getElementById('wm2-section');
      if (section) {
        section.dataset.viewMode = currentViewMode;
        section.dataset.weekSize = currentWeekViewSize;
      }
      document.querySelectorAll('#wm2-week-size-toggle [data-week-size]').forEach((btn) => {
        btn.dataset.active = String(btn.dataset.weekSize === currentWeekViewSize);
        btn.setAttribute('aria-pressed', btn.dataset.active);
      });
      document.querySelectorAll('#wm2-week-meal-tabs [data-week-meal-tab]').forEach((btn) => {
        btn.dataset.active = String(btn.dataset.weekMealTab === currentWeekMealTab);
        btn.setAttribute('aria-pressed', btn.dataset.active);
      });
      document.querySelectorAll('#wm2-week-layout-toggle [data-week-layout]').forEach((btn) => {
        btn.dataset.active = String(btn.dataset.weekLayout === currentWeekViewLayout);
        btn.setAttribute('aria-pressed', btn.dataset.active);
      });
      window.requestAnimationFrame(alignWeekTagMealRows);
    }

    function alignWeekTagMealRows(){
      const weekView = document.getElementById('wm2-week-view');
      if (!weekView) return;
      const mealTypes = ['breakfast', 'lunch', 'dinner'];
      const allBlocks = Array.from(weekView.querySelectorAll('.wm2-week-meal[data-week-meal]'));
      allBlocks.forEach((block) => { block.style.minHeight = ''; });
      if (currentWeekViewLayout !== 'tags' || currentViewMode !== 'week') return;
      mealTypes.forEach((mealType) => {
        const blocks = Array.from(weekView.querySelectorAll(`.wm2-week-meal[data-week-meal="${mealType}"]`));
        const maxHeight = blocks.reduce((max, block) => Math.max(max, Math.ceil(block.getBoundingClientRect().height)), 0);
        if (!maxHeight) return;
        blocks.forEach((block) => { block.style.minHeight = `${maxHeight}px`; });
      });
    }

    function rebuild(){ buildPills(); renderDay(); renderWeekView(); updateViewModeUI(); }
    document.addEventListener('weekplan:rendered', rebuild);
    document.querySelectorAll('#wm2-view-toggle [data-view-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentViewMode = btn.dataset.viewMode === 'detail' ? 'detail' : 'week';
        persistViewMode();
        updateViewModeUI();
      });
    });
    document.querySelectorAll('#wm2-week-size-toggle [data-week-size]').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentWeekViewSize = btn.dataset.weekSize === 'large' ? 'large' : 'normal';
        try {
          window.localStorage.setItem(weekViewSizeStorageKey, currentWeekViewSize);
        } catch (_) { /* storage unavailable */ }
        updateViewModeUI();
      });
    });
    document.querySelectorAll('#wm2-week-meal-tabs [data-week-meal-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const meal = btn.dataset.weekMealTab;
        currentWeekMealTab = ['breakfast', 'lunch', 'dinner'].includes(meal) ? meal : 'breakfast';
        updateViewModeUI();
      });
    });
    document.querySelectorAll('#wm2-week-layout-toggle [data-week-layout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentWeekViewLayout = btn.dataset.weekLayout === 'tags' ? 'tags' : 'tabs';
        try {
          window.localStorage.setItem(weekViewLayoutStorageKey, currentWeekViewLayout);
        } catch (_) { /* storage unavailable */ }
        updateViewModeUI();
      });
    });
    let weekTagResizeFrame = 0;
    window.addEventListener('resize', () => {
      if (weekTagResizeFrame) window.cancelAnimationFrame(weekTagResizeFrame);
      weekTagResizeFrame = window.requestAnimationFrame(() => {
        weekTagResizeFrame = 0;
        alignWeekTagMealRows();
      });
    });
    // Refresh after primary interactions from weekMenu (without disturbing anchor navigation)
    document.addEventListener('click', (e) => {
      const closeBtn = e.target.closest('#wm2-set-modal [data-close]');
      if (closeBtn) {
        e.preventDefault();
        closeSetMenuModal();
        return;
      }
      const setBtn = e.target.closest('[data-action="open-set-menu"]');
      if (setBtn) {
        e.preventDefault();
        const menuId = setBtn.dataset.menuId || '';
        openSetMenuModalById(menuId);
        return;
      }
      const needsRefresh =
        e.target.closest('[data-menu-option]') ||
        e.target.closest('[data-fav-action="submit"]') ||
        e.target.closest('[data-action="toggle-dine"]') ||
        e.target.closest('[data-action="clear-slot"]') ||
        e.target.closest('[data-action="shuffle"]') ||
        e.target.closest('[data-action="add-lunch-slot"]') ||
        e.target.closest('[data-action="add-dinner-slot"]') ||
        e.target.closest('[data-action="toggle-favorite"]') ||
        e.target.closest('[data-action="change"]');
      if (needsRefresh) {
        setTimeout(rebuild, 40);
        // Request auto-save shortly after state/render settles
        setTimeout(function(){ if (window.weekMenuAPI && window.weekMenuAPI.requestAutoSave) window.weekMenuAPI.requestAutoSave(); }, 120);
      }
    });
    const checkInitialSetMenu = () => {
      let targetId = '';
      try {
        const params = new URLSearchParams(window.location.search || '');
        targetId = params.get('setMenuId') || '';
      } catch (_) { targetId = ''; }
      if (targetId) openSetMenuModalById(targetId);
    };
    if (document.readyState==='loading') {
      document.addEventListener('DOMContentLoaded', () => { rebuild(); checkInitialSetMenu(); });
    } else {
      rebuild();
      checkInitialSetMenu();
    }
  })();

  // Fallback proxy removed to avoid duplicate click handling (caused recursion)

  // Remove original main tab buttons block (plan/supplies) to avoid empty spacing
  (function(){
    const removeTabs = () => {
      const anyTab = document.querySelector('section.relative.max-w-6xl.mx-auto:not(#wm2-section) .main-tab-button');
      if (!anyTab) return;
      const container = anyTab.closest('div.w-full.grid');
      const outer = anyTab.closest('div.px-0.py-0.space-y-0') || container?.parentElement;
      if (outer && outer.parentElement) outer.parentElement.removeChild(outer);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', removeTabs); else removeTabs();
  })();

  // (Removed) intrusive mutation observer; rely on explicit events instead
</script>

<script>
  // weekMenu2 dine-out edit modal (capture clicks before weekMenu handlers)
  (function(){
    let ctx = null; // { day, meal, index }
    const ensureModal = () => {
      let modal = document.getElementById('wm2-dine-modal');
      if (modal) return modal;
      const tpl = document.createElement('div');
      tpl.id = 'wm2-dine-modal';
      tpl.className = 'hidden fixed inset-0 z-50';
      tpl.innerHTML = `
        <div class="absolute inset-0 bg-black/40" data-role="backdrop"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4">
          <div class="w-full max-w-sm rounded-xl bg-white p-5 shadow-lg border">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-base font-semibold">外食情報を編集</h3>
              <button type="button" class="inline-flex items-center justify-center rounded hover:bg-gray-100 p-2" data-role="close"><span class="lucide w-4 h-4" data-lucide="x"></span></button>
            </div>
            <div class="space-y-3 text-[15px]">
              <label class="block">
                <span class="text-sm text-gray-700">お店の名前</span>
                <input type="text" id="wm2-dine-name" name="dineName" class="mt-1 w-full rounded border border-gray-300 px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="店名を入力" />
              </label>
              <label class="block">
                <span class="text-sm text-gray-700">グルメサイトのURL（任意）</span>
                <input type="url" id="wm2-dine-url" name="dineUrl" class="mt-1 w-full rounded border border-gray-300 px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="https://..." />
              </label>
            </div>
            <div class="mt-5 flex justify-end gap-2">
              <button type="button" data-role="cancel" class="px-3 py-1.5 rounded border">キャンセル</button>
              <button type="button" data-role="save" class="px-3 py-1.5 rounded bg-blue-600 text-white">保存</button>
            </div>
          </div>
        </div>`;
      document.body.appendChild(tpl);
      if (typeof window.refreshLucideIcons === 'function') window.refreshLucideIcons();
      return tpl;
    };

    const open = (day, meal, index) => {
      const modal = ensureModal();
      ctx = { day, meal, index };
      const info = (window.weekMenuAPI && window.weekMenuAPI.getDineInfo) ? window.weekMenuAPI.getDineInfo(day, meal, index) : { dineOut:false, dineOutName:'', dineOutUrl:'' };
      const nameEl = document.getElementById('wm2-dine-name');
      const urlEl = document.getElementById('wm2-dine-url');
      if (nameEl) nameEl.value = info.dineOutName || '';
      if (urlEl) urlEl.value = info.dineOutUrl || '';
      modal.classList.remove('hidden');
    };
    const close = () => {
      const modal = document.getElementById('wm2-dine-modal');
      if (!modal) return;
      modal.classList.add('hidden');
      ctx = null;
    };

    // Capture click on toggle-dine inside this section to replace prompt with modal
    document.addEventListener('click', (ev) => {
      const t = ev.target;
      const btn = t && t.closest && t.closest('#wm2-section [data-action="toggle-dine"]');
      const editBtn = t && t.closest && t.closest('#wm2-section [data-action="edit-dine"]');
      if (!btn && !editBtn) return;
      ev.preventDefault(); ev.stopPropagation();

      const container = t.closest('[data-slot-index],[data-dinner-index]');
      const mealBox = t.closest('#wm2-box-breakfast, #wm2-box-lunch, #wm2-box-dinner');
      if (!container || !mealBox) return;
      const isDinner = container.hasAttribute('data-dinner-index');
      const meal = mealBox.dataset.meal || (isDinner ? 'dinner' : 'lunch');
      const indexAttr = isDinner ? 'data-dinner-index' : 'data-slot-index';
      const index = Number(container.getAttribute(indexAttr));
      const day = Number(mealBox.getAttribute('data-day'));
      if (!meal || Number.isNaN(index) || Number.isNaN(day)) return;

      const api = window.weekMenuAPI || {};
      const current = api.getDineInfo ? api.getDineInfo(day, meal, index) : { dineOut:false };
      if (editBtn) {
        open(day, meal, index);
        return;
      }
      if (!current.dineOut) {
        if (api.setDineInfo) api.setDineInfo(day, meal, index, { dineOut: true });
        open(day, meal, index);
      } else {
        if (api.setDineInfo) api.setDineInfo(day, meal, index, { dineOut: false, dineOutName: '', dineOutUrl: '' });
        try { if (api.saveWeekPlanSilently) api.saveWeekPlanSilently(); else if (api.requestAutoSave) api.requestAutoSave(); } catch(_) {}
      }
    }, true);

    document.addEventListener('click', (ev) => {
      const t = ev.target;
      const modal = document.getElementById('wm2-dine-modal');
      if (!modal || modal.classList.contains('hidden')) return;
      if (t.closest('[data-role="close"]') || t.closest('[data-role="cancel"]') || t.closest('[data-role="backdrop"]')) {
        ev.preventDefault(); close(); return;
      }
      if (t.closest('[data-role="save"]')) {
        ev.preventDefault();
        if (!ctx) { close(); return; }
        const nameEl = document.getElementById('wm2-dine-name');
        const urlEl = document.getElementById('wm2-dine-url');
        const name = (nameEl && nameEl.value || '').trim();
        const url = (urlEl && urlEl.value || '').trim();
        if (window.weekMenuAPI && window.weekMenuAPI.setDineInfo) {
          window.weekMenuAPI.setDineInfo(ctx.day, ctx.meal, ctx.index, { dineOut: true, dineOutName: name, dineOutUrl: url });
        }
        // Auto-save after editing dine info
        try { if (window.weekMenuAPI && window.weekMenuAPI.requestAutoSave) window.weekMenuAPI.requestAutoSave(); } catch(_) {}
        close();
      }
    });
  })();
</script>

<!-- weekMenu2: 「これ食べた」 API 呼び出し -->
<script>
  (function(){
    console.log('[wm2] DO handler boot');
    const sod = (d)=>{ const x=new Date(d); x.setHours(0,0,0,0); return x; };
    function applyRecordedStyle(btn, recorded){
      try { console.log('[wm2] applyRecordedStyle', { recorded, before: btn.className, dataRecorded: btn.dataset.recorded }); } catch(_) {}
      btn.dataset.recorded = recorded ? 'true' : 'false';
      const clsOn = ['bg-emerald-50','text-emerald-700','border-emerald-300','hover:text-emerald-800','hover:border-emerald-400','focus:ring-emerald-200'];
      const clsOff = ['bg-white','text-gray-500','border-gray-200','hover:text-blue-600','hover:border-blue-300','focus:ring-blue-100'];
      // reset base
      btn.classList.remove(...clsOn, ...clsOff);
      // ICON_BTN base minimal assumptions: ensure icon-button base remains; rely on original classes existing
      const base = 'icon-button inline-flex h-9 w-9 items-center justify-center rounded-full border shadow-sm transition disabled:cursor-not-allowed disabled:opacity-40'.split(' ');
      base.forEach(c => { if (!btn.classList.contains(c)) btn.classList.add(c); });
      // add border/text colors
      (recorded ? clsOn : clsOff).forEach(c => btn.classList.add(c));
      try { console.log('[wm2] applyRecordedStyle after', btn.className, 'data-recorded=', btn.dataset.recorded); } catch(_) {}
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    async function __handle(ev) {
      const btn = ev.target.closest('[data-action="wm2-mark-ate"]');
      if (!btn) return false;
      if (btn.dataset.busy === 'true') { console.log('[wm2] busy: skip'); return false; }
      btn.dataset.busy = 'true';
      ev.preventDefault();
      try {
        console.log('[wm2] DO click');
        const data = window.weekMenuData || {};
        const week = Array.isArray(data.weekDates) ? data.weekDates : [];
        const dayIndex = Number(btn.getAttribute('data-day'));
        const meal = btn.getAttribute('data-meal');
        const menuId = btn.getAttribute('data-menu-id');
        const dateISO = (week[dayIndex] && (week[dayIndex].dateISO || week[dayIndex])) || '';
        const todayISO = data.todayISO || new Date().toISOString();
        console.log('[wm2] payload base', { dayIndex, meal, menuId, dateISO, todayISO });
        if (!menuId) throw new Error('メニューが特定できません');
        if (!dateISO) throw new Error('日付が特定できません');
        if (sod(new Date(dateISO)).getTime() > sod(new Date(todayISO)).getTime()) throw new Error('未来日は記録できません');

        const recorded = btn.dataset.recorded === 'true';
        console.log('[wm2] recorded?', recorded);
        // ensure planId (only needed when recording, not when deleting)
        let planId = data.planId || '';
        if (!recorded) {
          if (!planId && window.weekMenuAPI && window.weekMenuAPI.saveWeekPlanSilently) {
            try { await window.weekMenuAPI.saveWeekPlanSilently(); planId = (window.weekMenuData && window.weekMenuData.planId) || ''; } catch(_) {}
          }
        }

        const payload = { planId: planId || '', groupId: data.currentGroupId || '', dayIndex, dateISO, mealType: meal, menuId };
        console.log('[wm2] request', recorded ? 'DELETE' : 'POST', payload);
        let resp;
        if (!recorded) {
          // record
          resp = await fetch('/users/week-menu/do', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        } else {
          // unrecord
          resp = await fetch('/users/week-menu/do', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        }
        console.log('[wm2] response status', resp.status);
        if (!resp.ok) {
          const txt = await resp.text();
          console.error('[wm2] response error', resp.status, txt);
          throw new Error(recorded ? '取消に失敗しました' : '記録に失敗しました');
        }
        const json = await resp.json();
        console.log('[wm2] response json', json);
        if (!json || !json.success) throw new Error(recorded ? '取消に失敗しました' : '記録に失敗しました');

        // Toggle style + state
        applyRecordedStyle(btn, !recorded);
        // Update in-memory DO set so that re-rendered days reflect the latest state
        try {
          const key = `${String(dateISO).slice(0,10)}|${meal}|${String(menuId)}`;
          if (window.__wm2_DO_SET) {
            if (!recorded) window.__wm2_DO_SET.add(key); else window.__wm2_DO_SET.delete(key);
            console.log('[wm2] DO set updated', !recorded ? 'add' : 'delete', key);
          }
        } catch(_) {}
      } catch (err) {
        console.error('[wm2] DO error', err);
        alert(err.message || '記録に失敗しました');
      }
      btn.dataset.busy = 'false';
      return false;
    }

    // expose only direct handler (per-button listeners call this)
    window.__wm2_markAte = __handle;
    console.log('[wm2] DO handler attached');

    // 初期描画時は未記録スタイルのまま
  })();
</script>

