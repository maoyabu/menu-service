    // global click handler for attendee buttons
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-action="attendee-add"], [data-action="attendee-remove"], [data-action="attendee-reset-all"]');
      if (!btn) return;
      const action = btn.dataset.action;
      const meal = btn.dataset.meal;
      const day = Number(btn.dataset.day);
      if (!meal || Number.isNaN(day)) return;
      try {
        if (!planId) {
          // 先に自動保存してplanIdを確定させる
          if (window.weekMenuAPI && window.weekMenuAPI.saveWeekPlanSilently) {
            await window.weekMenuAPI.saveWeekPlanSilently();
          }
        }
        const latestPlanId = getPlanIdForDay(day);
        if (!latestPlanId) throw new Error('プランIDが未確定のため保存できません');
        let endpoint = '/users/week-menu/participants';
        let body = null;
        if (action === 'attendee-reset-all') {
          endpoint = '/users/week-menu/participants/reset';
          body = { planId: latestPlanId, dayIndex: day, mealType: meal };
        } else {
          const participate = action === 'attendee-add';
          // attendee-remove の場合は理由モーダルを先に開く
          if (!participate) {
            if (typeof window.__wm2_openReasonModal === 'function') {
              // 後続送信はモーダル側から行う
              window.__wm2_openReasonModal(day, meal);
              return;
              if (window.refreshLucideIcons) window.refreshLucideIcons();
            }
          }
          body = { planId: latestPlanId, dayIndex: day, mealType: meal, participate };
        }
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error('更新に失敗しました');
