                <span class="pill ${it.type==='ingredient'?'ing':'sea'}">${it.type==='ingredient'?'食材':'調味料'}</span>
                ${!it.fromStock ? `
                  <button type="button" class="ml-2 inline-flex items-center justify-center rounded-full border border-purple-300 text-purple-700 bg-purple-50 hover:bg-purple-100 px-2 py-1 text-xs font-semibold" data-action="wm2-add-stock" title="マイストックに追加">
                    <span class="text-xs font-bold leading-none mr-0.5">＋</span>
                    <span class="lucide w-3.5 h-3.5" data-lucide="package"></span>
                  </button>
                ` : ''}
              </div>`;
            ul.appendChild(li);
            try {
              if (checked && li.dataset.fromStock !== 'true') {
                const inline = li.querySelector('[data-role="state-inline"]');
                const d = (window.__wm2_supDates && window.__wm2_supDates[it.key]) || '';
                if (inline && d) inline.innerHTML = '<span class="pill state purchased">購入済み ' + (fmtDate(d) || '') + '</span>';
              }
            } catch(_) {}
          });
          return ul;
        };
        const renderType = (title, listItems) => {
          if (!listItems || !listItems.length) return;
          const h = document.createElement('h5'); h.className='mt-2 text-xs font-semibold text-gray-500'; h.textContent=title; wrap.appendChild(h);
          const groups = groupByClass(listItems);
          const labels = sortClassLabels(Array.from(groups.keys()));
          labels.forEach((label)=>{
