      const grid = document.createElement('div'); grid.className='grid grid-cols-1 md:grid-cols-2 gap-4';
      const left = document.createElement('div');
      const h1 = document.createElement('h4'); h1.textContent = '買うもの'; left.appendChild(h1);
      left.appendChild(listTpl('wm2-sup-buy', buyItems));
