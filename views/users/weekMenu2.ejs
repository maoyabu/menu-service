<script>
  (function(){
    const startOfWeekMon = (date) => {
      const d = new Date(date);
      d.setHours(0, 0, 0, 0);
      const offset = (d.getDay() + 6) % 7;
      d.setDate(d.getDate() - offset);
      return d;
    };
    const toLocalISO = (date) => {
      const d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
      return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString();
    };
    const navigateToWeek = (targetDate) => {
      const url = new URL(window.location.href);
      url.searchParams.delete('plan');
      url.searchParams.delete('planId');
      url.searchParams.set('weekStart', toLocalISO(startOfWeekMon(targetDate)));
      window.location.assign(url.toString());
    };

    document.querySelectorAll('[data-week-shift]').forEach((button) => {
      button.addEventListener('click', () => {
        const data = window.weekMenuData || {};
        const base = data.weekStartISO || new Date().toISOString();
        const week = startOfWeekMon(new Date(base));
        week.setDate(week.getDate() + (Number(button.dataset.weekShift) || 0) * 7);
        navigateToWeek(week);
      });
    });

    const todayButton = document.querySelector('[data-week-today]');
    if (todayButton) {
      todayButton.addEventListener('click', () => navigateToWeek(new Date()));
    }

    const toggle = document.querySelector('[data-calendar-toggle]');
    const popover = document.getElementById('wm2-calendar-popover');
    const setCalendarOpen = (open) => {
      if (!toggle || !popover) return;
      popover.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    if (toggle && popover) {
      toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        setCalendarOpen(popover.hidden);
      });
      popover.addEventListener('click', (event) => event.stopPropagation());
      document.addEventListener('click', () => setCalendarOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setCalendarOpen(false);
      });
    }
  })();
</script>

