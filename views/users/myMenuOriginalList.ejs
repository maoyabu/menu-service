<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex flex-col items-start gap-2">
    <nav class="text-sm text-gray-600 inline-flex items-center gap-1">
      <a href="/users/my-menu" class="inline-flex items-center gap-1 text-blue-600 font-semibold">
        <span class="lucide w-4 h-4" data-lucide="utensils"></span>
        <span>マイメニュートップ</span>
      </a>
      <span class="text-gray-400">›</span>
      <span>オリジナルレシピ一覧</span>
    </nav>
    <div class="rounded-xl border border-purple-200 bg-purple-50 px-4 py-2 text-purple-800">
      <h1 class="text-xl font-extrabold">オリジナルレシピ一覧</h1>
      <p class="text-sm opacity-80">自分が登録したオリジナルレシピ</p>
    </div>
    <a href="/users/my-menu/original" class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 bg-purple-700 text-white text-sm font-semibold hover:bg-purple-800">新規作成</a>
  </header>

  <form method="get" class="bg-white border rounded-xl p-3 flex flex-wrap items-center gap-3 text-sm">
    <input
      type="text"
      name="keyword"
      value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
      placeholder="メニュー名・種類・メニュー内容で検索"
      class="border rounded-lg px-3 py-2 min-w-[240px]"
    />
    <label class="inline-flex items-center gap-2">
      <input type="checkbox" name="show_hidden" value="true" <%= showHidden ? 'checked' : '' %> />
      <span>非表示のレシピも表示</span>
    </label>
    <button class="px-3 py-1.5 rounded border">更新</button>
    <a href="/users/my-menu/original-list" class="px-3 py-1.5 rounded border">クリア</a>
  </form>

  <style>
    .myorig-grid{ display:grid; width:100%; height:100%; gap:1px; background:#e5e7eb; }
    .myorig-grid.one{ grid-template-columns:1fr; grid-template-rows:1fr; }
    .myorig-grid.two{ grid-template-columns:repeat(2,1fr); grid-template-rows:1fr; }
    .myorig-grid.three,
    .myorig-grid.four{ grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(2,1fr); }
    .myorig-grid.five{ grid-template-columns:repeat(2,1fr); grid-template-rows:repeat(3,1fr); }
    .myorig-grid .tile{ background:#f1f5f9; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .myorig-grid .tile img{ width:100%; height:100%; object-fit:cover; }
    .myorig-grid .tile.span-2{ grid-column:1 / 3; }
  </style>

  <% if (!list || !list.length) { %>
    <p class="text-gray-500">オリジナルレシピはまだありません</p>
  <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% list.forEach(function(mm){ const m = mm.menu || {}; %>
        <article class="rounded-xl border bg-white overflow-hidden shadow-sm">
          <div class="aspect-video bg-gray-100 overflow-hidden relative">
            <% if (m.menuType === 'set') { %>
              <% const setImages = (m.setMenus || []).map(x => x?.imageUrl).filter(Boolean); %>
              <% const imgCount = Math.min(setImages.length, 5); %>
              <% if (imgCount > 0) { %>
                <% const gridClass = imgCount === 1 ? 'one' : (imgCount === 2 ? 'two' : (imgCount === 3 ? 'three' : (imgCount === 4 ? 'four' : 'five'))); %>
                <div class="myorig-grid <%= gridClass %>">
                  <% if (imgCount === 3) { %>
                    <div class="tile span-2"><img src="<%= setImages[0] %>" alt=""></div>
                    <div class="tile"><img src="<%= setImages[1] %>" alt=""></div>
                    <div class="tile"><img src="<%= setImages[2] %>" alt=""></div>
                  <% } else if (imgCount === 5) { %>
                    <div class="tile span-2"><img src="<%= setImages[0] %>" alt=""></div>
                    <% for (let i = 1; i < 5; i++) { %>
                      <div class="tile"><img src="<%= setImages[i] %>" alt=""></div>
                    <% } %>
                  <% } else { %>
                    <% for (let i = 0; i < imgCount; i++) { %>
                      <div class="tile"><img src="<%= setImages[i] %>" alt=""></div>
                    <% } %>
                  <% } %>
                </div>
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-xs text-gray-400">no image</div>
              <% } %>
            <% } else { %>
              <img src="<%= m.imageUrl || '' %>" alt="" class="w-full h-full object-cover <%= m.imageUrl ? '' : 'hidden' %>">
            <% } %>
            <% if (m.kind) { %>
              <span class="absolute top-2 left-2 text-[10px] bg-white/90 text-gray-700 rounded px-2 py-0.5"><%= m.kind %></span>
            <% } %>
            <a href="/users/my-menu/edit/<%= m._id %>" class="absolute top-2 right-2 inline-flex h-8 w-8 items-center justify-center rounded-full border text-gray-500 bg-white/90 hover:bg-white" title="編集">
              <span class="lucide w-4 h-4" data-lucide="pencil"></span>
            </a>
          </div>
          <div class="p-3 space-y-1">
            <% const __typeIsSet = (m.menuType === 'set') || (Array.isArray(m.setMenus) && m.setMenus.length > 0); %>
            <% const __typeIsArrange = m.menuType === 'arrange'; %>
            <div class="flex flex-wrap items-center gap-1">
              <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-purple-50 text-purple-700">オリジナル</span>
              <% if (__typeIsSet) { %>
                <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-rose-50 text-rose-700">セットメニュー</span>
              <% } %>
              <% if (__typeIsArrange) { %>
                <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-rose-50 text-rose-700">アレンジメニュー</span>
              <% } %>
              <% if (mm.hidden) { %>
                <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-gray-200 text-gray-700">非表示</span>
              <% } %>
            </div>
            <h3 class="font-semibold text-sm truncate" title="<%= m.name || '' %>"><%= m.name || '' %></h3>
            <div class="text-xs text-gray-500"><span><%= m.kind || '' %></span> · <span><%= m.junle || '' %></span> · <span><%= m.cook || '' %></span></div>
            <div class="pt-2 flex items-center gap-2">
              <a href="/users/my-menu/edit/<%= m._id %>" class="text-xs px-2 py-1 rounded border">編集</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
