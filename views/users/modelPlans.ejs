<%
  const fmt = (value) => {
    try {
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
    } catch (_) {
      return '';
    }
  };
  const countMenus = (template) => (template.dayPlans || []).reduce((sum, day) => sum + ((day.slots || []).length), 0);
%>

<section class="max-w-6xl mx-auto space-y-6">
  <header class="flex flex-col gap-3 rounded-xl border border-blue-200 bg-blue-50 px-4 py-4 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3 text-blue-900">
      <span class="lucide w-5 h-5" data-lucide="calendar-days"></span>
      <div>
        <h1 class="text-xl font-extrabold">モデルPLAN一覧</h1>
        <p class="text-sm text-blue-700">よく使う一週間の献立パターンを編集できます。</p>
      </div>
    </div>
    <a href="/users/my-menu" class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">
      <span class="lucide w-4 h-4" data-lucide="chevron-left"></span>
      マイメニューへ
    </a>
  </header>

  <% if (!(templates || []).length) { %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
      <p class="font-semibold text-gray-800">モデルPLANはまだありません。</p>
      <p class="mt-2 text-sm text-gray-500">7 DAYS PLAN画面で保存済みの週を開き、「モデルPLANとして保存」から作成できます。</p>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% templates.forEach((template) => { %>
        <article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="truncate text-base font-bold text-gray-900" title="<%= template.title || 'モデルPLAN' %>"><%= template.title || 'モデルPLAN' %></h2>
              <p class="mt-1 text-xs text-gray-500"><%= template.group?.group_name || 'グループ' %></p>
            </div>
            <span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700"><%= countMenus(template) %>品</span>
          </div>
          <% if (template.description) { %>
            <p class="mt-3 line-clamp-2 text-sm text-gray-600"><%= template.description %></p>
          <% } %>
          <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
            <span>更新日 <%= fmt(template.updatedAt) %></span>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <a href="/users/my-menu/model-plans/<%= template._id %>/edit" class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700">
              <span class="lucide w-4 h-4" data-lucide="edit-3"></span>
              編集
            </a>
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-100" data-delete-template="<%= template._id %>">
              <span class="lucide w-4 h-4" data-lucide="trash-2"></span>
            </button>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<script>
  document.addEventListener('click', async (event) => {
    const btn = event.target.closest('[data-delete-template]');
    if (!btn) return;
    const id = btn.getAttribute('data-delete-template');
    if (!id) return;
    if (!window.confirm('このモデルPLANを削除します。よろしいですか？')) return;
    btn.disabled = true;
    try {
      const res = await fetch(`/users/my-menu/model-plans/${encodeURIComponent(id)}`, { method: 'DELETE' });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.error || '削除に失敗しました。');
      window.location.reload();
    } catch (err) {
      alert(err.message || '削除に失敗しました。');
      btn.disabled = false;
    }
  });
  window.refreshLucideIcons && window.refreshLucideIcons();
</script>
