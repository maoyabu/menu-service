<%
  const fmt = (value) => {
    try {
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      return `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
    } catch (_) {
      return '';
    }
  };
  const countMenus = (template) => (template.dayPlans || []).reduce((sum, day) => sum + ((day.slots || []).length), 0);
  const ownTemplates = templates || [];
  const publishedTemplates = publicTemplates || [];
  const groups = userGroups || [];
%>

<section class="max-w-6xl mx-auto space-y-6">
  <header class="flex flex-col gap-3 rounded-xl border border-blue-200 bg-blue-50 px-4 py-4 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3 text-blue-900">
      <span class="lucide w-5 h-5" data-lucide="calendar-days"></span>
      <div>
        <h1 class="text-xl font-extrabold">モデルPLAN一覧</h1>
        <p class="text-sm text-blue-700">よく使う一週間の献立パターンを編集できます。</p>
      </div>
    </div>
    <a href="/users/my-menu" class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-white px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">
      <span class="lucide w-4 h-4" data-lucide="chevron-left"></span>
      マイメニューへ
    </a>
  </header>

  <% if (!ownTemplates.length) { %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
      <p class="font-semibold text-gray-800">モデルPLANはまだありません。</p>
      <p class="mt-2 text-sm text-gray-500">7 DAYS PLAN画面で保存済みの週を開き、「モデルPLANとして保存」から作成できます。</p>
    </div>
  <% } else { %>
    <h2 class="text-lg font-bold text-gray-900">自分のモデルPLAN</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% ownTemplates.forEach((template) => { %>
        <% const publicScope = template.publicScope === 'all' ? 'all' : 'group'; %>
        <% const isPublic = template.isPublic !== false; %>
        <article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="truncate text-base font-bold text-gray-900" title="<%= template.title || 'モデルPLAN' %>"><%= template.title || 'モデルPLAN' %></h2>
              <p class="mt-1 text-xs text-gray-500"><%= template.group?.group_name || 'グループ' %></p>
            </div>
            <span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700"><%= countMenus(template) %>品</span>
          </div>
          <% if (template.description) { %>
            <p class="mt-3 line-clamp-2 text-sm text-gray-600"><%= template.description %></p>
          <% } %>
          <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
            <span>更新日 <%= fmt(template.updatedAt) %></span>
          </div>
          <form class="mt-4 rounded-lg border border-gray-100 bg-gray-50 p-3 text-sm" data-public-settings-form data-template-id="<%= template._id %>">
            <label class="inline-flex items-center gap-2 font-semibold text-gray-700">
              <input type="checkbox" name="isPublic" class="rounded border-gray-300" <%= isPublic ? 'checked' : '' %>>
              公開する
            </label>
            <div class="mt-3">
              <select name="publicScope" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm" <%= isPublic ? '' : 'disabled' %>>
                <option value="group" <%= publicScope === 'group' ? 'selected' : '' %>>自分のグループだけに公開</option>
                <option value="all" <%= publicScope === 'all' ? 'selected' : '' %>>Allグループに公開</option>
              </select>
            </div>
            <p class="mt-2 text-xs text-gray-500" data-public-settings-status></p>
          </form>
          <div class="mt-4 flex items-center gap-2">
            <a href="/users/my-menu/model-plans/<%= template._id %>/edit" class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700">
              <span class="lucide w-4 h-4" data-lucide="edit-3"></span>
              編集
            </a>
            <button type="button" class="inline-flex items-center justify-center rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-100" data-delete-template="<%= template._id %>">
              <span class="lucide w-4 h-4" data-lucide="trash-2"></span>
            </button>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>

  <section class="space-y-4">
    <div>
      <h2 class="text-lg font-bold text-gray-900">公開されたPLAN一覧</h2>
      <p class="mt-1 text-sm text-gray-500">公開されたモデルPLANは直接編集できません。複製して自分のモデルPLANに取り込むと編集できます。</p>
    </div>
    <% if (!publishedTemplates.length) { %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-8 text-center text-sm text-gray-500">
        公開されたモデルPLANはまだありません。
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% publishedTemplates.forEach((template) => { %>
          <article class="rounded-xl border border-emerald-200 bg-white p-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="truncate text-base font-bold text-gray-900" title="<%= template.publishedTitle || template.title || 'モデルPLAN' %>"><%= template.publishedTitle || template.title || 'モデルPLAN' %></h3>
                <p class="mt-1 text-xs text-gray-500"><%= template.publicScope === 'all' ? 'Allグループ公開' : 'グループ公開' %></p>
              </div>
              <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700"><%= countMenus(template) %>品</span>
            </div>
            <% if (template.description) { %>
              <p class="mt-3 line-clamp-2 text-sm text-gray-600"><%= template.description %></p>
            <% } %>
            <div class="mt-4 flex items-center justify-between text-xs text-gray-500">
              <span>更新日 <%= fmt(template.updatedAt) %></span>
            </div>
            <button
              type="button"
              class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-semibold text-white hover:bg-emerald-700"
              data-duplicate-template="<%= template._id %>"
              data-default-title="<%= (template.title || 'モデルPLAN').replace(/"/g, '&quot;') %>"
            >
              <span class="lucide w-4 h-4" data-lucide="copy-plus"></span>
              複製して取り込む
            </button>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>

<script>
  const modelPlanGroups = <%- JSON.stringify((groups || []).map((group) => ({ id: String(group._id), name: group.group_name || 'グループ' }))) %>;

  document.addEventListener('change', async (event) => {
    const form = event.target.closest('[data-public-settings-form]');
    if (!form) return;
    const id = form.getAttribute('data-template-id');
    const isPublicInput = form.querySelector('input[name="isPublic"]');
    const publicScopeSelect = form.querySelector('select[name="publicScope"]');
    const status = form.querySelector('[data-public-settings-status]');
    if (!id || !isPublicInput || !publicScopeSelect) return;
    const isPublic = !!isPublicInput.checked;
    publicScopeSelect.disabled = !isPublic;
    if (status) status.textContent = '保存中...';
    try {
      const res = await fetch(`/users/my-menu/model-plans/${encodeURIComponent(id)}/public-settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isPublic, publicScope: publicScopeSelect.value || 'group' })
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.error || '公開設定を保存できませんでした。');
      if (status) status.textContent = '保存しました';
    } catch (err) {
      if (status) status.textContent = '';
      alert(err.message || '公開設定を保存できませんでした。');
    }
  });

  document.addEventListener('click', async (event) => {
    const duplicateBtn = event.target.closest('[data-duplicate-template]');
    if (duplicateBtn) {
      const id = duplicateBtn.getAttribute('data-duplicate-template');
      if (!id) return;
      const defaultTitle = `${duplicateBtn.getAttribute('data-default-title') || 'モデルPLAN'} のコピー`;
      const title = window.prompt('取り込むモデルPLAN名', defaultTitle);
      if (title === null) return;
      const trimmed = String(title || '').trim();
      if (!trimmed) {
        alert('モデルPLAN名を入力してください。');
        return;
      }
      let groupId = modelPlanGroups[0]?.id || '';
      if (!groupId) {
        alert('保存先グループが見つかりません。');
        return;
      }
      if (modelPlanGroups.length > 1) {
        const options = modelPlanGroups.map((group, index) => `${index + 1}: ${group.name}`).join('\n');
        const selected = window.prompt(`保存先グループを番号で選択してください。\n${options}`, '1');
        if (selected === null) return;
        const index = Number(selected) - 1;
        if (!Number.isInteger(index) || !modelPlanGroups[index]) {
          alert('保存先グループの選択が不正です。');
          return;
        }
        groupId = modelPlanGroups[index].id;
      }
      duplicateBtn.disabled = true;
      try {
        const res = await fetch(`/users/my-menu/model-plans/${encodeURIComponent(id)}/duplicate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: trimmed, groupId, isPublic: true, publicScope: 'group' })
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.error || '取り込みに失敗しました。');
        alert('モデルPLANを取り込みました。');
        window.location.reload();
      } catch (err) {
        alert(err.message || '取り込みに失敗しました。');
        duplicateBtn.disabled = false;
      }
      return;
    }

    const btn = event.target.closest('[data-delete-template]');
    if (!btn) return;
    const id = btn.getAttribute('data-delete-template');
    if (!id) return;
    if (!window.confirm('このモデルPLANを削除します。よろしいですか？')) return;
    btn.disabled = true;
    try {
      const res = await fetch(`/users/my-menu/model-plans/${encodeURIComponent(id)}`, { method: 'DELETE' });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json.error || '削除に失敗しました。');
      window.location.reload();
    } catch (err) {
      alert(err.message || '削除に失敗しました。');
      btn.disabled = false;
    }
  });
  window.refreshLucideIcons && window.refreshLucideIcons();
</script>
