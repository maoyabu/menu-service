    const classSections = Array.from(document.querySelectorAll('[data-class-section]'));
    const placeSections = Array.from(document.querySelectorAll('[data-place-section]'));
    const placeGroups = Array.from(document.querySelectorAll('[data-place-group]'));
    function applyClassFilter(which){
      const target = ['ingredient','seasoning'].includes(which) ? which : 'all';
      filterButtons.forEach(btn=>{
        const isActive = (btn.dataset.filterTab || 'all') === target;
        btn.classList.toggle('bg-white', isActive);
        btn.classList.toggle('shadow', isActive);
        btn.classList.toggle('text-gray-900', isActive);
        btn.classList.toggle('text-gray-600', !isActive);
      });
      classSections.forEach(sec=>{
        if (!sec) return;
        if (target === 'all') {
          sec.classList.remove('hidden');
        } else {
          sec.classList.toggle('hidden', sec.getAttribute('data-class-section') !== target);
        }
      });
      placeSections.forEach(sec=>{
        if (!sec) return;
        if (target === 'all') {
          sec.classList.remove('hidden');
        } else {
          sec.classList.toggle('hidden', sec.getAttribute('data-place-section') !== target);
        }
      });
      placeGroups.forEach(group=>{
        if (!group) return;
        const hasIngredient = !!group.querySelector('[data-place-section="ingredient"]');
        const hasSeasoning = !!group.querySelector('[data-place-section="seasoning"]');
        let shouldShow = true;
        if (target === 'ingredient') {
          shouldShow = hasIngredient;
        } else if (target === 'seasoning') {
          shouldShow = hasSeasoning;
        } else {
          shouldShow = hasIngredient || hasSeasoning;
        }
        group.classList.toggle('hidden', !shouldShow);
      });
      try { localStorage.setItem(FILTER_KEY, target); } catch(_){ }
    }
    filterButtons.forEach(btn=>{
      if (btn.__msFilterBound) return;
      btn.__msFilterBound = true;
      btn.addEventListener('click', ()=>{
        applyClassFilter(btn.dataset.filterTab || 'all');
      });
    });
    (function(){
      let saved = 'all';
      try {
        const stored = localStorage.getItem(FILTER_KEY);
        if (stored && ['all','ingredient','seasoning'].includes(stored)) {
          saved = stored;
        }
      } catch(_){ }
      applyClassFilter(saved);
    })();
    // 既存ストックの編集用モーダル
    function buildEditModal(data){
      const modal=document.createElement('div'); modal.className='fixed inset-0 z-50 hidden overflow-y-auto';
      const name= data.name || ''; const cls=data.class || '';
      modal.innerHTML=`
        <div class=\"absolute inset-0 bg-black/40\" data-close></div>
        <div class=\"relative mx-auto mt-10 w-full max-w-3xl rounded-xl bg-white shadow-xl\">\n          <div class=\"flex items-center justify-between border-b px-5 py-3\">\n            <h3 class=\"font-semibold\">ストック編集</h3>\n            <button type=\"button\" data-close class=\"text-gray-500\">✕</button>\n          </div>\n          <div class=\"p-4 space-y-3\">\n            <div class=\"grid grid-cols-3 gap-3 border rounded bg-blue-50 p-3\">\n              <div class=\"col-span-3 space-y-2\">\n                <div class=\"rounded border border-blue-200 bg-blue-100 px-3 py-2 text-sm font-semibold text-blue-900 flex flex-wrap gap-2\">\n                  <span>対象: ${name}</span>\n                  <span class=\"text-xs font-normal text-blue-800\">${cls}</span>\n                </div>\n                <div>\n                  <label class=\"text-xs text-gray-500\">ストックの補足（任意）</label>\n                  <input data-x=\"comment\" class=\"w-full border rounded px-2 py-1\" placeholder=\"メモなど\">\n                </div>\n              </div>\n              <div><label class=\"text-xs text-gray-500\">数量</label><input data-x=\"amount\" type=\"number\" step=\"0.1\" min=\"0\" class=\"w-full border rounded px-2 py-1\" value=\"${data.amount||''}\"></div>\n              <div><label class=\"text-xs text-gray-500\">単位</label><input data-x=\"unit\" list=\"editUnitList\" class=\"w-full border rounded px-2 py-1\" value=\"${data.unit||''}\"></div>\n              <div><label class=\"text-xs text-gray-500\">保管場所</label><select data-x=\"place\" class=\"w-full border rounded px-2 py-1\"><option value=\"\">選択してください</option></select><button type=\"button\" data-x=\"placeAdd\" class=\"ml-2 text-xs text-emerald-700 underline\">新規追加</button></div>\n              <div class=\"col-span-3 space-y-1\">\n                <label class=\"text-xs text-gray-500\">商品URL（任意）</label>\n                <div class=\"flex flex-col gap-3 md:flex-row md:items-start\">\n                  <div class=\"flex-1 min-w-0 space-y-1\">\n                    <input data-x=\"productUrl\" type=\"url\" class=\"w-full border rounded px-2 py-1\" placeholder=\"例: https://www.amazon.co.jp/...\">\n                    <div class=\"text-[11px] text-gray-500\">\n                      画像URL：\n                      <span data-role=\"image-url-text\" class=\"break-all\">未取得</span>\n                    </div>\n                    <input data-x=\"productImageManual\" type=\"url\" class=\"w-full border rounded px-2 py-1 text-xs\" placeholder=\"画像URLを直接入力（任意）\">\n                    <p class=\"text-[11px] text-gray-400\">取得できない場合はこちらに入力してください</p>\n                  </div>\n                  <div class=\"w-full md:w-28\">\n                    <div class=\"border border-dashed border-gray-300 rounded bg-white h-28 flex items-center justify-center overflow-hidden\">\n                      <img data-role=\"image-preview\" class=\"max-w-full max-h-full object-contain hidden\" alt=\"商品画像\">\n                      <span data-role=\"image-placeholder\" class=\"text-[11px] text-gray-400\">プレビュー</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div class=\"col-span-3\">\n                <label class=\"inline-flex items-center gap-2 text-xs text-gray-700\">\n                  <input type=\"checkbox\" data-x=\"stockpile\" class=\"rounded\">\n                  備蓄\n                </label>\n              </div>\n              <div class=\"col-span-3\">\n                <label class=\"text-xs text-gray-500\">賞味期限</label>\n                <input data-x=\"exp\" type=\"date\" class=\"w-full border rounded px-2 py-1\" value=\"${data.exp||''}\">\n              </div>\n            </div>\n            <datalist id=\"editUnitList\"></datalist>\n            <div class=\"flex items-center justify-between pt-2\">\n              <button type=\"button\" data-x=\"delete\" class=\"px-3 py-1.5 rounded bg-red-600 text-white text-sm\">削除</button>\n              <div class=\"space-x-2\">\n                <button type=\"button\" data-close class=\"px-3 py-1.5 rounded border\">キャンセル</button>\n                <button type=\"button\" data-x=\"save\" class=\"px-4 py-1.5 rounded bg-blue-600 text-white text-sm\">保存</button>\n              </div>\n            </div>\n          </div>\n        </div>`;
      document.body.appendChild(modal);
      const productUrlInputEdit = modal.querySelector('[data-x="productUrl"]');
      const manualImageInputEdit = modal.querySelector('[data-x="productImageManual"]');
      const imageUrlTextEdit = modal.querySelector('[data-role="image-url-text"]');
      const imagePreviewEdit = modal.querySelector('[data-role="image-preview"]');
      const imagePlaceholderEdit = modal.querySelector('[data-role="image-placeholder"]');
      let cachedImageUrlEdit = data.img || '';
      let imageFetchTimer = null;
      let imageFetchId = 0;
      let manualOverrideEdit = false;
      const updateImagePreviewEdit = (url, fallback, opts = {}) => {
        cachedImageUrlEdit = url || '';
        if (imageUrlTextEdit) imageUrlTextEdit.textContent = url ? url : (fallback || '未取得');
        if (imagePreviewEdit) {
          if (url) {
            imagePreviewEdit.src = url;
            imagePreviewEdit.classList.remove('hidden');
          } else {
            imagePreviewEdit.src = '';
            imagePreviewEdit.classList.add('hidden');
          }
        }
        if (imagePlaceholderEdit) imagePlaceholderEdit.classList.toggle('hidden', !!url);
        if (manualImageInputEdit && (!manualOverrideEdit || opts.forceManualSync)) {
          manualImageInputEdit.value = url || '';
        }
      };
      const fetchImageFromUrlEdit = async (value, runId) => {
        try {
          const res = await fetch('/users/my-stock/api/product-image?url=' + encodeURIComponent(value));
          if (!res.ok) throw new Error('failed');
          const payload = await res.json();
          if (runId !== imageFetchId) return;
          if (payload && payload.imageUrl) {
            updateImagePreviewEdit(payload.imageUrl);
          } else {
            updateImagePreviewEdit('', '取得できませんでした');
          }
        } catch (_) {
          if (runId !== imageFetchId) return;
          updateImagePreviewEdit('', '取得に失敗しました');
        }
      };
      const scheduleImageFetchEdit = (value) => {
        imageFetchId += 1;
        const runId = imageFetchId;
        clearTimeout(imageFetchTimer);
        if (!value) {
          updateImagePreviewEdit('', '未取得');
          return;
        }
        if (imageUrlTextEdit) imageUrlTextEdit.textContent = '読み込み中…';
        imageFetchTimer = setTimeout(()=> fetchImageFromUrlEdit(value, runId), 450);
      };
      if (productUrlInputEdit) {
        productUrlInputEdit.value = data.url || '';
        productUrlInputEdit.addEventListener('input', ()=>{
          const value = String(productUrlInputEdit.value || '').trim();
          manualOverrideEdit = false;
          scheduleImageFetchEdit(value);
        });
      }
      if (manualImageInputEdit) {
        if (data.img) {
          manualImageInputEdit.value = data.img;
          manualOverrideEdit = true;
        }
        manualImageInputEdit.addEventListener('input', ()=>{
          const value = String(manualImageInputEdit.value || '').trim();
          manualOverrideEdit = !!value;
          if (value) {
            updateImagePreviewEdit(value, null, { forceManualSync: true });
          } else {
            updateImagePreviewEdit('', '未取得', { forceManualSync: true });
          }
        });
      }
      if (cachedImageUrlEdit) {
        updateImagePreviewEdit(cachedImageUrlEdit, '未取得', { forceManualSync: true });
      } else if ((data.url||'').trim()) {
        scheduleImageFetchEdit(String(data.url).trim());
      } else {
        updateImagePreviewEdit('', '未取得', { forceManualSync: true });
      }
      function close(){ modal.classList.add('hidden'); clearTimeout(imageFetchTimer); }
      modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });
      // 単位候補
      const units=(data.units||'').split(',').map(s=>s.trim()).filter(Boolean);
      const dl=modal.querySelector('#editUnitList'); dl.innerHTML=''; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; dl.appendChild(op); });
      // 保管場所候補
      (async()=>{ try{ const sel=modal.querySelector('[data-x="place"]'); const list= await (await fetch('/users/my-stock/api/places')).json(); sel.innerHTML='<option value="">選択してください</option>'; (list||[]).forEach(p=>{ const op=document.createElement('option'); op.value=p._id; op.textContent=p.name; sel.appendChild(op); }); sel.value = data.place || ''; }catch(_){}})();
      try {
        const cb = modal.querySelector('[data-x="stockpile"]');
        if (cb) cb.checked = !!data.stockpile;
        const cmt = data && (data.cmt || data.comment) ? (data.cmt || data.comment) : '';
        const commentInput = modal.querySelector('[data-x="comment"]');
        if (commentInput) commentInput.value = cmt;
      } catch(_){ }
      // 新規保管場所
      modal.querySelector('[data-x="placeAdd"]').addEventListener('click', async ()=>{ const name=prompt('保管場所名'); if(!name) return; const res=await fetch('/users/my-stock/api/places', { method:'POST', headers:{'Content-Type': 'application/json'}, body: JSON.stringify({ name }) }); if(res.ok){ const created=await res.json(); const sel=modal.querySelector('[data-x="place"]'); const op=document.createElement('option'); op.value=created._id; op.textContent=created.name; sel.appendChild(op); sel.value=created._id; } else { alert('追加に失敗しました'); }});
      // 削除
      modal.querySelector('[data-x="delete"]').addEventListener('click', async ()=>{ if(!confirm('削除しますか？')) return; const res=await fetch(`/users/my-stock/api/stocks/${data.id}`, { method:'DELETE' }); if(!res.ok){ alert('削除に失敗しました'); return; } location.reload(); });
      // 保存
      modal.querySelector('[data-x="save"]').addEventListener('click', async ()=>{ const payload={ amount: modal.querySelector('[data-x="amount"]').value, unit: modal.querySelector('[data-x="unit"]').value, placeId: modal.querySelector('[data-x="place"]').value || null, expiryDate: modal.querySelector('[data-x="exp"]').value || null, stockpile: !!modal.querySelector('[data-x="stockpile"]').checked, comment: (modal.querySelector('[data-x="comment"]').value||'').trim(), productUrl: (modal.querySelector('[data-x="productUrl"]').value||'').trim(), productImageUrl: cachedImageUrlEdit || '' }; const res=await fetch(`/users/my-stock/api/stocks/${data.id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) }); if(!res.ok){ alert('更新に失敗しました'); return; } location.reload(); });
      return { open: ()=> modal.classList.remove('hidden') };
    }
    // タグクリックで編集（全体）
    document.querySelectorAll('[data-stock-id]').forEach(el=>{
      el.addEventListener('click', (ev)=>{
        // 内側の編集/削除ボタンは個別ハンドラに委譲
        if (ev.target && (ev.target.hasAttribute('data-stock-edit') || ev.target.hasAttribute('data-stock-del'))) return;
        const data={ id: el.dataset.stockId, type: el.dataset.type, itemId: el.dataset.itemId, name: el.dataset.name||'', class: el.dataset.class||'', units: el.dataset.units||'', amount: el.dataset.amount||'', unit: el.dataset.unit||'', place: el.dataset.place||'', exp: el.dataset.exp||'', stockpile: el.dataset.sp==='1', cmt: el.dataset.cmt || '', url: el.dataset.url || '', img: el.dataset.img || '' };
        const edit = buildEditModal(data); edit.open();
      });
    });
    // 編集/削除ボタン（イベント委譲）
    document.addEventListener('click', async (e)=>{
      const editBtn = e.target.closest('[data-stock-edit]');
      if (editBtn) {
        e.stopPropagation();
        const host = editBtn.closest('[data-stock-id]');
        if (!host) return;
        const data={ id: host.dataset.stockId, type: host.dataset.type, itemId: host.dataset.itemId, name: host.dataset.name||'', class: host.dataset.class||'', units: host.dataset.units||'', amount: host.dataset.amount||'', unit: host.dataset.unit||'', place: host.dataset.place||'', exp: host.dataset.exp||'', stockpile: host.dataset.sp==='1', cmt: host.dataset.cmt || '', url: host.dataset.url || '', img: host.dataset.img || '' };
        const edit = buildEditModal(data); edit.open();
        return;
      }
      const delBtn = e.target.closest('[data-stock-del]');
      if (delBtn) {
        e.stopPropagation();
        const id = delBtn.getAttribute('data-stock-del');
        if (!id) return;
        if (!confirm('削除しますか？')) return;
        const res = await fetch(`/users/my-stock/api/stocks/${id}`, { method:'DELETE' });
        if (!res.ok) { alert('削除に失敗しました'); return; }
        location.reload();
      }
    });
  })();
</script>
