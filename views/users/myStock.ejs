<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">マイストック</h1>
      <p class="text-sm text-gray-500">自宅にストックしている食材・調味料を管理</p>
    </div>
    <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
      <button type="button" data-view-tab="class" class="px-4 py-1 rounded-full bg-white shadow text-gray-900">分類で見る</button>
      <button type="button" data-view-tab="place" class="px-4 py-1 rounded-full text-gray-600">保管場所で見る</button>
    </div>
  </header>

  <div class="flex items-center justify-end -mt-2">
    <a href="/users/my-stock/checklist" class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">
      <span class="lucide w-4 h-4" data-lucide="check-square"></span>
      マイストックチェックリスト
    </a>
  </div>

  <div class="flex items-center gap-2 text-sm">
    <span class="text-gray-600">表示:</span>
    <% const __onlySP = typeof onlyStockpile !== 'undefined' && onlyStockpile; %>
    <a href="/users/my-stock" class="px-3 py-1 rounded-full border <%= __onlySP ? '' : 'bg-white shadow' %>">全て</a>
    <a href="/users/my-stock?stockpile=true" class="px-3 py-1 rounded-full border <%= __onlySP ? 'bg-white shadow' : '' %>">備蓄のみ</a>
  </div>

  <div data-view="class" class="grid md:grid-cols-2 gap-6">
    <!-- 食材 -->
    <section class="rounded-2xl border bg-white">
      <div class="p-4 flex items-center justify-between">
        <h2 class="font-semibold">食材のストック</h2>
        <button type="button" id="addIng" class="px-3 py-1.5 rounded border bg-amber-50 border-amber-300 text-amber-800 text-sm">＋ 追加</button>
      </div>
      <div class="divide-y">
        <% Object.keys(grouped.ingredient || {}).forEach(function(cls){ const rows = grouped.ingredient[cls] || []; %>
          <details class="group" open>
            <summary class="cursor-pointer select-none px-4 py-2 flex items-center justify-between">
              <span class="font-medium"><%= cls %></span>
              <span class="text-xs text-gray-500"><%= rows.length %> 件</span>
            </summary>
            <div class="px-4 pb-3 pt-1 flex flex-wrap gap-2">
              <% rows.forEach(function(r){ const it = r.meta || {}; const s = r.stock || {}; var _p=((places||[]).find(function(p){return String(p._id)===String(s.place||'')})); const placeName=_p?_p.name:''; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
                <div class="w-48 border border-gray-200 rounded-lg bg-white px-3 py-2 text-sm shadow-sm cursor-pointer" data-stock-id="<%= s._id %>" data-type="ingredient" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.ingredient || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-medium text-gray-900 truncate"><%= it.ingredient || '' %></span>
                    <span class="inline-flex items-center gap-1 ml-2">
                      <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                      <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                    </span>
                  </div>
                  <div class="text-xs text-gray-600 mt-1">
                    <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                    <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                  </div>
                  <% if (s.comment) { %><div class="text-[11px] text-gray-500 mt-0.5 truncate"><%= s.comment %></div><% } %>
                </div>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>

    <!-- 調味料 -->
    <section class="rounded-2xl border bg-white">
      <div class="p-4 flex items-center justify-between">
        <h2 class="font-semibold">調味料のストック</h2>
        <button type="button" id="addSea" class="px-3 py-1.5 rounded border bg-amber-50 border-amber-300 text-amber-800 text-sm">＋ 追加</button>
      </div>
      <div class="divide-y">
        <% Object.keys(grouped.seasoning || {}).forEach(function(cls){ const rows = grouped.seasoning[cls] || []; %>
          <details class="group" open>
            <summary class="cursor-pointer select-none px-4 py-2 flex items-center justify-between">
              <span class="font-medium"><%= cls %></span>
              <span class="text-xs text-gray-500"><%= rows.length %> 件</span>
            </summary>
            <div class="px-4 pb-3 pt-1 flex flex-wrap gap-2">
              <% rows.forEach(function(r){ const it = r.meta || {}; const s = r.stock || {}; var _p=((places||[]).find(function(p){return String(p._id)===String(s.place||'')})); const placeName=_p?_p.name:''; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
                <div class="w-48 border border-gray-200 rounded-lg bg-white px-3 py-2 text-sm shadow-sm cursor-pointer" data-stock-id="<%= s._id %>" data-type="seasoning" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.seasoning || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-medium text-gray-900 truncate"><%= it.seasoning || '' %></span>
                    <span class="inline-flex items-center gap-1 ml-2">
                      <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                      <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                    </span>
                  </div>
                  <div class="text-xs text-gray-600 mt-1">
                    <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                    <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                  </div>
                  <% if (s.comment) { %><div class="text-[11px] text-gray-500 mt-0.5 truncate"><%= s.comment %></div><% } %>
                </div>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>
  </div>

  <div data-view="place" class="hidden space-y-6">
    <% const _pg = (typeof placeGrouped !== 'undefined' && placeGrouped) ? placeGrouped : {}; Object.keys(_pg).forEach(function(pname){ const sec=_pg[pname]||{}; %>
    <section class="rounded-2xl border bg-white">
      <div class="p-4 flex items-center justify-between">
        <h2 class="font-semibold"><%= pname %></h2>
        <span class="text-xs text-gray-500">食材 <%= (sec.ingredient||[]).length %> 件・調味料 <%= (sec.seasoning||[]).length %> 件</span>
      </div>
      <div class="px-4 pb-4 space-y-2">
        <% if ((sec.ingredient||[]).length){ %>
          <div class="text-xs text-gray-500 mb-1">食材</div>
          <div class="flex flex-wrap gap-2">
            <% (sec.ingredient||[]).forEach(function(r){ const it=r.meta||{}; const s=r.stock||{}; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
              <div class="w-48 border border-gray-200 rounded-lg bg-white px-3 py-2 text-sm shadow-sm cursor-pointer" data-stock-id="<%= s._id %>" data-type="ingredient" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.ingredient || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-medium text-gray-900 truncate"><%= it.ingredient || '' %></span>
                  <span class="inline-flex items-center gap-1 ml-2">
                    <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                    <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                  </span>
                </div>
                <div class="text-xs text-gray-600 mt-1">
                  <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                  <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                </div>
                <% if (s.comment) { %><div class="text-[11px] text-gray-500 mt-0.5 truncate"><%= s.comment %></div><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if ((sec.seasoning||[]).length){ %>
          <div class="text-xs text-gray-500 mt-3 mb-1">調味料</div>
          <div class="flex flex-wrap gap-2">
            <% (sec.seasoning||[]).forEach(function(r){ const it=r.meta||{}; const s=r.stock||{}; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
              <div class="w-48 border border-gray-200 rounded-lg bg-white px-3 py-2 text-sm shadow-sm cursor-pointer" data-stock-id="<%= s._id %>" data-type="seasoning" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.seasoning || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-medium text-gray-900 truncate"><%= it.seasoning || '' %></span>
                  <span class="inline-flex items-center gap-1 ml-2">
                    <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                    <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                  </span>
                </div>
                <div class="text-xs text-gray-600 mt-1">
                  <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                  <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                </div>
                <% if (s.comment) { %><div class="text-[11px] text-gray-500 mt-0.5 truncate"><%= s.comment %></div><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
    <% }) %>
  </div>
</section>

<script>
  // 追加モーダル（チップ＋タグ、オリジナル追加、場所/期限入力）
  (function(){
    function buildModal(type){
      const modal=document.createElement('div'); modal.className='fixed inset-0 z-50 hidden overflow-y-auto';
      modal.innerHTML=`
        <div class=\"absolute inset-0 bg-black/40\" data-close></div>
        <div class=\"relative mx-auto mt-10 w-[900px] max-w-[96vw] rounded-2xl bg-white shadow-xl\">\n          <div class=\"flex items-center justify-between border-b px-5 py-3\">\n            <h3 class=\"font-semibold\">${type==='ingredient'?'食材を追加':'調味料を追加'}</h3>\n            <button type=\"button\" data-close class=\"text-gray-500\">✕</button>\n          </div>\n          <div class=\"p-4 space-y-3\">\n            <div class=\"inline-flex p-1 bg-gray-100 rounded-full text-sm\">\n              <button data-tab=\"preset\" class=\"px-4 py-1 rounded-full bg-white shadow text-gray-900\">プリセットから選択</button>\n              <button data-tab=\"original\" class=\"px-4 py-1 rounded-full text-gray-600\">オリジナル追加</button>\n            </div>\n            <div data-view=\"preset\" class=\"space-y-3\">\n              <input data-role=\"kw\" placeholder=\"検索...\" class=\"w-full border rounded px-3 py-2\"/>\n              <div data-role=\"genres\" class=\"flex flex-wrap gap-2\"></div>\n              <div data-role=\"tags\" class=\"flex flex-wrap gap-2 max-h-[40vh] overflow-auto border rounded p-3 bg-green-50\"></div>\n              <div data-role=\"selected\" class=\"hidden border rounded p-3 bg-blue-50\"></div>\n            </div>\n            <div data-view=\"original\" class=\"hidden space-y-3\">\n              <div class=\"grid grid-cols-4 gap-3\">\n                <div class=\"col-span-2\"><label class=\"text-xs text-gray-500\">名前</label><input data-o=\"name\" class=\"w-full border rounded px-3 py-2\"></div>\n                <div><label class=\"text-xs text-gray-500\">カテゴリー</label><select data-o=\"cat\" class=\"w-full border rounded px-3 py-2\"><option value=\"\">選択してください</option></select></div>\n                <div><label class=\"text-xs text-gray-500\">単位</label><input data-o=\"units\" class=\"w-full border rounded px-3 py-2\" placeholder=\"g, ml, 本\"></div>\n              </div>\n              <div class=\"text-right\"><button data-role=\"create\" class=\"px-4 py-1.5 rounded bg-emerald-600 text-white text-sm\">作成して追加</button></div>\n            </div>\n            <div class=\"grid grid-cols-3 gap-3\">\n              <div><label class=\"text-xs text-gray-500\">数量</label><input data-x=\"amount\" type=\"number\" step=\"0.1\" min=\"0\" class=\"w-full border rounded px-3 py-2\"></div>\n              <div><label class=\"text-xs text-gray-500\">単位</label><input data-x=\"unit\" class=\"w-full border rounded px-3 py-2\"></div>\n              <div><label class=\"text-xs text-gray-500\">保管場所</label><select data-x=\"place\" class=\"w-full border rounded px-3 py-2\"><option value=\"\">選択してください</option></select><button type=\"button\" data-x=\"placeAdd\" class=\"ml-2 text-xs text-emerald-700 underline\">新規追加</button></div>\n              <div class=\"col-span-3 flex items-end justify-end gap-3\">\n                <div class=\"w-40\"><label class=\"text-xs text-gray-500\">賞味期限</label><input data-x=\"exp\" type=\"date\" class=\"w-full border rounded px-3 py-2\"></div>\n                <button type=\"button\" data-x=\"save\" class=\"px-4 py-1.5 rounded bg-blue-600 text-white text-sm\">ストックに追加</button>\n              </div>\n            </div>\n          </div>\n        </div>`;
      document.body.appendChild(modal);
      // Post-process: blue box styling, label, unit datalist, stockpile checkbox
      try {
        const gridBox = modal.querySelector('div.grid.grid-cols-3.gap-3');
        if (gridBox) gridBox.classList.add('border','rounded','bg-blue-50','p-3');
        const expInput = modal.querySelector('[data-x="exp"]');
        if (expInput && expInput.previousElementSibling && expInput.previousElementSibling.tagName === 'LABEL') {
          expInput.previousElementSibling.textContent = '賞味期限';
        }
        const unitInput = modal.querySelector('[data-x="unit"]');
        if (unitInput) unitInput.setAttribute('list','stockUnitList');
        if (!modal.querySelector('#stockUnitList')) {
          const dl = document.createElement('datalist'); dl.id = 'stockUnitList';
          const container = modal.querySelector('.p-4');
          if (container) container.appendChild(dl); else modal.appendChild(dl);
        }
        // Add stockpile checkbox into the controls row
        const controlsRow = modal.querySelector('div.col-span-3.flex.items-end.justify-end.gap-3');
        if (controlsRow && !modal.querySelector('[data-x="stockpile"]')){
          const lb=document.createElement('label'); lb.className='inline-flex items-center gap-1 mr-auto text-xs text-gray-700';
          const cb=document.createElement('input'); cb.type='checkbox'; cb.className='rounded'; cb.setAttribute('data-x','stockpile');
          lb.appendChild(cb); lb.appendChild(document.createTextNode(' 備蓄'));
          controlsRow.prepend(lb);
        }
        // Add comment input (full width) before expiry
        const expRow = modal.querySelector('[data-x="exp"]')?.closest('div');
        const grid = expRow && expRow.parentElement;
        if (grid && !modal.querySelector('[data-x="comment"]')){
          const wrap=document.createElement('div'); wrap.className='col-span-3';
          wrap.innerHTML='<label class="text-xs text-gray-500">コメント</label><input data-x="comment" class="w-full border rounded px-3 py-2" placeholder="メモなど">';
          grid.insertBefore(wrap, expRow);
        }
      } catch(_){ }
      function close(){ modal.classList.add('hidden'); }
      modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });
      const base= type==='ingredient'? '/users/my-menu/api/ingredients': '/users/my-menu/api/seasonings';
      async function fetchList(params){ const url=new URL(base, location.origin); Object.entries(params||{}).forEach(([k,v])=>{ if(v) url.searchParams.set(k,v); }); const res=await fetch(url.toString()); return res.json(); }
      async function buildGenres(){
        const holder=modal.querySelector('[data-role="genres"]');
        holder.innerHTML='';
        try {
          const meta=new URL(base, location.origin);
          meta.searchParams.set('meta','genres');
          const m=await (await fetch(meta.toString())).json();
          const cats=Array.isArray(m?.genres)? m.genres: [];
          // プルダウン（分類）
          const select=document.createElement('select');
          select.className='border rounded px-3 py-2';
          // ラベル「分類：」
          holder.className='flex items-center gap-2';
          const label=document.createElement('span');
          label.textContent='分類：';
          label.className='text-sm text-gray-700';
          const all=['すべて',...cats];
          all.forEach((label,idx)=>{
            const val=idx===0?'':label;
            const op=document.createElement('option');
            op.value=val;
            op.textContent=label;
            if(String(state.genre||'')===String(val||'')) op.selected=true;
            select.appendChild(op);
          });
          select.addEventListener('change', ()=>{ state.genre = select.value; run(); });
          holder.appendChild(label);
          holder.appendChild(select);

          // 保管場所プルダウン
          const placeSel=modal.querySelector('[data-x="place"]');
          if(placeSel){
            const list= await (await fetch('/users/my-stock/api/places')).json();
            placeSel.innerHTML='<option value="">選択してください</option>';
            (list||[]).forEach(p=>{ const op=document.createElement('option'); op.value=p._id; op.textContent=p.name; placeSel.appendChild(op); });
          }
          // オリジナル追加のカテゴリー候補
          const catSel=modal.querySelector('[data-o="cat"]');
          if(catSel){ catSel.innerHTML='<option value="">選択してください</option>'; cats.forEach(c=>{ const op=document.createElement('option'); op.value=c; op.textContent=c; catSel.appendChild(op); }); }
        }catch(_){}
      }
      function renderTags(data){ const tags=modal.querySelector('[data-role="tags"]'); const selected=modal.querySelector('[data-role="selected"]'); const unitDL = modal.querySelector('#stockUnitList'); if(unitDL) unitDL.innerHTML=''; tags.innerHTML=''; selected.classList.add('hidden'); selected.innerHTML=''; (data||[]).forEach(it=>{ const name=it.ingredient||it.seasoning||''; const units=Array.isArray(it.unit)? it.unit: (it.unit?[it.unit]:[]); const b=document.createElement('button'); b.type='button'; b.className='px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200'; b.textContent=name; b.addEventListener('click', ()=>{ state.selectedId=String(it._id); selected.classList.remove('hidden'); selected.innerHTML=`<div class=\"text-sm\"><span class=\"font-semibold\">選択:</span> ${name} <span class=\"text-xs text-gray-600\">${it.classification||''}</span></div>`; const box=modal.querySelector('div.grid.grid-cols-3'); if(box) box.classList.remove('hidden'); if(unitDL){ unitDL.innerHTML=''; (units||[]).forEach(u=>{ const op=document.createElement('option'); op.value=u; unitDL.appendChild(op); }); } }); tags.appendChild(b); }); }
      let __reqSeq = 0;
      async function run(){
        const mySeq = ++__reqSeq;
        const kw=modal.querySelector('[data-role="kw"]').value.trim();
        const data=await fetchList({ keyword: kw, genre: state.genre });
        if (mySeq !== __reqSeq) return;
        renderTags(data);
      }
      const state={ genre:'', selectedId: null };
      modal.querySelector('[data-role="kw"]').addEventListener('input', ()=>run());
      modal.querySelector('[data-x="placeAdd"]').addEventListener('click', async ()=>{
        const name=prompt('保管場所名');
        if(!name) return;
        const res=await fetch('/users/my-stock/api/places', { method:'POST', headers:{'Content-Type': 'application/json'}, body: JSON.stringify({ name }) });
        if(res.ok){
          const created = await res.json();
          const sel = modal.querySelector('[data-x="place"]');
          if (sel) {
            const op=document.createElement('option'); op.value=created._id; op.textContent=created.name; sel.appendChild(op); sel.value=created._id;
          }
        } else { alert('追加に失敗しました'); }
      });
      // 保存（ブルー枠の値を使用）
      modal.addEventListener('click', async (e)=>{
        if (e.target && (e.target.matches('[data-x="save"]') || e.target.matches('[data-x="save-bottom"]'))) {
          if (!state.selectedId) { alert('先にストックする品目を選択してください'); return; }
          const payload = {
            type,
            id: state.selectedId,
            amount: modal.querySelector('[data-x="amount"]').value,
            unit: modal.querySelector('[data-x="unit"]').value,
            placeId: modal.querySelector('[data-x="place"]').value || null,
            expiryDate: modal.querySelector('[data-x="exp"]').value || null,
            stockpile: !!modal.querySelector('[data-x="stockpile"]')?.checked,
            comment: (modal.querySelector('[data-x="comment"]')?.value || '').trim()
          };
          const res = await fetch('/users/my-stock/api/stocks', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
          if (!res.ok) { alert('登録に失敗しました'); return; }
          location.reload();
        }
      });
      buildGenres(); run();
      // tabs
      const preset=modal.querySelector('[data-view="preset"]'); const original=modal.querySelector('[data-view="original"]'); const tabP=modal.querySelector('[data-tab="preset"]'); const tabO=modal.querySelector('[data-tab="original"]');
      function switchTab(tab){ if(tab==='preset'){ tabP.classList.add('bg-white','shadow','text-gray-900'); tabO.classList.remove('bg-white','shadow','text-gray-900'); preset.classList.remove('hidden'); original.classList.add('hidden'); } else { tabO.classList.add('bg-white','shadow','text-gray-900'); tabP.classList.remove('bg-white','shadow','text-gray-900'); original.classList.remove('hidden'); preset.classList.add('hidden'); } const box=modal.querySelector('div.grid.grid-cols-3'); if(box){ if(tab==='original' && !state.selectedId){ box.classList.add('hidden'); } else { box.classList.remove('hidden'); } } }
      tabP.addEventListener('click', ()=>switchTab('preset')); tabO.addEventListener('click', ()=>switchTab('original'));
      modal.querySelector('[data-role="create"]').addEventListener('click', async ()=>{
        const name=modal.querySelector('[data-o="name"]').value.trim();
        const cat=modal.querySelector('[data-o="cat"]').value.trim();
        const units=modal.querySelector('[data-o="units"]').value.trim();
        if(!name){ alert('名前を入力してください'); return;}
        const endpoint = type==='ingredient' ? '/users/my-menu/api/ingredients/custom' : '/users/my-menu/api/seasonings/custom';
        const res=await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name, classification: cat, units }) });
        if(!res.ok){ alert('作成に失敗しました'); return; }
        const created = await res.json();
        // 直後のフロー: 追加したアイテムを選択済みにし、ストック入力へ
        switchTab('preset');
        state.selectedId = String(created._id);
        const selected=modal.querySelector('[data-role="selected"]');
        const unitDL = modal.querySelector('#stockUnitList');
        if (selected){
          selected.classList.remove('hidden');
          const label = created.ingredient || created.seasoning || name;
          const cls = created.classification || '';
          selected.innerHTML = `<div class=\"text-sm\"><span class=\"font-semibold\">選択:</span> ${label} <span class=\"text-xs text-gray-600\">${cls}</span></div>`;
        }
        if (unitDL){ unitDL.innerHTML=''; (Array.isArray(created.unit)?created.unit:(created.unit?[created.unit]:[])).forEach(u=>{ const op=document.createElement('option'); op.value=u; unitDL.appendChild(op); }); }
        const box=modal.querySelector('div.grid.grid-cols-3'); if(box) box.classList.remove('hidden');
        const amountEl = modal.querySelector('[data-x="amount"]');
        if (amountEl){ amountEl.focus(); amountEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
      });
      return { open: ()=> modal.classList.remove('hidden') };
    }
    const addIng = buildModal('ingredient'); const addSea = buildModal('seasoning');
    document.getElementById('addIng')?.addEventListener('click', ()=>addIng.open());
    document.getElementById('addSea')?.addEventListener('click', ()=>addSea.open());
    // View toggle
    const tabClass = document.querySelector('[data-view-tab="class"]');
    const tabPlace = document.querySelector('[data-view-tab="place"]');
    const viewClass = document.querySelector('[data-view="class"]');
    const viewPlace = document.querySelector('[data-view="place"]');
    function switchView(which){
      if (which==='place'){
        tabPlace.classList.add('bg-white','shadow','text-gray-900');
        tabClass.classList.remove('bg-white','shadow','text-gray-900');
        viewPlace.classList.remove('hidden'); viewClass.classList.add('hidden');
      } else {
        tabClass.classList.add('bg-white','shadow','text-gray-900');
        tabPlace.classList.remove('bg-white','shadow','text-gray-900');
        viewClass.classList.remove('hidden'); viewPlace.classList.add('hidden');
      }
    }
    tabClass?.addEventListener('click', ()=>switchView('class'));
    tabPlace?.addEventListener('click', ()=>switchView('place'));
    // 既存ストックの編集用モーダル
    function buildEditModal(data){
      const modal=document.createElement('div'); modal.className='fixed inset-0 z-50 hidden overflow-y-auto';
      const name= data.name || ''; const cls=data.class || '';
      modal.innerHTML=`
        <div class=\"absolute inset-0 bg-black/40\" data-close></div>
        <div class=\"relative mx-auto mt-10 w-[700px] max-w-[96vw] rounded-2xl bg-white shadow-xl\">\n          <div class=\"flex items-center justify-between border-b px-5 py-3\">\n            <h3 class=\"font-semibold\">ストック編集</h3>\n            <button type=\"button\" data-close class=\"text-gray-500\">✕</button>\n          </div>\n          <div class=\"p-4 space-y-3\">\n            <div class=\"text-sm\"><span class=\"font-semibold\">対象:</span> ${name} <span class=\"text-xs text-gray-600\">${cls}</span></div>\n            <div class=\"grid grid-cols-3 gap-3 border rounded bg-blue-50 p-3\">\n              <div><label class=\"text-xs text-gray-500\">数量</label><input data-x=\"amount\" type=\"number\" step=\"0.1\" min=\"0\" class=\"w-full border rounded px-3 py-2\" value=\"${data.amount||''}\"></div>\n              <div><label class=\"text-xs text-gray-500\">単位</label><input data-x=\"unit\" list=\"editUnitList\" class=\"w-full border rounded px-3 py-2\" value=\"${data.unit||''}\"></div>\n              <div><label class=\"text-xs text-gray-500\">保管場所</label><select data-x=\"place\" class=\"w-full border rounded px-3 py-2\"><option value=\"\">選択してください</option></select><button type=\"button\" data-x=\"placeAdd\" class=\"ml-2 text-xs text-emerald-700 underline\">新規追加</button></div>\n              <div class=\"col-span-3\"><label class=\"text-xs text-gray-500\">賞味期限</label><input data-x=\"exp\" type=\"date\" class=\"w-full border rounded px-3 py-2\" value=\"${data.exp||''}\"></div>\n            </div>\n            <datalist id=\"editUnitList\"></datalist>\n            <div class=\"flex items-center justify-between pt-2\">\n              <button type=\"button\" data-x=\"delete\" class=\"px-3 py-1.5 rounded bg-red-600 text-white text-sm\">削除</button>\n              <div class=\"space-x-2\">\n                <button type=\"button\" data-close class=\"px-3 py-1.5 rounded border\">キャンセル</button>\n                <button type=\"button\" data-x=\"save\" class=\"px-4 py-1.5 rounded bg-blue-600 text-white text-sm\">保存</button>\n              </div>\n            </div>\n          </div>\n        </div>`;
      document.body.appendChild(modal);
      function close(){ modal.classList.add('hidden'); }
      modal.addEventListener('click', (e)=>{ if (e.target.hasAttribute('data-close')) close(); });
      // 単位候補
      const units=(data.units||'').split(',').map(s=>s.trim()).filter(Boolean);
      const dl=modal.querySelector('#editUnitList'); dl.innerHTML=''; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; dl.appendChild(op); });
      // 保管場所候補
      (async()=>{ try{ const sel=modal.querySelector('[data-x="place"]'); const list= await (await fetch('/users/my-stock/api/places')).json(); sel.innerHTML='<option value="">選択してください</option>'; (list||[]).forEach(p=>{ const op=document.createElement('option'); op.value=p._id; op.textContent=p.name; sel.appendChild(op); }); sel.value = data.place || ''; }catch(_){}})();
      // Insert stockpile checkbox and comment before expiry row
      try {
        const expEl = modal.querySelector('[data-x="exp"]');
        const lastRow = expEl && expEl.closest('div');
        const grid = lastRow && lastRow.parentElement;
        if (grid && lastRow){
          const holder=document.createElement('div');
          const lb=document.createElement('label'); lb.className='inline-flex items-center gap-1 text-xs text-gray-700';
          const cb=document.createElement('input'); cb.type='checkbox'; cb.className='rounded'; cb.setAttribute('data-x','stockpile'); if (data && data.stockpile) cb.checked=true;
          lb.appendChild(cb); lb.appendChild(document.createTextNode(' 備蓄'));
          grid.insertBefore(holder, lastRow); holder.appendChild(lb);
          const wrap=document.createElement('div'); wrap.className='col-span-3';
          wrap.innerHTML = '<label class="text-xs text-gray-500">コメント</label><input data-x="comment" class="w-full border rounded px-3 py-2">';
          grid.insertBefore(wrap, lastRow);
          const cmt = data && (data.cmt || data.comment) ? (data.cmt || data.comment) : '';
          modal.querySelector('[data-x="comment"]').value = cmt;
        }
      } catch(_){ }
      // 新規保管場所
      modal.querySelector('[data-x="placeAdd"]').addEventListener('click', async ()=>{ const name=prompt('保管場所名'); if(!name) return; const res=await fetch('/users/my-stock/api/places', { method:'POST', headers:{'Content-Type': 'application/json'}, body: JSON.stringify({ name }) }); if(res.ok){ const created=await res.json(); const sel=modal.querySelector('[data-x="place"]'); const op=document.createElement('option'); op.value=created._id; op.textContent=created.name; sel.appendChild(op); sel.value=created._id; } else { alert('追加に失敗しました'); }});
      // 削除
      modal.querySelector('[data-x="delete"]').addEventListener('click', async ()=>{ if(!confirm('削除しますか？')) return; const res=await fetch(`/users/my-stock/api/stocks/${data.id}`, { method:'DELETE' }); if(!res.ok){ alert('削除に失敗しました'); return; } location.reload(); });
      // 保存
      modal.querySelector('[data-x="save"]').addEventListener('click', async ()=>{ const payload={ amount: modal.querySelector('[data-x="amount"]').value, unit: modal.querySelector('[data-x="unit"]').value, placeId: modal.querySelector('[data-x="place"]').value || null, expiryDate: modal.querySelector('[data-x="exp"]').value || null, stockpile: !!modal.querySelector('[data-x="stockpile"]').checked, comment: (modal.querySelector('[data-x="comment"]').value||'').trim() }; const res=await fetch(`/users/my-stock/api/stocks/${data.id}`, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) }); if(!res.ok){ alert('更新に失敗しました'); return; } location.reload(); });
      return { open: ()=> modal.classList.remove('hidden') };
    }
    // タグクリックで編集（全体）
    document.querySelectorAll('[data-stock-id]').forEach(el=>{
      el.addEventListener('click', (ev)=>{
        // 内側の編集/削除ボタンは個別ハンドラに委譲
        if (ev.target && (ev.target.hasAttribute('data-stock-edit') || ev.target.hasAttribute('data-stock-del'))) return;
        const data={ id: el.dataset.stockId, type: el.dataset.type, itemId: el.dataset.itemId, name: el.dataset.name||'', class: el.dataset.class||'', units: el.dataset.units||'', amount: el.dataset.amount||'', unit: el.dataset.unit||'', place: el.dataset.place||'', exp: el.dataset.exp||'', stockpile: el.dataset.sp==='1', cmt: el.dataset.cmt || '' };
        const edit = buildEditModal(data); edit.open();
      });
    });
    // 編集/削除ボタン（イベント委譲）
    document.addEventListener('click', async (e)=>{
      const editBtn = e.target.closest('[data-stock-edit]');
      if (editBtn) {
        e.stopPropagation();
        const host = editBtn.closest('[data-stock-id]');
        if (!host) return;
        const data={ id: host.dataset.stockId, type: host.dataset.type, itemId: host.dataset.itemId, name: host.dataset.name||'', class: host.dataset.class||'', units: host.dataset.units||'', amount: host.dataset.amount||'', unit: host.dataset.unit||'', place: host.dataset.place||'', exp: host.dataset.exp||'', stockpile: host.dataset.sp==='1', cmt: host.dataset.cmt || '' };
        const edit = buildEditModal(data); edit.open();
        return;
      }
      const delBtn = e.target.closest('[data-stock-del]');
      if (delBtn) {
        e.stopPropagation();
        const id = delBtn.getAttribute('data-stock-del');
        if (!id) return;
        if (!confirm('削除しますか？')) return;
        const res = await fetch(`/users/my-stock/api/stocks/${id}`, { method:'DELETE' });
        if (!res.ok) { alert('削除に失敗しました'); return; }
        location.reload();
      }
    });
  })();
</script>
