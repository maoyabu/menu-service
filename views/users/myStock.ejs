<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold">マイストック</h1>
      <p class="text-sm text-gray-500">自宅にストックしている食材・調味料を管理</p>
    </div>
  </header>

  <!-- View tabs + checklist action in one row (compact) -->
  <div class="mt-1 flex items-center justify-between flex-wrap gap-3">
    <div class="flex items-center gap-2 flex-wrap">
      <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
        <button type="button" data-view-tab="class" class="px-4 py-1 rounded-full bg-white shadow text-gray-900">分類で見る</button>
        <button type="button" data-view-tab="place" class="px-4 py-1 rounded-full text-gray-600">保管場所で見る</button>
      </div>
      <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
        <button type="button" data-filter-tab="all" class="px-3 py-1 rounded-full bg-white shadow text-gray-900">すべて</button>
        <button type="button" data-filter-tab="ingredient" class="px-3 py-1 rounded-full text-gray-600">食材のみ</button>
        <button type="button" data-filter-tab="seasoning" class="px-3 py-1 rounded-full text-gray-600">調味料のみ</button>
      </div>
      <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
        <% const __onlySP = typeof onlyStockpile !== 'undefined' && onlyStockpile; %>
        <a href="/users/my-stock" class="px-4 py-1 rounded-full <%= __onlySP ? 'text-gray-600' : 'bg-white shadow text-gray-900' %>">全て</a>
        <a href="/users/my-stock?stockpile=true" class="px-4 py-1 rounded-full <%= __onlySP ? 'bg-white shadow text-gray-900' : 'text-gray-600' %>">備蓄のみ</a>
      </div>
    </div>
    <a href="/users/my-stock/checklist" class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 whitespace-nowrap">
      <span class="lucide w-4 h-4" data-lucide="check-square"></span>
      <span class="whitespace-nowrap">棚卸しリスト</span>
    </a>
  </div>

  <div data-view="class" class="space-y-6">
    <!-- 食材 -->
    <section class="rounded-2xl border bg-white" data-class-section="ingredient">
      <div class="p-4 flex items-center justify-between">
        <h2 class="font-semibold">食材のストック</h2>
        <button type="button" id="addIng" data-action="add-ingredient" class="px-3 py-1.5 rounded border bg-amber-50 border-amber-300 text-amber-800 text-sm">＋ 追加</button>
      </div>
      <div class="divide-y">
        <% Object.keys(grouped.ingredient || {}).forEach(function(cls){ const rows = grouped.ingredient[cls] || []; %>
          <details class="group" open>
            <summary class="cursor-pointer select-none px-4 py-2 flex items-center justify-between">
              <span class="font-medium"><%= cls %></span>
              <span class="text-xs text-gray-500"><%= rows.length %> 件</span>
            </summary>
            <div class="px-4 pb-3 pt-1 grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
              <% rows.forEach(function(r){ const it = r.meta || {}; const s = r.stock || {}; var _p=((places||[]).find(function(p){return String(p._id)===String(s.place||'')})); const placeName=_p?_p.name:''; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
                <div class="border border-blue-300 rounded-lg bg-white px-3 py-2 text-sm shadow-sm flex flex-col h-full cursor-pointer" data-stock-id="<%= s._id %>" data-type="ingredient" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.ingredient || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>" data-url="<%- (s.productUrl || '').replace(/\"/g,'&quot;') %>" data-img="<%- (s.productImageUrl || '').replace(/\"/g,'&quot;') %>">
                  <div class="flex gap-3 flex-1">
                    <div class="w-16 h-16 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                      <% if (s.productImageUrl) { %>
                        <img src="<%= s.productImageUrl %>" alt="<%= it.ingredient || '' %>の画像" class="w-full h-full object-contain" loading="lazy">
                      <% } else { %>
                        <span class="text-[11px] text-gray-400">No Image</span>
                      <% } %>
                    </div>
                    <div class="flex-1 min-w-0 space-y-1">
                      <div class="flex items-start justify-between gap-2">
                        <p class="font-medium text-gray-900 truncate"><%= it.ingredient || '' %></p>
                        <span class="inline-flex items-center gap-1 ml-2">
                          <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                          <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                        </span>
                      </div>
                      <% if (s.comment) { %><div class="text-[11px] text-gray-500 truncate"><%= s.comment %></div><% } %>
                      <div class="text-xs text-gray-600">
                        <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                        <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                      </div>
                      <% if (placeName) { %><div class="text-[11px] text-gray-500 flex items-center gap-1"><span class="lucide w-3 h-3" data-lucide="map-pin"></span><span class="truncate">保管: <%= placeName %></span></div><% } %>
                    </div>
                  </div>
                  <% if (s.productUrl) { %>
                    <div class="pt-2 mt-auto">
                      <a href="<%= s.productUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-semibold">
                        <span class="lucide w-3.5 h-3.5" data-lucide="shopping-cart"></span>
                        購入
                      </a>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>

    <!-- 調味料 -->
    <section class="rounded-2xl border bg-white" data-class-section="seasoning">
      <div class="p-4 flex items-center justify-between">
        <h2 class="font-semibold">調味料のストック</h2>
        <button type="button" id="addSea" data-action="add-seasoning" class="px-3 py-1.5 rounded border bg-amber-50 border-amber-300 text-amber-800 text-sm">＋ 追加</button>
      </div>
      <div class="divide-y">
        <% Object.keys(grouped.seasoning || {}).forEach(function(cls){ const rows = grouped.seasoning[cls] || []; %>
          <details class="group" open>
            <summary class="cursor-pointer select-none px-4 py-2 flex items-center justify-between">
              <span class="font-medium"><%= cls %></span>
              <span class="text-xs text-gray-500"><%= rows.length %> 件</span>
            </summary>
            <div class="px-4 pb-3 pt-1 grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
              <% rows.forEach(function(r){ const it = r.meta || {}; const s = r.stock || {}; var _p=((places||[]).find(function(p){return String(p._id)===String(s.place||'')})); const placeName=_p?_p.name:''; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
                <div class="border border-blue-300 rounded-lg bg-white px-3 py-2 text-sm shadow-sm flex flex-col h-full cursor-pointer" data-stock-id="<%= s._id %>" data-type="seasoning" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.seasoning || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>" data-url="<%- (s.productUrl || '').replace(/\"/g,'&quot;') %>" data-img="<%- (s.productImageUrl || '').replace(/\"/g,'&quot;') %>">
                  <div class="flex gap-3 flex-1">
                    <div class="w-16 h-16 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                      <% if (s.productImageUrl) { %>
                        <img src="<%= s.productImageUrl %>" alt="<%= it.seasoning || '' %>の画像" class="w-full h-full object-contain" loading="lazy">
                      <% } else { %>
                        <span class="text-[11px] text-gray-400">No Image</span>
                      <% } %>
                    </div>
                    <div class="flex-1 min-w-0 space-y-1">
                      <div class="flex items-start justify-between gap-2">
                        <p class="font-medium text-gray-900 truncate"><%= it.seasoning || '' %></p>
                        <span class="inline-flex items-center gap-1 ml-2">
                          <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                          <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                        </span>
                      </div>
                      <% if (s.comment) { %><div class="text-[11px] text-gray-500 truncate"><%= s.comment %></div><% } %>
                      <div class="text-xs text-gray-600">
                        <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                        <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                      </div>
                      <% if (placeName) { %><div class="text-[11px] text-gray-500 flex items-center gap-1"><span class="lucide w-3 h-3" data-lucide="map-pin"></span><span class="truncate">保管: <%= placeName %></span></div><% } %>
                    </div>
                  </div>
                  <% if (s.productUrl) { %>
                    <div class="pt-2 mt-auto">
                      <a href="<%= s.productUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-semibold">
                        <span class="lucide w-3.5 h-3.5" data-lucide="shopping-cart"></span>
                        購入
                      </a>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>
  </div>

  <div data-view="place" class="hidden space-y-6">
    <% const _pg = (typeof placeGrouped !== 'undefined' && placeGrouped) ? placeGrouped : {}; Object.keys(_pg).forEach(function(pname){ const sec=_pg[pname]||{}; %>
    <section class="rounded-2xl border bg-white" data-place-group>
      <div class="p-4 flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h2 class="font-semibold"><%= pname %></h2>
          <span class="text-xs text-gray-500 block">食材 <%= (sec.ingredient||[]).length %> 件・調味料 <%= (sec.seasoning||[]).length %> 件</span>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" data-action="add-ingredient" class="px-3 py-1 rounded border bg-amber-50 border-amber-300 text-amber-800 text-xs">＋ 食材</button>
          <button type="button" data-action="add-seasoning" class="px-3 py-1 rounded border bg-amber-50 border-amber-300 text-amber-800 text-xs">＋ 調味料</button>
        </div>
      </div>
      <div class="px-4 pb-4 space-y-2">
        <% if ((sec.ingredient||[]).length){ %>
          <div data-place-section="ingredient" class="space-y-1">
            <div class="text-xs text-gray-500 mb-1">食材</div>
            <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            <% (sec.ingredient||[]).forEach(function(r){ const it=r.meta||{}; const s=r.stock||{}; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
              <div class="border border-blue-300 rounded-lg bg-white px-3 py-2 text-sm shadow-sm flex flex-col h-full cursor-pointer" data-stock-id="<%= s._id %>" data-type="ingredient" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.ingredient || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>" data-url="<%- (s.productUrl || '').replace(/\"/g,'&quot;') %>" data-img="<%- (s.productImageUrl || '').replace(/\"/g,'&quot;') %>">
                <div class="flex gap-3 flex-1">
                  <div class="w-16 h-16 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                    <% if (s.productImageUrl) { %>
                      <img src="<%= s.productImageUrl %>" alt="<%= it.ingredient || '' %>の画像" class="w-full h-full object-contain" loading="lazy">
                    <% } else { %>
                      <span class="text-[11px] text-gray-400">No Image</span>
                    <% } %>
                  </div>
                  <div class="flex-1 min-w-0 space-y-1">
                    <div class="flex items-start justify-between gap-2">
                      <p class="font-medium text-gray-900 truncate"><%= it.ingredient || '' %></p>
                      <span class="inline-flex items-center gap-1 ml-2">
                        <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                        <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                      </span>
                    </div>
                    <% if (s.comment) { %><div class="text-[11px] text-gray-500 truncate"><%= s.comment %></div><% } %>
                    <div class="text-xs text-gray-600">
                      <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                      <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                    </div>
                  </div>
                </div>
                <% if (s.productUrl) { %>
                  <div class="pt-2 mt-auto">
                    <a href="<%= s.productUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-semibold">
                      <span class="lucide w-3.5 h-3.5" data-lucide="shopping-cart"></span>
                      購入
                    </a>
                  </div>
                <% } %>
              </div>
            <% }) %>
            </div>
          </div>
        <% } %>
        <% if ((sec.seasoning||[]).length){ %>
          <div data-place-section="seasoning" class="space-y-1">
            <div class="text-xs text-gray-500 mt-3 mb-1">調味料</div>
            <div class="grid gap-3 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
              <% (sec.seasoning||[]).forEach(function(r){ const it=r.meta||{}; const s=r.stock||{}; const expStr = s.expiryDate ? (new Date(s.expiryDate)).toISOString().slice(0,10) : ''; %>
                <div class="border border-blue-300 rounded-lg bg-white px-3 py-2 text-sm shadow-sm flex flex-col h-full cursor-pointer" data-stock-id="<%= s._id %>" data-type="seasoning" data-item-id="<%= it._id %>" data-units="<%- Array.isArray(it.unit)? it.unit.join(',') : (it.unit || '') %>" data-name="<%- it.seasoning || '' %>" data-class="<%- it.classification || '' %>" data-amount="<%- s.amount || '' %>" data-unit="<%- s.unit || '' %>" data-place="<%- s.place || '' %>" data-exp="<%- expStr %>" data-sp="<%= s.stockpile ? '1':'0' %>" data-cmt="<%- s.comment || '' %>" data-url="<%- (s.productUrl || '').replace(/\"/g,'&quot;') %>" data-img="<%- (s.productImageUrl || '').replace(/\"/g,'&quot;') %>">
                  <div class="flex gap-3 flex-1">
                    <div class="w-16 h-16 rounded border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden">
                      <% if (s.productImageUrl) { %>
                        <img src="<%= s.productImageUrl %>" alt="<%= it.seasoning || '' %>の画像" class="w-full h-full object-contain" loading="lazy">
                      <% } else { %>
                        <span class="text-[11px] text-gray-400">No Image</span>
                      <% } %>
                    </div>
                    <div class="flex-1 min-w-0 space-y-1">
                      <div class="flex items-start justify-between gap-2">
                        <p class="font-medium text-gray-900 truncate"><%= it.seasoning || '' %></p>
                        <span class="inline-flex items-center gap-1 ml-2">
                          <button type="button" class="text-gray-600 hover:text-gray-800" data-stock-edit="<%= s._id %>" title="編集"><span class="lucide w-4 h-4" data-lucide="pencil"></span></button>
                          <button type="button" class="text-red-600 hover:text-red-700" data-stock-del="<%= s._id %>" title="削除"><span class="lucide w-4 h-4" data-lucide="trash-2"></span></button>
                        </span>
                      </div>
                      <% if (s.comment) { %><div class="text-[11px] text-gray-500 truncate"><%= s.comment %></div><% } %>
                      <div class="text-xs text-gray-600">
                        <% if (s.stockpile) { %><span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 mr-1 align-middle">備蓄</span><% } %>
                        <span class="align-middle"><%= s.amount || '' %><%= s.unit || '' %></span>
                      </div>
                    </div>
                  </div>
                  <% if (s.productUrl) { %>
                    <div class="pt-2 mt-auto">
                      <a href="<%= s.productUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-800 font-semibold">
                        <span class="lucide w-3.5 h-3.5" data-lucide="shopping-cart"></span>
                        購入
                      </a>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </section>
    <% }) %>
  </div>
</section>

<script>
  // 追加モーダル（チップ＋タグ、オリジナル追加、場所/期限入力）
  (function(){
    function buildModal(type){
      const modal=document.createElement('div'); modal.className='fixed inset-0 z-50 hidden overflow-y-auto';
      modal.innerHTML=`
        <div class=\"absolute inset-0 bg-black/40\" data-close></div>
        <div class=\"relative mx-auto mt-10 w-full max-w-3xl rounded-xl bg-white shadow-xl\">\n          <div class=\"flex items-center justify-between border-b px-5 py-3\">\n            <h3 class=\"font-semibold\">${type==='ingredient'?'食材を追加':'調味料を追加'}</h3>\n            <button type=\"button\" data-close class=\"text-gray-500\">✕</button>\n          </div>\n          <div class=\"p-4 space-y-3\">\n            <div class=\"inline-flex p-1 bg-gray-100 rounded-full text-sm\">\n              <button type=\"button\" data-tab=\"preset\" class=\"px-4 py-1 rounded-full bg-white shadow text-gray-900\">プリセットから選択</button>\n              <button type=\"button\" data-tab=\"original\" class=\"px-4 py-1 rounded-full text-gray-600\">オリジナル追加</button>\n            </div>\n            <div data-view=\"preset\" class=\"space-y-3\">\n              <input data-role=\"kw\" placeholder=\"検索...\" class=\"w-full border rounded px-2 py-1\"/>\n              <div data-role=\"genres\" class=\"flex flex-wrap gap-2\"></div>\n              <div data-role=\"tags\" class=\"flex flex-wrap gap-2 max-h-48 overflow-auto border rounded p-2.5 bg-green-50\"></div>\n            </div>\n            <div data-view=\"original\" class=\"hidden space-y-3\">\n              <div class=\"grid grid-cols-4 gap-3\">\n                <div class=\"col-span-2\"><label class=\"text-xs text-gray-500\">名前</label><input data-o=\"name\" class=\"w-full border rounded px-2 py-1\"></div>\n                <div><label class=\"text-xs text-gray-500\">カテゴリー</label><select data-o=\"cat\" class=\"w-full border rounded px-2 py-1\"><option value=\"\">選択してください</option></select></div>\n                <div><label class=\"text-xs text-gray-500\">単位</label><input data-o=\"units\" class=\"w-full border rounded px-2 py-1\" placeholder=\"g, ml, 本\"></div>\n              </div>\n              <div class=\"text-right\"><button data-role=\"create\" class=\"px-4 py-1.5 rounded bg-emerald-600 text-white text-sm\">作成して追加</button></div>\n            </div>\n            <div class=\"grid grid-cols-3 gap-3\">\n              <div class=\"col-span-3 space-y-2\">\n                <div data-role=\"selected\" class=\"hidden rounded border border-blue-200 bg-blue-100 px-3 py-2 text-sm font-semibold text-blue-900 flex flex-wrap gap-2\">\n                  <span data-role=\"selected-name\"></span>\n                  <span data-role=\"selected-class\" class=\"text-xs font-normal text-blue-800\"></span>\n                </div>\n                <div>\n                  <label class=\"text-xs text-gray-500\">ストックの補足（任意）</label>\n                  <input data-x=\"comment\" class=\"w-full border rounded px-2 py-1\" placeholder=\"メモなど\">\n                </div>\n              </div>\n              <div><label class=\"text-xs text-gray-500\">数量</label><input data-x=\"amount\" type=\"number\" step=\"0.1\" min=\"0\" class=\"w-full border rounded px-2 py-1\"></div>\n              <div><label class=\"text-xs text-gray-500\">単位</label><input data-x=\"unit\" class=\"w-full border rounded px-2 py-1\"></div>\n              <div><label class=\"text-xs text-gray-500\">保管場所</label><select data-x=\"place\" class=\"w-full border rounded px-2 py-1\"><option value=\"\">選択してください</option></select><button type=\"button\" data-x=\"placeAdd\" class=\"ml-2 text-xs text-emerald-700 underline\">新規追加</button></div>\n              <div class=\"col-span-3 space-y-1\">\n                <label class=\"text-xs text-gray-500\">商品URL（任意）</label>\n                <div class=\"flex flex-col gap-3 md:flex-row md:items-start\">\n                  <div class=\"flex-1 min-w-0 space-y-1\">\n                    <input data-x=\"productUrl\" type=\"url\" class=\"w-full border rounded px-2 py-1\" placeholder=\"例: https://www.amazon.co.jp/...\">\n                    <div class=\"text-[11px] text-gray-500\">\n                      画像URL：\n                      <span data-role=\"image-url-text\" class=\"break-all\">未取得</span>\n                    </div>\n                    <input data-x=\"productImageManual\" type=\"url\" class=\"w-full border rounded px-2 py-1 text-xs\" placeholder=\"画像URLを直接入力（任意）\">\n                    <p class=\"text-[11px] text-gray-400\">取得できない場合はこちらに画像URLを入力してください</p>\n                  </div>\n                  <div class=\"w-full md:w-28\">\n                    <div class=\"border border-dashed border-gray-300 rounded bg-white h-28 flex items-center justify-center overflow-hidden\">\n                      <img data-role=\"image-preview\" class=\"max-w-full max-h-full object-contain hidden\" alt=\"商品画像\">\n                      <span data-role=\"image-placeholder\" class=\"text-[11px] text-gray-400\">プレビュー</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div class=\"col-span-3\">\n                <label class=\"inline-flex items-center gap-2 text-xs text-gray-700\">\n                  <input type=\"checkbox\" data-x=\"stockpile\" class=\"rounded\">\n                  備蓄\n                </label>\n              </div>\n            <div class=\"grid grid-cols-3 gap-3 border rounded bg-blue-50 p-3\">
              <div class=\"col-span-3\">\n                <label class=\"text-xs text-gray-500\">賞味期限</label>\n                <input data-x=\"exp\" type=\"date\" class=\"w-full border rounded px-2 py-1\">\n              </div>\n            </div>\n            <div class=\"flex items-center justify-end gap-2 pt-3\">\n              <button type=\"button\" data-x=\"save\" class=\"px-4 py-1.5 rounded bg-blue-600 text-white text-sm\">ストックに追加</button>\n            </div>\n          </div>\n        </div>`;
      document.body.appendChild(modal);
