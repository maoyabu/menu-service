<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold">完了したイベント</h1>
      <p class="text-sm text-gray-600">復活や複製をして次のイベントに活用できます</p>
    </div>
    <div class="flex gap-2">
      <a href="/users/packing" class="px-3 py-1.5 rounded-lg border text-sm bg-white text-gray-800 hover:bg-gray-50">未完了の一覧へ戻る</a>
    </div>
  </header>

  <section class="border rounded-2xl bg-white p-4 space-y-3">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700 border border-gray-200">完了イベント一覧</span>
        <p class="text-xs text-gray-500">復活すると通常のイベント一覧に戻ります</p>
      </div>
    </div>
    <div id="completed-list" class="space-y-2"></div>
    <p id="completed-empty" class="text-sm text-gray-500">完了したイベントはまだありません。</p>
  </section>
</section>

<div id="duplicate-modal" class="hidden fixed inset-0 z-50 bg-black/30 items-start justify-center p-4">
  <div class="mt-16 w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">イベントを複製</h3>
      <button type="button" data-dup-close class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">新しいイベント名
      <input type="text" id="duplicate-name" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200" />
    </label>
    <p class="text-xs text-gray-500">収納や持ち物リストを複製して新しいイベントを作成します。</p>
    <div class="flex justify-end gap-2">
      <button type="button" data-dup-close class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="duplicate-confirm" class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">複製する</button>
    </div>
  </div>
</div>

<script>
  (function(){
    const events = <%- JSON.stringify(events || []) %>;
    const members = <%- JSON.stringify(members || []) %>;
    const completedList = document.getElementById('completed-list');
    const completedEmpty = document.getElementById('completed-empty');
    const duplicateModal = document.getElementById('duplicate-modal');
    const duplicateName = document.getElementById('duplicate-name');
    const duplicateConfirm = document.getElementById('duplicate-confirm');
    let duplicateTargetId = '';

    const memberNameById = new Map((members || []).map((m)=> [m.id, m.name]));

    function toast(msg){
      if (!msg) return;
      try {
        const el = document.createElement('div');
        el.textContent = msg;
        el.className = 'fixed bottom-4 right-4 bg-gray-900 text-white text-sm px-3 py-2 rounded shadow';
        document.body.appendChild(el);
        setTimeout(()=> el.remove(), 2000);
      } catch(_) { alert(msg); }
    }

    function formatDate(val){
      if (!val) return '';
      try{
        const d = new Date(val);
        if (Number.isNaN(d.getTime())) return '';
        return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      } catch(_){ return ''; }
    }

    function renderList(){
      if (!completedList) return;
      completedList.innerHTML = '';
      if (!events.length){
        completedEmpty?.classList.remove('hidden');
        return;
      }
      completedEmpty?.classList.add('hidden');
      events.forEach((ev)=>{
        const row = document.createElement('div');
        row.className = 'flex flex-col md:flex-row md:items-center md:justify-between gap-2 border rounded-xl px-3 py-3 bg-gray-50';
        const participants = (ev.participants || []).map((id)=> memberNameById.get(id) || '').filter(Boolean);
        const participantLabel = participants.length ? participants.join(', ') : '未設定';
        const completedDate = formatDate(ev.completedAt);
        row.innerHTML = `
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <p class="font-semibold text-gray-900">${ev.name}</p>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-gray-200 text-gray-700 text-[11px] border border-gray-300">参加 ${(ev.participants||[]).length} 人</span>
            </div>
            <p class="text-xs text-gray-600 break-words">メンバー: ${participantLabel}</p>
            <p class="text-xs text-gray-500">${completedDate ? `完了日: ${completedDate}` : '完了日: 不明'}</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="px-3 py-1.5 rounded-lg bg-green-600 text-white text-sm font-semibold hover:bg-green-700" data-duplicate="${ev.id}">複製して再利用</button>
            <button type="button" class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 text-sm hover:bg-blue-100" data-restore="${ev.id}">復活させる</button>
          </div>
        `;
        completedList.appendChild(row);
      });
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    function openDuplicateModal(id){
      const target = events.find((e)=> e.id === id);
      duplicateTargetId = id;
      if (duplicateName) duplicateName.value = target ? `${target.name}（再利用）` : '';
      duplicateModal?.classList.remove('hidden'); duplicateModal?.classList.add('flex');
      duplicateName?.focus();
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    function closeDuplicateModal(){
      duplicateTargetId = '';
      duplicateModal?.classList.add('hidden'); duplicateModal?.classList.remove('flex');
    }
    duplicateModal?.addEventListener('click', (ev)=> { if (ev.target === duplicateModal) closeDuplicateModal(); });
    duplicateModal?.querySelectorAll('[data-dup-close]')?.forEach((b)=> b.addEventListener('click', closeDuplicateModal));

    duplicateConfirm?.addEventListener('click', async ()=>{
      if (!duplicateTargetId) return;
      const name = (duplicateName?.value || '').trim();
      if (!name) { duplicateName?.focus(); return; }
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(duplicateTargetId)}/duplicate`, {
          method:'POST',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ name })
        });
        if (!res.ok) throw new Error('複製に失敗しました');
        const json = await res.json();
        toast('複製したイベントを開きます');
        window.location.href = `/users/packing/${encodeURIComponent(json.id)}`;
      }catch(e){ toast(e.message || '複製に失敗しました'); }
    });

    async function restoreEvent(id){
      try{
        const res = await fetch(`/users/packing/api/events/${encodeURIComponent(id)}`, {
          method:'PATCH',
          headers:{ 'Content-Type':'application/json' },
          body: JSON.stringify({ completed: false })
        });
        if (!res.ok) throw new Error('復活に失敗しました');
        const idx = events.findIndex((e)=> e.id === id);
        if (idx >= 0) events.splice(idx,1);
        renderList();
        toast('イベントを復活させました（通常の一覧に戻りました）');
      }catch(e){ toast(e.message || '復活に失敗しました'); }
    }

    completedList?.addEventListener('click', (ev)=>{
      const dupBtn = ev.target.closest('button[data-duplicate]');
      const restoreBtn = ev.target.closest('button[data-restore]');
      if (dupBtn){
        openDuplicateModal(dupBtn.dataset.duplicate);
      } else if (restoreBtn){
        restoreEvent(restoreBtn.dataset.restore);
      }
    });

    renderList();
  })();
</script>
