<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="space-y-2">
    <div class="text-xs text-gray-500 flex items-center gap-1">
      <a href="/users/packing" class="text-blue-600 hover:underline">トップ</a>
      <span>＞</span>
      <a href="/users/packing/<%= event.id %>" class="text-blue-600 hover:underline"><%= event.name || '' %> のパッキングプラン</a>
      <span>＞</span>
      <span class="text-gray-800">チェックリスト</span>
    </div>
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 class="text-2xl font-bold"><%= event.name || '' %> の持ち物チェックリスト</h1>
        <p class="text-sm text-gray-600">収納先を切り替えながらチェックできます</p>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="export-open" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 border border-emerald-700 shadow-sm">チェックリストをExcelで出力</button>
      </div>
    </div>
  </header>

  <div class="space-y-3">
    <div class="text-xs text-gray-500">収納先</div>
    <div id="storage-tabs" class="flex flex-wrap gap-2"></div>
  </div>

  <div id="category-block" class="space-y-2 hidden">
    <div class="text-xs text-gray-500">カテゴリー</div>
    <div id="category-filter" class="flex flex-wrap gap-2"></div>
  </div>

  <div id="storage-view" class="border rounded-2xl bg-white p-4 space-y-3 hidden">
    <div id="category-view" class="space-y-4"></div>
  </div>
  <p id="empty-text" class="text-sm text-gray-500">持ち物がありません。イベントページで収納に紐付けてください。</p>
</section>

<div id="export-modal" class="hidden fixed inset-0 z-50 bg-black/40 items-start justify-center p-4">
  <div class="mt-20 w-full max-w-sm bg-white rounded-2xl shadow-2xl border border-gray-200 p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">誰のパッキングプランを出力しますか？</h3>
      <button type="button" id="export-close" class="text-gray-500 hover:text-gray-700"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <label class="block text-sm">
      メンバー
      <select id="export-owner" class="mt-1 w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-200">
        <option value="all">共有</option>
        <% (members || []).forEach((m)=> { %>
          <option value="<%= m.id %>"><%= m.name %></option>
        <% }) %>
      </select>
    </label>
    <div class="flex justify-end gap-2 pt-2">
      <button type="button" id="export-cancel" class="px-3 py-1.5 rounded border text-sm">キャンセル</button>
      <button type="button" id="export-confirm" class="px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700">出力</button>
    </div>
  </div>
</div>

  <script>
  (function(){
    const eventId = <%- JSON.stringify(event.id || '') %>;
    const members = <%- JSON.stringify(members || []) %>;
    const storages = <%- JSON.stringify(storages || []) %>;
    const items = <%- JSON.stringify(items || []) %>;
    const tabs = document.getElementById('storage-tabs');
    const view = document.getElementById('storage-view');
    const categoryView = document.getElementById('category-view');
    const categoryBlock = document.getElementById('category-block');
    const categoryFilter = document.getElementById('category-filter');
    const emptyText = document.getElementById('empty-text');
    const emptyTextDefault = emptyText?.textContent || '';
    const exportOpen = document.getElementById('export-open');
    const exportModal = document.getElementById('export-modal');
    const exportOwner = document.getElementById('export-owner');
    const exportClose = document.getElementById('export-close');
    const exportCancel = document.getElementById('export-cancel');
    const exportConfirm = document.getElementById('export-confirm');
    let activeStorageId = storages[0]?.id || '';
    let activeCategories = new Set();
    const STORAGE_KEY = `packing:check:${eventId}:storage`;
    const CATEGORY_KEY = `packing:check:${eventId}:cats`;

    function toast(msg){ try{ const el=document.createElement('div'); el.textContent=msg; el.className='fixed bottom-4 right-4 bg-gray-900 text-white text-sm px-3 py-2 rounded shadow'; document.body.appendChild(el); setTimeout(()=> el.remove(),2000);}catch(_){alert(msg);} }

    const normalizeCategory = (cat) => {
      const trimmed = (cat || '').trim();
      return trimmed || '未分類';
    };

    function restoreActiveStorage(){
      try{
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved && storages.find((s)=> s.id === saved)) activeStorageId = saved;
      } catch(_) {}
    }
    function saveActiveStorage(id){
      try{ localStorage.setItem(STORAGE_KEY, id || ''); }catch(_) {}
    }
    function loadCategorySelection(storageId, available){
      try{
        const raw = localStorage.getItem(CATEGORY_KEY);
        if (!raw) return null;
        const map = JSON.parse(raw);
        const arr = Array.isArray(map?.[storageId]) ? map[storageId] : null;
        if (!arr) return null;
        return arr.filter((c)=> available.includes(c));
      } catch(_) { return null; }
    }
    function saveCategorySelection(storageId, set){
      try{
        const raw = localStorage.getItem(CATEGORY_KEY);
        const map = raw ? (JSON.parse(raw) || {}) : {};
        map[storageId] = Array.from(set || []);
        localStorage.setItem(CATEGORY_KEY, JSON.stringify(map));
      } catch(_) {}
    }

    function renderTabs(){
      if (!tabs) return;
      tabs.innerHTML = '';
      storages.forEach((s, idx)=>{
        const btn = document.createElement('button');
        const active = s.id === activeStorageId || (!activeStorageId && idx===0);
        if (active) activeStorageId = s.id;
        btn.type='button';
        btn.dataset.id = s.id;
        btn.className = 'px-3 py-1.5 rounded-full border text-sm ' + (active ? 'bg-blue-600 text-white border-blue-700 shadow' : 'bg-white text-gray-800 border-gray-300 hover:border-blue-300');
        btn.textContent = s.name;
        btn.addEventListener('click', ()=> {
          const changed = activeStorageId !== s.id;
          activeStorageId = s.id;
          saveActiveStorage(activeStorageId);
          renderTabs();
          renderCategoryFilter(changed);
          renderLists();
        });
        tabs.appendChild(btn);
      });
      saveActiveStorage(activeStorageId);
      renderCategoryFilter(true);
      renderLists();
    }

    function renderCategoryFilter(storageChanged){
      if (!categoryFilter || !categoryBlock) return;
      categoryFilter.innerHTML = '';
      const list = items.filter((it)=> (it.storageId || '') === activeStorageId);
      if (!list.length){
        categoryBlock.classList.add('hidden');
        activeCategories = new Set();
        return;
      }
      const categories = Array.from(new Set(list.map((it)=> normalizeCategory(it.category)))).sort((a,b)=> a.localeCompare(b,'ja'));
      if (!categories.length){
        categoryBlock.classList.add('hidden');
        activeCategories = new Set();
        return;
      }
      categoryBlock.classList.remove('hidden');
      if (storageChanged){
        const saved = loadCategorySelection(activeStorageId, categories);
        if (saved !== null) {
          activeCategories = new Set(saved);
        } else {
          activeCategories = new Set(categories);
        }
      } else {
        activeCategories = new Set([...activeCategories].filter((c)=> categories.includes(c)));
        if (!activeCategories.size) activeCategories = new Set(categories);
      }
      categories.forEach((cat)=>{
        const selected = activeCategories.has(cat);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.category = cat;
        btn.className = 'px-3 py-1.5 rounded-full border text-sm ' + (selected ? 'bg-blue-100 text-blue-800 border-blue-200' : 'bg-white text-gray-700 border-gray-300 hover:border-blue-300');
        btn.textContent = cat;
        btn.addEventListener('click', ()=>{
          if (activeCategories.has(cat)){
            activeCategories.delete(cat);
          } else {
            activeCategories.add(cat);
          }
          saveCategorySelection(activeStorageId, activeCategories);
          renderCategoryFilter(false);
          renderLists();
        });
        categoryFilter.appendChild(btn);
      });
    }

    function renderLists(){
      if (!categoryView) return;
      categoryView.innerHTML = '';
      if (!activeStorageId){
        view.classList.add('hidden');
        emptyText.textContent = emptyTextDefault;
        emptyText.classList.remove('hidden');
        return;
      }
      const list = items.filter((it)=> (it.storageId || '') === activeStorageId);
      if (!list.length){
        view.classList.add('hidden');
        emptyText.textContent = emptyTextDefault;
        emptyText.classList.remove('hidden');
        return;
      }
      const hasSelection = activeCategories.size > 0;
      const filtered = hasSelection ? list.filter((it)=> activeCategories.has(normalizeCategory(it.category))) : [];
      if (!hasSelection){
        view.classList.add('hidden');
        emptyText.textContent = 'カテゴリーを選択してください。';
        emptyText.classList.remove('hidden');
        return;
      }
      if (!filtered.length){
        view.classList.add('hidden');
        emptyText.textContent = '選択されたカテゴリーの持ち物がありません。カテゴリーを変更してください。';
        emptyText.classList.remove('hidden');
        return;
      }
      const grouped = {};
      filtered.forEach((it)=>{
        const cat = normalizeCategory(it.category);
        if (!grouped[cat]) grouped[cat] = { pending: [], done: [] };
        (it.checked ? grouped[cat].done : grouped[cat].pending).push(it);
      });
      const makeLi = (it, checked)=>{
        const li = document.createElement('li');
        li.className = 'flex items-start gap-3 border rounded-lg px-3 py-2 ' + (checked ? 'bg-green-50 border-green-200' : '');
        const checkedStr = it.checkedAt ? new Date(it.checkedAt).toLocaleString('ja-JP', { month:'numeric', day:'numeric', hour:'2-digit', minute:'2-digit' }) : '';
        li.innerHTML = `
          <label class="flex items-start gap-3 w-full">
            <input type="checkbox" data-id="${it.id}" ${checked ? 'checked' : ''} class="mt-1 rounded border-gray-300 text-green-600 focus:ring-green-500" />
            <div class="flex-1 min-w-0 space-y-0.5">
              <div class="flex items-center justify-between gap-2">
                <p class="font-semibold text-gray-900">${it.name}</p>
                <span class="text-xs text-gray-500">数量: ${it.quantity || 0} / 重量: ${it.weight || 0}g</span>
              </div>
              ${it.comment ? `<div class="text-xs text-gray-600">${it.comment}</div>` : ''}
              ${checked ? `<div class="text-[11px] text-green-700">チェック済み${checkedStr ? ' / ' + checkedStr : ''}${it.checkedBy ? ' / ' + it.checkedBy : ''}</div>` : ''}
            </div>
          </label>
        `;
        return li;
      };
      Object.keys(grouped).sort((a,b)=> a.localeCompare(b,'ja')).forEach((cat)=>{
        const { pending, done } = grouped[cat];
        const section = document.createElement('div');
        section.className = 'border rounded-xl p-3 space-y-3';
        const header = document.createElement('div');
        header.className = 'flex items-center justify-between';
        header.innerHTML = `<h3 class="text-sm font-semibold text-gray-800">${cat}</h3><span class="text-xs text-gray-500">未チェック ${pending.length} / チェック済み ${done.length}</span>`;
        section.appendChild(header);
        const grid = document.createElement('div');
        grid.className = 'grid md:grid-cols-2 gap-3';
        const pendingWrap = document.createElement('div');
        pendingWrap.innerHTML = '<p class="text-xs font-semibold text-gray-700 mb-1">チェックすべき</p>';
        const pendingUl = document.createElement('ul');
        pendingUl.className = 'space-y-2';
        if (!pending.length){
          const empty = document.createElement('div');
          empty.className = 'text-xs text-gray-500';
          empty.textContent = '未チェックのアイテムはありません。';
          pendingUl.appendChild(empty);
        } else {
          pending.forEach((it)=> pendingUl.appendChild(makeLi(it,false)));
        }
        pendingWrap.appendChild(pendingUl);
        const doneWrap = document.createElement('div');
        doneWrap.innerHTML = '<p class="text-xs font-semibold text-gray-700 mb-1">チェック済み</p>';
        const doneUl = document.createElement('ul');
        doneUl.className = 'space-y-2';
        if (!done.length){
          const empty = document.createElement('div');
          empty.className = 'text-xs text-gray-500';
          empty.textContent = 'チェック済みはありません。';
          doneUl.appendChild(empty);
        } else {
          done.forEach((it)=> doneUl.appendChild(makeLi(it,true)));
        }
        doneWrap.appendChild(doneUl);
        grid.appendChild(pendingWrap);
        grid.appendChild(doneWrap);
        section.appendChild(grid);
        categoryView.appendChild(section);
      });
      view.classList.remove('hidden');
      emptyText.classList.add('hidden');
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }

    view?.addEventListener('change', async (ev)=>{
      const cb = ev.target.closest('input[type="checkbox"][data-id]');
      if (!cb) return;
      const id = cb.dataset.id;
      const checked = cb.checked;
      try{
        const res = await fetch(`/users/packing/api/items/${encodeURIComponent(id)}/check`, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ checked }) });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json();
        const it = items.find((x)=> x.id === id);
        if (it){
          it.checked = json.checked;
          it.checkedAt = json.checkedAt;
          it.checkedBy = json.checkedBy;
        }
        renderLists();
      }catch(e){
        toast(e.message || '更新に失敗しました');
        cb.checked = !checked;
      }
    });

    function openExportModal(){
      exportModal?.classList.remove('hidden'); exportModal?.classList.add('flex');
      exportOwner?.focus();
      if (window.refreshLucideIcons) window.refreshLucideIcons();
    }
    function closeExportModal(){
      exportModal?.classList.add('hidden'); exportModal?.classList.remove('flex');
    }
    function downloadExcel(){
      const owner = exportOwner?.value || 'all';
      const url = `/users/packing/check/${encodeURIComponent(eventId)}.xlsx?owner=${encodeURIComponent(owner)}`;
      window.location.href = url;
      closeExportModal();
    }

    restoreActiveStorage();
    renderTabs();
    exportOpen?.addEventListener('click', openExportModal);
    exportClose?.addEventListener('click', closeExportModal);
    exportCancel?.addEventListener('click', closeExportModal);
    exportModal?.addEventListener('click', (ev)=> { if (ev.target === exportModal) closeExportModal(); });
    exportConfirm?.addEventListener('click', downloadExcel);
  })();
</script>
