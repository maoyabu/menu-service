<style>
  .stock-hero-wrapper {
    position: relative;
    width: 100%;
    margin: 0 0 1.25rem;
    border-radius: 18px;
    overflow: hidden;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    min-height: 48px;
  }
  .stock-hero-image {
    display: block;
    width: 100%;
    height: auto;
  }
  .stock-hero-controls {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .stock-hero-toggle,
  .stock-hero-switch {
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #e2e8f0;
    color: #1f2937;
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }
  .stock-hero-switch {
    background: #e6f4ea;
    border-color: #cce6d4;
    color: #2f6b46;
  }
  .stock-hero-toggle:hover,
  .stock-hero-switch:hover {
    background: #ffffff;
  }
  .stock-hero-wrapper.is-hidden .stock-hero-image {
    display: none;
  }
</style>

<section class="max-w-5xl mx-auto py-8 space-y-8">
  <div class="stock-hero-wrapper" data-stock-hero>
    <div class="stock-hero-controls">
      <button type="button" class="stock-hero-toggle" data-stock-hero-toggle aria-pressed="true">非表示</button>
      <button type="button" class="stock-hero-switch" data-stock-hero-switch>備品管理とは</button>
    </div>
    <img src="/pict/mystock.jpg" alt="ストック管理とは" class="stock-hero-image" data-stock-hero-image>
  </div>

  <header class="space-y-2">
    <p class="text-xs font-semibold tracking-wide text-emerald-600">STOCK MANAGEMENT</p>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900">ストック管理トップ</h1>
    <p class="text-sm text-gray-600">
      <%= currentGroupName ? `${currentGroupName}の在庫と備品をまとめて管理します。` : '在庫と備品をまとめて管理します。' %>
    </p>
  </header>

  <div class="grid gap-4 md:grid-cols-3">
    <a href="/users/my-stock" class="block rounded-2xl border border-emerald-100 bg-emerald-50 p-5 shadow-sm hover:bg-emerald-100 transition">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-emerald-900">食材・調味料管理</h2>
        <span class="text-xs font-semibold text-emerald-700 bg-white/70 border border-emerald-200 rounded-full px-2 py-0.5">開く</span>
      </div>
      <div class="mt-3 flex flex-wrap gap-2 text-sm">
        <span class="inline-flex items-center gap-1 rounded-full bg-white/80 text-emerald-800 px-3 py-1">
          食材: <span class="font-semibold"><%= (mystockCounts && mystockCounts.ingredient) || 0 %></span> 件
        </span>
        <span class="inline-flex items-center gap-1 rounded-full bg-white/80 text-emerald-800 px-3 py-1">
          調味料: <span class="font-semibold"><%= (mystockCounts && mystockCounts.seasoning) || 0 %></span> 件
        </span>
      </div>
      <div class="mt-3 rounded-xl border border-emerald-100 bg-white px-3 py-2 text-xs text-emerald-900">
        <% if (myStockInventorySummary && myStockInventorySummary.currentLabel) { %>
          <div class="flex flex-wrap items-center gap-2">
            <span>現在の棚卸し: <span class="font-semibold"><%= myStockInventorySummary.currentLabel %>度</span></span>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold <%= myStockInventorySummary.statusLabel === '完了' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-800' %>">
              <%= myStockInventorySummary.statusLabel %>
            </span>
          </div>
          <p class="text-[11px] text-emerald-700 mt-1">次回の棚卸し: <%= myStockInventorySummary.nextLabel %></p>
        <% } else { %>
          <p class="text-[11px] text-emerald-700">棚卸し設定がありません。</p>
        <% } %>
      </div>
    </a>

    <a href="/users/my-equipment" class="block rounded-2xl border border-amber-100 bg-amber-50 p-5 shadow-sm hover:bg-amber-100 transition">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-amber-900">備品管理</h2>
        <span class="text-xs font-semibold text-amber-700 bg-white/70 border border-amber-200 rounded-full px-2 py-0.5">開く</span>
      </div>
      <div class="mt-3 text-sm text-amber-900">
        備品の登録点数: <span class="font-semibold"><%= (myEquipmentSummary && myEquipmentSummary.count) || 0 %></span> 件
      </div>
      <div class="mt-3 rounded-xl border border-amber-100 bg-white px-3 py-2 text-xs text-amber-900">
        <% if (myEquipmentSummary && myEquipmentSummary.currentLabel) { %>
          <div class="flex flex-wrap items-center gap-2">
            <span>現在の棚卸し: <span class="font-semibold"><%= myEquipmentSummary.currentLabel %>度</span></span>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold <%= myEquipmentSummary.statusLabel === '完了' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-800' %>">
              <%= myEquipmentSummary.statusLabel %>
            </span>
          </div>
          <p class="text-[11px] text-amber-700 mt-1">次回の棚卸し: <%= myEquipmentSummary.nextLabel %></p>
        <% } else { %>
          <p class="text-[11px] text-amber-700">棚卸し設定がありません。</p>
        <% } %>
      </div>
    </a>

    <a href="/users/purchase-reminder" class="block rounded-2xl border border-sky-100 bg-sky-50 p-5 shadow-sm hover:bg-sky-100 transition">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-sky-900">そろそろ購入リスト</h2>
        <span class="text-xs font-semibold text-sky-700 bg-white/70 border border-sky-200 rounded-full px-2 py-0.5">開く</span>
      </div>
      <p class="mt-3 text-sm text-sky-800">不足や購入タイミングを確認して補充計画を立てます。</p>
    </a>
  </div>

  <section class="rounded-2xl border border-gray-200 bg-white p-5 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">掲示板</h2>
        <p class="text-xs text-gray-500">グループのタスクや連絡を確認できます</p>
      </div>
      <a href="/users/board" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 bg-gray-100 px-3 py-1.5 rounded-full hover:bg-gray-200">
        掲示板へ
      </a>
    </div>
    <div class="rounded-xl border border-gray-100 bg-gray-50 px-3 py-3">
      <% if (myTodoTasks && myTodoTasks.length) { %>
        <ul class="space-y-2 text-sm">
          <% myTodoTasks.forEach((task) => { %>
            <li class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="font-semibold text-gray-800 truncate"><%= task.title %></p>
                <p class="text-xs text-gray-500">期限: <%= task.dueLabel || '期限なし' %></p>
              </div>
              <span class="shrink-0 inline-flex items-center rounded-full bg-amber-50 text-amber-800 px-2 py-0.5 text-xs font-semibold">未完了</span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-sm text-gray-500">未完了のイベントはありません。</p>
      <% } %>
    </div>
    <div class="text-sm text-gray-600">
      他メンバーの未完了イベント: <span class="font-semibold"><%= typeof otherMemberTaskCount === 'number' ? otherMemberTaskCount : 0 %></span> 件
    </div>
  </section>
</section>

<script>
  (function(){
    const wrapper = document.querySelector('[data-stock-hero]');
    const toggleBtn = document.querySelector('[data-stock-hero-toggle]');
    const switchBtn = document.querySelector('[data-stock-hero-switch]');
    const image = document.querySelector('[data-stock-hero-image]');
    if (!wrapper || !toggleBtn || !switchBtn || !image) return;

    const visibilityKey = 'stockTopHeroVisibility';
    const imageKey = 'stockTopHeroImage';
    const images = {
      mystock: { src: '/pict/mystock.jpg', alt: 'ストック管理とは', switchLabel: '備品管理とは' },
      equipment: { src: '/pict/myEquipment.jpg', alt: '備品管理とは', switchLabel: 'ストック管理とは' }
    };

    const apply = (hidden, current) => {
      const next = images[current] ? current : 'mystock';
      wrapper.classList.toggle('is-hidden', hidden);
      toggleBtn.textContent = hidden ? 'サービス概要の表示' : '非表示';
      toggleBtn.setAttribute('aria-pressed', String(!hidden));
      image.src = images[next].src;
      image.alt = images[next].alt;
      switchBtn.textContent = images[next].switchLabel;
      switchBtn.setAttribute('aria-label', images[next].switchLabel);
    };

    let hidden = false;
    let current = 'mystock';
    try {
      hidden = localStorage.getItem(visibilityKey) === 'hidden';
      const stored = localStorage.getItem(imageKey);
      if (stored) current = stored;
    } catch (_e) {}
    apply(hidden, current);

    toggleBtn.addEventListener('click', () => {
      const nextHidden = !wrapper.classList.contains('is-hidden');
      apply(nextHidden, current);
      try { localStorage.setItem(visibilityKey, nextHidden ? 'hidden' : 'visible'); } catch (_e) {}
    });

    switchBtn.addEventListener('click', () => {
      current = current === 'mystock' ? 'equipment' : 'mystock';
      apply(wrapper.classList.contains('is-hidden'), current);
      try { localStorage.setItem(imageKey, current); } catch (_e) {}
    });
  })();
</script>
