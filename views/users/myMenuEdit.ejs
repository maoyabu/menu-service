<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">レシピを編集</h1>
      <p class="text-sm text-gray-500">URL由来・オリジナルのレシピを編集できます</p>
    </div>
    <a href="/users/my-menu/shared-register?fav=mine" class="text-sm text-blue-600 font-semibold">マイメニュー一覧へ</a>
  </header>

  <form method="post" action="/users/my-menu/edit/<%= menuDoc._id %>" class="bg-white border rounded-2xl p-5 space-y-4">
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs text-gray-500">レシピ名</label>
        <input name="name" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.name || '' %>" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">よみ</label>
        <input name="yomi" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.yomi || '' %>" />
      </div>
      <div>
        <label class="text-xs text-gray-500">メニュー（自由入力 or 選択）</label>
        <input name="menu" list="menuList" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.menu || '' %>" />
        <datalist id="menuList">
          <% (menuNames || []).forEach(function(m){ if (!m) return; %>
            <option value="<%= m %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">種類</label>
        <input list="kindList" name="kind" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.kind || '' %>" />
        <datalist id="kindList">
          <% kinds.forEach(function(k){ %>
            <option value="<%= k %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">ジャンル</label>
        <input list="junleList" name="junle" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.junle || '' %>" />
        <datalist id="junleList">
          <% junles.forEach(function(j){ %>
            <option value="<%= j %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理方法</label>
        <input list="cookList" name="cook" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.cook || '' %>" />
        <datalist id="cookList">
          <% cooks.forEach(function(c){ %>
            <option value="<%= c %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">レシピURL</label>
        <input name="url" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.url || '' %>" />
      </div>
      <div>
        <label class="text-xs text-gray-500">画像URL（プレビューあり）</label>
        <div class="flex gap-3 items-start">
          <input name="imageUrl" id="f_imageUrl" class="flex-1 border rounded-lg px-3 py-2" value="<%= menuDoc.imageUrl || '' %>" />
          <input type="file" id="f_imageFile" accept="image/*" class="hidden" />
          <img id="imgPreview" src="<%= menuDoc.imageUrl || '' %>" alt="preview" class="w-24 h-24 object-cover rounded border cursor-pointer" title="クリックして画像を変更" />
        </div>
        <p class="text-[11px] text-gray-500 mt-1">画像をクリックして差し替え（Cloudinaryへアップロード・旧画像は削除）</p>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理時間（分）</label>
        <input name="time" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.time || '' %>" />
      </div>
      <div>
        <label class="text-xs text-gray-500">人数</label>
        <input name="people" type="number" min="1" step="1" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.people || 1 %>" />
      </div>
      <% if (owned && owned.sourceType === 'original') { %>
        <div class="md:col-span-2">
          <label class="text-xs text-gray-500">作り方</label>
          <textarea name="instruction" rows="6" class="w-full border rounded-lg px-3 py-2" placeholder="手順を記入"><%= typeof instructionText !== 'undefined' ? instructionText : '' %></textarea>
        </div>
        <div class="md:col-span-2">
          <label class="text-xs text-gray-500">コメント</label>
          <textarea name="comment" rows="3" class="w-full border rounded-lg px-3 py-2" placeholder="メモや補足"><%= typeof commentText !== 'undefined' ? commentText : '' %></textarea>
        </div>
      <% } else { %>
        <div class="md:col-span-2">
          <label class="text-xs text-gray-500">コメント</label>
          <textarea name="comment" rows="3" class="w-full border rounded-lg px-3 py-2"><%= menuDoc.comment || '' %></textarea>
        </div>
      <% } %>
    </div>
    <div class="border-t pt-4">
      <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="favorite" value="true" class="w-4 h-4" <%= (!owned || owned.favorite) ? 'checked' : '' %> />
            <span>お気に入り</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">食べたい頻度
            <select name="frequency" class="border rounded px-2 py-1">
              <% for(let i=1;i<=5;i++){ %>
                <option value="<%= i %>" <%= (owned && Number(owned.frequency)===i) ? 'selected' : '' %>><%= i %></option>
              <% } %>
            </select>
            <span class="text-xs text-gray-500">（1=低い、5=高い）</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="skill" value="true" class="w-4 h-4" <%= (owned && owned.skill) ? 'checked' : '' %> />
            <span>得意</span>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="share" value="true" class="w-4 h-4" <%= (owned && owned.share) ? 'checked' : '' %> />
            <span>共有する</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">共有範囲
            <select name="shareScope" class="border rounded px-2 py-1">
              <option value="group" <%= (!owned || owned.shareScope==='group') ? 'selected' : '' %>>グループ内</option>
              <option value="all" <%= (owned && owned.shareScope==='all') ? 'selected' : '' %>>全会員</option>
            </select>
          </label>
        </div>
      </div>
    </div>
    <div class="border-t pt-4">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">食材</h3>
        <button type="button" id="openIngModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 食材を追加</button>
      </div>
      <div id="ingredientsList" class="mt-2 space-y-2">
        <% (menuDoc.ingredients || []).forEach(function(row){
             const it = (ingredients||[]).find(i=> String(i._id)===String(row.name));
             const units = Array.isArray(it?.unit)? it.unit: (it?.unit? [it.unit]: []);
        %>
          <div class="flex gap-2 items-center">
            <div class="flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2">
              <span class="text-sm font-medium"><%= it ? it.ingredient : '' %></span>
              <% if (it && it.classification) { %>
                <span class="text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= it.classification %></span>
              <% } %>
            </div>
            <input type="hidden" name="ingredient_ids[]" value="<%= it ? it._id : '' %>" />
            <input type="number" step="0.1" min="0" name="ingredient_amounts[]" class="w-24 border rounded px-2 py-1" value="<%= row.amount || '' %>" />
            <% if (units.length) { %>
              <select name="ingredient_units[]" class="w-28 border rounded px-2 py-1">
                <% units.forEach(function(u){ %>
                  <option value="<%= u %>" <%= row.unit===u ? 'selected' : '' %>><%= u %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input name="ingredient_units[]" list="unitList" class="w-24 border rounded px-2 py-1" value="<%= row.unit || '' %>" />
            <% } %>
            <button type="button" class="px-2 py-1 text-xs border rounded" onclick="this.parentElement.remove()">削除</button>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="border-t pt-4">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">調味料</h3>
        <button type="button" id="openSeaModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 調味料を追加</button>
      </div>
      <div id="seasoningsList" class="mt-2 space-y-2">
        <% (menuDoc.seasoning || []).forEach(function(row){
             const it = (seasonings||[]).find(s=> String(s._id)===String(row.name));
             const units = Array.isArray(it?.unit)? it.unit: (it?.unit? [it.unit]: []);
        %>
          <div class="flex gap-2 items-center">
            <div class="flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2">
              <span class="text-sm font-medium"><%= it ? it.seasoning : '' %></span>
              <% if (it && it.classification) { %>
                <span class="text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= it.classification %></span>
              <% } %>
            </div>
            <input type="hidden" name="seasoning_ids[]" value="<%= it ? it._id : '' %>" />
            <input type="number" step="0.1" min="0" name="seasoning_amounts[]" class="w-24 border rounded px-2 py-1" value="<%= row.amount || '' %>" />
            <% if (units.length) { %>
              <select name="seasoning_units[]" class="w-28 border rounded px-2 py-1">
                <% units.forEach(function(u){ %>
                  <option value="<%= u %>" <%= row.unit===u ? 'selected' : '' %>><%= u %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input name="seasoning_units[]" list="unitList" class="w-24 border rounded px-2 py-1" value="<%= row.unit || '' %>" />
            <% } %>
            <button type="button" class="px-2 py-1 text-xs border rounded" onclick="this.parentElement.remove()">削除</button>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="pt-2">
      <button class="px-5 py-2 rounded-lg bg-emerald-600 text-white font-semibold">更新する</button>
    </div>
  </form>

  <datalist id="unitList">
    <% (allUnits || []).forEach(function(u){ %>
      <option value="<%= u %>"></option>
    <% }) %>
  </datalist>
</section>

<script>
  const imgInput = document.getElementById('f_imageUrl');
  const imgFile = document.getElementById('f_imageFile');
  const imgPreview = document.getElementById('imgPreview');
  imgInput?.addEventListener('input', () => {
    if (imgPreview) imgPreview.src = imgInput.value.trim();
  });

  // 画像クリックでファイル選択 → アップロード（旧Cloudinary画像を削除）
  imgPreview?.addEventListener('click', () => imgFile?.click());
  imgFile?.addEventListener('change', async () => {
    if (!imgFile.files || !imgFile.files[0]) return;
    const fd = new FormData();
    fd.append('image', imgFile.files[0]);
    const currentUrl = imgInput?.value?.trim?.() || '';
    if (currentUrl) fd.append('oldUrl', currentUrl);
    try {
      const res = await fetch('/users/my-menu/upload-replace', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok && data && data.url) {
        if (imgInput) imgInput.value = data.url;
        if (imgPreview) imgPreview.src = data.url;
      } else {
        alert('画像の差し替えに失敗しました');
      }
    } catch (e) {
      console.error(e);
      alert('画像の差し替えに失敗しました');
    } finally {
      imgFile.value = '';
    }
  });

  function createRow(kind, lists){
    const wrap = document.createElement('div');
    wrap.className = 'flex gap-2 items-center';
    const select = document.createElement('select');
    select.className = 'border rounded px-2 py-1 flex-1';
    const list = kind==='ingredient' ? lists.ingredients : lists.seasonings;
    list.forEach(it=>{
      const op = document.createElement('option');
      op.value = it._id; op.textContent = it.ingredient || it.seasoning || ''; select.appendChild(op);
    });
    const amount = document.createElement('input'); amount.type='number'; amount.step='0.1'; amount.min='0'; amount.className='w-24 border rounded px-2 py-1';
    const unit = document.createElement('input'); unit.setAttribute('list','unitList'); unit.className='w-24 border rounded px-2 py-1';
    const del = document.createElement('button'); del.type='button'; del.textContent='削除'; del.className='px-2 py-1 text-xs border rounded'; del.addEventListener('click', ()=>wrap.remove());
    if (kind==='ingredient'){ select.name='ingredient_ids[]'; amount.name='ingredient_amounts[]'; unit.name='ingredient_units[]'; }
    else { select.name='seasoning_ids[]'; amount.name='seasoning_amounts[]'; unit.name='seasoning_units[]'; }
    wrap.append(select, amount, unit, del); return wrap;
  }
  
  // 新UI（チップ＋タグ）に置換。モバイルでもスクロール可能
  (function(){
    function buildChipModal(type){
      const modal=document.createElement('div'); modal.className='fixed inset-0 z-50 hidden overflow-y-auto';
      modal.innerHTML=`
        <div class="absolute inset-0 bg-black/40" data-close></div>
        <div class="relative mx-auto mt-10 w-[840px] max-w-[96vw] rounded-2xl bg-white shadow-xl">
          <div class="flex items-center justify-between border-b px-5 py-3">
            <h3 class="font-semibold">${type==='ingredient'?'食材を追加':'調味料を追加'}</h3>
            <button type="button" data-close class="text-gray-500">✕</button>
          </div>
          <div class="p-4 space-y-3">
            <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
              <button data-tab="preset" class="px-4 py-1 rounded-full bg-white shadow text-gray-900">プリセットから選択</button>
              <button data-tab="original" class="px-4 py-1 rounded-full text-gray-600">オリジナル追加</button>
            </div>
            <div data-view="preset" class="space-y-3">
              <input data-role="kw" placeholder="検索..." class="w-full border rounded px-3 py-2"/>
              <div data-role="genres" class="flex flex-wrap gap-2"></div>
              <div data-role="tags" class="flex flex-wrap gap-2 max-h-[50vh] overflow-auto border rounded p-3 bg-green-50"></div>
              <div data-role="selected" class="hidden border rounded p-3 bg-blue-50"></div>
            </div>
            <div data-view="original" class="hidden space-y-3">
              <div class="grid grid-cols-3 gap-3">
                <div><label class="text-xs text-gray-500">名前</label><input data-o="name" class="w-full border rounded px-3 py-2"></div>
                <div><label class="text-xs text-gray-500">カテゴリー</label><select data-o="cat" class="w-full border rounded px-3 py-2"><option value="">選択してください</option></select></div>
                <div><label class="text-xs text-gray-500">単位（カンマ区切り）</label><input data-o="units" class="w-full border rounded px-3 py-2" placeholder="g, ml, 本"></div>
              </div>
              <div class="text-right"><button data-role="create" class="px-4 py-1.5 rounded bg-emerald-600 text-white text-sm">作成して追加</button></div>
            </div>
          </div>
        </div>`; document.body.appendChild(modal);
      function close(){ modal.classList.add('hidden'); }
      modal.addEventListener('click',(e)=>{ if(e.target.hasAttribute('data-close')) close(); });
      const apiBase= type==='ingredient'? '/users/my-menu/api/ingredients': '/users/my-menu/api/seasonings';
      async function fetchList(params){ const url=new URL(apiBase, location.origin); Object.entries(params||{}).forEach(([k,v])=>{ if(v) url.searchParams.set(k,v); }); const res=await fetch(url.toString()); return res.json(); }
      async function buildGenres(){
        const holder=modal.querySelector('[data-role="genres"]'); holder.innerHTML='';
        try{
          const metaUrl=new URL(apiBase, location.origin); metaUrl.searchParams.set('meta','genres');
          const m=await (await fetch(metaUrl.toString())).json();
          const cats=Array.isArray(m?.genres)? m.genres: [];
          // Dropdown for genre filter
          holder.className = 'flex items-center gap-2';
          const label=document.createElement('span'); label.textContent='分類：'; label.className='text-sm text-gray-700';
          const sel=document.createElement('select'); sel.className='border rounded px-3 py-2';
          const all=['すべて',...cats];
          all.forEach((labelTxt,idx)=>{ const val=idx===0?'':labelTxt; const op=document.createElement('option'); op.value=val; op.textContent=labelTxt; if(String(state.genre||'')===String(val||'')) op.selected=true; sel.appendChild(op); });
          sel.addEventListener('change', ()=>{ state.genre=sel.value; run(); });
          holder.appendChild(label); holder.appendChild(sel);
          // Original tab category list
          const catSel=modal.querySelector('[data-o="cat"]');
          if(catSel && catSel.tagName==='SELECT'){
            catSel.innerHTML='<option value="">選択してください</option>';
            cats.forEach(c=>{ const op=document.createElement('option'); op.value=c; op.textContent=c; catSel.appendChild(op); });
          }
        }catch(_){}
      }
      function renderTags(items){ const tags=modal.querySelector('[data-role="tags"]'); const selected=modal.querySelector('[data-role="selected"]'); tags.innerHTML=''; selected.classList.add('hidden'); selected.innerHTML=''; items.forEach(it=>{ const name=it.ingredient||it.seasoning||''; const units=Array.isArray(it.unit)? it.unit: (it.unit? [it.unit]: []); const b=document.createElement('button'); b.type='button'; b.textContent=name; b.className='px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200'; b.addEventListener('click',()=>{ selected.classList.remove('hidden'); selected.innerHTML=''; const row=document.createElement('div'); row.className='flex items-center gap-3'; const info=document.createElement('div'); info.className='flex-1'; info.innerHTML=`<div class=\"font-semibold\">${name}</div><div class=\"text-xs text-gray-600\">カテゴリ: ${it.classification||''}</div>`; const hidden=document.createElement('input'); hidden.type='hidden'; hidden.value=String(it._id); const amount=document.createElement('input'); amount.type='number'; amount.min='0'; amount.step='0.1'; amount.className='w-24 border rounded px-2 py-1'; let unitEl; if(units.length){ unitEl=document.createElement('select'); unitEl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitEl.appendChild(op); }); } else { unitEl=document.createElement('input'); unitEl.setAttribute('list','unitList'); unitEl.className='w-24 border rounded px-2 py-1'; } const addBtn=document.createElement('button'); addBtn.type='button'; addBtn.textContent='追加'; addBtn.className='px-3 py-1.5 rounded bg-blue-600 text-white text-sm'; addBtn.addEventListener('click',()=>{ const containerId= type==='ingredient'? 'ingredientsList': 'seasoningsList'; const wrap=document.createElement('div'); wrap.className='flex gap-2 items-center'; const labelBox=document.createElement('div'); labelBox.className='flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2'; const title=document.createElement('span'); title.className='text-sm font-medium'; title.textContent=name; labelBox.appendChild(title); if(it.classification){ const b=document.createElement('span'); b.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; b.textContent=it.classification; labelBox.appendChild(b);} const idInput=document.createElement('input'); idInput.type='hidden'; idInput.value=String(it._id); const amountInput=document.createElement('input'); amountInput.type='number'; amountInput.step='0.1'; amountInput.min='0'; amountInput.className='w-24 border rounded px-2 py-1'; amountInput.value=amount.value||''; let unitCtl; if(units.length){ unitCtl=document.createElement('select'); unitCtl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitCtl.appendChild(op); }); unitCtl.value=unitEl.value||''; } else { unitCtl=document.createElement('input'); unitCtl.setAttribute('list','unitList'); unitCtl.className='w-24 border rounded px-2 py-1'; unitCtl.value=unitEl.value||''; } const del=document.createElement('button'); del.type='button'; del.textContent='削除'; del.className='px-2 py-1 text-xs border rounded'; del.addEventListener('click',()=>wrap.remove()); if(type==='ingredient'){ idInput.name='ingredient_ids[]'; amountInput.name='ingredient_amounts[]'; unitCtl.name='ingredient_units[]'; } else { idInput.name='seasoning_ids[]'; amountInput.name='seasoning_amounts[]'; unitCtl.name='seasoning_units[]'; } wrap.append(labelBox, idInput, amountInput, unitCtl, del); document.getElementById(containerId).appendChild(wrap); close(); }); row.append(info, hidden, amount, unitEl, addBtn); selected.appendChild(row); }); tags.appendChild(b); }); }
      async function run(){ const kw=modal.querySelector('[data-role="kw"]').value.trim(); const data=await fetchList({ keyword: kw, genre: state.genre }); renderTags(data); }
      const state={ genre:'' };
      modal.querySelector('[data-role="kw"]').addEventListener('input', ()=>run());
      // tabs
      const presetView=modal.querySelector('[data-view="preset"]');
      const originalView=modal.querySelector('[data-view="original"]');
      const tabPreset=modal.querySelector('[data-tab="preset"]');
      const tabOriginal=modal.querySelector('[data-tab="original"]');
      function switchTab(tab){ if(tab==='preset'){ tabPreset.classList.add('bg-white','shadow','text-gray-900'); tabOriginal.classList.remove('bg-white','shadow','text-gray-900'); presetView.classList.remove('hidden'); originalView.classList.add('hidden'); } else { tabOriginal.classList.add('bg-white','shadow','text-gray-900'); tabPreset.classList.remove('bg-white','shadow','text-gray-900'); originalView.classList.remove('hidden'); presetView.classList.add('hidden'); } }
      tabPreset.addEventListener('click', ()=>switchTab('preset'));
      tabOriginal.addEventListener('click', ()=>switchTab('original'));
      // create original
      modal.querySelector('[data-role="create"]').addEventListener('click', async ()=>{
        const name=modal.querySelector('[data-o="name"]').value.trim();
        const cat=modal.querySelector('[data-o="cat"]').value.trim();
        const units=modal.querySelector('[data-o="units"]').value.trim();
        if(!name){ alert('名前を入力してください'); return; }
        const endpoint = type==='ingredient' ? '/users/my-menu/api/ingredients/custom' : '/users/my-menu/api/seasonings/custom';
        const res = await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name, classification: cat, units }) });
        if(!res.ok){ const m=await res.json().catch(()=>({})); alert(m.error||'作成に失敗しました'); return; }
        const created = await res.json();
        // そのまま行として追加
        const containerId= type==='ingredient'? 'ingredientsList': 'seasoningsList';
        const wrap=document.createElement('div'); wrap.className='flex gap-2 items-center';
        const labelBox=document.createElement('div'); labelBox.className='flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2';
        const title=document.createElement('span'); title.className='text-sm font-medium'; title.textContent= created.ingredient || created.seasoning || name; labelBox.appendChild(title);
        if((created.classification||cat)){ const b=document.createElement('span'); b.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; b.textContent=created.classification||cat; labelBox.appendChild(b); }
        const idInput=document.createElement('input'); idInput.type='hidden'; idInput.value=String(created._id);
        const amountInput=document.createElement('input'); amountInput.type='number'; amountInput.step='0.1'; amountInput.min='0'; amountInput.className='w-24 border rounded px-2 py-1';
        let unitCtl; const unitArr=Array.isArray(created.unit)? created.unit: (created.unit? [created.unit]: []);
        if(unitArr.length){ unitCtl=document.createElement('select'); unitCtl.className='w-28 border rounded px-2 py-1'; unitArr.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitCtl.appendChild(op); }); }
        else { unitCtl=document.createElement('input'); unitCtl.setAttribute('list','unitList'); unitCtl.className='w-24 border rounded px-2 py-1'; }
        const del=document.createElement('button'); del.type='button'; del.textContent='削除'; del.className='px-2 py-1 text-xs border rounded'; del.addEventListener('click', ()=>wrap.remove());
        if(type==='ingredient'){ idInput.name='ingredient_ids[]'; amountInput.name='ingredient_amounts[]'; unitCtl.name='ingredient_units[]'; } else { idInput.name='seasoning_ids[]'; amountInput.name='seasoning_amounts[]'; unitCtl.name='seasoning_units[]'; }
        wrap.append(labelBox, idInput, amountInput, unitCtl, del); document.getElementById(containerId).appendChild(wrap);
        close();
      });
      buildGenres();
      switchTab('preset');
      return { open: ()=>{ modal.classList.remove('hidden'); switchTab('preset'); run(); } };
    }
    const ingModal=buildChipModal('ingredient'); const seaModal=buildChipModal('seasoning');
    document.getElementById('openIngModal')?.addEventListener('click', ()=>ingModal.open());
    document.getElementById('openSeaModal')?.addEventListener('click', ()=>seaModal.open());
  })();
</script>
