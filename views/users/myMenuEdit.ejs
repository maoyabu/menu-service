      const apiBase= type==='ingredient'? '/users/my-menu/api/ingredients': '/users/my-menu/api/seasonings';
      async function fetchList(params){ const url=new URL(apiBase, location.origin); Object.entries(params||{}).forEach(([k,v])=>{ if(v) url.searchParams.set(k,v); }); const res=await fetch(url.toString()); return res.json(); }
