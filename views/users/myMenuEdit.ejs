<section class="max-w-5xl mx-auto py-8 space-y-6">
  <header class="flex flex-col items-start gap-2">
    <% const __editTitle = (owned && owned.sourceType === 'original') ? 'オリジナルレシピを編集' : 'レシピを編集'; %>
    <nav class="text-sm text-gray-600 inline-flex items-center gap-1">
      <a href="/users/my-menu" class="inline-flex items-center gap-1 text-blue-600 font-semibold">
        <span class="lucide w-4 h-4" data-lucide="utensils"></span>
        <span>マイメニュートップ</span>
      </a>
      <span class="text-gray-400">›</span>
      <span><%= __editTitle %></span>
    </nav>
    <div>
      <% if (owned && owned.sourceType === 'original') { %>
        <div class="rounded-xl border border-purple-200 bg-purple-50 px-4 py-2 text-purple-800">
          <h1 class="text-xl font-extrabold">オリジナルレシピを編集</h1>
          <p class="text-sm opacity-80">URL由来・オリジナルのレシピを編集できます</p>
        </div>
      <% } else { %>
        <div class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-2 text-blue-800">
          <h1 class="text-xl font-extrabold">レシピを編集</h1>
          <p class="text-sm opacity-80">URL由来・オリジナルのレシピを編集できます</p>
        </div>
      <% } %>
    </div>
  </header>
  <style>
    .toggle-track { position: relative; width: 48px; height: 24px; background: #d1d5db; border-radius: 9999px; display: inline-flex; align-items: center; padding: 0 2px; transition: background-color .2s ease; }
    .toggle-knob { width: 20px; height: 20px; border-radius: 9999px; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.25); transition: transform .2s ease; transform: translateX(0); }
    .toggle-input:checked + .toggle-track { background: #3b82f6; }
    .toggle-input:checked + .toggle-track .toggle-knob { transform: translateX(24px); }
    .toggle-state { display: inline-flex; gap: 4px; font-size: 11px; align-items: center; }
    .toggle-state .state-on,
    .toggle-state .state-off { padding: 4px 8px; border-radius: 6px; border: 1px solid #e5e7eb; transition: all .2s ease; }
    .toggle-input:checked ~ .toggle-state .state-on { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; font-weight: 600; }
    .toggle-input:checked ~ .toggle-state .state-off { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-on { background: #fff; color: #9ca3af; }
    .toggle-input:not(:checked) ~ .toggle-state .state-off { background: #f3f4f6; border-color: #d1d5db; color: #374151; font-weight: 600; }
  </style>

  <form method="post" action="/users/my-menu/edit/<%= menuDoc._id %>" class="bg-white border rounded-2xl p-5 space-y-4">
    <% const isSetMenu = menuDoc.menuType === 'set' || (Array.isArray(menuDoc.setMenus) && menuDoc.setMenus.length > 0); %>
    <% const setTypes = Array.isArray(menuDoc.setType) ? menuDoc.setType : (menuDoc.setType ? [menuDoc.setType] : []); %>
    <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-semibold text-gray-700">レシピタイプ</span>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="single" class="w-4 h-4 text-blue-600 border-gray-300" <%= !isSetMenu ? 'checked' : '' %>>
          <span>従来レシピ</span>
        </label>
        <label class="inline-flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="menuType" value="set" class="w-4 h-4 text-blue-600 border-gray-300" <%= isSetMenu ? 'checked' : '' %>>
          <span>セットメニュー</span>
        </label>
      </div>
      <div id="set-type-section" class="<%= isSetMenu ? '' : 'hidden' %>">
        <p class="text-sm font-semibold text-gray-700 mb-2">セット種別</p>
        <div class="flex flex-wrap gap-3 text-sm">
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="morning" class="w-4 h-4 text-blue-600 border-gray-300" <%= setTypes.includes('morning') ? 'checked' : '' %>>
            <span>モーニング</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="lunch" class="w-4 h-4 text-blue-600 border-gray-300" <%= setTypes.includes('lunch') ? 'checked' : '' %>>
            <span>ランチ</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" name="setType[]" value="dinner" class="w-4 h-4 text-blue-600 border-gray-300" <%= setTypes.includes('dinner') ? 'checked' : '' %>>
            <span>ディナー</span>
          </label>
        </div>
      </div>
      <p class="text-xs text-gray-500">セットメニューを選ぶと画像URL・調味料は登録せず、既存レシピから構成します。必要に応じて食材を追加できます。</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-xs text-gray-500">レシピ名</label>
        <input name="name" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.name || '' %>" required />
      </div>
      <div>
        <label class="text-xs text-gray-500">よみ</label>
        <input name="yomi" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.yomi || '' %>" />
      </div>
      <div>
        <label class="text-xs text-gray-500">メニュー（自由入力 or 選択）</label>
        <input name="menu" list="menuList" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.menu || '' %>" />
        <datalist id="menuList">
          <% (menuNames || []).forEach(function(m){ if (!m) return; %>
            <option value="<%= m %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">種類</label>
        <input list="kindList" name="kind" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.kind || '' %>" />
        <datalist id="kindList">
          <% kinds.forEach(function(k){ %>
            <option value="<%= k %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">ジャンル</label>
        <input list="junleList" name="junle" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.junle || '' %>" />
        <datalist id="junleList">
          <% junles.forEach(function(j){ %>
            <option value="<%= j %>"></option>
          <% }) %>
        </datalist>
      </div>
      <div>
        <label class="text-xs text-gray-500">調理方法</label>
        <input list="cookList" name="cook" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.cook || '' %>" />
        <datalist id="cookList">
          <% cooks.forEach(function(c){ %>
            <option value="<%= c %>"></option>
          <% }) %>
        </datalist>
      </div>
      
      <div class="md:col-span-2" id="image-section">
        <label class="text-xs text-gray-500">画像URL（プレビューあり）</label>
        <div class="flex gap-3 items-center">
          <input name="imageUrl" id="f_imageUrl" class="flex-1 border rounded-lg px-3 py-2" value="<%= menuDoc.imageUrl || '' %>" />
          <input type="file" id="f_imageFile" accept="image/*" class="hidden" />
          <img id="imgPreview" src="<%= menuDoc.imageUrl || '' %>" alt="preview" class="w-24 h-24 object-cover rounded border cursor-pointer" title="クリックして画像を変更" />
        </div>
        <p class="text-[11px] text-gray-500 mt-1">画像をクリックして差し替え（Cloudinaryへアップロード・旧画像は削除）</p>
      </div>
      <div class="grid grid-cols-2 gap-4 md:col-span-2">
        <div>
          <label class="text-xs text-gray-500">調理時間（分）</label>
          <input name="time" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.time || '' %>" />
        </div>
        <div>
          <label class="text-xs text-gray-500">人数</label>
          <input name="people" type="number" min="1" step="1" class="w-full border rounded-lg px-3 py-2" value="<%= menuDoc.people || 1 %>" />
        </div>
      </div>
      <% if (owned && owned.sourceType === 'original') { %>
        <div class="md:col-span-2" id="instruction-section">
          <label class="text-xs text-gray-500">作り方</label>
          <textarea name="instruction" rows="6" class="w-full border rounded-lg px-3 py-2" placeholder="手順を記入"><%= typeof instructionText !== 'undefined' ? instructionText : '' %></textarea>
        </div>
        <div class="md:col-span-2">
          <label class="text-xs text-gray-500">コメント</label>
          <textarea name="comment" rows="3" class="w-full border rounded-lg px-3 py-2" placeholder="メモや補足"><%= typeof commentText !== 'undefined' ? commentText : '' %></textarea>
        </div>
      <% } else { %>
        <div class="md:col-span-2">
          <label class="text-xs text-gray-500">コメント</label>
          <textarea name="comment" rows="3" class="w-full border rounded-lg px-3 py-2"><%= menuDoc.comment || '' %></textarea>
        </div>
      <% } %>
    </div>
    <div class="border-t pt-4">
      <div class="rounded-xl border px-4 py-3 bg-gray-50 space-y-3">
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <span class="text-sm font-semibold text-gray-700">つくりおき</span>
          <label class="inline-flex items-center gap-2 font-medium cursor-pointer">
            <input type="hidden" name="makeAhead" value="false">
            <input type="checkbox" name="makeAhead" value="true" class="toggle-input sr-only" <%= menuDoc.makeAhead ? 'checked' : '' %> />
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>つくりおき向き</span>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="favorite" value="true" class="w-4 h-4" <%= (!owned || owned.favorite) ? 'checked' : '' %> />
            <span>お気に入り</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">食べたい頻度
            <select name="frequency" class="border rounded px-2 py-1">
              <option value="5" <%= (owned && Number(owned.frequency)===5) ? 'selected' : '' %>>5 … 週に2回</option>
              <option value="4" <%= (owned && Number(owned.frequency)===4) ? 'selected' : '' %>>4 … 週に1回</option>
              <option value="3" <%= (!owned || Number(owned.frequency)===3) ? 'selected' : '' %>>3 … 隔週に1回</option>
              <option value="2" <%= (owned && Number(owned.frequency)===2) ? 'selected' : '' %>>2 … 月に1回</option>
              <option value="1" <%= (owned && Number(owned.frequency)===1) ? 'selected' : '' %>>1 … 3ヶ月に1回</option>
            </select>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <label class="inline-flex items-center gap-2 font-medium">
            <input type="checkbox" name="share" value="true" class="w-4 h-4" <%= (owned && owned.share) ? 'checked' : '' %> />
            <span>共有する</span>
          </label>
          <label class="inline-flex items-center gap-2 font-medium">共有範囲
            <select name="shareScope" class="border rounded px-2 py-1">
              <option value="group" <%= (!owned || owned.shareScope==='group') ? 'selected' : '' %>>グループ内</option>
              <option value="all" <%= (owned && owned.shareScope==='all') ? 'selected' : '' %>>全会員</option>
              <% if (owned && owned.sourceType === 'original') { %>
                <option value="public" <%= (owned && owned.shareScope==='public') ? 'selected' : '' %>>一般公開</option>
              <% } %>
            </select>
          </label>
          <% if (publicUrl) { %>
          <div class="flex items-center gap-2 text-sm">
            <span class="text-gray-700">公開URL:</span>
            <input type="text" readonly class="border rounded px-2 py-1 w-80" value="<%= publicUrl %>" id="publicUrlInput">
            <button type="button" class="px-2 py-1 rounded border text-sm" id="copyPublicUrl">コピー</button>
          </div>
          <% } %>
        </div>
        <% if (owned && owned.sourceType === 'original') { %>
        <div class="flex flex-wrap items-center gap-4 text-[15px]">
          <span class="text-sm font-semibold text-gray-700">非表示にする</span>
          <label class="inline-flex items-center gap-2 font-medium cursor-pointer">
            <input type="hidden" name="hidden" value="false">
            <input type="checkbox" name="hidden" value="true" class="toggle-input sr-only" <%= (owned && owned.hidden) ? 'checked' : '' %> />
            <span class="toggle-track"><span class="toggle-knob"></span></span>
            <span class="toggle-state">
              <span class="state-off">OFF</span>
              <span class="state-on">ON</span>
            </span>
            <span>一覧で非表示</span>
          </label>
        </div>
        <% } %>
      </div>
    </div>
    <div id="set-menu-section" class="border-t pt-4 <%= isSetMenu ? '' : 'hidden' %>">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">セットに含めるメニュー</h3>
        <button type="button" id="openSetMenuModal" class="px-3 py-1.5 rounded border text-sm bg-blue-50 border-blue-300 text-blue-800 hover:bg-blue-100">＋ メニューを追加</button>
      </div>
      <div id="setMenuList" class="mt-2 space-y-2 text-sm text-gray-500">メニューを追加してください</div>
      <p class="text-xs text-gray-500 mt-1">セットメニューや自分自身は追加できません。</p>
    </div>

    <div class="border-t pt-4" id="ingredients-section">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">食材</h3>
        <button type="button" id="openIngModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 食材を追加</button>
      </div>
      <div id="ingredientsList" class="mt-2 space-y-2">
        <% (menuDoc.ingredients || []).forEach(function(row){
             const it = (ingredients||[]).find(i=> String(i._id)===String(row.name));
             const units = Array.isArray(it?.unit)? it.unit: (it?.unit? [it.unit]: []);
        %>
          <div class="flex gap-2 items-center">
            <div class="flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2">
              <span class="text-sm font-medium"><%= it ? it.ingredient : '' %></span>
              <% if (it && it.classification) { %>
                <span class="text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= it.classification %></span>
              <% } %>
            </div>
            <input type="hidden" name="ingredient_ids[]" value="<%= it ? it._id : '' %>" />
            <input type="number" step="0.1" min="0" name="ingredient_amounts[]" class="w-24 border rounded px-2 py-1" value="<%= row.amount || '' %>" />
            <% if (units.length) { %>
              <select name="ingredient_units[]" class="w-28 border rounded px-2 py-1">
                <% units.forEach(function(u){ %>
                  <option value="<%= u %>" <%= row.unit===u ? 'selected' : '' %>><%= u %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input name="ingredient_units[]" list="unitList" class="w-24 border rounded px-2 py-1" value="<%= row.unit || '' %>" />
            <% } %>
            <button type="button" class="px-2 py-1 text-xs border rounded" onclick="this.parentElement.remove()">削除</button>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="border-t pt-4" id="seasonings-section">
      <div class="flex items-center justify-start gap-3">
        <h3 class="font-semibold">調味料</h3>
        <button type="button" id="openSeaModal" class="px-3 py-1.5 rounded border text-sm bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100">＋ 調味料を追加</button>
      </div>
      <div id="seasoningsList" class="mt-2 space-y-2">
        <% (menuDoc.seasoning || []).forEach(function(row){
             const it = (seasonings||[]).find(s=> String(s._id)===String(row.name));
             const units = Array.isArray(it?.unit)? it.unit: (it?.unit? [it.unit]: []);
        %>
          <div class="flex gap-2 items-center">
            <div class="flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2">
              <span class="text-sm font-medium"><%= it ? it.seasoning : '' %></span>
              <% if (it && it.classification) { %>
                <span class="text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700"><%= it.classification %></span>
              <% } %>
            </div>
            <input type="hidden" name="seasoning_ids[]" value="<%= it ? it._id : '' %>" />
            <input type="number" step="0.1" min="0" name="seasoning_amounts[]" class="w-24 border rounded px-2 py-1" value="<%= row.amount || '' %>" />
            <% if (units.length) { %>
              <select name="seasoning_units[]" class="w-28 border rounded px-2 py-1">
                <% units.forEach(function(u){ %>
                  <option value="<%= u %>" <%= row.unit===u ? 'selected' : '' %>><%= u %></option>
                <% }) %>
              </select>
            <% } else { %>
              <input name="seasoning_units[]" list="unitList" class="w-24 border rounded px-2 py-1" value="<%= row.unit || '' %>" />
            <% } %>
            <button type="button" class="px-2 py-1 text-xs border rounded" onclick="this.parentElement.remove()">削除</button>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="pt-2">
      <button class="px-5 py-2 rounded-lg bg-emerald-600 text-white font-semibold">更新する</button>
    </div>
  </form>

  <% if (publicUrl) { %>
  <script>
    (function(){
      const btn = document.getElementById('copyPublicUrl');
      const input = document.getElementById('publicUrlInput');
      if (!btn || !input) return;
      btn.addEventListener('click', async function(){
        try {
          await navigator.clipboard.writeText(input.value);
          btn.textContent = 'コピーしました';
          setTimeout(()=>{ btn.textContent='コピー'; }, 1500);
        } catch(_) {
          input.select(); document.execCommand('copy');
          btn.textContent = 'コピーしました';
          setTimeout(()=>{ btn.textContent='コピー'; }, 1500);
        }
      });
    })();
  </script>
  <% } %>

  <datalist id="unitList">
    <% (allUnits || []).forEach(function(u){ %>
      <option value="<%= u %>"></option>
    <% }) %>
  </datalist>
</section>

<script>
  const imgInput = document.getElementById('f_imageUrl');
  const imgFile = document.getElementById('f_imageFile');
  const imgPreview = document.getElementById('imgPreview');
  imgInput?.addEventListener('input', () => {
    if (imgPreview) imgPreview.src = imgInput.value.trim();
  });

  // 画像クリックでファイル選択 → アップロード（旧Cloudinary画像を削除）
  imgPreview?.addEventListener('click', () => imgFile?.click());
  imgFile?.addEventListener('change', async () => {
    if (!imgFile.files || !imgFile.files[0]) return;
    const fd = new FormData();
    fd.append('image', imgFile.files[0]);
    const currentUrl = imgInput?.value?.trim?.() || '';
    if (currentUrl) fd.append('oldUrl', currentUrl);
    try {
      const res = await fetch('/users/my-menu/upload-replace', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok && data && data.url) {
        if (imgInput) imgInput.value = data.url;
        if (imgPreview) imgPreview.src = data.url;
      } else {
        alert('画像の差し替えに失敗しました');
      }
    } catch (e) {
      console.error(e);
      alert('画像の差し替えに失敗しました');
    } finally {
      imgFile.value = '';
    }
  });

  function createRow(kind, lists){
    const wrap = document.createElement('div');
    wrap.className = 'flex gap-2 items-center';
    const select = document.createElement('select');
    select.className = 'border rounded px-2 py-1 flex-1';
    const list = kind==='ingredient' ? lists.ingredients : lists.seasonings;
    list.forEach(it=>{
      const op = document.createElement('option');
      op.value = it._id; op.textContent = it.ingredient || it.seasoning || ''; select.appendChild(op);
    });
    const amount = document.createElement('input'); amount.type='number'; amount.step='0.1'; amount.min='0'; amount.className='w-24 border rounded px-2 py-1';
    const unit = document.createElement('input'); unit.setAttribute('list','unitList'); unit.className='w-24 border rounded px-2 py-1';
    const del = document.createElement('button'); del.type='button'; del.textContent='削除'; del.className='px-2 py-1 text-xs border rounded'; del.addEventListener('click', ()=>wrap.remove());
    if (kind==='ingredient'){ select.name='ingredient_ids[]'; amount.name='ingredient_amounts[]'; unit.name='ingredient_units[]'; }
    else { select.name='seasoning_ids[]'; amount.name='seasoning_amounts[]'; unit.name='seasoning_units[]'; }
    wrap.append(select, amount, unit, del); return wrap;
  }
  
  // 新UI（チップ＋タグ）に置換。モバイルでもスクロール可能
  (function(){
    function buildChipModal(type){
      const modal=document.createElement('div'); modal.className='fixed inset-0 z-50 hidden overflow-y-auto';
      modal.innerHTML=`
        <div class="absolute inset-0 bg-black/40" data-close></div>
        <div class="relative mx-auto mt-10 w-[840px] max-w-[96vw] rounded-2xl bg-white shadow-xl">
          <div class="flex items-center justify-between border-b px-5 py-3">
            <h3 class="font-semibold">${type==='ingredient'?'食材を追加':'調味料を追加'}</h3>
            <button type="button" data-close class="text-gray-500">✕</button>
          </div>
          <div class="p-4 space-y-3">
            <div class="inline-flex p-1 bg-gray-100 rounded-full text-sm">
              <button data-tab="preset" class="px-4 py-1 rounded-full bg-white shadow text-gray-900">プリセットから選択</button>
              <button data-tab="original" class="px-4 py-1 rounded-full text-gray-600">オリジナル追加</button>
            </div>
            <div data-view="preset" class="space-y-3">
              <input data-role="kw" placeholder="検索..." class="w-full border rounded px-3 py-2"/>
              <div data-role="genres" class="flex flex-wrap gap-2"></div>
              <div data-role="tags" class="max-h-[50vh] overflow-auto border rounded p-2 bg-white space-y-2"></div>
              <div data-role="selected" class="hidden border rounded p-3 bg-blue-50"></div>
            </div>
            <div data-view="original" class="hidden space-y-3">
              <div class="grid grid-cols-3 gap-3">
                <div><label class="text-xs text-gray-500">名前</label><input data-o="name" class="w-full border rounded px-3 py-2"></div>
