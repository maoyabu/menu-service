div'); wrap.className='flex gap-2 items-center'; const labelBox=document.createElement('div'); labelBox.className='flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2'; const title=document.createElement('span'); title.className='text-sm font-medium'; title.textContent=name; labelBox.appendChild(title); if(it.classification){ const b=document.createElement('span'); b.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; b.textContent=it.classification; labelBox.appendChild(b);} const idInput=document.createElement('input'); idInput.type='hidden'; idInput.value=String(it._id); const amountInput=document.createElement('input'); amountInput.type='number'; amountInput.step='0.1'; amountInput.min='0'; amountInput.className='w-24 border rounded px-2 py-1'; amountInput.value=amount.value||''; let unitCtl; if(units.length){ unitCtl=document.createElement('select'); unitCtl.className='w-28 border rounded px-2 py-1'; units.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitCtl.appendChild(op); }); unitCtl.value=unitEl.value||''; } else { unitCtl=document.createElement('input'); unitCtl.setAttribute('list','unitList'); unitCtl.className='w-24 border rounded px-2 py-1'; unitCtl.value=unitEl.value||''; } const del=document.createElement('button'); del.type='button'; del.textContent='削除'; del.className='px-2 py-1 text-xs border rounded'; del.addEventListener('click',()=>wrap.remove()); if(type==='ingredient'){ idInput.name='ingredient_ids[]'; amountInput.name='ingredient_amounts[]'; unitCtl.name='ingredient_units[]'; } else { idInput.name='seasoning_ids[]'; amountInput.name='seasoning_amounts[]'; unitCtl.name='seasoning_units[]'; } wrap.append(labelBox, idInput, amountInput, unitCtl, del); document.getElementById(containerId).appendChild(wrap); close(); }); const panelRow=document.createElement('div'); panelRow.className='flex items-center gap-3'; panelRow.append(info, hidden, amount, unitEl, addBtn); selected.appendChild(panelRow); } else { selected.classList.add('hidden'); selected.innerHTML=''; } }); checks.push(checkbox); row.appendChild(checkbox); if(it.imageUrl){ const img=document.createElement('img'); img.src=it.imageUrl; img.alt=name||'image'; img.className='w-12 h-12 rounded object-cover'; row.appendChild(img); } else { const placeholder=document.createElement('div'); placeholder.className='w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500'; placeholder.textContent='NO IMG'; row.appendChild(placeholder); } const info=document.createElement('div'); info.className='flex-1'; const title=document.createElement('div'); title.className='font-medium text-gray-800'; title.textContent=name||'名称未設定'; const meta=document.createElement('div'); meta.className='text-xs text-gray-500'; meta.textContent=[it.classification,it.short_nutrition].filter(Boolean).join(' / '); info.appendChild(title); info.appendChild(meta); row.appendChild(info); holder.appendChild(row); }); }
      let __reqSeq = 0;
      async function run(){
        const mySeq = ++__reqSeq;
        const kw=modal.querySelector('[data-role="kw"]').value.trim();
        const data=await fetchList({ keyword: kw, genre: state.genre });
        if (mySeq !== __reqSeq) return;
        renderTags(data);
      }
      const state={ genre:'' };
      modal.querySelector('[data-role="kw"]').addEventListener('input', ()=>run());
      // tabs
      const presetView=modal.querySelector('[data-view="preset"]');
      const originalView=modal.querySelector('[data-view="original"]');
      const tabPreset=modal.querySelector('[data-tab="preset"]');
      const tabOriginal=modal.querySelector('[data-tab="original"]');
      function switchTab(tab){ if(tab==='preset'){ tabPreset.classList.add('bg-white','shadow','text-gray-900'); tabOriginal.classList.remove('bg-white','shadow','text-gray-900'); presetView.classList.remove('hidden'); originalView.classList.add('hidden'); } else { tabOriginal.classList.add('bg-white','shadow','text-gray-900'); tabPreset.classList.remove('bg-white','shadow','text-gray-900'); originalView.classList.remove('hidden'); presetView.classList.add('hidden'); } }
      tabPreset.addEventListener('click', ()=>switchTab('preset'));
      tabOriginal.addEventListener('click', ()=>switchTab('original'));
      // create original
      modal.querySelector('[data-role="create"]').addEventListener('click', async ()=>{
        const name=modal.querySelector('[data-o="name"]').value.trim();
        const cat=modal.querySelector('[data-o="cat"]').value.trim();
        const units=modal.querySelector('[data-o="units"]').value.trim();
        if(!name){ alert('名前を入力してください'); return; }
        const endpoint = type==='ingredient' ? '/users/my-menu/api/ingredients/custom' : '/users/my-menu/api/seasonings/custom';
        const res = await fetch(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ name, classification: cat, units }) });
        if(!res.ok){ const m=await res.json().catch(()=>({})); alert(m.error||'作成に失敗しました'); return; }
        const created = await res.json();
        // そのまま行として追加
        const containerId= type==='ingredient'? 'ingredientsList': 'seasoningsList';
        const wrap=document.createElement('div'); wrap.className='flex gap-2 items-center';
        const labelBox=document.createElement('div'); labelBox.className='flex-1 border rounded px-3 py-2 bg-gray-50 flex items-center gap-2';
        const title=document.createElement('span'); title.className='text-sm font-medium'; title.textContent= created.ingredient || created.seasoning || name; labelBox.appendChild(title);
        if((created.classification||cat)){ const b=document.createElement('span'); b.className='text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700'; b.textContent=created.classification||cat; labelBox.appendChild(b); }
        const idInput=document.createElement('input'); idInput.type='hidden'; idInput.value=String(created._id);
        const amountInput=document.createElement('input'); amountInput.type='number'; amountInput.step='0.1'; amountInput.min='0'; amountInput.className='w-24 border rounded px-2 py-1';
        let unitCtl; const unitArr=Array.isArray(created.unit)? created.unit: (created.unit? [created.unit]: []);
        if(unitArr.length){ unitCtl=document.createElement('select'); unitCtl.className='w-28 border rounded px-2 py-1'; unitArr.forEach(u=>{ const op=document.createElement('option'); op.value=u; op.textContent=u; unitCtl.appendChild(op); }); }
        else { unitCtl=document.createElement('input'); unitCtl.setAttribute('list','unitList'); unitCtl.className='w-24 border rounded px-2 py-1'; }
        const del=document.createElement('button'); del.type='button'; del.textContent='削除'; del.className='px-2 py-1 text-xs border rounded'; del.addEventListener('click', ()=>wrap.remove());
        if(type==='ingredient'){ idInput.name='ingredient_ids[]'; amountInput.name='ingredient_amounts[]'; unitCtl.name='ingredient_units[]'; } else { idInput.name='seasoning_ids[]'; amountInput.name='seasoning_amounts[]'; unitCtl.name='seasoning_units[]'; }
        wrap.append(labelBox, idInput, amountInput, unitCtl, del); document.getElementById(containerId).appendChild(wrap);
        close();
      });
      buildGenres();
      switchTab('preset');
      return { open: ()=>{ modal.classList.remove('hidden'); switchTab('preset'); run(); } };
    }
    const ingModal=buildChipModal('ingredient'); const seaModal=buildChipModal('seasoning');
    document.getElementById('openIngModal')?.addEventListener('click', ()=>ingModal.open());
    document.getElementById('openSeaModal')?.addEventListener('click', ()=>seaModal.open());
  })();
</script>

<script>
  const setMenuCandidates = <%- JSON.stringify(setMenuCandidates || []) %>;
  const initialSetMenus = <%- JSON.stringify((menuDoc.setMenus || []).map(m=>({ _id: String(m?._id || m || ''), name: m?.name || '', menu: m?.menu || '', kind: m?.kind || '', junle: m?.junle || '', cook: m?.cook || '', imageUrl: m?.imageUrl || '', menuType: m?.menuType || '' })).filter(m=>m._id)) %>;

  function setSectionEnabled(sectionId, enabled) {
    const section = document.getElementById(sectionId);
    if (!section) return;
    section.classList.toggle('hidden', !enabled);
    section.querySelectorAll('input, select, textarea, button').forEach((el) => {
      if (el.id === 'openSetMenuModal') return;
      if (enabled) el.removeAttribute('disabled');
      else el.setAttribute('disabled', 'disabled');
    });
  }

  function toggleRequired(selector, isRequired) {
    const input = document.querySelector(selector);
    if (!input) return;
    if (isRequired) input.setAttribute('required', 'required');
    else input.removeAttribute('required');
  }

  function applyMenuTypeState() {
    const checked = document.querySelector('input[name="menuType"]:checked');
    const isSet = checked && checked.value === 'set';
    setSectionEnabled('set-type-section', isSet);
    setSectionEnabled('set-menu-section', isSet);
    setSectionEnabled('image-section', !isSet);
    setSectionEnabled('seasonings-section', !isSet);
    setSectionEnabled('ingredients-section', true);
    toggleRequired('#f_imageUrl', !isSet);
    toggleRequired('textarea[name="instruction"]', !isSet);
    // setType validation handled on submit (checkbox group)
  }

  const setMenuState = { selected: new Map() };

  function normalizeText(value) { return String(value || '').toLowerCase(); }
  function matchKeyword(item, keyword) {
    if (!keyword) return true;
    const text = [item.name, item.menu, item.kind, item.junle, item.cook].map(normalizeText).join(' ');
    return text.includes(keyword);
  }

  function renderSetMenuList() {
    const listEl = document.getElementById('setMenuList');
    if (!listEl) return;
    const values = Array.from(setMenuState.selected.values());
    if (!values.length) {
      listEl.textContent = 'メニューを追加してください';
      return;
    }
    listEl.innerHTML = '';
    values.forEach((item) => {
      const wrap = document.createElement('div');
      wrap.className = 'flex flex-wrap items-center gap-3 border border-gray-200 rounded p-2 bg-gray-50';

      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'set_menu_ids[]';
      hidden.value = item._id;
      wrap.appendChild(hidden);

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        wrap.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        wrap.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'min-w-[180px]';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      wrap.appendChild(info);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'ml-auto px-2 py-1 text-sm text-red-600 border rounded hover:bg-red-100';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', () => {
        setMenuState.selected.delete(item._id);
        renderSetMenuList();
        renderSetMenuResults();
      });
      wrap.appendChild(removeBtn);

      listEl.appendChild(wrap);
    });
  }

  function renderSetMenuResults() {
    const resultsEl = document.getElementById('set-menu-results');
    if (!resultsEl) return;
    const keyword = normalizeText(document.getElementById('set-menu-keyword')?.value || '');
    const menuFilter = document.getElementById('set-menu-filter-menu')?.value || '';
    const kindFilter = document.getElementById('set-menu-filter-kind')?.value || '';
    const junleFilter = document.getElementById('set-menu-filter-junle')?.value || '';
    const cookFilter = document.getElementById('set-menu-filter-cook')?.value || '';

    const filtered = setMenuCandidates.filter((item) => {
      if (item.menuType === 'set') return false;
      if (menuFilter && item.menu !== menuFilter) return false;
      if (kindFilter && item.kind !== kindFilter) return false;
      if (junleFilter && item.junle !== junleFilter) return false;
      if (cookFilter && item.cook !== cookFilter) return false;
      return matchKeyword(item, keyword);
    });

    resultsEl.innerHTML = '';
    if (!filtered.length) {
      const empty = document.createElement('div');
      empty.className = 'text-sm text-gray-500';
      empty.textContent = '条件に一致するメニューがありません。';
      resultsEl.appendChild(empty);
      return;
    }

    filtered.forEach((item) => {
      const row = document.createElement('label');
      row.className = 'flex items-start gap-3 border rounded p-2 bg-white hover:bg-gray-50 cursor-pointer';

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.className = 'mt-1 w-4 h-4 text-blue-600 border-gray-300';
      checkbox.checked = setMenuState.selected.has(item._id);
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) setMenuState.selected.set(item._id, item);
        else setMenuState.selected.delete(item._id);
        renderSetMenuList();
      });
      row.appendChild(checkbox);

      if (item.imageUrl) {
        const img = document.createElement('img');
        img.src = item.imageUrl;
        img.alt = item.name || 'menu image';
        img.className = 'w-12 h-12 rounded object-cover';
        row.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'w-12 h-12 rounded bg-gray-200 flex items-center justify-center text-xs text-gray-500';
        placeholder.textContent = 'NO IMG';
        row.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'flex-1';
      const title = document.createElement('div');
      title.className = 'font-medium text-gray-800';
      title.textContent = item.name || '名称未設定';
      const meta = document.createElement('div');
      meta.className = 'text-xs text-gray-500';
      meta.textContent = [item.menu, item.kind, item.junle, item.cook].filter(Boolean).join(' / ');
      info.appendChild(title);
      info.appendChild(meta);
      row.appendChild(info);

      resultsEl.appendChild(row);
    });
  }

  function openSetMenuModal() {
    const modal = document.getElementById('set-menu-modal');
    if (!modal) return;
    modal.classList.remove('hidden');
    renderSetMenuResults();
  }

  function closeSetMenuModal() {
    const modal = document.getElementById('set-menu-modal');
    if (!modal) return;
    modal.classList.add('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input[name="menuType"]').forEach((el) => {
      el.addEventListener('change', applyMenuTypeState);
    });
    applyMenuTypeState();

    initialSetMenus.forEach((item) => {
      if (!item || !item._id) return;
      setMenuState.selected.set(item._id, item);
    });
    renderSetMenuList();

    const openBtn = document.getElementById('openSetMenuModal');
    const closeBtn = document.getElementById('set-menu-close');
    const applyBtn = document.getElementById('set-menu-apply');
    const overlay = document.getElementById('set-menu-overlay');
    if (openBtn) openBtn.addEventListener('click', openSetMenuModal);
    if (closeBtn) closeBtn.addEventListener('click', closeSetMenuModal);
    if (applyBtn) applyBtn.addEventListener('click', closeSetMenuModal);
    if (overlay) overlay.addEventListener('click', closeSetMenuModal);

    ['set-menu-keyword','set-menu-filter-menu','set-menu-filter-kind','set-menu-filter-junle','set-menu-filter-cook']
      .forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', renderSetMenuResults);
        el.addEventListener('change', renderSetMenuResults);
      });

    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', (e) => {
        const checked = document.querySelector('input[name="menuType"]:checked');
        const isSet = checked && checked.value === 'set';
        if (!isSet) return;
        const any = Array.from(document.querySelectorAll('input[name="setType[]"]')).some((el) => el.checked);
        if (!any) {
          e.preventDefault();
          alert('セット種別を1つ以上選択してください。');
        }
      });
    }
  });
</script>

<!-- セットメニュー選択モーダル -->
<div id="set-menu-modal" class="fixed inset-0 z-50 hidden">
  <div id="set-menu-overlay" class="absolute inset-0 bg-black/40"></div>
  <div class="relative mx-auto mt-10 w-[860px] max-w-[96vw] rounded-2xl bg-white shadow-xl">
    <div class="flex items-center justify-between border-b px-5 py-3">
      <h3 class="font-semibold">メニューを追加</h3>
      <button type="button" id="set-menu-close" class="text-gray-500">✕</button>
    </div>
    <div class="p-4 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="text-xs text-gray-500">フリーワード</label>
          <input id="set-menu-keyword" class="w-full border rounded px-3 py-2" placeholder="例: 白米 / 味噌">
        </div>
        <div>
          <label class="text-xs text-gray-500">メニュー</label>
          <select id="set-menu-filter-menu" class="w-full border rounded px-3 py-2">
            <option value="">すべて</option>
            <% (menuNames || []).forEach(name => { %>
              <option value="<%= name %>"><%= name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="text-xs text-gray-500">種類</label>
          <select id="set-menu-filter-kind" class="w-full border rounded px-3 py-2">
            <option value="">すべて</option>
            <% (kinds || []).forEach(kind => { %>
              <option value="<%= kind %>"><%= kind %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="text-xs text-gray-500">ジャンル</label>
          <select id="set-menu-filter-junle" class="w-full border rounded px-3 py-2">
            <option value="">すべて</option>
            <% (junles || []).forEach(junle => { %>
              <option value="<%= junle %>"><%= junle %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="text-xs text-gray-500">調理方法</label>
          <select id="set-menu-filter-cook" class="w-full border rounded px-3 py-2">
            <option value="">すべて</option>
            <% (cooks || []).forEach(cook => { %>
              <option value="<%= cook %>"><%= cook %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div id="set-menu-results" class="max-h-[45vh] overflow-auto border rounded p-3 bg-gray-50 space-y-2"></div>
      <div class="text-right">
        <button type="button" id="set-menu-apply" class="px-4 py-2 rounded bg-gray-900 text-white text-sm">追加する</button>
      </div>
    </div>
  </div>
</div>
