<section class="max-w-6xl mx-auto py-8 space-y-6">
  <header class="flex items-center justify-between">
    <div class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-2 text-blue-800">
      <h1 class="text-xl font-extrabold"><%= monthLabel || '' %>の棚卸しリスト</h1>
      <p class="text-sm opacity-80">チェックすると日付とメモを記録します</p>
    </div>
    <a href="/users/my-stock" class="text-sm text-blue-600 font-semibold">マイストックへ戻る</a>
  </header>

  <div id="checklist" class="space-y-6"></div>
  <!-- inline popover for note/amount -->
  <div id="stock-pop" class="hidden fixed z-50 bg-white border rounded-xl shadow p-3 w-72">
    <div class="text-sm font-semibold mb-2">チェック内容</div>
    <div class="space-y-2">
      <label class="block">
        <span class="text-xs text-gray-600">数量</span>
        <input type="number" step="0.1" min="0" id="stock-pop-amount" class="w-full border rounded px-2 py-1" />
      </label>
      <label class="block">
        <span class="text-xs text-gray-600">メモ</span>
        <input type="text" id="stock-pop-note" class="w-full border rounded px-2 py-1" placeholder="残量など" />
      </label>
    </div>
    <div class="mt-3 flex justify-end gap-2">
      <button type="button" id="stock-pop-cancel" class="px-2 py-1 border rounded text-sm">キャンセル</button>
      <button type="button" id="stock-pop-save" class="px-2 py-1 bg-blue-600 text-white rounded text-sm">保存</button>
    </div>
  </div>
</section>

<script>
  (function(){
    const monthStart = new Date(<%- JSON.stringify(monthStartISO || '') %>);
    const items = <%- JSON.stringify(items || []) %>;
    // group by place
    const byPlace = new Map();
    items.forEach((it)=>{
      const k = it.place || '未設定';
      const arr = byPlace.get(k) || []; arr.push(it); byPlace.set(k, arr);
    });
    // helpers
    const fmt = (d)=>{ try{ const dt = new Date(d); if (!dt || isNaN(dt.getTime())) return ''; const m = dt.getMonth()+1, day = dt.getDate(); return `${m}月${day}日`; }catch(_){ return ''; } };
    const isCheckedThisMonth = (d)=>{ if (!d) return false; try{ const dt = new Date(d); return dt.getFullYear()===monthStart.getFullYear() && dt.getMonth()===monthStart.getMonth(); }catch(_){ return false; } };
    const daysAgo = (d)=>{ if (!d) return 99999; const dt = new Date(d); return Math.floor((Date.now()-dt.getTime())/86400000); };

    const root = document.getElementById('checklist');
    byPlace.forEach((list, placeName)=>{
      // split
      const pending = list.filter(it => !isCheckedThisMonth(it.lastCheckedAt)).sort((a,b)=> (a.lastCheckedAt? new Date(a.lastCheckedAt):0) - (b.lastCheckedAt? new Date(b.lastCheckedAt):0));
      const done = list.filter(it => isCheckedThisMonth(it.lastCheckedAt)).sort((a,b)=> new Date(b.lastCheckedAt||0) - new Date(a.lastCheckedAt||0));
      const sec = document.createElement('section'); sec.className='rounded-2xl border bg-white p-4';
      sec.innerHTML = `<div class="flex items-center justify-between mb-3"><h2 class="font-semibold">${placeName}</h2></div>`;
      const grid = document.createElement('div'); grid.className='grid md:grid-cols-2 gap-4'; sec.appendChild(grid);
      const left = document.createElement('div'); left.innerHTML='<h3 class="text-sm font-semibold text-gray-700">要チェック</h3>'; grid.appendChild(left);
      const right = document.createElement('div'); right.innerHTML='<h3 class="text-sm font-semibold text-gray-700">チェック済み</h3>'; grid.appendChild(right);
      const makeLi = (it, checked)=>{
        const li = document.createElement('li'); li.className = 'flex items-start gap-2 border rounded-lg px-3 py-2 ' + (checked? 'bg-green-50 border-green-200': ''); li.dataset.id = it.id; li.dataset.checked = checked?'1':'0';
        const dateStr = it.lastCheckedAt ? fmt(it.lastCheckedAt) : '';
        const ago = it.lastCheckedAt ? `（${daysAgo(it.lastCheckedAt)}日前）` : '';
        li.innerHTML = `
          <label class="flex items-start gap-2 w-full">
            <input type="checkbox" ${checked?'checked':''} />
            <span class="flex-1">
              <span class="text-sm font-medium text-gray-900">${it.itemLabel || it.name || ''}</span>
              <span class="ml-2 text-xs text-gray-600">${it.amount||''}${it.unit||''}</span>
              <div class="text-xs text-gray-500 mt-0.5">最終チェック: <span data-role="date">${dateStr || '未'}</span> <span data-role="ago">${dateStr? ago: ''}</span> ${it.lastCheckedBy ? `<span data-role="by" class=\"ml-2 inline-flex items-center rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-2 py-0.5 text-[10px]\">${it.lastCheckedBy}</span>` : `<span data-role=\"by\" class=\"hidden\"></span>`}</div>
              ${it.lastCheckedNote? `<div class="text-[11px] text-gray-600 mt-0.5" data-role="note">${it.lastCheckedNote}</div>` : '<div class="hidden" data-role="note"></div>'}
            </span>
          </label>`;
        return li;
      };
      const ulL = document.createElement('ul'); ulL.className='space-y-2'; ulL.setAttribute('data-list','pending'); left.appendChild(ulL);
      const ulR = document.createElement('ul'); ulR.className='space-y-2'; ulR.setAttribute('data-list','done'); right.appendChild(ulR);
      pending.forEach(it=> ulL.appendChild(makeLi(it,false)));
      done.forEach(it=> ulR.appendChild(makeLi(it,true)));
      root.appendChild(sec);
    });

    // inline popover controls
    const pop = document.getElementById('stock-pop');
    const popAmt = document.getElementById('stock-pop-amount');
    const popNote = document.getElementById('stock-pop-note');
    const popCancel = document.getElementById('stock-pop-cancel');
    const popSave = document.getElementById('stock-pop-save');
    let currentCtx = null; // { li, cb }

    function openPopNear(cbEl, amount, note){
      const r = cbEl.getBoundingClientRect();
      pop.style.left = Math.min(window.innerWidth - 320, r.left + 24) + 'px';
      pop.style.top = Math.min(window.innerHeight - 180, r.top + 8) + 'px';
      popAmt.value = String(amount || 0);
      popNote.value = note || '';
      pop.classList.remove('hidden');
    }
    function closePop(){ pop.classList.add('hidden'); currentCtx = null; }

    function getLists(sec){
      const leftUl = sec.querySelector('[data-list="pending"]');
      const rightUl = sec.querySelector('[data-list="done"]');
      return { leftUl, rightUl };
    }

    root.addEventListener('change', async (ev)=>{
      const cb = ev.target.closest('input[type="checkbox"]'); if (!cb) return;
      const li = cb.closest('li'); if (!li) return;
      if (cb.checked){
        // open popover for input (move after save)
        const amountText = (li.querySelector('.text-xs .ml-2') ? li.querySelector('.text-xs .ml-2').textContent : '').trim();
        const amountNum = Number((amountText||'').split(/\s|[^0-9.]+/)[0]) || Number(li.dataset.amount||0);
        currentCtx = { li, cb };
        openPopNear(cb, amountNum, (li.querySelector('[data-role="note"]')||{}).textContent||'');
      } else {
        // unchecked: move back to left
        const sec = li.closest('section'); const lists = getLists(sec);
        if (lists.leftUl) lists.leftUl.appendChild(li);
        li.classList.remove('bg-green-50','border-green-200'); li.dataset.checked='0';
      }
    });

    popCancel.addEventListener('click', ()=>{
      if (currentCtx){
        const { li, cb } = currentCtx;
        // If it was already in checked area, move back; otherwise just uncheck
        if (li.dataset.checked === '1'){
          const sec = li.closest('section'); const lists = getLists(sec);
          if (lists.leftUl) lists.leftUl.appendChild(li);
          li.classList.remove('bg-green-50','border-green-200'); li.dataset.checked='0';
        }
        cb.checked = false; closePop();
      }
    });
    popSave.addEventListener('click', async ()=>{
      if (!currentCtx) return; const { li, cb } = currentCtx; const id = li.dataset.id;
      try{
        const payload = { note: popNote.value || '', amount: popAmt.value };
        const res = await fetch(`/users/my-stock/api/check/${encodeURIComponent(id)}`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('更新に失敗しました');
        const json = await res.json(); const item = json.item;
        // update UI
        const dateNode = li.querySelector('[data-role="date"]'); if (dateNode) { const d=new Date(item.lastCheckedAt); dateNode.textContent = (d.getMonth()+1)+'月'+d.getDate()+'日'; }
        const agoNode = li.querySelector('[data-role="ago"]'); if (agoNode) agoNode.textContent = '';
        const noteNode = li.querySelector('[data-role="note"]'); if (noteNode){ noteNode.textContent = item.lastCheckedNote || ''; noteNode.classList.toggle('hidden', !item.lastCheckedNote); }
        const byNode = li.querySelector('[data-role="by"]'); if (byNode){ byNode.textContent = item.lastCheckedBy || ''; byNode.classList.toggle('hidden', !item.lastCheckedBy); byNode.className = 'ml-2 inline-flex items-center rounded-full border border-blue-200 bg-blue-50 text-blue-700 px-2 py-0.5 text-[10px]'; }
        const amtSpan = li.querySelector('.text-xs.text-gray-600'); if (amtSpan){ amtSpan.textContent = `${item.amount||0}${item.unit||''}`; }
        // move to right
        const sec = li.closest('section'); const lists = getLists(sec);
        if (lists.rightUl) lists.rightUl.appendChild(li);
        li.classList.add('bg-green-50','border-green-200'); li.dataset.checked='1';
      }catch(e){ alert(e.message||'更新に失敗しました'); cb.checked=false; }
      closePop();
    });
  })();
</script>
