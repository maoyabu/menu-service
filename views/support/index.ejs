<% layout('layouts/boilerplate') %>

<section class="max-w-3xl mx-auto bg-white shadow rounded-2xl p-6 sm:p-8">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <p class="text-sm text-amber-600 font-semibold tracking-wide">PACKING PLAN</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mt-1">サポート</h1>
      <p class="text-gray-600 mt-2">よくあるご質問とお問い合わせ先をご案内します。</p>
    </div>
    <a href="mailto:ma.oyabu@gmail.com" class="inline-flex items-center gap-2 rounded-full bg-amber-500 text-white px-4 py-2 text-sm font-semibold shadow hover:bg-amber-600 transition">
      <span>メールで問い合わせる</span>
    </a>
  </div>

  <div class="mt-8">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-gray-900">よくあるご質問</h2>
      <span class="text-xs text-gray-500">FAQ</span>
    </div>
    <div class="mt-4 space-y-3">
      <% if (!faqs || !faqs.length) { %>
        <p class="text-gray-500">よくあるご質問は準備中です。</p>
      <% } else { %>
        <% faqs.forEach((faq, idx) => { %>
          <details class="group rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
            <summary class="cursor-pointer list-none flex items-center justify-between font-semibold text-gray-800">
              <span><%= faq.qa_question %></span>
              <span class="ml-4 text-amber-600 group-open:rotate-180 transition">⌄</span>
            </summary>
            <div class="mt-3 text-sm text-gray-600 leading-relaxed">
              <p><%= faq.qa_answer %></p>
              <% if (faq.url) { %>
                <a href="<%= faq.url %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 mt-2 text-amber-600 font-semibold hover:underline">
                  詳しくはこちら
                </a>
              <% } %>
            </div>
          </details>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="mt-10 border-t border-gray-200 pt-6">
    <h2 class="text-lg font-semibold text-gray-900">お問い合わせ先</h2>
    <p class="text-gray-600 mt-2">非会員の方はメールでお問い合わせください。</p>
    <div class="mt-4 flex flex-col sm:flex-row gap-3">
      <a href="mailto:ma.oyabu@gmail.com" class="inline-flex items-center justify-center rounded-full border border-amber-300 text-amber-700 px-4 py-2 text-sm font-semibold hover:bg-amber-50 transition">
        ma.oyabu@gmail.com
      </a>
      <span class="text-xs text-gray-500 self-center">ログイン後はアプリ内のサポートから履歴をご確認できます。</span>
    </div>
  </div>
</section>
