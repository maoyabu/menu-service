<section class="max-w-md mx-auto my-16 bg-white shadow-md border border-gray-100 rounded-2xl p-8">
  <h1 class="text-2xl font-bold text-gray-800">新しいパスワードの設定</h1>
  <p class="text-sm text-gray-500 mt-2">半角英数字8文字以上で入力してください。</p>

  <% if (locals.error && locals.error.length) { %>
    <div class="mt-4 rounded-md bg-red-50 border border-red-200 text-red-700 px-3 py-2 text-sm">
      <%= Array.isArray(error) ? error.join('<br>') : error %>
    </div>
  <% } %>
  <% if (locals.success && locals.success.length) { %>
    <div class="mt-4 rounded-md bg-green-50 border border-green-200 text-green-700 px-3 py-2 text-sm">
      <%= Array.isArray(success) ? success.join('<br>') : success %>
    </div>
  <% } %>

  <form id="resetForm" method="POST" action="/auth/reset/<%= token %>" class="mt-6 space-y-5" novalidate>
    <div>
      <label for="newPassword" class="block text-sm font-medium text-gray-700">新しいパスワード</label>
      <div class="mt-2 relative">
        <input
          id="newPassword"
          name="newPassword"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="w-full border border-gray-300 px-4 py-3 rounded-lg pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
        <button type="button" class="absolute inset-y-0 right-2 my-auto text-gray-500" aria-label="表示切替" data-toggle-password="newPassword">表示</button>
      </div>
      <div class="mt-2 h-2 w-full bg-gray-100 rounded">
        <div id="pwStrength" class="h-2 rounded" style="width:0%"></div>
      </div>
      <p id="pwHint" class="mt-1 text-xs text-gray-500">英字・数字の組み合わせ推奨</p>
    </div>

    <div>
      <label for="confirmNewPassword" class="block text-sm font-medium text-gray-700">新しいパスワード（確認）</label>
      <div class="mt-2 relative">
        <input
          id="confirmNewPassword"
          name="confirmNewPassword"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          class="w-full border border-gray-300 px-4 py-3 rounded-lg pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
        <button type="button" class="absolute inset-y-0 right-2 my-auto text-gray-500" aria-label="表示切替" data-toggle-password="confirmNewPassword">表示</button>
      </div>
      <p id="matchHint" class="mt-1 text-xs text-gray-500">確認用パスワードが一致しているかチェックします。</p>
    </div>

    <button id="submitBtn" type="submit" class="w-full bg-blue-600 hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold py-3 rounded-lg transition">
      パスワードを変更
    </button>

    <div class="mt-4 text-center">
      <a href="/user/login" class="text-sm text-blue-600 hover:underline">ユーザーログインに戻る</a>
    </div>
  </form>
</section>

<script>
(function(){
  const newPw = document.getElementById('newPassword');
  const confirmPw = document.getElementById('confirmNewPassword');
  const submitBtn = document.getElementById('submitBtn');
  const strengthBar = document.getElementById('pwStrength');
  const matchHint = document.getElementById('matchHint');
  const toggles = document.querySelectorAll('[data-toggle-password]');

  function score(pw){
    let s = 0;
    if (!pw) return 0;
    if (pw.length >= 8) s += 30;
    if (/[a-z]/.test(pw)) s += 20;
    if (/[A-Z]/.test(pw)) s += 20;
    if (/\d/.test(pw)) s += 20;
    if (/[^\w]/.test(pw)) s += 10;
    return Math.min(s,100);
  }

  function updateUI(){
    const pw = newPw.value;
    const sc = score(pw);
    strengthBar.style.width = sc + '%';
    strengthBar.style.backgroundColor = sc >= 70 ? '#16a34a' : sc >= 40 ? '#f59e0b' : '#ef4444';

    const match = pw && confirmPw.value && pw === confirmPw.value;
    matchHint.textContent = match ? '一致しています。' : '確認用パスワードが一致しているかチェックします。';
    matchHint.className = 'mt-1 text-xs ' + (match ? 'text-green-600' : 'text-gray-500');

    submitBtn.disabled = !(pw && confirmPw.value && pw.length >= 8 && match);
  }

  newPw.addEventListener('input', updateUI);
  confirmPw.addEventListener('input', updateUI);
  updateUI();

  toggles.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-toggle-password');
      const el = document.getElementById(id);
      if (!el) return;
      el.type = el.type === 'password' ? 'text' : 'password';
      btn.textContent = el.type === 'password' ? '表示' : '非表示';
    });
  });
})();
</script>