<div class="max-w-md mx-auto bg-white p-8 rounded shadow-md mt-10">
  <h1 class="text-2xl font-bold text-center mb-6">Menu Service 管理画面</h1>

  <% if (error && error.length > 0) { %>
    <div class="bg-red-100 text-red-800 p-2 rounded mb-4 text-center">
      <%= error %>
    </div>
  <% } %>

  <form action="/login" method="POST" class="space-y-4">
    <div>
      <label for="email" class="block font-semibold mb-1">メールアドレス または ユーザー名</label>
      <input type="text" id="email" name="username" required class="w-full border border-gray-300 px-3 py-2 rounded" />
    </div>

    <div>
      <label for="password" class="block font-semibold mb-1">パスワード</label>
      <input type="password" id="password" name="password" required class="w-full border border-gray-300 px-3 py-2 rounded" />
    </div>

    <button type="submit" class="w-full bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600">
      ログイン
    </button>
  </form>
</div>