<header data-sticky-header class="sticky top-0 z-50 flex items-center justify-between px-6 py-3 border-b border-gray-200 bg-white shadow-sm transition-colors duration-300">
  <div class="flex items-center gap-3 text-gray-800 text-lg font-semibold">
    <button type="button" data-menu-open class="relative inline-flex h-10 w-10 items-center justify-center rounded-md hover:bg-gray-100 text-gray-700 cursor-pointer select-none z-20" aria-label="メニューを開く" aria-expanded="false" aria-controls="app-menu-drawer" role="button">
      <span aria-hidden="true" class="absolute inset-0"></span>
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
    <i data-lucide="chef-hat" class="w-6 h-6"></i>
    <% const onAdminRoute = typeof isAdminRoute !== 'undefined' ? isAdminRoute : false; %>
    <% const homeHref = onAdminRoute ? '/admin/admin-top' : '/users/my-top'; %>
    <% const brandLabel = onAdminRoute ? 'レシピ管理システム' : '7 DAYS PLAN'; %>
    <a href="<%= homeHref %>" class="hover:underline">
      <span><%= brandLabel %></span>
    </a>
  </div>
  <div class="flex items-center gap-4">
    <% if (typeof user !== 'undefined' && user) { %>
      <% const groups = Array.isArray(userGroups) ? userGroups : []; %>
      <% const currentGroupId = (typeof selectedGroupId !== 'undefined' && selectedGroupId) ? String(selectedGroupId) : ''; %>
      <% const defaultGroupId = (typeof userDefaultGroupId !== 'undefined' && userDefaultGroupId) ? String(userDefaultGroupId) : ''; %>
      <% const effectiveGroupId = currentGroupId || defaultGroupId; %>
      <% if (user.isAdmin) { %>
        <a href="/admin/admin-top" class="flex items-center gap-1 text-gray-600 hover:text-blue-600 transition">
          <i data-lucide="shield-check" class="w-5 h-5"></i>
          <span class="hidden sm:inline text-sm font-semibold text-gray-700">管理者</span>
        </a>
      <% } %>

      <div class="flex items-center gap-2 text-gray-600">
        <i data-lucide="users" class="w-5 h-5"></i>
        <% if (groups.length > 1) { %>
          <label class="text-sm">
            <span class="sr-only">グループを選択</span>
            <select class="border border-gray-300 rounded px-2 py-1 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400"
              onchange="if (this.value) { window.location.href = '/settings?group=' + this.value; }">
              <option value="" <%= effectiveGroupId === '' ? 'selected' : '' %>>グループ一覧</option>
              <% groups.forEach((group) => { %>
                <%
                  const optionLabel = (defaultGroupId === String(group._id) ? '★ ' : '') + group.group_name;
                  const isSelected = effectiveGroupId === String(group._id);
                %>
                <option value="<%= group._id %>" <%= isSelected ? 'selected' : '' %>><%= optionLabel %></option>
              <% }) %>
            </select>
          </label>
        <% } else if (groups.length === 1) { %>
          <span class="text-sm px-2 py-1 bg-gray-100 rounded">
            <%= (defaultGroupId === String(groups[0]._id || '') ? '★ ' : '') + groups[0].group_name %>
          </span>
        <% } else { %>
          <span class="text-sm text-gray-400">グループ未所属</span>
        <% } %>
      </div>

      <div class="flex items-center gap-2 text-gray-700">
        <i data-lucide="user" class="w-5 h-5"></i>
        <span class="hidden sm:inline bg-gray-100 text-gray-800 px-2 py-1 text-sm rounded"><%= (user.displayname || user.username || user.email || '') %></span>
      </div>

      <div class="flex items-center gap-2 border border-gray-300 rounded px-3 py-1">
        <a href="/settings?view=profile" class="flex items-center gap-1 text-gray-700 hover:text-blue-600 transition">
          <i data-lucide="settings" class="w-4 h-4"></i>
          <span class="hidden sm:inline text-sm font-medium">設定</span>
        </a>
        <span class="text-gray-300 mx-1 hidden sm:inline">|</span>
        <form action="/logout" method="POST">
          <button type="submit" class="flex items-center gap-1 text-gray-700 hover:text-blue-600 transition">
            <i data-lucide="log-out" class="w-4 h-4"></i>
            <span class="hidden sm:inline">ログアウト</span>
          </button>
        </form>
      </div>
    <% } else { %>
      <a href="/user/login" class="flex items-center gap-1 border border-gray-300 px-3 py-1 rounded hover:bg-gray-50">
        <i data-lucide="log-in" class="w-4 h-4"></i>
        <span>ログイン</span>
      </a>
    <% } %>
  </div>
</header>
