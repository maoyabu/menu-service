      japanese: modal.querySelector('[data-weekmenu-settings-lunch-ratio="japanese"]'),
      western: modal.querySelector('[data-weekmenu-settings-lunch-ratio="western"]'),
      chinese: modal.querySelector('[data-weekmenu-settings-lunch-ratio="chinese"]'),
      other: modal.querySelector('[data-weekmenu-settings-lunch-ratio="other"]')
    };
    const dinnerRatioInputs = {
      japanese: modal.querySelector('[data-weekmenu-settings-dinner-ratio="japanese"]'),
      western: modal.querySelector('[data-weekmenu-settings-dinner-ratio="western"]'),
      chinese: modal.querySelector('[data-weekmenu-settings-dinner-ratio="chinese"]'),
      other: modal.querySelector('[data-weekmenu-settings-dinner-ratio="other"]')
    };
    const dinnerArrangeCountEl = modal.querySelector('[data-weekmenu-settings-dinner-arrange-count]');
    const dailyMailEnabledEl = modal.querySelector('[data-weekmenu-settings-daily-mail-enabled]');
    const dailyMailTimeEl = modal.querySelector('[data-weekmenu-settings-daily-mail-time]');
    const floatingEnabledEl = modal.querySelector('[data-weekmenu-settings-floating-enabled]');
    const floatingListEl = modal.querySelector('[data-weekmenu-settings-floating-list]');
    const calendarStartEls = modal.querySelectorAll('[data-weekmenu-settings-calendar-start]');
    const ratioKeys = ['japanese', 'western', 'chinese', 'other'];

    const defaults = {
      breakfastMenus: ['モーニング'],
      breakfastRatios: {
        japanese: 3,
        western: 4,
        chinese: 0,
        other: 0
      },
      lunchMenus: [
        'カレーライス',
        '丼',
        'パスタ',
        'うどん',
        '焼きそば',
        'そうめん',
        'そば',
        'ちゃんぽん',
        'ラーメン',
        'ハンバーガー',
        'サンドイッチ',
        '定食'
      ],
      lunchRatios: {
        japanese: 2,
        western: 3,
        chinese: 2,
        other: 0
      },
      dinnerMenus: [],
      dinnerRatios: {
        japanese: 3,
        western: 2,
        chinese: 2,
        other: 0
      },
      dinnerArrangeCount: 1,
      dailyMenuMailEnabled: true,
      dailyMenuMailTime: '06:00',
      breakfastFilterEnabled: true,
      lunchFilterEnabled: true,
      dinnerFilterEnabled: true,
      floatingMenuEnabled: false,
      floatingMenuItems: ['my-top', 'current-week', 'shopping-list', 'my-menu'],
      calendarWeekStart: 'monday'
    };

    let cachedMenus = [];
    let cachedSettings = null;

    const normalizeRatios = (raw, fallback) => {
      const base = ratioKeys.reduce((acc, key) => {
        const value = Number(raw?.[key]);
        acc[key] = Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
        return acc;
      }, {});
      const sum = ratioKeys.reduce((acc, key) => acc + base[key], 0);
      if (sum <= 0) return { ...(fallback || {}) };
      if (sum === 7) return base;
      const scaled = ratioKeys.map((key) => {
        const rawValue = base[key];
        const scaledValue = (rawValue / sum) * 7;
        return { key, scaledValue };
      });
      const floored = {};
      let total = 0;
      scaled.forEach(({ key, scaledValue }) => {
        const value = Math.floor(scaledValue);
        floored[key] = value;
        total += value;
      });
      let remainder = 7 - total;
      if (remainder > 0) {
        const byFraction = scaled
          .map(({ key, scaledValue }) => ({ key, fraction: scaledValue - Math.floor(scaledValue) }))
          .sort((a, b) => b.fraction - a.fraction);
        for (let i = 0; i < remainder; i += 1) {
          const target = byFraction[i % byFraction.length];
          floored[target.key] += 1;
        }
      }
      return floored;
    };

    const normalizeSettings = (raw) => {
      const toArray = (v) => (Array.isArray(v) ? v : (v ? [v] : []))
        .map((x) => (typeof x === 'string' ? x.trim() : ''))
        .filter(Boolean);
      return {
        breakfastMenus: toArray(raw?.breakfastMenus).length ? toArray(raw?.breakfastMenus) : defaults.breakfastMenus.slice(),
        breakfastRatios: normalizeRatios(raw?.breakfastRatios || {}, defaults.breakfastRatios),
        lunchMenus: toArray(raw?.lunchMenus).length ? toArray(raw?.lunchMenus) : defaults.lunchMenus.slice(),
        lunchRatios: normalizeRatios(raw?.lunchRatios || {}, defaults.lunchRatios),
        dinnerMenus: toArray(raw?.dinnerMenus).length ? toArray(raw?.dinnerMenus) : defaults.dinnerMenus.slice(),
        dinnerRatios: normalizeRatios(raw?.dinnerRatios || {}, defaults.dinnerRatios),
        dinnerArrangeCount: Number.isFinite(Number(raw?.dinnerArrangeCount))
          ? Math.max(0, Math.min(7, Math.floor(Number(raw?.dinnerArrangeCount))))
          : defaults.dinnerArrangeCount,
        dailyMenuMailEnabled: raw?.dailyMenuMailEnabled !== false,
        dailyMenuMailTime: /^([01]\d|2[0-3]):[0-5]\d$/.test(String(raw?.dailyMenuMailTime || ''))
          ? String(raw.dailyMenuMailTime)
          : defaults.dailyMenuMailTime,
        breakfastFilterEnabled: raw?.breakfastFilterEnabled !== false,
        lunchFilterEnabled: raw?.lunchFilterEnabled !== false,
        dinnerFilterEnabled: raw?.dinnerFilterEnabled !== false,
        floatingMenuEnabled: raw?.floatingMenuEnabled === true,
        floatingMenuItems: toArray(raw?.floatingMenuItems).length ? toArray(raw?.floatingMenuItems) : defaults.floatingMenuItems.slice(),
        calendarWeekStart: raw?.calendarWeekStart === 'sunday' ? 'sunday' : 'monday'
      };
    };

    const setRatioInputs = (ratios, inputs) => {
      ratioKeys.forEach((key) => {
        if (inputs[key]) inputs[key].value = Number(ratios?.[key]) || 0;
      });
    };

    const readRatios = (inputs, fallback) => normalizeRatios(ratioKeys.reduce((acc, key) => {
      const raw = inputs[key] ? inputs[key].value : 0;
      const value = Number(raw);
      acc[key] = Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
      return acc;
    }, {}), fallback);

    const adjustRatios = (changedKey, inputs, fallback) => {
      const values = ratioKeys.reduce((acc, key) => {
        const raw = inputs[key] ? inputs[key].value : 0;
        const value = Number(raw);
        acc[key] = Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
        return acc;
      }, {});
      let sum = ratioKeys.reduce((acc, key) => acc + values[key], 0);
      if (sum === 7) {
        setRatioInputs(values, inputs);
        return;
      }
      const adjustKey = (changedKey === 'other') ? 'western' : 'other';
      const adjustOrder = [adjustKey, ...ratioKeys.filter((k) => k !== changedKey && k !== adjustKey)];
      let diff = 7 - sum;
      adjustOrder.forEach((key) => {
        if (diff === 0) return;
        const next = values[key] + diff;
        if (next < 0) {
          diff = next;
          values[key] = 0;
        } else if (next > 7) {
          diff = next - 7;
          values[key] = 7;
        } else {
          values[key] = next;
          diff = 0;
        }
      });
      if (diff !== 0) {
        const next = Math.max(0, Math.min(7, values[changedKey] + diff));
        values[changedKey] = next;
      }
      if (ratioKeys.reduce((acc, key) => acc + values[key], 0) === 0) {
        setRatioInputs(fallback || {}, inputs);
      } else {
        setRatioInputs(values, inputs);
      }
    };

    const openModal = async () => {
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      if (errorEl) errorEl.classList.add('hidden');
      if (!cachedSettings || !cachedMenus.length) {
        try {
          const res = await fetch('/users/week-menu/settings');
          if (!res.ok) throw new Error('fetch failed');
          const json = await res.json();
          cachedMenus = Array.isArray(json.menus) ? json.menus : [];
          cachedSettings = normalizeSettings(json.settings || {});
        } catch (e) {
          if (errorEl) {
            errorEl.textContent = '設定の読み込みに失敗しました。';
            errorEl.classList.remove('hidden');
          }
          cachedMenus = [];
          cachedSettings = normalizeSettings({});
        }
      }
      renderLists();
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
    };

    const renderList = (container, menus, selectedSet, keyword) => {
      if (!container) return;
      container.innerHTML = '';
      const list = menus.filter((m) => !keyword || m.toLowerCase().includes(keyword.toLowerCase()));
      list.forEach((menu) => {
        const id = `wm-setting-${container.dataset.role || 'menu'}-${menu}`;
        const label = document.createElement('label');
        label.className = 'inline-flex items-center gap-2 text-sm px-2 py-1 rounded border border-gray-200 bg-gray-50';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = menu;
        input.checked = selectedSet.has(menu);
        input.className = 'w-4 h-4 text-blue-600 border-gray-300 rounded';
        const span = document.createElement('span');
        span.textContent = menu;
        label.appendChild(input);
        label.appendChild(span);
        container.appendChild(label);
      });
    };

    const renderLists = () => {
      const settings = cachedSettings || normalizeSettings({});
      if (breakfastEnabledEl) breakfastEnabledEl.checked = settings.breakfastFilterEnabled !== false;
      if (lunchEnabledEl) lunchEnabledEl.checked = settings.lunchFilterEnabled !== false;
      if (dinnerEnabledEl) dinnerEnabledEl.checked = settings.dinnerFilterEnabled !== false;
      const breakfastSelected = new Set(settings.breakfastMenus || []);
      const lunchSelected = new Set(settings.lunchMenus || []);
      const dinnerSelected = new Set(settings.dinnerMenus || []);
      setRatioInputs(settings.breakfastRatios || defaults.breakfastRatios, ratioInputs);
      setRatioInputs(settings.lunchRatios || defaults.lunchRatios, lunchRatioInputs);
      setRatioInputs(settings.dinnerRatios || defaults.dinnerRatios, dinnerRatioInputs);
      if (dinnerArrangeCountEl) dinnerArrangeCountEl.value = Number(settings.dinnerArrangeCount) || 0;
      if (dailyMailEnabledEl) dailyMailEnabledEl.checked = settings.dailyMenuMailEnabled !== false;
      if (dailyMailTimeEl) dailyMailTimeEl.value = settings.dailyMenuMailTime || '06:00';
      if (floatingEnabledEl) floatingEnabledEl.checked = settings.floatingMenuEnabled === true;
      if (floatingListEl) {
        const selectedItems = new Set(settings.floatingMenuItems || []);
        floatingListEl.querySelectorAll('input[type="checkbox"]').forEach((input) => {
          input.checked = selectedItems.has(input.value);
        });
      }
      calendarStartEls.forEach((input) => {
        input.checked = input.value === settings.calendarWeekStart;
      });
      renderList(breakfastListEl, cachedMenus, breakfastSelected, breakfastSearchEl?.value || '');
      renderList(lunchListEl, cachedMenus, lunchSelected, lunchSearchEl?.value || '');
      renderList(dinnerListEl, cachedMenus, dinnerSelected, dinnerSearchEl?.value || '');
    };

    const collectSelected = (container) => {
      if (!container) return [];
      return Array.from(container.querySelectorAll('input[type="checkbox"]:checked'))
        .map((el) => el.value)
        .filter(Boolean);
    };

    openButtons.forEach((btn) => btn.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    }));
    window.addEventListener('weekmenu-settings:open', () => openModal());
    closeButtons.forEach((btn) => btn.addEventListener('click', (e) => {
      e.preventDefault();
      closeModal();
    }));
    if (breakfastSearchEl) breakfastSearchEl.addEventListener('input', renderLists);
    if (lunchSearchEl) lunchSearchEl.addEventListener('input', renderLists);
    if (dinnerSearchEl) dinnerSearchEl.addEventListener('input', renderLists);
    ratioKeys.forEach((key) => {
      const input = ratioInputs[key];
      if (input) input.addEventListener('input', () => adjustRatios(key, ratioInputs, defaults.breakfastRatios));
      const lunchInput = lunchRatioInputs[key];
      if (lunchInput) lunchInput.addEventListener('input', () => adjustRatios(key, lunchRatioInputs, defaults.lunchRatios));
      const dinnerInput = dinnerRatioInputs[key];
      if (dinnerInput) dinnerInput.addEventListener('input', () => adjustRatios(key, dinnerRatioInputs, defaults.dinnerRatios));
    });
    if (breakfastClearBtn) breakfastClearBtn.addEventListener('click', () => {
      if (breakfastListEl) breakfastListEl.querySelectorAll('input[type="checkbox"]').forEach((c) => { c.checked = false; });
    });
    if (lunchClearBtn) lunchClearBtn.addEventListener('click', () => {
      if (lunchListEl) lunchListEl.querySelectorAll('input[type="checkbox"]').forEach((c) => { c.checked = false; });
    });
    if (dinnerClearBtn) dinnerClearBtn.addEventListener('click', () => {
      if (dinnerListEl) dinnerListEl.querySelectorAll('input[type="checkbox"]').forEach((c) => { c.checked = false; });
    });

    if (saveButton) {
      saveButton.addEventListener('click', async () => {
        try {
          if (errorEl) errorEl.classList.add('hidden');
          const selectedFloatingItems = collectSelected(floatingListEl);
          if (floatingEnabledEl?.checked && !selectedFloatingItems.length) {
            if (errorEl) {
              errorEl.textContent = 'フローティングメニューに表示する項目を1つ以上選択してください。';
              errorEl.classList.remove('hidden');
            }
            return;
          }
          const payload = {
            breakfastMenus: collectSelected(breakfastListEl),
            breakfastRatios: readRatios(ratioInputs, defaults.breakfastRatios),
            lunchMenus: collectSelected(lunchListEl),
            lunchRatios: readRatios(lunchRatioInputs, defaults.lunchRatios),
            dinnerMenus: collectSelected(dinnerListEl),
            dinnerRatios: readRatios(dinnerRatioInputs, defaults.dinnerRatios),
            dinnerArrangeCount: dinnerArrangeCountEl ? dinnerArrangeCountEl.value : 0,
            dailyMenuMailEnabled: dailyMailEnabledEl ? dailyMailEnabledEl.checked : true,
            dailyMenuMailTime: dailyMailTimeEl ? dailyMailTimeEl.value : '06:00',
            breakfastFilterEnabled: breakfastEnabledEl ? breakfastEnabledEl.checked : true,
            lunchFilterEnabled: lunchEnabledEl ? lunchEnabledEl.checked : true,
            dinnerFilterEnabled: dinnerEnabledEl ? dinnerEnabledEl.checked : true,
            floatingMenuEnabled: floatingEnabledEl ? floatingEnabledEl.checked : false,
            floatingMenuItems: selectedFloatingItems,
            calendarWeekStart: modal.querySelector('[data-weekmenu-settings-calendar-start]:checked')?.value || 'monday'
          };
          const res = await fetch('/users/week-menu/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('save failed');
          const json = await res.json();
          const calendarStartChanged = (cachedSettings?.calendarWeekStart || 'monday') !== payload.calendarWeekStart;
          cachedSettings = normalizeSettings(json.settings || payload);
          if (window.weekMenuData) {
            window.weekMenuData.menuFilterSettings = cachedSettings;
          }
          window.dispatchEvent(new CustomEvent('floating-menu:settings-changed', { detail: cachedSettings }));
          closeModal();
          if (calendarStartChanged) window.location.reload();
        } catch (e) {
          if (errorEl) {
            errorEl.textContent = '設定の保存に失敗しました。';
            errorEl.classList.remove('hidden');
          }
        }
      });
    }
  })();
</script>

<script>
  (function(){
    const body = document.body;
    const overlay = document.getElementById('app-menu-overlay');
    const drawer = document.getElementById('app-menu-drawer');

    const setExpanded = (value) => {
      document.querySelectorAll('[data-menu-open]').forEach((b)=>{
        try { b.setAttribute('aria-expanded', value ? 'true' : 'false'); } catch(_) {}
      });
    };

    const open = () => {
      body.dataset.menuOpen = 'true';
      setExpanded(true);
      overlay.classList.remove('hidden');
      // allow one frame for display before opacity transition
      requestAnimationFrame(() => {
        overlay.classList.remove('opacity-0');
        overlay.classList.add('opacity-100');
        drawer.classList.remove('-translate-x-full');
      });
    };
    const close = () => {
      delete body.dataset.menuOpen;
       setExpanded(false);
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0');
      drawer.classList.add('-translate-x-full');
      setTimeout(() => overlay.classList.add('hidden'), 200);
    };

    // Bind explicit open/close buttons to avoid interfering with link clicks
    const bindToggles = () => {
      document.querySelectorAll('[data-menu-open]')
        .forEach((btn) => {
          btn.addEventListener('click', (e) => { e.preventDefault(); open(); });
        });
      document.querySelectorAll('[data-menu-close]')
        .forEach((btn) => {
          btn.addEventListener('click', (e) => { e.preventDefault(); close(); });
        });
      // Close drawer on any nav link click, but do not prevent navigation
      drawer.querySelectorAll('a[href]')
        .forEach((a) => {
          a.addEventListener('click', () => { close(); });
        });
    };
    // initial bind and after lucide potentially re-renders icons
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindToggles, { once: true });
    } else {
      bindToggles();
    }

    overlay.addEventListener('click', close);
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();
</script>
