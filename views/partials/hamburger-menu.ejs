<script>
  (function () {
    const menu = document.getElementById('floating-quick-menu');
    const list = menu?.querySelector('[data-floating-menu-list]');
    const dragHandle = menu?.querySelector('[data-floating-menu-drag]');
    const settingsButton = menu?.querySelector('[data-floating-menu-settings]');
    const toggleButton = menu?.querySelector('[data-floating-menu-toggle]');
    if (!menu || !list || !dragHandle) return;

    let items = [];
    try {
      items = JSON.parse(document.getElementById('floating-menu-items-data')?.textContent || '[]');
    } catch (_) {}
    const itemMap = new Map(items.map((item) => [item.id, item]));
    const positionKey = 'prepalace-floating-menu-position';
    const collapsedKey = 'prepalace-floating-menu-collapsed';
    let dragState = null;
    let moved = false;

    const clampPosition = (left, top) => ({
      left: Math.max(8, Math.min(left, window.innerWidth - menu.offsetWidth - 8)),
      top: Math.max(8, Math.min(top, window.innerHeight - menu.offsetHeight - 8))
    });

    const setPosition = (left, top, persist) => {
      const next = clampPosition(left, top);
      menu.style.left = `${next.left}px`;
      menu.style.top = `${next.top}px`;
      menu.style.right = 'auto';
      menu.style.bottom = 'auto';
      if (persist) {
        try { localStorage.setItem(positionKey, JSON.stringify(next)); } catch (_) {}
      }
    };

    const restorePosition = () => {
      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(positionKey) || 'null'); } catch (_) {}
      if (saved && Number.isFinite(saved.left) && Number.isFinite(saved.top)) {
        setPosition(saved.left, saved.top, false);
      } else {
        setPosition(window.innerWidth - menu.offsetWidth - 20, window.innerHeight - menu.offsetHeight - 24, false);
      }
    };

    const setCollapsed = (collapsed, persist) => {
      list.classList.toggle('hidden', collapsed);
      toggleButton?.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      toggleButton?.setAttribute('aria-label', collapsed ? 'メニューを開く' : 'メニューを折りたたむ');
      const icon = toggleButton?.querySelector('[data-lucide]');
      if (icon) icon.classList.toggle('rotate-180', collapsed);
      if (persist) {
        try { localStorage.setItem(collapsedKey, collapsed ? '1' : '0'); } catch (_) {}
      }
    };

    const restoreCollapsed = () => {
      let collapsed = false;
      try { collapsed = localStorage.getItem(collapsedKey) === '1'; } catch (_) {}
      setCollapsed(collapsed, false);
    };

    const render = (settings) => {
      const enabled = settings?.floatingMenuEnabled === true;
      const selectedIds = Array.isArray(settings?.floatingMenuItems) ? settings.floatingMenuItems : [];
      list.innerHTML = '';
      selectedIds.forEach((id) => {
        const item = itemMap.get(id);
        if (!item) return;
        const link = document.createElement('a');
        link.href = item.href;
        link.className = 'flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-gray-700 hover:bg-violet-50 hover:text-violet-700';
        const icon = document.createElement('i');
        icon.setAttribute('data-lucide', item.icon);
        icon.className = 'w-4 h-4 text-violet-500';
        const label = document.createElement('span');
        label.textContent = item.label;
        link.append(icon, label);
        list.appendChild(link);
      });
      menu.classList.toggle('hidden', !enabled || !list.children.length);
      if (enabled && list.children.length) {
        restoreCollapsed();
        requestAnimationFrame(restorePosition);
        window.refreshLucideIcons?.();
      }
    };

    const loadSettings = async () => {
      try {
        const response = await fetch('/users/week-menu/settings');
        if (!response.ok) return;
        const json = await response.json();
        render(json.settings || {});
      } catch (_) {}
    };

    dragHandle.addEventListener('pointerdown', (event) => {
      if (event.target.closest('button')) return;
      const rect = menu.getBoundingClientRect();
      dragState = { pointerId: event.pointerId, offsetX: event.clientX - rect.left, offsetY: event.clientY - rect.top };
      moved = false;
      dragHandle.setPointerCapture(event.pointerId);
    });
    dragHandle.addEventListener('pointermove', (event) => {
      if (!dragState || dragState.pointerId !== event.pointerId) return;
      moved = true;
      setPosition(event.clientX - dragState.offsetX, event.clientY - dragState.offsetY, false);
    });
    const finishDrag = (event) => {
      if (!dragState || dragState.pointerId !== event.pointerId) return;
      if (moved) {
        const rect = menu.getBoundingClientRect();
        setPosition(rect.left, rect.top, true);
      }
      dragState = null;
    };
    dragHandle.addEventListener('pointerup', finishDrag);
    dragHandle.addEventListener('pointercancel', finishDrag);

    settingsButton?.addEventListener('click', () => {
      window.dispatchEvent(new Event('weekmenu-settings:open'));
    });
    toggleButton?.addEventListener('click', () => {
      const collapsed = !list.classList.contains('hidden');
      setCollapsed(collapsed, true);
      const rect = menu.getBoundingClientRect();
      requestAnimationFrame(() => setPosition(rect.left, rect.top, false));
    });
    window.addEventListener('resize', () => {
      if (menu.classList.contains('hidden')) return;
      const rect = menu.getBoundingClientRect();
      setPosition(rect.left, rect.top, false);
    });
    window.addEventListener('floating-menu:settings-changed', (event) => render(event.detail || {}));
    loadSettings();
  })();
</script>
<% } %>

