<% const pathNow = (typeof currentPath !== 'undefined' ? currentPath : ''); %>
<% const isActive = (hrefPrefix) => pathNow && hrefPrefix && pathNow.startsWith(hrefPrefix); %>
<% const wmView = typeof weekMenuView !== 'undefined' ? weekMenuView : null; %>
<% const isWeekRoute = isActive('/users/week-menu'); %>
<% const activeCurrent = (isWeekRoute && wmView === 'current'); %>
<% const activeNext = (isWeekRoute && wmView === 'next'); %>
<% const wmMode = (typeof weekMenuMode !== 'undefined' ? weekMenuMode : null); %>
<% const activeNextSupplies = (isWeekRoute && wmView === 'next' && wmMode === 'supplies'); %>
<% const activePacking = isActive('/users/packing'); %>
<% const activePurchaseReminder = isActive('/users/purchase-reminder'); %>
<% const isStockService = isActive('/users/my-stock') || isActive('/users/my-equipment') || activePurchaseReminder || isActive('/users/stock-top'); %>
<% const isBoardRoute = isActive('/users/board'); %>
<% const currentService = isBoardRoute ? 'board' : (activePacking ? 'packing' : (isStockService ? 'stock' : 'plan')); %>
<% const currentGroupName = (()=>{ const groups = Array.isArray(userGroups)? userGroups : []; const currentGroupId = (typeof selectedGroupId !== 'undefined' && selectedGroupId) ? String(selectedGroupId) : ''; const defaultGroupId = (typeof userDefaultGroupId !== 'undefined' && userDefaultGroupId) ? String(userDefaultGroupId) : ''; const gid = currentGroupId || defaultGroupId; const g = groups.find((gr)=> String(gr._id || '') === gid); return g ? g.group_name : ''; })(); %>
<% /* Compute next week's Monday (week start) in ISO, same logic as server */ %>
<% const _tmpNow = new Date(); _tmpNow.setHours(0,0,0,0); const _day = _tmpNow.getDay(); const _offset = (_day + 6) % 7; const _nextMon = new Date(_tmpNow); _nextMon.setDate(_nextMon.getDate() - _offset + 7); const nextWeekStartISO = _nextMon.toISOString(); const _afterNextMon = new Date(_nextMon); _afterNextMon.setDate(_afterNextMon.getDate() + 7); const afterNextWeekStartISO = _afterNextMon.toISOString(); %>
<% const floatingMenuItems = [
  { id: 'my-top', label: 'トップページ', icon: 'home', href: '/users/my-top' },
  { id: 'current-week', label: '今週の7 DAYS PLAN', icon: 'calendar', href: `/users/week-menu?weekStart=${encodeURIComponent(new Date().toISOString())}` },
  { id: 'create-week', label: '再来週の7 DAYS PLANを作成', icon: 'calendar-plus', href: `/users/week-menu?weekStart=${encodeURIComponent(afterNextWeekStartISO)}` },
  { id: 'shopping-list', label: '来週のお買い物リスト', icon: 'shopping-cart', href: `/users/week-menu?show=supplies&weekStart=${encodeURIComponent(nextWeekStartISO)}` },
  { id: 'menu-list', label: 'メニューリスト', icon: 'list', href: '/users/my-menu/shared-register' },
  { id: 'my-menu', label: 'マイメニュー', icon: 'book-open', href: '/users/my-menu' },
  { id: 'seasonal-ingredients', label: '旬の食材', icon: 'leaf', href: '/users/seasonal-ingredients' },
  { id: 'menu-ranking', label: 'メニューランキング', icon: 'trophy', href: '/users/menu-ranking' },
  { id: 'stock-top', label: 'ストック管理トップ', icon: 'layout-grid', href: '/users/stock-top' },
  { id: 'my-stock', label: 'ストック管理', icon: 'package', href: '/users/my-stock' },
  { id: 'my-equipment', label: '備品管理', icon: 'boxes', href: '/users/my-equipment' },
  { id: 'purchase-reminder', label: 'そろそろ購入リスト', icon: 'shopping-bag', href: '/users/purchase-reminder' },
  { id: 'packing', label: 'パッキングプラン', icon: 'clipboard-list', href: '/users/packing' },
  { id: 'board', label: `${currentGroupName || 'グループ'}の掲示板`, icon: 'messages-square', href: '/users/board' },
  { id: 'notices', label: 'お知らせ', icon: 'megaphone', href: '/notices' },
  { id: 'settings', label: '設定', icon: 'settings', href: '/settings' },
  { id: 'slideshow', label: 'スライドショー', icon: 'images', href: '/slideshow' }
]; %>

