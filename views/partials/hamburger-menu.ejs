            <i data-lucide="home" class="w-5 h-5 <%= isActive('/users/my-top') ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>トップページ</span>
            <% if (isActive('/users/my-top')) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/week-menu?weekStart=<%= new Date().toISOString() %>" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= activeCurrent ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>" aria-current="<%= activeCurrent ? 'page' : 'false' %>">
            <i data-lucide="calendar" class="w-5 h-5 <%= activeCurrent ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>今週の7 DAYS PLAN</span>
            <% if (activeCurrent) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/week-menu?weekStart=<%= encodeURIComponent(afterNextWeekStartISO) %>" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= (activeNext && !activeNextSupplies) ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>">
            <i data-lucide="calendar-plus" class="w-5 h-5 <%= (activeNext && !activeNextSupplies) ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>再来週の7 DAYS PLANを作成</span>
            <% if (activeNext && !activeNextSupplies) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/week-menu2?show=supplies&weekStart=<%= encodeURIComponent(nextWeekStartISO) %>" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= activeNextSupplies ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>">
            <i data-lucide="shopping-cart" class="w-5 h-5 <%= activeNextSupplies ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>来週のお買い物リスト</span>
            <% if (activeNextSupplies) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/my-menu" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= isActive('/users/my-menu') ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>" aria-current="<%= isActive('/users/my-menu') ? 'page' : 'false' %>">
            <i data-lucide="book-open" class="w-5 h-5 <%= isActive('/users/my-menu') ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>マイメニュー</span>
            <% if (isActive('/users/my-menu')) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/seasonal-ingredients" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= isActive('/users/seasonal-ingredients') ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>" aria-current="<%= isActive('/users/seasonal-ingredients') ? 'page' : 'false' %>">
            <i data-lucide="leaf" class="w-5 h-5 <%= isActive('/users/seasonal-ingredients') ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>旬の食材</span>
            <% if (isActive('/users/seasonal-ingredients')) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/my-stock" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= isActive('/users/my-stock') ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>">
            <i data-lucide="package" class="w-5 h-5 <%= isActive('/users/my-stock') ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>マイストック</span>
            <% if (isActive('/users/my-stock')) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <li>
          <a href="/users/my-equipment" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= isActive('/users/my-equipment') ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>">
            <i data-lucide="boxes" class="w-5 h-5 <%= isActive('/users/my-equipment') ? 'text-blue-700' : 'text-gray-500 group-hover:text-gray-700' %>"></i>
            <span>マイ備品</span>
            <% if (isActive('/users/my-equipment')) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
      </ul>
    </div>

    <div class="mx-4 my-2 border-t border-gray-200"></div>

    <div class="px-4 py-3">
      <p class="px-2 text-xs font-semibold tracking-wide text-gray-500">設定</p>
      <ul class="mt-2 space-y-1">
        <li>
          <a href="/settings" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= isActive('/settings') ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>" aria-current="<%= isActive('/settings') ? 'page' : 'false' %>">
            <i data-lucide="settings" class="w-5 h-5 <%= isActive('/settings') ? 'text-blue-700' : 'text-red-600' %>"></i>
            <span>設定</span>
            <% if (isActive('/settings')) { %>
              <span class="absolute right-0 top-0 bottom-0 w-1 bg-blue-600 rounded-r"></span>
            <% } %>
          </a>
        </li>
        <% if (user && user.isAdmin) { %>
        <li>
          <a href="/admin/admin-top" class="group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition <%= isActive('/admin') ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50' %>" aria-current="<%= isActive('/admin') ? 'page' : 'false' %>">
            <i data-lucide="shield-check" class="w-5 h-5 <%= isActive('/admin') ? 'text-blue-700' : 'text-red-600' %>"></i>
            <span>管理画面</span>
            <% if (isActive('/admin')) { %>
