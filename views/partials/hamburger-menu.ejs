<% const pathNow = (typeof currentPath !== 'undefined' ? currentPath : ''); %>
<% const isActive = (hrefPrefix) => pathNow && hrefPrefix && pathNow.startsWith(hrefPrefix); %>
<% const wmView = typeof weekMenuView !== 'undefined' ? weekMenuView : null; %>
<% const isWeekRoute = isActive('/users/week-menu'); %>
<% const activeCurrent = (isWeekRoute && wmView === 'current'); %>
<% const activeNext = (isWeekRoute && wmView === 'next'); %>
<% const wmMode = (typeof weekMenuMode !== 'undefined' ? weekMenuMode : null); %>
<% const activeNextSupplies = (isWeekRoute && wmView === 'next' && wmMode === 'supplies'); %>
<% /* Compute next week's Monday (week start) in ISO, same logic as server */ %>
<% const _tmpNow = new Date(); _tmpNow.setHours(0,0,0,0); const _day = _tmpNow.getDay(); const _offset = (_day + 6) % 7; const _nextMon = new Date(_tmpNow); _nextMon.setDate(_nextMon.getDate() - _offset + 7); const nextWeekStartISO = _nextMon.toISOString(); const _afterNextMon = new Date(_nextMon); _afterNextMon.setDate(_afterNextMon.getDate() + 7); const afterNextWeekStartISO = _afterNextMon.toISOString(); %>

<div id="app-menu-overlay" class="hidden fixed inset-0 z-[60] bg-black/40 opacity-0 transition-opacity duration-200"></div>

<aside id="app-menu-drawer" class="fixed left-0 top-0 z-[61] h-full w-[80%] sm:w-80 max-w-full -translate-x-full transition-transform duration-300 will-change-transform bg-white shadow-2xl border-r border-gray-200 flex flex-col">
  <div class="px-5 py-3 bg-blue-600 text-white text-sm font-semibold tracking-wide flex items-center justify-between">
    <div>7 DAYS PLAN</div>
    <div class="flex items-center gap-1">
      <a href="https://colts-wish-krs.craft.me/qQrgjsNkauAsKQ" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded p-2 hover:bg-white/10 text-white" aria-label="ガイドを開く(別ウィンドウ)">
        <i data-lucide="book-open" class="w-5 h-5 pointer-events-none"></i>
        <span class="ml-1 whitespace-nowrap">ガイド</span>
      </a>
      <button type="button" data-menu-close class="inline-flex items-center justify-center rounded p-2 hover:bg-white/10 text-white" aria-label="メニューを閉じる">
        <i data-lucide="x" class="w-5 h-5 pointer-events-none"></i>
      </button>
    </div>
  </div>
  <div class="px-5 pt-5 pb-4 border-b border-gray-100 bg-white flex items-center gap-3">
    <div class="relative w-12 h-12 shrink-0 rounded-full overflow-hidden bg-gray-100 text-gray-600 flex items-center justify-center font-semibold select-none">
      <% const avatarUrl = (user && user.avatar) ? user.avatar : ''; %>
      <% const displayName = (user && (user.displayname || user.username || user.email)) || ''; %>
      <% const initials = (displayName || '').trim().split(/\s+/).map(s => s[0]).join('').slice(0,2).toUpperCase(); %>
      <% if (avatarUrl) { %>
        <img src="<%= avatarUrl %>" alt="avatar" class="absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
        <div class="hidden absolute inset-0 w-full h-full items-center justify-center"><%= initials || 'U' %></div>
      <% } else { %>
        <span><%= initials || 'U' %></span>
      <% } %>
    </div>
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <p class="font-semibold text-gray-900 truncate max-w-[18rem]"><%= displayName %> さん</p>
        <% if (user && user.isAdmin) { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700">管理者</span>
        <% } %>
      </div>
      <p class="text-xs text-gray-500 truncate"><%= user && user.email ? user.email : '' %></p>
    </div>
    
  </div>

  <% /* グループ選択（モバイル）: ヘッダから移動 */ %>
